{
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(favicon-.*|apple-touch-icon-.*|savvia-logo\\.svg|og\\.(png|jpg|webp))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "rewrites": [
    {
      "source": "/musica-clara",
      "destination": "https://savvia-musica.vercel.app/musica/clara/"
    },
    {
      "source": "/musica-clara/",
      "destination": "https://savvia-musica.vercel.app/musica/clara/"
    },
    {
      "source": "/musica",
      "destination": "https://savvia-musica.vercel.app/musica/"
    },
    {
      "source": "/musica/:path(.*)",
      "destination": "https://savvia-musica.vercel.app/musica/:path"
    }
  ],
  "redirects": [
    {
      "source": "/portfolio/neety",
      "destination": "/en/proyectos/neety",
      "permanent": true
    },
    {
      "source": "/es/portfolio/neety",
      "destination": "/proyectos/neety",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug*",
      "destination": "/en/proyectos",
      "permanent": true
    },
    {
      "source": "/es/portfolio/:slug*",
      "destination": "/proyectos",
      "permanent": true
    },
    {
      "source": "/manifesto",
      "destination": "/en/manifiesto",
      "permanent": true
    },
    {
      "source": "/es/manifesto",
      "destination": "/manifiesto",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/en/privacidad",
      "permanent": true
    },
    {
      "source": "/es/privacy-policy",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/en/aviso-legal",
      "permanent": true
    },
    {
      "source": "/es/terms-conditions",
      "destination": "/aviso-legal",
      "permanent": true
    },
    {
      "source": "/:viejo(pricing|tiny-web|mure-data-treseiscero|home-test-no-index)",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/proyectos",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        }
      ],
      "destination": "/en/proyectos",
      "permanent": false
    },
    {
      "source": "/proyectos/:slug*",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        }
      ],
      "destination": "/en/proyectos/:slug*",
      "permanent": false
    },
    {
      "source": "/manifiesto",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        }
      ],
      "destination": "/en/manifiesto",
      "permanent": false
    }
  ]
}
