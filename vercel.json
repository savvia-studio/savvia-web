{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/favicon-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/apple-touch-icon-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/:f(savvia-logo.svg|og.png|og.jpg|og.webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/musica-clara",
      "destination": "https://savvia-musica.vercel.app/musica/clara/"
    },
    {
      "source": "/musica-clara/",
      "destination": "https://savvia-musica.vercel.app/musica/clara/"
    },
    {
      "source": "/musica",
      "destination": "https://savvia-musica.vercel.app/musica/"
    },
    {
      "source": "/musica/:path(.*)",
      "destination": "https://savvia-musica.vercel.app/musica/:path"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.savvia.studio"
        }
      ],
      "destination": "https://savvia.studio/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.savvia.studio"
        }
      ],
      "destination": "https://savvia.studio/:path",
      "permanent": true
    },
    {
      "source": "/portfolio/neety",
      "destination": "/en/proyectos/neety",
      "permanent": true
    },
    {
      "source": "/es/portfolio/neety",
      "destination": "/proyectos/neety",
      "permanent": true
    },
    {
      "source": "/portfolio/:slug*",
      "destination": "/en/proyectos",
      "permanent": true
    },
    {
      "source": "/es/portfolio/:slug*",
      "destination": "/proyectos",
      "permanent": true
    },
    {
      "source": "/manifesto",
      "destination": "/en/manifiesto",
      "permanent": true
    },
    {
      "source": "/es/manifesto",
      "destination": "/manifiesto",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/en/privacidad",
      "permanent": true
    },
    {
      "source": "/es/privacy-policy",
      "destination": "/privacidad",
      "permanent": true
    },
    {
      "source": "/terms-conditions",
      "destination": "/en/aviso-legal",
      "permanent": true
    },
    {
      "source": "/es/terms-conditions",
      "destination": "/aviso-legal",
      "permanent": true
    },
    {
      "source": "/:viejo(pricing|tiny-web|mure-data-treseiscero|home-test-no-index)",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|facebookexternalhit|Facebot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Googlebot|bingbot|Applebot|DuckDuckBot).*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/proyectos",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|facebookexternalhit|Facebot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Googlebot|bingbot|Applebot|DuckDuckBot).*"
        }
      ],
      "destination": "/en/proyectos",
      "permanent": false
    },
    {
      "source": "/proyectos/:slug*",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|facebookexternalhit|Facebot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Googlebot|bingbot|Applebot|DuckDuckBot).*"
        }
      ],
      "destination": "/en/proyectos/:slug*",
      "permanent": false
    },
    {
      "source": "/manifiesto",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "(US|GB|IE|CA|AU|NZ|ZA|SG|IN)"
        }
      ],
      "missing": [
        {
          "type": "cookie",
          "key": "savvia-lang"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Twitterbot|Discordbot|facebookexternalhit|Facebot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Googlebot|bingbot|Applebot|DuckDuckBot).*"
        }
      ],
      "destination": "/en/manifiesto",
      "permanent": false
    }
  ]
}
