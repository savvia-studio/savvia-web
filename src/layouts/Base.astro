---
import '../styles/global.css';
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  description?: string;
  carga?: boolean; // ronda 62: solo la home tiene la animación de carga (las páginas de proyectos, no)
}
const {
  carga = true,
  title = 'savvia — Tu web, a la altura de lo que haces',
  description = 'Tu web, a la altura de lo que haces. savvia es el estudio web de Eric y Andoni que orquesta la IA. Desde Donostia.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="es" data-carga={carga ? '1' : '0'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- RONDA 38 · metadatos para compartir (og/twitter en URL absoluta; `site` = https://savvia.studio) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="savvia" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.jpg?v=140', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="savvia: el roble en acuarela bajo el titular «Tu web, a la altura de lo que haces»" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.jpg?v=140', Astro.site)} />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=144" />
    <!-- Borrador: no indexar hasta tener licencias de fuentes y visto bueno. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=144" />
    <meta name="theme-color" content="#3b231b" />
    <Font cssVariable="--font-family-display" preload />
    <Font cssVariable="--font-areal" preload />
    <Font cssVariable="--font-areal-mono" />
    <Font cssVariable="--font-manrope" />
    <Font cssVariable="--font-plex-mono" />
    <Font cssVariable="--font-bricolage" />
    <Font cssVariable="--font-switzer" />
    <!-- Todo lo que deba correr durante el parseo va aquí, en línea (los <script> de Astro son diferidos). -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // La ESTACIÓN de la web (ronda 39; ronda 40: por meses y con la paleta de Andoni): fondo oscuro, árbol y raíces. Antes del primer pintado
      // (regla dura 3). Primavera mar–may · verano jun–ago · otoño sep–nov · invierno dic–feb. `?estacion=invierno` la fuerza (para revisar).
      (function () {
        var q = /[?&]estacion=(otono|invierno|primavera|verano)/.exec(location.search), m = new Date().getMonth() + 1;
        var e = q ? q[1] : m >= 3 && m <= 5 ? 'primavera' : m >= 6 && m <= 8 ? 'verano' : m >= 9 && m <= 11 ? 'otono' : 'invierno';
        document.documentElement.dataset.estacion = e;
        var c = { otono: '#3b231b', invierno: '#eceff3', primavera: '#382a2d', verano: '#1f352a' }[e];
        document.querySelector('meta[name="theme-color"]').setAttribute('content', c);
      })();
      // RONDA 39 · la tipografía de texto está a prueba (ABC Areal): ?tipo=antes enseña la pareja anterior (Manrope + IBM Plex Mono)
      if (/[?&]tipo=antes/.test(location.search)) document.documentElement.classList.add('tipo-antes');
      // PRUEBA hero-claro (Eric, 03/10) · el hero sobre claro y lo que era claro, en oscuro: ?hero=blanco (blanco puro) o ?hero=claro (Rosa niebla).
      // Sin el parámetro no cambia nada. Para quitar la prueba: buscar «PRUEBA hero-claro» (Base, Hero, Nav, estela.ts)
      var hc = /[?&]hero=(claro|blanco)/.exec(location.search); if (hc) document.documentElement.classList.add('hero-claro', 'hero-' + hc[1], 'sobre-claro');
      // RONDA 64/68 · la transición de savia: la página nueva nace CUBIERTA de savia (html.vt-llega) y transicion.ts la escurre; salvavidas a los 3 s
      try { var vt = +sessionStorage.getItem('savvia:vt') || 0; sessionStorage.removeItem('savvia:vt'); if (Date.now() - vt < 4000 && !matchMedia('(prefers-reduced-motion: reduce)').matches) { document.documentElement.classList.add('vt-llega'); setTimeout(function () { document.documentElement.classList.remove('vt-llega'); }, 3000); } } catch (e) {}
      // RONDA 16 · los carriles cargan SIEMPRE puestos (ya no se recuerda si se quitaron) y se trazan al posarse la carga.
      // La carga: el hero nace desplazado 100 lvh (sube desde abajo). Con movimiento reducido no hay carga. Salvavidas: si el script
      // de la carga no llegara a correr, a los 8 s el hero vuelve a su sitio.
      // RONDA 69 · «la animación de carga inicial, que solo se ejecute la primera vez»: se recuerda en este navegador (localStorage) al terminarla o saltarla;
      // ?carga=1 la fuerza (para revisarla)
      // RONDA 83 · ?carga=1 la fuerza SIEMPRE: aunque ya se haya visto y aunque el sistema pida movimiento reducido (es para revisarla)
      var cargaPedida = /[?&]carga=1/.test(location.search);
      // RONDA 135 · «recupera la animación de carga siempre»: sale en cada visita; solo la saltan ?carga=0 y los navegadores automatizados con la clave puesta (pruebas)
      var cargaVista = /[?&]carga=0/.test(location.search);
      try { if (navigator.webdriver && localStorage.getItem('savvia:carga') === '1' && !cargaPedida) cargaVista = true; } catch (e) {}
      if (document.documentElement.dataset.carga === '1' && !cargaVista && (cargaPedida || !matchMedia('(prefers-reduced-motion: reduce)').matches)) {
        document.documentElement.classList.add('cargando');
        // RONDA 19: la carga la ARRANCA el visitante (mantener pulsado), así que el salvavidas ya no mira si la gota cayó: solo si el script de la carga no llegó a correr
        setTimeout(function () { if (!window.__cargaViva) document.documentElement.classList.remove('cargando'); }, 8000);
      } else document.documentElement.classList.add('carriles-entran', 'sin-carga'); // sin-carga (ronda 83): la parrilla del hero entra antes que el árbol
    </script>
  </head>
  <body>
    <a href="#contenido" class="detail sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-niebla focus:px-3 focus:py-2 focus:text-cacao">
      Saltar al contenido
    </a>
    <slot />
    <script>
      import '../scripts/entradas';
      import '../scripts/transicion';
      // ronda 134: fuera '../scripts/cta' (la gota de los CTA de cristal: el CTA ya es Coral lleno)
      import '../scripts/cta-liquido'; // ronda 136: el color del CTA primario entra como un líquido desde donde entra el cursor
      import '../scripts/clics'; // ronda 125: los sonidos de clic
    </script>
    <!-- RONDA 38 · Modo revisión · Agentation (portado de la web anterior, ronda 57): Eric abre savvia.studio/?feedback=1, clica un elemento, escribe la
         nota y Agentation devuelve un markdown con el selector CSS real. Sin ?feedback=1 no se pide ni un byte a la CDN. Sin import map a propósito: los
         `?deps=` de esm.sh reescriben las importaciones internas a las MISMAS URL (una sola instancia de React). Solo escritorio (no soporta móvil). -->
    <!-- RONDA 83 · Eric: «ponme agentation siempre»: en LOCAL (astro dev) va siempre puesto; publicada, ?feedback=1 se RECUERDA en ese navegador
         (localStorage «savvia:feedback») hasta ?feedback=0. Quien no lo haya pedido nunca sigue sin cargar nada. -->
    <script is:inline define:vars={{ dev: import.meta.env.DEV }}>
      (() => {
        const q = new URLSearchParams(location.search);
        let on = dev;
        try {
          if (q.has('feedback')) localStorage.setItem('savvia:feedback', q.get('feedback') === '0' ? '0' : '1');
          const g = localStorage.getItem('savvia:feedback');
          if (g) on = g === '1';
        } catch (e) { if (q.has('feedback')) on = q.get('feedback') !== '0'; }
        if (!on) return;
        const desktop = matchMedia('(hover:hover)').matches && innerWidth >= 900;
        if (!desktop) {
          if (!q.has('feedback')) return; // el aviso, solo si se ha pedido en esta visita
          const n = document.createElement('div');
          n.textContent = 'Modo feedback: solo escritorio.';
          n.style.cssText = 'position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:100001;font:11px/1 ui-monospace,monospace;letter-spacing:.08em;text-transform:uppercase;color:#EADDE7;background:#302018;border:1px solid #f65340;border-radius:6px;padding:9px 12px';
          addEventListener('DOMContentLoaded', () => document.body.appendChild(n));
          return;
        }
        const boot = async () => {
          try {
            const [React, dom, ag] = await Promise.all([
              import('https://esm.sh/react@18.3.1'),
              import('https://esm.sh/react-dom@18.3.1/client?deps=react@18.3.1'),
              import('https://esm.sh/agentation@3.0.2?deps=react@18.3.1,react-dom@18.3.1'),
            ]);
            const host = document.createElement('div');
            host.id = 'reviewRoot';
            document.body.appendChild(host);
            dom.createRoot(host).render(React.createElement(ag.Agentation));
          } catch (e) {
            console.error('[feedback] no se pudo cargar Agentation:', e && e.message);
          }
        };
        if (document.readyState === 'complete') boot();
        else addEventListener('load', boot, { once: true });
      })();
    </script>
  </body>
</html>
