---
// PRUEBA · el árbol del hero AISLADO (copa + raíces) para grabar el vídeo de redes (tools/grabar-arbol.cjs). Solo en desarrollo.
// La copa brota hacia arriba desde la gota (estela.ts, sin carga: la gota cae sola) y las raíces bajan a la vez desde el cuello.
// ?fondo=rrggbb cambia el fondo (por defecto, la noche de la estación) · ?est=0…3 la estación · ?grabar=1 espera a que el grabador mueva el reloj ·
// ?estaciones=1 (&cada=3.5): ya crecido, pasa por las cuatro estaciones y vuelve a la primera.
if (import.meta.env.PROD) return Astro.redirect('/');
import '../../styles/global.css';
---

<!doctype html>
<html lang="es" data-estacion="otono">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Árbol · vídeo</title>
    <link rel="icon" href="data:," />
    <script is:inline>
      var q = new URLSearchParams(location.search), e = ['otono', 'invierno', 'primavera', 'verano'][+(q.get('est') || 0)] || 'otono';
      document.documentElement.dataset.estacion = e;
    </script>
  </head>
  <body>
    <main class="escena" data-escena>
      <div class="arbol">
                <canvas data-lienzo-copa></canvas>
      </div>
      <div class="raices">
                <canvas data-lienzo-raiz></canvas>
      </div>
    </main>
  </body>
</html>

<script>
  import { crearEstela, ESTACIONES_SIN_RALEO, type Estela } from '../../scripts/estela';
  import { EST, NOCHE, estacionActual } from '../../scripts/estacion';
  type RGB = [number, number, number];
  const q = new URLSearchParams(location.search);
  const n0 = estacionActual();
  // ?fondo=rrggbb lo deja fijo; sin él, el fondo es la noche de cada estación y vira con ella (como en la web)
  const hex = q.get('fondo');
  const fijo: RGB | null = hex && /^[0-9a-f]{6}$/i.test(hex) ? ([0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16)) as RGB) : null;
  const fondoDe = (n: number): RGB => fijo ?? NOCHE[n];
  const pintarFondo = (c: RGB) => { document.documentElement.style.backgroundColor = document.body.style.backgroundColor = `rgb(${c.map(Math.round).join(' ')})`; };
  pintarFondo(fondoDe(n0));
  // las ocho láminas, precargadas: el cambio de estación no espera a la red (y el grabador mueve el reloj a su ritmo)
  const lamina = (k: 'arbol' | 'raices', n: number) => { const i = new Image(); i.src = `/media/hero/${k}-${EST[n]}.webp`; return i; };
  const COPAS = [0, 1, 2, 3].map((n) => lamina('arbol', n)), RAICES = [0, 1, 2, 3].map((n) => lamina('raices', n));
  // la copa, como en el hero (Hero.astro); las raíces, como en Raices.astro, hundidas en el mismo fondo (sin la mancha de tierra)
  const TINTE = [0, 0.8, 0.65, 0.5];
  const opCopa = (n: number, gota: boolean) => ({ origen: [0.5, 1] as [number, number], dir: -1 as const, soplo: n !== 1, gota, hd: true, sinLuz: true, intensidad: n === 2 ? 0.9 : 0 });
  const opRaiz = (n: number) => ({ origen: [0.5, 0] as [number, number], dir: 1 as const, soplo: n !== 1, nitido: n === 1, limpioArriba: 80, sinLuz: true, hd: true, estaciones: ESTACIONES_SIN_RALEO, intensidad: TINTE[n] });
  let cvCopa = document.querySelector<HTMLCanvasElement>('[data-lienzo-copa]')!, cvRaiz = document.querySelector<HTMLCanvasElement>('[data-lienzo-raiz]')!;
  const t = crearEstela(cvCopa, COPAS[n0], opCopa(n0, true));
  if (t && (n0 === 2 || n0 === 1)) t.estacion(n0);
  t?.fondo(...fondoDe(n0));
  const r = crearEstela(cvRaiz, RAICES[n0], opRaiz(n0));
  r?.estacion(n0);
  r?.fondo(...fondoDe(n0));
  r?.crecer(0);
  // CAMBIO DE ESTACIÓN · Eric: «esas transiciones circulares no me gustan tanto, algo más orgánico, que se vaya pasando de un estado a otro de forma
  // natural». La estación nueva no llega con un frente: brota a MANCHAS (ruido a varias escalas, como matas de hojas que viran a destiempo), con
  // canto blando, y la vieja se apaga en las mismas manchas (máscaras complementarias). Un leve sesgo: la copa empieza algo antes por abajo y las
  // raíces por el cuello. La máscara es un lienzo pequeño (se escala blando) que se umbraliza en cada fotograma.
  const MT = 3200; // ms
  const ruido = (seed: number) => {
    const P = new Float32Array(512).map((_, i) => Math.abs(Math.sin((i + 1) * 12.9898 + seed * 78.233) * 43758.5453) % 1);
    const v = (x: number, y: number) => {
      const xi = Math.floor(x), yi = Math.floor(y), fx = x - xi, fy = y - yi, sx = fx * fx * (3 - 2 * fx), sy = fy * fy * (3 - 2 * fy);
      const h = (i: number, j: number) => P[(((i * 57 + j * 131) % 512) + 512) % 512];
      return (h(xi, yi) * (1 - sx) + h(xi + 1, yi) * sx) * (1 - sy) + (h(xi, yi + 1) * (1 - sx) + h(xi + 1, yi + 1) * sx) * sy;
    };
    return (x: number, y: number) => v(x * 3, y * 3) * 0.5 + v(x * 7 + 11, y * 7) * 0.3 + v(x * 17, y * 17 + 5) * 0.2;
  };
  const revelar = (el: HTMLCanvasElement, oy: number, viejo: HTMLCanvasElement) => {
    const W = 220, H = Math.max(8, Math.round((W * el.offsetHeight) / el.offsetWidth)), f = new Float32Array(W * H), rn = ruido(Math.random() * 100);
    for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
      const dy = Math.abs(y / H - oy); // 0 = donde empieza (la base de la copa, el cuello de las raíces)
      f[y * W + x] = rn(x / W, (y / H) * (H / W)) * 0.78 + dy * 0.22;
    }
    let lo = 1, hi = 0; for (const z of f) { lo = Math.min(lo, z); hi = Math.max(hi, z); }
    for (let i = 0; i < f.length; i++) f[i] = (f[i] - lo) / (hi - lo);
    const mk = (n: number) => { const c = document.createElement('canvas'); c.width = W; c.height = H; return c; };
    const cA = mk(0), cB = mk(1), xA = cA.getContext('2d')!, xB = cB.getContext('2d')!, dA = xA.createImageData(W, H), dB = xB.createImageData(W, H);
    const E = 0.22; // el canto blando, en fracción del campo
    const pon = (cv: HTMLCanvasElement, m: string) => { cv.style.setProperty('-webkit-mask', m); cv.style.setProperty('mask', m); };
    const pintar = (k: number) => {
      const t = k * (1 + E);
      for (let i = 0; i < f.length; i++) {
        const z = Math.min(1, Math.max(0, (t - f[i]) / E)), m = z * z * (3 - 2 * z);
        dA.data[i * 4 + 3] = m * 255; dB.data[i * 4 + 3] = (1 - m) * 255;
      }
      xA.putImageData(dA, 0, 0); xB.putImageData(dB, 0, 0);
      pon(el, `url(${cA.toDataURL()}) 0 0 / 100% 100% no-repeat`);
      pon(viejo, `url(${cB.toDataURL()}) 0 0 / 100% 100% no-repeat`);
    };
    pintar(0);
    let a = 0;
    const paso = (ahora: number) => {
      if (!a) a = ahora;
      const k = Math.min(1, (ahora - a) / MT);
      pintar(k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);
      if (k < 1) requestAnimationFrame(paso);
      else { pon(el, ''); const g = viejo.getContext('webgl2') || viejo.getContext('webgl'); g?.getExtension('WEBGL_lose_context')?.loseContext(); viejo.remove(); }
    };
    requestAnimationFrame(paso);
  };
  const nuevo = (viejo: HTMLCanvasElement, img: HTMLImageElement, op: any, n: number, oy: number, esCopa: boolean): HTMLCanvasElement => {
    const cv = viejo.cloneNode(false) as HTMLCanvasElement; cv.classList.remove('listo'); viejo.after(cv);
    const e = crearEstela(cv, img, op) as Estela;
    if (!esCopa || n === 1 || n === 2) e.estacion(n);
    e.fondo(...fondoDe(n)); e.crecer(1);
    revelar(cv, oy, viejo);
    return cv;
  };
  // el fondo vira con la estación (2,4 s, como --noche en global.css), con el reloj de la página
  const virarFondo = (de: RGB, a: RGB) => {
    if (fijo) return;
    let t0 = 0;
    const paso = (ahora: number) => {
      if (!t0) t0 = ahora;
      const k = Math.min(1, (ahora - t0) / 2400), e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
      pintarFondo(de.map((c, i) => c + (a[i] - c) * e) as RGB);
      if (k < 1) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };
  let est = n0;
  const cambiar = () => {
    const n = (est + 1) % 4, de = fondoDe(est);
    est = n;
    cvCopa = nuevo(cvCopa, COPAS[n], opCopa(n, false), n, 1, true);
    virarFondo(de, fondoDe(n));
    let t0 = 0;
    const espera = (ahora: number) => { if (!t0) t0 = ahora; if (ahora - t0 < 450) return void requestAnimationFrame(espera); cvRaiz = nuevo(cvRaiz, RAICES[n], opRaiz(n), n, 0, false); };
    requestAnimationFrame(espera);
  };
  // el reloj: la gota de la copa cae en cuanto el lienzo pinta (0,95 s) y la copa crece 3,6 s; las raíces, con la misma curva y a la vez.
  // ?estaciones=1: después, cada ?cada= s (3,5 por defecto) la estación siguiente, hasta dar la vuelta entera y volver a la primera
  const INTRO = 1.05, CRECE = 3.6, REPOSO = 2.8, CADA = +(q.get('cada') || 4.2);
  const CAMBIOS = q.has('estaciones') ? [0, 1, 2, 3].map((i) => INTRO + CRECE + REPOSO + i * CADA) : [];
  const empezar = () => {
    let t0 = 0, hechos = 0;
    t?.visible(true);
    const paso = (ahora: number) => {
      if (!t0) t0 = ahora;
      const s = (ahora - t0) / 1000, k = Math.min(1, Math.max(0, (s - INTRO) / CRECE));
      r?.crecer(1 - Math.pow(1 - k, 1.6));
      while (hechos < CAMBIOS.length && s >= CAMBIOS[hechos]) { hechos++; cambiar(); }
      if (k < 1 || hechos < CAMBIOS.length) requestAnimationFrame(paso);
    };
    requestAnimationFrame(paso);
  };
  const w = window as any;
  w.__empezar = empezar;
  const listas = Promise.all([...COPAS, ...RAICES].map((i) => (i.complete ? Promise.resolve() : new Promise((ok) => i.addEventListener('load', ok, { once: true })))));
  listas.then(() => { w.__listo = true; if (!q.has('grabar')) empezar(); });
</script>

<style is:global>
  /* sin la franja de 3 px del móvil (global.css, ronda 292): se graba a 540 px de ancho */
  html::after { display: none; }
  html,
  body {
    margin: 0;
    height: 100%;
    overflow: hidden;
    background-image: none;
  }
  .escena {
    --w: min(88vw, 88vh * 1260 / 944);
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .arbol,
  .raices {
    position: relative;
    width: var(--w);
  }
  .arbol { aspect-ratio: 1260 / 583; }
  .raices { aspect-ratio: 1260 / 361; }
  canvas,
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  img { opacity: 0; }
  canvas { opacity: 0; }
  canvas.listo { opacity: 1; }
</style>
