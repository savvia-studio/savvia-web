---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Cargador from '../components/Cargador.astro';
import Hero from '../components/Hero.astro';
import Raices from '../components/Raices.astro';
import Dolores from '../components/Dolores.astro'; // ronda 51 · dirección A «el roble que sana» (a prueba; la anterior sigue en Recorrido.astro)
import DoloresB from '../components/DoloresB.astro'; // ronda 51 · dirección B «tachado» (a prueba)
import LaSavvia from '../components/LaSavvia.astro'; // ronda 53: guardada (la sustituye LaReceta)
import LaReceta from '../components/LaReceta.astro';
import Proyectos from '../components/Proyectos.astro';
import Anteriores from '../components/Anteriores.astro';
import Servicios from '../components/Servicios.astro';
import Estudio from '../components/Estudio.astro';
import Preguntas from '../components/Preguntas.astro';
import Pie from '../components/Pie.astro';
---

<Base>
  <Nav />
  <Carriles />
  <Cargador />
  <main id="contenido">
    <!-- RONDA 39 · «reestructuramos la web: hero > pains > proyectos destacados > nuestros proyectos > servicios > savvia es la receta de
         tu web > equipo > FAQs > footer» -->
    <Hero />
    <Raices />
    <!-- RONDA 51 · PRUEBA de la sección 2: sin parámetro → la A2 (tarjetas de agua; publicada en la ronda 52) · `?s2=b` → la B (tachado) · `?s2=a` → la A (el roble que sana).
         Se decide antes del primer pintado. -->
    <script is:inline>document.documentElement.dataset.s2 = new URLSearchParams(location.search).get('s2') || 'a2';</script>
    <Dolores />
    <Dolores id="recorrido-a2" tarjetas />
    <DoloresB />
    <Proyectos />
    <Anteriores />
    <Servicios />
    <LaReceta />
    <Estudio />
    <Preguntas />
  </main>
  <Pie />
</Base>
