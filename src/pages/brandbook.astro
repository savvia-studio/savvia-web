---
// RONDA 144 · EL BRANDBOOK. Andoni: «si podemos montar un brandbook como este sería top» (referencia: el vídeo de kargul.studio, x.com/marcelkargul,
// 08/10/2026: un documento web con índice lateral fijo y una sola columna larga). Aquí, el sistema REAL de savvia, sacado de sus tokens (global.css),
// sus scripts y su diccionario (AGENTS.md): nada inventado. La versión anterior, en tools/r144/brandbook.v1.astro.txt.
// RONDA 144 (2.ª) · Andoni: «el isotipo es distinto al resto (el de la carga): tiene que ir el del resto de sitios · que se muestre la CONSTRUCCIÓN del
// logotipo con sus curvas · el color organizado por estaciones, con sus paletas, y que el brandbook pase por esas estaciones · en componentes tenemos más:
// añadirlos todos · en textura y movimiento también hay más: añadirlo bien».
//   · El isotipo es la v del logotipo (savvia-isotipo.svg ya es su primer trazo).
//   · CONSTRUCCIÓN: los trazos del logotipo leídos al compilar (M · C · L · H · V · Z absolutos): contorno, anclas (cuadrados), manejadores (líneas y
//     puntos) y las líneas de la letra (base, altura de x, ascendentes); se dibuja al llegar.
//   · COLOR: cuatro paneles a sangre, uno por estación, con su noche de fondo y su paleta; al pasar por cada uno, la página ENTERA cambia a esa estación
//     (fijarEstacion: el acento, la barra, el pie) y al salir del tramo vuelve a la de hoy.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import Cta from '../components/Cta.astro';
import { flecha } from '../lib/flecha';
import logoRaw from '../../public/savvia-palabra.svg?raw'; // ronda 145: el logotipo es la palabra en Family (sin isotipo)

const indice = [
  ['logotipo', 'Logotipo'],
  ['construccion', 'Construcción'],
  ['color', 'Color y estaciones'],
  ['tipografia', 'Tipografía'],
  ['voz', 'Voz'],
  ['componentes', 'Componentes'],
  ['materia', 'Textura y movimiento'],
  ['aplicaciones', 'Aplicaciones'],
] as const;

// ── LA CONSTRUCCIÓN: anclas y manejadores de cada trazo del logotipo (comandos absolutos)
const trazos = [...logoRaw.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]);
type Pt = [number, number];
const anclas: Pt[] = [], manejos: [Pt, Pt][] = [], controles: Pt[] = [];
const cajas: { x0: number; x1: number; y0: number; y1: number }[] = [];
for (const d of trazos) {
  const tk = d.match(/[MCQLHVZ]|-?\d*\.?\d+(?:e-?\d+)?/gi) ?? [];
  let i = 0, cmd = '', cx = 0, cy = 0;
  const n = () => parseFloat(tk[i++]);
  const caja = { x0: 1e9, x1: -1e9, y0: 1e9, y1: -1e9 };
  const mete = (p: Pt) => { caja.x0 = Math.min(caja.x0, p[0]); caja.x1 = Math.max(caja.x1, p[0]); caja.y0 = Math.min(caja.y0, p[1]); caja.y1 = Math.max(caja.y1, p[1]); };
  while (i < tk.length) {
    if (/[MCQLHVZ]/i.test(tk[i])) cmd = tk[i++].toUpperCase();
    if (cmd === 'Z') continue;
    if (cmd === 'M' || cmd === 'L') { cx = n(); cy = n(); anclas.push([cx, cy]); mete([cx, cy]); if (cmd === 'M') cmd = 'L'; }
    else if (cmd === 'H') { cx = n(); anclas.push([cx, cy]); mete([cx, cy]); }
    else if (cmd === 'V') { cy = n(); anclas.push([cx, cy]); mete([cx, cy]); }
    else if (cmd === 'C') {
      const a: Pt = [n(), n()], b: Pt = [n(), n()], e: Pt = [n(), n()];
      manejos.push([[cx, cy], a], [b, e]); controles.push(a, b); anclas.push(e); mete(e);
      cx = e[0]; cy = e[1];
    } else if (cmd === 'Q') {
      const a: Pt = [n(), n()], e: Pt = [n(), n()];
      manejos.push([[cx, cy], a], [a, e]); controles.push(a); anclas.push(e); mete(e);
      cx = e[0]; cy = e[1];
    } else i++;
  }
  cajas.push(caja);
}
// las líneas de la letra (Family, 1000 por em): la base en 0, la altura de x en 462 (OS/2) y las ascendentes, lo más alto de la palabra (el punto de la i)
const base = 0, xAlto = -462;
const ascend = Math.round(Math.min(...cajas.map((c) => c.y0)));
const f = (v: number) => v.toFixed(1);
const dManejos = manejos.map(([a, b]) => `M${f(a[0])} ${f(a[1])}L${f(b[0])} ${f(b[1])}`).join('');

const base6_r144 = [
  { n: 'Cacao', hex: '#302018', uso: 'La tinta y la noche. Texto sobre claro, fondos oscuros.', claro: false },
  { n: 'Nogal', hex: '#63402F', uso: 'La madera. Superficies cálidas y estados de pulsado.', claro: false },
  { n: 'Rosa niebla', hex: '#EADDE7', uso: 'El papel. Fondos claros y texto sobre oscuro.', claro: true },
  { n: 'Salvia', hex: '#96BFE6', uso: 'El cielo. Solo el fondo de Servicios.', claro: true },
  { n: 'Cobalto', hex: '#3456D3', uso: 'Detalles mínimos de las ilustraciones.', claro: false },
  { n: 'Cereza', hex: '#B52C4C', uso: 'Reservado. Aún sin uso.', claro: false },
];
const estaciones = [
  { id: 'primavera', n: 'Primavera', meses: 'marzo – mayo', noche: '#382A2D', honda: '#382A2D', arbol: '#C76B83', acento: '#FF7FAE', tinta: '#EFDEE6', papel: '#EFDEE6', madera: '#6A3F47', cielo: '#A8C6EC', detalle: '#4A5FD0', fruto: '#C23A62', de: 'el cerezo', frase: 'El roble florece en rosa; la savia es el cerezo.' },
  { id: 'verano', n: 'Verano', meses: 'junio – agosto', noche: '#1F352A', honda: '#1F352A', arbol: '#67834D', acento: '#A6D96A', tinta: '#E9E0DF', papel: '#E9E0DF', madera: '#5F4A31', cielo: '#8EC4E6', detalle: '#2F6FCF', fruto: '#A8433C', de: 'la hoja nueva', frase: 'Verdes hondos y luces lima; la savia es la hoja nueva.' },
  { id: 'otono', n: 'Otoño', meses: 'septiembre – noviembre', noche: '#3B231B', honda: '#3B231B', arbol: '#C65C2D', acento: '#FF616B', tinta: '#EADDE7', papel: '#EADDE7', madera: '#63402F', cielo: '#96BFE6', detalle: '#3456D3', fruto: '#B52C4C', de: 'el Coral de siempre', frase: 'La casa: Cacao, cobre y el Coral de la savia.' },
  { id: 'invierno', n: 'Invierno', meses: 'diciembre – febrero', noche: '#ECEFF3', honda: '#2A2932', arbol: '#6E7B91', acento: '#4F8AD6', tinta: '#302018', papel: '#E5E8EE', madera: '#4C403D', cielo: '#A9BFD6', detalle: '#3E5A9E', fruto: '#8E2F4A', de: 'el cielo de enero', frase: 'La web se vuelve nieve; el roble, desnudo; la savia, el azul glaciar.' },
];
const escala = [
  ['H1', 'var(--text-h1)', '44 → 72', 'Family 400', 'display'],
  ['H2', 'var(--text-h2)', '34 → 48', 'Family 400', 'display'],
  ['H3', 'var(--text-h3)', '26 → 32', 'Family 400', 'display'],
  ['Lead', 'var(--text-lead)', '20', 'ABC Areal 400', 'sans'],
  ['Cuerpo', 'var(--text-body)', '17 → 18', 'ABC Areal 400', 'sans'],
  ['Interfaz', 'var(--text-ui)', '16', 'ABC Areal 500', 'sans'],
  ['Detalle', 'var(--text-detail)', '13', 'ABC Areal Mono 400', 'mono'],
] as const;
const seDice = ['orquestar', 'criterio', 'elevar', 'desarrollo agéntico', 'a medida', 'de principio a fin', 'documentado', 'fuente de verdad', 'claridad', 'contigo', 'Eric y Andoni', 'Donostia'];
const noSeDice = ['prompt', 'vibe coding', '«lavado de cara»', 'años de experiencia', 'número de clientes', '«pioneros»', 'jerga de generador'];
const check = `<svg class="chk" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8.25" /><path d="M6 10.4 8.7 13 14 7.2" pathLength="1" /></svg>`;
---

<Base title="Brandbook — savvia" description="El sistema de marca de savvia: logotipo y su construcción, color por estaciones, tipografía, voz, componentes y movimiento." carga={false}>
  <Nav />
  <Carriles />
  <main id="contenido" class="libro surface-light">
    <div class="wrap marco-libro">
      <nav class="indice" aria-label="Secciones del brandbook">
        <p class="detail detail-caps text-fg2">Brandbook</p>
        <ol>
          {indice.map(([id, t], i) => (
            <li><a href={`#${id}`} data-ir={id}><span class="detail n">{String(i + 1).padStart(2, '0')}</span>{t}</a></li>
          ))}
        </ol>
      </nav>

      <div class="hojas">
        <header class="portada">
          <h1 class="font-display titular" data-entra>La marca, en una página.</h1>
          <p class="text-sub text-fg2 mt-6 measure" data-enfoca>Cómo se ve, cómo suena y cómo se mueve savvia. Todo lo que hay aquí sale del sistema real de la web.</p>
          <div class="cubierta">
            <span class="logo-masc" role="img" aria-label="savvia"></span>
            <span class="detail pie-cub">savvia · Donostia · desde 2020</span>
          </div>
        </header>

        <!-- 01 · LOGOTIPO -->
        <section id="logotipo" class="seccion" aria-labelledby="h-logotipo">
          <h2 id="h-logotipo" class="font-display text-h2">Logotipo</h2>
          <p class="cuerpo">El logotipo es la palabra: «savvia» en Family, la letra de los titulares, siempre en minúscula (también a principio de frase). Sin isotipo. El favicon es su «s».</p>
          <div class="fila f2">
            <figure class="placa oscura"><span class="logo-masc" role="img" aria-label="savvia sobre Cacao"></span><figcaption class="detail">Sobre Cacao · Rosa niebla</figcaption></figure>
            <figure class="placa clara"><span class="logo-masc" role="img" aria-label="savvia sobre Rosa niebla"></span><figcaption class="detail">Sobre Rosa niebla · Cacao</figcaption></figure>
          </div>
          <div class="fila f3">
            <figure class="placa oscura sm"><img class="fav" src="/favicon.svg?v=145" alt="Favicon" width="64" height="64" /><figcaption class="detail">Favicon · la «s»</figcaption></figure>
            <figure class="placa clara sm"><span class="logo-masc peq" role="img" aria-label="savvia en pequeño"></span><figcaption class="detail">Tamaño mínimo · 16 px de alto</figcaption></figure>
            <figure class="placa oscura sm"><span class="font-display en-texto">Hecho con <span class="logo-masc linea" role="img" aria-label="savvia"></span></span><figcaption class="detail">Dentro de una frase · a la altura de la letra</figcaption></figure>
          </div>
          <ul class="reglas">
            <li><b>Aire</b> alrededor, como mínimo, la altura de x de la palabra. Tamaño mínimo: 16 px de alto en pantalla.</li>
            <li><b>Sí</b> en Cacao o Rosa niebla, macizo, sobre fondo liso. <b>No</b> se estira, no se gira, no lleva sombra ni degradado, no cambia con la estación.</li>
          </ul>
        </section>

        <!-- 02 · CONSTRUCCIÓN -->
        <section id="construccion" class="seccion" aria-labelledby="h-construccion">
          <h2 id="h-construccion" class="font-display text-h2">Construcción</h2>
          <p class="cuerpo">La palabra, en Family 400 con un apretado de −0,02 em: {anclas.length} anclas y {controles.length} manejadores. Las letras viven entre la línea base y la altura de x; solo el punto de la i sube hasta las ascendentes.</p>
          <figure class="construccion" data-construccion>
            <svg viewBox="-20 -720 2500 770" aria-hidden="true">
              <g class="guias">
                <line x1="-20" x2="2480" y1={base} y2={base} /><text x="2480" y={base - 14}>línea base</text>
                <line x1="-20" x2="2480" y1={xAlto} y2={xAlto} /><text x="2480" y={xAlto - 14}>altura de x</text>
                <line x1="-20" x2="2480" y1={ascend} y2={ascend} /><text x="2480" y={ascend - 14}>ascendentes</text>
              </g>
              <g class="relleno">{trazos.map((d) => <path d={d} />)}</g>
              <g class="contorno">{trazos.map((d) => <path d={d} pathLength="1" />)}</g>
              <path class="manejos" d={dManejos} />
              <g class="controles">{controles.map(([x, y]) => <circle cx={f(x)} cy={f(y)} r="3.2" />)}</g>
              <g class="anclas">{anclas.map(([x, y]) => <rect x={f(x - 3.6)} y={f(y - 3.6)} width="7.2" height="7.2" />)}</g>
            </svg>
            <figcaption class="detail leyenda"><span><i class="lg-a"></i>ancla</span><span><i class="lg-c"></i>manejador</span><span><i class="lg-g"></i>líneas de la letra</span></figcaption>
          </figure>
        </section>

        <!-- 03 · COLOR Y ESTACIONES -->
        <section id="color" class="seccion" aria-labelledby="h-color">
          <h2 id="h-color" class="font-display text-h2">Color y estaciones</h2>
          <p class="cuerpo">No hay una paleta común: cada estación tiene la suya, de diez colores. Cinco cambian de verdad —el fondo, el cristal, el roble, la savia y la tinta— y cinco viran apenas para entonar con ellos —el papel, la madera, el cielo, el detalle y el fruto—. Al bajar, esta página pasa por las cuatro.</p>
        </section>
      </div>
    </div>

    <!-- RONDA 144 (3.ª) · «en color y estaciones, que los colores que están cambien con la estación»: UNA escena fija (sticky) durante cuatro pantallas;
         al bajar, la estación avanza y todo cambia con ella: la noche del fondo, el roble, la paleta (sus muestras leen los colores de la página) y sus
         valores. La página entera la sigue (fijarEstacion); al salir del tramo vuelve la de hoy. -->
    <div class="estaciones" data-estaciones style={`--n:${estaciones.length}`}>
      <div class="escena-est" data-escena-est data-actual="0">
        <div class="wrap est-dentro">
          <div class="est-txt">
            <div class="est-pila">
              {estaciones.map((e, i) => (
                <div class={`est-cab ${i === 0 ? 'on' : ''}`} data-cab={i}>
                  <p class="detail detail-caps">{e.meses}</p>
                  <h3 class="font-display est-n">{e.n}</h3>
                  <p class="est-frase">{e.frase}</p>
                </div>
              ))}
            </div>
            <ol class="est-puntos" aria-hidden="true">{estaciones.map((e, i) => <li class={i === 0 ? 'on' : ''} data-punto={i}>{e.n}</li>)}</ol>
          </div>
          <div class="est-robles">
            {estaciones.map((e, i) => <img class={i === 0 ? 'on' : ''} data-roble={i} src={`/media/hero/arbol-${e.id}.webp`} alt={i === 0 ? 'El roble de la estación' : ''} loading="lazy" decoding="async" />)}
          </div>
          <ul class="est-paleta">
            {[
              ['Noche', 'var(--noche)', 'el fondo', 'noche'],
              ['Noche honda', 'var(--noche-honda)', 'el cristal', 'honda'],
              ['Roble', 'var(--arbol)', 'la hoja', 'arbol'],
              ['Savia', 'var(--color-coral)', 'el acento', 'acento'],
              ['Tinta', 'var(--tinta-est)', 'el texto', 'tinta'],
              ['Papel', 'var(--color-niebla)', 'los fondos claros', 'papel'],
              ['Madera', 'var(--color-nogal)', 'lo cálido', 'madera'],
              ['Cielo', 'var(--color-salvia)', 'Servicios', 'cielo'],
              ['Detalle', 'var(--color-cobalto)', 'las ilustraciones', 'detalle'],
              ['Fruto', 'var(--color-cereza)', 'la receta', 'fruto'],
            ].map(([n, v, u, k]) => (
              <li style={`--c:${v}`}><i class="est-m" /><span class="est-mn">{n}</span><span class="detail" data-hex={k}>{(estaciones[0] as any)[k]}</span><span class="detail est-u">{u}</span></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
    <script type="application/json" data-estaciones-datos set:html={JSON.stringify(estaciones)} />

    <div class="wrap marco-libro">
      <div class="indice-hueco" aria-hidden="true"></div>
      <div class="hojas">
        <!-- RONDA 150 · las cuatro paletas, una junto a otra, para consultarlas de un vistazo -->
        <section class="seccion sin-borde" aria-label="Las cuatro paletas">
          <!-- RONDA 151 · «el resumen de cada estación con su paleta, más visual y no tan pequeño»: una tarjeta grande por estación, sobre su propia noche,
               con sus diez colores en franjas altas (las cinco que cambian, más anchas; las cinco que viran, más estrechas) -->
          <div class="paletas">
            {estaciones.map((e) => (
              <article class={`paleta ${e.id === 'invierno' ? 'clara' : ''}`} style={`--pn:${e.noche};--pt:${e.tinta}`}>
                <header class="pl-cab"><p class="pl-n font-display">{e.n}</p><p class="detail pl-m">{e.meses}</p></header>
                <ul class="pl-franjas">
                  {[['Noche', e.noche, 1], ['Noche honda', e.honda, 1], ['Roble', e.arbol, 1], ['Savia', e.acento, 1], ['Tinta', e.tinta, 1], ['Papel', e.papel, 0], ['Madera', e.madera, 0], ['Cielo', e.cielo, 0], ['Detalle', e.detalle, 0], ['Fruto', e.fruto, 0]].map(([n, h, mayor]) => (
                    <li class={mayor ? 'mayor' : ''} style={`--c:${h}`}><span class="pl-t"><b>{n}</b><span class="detail">{h}</span></span></li>
                  ))}
                </ul>
              </article>
            ))}
          </div>
        </section>
        <section class="seccion sin-borde" aria-label="Reglas del color">
          <ul class="reglas">
            <li><b>Contraste</b> la tinta sobre la noche de cada estación pasa de 9:1 (en invierno, Cacao sobre la nieve 15:1).</li>
            <li><b>Sin</b> degradados, brillos ni sombras por defecto. La savia es un punto, un filo, lo que se mueve; nunca texto pequeño sobre claro.</li>
          </ul>
        </section>

        <!-- 04 · TIPOGRAFÍA -->
        <section id="tipografia" class="seccion" aria-labelledby="h-tipografia">
          <h2 id="h-tipografia" class="font-display text-h2">Tipografía</h2>
          <p class="cuerpo">Tres voces: Family para lo que se dice, ABC Areal para lo que se lee y ABC Areal Mono para los detalles. Sin cursivas, nunca.</p>
          <div class="fila f3 familias">
            <figure class="placa clara fam"><span class="font-display aa">Aa</span><figcaption><b>Family</b><span class="detail">Titulares · 400</span></figcaption></figure>
            <figure class="placa clara fam"><span class="aa sans">Aa</span><figcaption><b>ABC Areal</b><span class="detail">Texto e interfaz · 400 · 500</span></figcaption></figure>
            <figure class="placa clara fam"><span class="aa mono">Aa</span><figcaption><b>ABC Areal Mono</b><span class="detail">Detalles · 400</span></figcaption></figure>
          </div>
          <ol class="escala">
            {escala.map(([n, v, px, fam, cls]) => (
              <li>
                <span class="detail e-n">{n}</span>
                <span class={`e-m ${cls}`} style={`font-size:${v}`}>Elevamos tu web</span>
                <span class="detail e-d">{px} px · {fam}</span>
              </li>
            ))}
          </ol>
        </section>

        <!-- 05 · VOZ -->
        <section id="voz" class="seccion" aria-labelledby="h-voz">
          <h2 id="h-voz" class="font-display text-h2">Voz</h2>
          <p class="cuerpo">Se habla siempre a quien entra; la primera persona, solo cuando hablan Eric y Andoni. No se presume: el trabajo lo demuestra.</p>
          <div class="fila f2">
            <div class="placa clara lista-voz"><p class="detail detail-caps">Se dice</p><ul>{seDice.map((w) => <li>{w}</li>)}</ul></div>
            <div class="placa clara lista-voz no"><p class="detail detail-caps">No se dice</p><ul>{noSeDice.map((w) => <li>{w}</li>)}</ul></div>
          </div>
          <blockquote class="font-display ejemplo">«Elevamos tu web con IA.»<span class="detail">El titular: corto, a quien entra, con el verbo delante.</span></blockquote>
        </section>

        <!-- 06 · COMPONENTES -->
        <section id="componentes" class="seccion" aria-labelledby="h-componentes">
          <h2 id="h-componentes" class="font-display text-h2">Componentes</h2>
          <p class="cuerpo">Un solo idioma para todo lo que se pulsa: el cristal de la barra de la vista sentado, chevrones finos y, al pasar, la niebla lo llena como un líquido desde donde entra el cursor.</p>

          <div class="comp">
            <h3 class="comp-t">Botones</h3>
            <div class="placa oscura demos">
              <Cta href="#componentes">Cuéntanos tu proyecto</Cta>
              <Cta href="#componentes" tam="sm">Ver la web</Cta>
              <Cta href="#componentes" variante="secundario">Ver caso de estudio</Cta>
              <Cta href="#componentes" variante="secundario" flecha="izq">Proyectos</Cta>
            </div>
            <p class="comp-d detail">Primario: cristal (noche al 58 %, desenfoque 22 px, filo claro 16 %), ABC Areal 500, sin mayúsculas · Pequeño: 40 px · Secundario: texto y chevrón, sin caja.</p>
          </div>

          <div class="comp">
            <h3 class="comp-t">Barra de cristal</h3>
            <div class="placa oscura demos">
              <div class="barra-cristal" role="group" aria-label="Ejemplo de barra">
                <button type="button" class="paso" aria-label="Anterior"><Fragment set:html={flecha('izq')} /></button>
                <p class="cual"><span class="n">02/04</span><span>Arkdev</span></p>
                <button type="button" class="paso" aria-label="Siguiente"><Fragment set:html={flecha()} /></button>
              </div>
              <div class="barra-cristal" role="group" aria-label="Ejemplo de paginación">
                <button type="button" class="paso" aria-label="Anterior" disabled><Fragment set:html={flecha('izq')} /></button>
                <p class="cual"><span class="n">Página</span><span>01/03</span></p>
                <button type="button" class="paso" aria-label="Siguiente"><Fragment set:html={flecha()} /></button>
              </div>
            </div>
            <p class="comp-d detail">Para pasar de una cosa a otra: los destacados, las páginas del portfolio, los testimonios y los proyectos con la vista sentado. Sobre claro, la misma barra sin velo (filete del color de las reglas).</p>
          </div>

          <div class="comp">
            <h3 class="comp-t">Buscador y filtros</h3>
            <div class="placa clara demos">
