---
// RONDA 126 · EL MANIFIESTO. RONDA 128: en claro, tipo clusia/about. RONDA 129: en papel, el roble gofrado en seco y el texto que lo rodeaba.
// RONDA 130: el texto centrado que se abría alrededor del cursor (fuera en la 131).
// RONDA 131 (Andoni): «no quiero el titular debajo del árbol, lo quiero encima y el árbol un poco más pequeño. El árbol no se mueve con el
// scroll. Y el ratón no mueve el texto. Si podemos hacer alguna animación chula al pasar de capítulo a capítulo es bienvenida.»
// · Portada: «Manifiesto» arriba y, debajo, el roble GOFRADO en el propio papel (un ~22 % más pequeño que en la 130). No va fijo a la pantalla:
//   es parte de la hoja y se va con ella al bajar. Se pinta una vez y solo se repinta al cambiar de tamaño.
// · Párrafos: texto centrado y quieto (seleccionable).
// · De capítulo a capítulo: el numeral del capítulo se IMPRIME en el papel (tipografía de imprenta): la plancha baja con su sombra, golpea,
//   deja la tinta y el canto hundido (luz abajo a la derecha, sombra arriba a la izquierda) y del golpe sale un halo tenue. Una vez por
//   capítulo (IntersectionObserver), solo transform y opacidad. Con movimiento reducido o sin JS: ya impreso.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import { manifiesto } from '../data/manifiesto';

// [[…]] = la frase que se subraya con savia
const rico = (t: string) =>
  t.split(/(\[\[.+?\]\])/).filter(Boolean).map((seg) => {
    const m = /^\[\[(.+)\]\]$/.exec(seg);
    return m ? { t: m[1], m: true } : { t: seg, m: false };
  });
---

<Base title="Manifiesto — savvia" description={`${manifiesto.cierre} El manifiesto de savvia, el estudio web de Eric y Andoni en Donostia.`} carga={false}>
  <Nav />
  <Carriles />
  <main id="contenido" class="manifiesto surface-light" data-manifiesto>
    <div class="lectura">
      <header class="portada wrap">
        <h1 class="titulo font-display" data-entra>{manifiesto.titulo}</h1>
        <!-- el roble gofrado en la hoja: bajo el titular, quieto en la página -->
        <div class="roble" aria-hidden="true" data-roble>
          <img class="respaldo" src="/media/manifiesto/roble-relieve.webp" alt="" width="1340" height="663" />
          <canvas data-relieve></canvas>
        </div>
      </header>

      <!-- RONDA 144 · Eric: «no me ha encantado; lo veo mejor como 3–4 párrafos seguidos». Fuera los capítulos con numeral romano (en
           tools/r144/manifiesto.r143.astro.txt): el texto de Andoni, entero y seguido, en una sola columna; los párrafos entran uno tras otro.
           El cierre («Eso es savvia agentic…») va debajo, grande, como siempre. -->
      <section class="capitulo seguido" aria-label="El manifiesto">
        {
          manifiesto.capitulos.map((c) => (
            <div class="bloque">
              <p class="fuente">{rico(c.parrafos.join(' ')).map((s) => (s.m ? <span class="marca">{s.t}</span> : s.t))}</p>
            </div>
          ))
        }
      </section>
    </div>

    <section class="cierre wrap" aria-label="Cierre">
      <p class="frase font-display">{manifiesto.cierre}</p>
      <p class="firma detail text-fg2">{manifiesto.firma}</p>
    </section>
  </main>
  <Pie />
</Base>

<style>
  /* ── EL PAPEL: Rosa niebla con su grano (surface-light) y unas fibras largas, muy tenues ── */
  .manifiesto {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
  }
  .manifiesto::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.24;
    mix-blend-mode: multiply;
    background-image: url('/media/manifiesto/fibras.svg'); /* ronda 142: archivo aparte (en la build, el url(#f) dentro del data URI se rompía y pedía /%23f) */
    background-size: 520px 520px;
  }

  .lectura {
    position: relative;
    padding-bottom: 24lvh;
  }

  /* ── PORTADA: el titular arriba y el roble gofrado debajo, en la primera pantalla ── */
  .portada {
    position: relative;
    z-index: 1;
    min-height: 100lvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 1rem + 2lvh, 3rem);
    padding-top: calc(var(--spacing) * 24);
    padding-bottom: calc(var(--spacing) * 12);
    text-align: center;
  }
  .titulo {
    font-size: clamp(3.25rem, 1.6rem + 5.4vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: var(--fg);
  }
  /* la caja del roble: su proporción (1340 × 663) y un margen para que el canto del gofrado respire */
  .roble {
    position: relative;
    width: min(48vw, 46lvh * 2.021);
    aspect-ratio: 1340 / 663;
    pointer-events: none;
  }
  .roble canvas,
  .respaldo {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
  }
  .respaldo {
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.05;
    mix-blend-mode: multiply;
  }
  :global(html.relieve-listo) .respaldo { display: none; }
  @media (max-width: 47.99rem) {
    .roble { width: min(88vw, 34lvh * 2.021); }
  }

  /* ── CAPÍTULOS: «Cap. uno · I · Voz propia», centrado ── */
  .capitulo {
    position: relative;
    z-index: 1;
    margin-top: 36lvh;
  }
  .capitulo:first-of-type { margin-top: 16lvh; }
  .cabecera {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    column-gap: calc(var(--spacing) * 8);
    font-weight: 400;
    margin-bottom: calc(var(--spacing) * 16);
  }
  .cap { justify-self: end; letter-spacing: 0.04em; }
  .etq { justify-self: start; letter-spacing: 0.04em; }

  /* ── EL NUMERAL IMPRESO (tipografía de imprenta) ──
     capas: n-alta (la sombra de la plancha cuando aún está en el aire) · n-halo (el golpe) · n-luz (el canto bajo a la derecha, más claro
     que el papel) · n-hondo (la sombra del canto, arriba a la izquierda) · n-tinta (la tinta, el texto real). */
  .num {
    position: relative;
    display: inline-grid;
    font-size: clamp(3rem, 2rem + 3vw, 5rem);
    line-height: 1;
  }
  .num { justify-items: center; }
  .num > span { grid-area: 1 / 1; }
  .n-tinta { position: relative; color: var(--fg); }
  .n-luz { color: rgb(255 252 253 / 0.95); transform: translate(0.012em, 0.018em); }
  .n-hondo { color: rgb(48 32 24 / 0.5); transform: translate(-0.01em, -0.014em); }
  .n-alta { color: transparent; text-shadow: 0.06em 0.12em 0.14em rgb(48 32 24 / 0.28); opacity: 0; }
  .n-halo {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -0.75em 0 0 -1.3em;
    width: 2.6em;
    height: 1.5em;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(48 32 24 / 0.1), rgb(48 32 24 / 0.04) 62%, transparent);
    opacity: 0;
  }

  /* estado de partida (solo con JS y con movimiento): la plancha en el aire, sin tinta ni canto */
  :global(html.imprenta) .num:not(.impreso) .n-tinta,
  :global(html.imprenta) .num:not(.impreso) .n-luz,
  :global(html.imprenta) .num:not(.impreso) .n-hondo {
    opacity: 0;
    transform: scale(1.08);
  }
  :global(html.imprenta) .num:not(.impreso) .n-alta {
    opacity: 0.9;
    transform: translate(0.05em, 0.09em) scale(1.12);
  }
  :global(html.imprenta) .cabecera:not(.impresa) .cap,
  :global(html.imprenta) .cabecera:not(.impresa) .etq {
    opacity: 0;
    transform: translateY(8px);
  }
  :global(html.imprenta) .capitulo:not(.leido) .bloque {
    opacity: 0;
    transform: translateY(16px);
  }

  /* la bajada (0,55 s) y el golpe: tinta y canto, con la curva expo */
  .num > span,
  .cap,
  .etq,
  .bloque {
    transition:
      opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .num.impreso .n-alta {
    opacity: 0;
    transform: translate(0, 0) scale(1);
    transition:
      opacity 0.5s cubic-bezier(0.5, 0, 0.75, 0),
      transform 0.55s cubic-bezier(0.5, 0, 0.75, 0);
  }
  .num.impreso .n-tinta,
  .num.impreso .n-luz,
  .num.impreso .n-hondo {
    transition-delay: 0.5s;
    transition-duration: 0.7s, 0.55s;
  }
  .num.impreso .n-halo { animation: golpe 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both; }
  @keyframes golpe {
    from { opacity: 0.9; transform: scale(0.7); }
    to { opacity: 0; transform: scale(1.35); }
  }
  .cabecera.impresa .cap,
  .cabecera.impresa .etq { transition-delay: 0.85s; }
  .capitulo.leido .bloque { transition-duration: 1.2s; transition-delay: 0.95s; }
  .capitulo.leido .bloque + .bloque { transition-delay: 1.1s; }

  @media (prefers-reduced-motion: reduce) {
    .num > span, .cap, .etq, .bloque { transition: none !important; }
    .n-halo { animation: none !important; }
  }

  /* ── EL TEXTO: una columna centrada, quieta ── */
  .bloque {
    position: relative;
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
    line-height: 1.6;
    color: var(--fg);
  }
  .bloque + .bloque { margin-top: calc(var(--spacing) * 8); }
  .seguido { margin-top: 14lvh; }
  .seguido .bloque { font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem); line-height: 1.5; }
  .seguido .bloque + .bloque { margin-top: calc(var(--spacing) * 6); }
  .seguido .fuente { max-width: 40ch; text-align: left; }
  .seguido .bloque + .bloque { transition-delay: calc(0.95s + 0.15s); }
  .seguido .bloque:nth-child(3) { transition-delay: 1.25s; }
  .fuente {
    position: relative;
    max-width: 34ch;
    margin-inline: auto;
    padding-inline: 20px;
    box-sizing: content-box;
    text-align: center;
    text-wrap: pretty;
  }
  .fuente .marca {
    background: linear-gradient(var(--color-coral), var(--color-coral)) 0 94% / 100% 2px no-repeat;
  }
  .lista ul { list-style: none; padding: 0; margin-top: calc(var(--spacing) * 2); }
  .lista-t { letter-spacing: 0.04em; color: var(--fg2); }
  .listas {
    position: relative;
    z-index: 1;
    margin-top: 36lvh;
  }
  .listas .bloque + .bloque { margin-top: calc(var(--spacing) * 16); }

  /* ── CIERRE ── */
  .cierre {
    position: relative;
    z-index: 1;
    text-align: center;
    padding-block: calc(var(--spacing) * 24) var(--space-section);
  }
  .frase {
    max-width: 18ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.75rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .firma { margin-top: calc(var(--spacing) * 8); letter-spacing: 0.04em; }
</style>

<script>
  import { crearRelieve } from '../components/manifiesto/relieve';

  const main = document.querySelector<HTMLElement>('[data-manifiesto]')!;
  const caja = main.querySelector<HTMLElement>('[data-roble]')!;
  const lienzo = main.querySelector<HTMLCanvasElement>('[data-relieve]')!;
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ancho = matchMedia('(min-width: 48rem)');

  // ── LA IMPRENTA: cada capítulo se imprime una vez, al llegar (el numeral al 72 % de la pantalla) ──
  const caps = [...main.querySelectorAll<HTMLElement>('.capitulo')];
  if (!reducido && 'IntersectionObserver' in window) {
    const html = document.documentElement;
    html.classList.add('imprenta');
    const io = new IntersectionObserver(
      (es) => {
        for (const e of es) {
          if (!e.isIntersecting) continue;
          const c = e.target as HTMLElement;
          c.querySelector('.num')?.classList.add('impreso');
          c.querySelector('.cabecera')?.classList.add('impresa');
          c.classList.add('leido');
          io.unobserve(c);
        }
      },
      { rootMargin: '0px 0px -28% 0px' },
    );
    // lo que ya ha pasado al cargar (recarga a media página) va impreso, sin teatro
    for (const c of caps) {
      if (c.getBoundingClientRect().top < innerHeight * 0.72) {
        c.querySelector('.num')?.classList.add('impreso');
        c.querySelector('.cabecera')?.classList.add('impresa');
        c.classList.add('leido');
      } else io.observe(c);
    }
  }

  // ── EL ROBLE GOFRADO: parte de la hoja (no va fijo); se pinta una vez y al cambiar de tamaño ──
  (async () => {
    const R = await crearRelieve(lienzo, '/media/manifiesto/roble-relieve.webp').catch(() => null);
    if (!R || !R.ok) return;
    document.documentElement.classList.add('relieve-listo');
    let tw0 = 0, th0 = 0;
    const pintar = () => {
      const w = lienzo.clientWidth, h = lienzo.clientHeight;
      if (!w || !h) return;
      if (w !== tw0 || h !== th0) { tw0 = w; th0 = h; R.tam(w, h); }
      const tw = w / 1.08; // el lienzo lleva un 4 % de margen por lado
      R.pintar({
        cx: w / 2, cy: h / 2, w: tw, h: tw / (1340 / 663), giro: 0, luz: -2.36, fuerza: ancho.matches ? 3.2 : 2.2,
        mano: { x: mx, y: my, f: mf, alza: reducido ? 0 : 0.6, r: ancho.matches ? 180 : 130 },
      });
    };

    // ── LA MANO: al pasar el puntero (o el dedo, mientras toca) el gofrado responde; con inercia y sin bucle en reposo ──
    // Se escucha en la portada (el lienzo no coge el puntero: no estorba a la selección de texto).
    let mx = -1e4, my = -1e4, mf = 0; // lo que se pinta
    let tx = 0, ty = 0, tf = 0; // a dónde va
    let raf = 0, tAnt = 0;
    const portada = main.querySelector<HTMLElement>('.portada')!;
    const paso = (t: number) => {
      const dt = Math.min(0.05, tAnt ? (t - tAnt) / 1000 : 1 / 60);
      tAnt = t;
      const kp = reducido ? 1 : 1 - Math.pow(1 - 0.12, dt * 60); // lerp 0,12 por fotograma a 60 fps
      if (mf < 0.002) { mx = tx; my = ty; } else { mx += (tx - mx) * kp; my += (ty - my) * kp; }
      // entra en ~0,35 s y se relaja en ~0,8 s
      const kf = 1 - Math.exp(-dt / (tf > mf ? 0.12 : 0.27));
      mf += (tf - mf) * kf;
      pintar();
      const quieto = Math.abs(tf - mf) < 0.003 && Math.abs(tx - mx) < 0.3 && Math.abs(ty - my) < 0.3;
      if (quieto) { mf = tf; raf = 0; tAnt = 0; if (!tf) pintar(); return; }
      raf = requestAnimationFrame(paso);
    };
    const mover = () => { if (!raf) raf = requestAnimationFrame(paso); };
    let cx0 = 0, cy0 = 0;
    const apuntar = () => {
      const r = lienzo.getBoundingClientRect();
      const x = cx0 - r.left, y = cy0 - r.top;
      const m = 60;
      const dentro = x > -m && y > -m && x < r.width + m && y < r.height + m;
      tx = x; ty = y; tf = dentro ? 1 : 0;
      mover();
    };
    const sobre = (e: PointerEvent) => {
      if (e.pointerType === 'touch' && !e.isPrimary) return;
      cx0 = e.clientX; cy0 = e.clientY;
      apuntar();
    };
    const fuera = () => { tf = 0; mover(); };
    portada.addEventListener('pointermove', sobre, { passive: true });
    portada.addEventListener('pointerdown', sobre, { passive: true });
    portada.addEventListener('pointerleave', fuera);
    portada.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') fuera(); });
    portada.addEventListener('pointercancel', fuera);
    // con la rueda la hoja se mueve bajo la mano quieta: se vuelve a apuntar
    addEventListener('scroll', () => { if (tf) apuntar(); }, { passive: true });

    pintar();
    let t = 0;
    let ultimo = caja.clientWidth;
    new ResizeObserver(() => {
      if (caja.clientWidth === ultimo) return; // la barra del móvil cambia el alto, no el ancho: no se repinta
      ultimo = caja.clientWidth;
      clearTimeout(t);
      t = window.setTimeout(pintar, 80);
    }).observe(caja);
    (window as any).__manifiesto = () => ({
      roble: caja.getBoundingClientRect().toJSON(),
      impresos: main.querySelectorAll('.num.impreso').length,
      mano: { x: mx, y: my, f: mf, animando: !!raf },
    });
  })();
</script>
