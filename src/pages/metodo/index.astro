---
// LANZAMIENTO: esta página aún no sale (ver src/lib/lanzamiento.ts); quien llega por la dirección vuelve a la home
import { RECORTE, METODO_ABIERTO } from '../../lib/lanzamiento';
if (RECORTE || !METODO_ABIERTO) return Astro.redirect('/');
// RONDA 127–128 · /handbook — LA PORTADA PARA NAVEGAR el manual de savvia. Andoni: «algo así https://www.designhandbook.com/en» y, en la 128,
// «tenemos por un lado para navegarlo (designhandbook.com/en) y luego cada capítulo en detalle» · «las páginas secundarias, todas en light».
// Cada capítulo vive en /handbook/<slug> (src/pages/handbook/[slug].astro). Contenido: src/data/handbook.ts, solo con hechos.
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Carriles from '../../components/Carriles.astro';
import Pie from '../../components/Pie.astro';
import PasarPagina from '../../components/handbook/PasarPagina.astro';
import Portada from '../../components/handbook/Portada.astro';
---

<Base
  title="Método de savvia"
  description="El método de savvia: qué creemos, cómo trabajamos y qué te llevas al terminar. El manual del estudio web de Eric y Andoni."
  carga={false}
  indexar={false}
>
  <PasarPagina />
  <Nav />
  <Carriles />
  <main id="contenido" class="handbook surface-light">
    <Portada />
  </main>
  <Pie />
</Base>

<style>
  .handbook { overflow-x: clip; }
</style>
