---
// RONDA 62 · TODOS LOS PROYECTOS (referencia: focuslab.agency/work). RONDA 63 (Andoni): «en light mode; los destacados, como en "Más proyectos";
// los filtros más elegantes y un buscador inteligente». En claro (Rosa niebla); los destacados son PIEZAS (degradado de su web + navegador, o la mesa
// con la web en el monitor) en un mosaico asimétrico; debajo, un BUSCADOR que entiende sinónimos, acentos y erratas, y filtros tipográficos con
// recuento. Todo se filtra y se pagina en la página; el estado va en la dirección (?q=&servicio=&sector=&p=).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Carriles from '../../components/Carriles.astro';
import Pie from '../../components/Pie.astro';
import Pieza from '../../components/obra/Pieza.astro';
import { proyectos, SERVICIOS } from '../../data/proyectos';
import { flecha } from '../../lib/flecha';

// RONDA 138 · Andoni: «el de Playground cambiarlo por alguno que se vea el móvil, ya que es más vertical. Y los destacados que sean un slider para
// que tengas todos los proyectos más arriba y a mano». Los destacados, en UNA fila que se desliza (scroll-snap nativo): todas las piezas a la misma
// altura y anchos distintos (`k` = ancho / alto); la del teléfono (Remerge), estrecha y vertical. Orden: ancho · estrecho · medio · ancho.
// RONDA 191 · Eric: «en el slider tienen que estar neety.com, surepayroll.com, claudiabe.studio, homeofambrose.com y elevenlab.org; aunque no les
// llamemos proyectos destacados, solo que sea una slide que vaya pasando» (sustituyen a los cuatro de antes). Grabadas con tools/r189/grabar.cjs
// (public/media/anteriores/video/<clave>.mp4). Las que no tienen caso enlazan a su web; Neety, a su caso. Colores, de su propia web.
type Slide = { p: (typeof proyectos)[number]; href: string; fondo?: string };
const web = (slug: string, nombre: string, dominio: string, url: string, sector: string, colores: string[], vid = slug, fondo?: string): Slide => ({
  href: url,
  fondo,
  p: { slug, nombre, dominio, url, sector, colores, servicios: [], portada: { tipo: 'video', src: `/media/anteriores/video/${vid}.mp4`, poster: `/media/anteriores/video/${vid}.jpg` } } as unknown as (typeof proyectos)[number],
});
const neety = proyectos.find((p) => p.slug === 'neety')!;
const SLIDES: Slide[] = [
  { href: '/proyectos/neety', p: { ...neety, dominio: 'neety.com', portada: { tipo: 'video', src: '/media/anteriores/video/neety-com.mp4', poster: '/media/anteriores/video/neety-com.jpg' } }, fondo: '/media/anteriores/fondos/slider-neety.webp' },
  web('surepayroll', 'SurePayroll', 'surepayroll.com', 'https://www.surepayroll.com/', 'Nóminas', ['#0f2421', '#1fc58e', '#8f7cf0'], 'surepayroll', '/media/anteriores/fondos/slider-surepayroll.webp'),
  web('claudia-be', 'Claudia BE', 'claudiabe.studio', 'https://claudiabe.studio/', 'Estudio de branding', ['#f6e9e1', '#ee4f4f', '#f4a3a3'], 'claudia-be', '/media/anteriores/fondos/slider-claudia-be.webp'),
  web('home-of-ambrose', 'Home of Ambrose', 'homeofambrose.com', 'https://www.homeofambrose.com/', 'Vivienda', ['#f6e5d5', '#c25631', '#4d4d1c']),
  web('eleven-lab', 'Eleven Lab', 'elevenlab.org', 'https://www.elevenlab.org/', 'Consultoría de diseño', ['#0d6b7a', '#1c3fa8', '#0a8f86'], 'eleven-lab', '/media/anteriores/fondos/slider-eleven-lab.webp'),
];
const servicios = SERVICIOS.map((s) => [s, proyectos.filter((p) => p.servicios.includes(s)).length] as const).filter(([, n]) => n);
const sectores = [...new Set(proyectos.map((p) => p.sector).filter(Boolean))].sort((a, b) => a!.localeCompare(b!, 'es')) as string[];
const POR_PAGINA = 9; // RONDA 144 · Eric: «de tres en vez de dos: van a ir todas, las 40» → filas de 3
// RONDA 144 · Eric: «rescatar todos los filtros que tenemos en Webflow (por ejemplo países)»: servicio, sector, país y tecnología
const paisDe = (p: (typeof proyectos)[number]) => (p.ubicacion ? p.ubicacion.split(',').pop()!.trim() : '');
const paises = [...new Set(proyectos.map(paisDe).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'es'));
const tecnologias = [...new Set(proyectos.flatMap((p) => p.stack ?? []))].map((t) => [t, proyectos.filter((p) => p.stack?.includes(t)).length] as const).filter(([, n]) => n > 1).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'es')).map(([t]) => t);
// el tipo de pieza de cada proyecto en la rejilla: web móvil → teléfono; fondo de marca claro → navegador recto; oscuro → navegador ladeado
const luz = (hex: string) => { const n = parseInt(hex.slice(1), 16); return ((n >> 16) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000 > 150; };
// ronda 131 · «en portfolio, todos en desktop»: en la rejilla nunca teléfono; las webs móviles usan su grabación de escritorio (`escritorio`)
const tipoDe = (p: (typeof proyectos)[number]) => (luz(p.colores[0]) ? 'claro' : 'mancha') as 'claro' | 'mancha';
// lo que el buscador lee de cada proyecto (se normaliza en el navegador)
const texto = (p: (typeof proyectos)[number]) =>
  [p.nombre, p.sector, p.ubicacion, p.con, p.servicios.join(' '), (p.stack ?? []).join(' '), p.resumen, p.entradilla, p.contexto.join(' '), p.apartados.map((a) => a.titulo + ' ' + a.texto.join(' ')).join(' ')].filter(Boolean).join(' · ');
---

<Base title="Proyectos — savvia" description="Webs a medida, de principio a fin: los proyectos de savvia, el estudio web de Eric y Andoni." carga={false}>
  <Nav />
  <Carriles />
  <!-- ronda 129: con JS, el navegador de cada pieza espera bajo su borde y sube al entrar (sin JS, en su sitio). Antes de pintar las piezas. -->
  <script is:inline>document.documentElement.classList.add('pz-js');</script>
  <main id="contenido" class="obras surface-light">
    <header class="wrap cabecera">
      <h1 class="font-display titular" data-entra>Webs a medida, de principio a fin.</h1>
      <p class="text-sub text-fg2 mt-6 measure" data-enfoca>Para equipos que viven de su web. Estos son algunos de ellos.</p>
    </header>

    <section class="destacados" aria-roledescription="carrusel" aria-label="Algunas webs" data-slider>
      <ul class="pista" data-pista>
        {
          SLIDES.map(({ p, href, fondo }, i) => {
            const tipo = luz(p.colores[0]) ? 'claro' : 'mancha';
            return (
              <li class={`slide ${tipo}`} style="--k:1.6" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${SLIDES.length}: ${p.nombre}`} data-slide>
                <Pieza p={p} tipo={tipo} giro={i % 2 ? 5 : -5} href={href} fondo={fondo} transicion={href.startsWith('/')} />
              </li>
            );
          })
        }
      </ul>
      <div class="wrap mandos-s">
        <!-- RONDA 152 · Andoni: «las flechas para pasar de proyecto, igual que en los testimonios destacados de la home, y abajo a la derecha»: las
             dos flechas solas (sin cuenta, sin nombre, sin la caja de cristal), pegadas a la guía derecha bajo el slider. El número y el nombre
             del que se ve siguen para lectores de pantalla. -->
        <div class="barra-cristal barra-voz" role="group" aria-label="Navegación de destacados">
          <button type="button" class="paso" aria-label="Anterior" data-paso="-1"><Fragment set:html={flecha('izq')} /></button>
          <button type="button" class="paso" aria-label="Siguiente" data-paso="1"><Fragment set:html={flecha()} /></button>
        </div>
        <p class="sr-only" aria-live="polite"><span data-n>01/{String(SLIDES.length).padStart(2, '0')}</span> <span data-n-nombre>{SLIDES[0].p.nombre}</span></p>
      </div>
    </section>

    <section class="wrap todos" aria-labelledby="todos-h" data-todos data-por-pagina={POR_PAGINA}>
      <!-- RONDA 64 · «dejamos solo el buscador; en el buscador está escrito por defecto "Todos los proyectos": el titular se convierte en el propio
           buscador». El h2 es el campo: en Family, del tamaño de un titular; al escribir, busca. A la derecha, discretos: «Filtros» (se despliegan)
           y el orden de la rejilla (filas de 2 o de 3; ronda 129: fuera el «libre»). -->
      <!-- RONDA 144 · Eric: «el buscador está aquí pero lo buscas allí: que se vea que puedes filtrar rápido; el botón de filtros, más llamativo».
           Titular a la izquierda; a la derecha, en una sola fila, el BUSCADOR (un campo de verdad) y «Filtros» (CTA de cristal con su recuento). -->
      <div class="cabeza-todos">
        <h2 id="todos-h" class="font-display text-h2">Todos los proyectos</h2>
        <!-- RONDA 144 (2.ª) · Andoni: «el buscador y los filtros, más integrados con el fondo, y en la misma barra, no dos aparte»: UNA barra (filete del
             color de las reglas, sin velo): a la izquierda se escribe; a la derecha, tras un separador, «Filtros» con su recuento -->
        <div class="mandos barra-buscar">
          <label class="buscador">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5L21 21" /></svg>
            <span class="sr-only">Buscar proyectos</span>
            <input id="buscar" type="search" autocomplete="off" spellcheck="false" placeholder="Busca un proyecto" data-buscar />
          </label>
          <button type="button" class="mando-f" aria-expanded="false" aria-controls="filtros" data-abrir-filtros>
            <svg class="ic-f" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 4.5h12M4.5 8h7M7 11.5h2" /></svg><span>Filtros</span><span class="n-f" data-n-filtros></span>
          </button>
        </div>
      </div>

      <!-- LOS FILTROS, bajo «Filtros»: cuatro filas de etiquetas con recuento -->
      <div id="filtros" class="filtros" data-filtros hidden>
        <div class="fila-f" role="group" aria-label="Servicio">
          <span class="etq detail">Servicio</span>
          <div class="ops">
            <button type="button" class="op" aria-pressed="true" data-f="servicio" data-v="">Todos</button>
            {servicios.map(([v, n]) => <button type="button" class="op" aria-pressed="false" data-f="servicio" data-v={v}>{v}<sup>{n}</sup></button>)}
          </div>
        </div>
        <div class="fila-f" role="group" aria-label="Sector">
          <span class="etq detail">Sector</span>
          <div class="ops">
            <button type="button" class="op" aria-pressed="true" data-f="sector" data-v="">Todos</button>
            {sectores.map((v) => <button type="button" class="op" aria-pressed="false" data-f="sector" data-v={v}>{v}</button>)}
          </div>
        </div>
        <div class="fila-f" role="group" aria-label="País">
          <span class="etq detail">País</span>
          <div class="ops">
            <button type="button" class="op" aria-pressed="true" data-f="pais" data-v="">Todos</button>
            {paises.map((v) => <button type="button" class="op" aria-pressed="false" data-f="pais" data-v={v}>{v}<sup>{proyectos.filter((p) => paisDe(p) === v).length}</sup></button>)}
          </div>
        </div>
        <div class="fila-f" role="group" aria-label="Tecnología">
          <span class="etq detail">Tecnología</span>
          <div class="ops">
            <button type="button" class="op" aria-pressed="true" data-f="tec" data-v="">Todas</button>
            {tecnologias.map((v) => <button type="button" class="op" aria-pressed="false" data-f="tec" data-v={v}>{v}<sup>{proyectos.filter((p) => p.stack?.includes(v)).length}</sup></button>)}
          </div>
        </div>
        <button type="button" class="btn-secondary btn-sm limpiar-f" data-limpiar-f>Quitar filtros</button>
      </div>
      <p class="detail text-fg2 cuenta" aria-live="polite" data-cuenta></p>

      <!-- cada proyecto, dentro de SU degradado (la pieza de «Más proyectos»), no la web a sangre -->
      <ul class="rejilla" data-rejilla-obras>
        {
          proyectos.map((p, i) => (
            <li data-obra data-slug={p.slug} data-servicios={p.servicios.join('|')} data-sector={p.sector ?? ''} data-pais={paisDe(p)} data-tec={(p.stack ?? []).join('|')} data-texto={texto(p)} data-nombre={p.nombre} style={`view-transition-name: t-${p.slug}`}>
              <Pieza p={p} tipo={tipoDe(p)} giro={i % 2 ? 5 : -5} transicion={!p.destacado} sube />
            </li>
          ))
        }
      </ul>
      <p class="vacio text-fg2" data-vacio hidden>Nada con esa búsqueda. <button type="button" class="link" data-limpiar>Ver todos</button></p>
      <nav class="paginas" aria-label="Páginas" data-paginas></nav>
    </section>
  </main>
  <Pie />
</Base>

<script>
  import { flecha } from '../../lib/flecha';
  // ── RONDA 138 · EL SLIDER DE LOS DESTACADOS: scroll horizontal nativo con snap (trackpad, rueda con mayúsculas, dedo); con ratón, también se
  // ARRASTRA; flechas (botones y ← → con el foco dentro); el progreso, «01 / 04» en mono y una línea fina que se llena.
  {
    const sl = document.querySelector<HTMLElement>('[data-slider]');
    if (sl) {
      const pista = sl.querySelector<HTMLElement>('[data-pista]')!, slides = [...sl.querySelectorAll<HTMLElement>('[data-slide]')];
      const nEl = sl.querySelector<HTMLElement>('[data-n]')!, nomEl = sl.querySelector<HTMLElement>('[data-n-nombre]')!;
      const nombres = slides.map((s) => s.querySelector('.nombre, h3, [data-nombre]')?.textContent?.trim() || s.getAttribute('aria-label')?.split(': ').pop() || '');
      const [ant, sig] = [...sl.querySelectorAll<HTMLButtonElement>('[data-paso]')];
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pad = () => parseFloat(getComputedStyle(pista).paddingLeft) || 0; // (scroll-padding sale sin resolver: «max(…)»)
      const max = () => pista.scrollWidth - pista.clientWidth;
      // RONDA 144 · Eric: «el slider, que termine realmente donde debería terminar»: sin hueco al final; la última pieza acaba en el margen derecho.
      // Cada pieza tiene su parada (su borde izquierdo en el margen, o el final del recorrido si no cabe): «siguiente» = una pieza, sin saltos.
      const parada = (i: number) => Math.min(max(), Math.max(0, slides[i].offsetLeft - pad()));
      const actual = () => { const x = pista.scrollLeft; let m = 0, d = Infinity; slides.forEach((_, i) => { const e = Math.abs(parada(i) - x); if (e < d - 0.5) { d = e; m = i; } }); return m; };
      const medir = () => {};
      const pintarS = () => {
        const i = actual(), mx = max();
        nEl.textContent = `${String(i + 1).padStart(2, '0')}/${String(slides.length).padStart(2, '0')}`;
        nomEl.textContent = nombres[i];
        ant.disabled = i === 0;
        sig.disabled = i === slides.length - 1;
      };
      const ir = (i: number) => pista.scrollTo({ left: parada(Math.max(0, Math.min(slides.length - 1, i))), behavior: reducido ? 'auto' : 'smooth' });
      ant.addEventListener('click', () => ir(actual() - 1));
      sig.addEventListener('click', () => ir(actual() + 1));
      sl.addEventListener('keydown', (e) => { if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight' || (e.target as HTMLElement).closest('[data-paso]')) return; e.preventDefault(); ir(actual() + (e.key === 'ArrowRight' ? 1 : -1)); });
      // al enfocar una pieza con el tabulador, que entre entera
      slides.forEach((s, i) => s.addEventListener('focusin', () => { const r = s.getBoundingClientRect(), p = pista.getBoundingClientRect(); if (r.left < p.left || r.right > p.right) ir(i); }));
      let raf = 0;
      pista.addEventListener('scroll', () => { cancelAnimationFrame(raf); raf = requestAnimationFrame(pintarS); }, { passive: true });
      addEventListener('resize', () => { medir(); pintarS(); });
      // arrastrar con el ratón (el dedo y el trackpad ya los hace el navegador); si se ha movido, el clic no abre el caso
      let x0 = 0, s0 = 0, movido = false, arrastra = false;
      pista.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse' || e.button !== 0) return; arrastra = true; movido = false; x0 = e.clientX; s0 = pista.scrollLeft; });
      addEventListener('pointermove', (e) => { if (!arrastra) return; const dx = e.clientX - x0; if (!movido && Math.abs(dx) > 6) { movido = true; pista.classList.add('arrastra'); } if (movido) pista.scrollLeft = s0 - dx; });
      addEventListener('pointerup', () => { if (!arrastra) return; arrastra = false; if (movido) { pista.classList.remove('arrastra'); ir(actual()); } });
      pista.addEventListener('click', (e) => { if (movido) { e.preventDefault(); e.stopPropagation(); movido = false; } }, true);
      pista.addEventListener('dragstart', (e) => e.preventDefault());
      medir();
      pintarS();
      // RONDA 191 · Eric: «una slide que vaya pasando»: avanza sola cada 5 s (y al final vuelve a la primera); se para con el puntero o el foco dentro,
      // fuera de la vista o con la pestaña oculta, y espera 10 s tras cualquier gesto del visitante. Sin paso solo con movimiento reducido.
      if (!reducido) {
        let dentro = false, visible = false, quieto = 0;
        const gesto = () => (quieto = performance.now() + 10000);
        sl.addEventListener('pointerenter', () => (dentro = true));
        sl.addEventListener('pointerleave', () => (dentro = false));
        sl.addEventListener('focusin', () => (dentro = true));
        sl.addEventListener('focusout', () => (dentro = false));
        ['pointerdown', 'wheel', 'touchstart', 'keydown'].forEach((t) => sl.addEventListener(t, gesto, { passive: true }));
        new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.4 }).observe(sl);
        setInterval(() => {
          if (dentro || !visible || document.hidden || performance.now() < quieto || arrastra) return;
          const i = actual();
          ir(i >= slides.length - 1 || pista.scrollLeft >= max() - 2 ? 0 : i + 1);
        }, 5000);
      }
      (window as any).__slider = () => ({ i: actual(), scroll: Math.round(pista.scrollLeft), max: max(), n: nEl.textContent });
    }
  }
  // ── EL BUSCADOR «inteligente», todo en el navegador (sin IA detrás): normaliza (minúsculas, sin acentos), amplía cada palabra con SINÓNIMOS del
  // oficio, acepta prefijos y una errata en palabras de 5 letras o más, y ordena por dónde aparece (nombre > sector y servicios > el resto del caso).
  const SINONIMOS: Record<string, string[]> = {
    multidioma: ['idioma', 'idiomas', 'multilingue', 'multilenguaje', 'traduccion', 'traducir', 'i18n', 'localizacion', 'internacional', 'ingles', 'coreano', 'japones', 'chino', 'portugues'],
    fintech: ['finanzas', 'financiero', 'banca', 'banco', 'bancos', 'nominas', 'nomina', 'pagos', 'facturacion', 'factura', 'facturas', 'payroll'],
    ia: ['inteligencia', 'artificial', 'ai', 'agentico', 'agentica', 'agentes', 'llm', 'modelos', 'cuantica'],
    migracion: ['migrar', 'mudanza', 'unificar', 'unificadas', 'redirecciones'],
    cms: ['contenido', 'contenidos', 'colecciones', 'fichas', 'blog'],
    animacion: ['animaciones', 'motion', 'movimiento', 'interaccion', 'interacciones'],
    desarrolladores: ['developers', 'api', 'programadores'],
    educacion: ['colegios', 'escuelas', 'profesores', 'alumnos', 'edtech'],
    renovables: ['energia', 'solar', 'eolica', 'sostenible'],
    ventas: ['b2b', 'comercial', 'comerciales', 'saas', 'crm'],
    logistica: ['ecommerce', 'envios', 'almacen', 'fulfillment'],
    publicidad: ['anuncios', 'ads', 'marketing', 'apps', 'movil'],
  };
  const norma = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9#+ ]/g, ' ');
  const inverso = new Map<string, string[]>();
  for (const [k, vs] of Object.entries(SINONIMOS)) { const g = [k, ...vs]; g.forEach((w) => inverso.set(w, g)); }
  const errata1 = (a: string, b: string) => { // distancia de edición ≤ 1
    if (Math.abs(a.length - b.length) > 1) return false;
    let i = 0, j = 0, d = 0;
    while (i < a.length && j < b.length) { if (a[i] === b[j]) { i++; j++; continue; } if (++d > 1) return false; if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; } }
    return d + (a.length - i) + (b.length - j) <= 1;
  };
  type Campo = { palabras: string[]; peso: number };
  // cada término: lo que se escribió (admite una errata) y sus sinónimos (solo exactos o como principio de palabra)
  const puntuar = (terminos: { orig: string; variantes: string[] }[], campos: Campo[]) => {
    let total = 0;
    for (const { orig, variantes } of terminos) {
      let mejor = 0;
      for (const c of campos) for (const w of c.palabras) for (const v of variantes) {
        const s = w === v ? 1 : w.startsWith(v) && v.length >= 3 ? 0.8 : v === orig && v.length >= 5 && errata1(w, v) ? 0.6 : 0;
        if (s * c.peso > mejor) mejor = s * c.peso;
      }
      if (!mejor) return 0; // todas las palabras tienen que aparecer (en alguna de sus formas)
      total += mejor;
    }
    return total;
  };

  const caja = document.querySelector<HTMLElement>('[data-todos]')!;
  const POR = Number(caja.dataset.porPagina) || 6;
  const lista = caja.querySelector<HTMLElement>('[data-rejilla-obras]')!;
  const items = [...caja.querySelectorAll<HTMLElement>('[data-obra]')];
  const palabras = (s: string) => norma(s).split(/\s+/).filter(Boolean);
  const indice = items.map((it) => ({
    it,
    campos: [
      { palabras: palabras(it.dataset.nombre!), peso: 5 },
      { palabras: palabras(it.dataset.sector + ' ' + it.dataset.servicios!.replace(/\|/g, ' ')), peso: 3 },
      { palabras: palabras(it.dataset.texto!), peso: 1 },
    ] as Campo[],
  }));
  const input = caja.querySelector<HTMLInputElement>('[data-buscar]')!;
  const filtros = caja.querySelector<HTMLElement>('[data-filtros]')!, abrirF = caja.querySelector<HTMLButtonElement>('[data-abrir-filtros]')!, nF = caja.querySelector<HTMLElement>('[data-n-filtros]')!;
  const ops = [...caja.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const paginas = caja.querySelector<HTMLElement>('[data-paginas]')!, cuenta = caja.querySelector<HTMLElement>('[data-cuenta]')!, vacio = caja.querySelector<HTMLElement>('[data-vacio]')!;
  const q = new URLSearchParams(location.search);
  const F = ['servicio', 'sector', 'pais', 'tec'] as const;
  const filtro: Record<(typeof F)[number], string> = { servicio: q.get('servicio') || '', sector: q.get('sector') || '', pais: q.get('pais') || '', tec: q.get('tec') || '' };
  let busca = q.get('q') || '', pagina = Math.max(1, Number(q.get('p')) || 1);
  input.value = busca;

  const pintar = (mover = false) => {
    const terminos = palabras(busca).map((w) => ({ orig: w, variantes: inverso.get(w) ?? [w] }));
    const pasan = indice
      .filter(({ it }) => (!filtro.servicio || it.dataset.servicios!.split('|').includes(filtro.servicio)) && (!filtro.sector || it.dataset.sector === filtro.sector) && (!filtro.pais || it.dataset.pais === filtro.pais) && (!filtro.tec || it.dataset.tec!.split('|').includes(filtro.tec)))
      .map((x, n) => ({ ...x, n, s: terminos.length ? puntuar(terminos, x.campos) : 1 }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.n - b.n);
    const total = Math.max(1, Math.ceil(pasan.length / POR));
    pagina = Math.min(pagina, total);
    items.forEach((it) => (it.hidden = true));
    pasan.forEach(({ it }) => lista.append(it)); // el orden, por relevancia
    pasan.slice((pagina - 1) * POR, pagina * POR).forEach(({ it }, i) => { it.hidden = false; it.style.setProperty('--i', String(i)); it.style.setProperty('--fila-i', String(i % (innerWidth >= 1024 ? 3 : innerWidth >= 768 ? 2 : 1))); });
    ops.forEach((b) => b.setAttribute('aria-pressed', String(filtro[b.dataset.f as (typeof F)[number]] === b.dataset.v)));
    const nAct = F.filter((k) => filtro[k]).length;
    nF.textContent = nAct ? String(nAct) : '';
    vacio.hidden = pasan.length > 0;
    cuenta.textContent = `${String(pasan.length).padStart(2, '0')} ${pasan.length === 1 ? 'proyecto' : 'proyectos'}${busca || nAct ? ` de ${String(items.length).padStart(2, '0')}` : ''}`;
    paginas.innerHTML = '';
    if (total > 1) {
      const boton = (txt: string, n: number, et: string) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'paso'; b.setAttribute('aria-label', et); b.innerHTML = txt; b.disabled = n < 1 || n > total; b.addEventListener('click', () => { pagina = n; animar(() => pintar(true)); }); return b; };
      const num = document.createElement('p'); num.className = 'cual'; num.setAttribute('aria-current', 'page'); num.innerHTML = `<span class="n">Página</span><span>${String(pagina).padStart(2, '0')}/${String(total).padStart(2, '0')}</span>`;
      const barra = document.createElement('div'); barra.className = 'barra-cristal';
      barra.append(boton(flecha('izq'), pagina - 1, 'Página anterior'), num, boton(flecha(), pagina + 1, 'Página siguiente'));
      paginas.append(barra);
    }
    const u = new URL(location.href);
    ([['q', busca], ...F.map((k) => [k, filtro[k]] as const), ['p', pagina > 1 ? String(pagina) : '']] as const).forEach(([k, v]) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k)));
    history.replaceState(null, '', u);
    if (mover) caja.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };
  // RONDA 64 · los cambios que pide el visitante (orden, filtros, página) se ANIMAN: cada tarjeta viaja a su sitio nuevo (View Transitions en el
  // mismo documento; cada <li> lleva su nombre). Al escribir no: la lista cambia al ritmo de las teclas.
  const reducidoV = matchMedia('(prefers-reduced-motion: reduce)').matches;
  // html.vt-local: en estas transiciones dentro de la página no se rasga la página entera (eso es solo al cambiar de página)
  const animar = (f: () => void) => { const d = document as any; if (!d.startViewTransition || reducidoV) return f(); document.documentElement.classList.add('vt-local'); d.startViewTransition(f).finished.finally(() => document.documentElement.classList.remove('vt-local')); };
  let reloj = 0;
  input.addEventListener('input', () => { clearTimeout(reloj); reloj = window.setTimeout(() => { busca = input.value.trim(); pagina = 1; pintar(); }, 120); });
  input.addEventListener('keydown', (e) => { if (e.key === 'Escape' && input.value) { input.value = busca = ''; pagina = 1; pintar(); } });
  abrirF.addEventListener('click', () => { const si = filtros.hidden; filtros.hidden = !si; abrirF.setAttribute('aria-expanded', String(si)); });
  ops.forEach((b) => b.addEventListener('click', () => { filtro[b.dataset.f as (typeof F)[number]] = b.dataset.v!; pagina = 1; animar(() => pintar()); }));
  const limpiar = (conBusqueda: boolean) => { F.forEach((k) => (filtro[k] = '')); if (conBusqueda) input.value = busca = ''; pagina = 1; animar(() => pintar()); };
  caja.querySelector('[data-limpiar]')!.addEventListener('click', () => limpiar(true));
  caja.querySelector('[data-limpiar-f]')!.addEventListener('click', () => limpiar(false));
  if (F.some((k) => filtro[k])) { filtros.hidden = false; abrirF.setAttribute('aria-expanded', 'true'); }
  pintar();
  (window as any).__obras = () => ({ visibles: items.filter((i) => !i.hidden).map((i) => i.dataset.slug), busca, ...filtro, pagina, paginas: paginas.querySelectorAll('.paso').length });
  (window as any).__buscar = (x: string) => { input.value = busca = x; pagina = 1; pintar(); return (window as any).__obras(); };
</script>

