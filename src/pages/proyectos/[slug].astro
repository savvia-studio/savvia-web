---
// RONDA 62 · CASO DE ESTUDIO (referencia: focuslab.agency/work/marketo). RONDA 63: en claro y con mucha más información.
// RONDA 64 (Andoni): «quitamos métricas en grande; más estilo agencia creativa: ir intercalando detalles de la web + detalles de la marca (colores
// puestos de forma animada, tipografía, etc.)». El caso alterna TEXTO y MARCA:
//   nombre · entradilla y ficha (las cifras, pequeñas, en la ficha) · portada · la frase · COLOR (bandas de su paleta que crecen al llegar) ·
//   un DETALLE de la web junto al reto · galería · TIPOGRAFÍA (su muestra, escrita en SU web con SU fuente, que se imprime al llegar) · la web sección
//   a sección · galería · apartados con otro DETALLE · galería · por dentro y lo descartado · la cita · el siguiente.
// Detalles (d1, d2) y muestras (tipo-1, tipo-2): public/media/obra/<slug>/ (tools/r64-detalles.py, tools/r64-tipos.cjs).
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Carriles from '../../components/Carriles.astro';
import Pie from '../../components/Pie.astro';
import Medio from '../../components/obra/Medio.astro';
import { proyectos, type Proyecto, type Medio as TMedio } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({ params: { slug: p.slug }, props: { p, sig: proyectos[(i + 1) % proyectos.length] } }));
}
const { p, sig } = Astro.props as { p: Proyecto; sig: Proyecto };
const g = [...p.galeria];
const tomar = (): TMedio[] => {
  if (!g.length) return [];
  if (g[0].ancho === 'mitad' && g[1]?.ancho === 'mitad') return g.splice(0, 2);
  return g.splice(0, 1);
};
const huecos = [tomar(), tomar(), g.splice(0)];
const det = (n: number): TMedio => ({ tipo: 'video', src: `/media/obra/${p.slug}/d${n}.mp4`, poster: `/media/obra/${p.slug}/d${n}.jpg` });
const ficha = [
  ['Servicios', p.servicios],
  ['Sector', p.sector ? [p.sector] : []],
  ['Lugar', p.ubicacion ? [p.ubicacion] : []],
  ['Con', p.con ? [p.con] : []],
  ['Herramientas', p.stack ?? []],
  ['En cifras', (p.cifras ?? []).map((c) => `${c.v} ${c.t}`)],
].filter(([, v]) => (v as string[]).length) as [string, string[]][];
const luz = (hex: string) => { const n = parseInt(hex.slice(1), 16), r = n >> 16, gg = (n >> 8) & 255, b = n & 255; return (r * 299 + gg * 587 + b * 114) / 1000 > 150; };
// el fondo de las muestras tipográficas: el color más claro de su paleta (la tinta de la muestra es la suya)
const claroMarca = (p.paleta ?? []).map((c) => c.hex).find((h) => luz(h)) ?? '#FFFFFF';
const [primero, ...resto] = p.apartados;
const media = (m: TMedio, dos: boolean) => (dos ? (m.movil ? '4 / 5' : '4 / 3') : m.movil ? '16 / 10' : '16 / 9');
---

<Base title={`${p.nombre} — savvia`} description={p.resumen} carga={false}>
  <Nav />
  <Carriles />
  <main id="contenido" class="caso surface-light" style={`--claro-marca:${claroMarca}`}>
    <header class="wrap cabecera">
      <a href="/proyectos" class="volver detail text-fg2"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12H5M10 7l-5 5 5 5" /></svg>Proyectos</a>
      <h1 class="font-display nombre" data-entra>{p.nombre}</h1>
    </header>

    <section class="wrap intro grid-12" aria-label="El proyecto">
      <div class="texto">
        <p class="entradilla" data-enfoca>{p.entradilla}</p>
        <div class="contexto" data-enfoca>{p.contexto.map((t) => <p>{t}</p>)}</div>
      </div>
      <dl class="ficha" data-enfoca>
        {
          ficha.map(([k, v]) => (
            <div>
              <dt class="detail detail-caps">{k}</dt>
              {v.map((x) => <dd class="text-aux text-fg2">{x}</dd>)}
            </div>
          ))
        }
        {p.url && <a href={p.url} class="ver text-aux" target="_blank" rel="noopener">Ver la web<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>}
      </dl>
    </section>

    <div class="wrap portada" data-enfoca>
      <Medio medio={p.portada} color={p.color} alt={`La web de ${p.nombre}`} proporcion={p.portada.movil ? '16 / 11' : '16 / 9'} transicion={`obra-${p.slug}`} />
    </div>

    {p.frase && <p class="wrap frase font-display" data-entra>{p.frase}</p>}

    <!-- COLOR: su paleta en bandas verticales que suben una tras otra al llegar; al pasar, la banda se ensancha -->
    {
      p.paleta && (
        <section class="wrap color" aria-label={`El color de ${p.nombre}`} data-vivo>
          <ul class="bandas">
            {p.paleta.map((c, i) => (
              <li style={`--c:${c.hex};--i:${i}`} class={luz(c.hex) ? 'sobre-claro' : 'sobre-oscuro'}>
                <span class="nm text-aux">{c.n}</span>
                <span class="hx detail">{c.hex}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="wrap par grid-12" aria-labelledby="reto-h">
      <div class="det-a" data-vivo><Medio medio={det(1)} color={p.color} alt={`Un detalle de la web de ${p.nombre}`} proporcion="1 / 1" /></div>
      <div class="lado">
        <h2 id="reto-h" class="font-display text-h3">El reto</h2>
        <p class="cuerpo grande mt-6">{p.reto}</p>
      </div>
    </section>

    {huecos[0].length > 0 && <div class={`wrap medios ${huecos[0].length === 2 ? 'dos' : ''}`}>{huecos[0].map((m) => <Medio medio={m} color={p.color} alt={`Un momento de la web de ${p.nombre}`} proporcion={media(m, huecos[0].length === 2)} />)}</div>}

    <!-- TIPOGRAFÍA: la muestra, escrita en su propia web con su fuente; se imprime de abajo arriba al llegar -->
    {
      p.tipos && (
        <section class="wrap tipos grid-12" aria-label={`La tipografía de ${p.nombre}`}>
          {p.tipos.slice(0, 2).map((t, i) => (
            <figure class={`muestra m${i + 1}`} data-vivo>
              <div class="hoja"><img src={`/media/obra/${p.slug}/tipo-${i + 1}.png`} alt={`Muestra de ${t.n}`} loading="lazy" decoding="async" /></div>
              <figcaption><span class="font-display tn">{t.n}</span><span class="text-aux text-fg2">{t.uso}</span></figcaption>
            </figure>
          ))}
        </section>
      )
    }

    {
      p.secciones && (
        <section class="wrap bloque grid-12" aria-labelledby="secc-h">
          <h2 id="secc-h" class="font-display text-h3 tit">La web, sección a sección</h2>
          <ol class="secciones">
            {p.secciones.map((s, i) => (
              <li data-enfoca>
                <span class="num detail">{String(i + 1).padStart(2, '0')}</span>
                <span class="sn">{s.n}</span>
                <span class="sd text-aux text-fg2">{s.d}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {huecos[1].length > 0 && <div class={`wrap medios ${huecos[1].length === 2 ? 'dos' : ''}`}>{huecos[1].map((m) => <Medio medio={m} color={p.color} alt={`Un momento de la web de ${p.nombre}`} proporcion={media(m, huecos[1].length === 2)} />)}</div>}

    {
      primero && (
        <section class="wrap par invertido grid-12" aria-label={primero.titulo}>
          <div class="lado">
            <h2 class="font-display text-h3">{primero.titulo}</h2>
            <div class="cuerpo mt-6">{primero.texto.map((t) => <p>{t}</p>)}</div>
          </div>
          <div class="det-b" data-vivo><Medio medio={det(2)} color={p.color} alt={`Otro detalle de la web de ${p.nombre}`} proporcion="1 / 1" /></div>
        </section>
      )
    }

    {
      resto.map((a) => (
        <section class="wrap bloque grid-12" aria-label={a.titulo}>
          <h2 class="font-display text-h3 tit">{a.titulo}</h2>
          <div class="cuerpo">{a.texto.map((t) => <p>{t}</p>)}</div>
        </section>
      ))
    }

    {huecos[2].length > 0 && <div class="wrap medios">{huecos[2].map((m) => <Medio medio={m} color={p.color} alt={`Un momento de la web de ${p.nombre}`} proporcion={media(m, false)} />)}</div>}

    {
      (p.tecnica || p.descartado) && (
        <section class="wrap bloque grid-12" aria-label="Por dentro">
          {p.tecnica && (
            <div class="lista-col">
              <h2 class="font-display text-h3">Por dentro</h2>
              <ul class="lista">{p.tecnica.map((t) => <li>{t}</li>)}</ul>
            </div>
          )}
          {p.descartado && (
            <div class="lista-col">
              <h2 class="font-display text-h3">Lo que se descartó</h2>
              <ul class="lista tachada">{p.descartado.map((t) => <li>{t}</li>)}</ul>
            </div>
          )}
        </section>
      )
    }

    {
      p.cita && (
        <section class="cita surface-dark section-y" aria-label="Lo que cuenta el cliente" data-sube>
          <figure class="wrap">
            <blockquote class="font-display">«{p.cita.texto}»</blockquote>
            <figcaption class="mt-8"><span class="text-ui font-medium">{p.cita.autor}</span><span class="text-aux text-fg2"> · {p.cita.rol}</span></figcaption>
          </figure>
        </section>
      )
    }

    <nav class={`wrap siguiente section-y ${p.cita ? '' : 'borde'}`} aria-label="Siguiente proyecto">
      <p class="detail detail-caps text-fg2">Siguiente proyecto</p>
      <a href={`/proyectos/${sig.slug}`} class="font-display sig">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M14 7l5 5-5 5" /></svg><span>{sig.nombre}</span>
      </a>
    </nav>
  </main>
  <Pie />
</Base>

<script>
  // lo que se anima al llegar (bandas de color, muestras, detalles): una vez, cuando asoma un 25 %
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('[data-vivo]').forEach((el) => io.observe(el));
</script>

<style>
  .caso {
    padding-top: calc(var(--spacing) * 32);
  }
  .volver {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    transition: color 0.3s ease;
  }
  .volver:hover {
    color: var(--fg);
  }
  .volver svg,
  .ver svg {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .nombre {
    margin-top: calc(var(--spacing) * 6);
    font-size: clamp(3.5rem, 1rem + 9vw, 10rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .intro {
    margin-top: calc(var(--spacing) * 16);
    row-gap: calc(var(--spacing) * 12);
  }
  .texto,
  .ficha,
  .tit,
  .cuerpo,
  .secciones,
  .lista-col,
  .det-a,
  .det-b,
  .lado,
  .muestra {
    grid-column: 1 / -1;
  }
  @media (width >= 64rem) {
    .texto {
      grid-column: 1 / span 8;
    }
    .ficha {
      grid-column: 10 / span 3;
    }
    .tit {
      grid-column: 1 / span 4;
    }
    .bloque .cuerpo,
    .secciones {
      grid-column: 5 / span 8;
    }
    .lista-col:first-child {
      grid-column: 1 / span 6;
    }
    .lista-col:nth-child(2) {
      grid-column: 7 / span 6;
    }
    /* los pares detalle + texto, asimétricos y alternos */
    .par .det-a {
      grid-column: 1 / span 5;
    }
    .par .lado {
      grid-column: 7 / span 5;
      align-self: center;
    }
    .par.invertido .lado {
      grid-column: 2 / span 5;
      grid-row: 1;
    }
    .par.invertido .det-b {
      grid-column: 8 / span 5;
      grid-row: 1;
      margin-top: calc(var(--spacing) * 24);
    }
    .muestra.m1 {
      grid-column: 1 / span 7;
    }
    .muestra.m2 {
      grid-column: 9 / span 4;
      margin-top: calc(var(--spacing) * 32);
    }
  }
  .ficha {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
  }
  .ficha dt {
    margin-bottom: calc(var(--spacing) * 2);
  }
  .ficha dd + dd {
    margin-top: calc(var(--spacing) * 1);
  }
  .ver {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    align-self: flex-start;
    border-bottom: 1px solid var(--rule-strong);
    padding-bottom: calc(var(--spacing) * 1);
  }
  .entradilla {
    font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2rem);
    line-height: 1.3;
    text-wrap: pretty;
  }
  .contexto {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--spacing) * 8);
    margin-top: calc(var(--spacing) * 12);
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--fg2);
  }
  @media (width < 48rem) {
    .contexto {
      grid-template-columns: 1fr;
      gap: calc(var(--spacing) * 6);
    }
  }
  .portada {
    margin-top: calc(var(--spacing) * 24);
  }
  .frase {
    padding-block: var(--space-section);
    font-size: clamp(2.25rem, 1.2rem + 4vw, 5rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    max-width: calc(20ch + var(--gutter) * 2);
    text-wrap: balance;
  }
  .frase::before {
    content: '';
    display: inline-block;
    width: 0.22em;
    height: 0.22em;
    margin-right: 0.3em;
    border-radius: 50%;
    background: var(--color-coral);
    vertical-align: 0.2em;
  }
  /* ── COLOR: bandas verticales que suben una tras otra; la primera, más ancha; al pasar, se ensancha la que pisas */
  .bandas {
    display: flex;
    gap: calc(var(--spacing) * 1);
    height: clamp(18rem, 55lvh, 34rem);
  }
  .bandas li {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: calc(var(--spacing) * 1);
    padding: calc(var(--spacing) * 4);
    border-radius: var(--radius-lg);
    background: var(--c);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cacao) 10%, transparent);
    overflow: hidden;
    clip-path: inset(100% 0 0 0 round var(--radius-lg));
    transition:
      clip-path 1.1s var(--ease-out-expo) calc(var(--i) * 110ms),
      flex-grow 0.9s var(--ease-out-expo);
  }
  .bandas li:first-child {
    flex-grow: 2.4;
  }
  .bandas:hover li {
    flex-grow: 0.8;
  }
  .bandas li:hover {
    flex-grow: 3;
  }
  .color.visto .bandas li {
    clip-path: inset(0 0 0 0 round var(--radius-lg));
  }
  .sobre-claro {
    color: var(--color-cacao);
  }
  .sobre-oscuro {
    color: var(--color-niebla);
  }
  .bandas .nm,
  .bandas .hx {
    white-space: nowrap;
    opacity: 0;
    translate: 0 calc(var(--spacing) * 2);
    transition: opacity 0.6s ease, translate 0.8s var(--ease-out-expo);
    transition-delay: calc(0.5s + var(--i) * 110ms);
  }
  .color.visto .nm,
  .color.visto .hx {
    opacity: 1;
    translate: 0 0;
  }
  .hx {
    opacity: 0.7;
  }
  .color.visto .hx {
    opacity: 0.7;
  }
  @media (width < 48rem) {
    .bandas {
      flex-direction: column;
      height: auto;
    }
    .bandas li {
      min-height: calc(var(--spacing) * 16);
    }
  }
  /* ── PARES: un detalle de la web junto a un texto */
  .par {
    padding-block: var(--space-section);
    row-gap: calc(var(--spacing) * 12);
  }
  .det-a,
  .det-b {
    clip-path: inset(12% 12% 12% 12% round var(--radius-lg));
    scale: 1.06;
    transition: clip-path 1.2s var(--ease-out-expo), scale 1.4s var(--ease-out-expo);
  }
  .det-a.visto,
  .det-b.visto {
    clip-path: inset(0 0 0 0 round var(--radius-lg));
    scale: 1;
  }
  .cuerpo {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--fg2);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
    max-width: 64ch;
  }
  .cuerpo.grande {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.625rem);
    line-height: 1.4;
    color: var(--fg);
  }
  /* ── TIPOGRAFÍA: la muestra sobre el color claro de su marca; se imprime de abajo arriba */
  .tipos {
    padding-block: var(--space-section);
    row-gap: calc(var(--spacing) * 16);
    align-items: start;
  }
  .muestra {
    margin: 0;
  }
  .hoja {
    display: grid;
    place-items: center start;
    padding: clamp(1.5rem, 4vw, 4rem);
    border-radius: var(--radius-lg);
    background: var(--claro-marca);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cacao) 10%, transparent);
    overflow: hidden;
  }
  .hoja img {
    width: 100%;
    height: auto;
    clip-path: inset(100% 0 0 0);
    translate: 0 calc(var(--spacing) * 6);
    transition: clip-path 1.4s var(--ease-out-expo) 0.15s, translate 1.4s var(--ease-out-expo) 0.15s;
  }
  .muestra.visto .hoja img {
    clip-path: inset(0 0 0 0);
    translate: 0 0;
  }
  .muestra figcaption {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 1);
    margin-top: calc(var(--spacing) * 4);
  }
  .tn {
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .bloque {
    padding-block: calc(var(--spacing) * 24);
    row-gap: calc(var(--spacing) * 6);
    border-top: 1px solid var(--rule);
  }
  .medios {
    display: grid;
    gap: calc(var(--spacing) * 6);
    margin-block: calc(var(--spacing) * 6);
  }
  .medios.dos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (width < 48rem) {
    .medios.dos {
      grid-template-columns: 1fr;
    }
  }
  .secciones li {
    display: grid;
    grid-template-columns: calc(var(--spacing) * 12) minmax(0, 14rem) minmax(0, 1fr);
    gap: calc(var(--spacing) * 4);
    align-items: baseline;
    padding-block: calc(var(--spacing) * 4);
    border-bottom: 1px solid var(--rule);
  }
  .secciones li:first-child {
    padding-top: 0;
  }
  .num {
    color: var(--fg2);
    font-variant-numeric: tabular-nums;
  }
  .sn {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.2;
  }
  @media (width < 48rem) {
    .secciones li {
      grid-template-columns: calc(var(--spacing) * 8) minmax(0, 1fr);
    }
    .sd {
      grid-column: 2;
    }
  }
  .lista-col {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
  }
  .lista li {
    padding-block: calc(var(--spacing) * 3);
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--fg2);
  }
  .lista.tachada li {
    position: relative;
    padding-left: calc(var(--spacing) * 6);
  }
  .lista.tachada li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 1.35em;
    width: calc(var(--spacing) * 3);
    height: 1.5px;
    background: var(--color-coral);
  }
  .cita blockquote {
    font-size: clamp(1.75rem, 1.1rem + 2.2vw, 3rem);
    line-height: 1.2;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .siguiente {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 4);
  }
  .siguiente.borde {
    border-top: 1px solid var(--rule);
  }
  .sig {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 6);
    align-self: flex-start;
    font-size: clamp(3rem, 1.2rem + 6vw, 7.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .sig svg {
    flex: none;
    width: 0.6em;
    height: 0.6em;
    fill: none;
    stroke: var(--color-coral);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.6s var(--ease-out-expo);
  }
  .sig span {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease-out-expo);
  }
  .sig:hover svg {
    translate: 0.15em 0;
  }
  .sig:hover span {
