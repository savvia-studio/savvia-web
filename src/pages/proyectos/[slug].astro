---
import Caso from '../../views/Caso.astro';
import { proyectos } from '../../data/proyectos';

export function getStaticPaths() {
  return proyectos.map((p, i) => ({ params: { slug: p.slug }, props: { p, sig: proyectos[(i + 1) % proyectos.length], ant: proyectos[(i - 1 + proyectos.length) % proyectos.length] } }));
}
---

<Caso {...Astro.props} />
