---
// RONDA 62 · TODOS LOS PROYECTOS (referencia: focuslab.agency/work). RONDA 63 (Andoni): «en light mode; los destacados, como en "Más proyectos";
// los filtros más elegantes y un buscador inteligente». En claro (Rosa niebla); los destacados son PIEZAS (degradado de su web + navegador, o la mesa
// con la web en el monitor) en un mosaico asimétrico; debajo, un BUSCADOR que entiende sinónimos, acentos y erratas, y filtros tipográficos con
// recuento. Todo se filtra en la página; el estado va en la dirección (?q=&servicio=&sector=).
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import PiezaCasa, { type ObraCasa } from '../components/obra/PiezaCasa.astro';
import Visor from '../components/obra/Visor.astro';
import Cta from '../components/Cta.astro';
import Voces from '../components/Voces.astro';
import { CASOS_LISTOS } from '../lib/lanzamiento';
import { proyectosDe, servicio } from '../data/idioma';
import { langDe, ruta } from '../lib/i18n';

const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
// OCTUBRE 2026 · Andoni: «trasladar la estructura de cómo presentamos los proyectos en la home; los filtros, los que teníamos en treseiscero.com/portfolio,
// pero flotantes y a nuestro estilo; y todos los proyectos de ese portfolio». Los proyectos y sus filtros (país · tecnología · servicio · categoría) salen
// del CMS de treseiscero (tools/portfolio-tsc/extraer.cjs → src/data/portfolio-tsc.json; capturas y colores: medios.cjs). Delante, los agénticos con caso.
import TSC from '../data/portfolio-tsc.json';
import { home } from '../data/idioma';
const casos = proyectosDe(lang).map((p) => ({ ...p, servicios: p.servicios.map((s) => servicio(lang, s)) }));
const caso = (slug: string) => casos.find((p) => p.slug === (slug === 'playground-iep' ? 'playground' : slug));
const casa = Object.fromEntries((home(lang).proyectos.anteriores as { slug: string; n: string; sector?: string; color: string[] }[]).map((a) => [a.slug, a]));
const NOMBRE: Record<string, string> = { greet: 'Greet', stellar: 'Stellar', 'playground-agentico': 'Playground IEP', 'fiallegas-abogados': 'Fiallegas Abogados', wisable: 'Wisable', cubbo: 'Cubbo', remerge: 'Remerge', surepayroll: 'SurePayroll', qalea: 'Qalea', 'home-of-ambrose': 'Home of Ambrose', gsbindex: 'GSB Index', kymatio: 'Kymatio', isotrol: 'Isotrol', monad: 'Monad', bluence: 'Bluence', 'claudia-be': 'Claudia BE', adaral: 'Adaral', 'business-online-payroll': 'Business Online Payroll', 'numen-games': 'Numen Games', 'managerpro-by-codely': 'ManagerPro by Codely', invopop: 'Invopop', 'endoaula-conecta': 'Endoaula Conecta', lyra: 'Lyra', valuat: 'Valuat', 'casa-for-agents': 'Crece con Casavo', stemdo: 'Stemdo', 'alpine-security': 'Alpine Security', 'homeplus-casavo': 'Home+ Casavo', soundtown: 'Soundtown', endoaula: 'Endoaula', 'gow-delivery': 'GOW Delivery', 'junipero-vc': 'Junípero', 'eleven-lab': 'Eleven Lab', vitalera: 'Vitalera', zrive: 'Zrive', ikon: 'Ikon', 'playground-iep': 'Playground IEP', naterra: 'Naterra', kalma: 'Kalma', kabila: 'Kabila', 'impact-bridge': 'Impact Bridge', 'profounders-capital': 'PROfounders Capital', 'transcend-network': 'Transcend', routal: 'Routal', thx: 'THX' };
const ES: Record<string, string> = {
  // países
  Spain: 'España', 'United States': 'Estados Unidos', 'United Kingdom': 'Reino Unido', Italy: 'Italia', Germany: 'Alemania',
  // servicios
  'HubSpot Integration': 'Integración con HubSpot', 'Webflow development': 'Desarrollo en Webflow', 'Custom animations/GSAP': 'Animaciones a medida (GSAP)', 'Web design': 'Diseño web',
  'CMS integration': 'CMS', 'Lottie animations': 'Animaciones Lottie', 'UX/UI design': 'Diseño UX/UI', 'WhaleSync integration': 'Integración con WhaleSync',
  'MemberStack integration': 'Integración con Memberstack', 'Branding concept': 'Concepto de marca', 'Make automatization': 'Automatización con Make',
  'Agentic development': 'Desarrollo agéntico', 'Webflow localization': 'Multidioma', 'Webflow user accounts': 'Cuentas de usuario',
  // categorías
  'Brand Portfolio': 'Portfolio de marca', Consultancy: 'Consultoría', Cybersecurity: 'Ciberseguridad', Delivery: 'Reparto', Eldercare: 'Cuidado de mayores', Finance: 'Finanzas',
  Healthcare: 'Salud', Legal: 'Legal', Logistics: 'Logística', 'Real State': 'Inmobiliario', 'Renewable energy': 'Renovables', 'Social Impact': 'Impacto social', Tech: 'Tecnología', VC: 'Capital riesgo',
};
const t = (x: string) => (en ? x : ES[x] ?? x);
// categorías que no dicen a qué se dedica el cliente (no sirven de sector bajo la pieza)
const META = new Set(['Awwwards', 'YCombinator', 'Webflow Enterprise', 'Tech']);
type Obra = { slug: string; nombre: string; dominio: string; href: string; sector: string; colores: [string, string, string]; portada: { tipo: 'video'; src: string; poster: string }; movil?: string; videoMovil?: { src: string; poster: string };
  pais: string[]; tec: string[]; servicios: string[]; categorias: string[] };
// los que tienen grabación de su web (public/media/anteriores/video/<slug>.mp4: suena al pasar); los demás, su captura del CMS
const GRABADOS = new Set(['greet', 'playground-agentico', 'fiallegas-abogados', 'gsbindex', 'profounders-capital', 'bluence', 'lyra', 'adaral', 'managerpro-by-codely', 'valuat', 'zrive', 'ikon', 'kabila', 'impact-bridge', 'gow-delivery', 'alpine-security', 'junipero-vc', 'business-online-payroll', 'claudia-be', 'cubbo', 'eleven-lab', 'home-of-ambrose', 'invopop', 'isotrol', 'kymatio', 'monad', 'naterra', 'remerge', 'routal', 'surepayroll', 'thx', 'transcend-network', 'wisable', 'homeplus-casavo', 'vitalera', 'kalma', 'playground-iep', 'casa-for-agents', 'stellar']);
// 27/10 · Eric (vitrina de proyectos): «solo thumbnail» (Home+ Casavo): su captura, sin vídeo ni móvil;
// y sin móvil, los que no convencen en el teléfono (Lyra, Eleven Lab, Zrive: «hay cosas desalineadas», «bastante pobre»; Valuat: «solo desktop»;
// 29/10, Home of Ambrose, Transcend, Isotrol y GOW: «que no se pueda ver en mobile, no me gusta cómo se ve»; GOW, «tiene bastante zoom»)
// (Crece con Casavo era «solo thumbnail» hasta que llegaron sus grabaciones, el 27/10: ahora con vídeo de escritorio y de móvil)
const SOLO_THUMB = new Set(['homeplus-casavo']);
const SIN_MOVIL = new Set(['lyra', 'eleven-lab', 'zrive', 'invopop', 'home-of-ambrose', 'transcend-network', 'isotrol', 'gow-delivery', ...SOLO_THUMB]);
const conVideo = (slug: string) => GRABADOS.has(slug) && !SOLO_THUMB.has(slug);
const MOVIL_GRABADO = new Set(['cubbo', 'valuat', 'remerge', 'claudia-be', 'routal', 'surepayroll', 'monad', 'thx', 'gsbindex', 'home-of-ambrose', 'kymatio', 'profounders-capital', 'naterra', 'bluence', 'lyra', 'business-online-payroll', 'adaral', 'managerpro-by-codely', 'fiallegas-abogados', 'gow-delivery','alpine-security', 'homeplus-casavo', 'junipero-vc', 'eleven-lab', 'vitalera', 'ikon', 'isotrol', 'qalea', 'kalma', 'kabila', 'impact-bridge', 'playground-agentico', 'transcend-network', 'wisable', 'greet', 'playground-iep', 'stellar', 'casa-for-agents']); // con grabación en móvil (<slug>-movil.mp4)
// 26/10 · Eric: Greet (greet.video, de los últimos), que no está en el CMS de treseiscero: va detrás de los del CMS (al final: así no mueve de sitio ni de forma a los demás), con su grabación (Screen Studio)
const EXTRA = [
  { slug: 'greet', dominio: 'greet.video', pais: ['Germany'], tecnologia: ['Webflow'], servicios: ['Web design', 'Webflow development'], categorias: ['Marketing'],
    colores: ['#0b3a1f', '#164b2f', '#c8102e'], sector: en ? 'Personalised video' : 'Vídeo personalizado' },
  // 26/10 · Eric: la home nueva de Playground IEP que hace Andoni con Claude (playgroundiep.treseiscero.app/home-v3); la de Webflow se queda («también es nuestra»)
  { slug: 'playground-agentico', dominio: 'playgroundiep.com', pais: ['United States'], tecnologia: ['Claude Code'], servicios: ['Web design', 'Agentic development'], categorias: ['EdTech'],
    colores: ['#efe9fb', '#8b6cf6', '#f6b8d8'], sector: en ? 'Special education' : 'Educación especial' },
  // 26/10 · Eric: Fiallegas Abogados (Eibar y Donostia), en Webflow; «a mitad de tabla, con pantalla de mesa»
  { slug: 'fiallegas-abogados', dominio: 'fiallegas-abogados.com', pais: ['Spain'], tecnologia: ['Webflow'], servicios: ['Web design', 'Webflow development'], categorias: ['Legal'],
    colores: ['#1f2c3f', '#3a4a63', '#c9b79c'], sector: en ? 'Law firm' : 'Despacho de abogados' },
  // 27/10 · Eric: Stellar (stellar X labs), «nuevo proyecto»: España · capital riesgo · Figma y Webflow · animaciones. FALTA su dominio (sin él no enlaza)
  { slug: 'stellar', dominio: '', pais: ['Spain'], tecnologia: ['Figma', 'Webflow'], servicios: ['Custom animations/GSAP'], categorias: ['VC'],
    colores: ['#e3c9d3', '#7d93c4', '#2f4677'], sector: en ? 'Venture capital' : 'Capital riesgo' },
];
// las tecnologías del filtro, las de treseiscero (las pilas de los casos agénticos solo cuentan si coinciden)
const TECS = new Set(TSC.flatMap((d) => d.tecnologia));
// 26/10 · Eric: fuera Quantus y Patchbay del portfolio («al final son showcase para la home de desarrollo agéntico»). 27/10 · Eric, desde la vitrina:
// «mostremos todos los que hemos dicho que están bien»: vuelven, con los medios de la vitrina (su portada; Quantus con su móvil, Patchbay sin: «el responsive
// no está bien resuelto»). (Neety no tiene `url` en su ficha: su web es neety.com, como en home.ts › anteriores)
const AGENTICOS = ['neety', 'quantus', 'patchbay'].map((s) => caso(s)!).filter(Boolean).map((c): Obra => ({
  slug: c.slug, nombre: c.nombre, dominio: c.dominio ?? '', href: CASOS_LISTOS.includes(c.slug) ? ruta(lang, `/proyectos/${c.slug}`) : c.url ?? `https://${c.dominio ?? (c.slug === 'neety' ? 'neety.com' : c.slug)}`, sector: c.sector ?? '', colores: c.colores,
  // 27/10 · Eric: Neety, con su grabación de escritorio de Screen Studio (la de /proyectos; el caso sigue con su portada)
  portada: c.slug === 'neety' ? { tipo: 'video', src: '/media/anteriores/video/neety.mp4', poster: '/media/anteriores/video/neety.jpg' } : { tipo: 'video', src: (c.escritorio ?? c.portada).src, poster: (c.escritorio ?? c.portada).poster ?? '' },
  pais: c.ubicacion ? [c.ubicacion.split(',').pop()!.trim()] : [], tec: (c.stack ?? []).filter((x) => TECS.has(x)), servicios: c.servicios, categorias: c.sector ? [c.sector] : [],
  ...(c.slug === 'neety' ? { movil: '/media/portfolio/neety-movil.webp', videoMovil: { src: '/media/anteriores/video/neety-com-movil.mp4', poster: '/media/anteriores/video/neety-com-movil.jpg' } } : {}),
  ...(c.slug === 'quantus' ? { videoMovil: { src: '/media/anteriores/video/quantus-movil.mp4', poster: '/media/anteriores/video/quantus-movil.jpg' } } : {}),
}));
// 26/10 · Eric: «hay que tener orden»: el ORDEN de la rejilla y lo de cada pieza (forma fija, nombre, sector, colores, fuera) los decide la herramienta
// «Orden de /proyectos» (claude.ai/artifact/EnYvzyRJn87Axd3SsUfBGP) y se copian a portfolio-orden.json. Lo que no esté en `orden` va al final (así un
// proyecto nuevo no mueve de sitio, ni de forma, a los demás).
import ORDEN from '../data/portfolio-orden.json';
// 27/10 · de la vitrina de proyectos: `g` = la disposición del fondo de marca (0 A, la de siempre · 1 B · 2 C · 3 D · 4 liso) y `t` = sus etiquetas, en
// castellano, cuando Eric las ha cambiado (país · tecnología · servicio · categoría; en inglés se traducen de vuelta con ES)
type Etiquetas = { pais?: string[]; tec?: string[]; servicio?: string[]; categoria?: string[] };
type Ajuste = { forma?: 'navegador' | 'escena' | 'movil'; nav?: [number, number, number, number]; zm?: number; zt?: number; ar?: number; n?: string; s?: string; c?: [string, string, string]; oculto?: boolean; g?: number; t?: Etiquetas };
const AJUSTES = ORDEN.piezas as unknown as Record<string, Ajuste>;
const puesto = (slug: string) => { const i = ORDEN.orden.indexOf(slug); return i < 0 ? Infinity : i; };
const TODAS: Obra[] = [
  ...AGENTICOS,
  ...[...TSC, ...EXTRA].map((d): Obra => {
    const c = caso(d.slug), h = casa[d.slug];
    const cats = d.categorias.map(t);
    const sector = h?.sector ?? c?.sector ?? (d as { sector?: string }).sector ?? t(d.categorias.find((x) => !META.has(x)) ?? d.categorias[0] ?? '');
    const video = conVideo(d.slug) ? { src: `/media/anteriores/video/${d.slug}.mp4`, poster: `/media/anteriores/video/${d.slug}.jpg` }
      : { src: '', poster: SOLO_THUMB.has(d.slug) && GRABADOS.has(d.slug) ? `/media/anteriores/video/${d.slug}.jpg` : `/media/portfolio/${d.slug}.webp` };
    return {
      slug: d.slug, nombre: h?.n ?? c?.nombre ?? NOMBRE[d.slug] ?? d.dominio, dominio: d.dominio,
      href: c && CASOS_LISTOS.includes(c.slug) ? ruta(lang, `/proyectos/${c.slug}`) : d.dominio ? `https://${d.dominio}` : '#', sector,
      colores: ((h?.color as [string, string, string]) ?? c?.colores ?? d.colores) as [string, string, string],
      portada: { tipo: 'video', ...video }, pais: d.pais.map(t), tec: d.tecnologia, servicios: d.servicios.map(t), categorias: cats,
      movil: (d as { movil?: boolean }).movil && !SIN_MOVIL.has(d.slug) ? `/media/portfolio/${d.slug}-movil.webp` : undefined,
      videoMovil: MOVIL_GRABADO.has(d.slug) && !SIN_MOVIL.has(d.slug) ? { src: `/media/anteriores/video/${d.slug}-movil.mp4`, poster: `/media/anteriores/video/${d.slug}-movil.jpg` } : undefined,
    };
  }),
];
const OBRAS: Obra[] = TODAS.map((o, n) => ({ o, n })).sort((a, b) => puesto(a.o.slug) - puesto(b.o.slug) || a.n - b.n).map(({ o }) => o)
  .filter((o) => !AJUSTES[o.slug]?.oculto)
  .map((o) => { const a = AJUSTES[o.slug]; return a ? { ...o, nombre: a.n ?? o.nombre, sector: a.s ?? o.sector, colores: a.c ?? o.colores,
    ...(a.t && !en ? { pais: a.t.pais ?? o.pais, tec: a.t.tec ?? o.tec, servicios: a.t.servicio ?? o.servicios, categorias: a.t.categoria ?? o.categorias } : {}) } : o; });
// los cuatro filtros, con su recuento (de más a menos; a igualdad, por nombre)
const opciones = (f: (o: Obra) => string[]) => {
  const n = new Map<string, number>();
  OBRAS.forEach((o) => f(o).forEach((v) => n.set(v, (n.get(v) ?? 0) + 1)));
  return [...n].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], lang));
};
const FILTROS = [
  { k: 'pais', n: en ? 'Country' : 'País', ops: opciones((o) => o.pais) },
  { k: 'tec', n: en ? 'Technology' : 'Tecnología', ops: opciones((o) => o.tec) },
  { k: 'servicio', n: en ? 'Service' : 'Servicio', ops: opciones((o) => o.servicios) },
  { k: 'categoria', n: en ? 'Category' : 'Categoría', ops: opciones((o) => o.categorias) },
] as const;
// 27/10 · sin páginas: proyectos en TRAMOS con un mentor detrás de cada uno (antes, de 16 en 16 con «Ver más proyectos»). Tantos mentores como tramos
// de ~11 quepan (de 1 a 4) y repartidos a partes iguales, con el último siempre al final: nunca queda un proyecto suelto tras el último mentor.
// La misma cuenta, en el script (cortes()).
const MENTORES = home(lang).proyectos.testimonios.length;
const cortes = (n: number) => { const c = Math.max(1, Math.min(MENTORES, Math.round(n / 11))); return Array.from({ length: c }, (_, k) => Math.round((n * (k + 1)) / c)); };
const CORTES = cortes(OBRAS.length);
const casaDe = (o: Obra): ObraCasa => ({
  slug: o.slug, nombre: o.nombre, sector: o.sector, href: o.href, colores: o.colores,
  video: o.portada.src ? { src: o.portada.src, poster: o.portada.poster } : undefined,
  captura: o.portada.src ? o.portada.poster : o.portada.poster, movil: o.movil, videoMovil: o.videoMovil,
  // 27/10 · Eric: «y el zoom de la mesa desktop también, y zoom de mobile mesa», «y proporción de mockup también» (la de la carátula entera: `ar`, ancho/alto, manda sobre la del SITIO; ver `data-ratio`) (herramienta de orden › db orden/actual › zoom)
  zMesa: AJUSTES[o.slug]?.zm, zMovil: AJUSTES[o.slug]?.zt,
});
const texto = (o: Obra) => [o.nombre, o.dominio, o.sector, ...o.pais, ...o.tec, ...o.servicios, ...o.categorias].filter(Boolean).join(' · ');
---

<Base title={en ? 'savvia projects' : 'Proyectos de savvia'} description={en ? 'Custom websites, end to end: the projects of savvia, the web studio of Eric and Andoni.' : 'Webs a medida, de principio a fin: los proyectos de savvia, el estudio web de Eric y Andoni.'} carga={false}>
  <Nav />
  <Carriles />
  <!-- ronda 129: con JS, el navegador de cada pieza espera bajo su borde y sube al entrar (sin JS, en su sitio). Antes de pintar las piezas. -->
  <script is:inline>document.documentElement.classList.add('pz-js');</script>
  <main id="contenido" class="obras surface-light">
    <header class="wrap cabecera">
      <h1 class="font-display titular" data-entra>{en ? 'Custom websites.' : 'Webs a medida.'}</h1>
      <p class="text-sub text-fg2 mt-6 measure" data-enfoca>{en ? 'Our featured projects since 2020, both no-code and agentic development.' : 'Nuestros proyectos destacados desde 2020, tanto de no-code como desarrollo agéntico.'}</p>
    </header>

    <!-- 27/10 · Eric: en móvil, sin las dos cruces del vértice de la fila de filtros. (28/10 se quitó la fila entera y Eric la echó en falta: vuelve) -->
    <section class="wrap todos" aria-label={en ? 'All projects' : 'Todos los proyectos'} data-todos data-carril-sin-cruces-movil>
      <!-- RONDA 64 · «dejamos solo el buscador; en el buscador está escrito por defecto "Todos los proyectos": el titular se convierte en el propio
           buscador». El h2 es el campo: en Family, del tamaño de un titular; al escribir, busca. A la derecha, discretos: «Filtros» (se despliegan)
           y el orden de la rejilla (filas de 2 o de 3; ronda 129: fuera el «libre»). -->
      <!-- RONDA 144 · Eric: «el buscador está aquí pero lo buscas allí: que se vea que puedes filtrar rápido; el botón de filtros, más llamativo».
           Titular a la izquierda; a la derecha, en una sola fila, el BUSCADOR (un campo de verdad) y «Filtros» (CTA de cristal con su recuento). -->
      <!-- OCTUBRE 2026 · Eric y Andoni (reunión del 22/10): «el portfolio, con un scroll vertical continuo y filtros flotantes; fuera los destacados de
           arriba». Sin slider ni páginas: todos los proyectos seguidos (se van mostrando al bajar) y el buscador con «Filtros» en una barra que flota
           abajo mientras recorres la rejilla; los filtros se abren encima, en vertical. -->
      <!-- 26/10 · Eric: «más complejo, como en treseiscero.com/portfolio» y «al filtrar me lleva al footer»: los cuatro filtros vuelven ARRIBA, en cuatro
           cajas (rótulo pequeño, lo elegido grande y el chevrón), y las listas se abren hacia abajo; la barra flotante de abajo se va -->
      <!-- LOS FILTROS de treseiscero.com/portfolio, DIVIDIDOS como allí (Andoni: «sin el buscador; divididos como teníamos en treseiscero»): cuatro
           desplegables —país · tecnología · servicio · categoría—, cada uno con su rótulo y lo elegido, y «Quitar filtros», en una barra que flota abajo;
           cada lista se abre encima de su botón -->
      <div class="flota" data-flota>
        <div class="mandos barra-f" role="group" aria-label={en ? 'Filters' : 'Filtros'}>
          <!-- la BARRITA que sigue al puntero por los filtros y se queda en el que está abierto (Andoni) -->
          <span class="mira" aria-hidden="true" data-mira></span>
          {FILTROS.map((f) => {
            const todos = en ? 'All' : f.k === 'tec' || f.k === 'categoria' ? 'Todas' : 'Todos';
            return (
              <div class="desp" data-desp={f.k}>
                <button type="button" class="desp-b" aria-expanded="false" aria-controls={`f-${f.k}`} data-desp-b>
                  <span class="desp-n">{f.n}</span>
                  <span class="desp-v" data-desp-v data-todos={todos}>{todos}</span>
                  <svg class="desp-ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
                </button>
                <div id={`f-${f.k}`} class="desp-menu" role="group" aria-label={f.n} inert data-desp-menu>
                  <span class="mira mira-op" aria-hidden="true" data-mira></span>
                  <button type="button" class="op" aria-pressed="true" data-f={f.k} data-v="" style="--k:0">{todos}</button>
                  {f.ops.map(([v, n], k) => <button type="button" class="op" aria-pressed="false" data-f={f.k} data-v={v} style={`--k:${k + 1}`}>{v}<sup>{n}</sup></button>)}
                </div>
              </div>
            );
          })}
          <!-- Andoni: «el número de proyectos, en otro lado, sutil»: al final, con «Quitar» -->
          <div class="estado-f">
            <button type="button" class="limpiar-f" data-limpiar-f aria-label={en ? 'Clear filters' : 'Quitar filtros'} inert><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7h15M9.5 7V5.2c0-.66.54-1.2 1.2-1.2h2.6c.66 0 1.2.54 1.2 1.2V7M6.5 7l.8 11.3c.07.97.88 1.7 1.85 1.7h5.7c.97 0 1.78-.73 1.85-1.7L17.5 7M10.2 10.8v5.6M13.8 10.8v5.6" /></svg></button>
            <span class="cuenta" aria-live="polite" data-cuenta></span>
          </div>
        </div>
      </div>
      <!-- 27/10 · Eric: «cuando no hay nada, algo centradito y más de diseño» -->
      <div class="vacio" data-vacio hidden>
        <p class="font-display text-h2 vacio-t">{en ? 'Nothing here, yet.' : 'Aquí no hay nada, todavía.'}</p>
        <p class="text-sub text-fg2 mt-4">{en ? 'No project matches all those filters at once.' : 'Ningún proyecto cumple todos esos filtros a la vez.'}</p>
        <div class="mt-8"><Cta variante="secundario" flecha="no" data-limpiar><svg class="ic-papelera" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 7h15M9.5 7V5.2c0-.66.54-1.2 1.2-1.2h2.6c.66 0 1.2.54 1.2 1.2V7M6.5 7l.8 11.3c.07.97.88 1.7 1.85 1.7h5.7c.97 0 1.78-.73 1.85-1.7L17.5 7M10.2 10.8v5.6M13.8 10.8v5.6" /></svg>{en ? 'Clear filters' : 'Quitar filtros'}</Cta></div>
      </div>
      <!-- cada proyecto, dentro de SU degradado (la pieza de «Más proyectos»), no la web a sangre.
           27/10 · Eric: «en vez de "Ver más proyectos", al tener cuatro mentores: serie de proyectos, mentor, serie de proyectos, mentor…»: TRAMOS de 11
           (las 44 piezas son cuatro tramos; 11 = filas de 3 · 2 · 3 · 3 del mosaico) y, tras cada uno, un mentor a todo el ancho (todos como el primero: retrato a la izquierda,
           cita a la derecha). Sin JS ya van así; al filtrar, el script los recoloca (uno por tramo completo y, si no, uno al final) -->
      <ul class="rejilla mosaico" data-rejilla-obras data-eco-ultimo>
        {/* los mentores que no caben en un corte (pocos proyectos) también van, escondidos: el script los saca al filtrar */}
        {
          OBRAS.map((o, i) => (
            <Fragment>
            <li data-obra data-slug={o.slug} data-forma={AJUSTES[o.slug]?.forma} data-fondo={AJUSTES[o.slug]?.g || undefined} data-navegador={AJUSTES[o.slug]?.nav?.join(',')} data-ratio={AJUSTES[o.slug]?.ar} data-servicios={o.servicios.join('|')} data-categoria={o.categorias.join('|')} data-sector={o.sector} data-pais={o.pais.join('|')} data-tec={o.tec.join('|')} data-texto={texto(o)} data-nombre={o.nombre}>
              <PiezaCasa o={casaDe(o)} i={i} />
              {/* 27/10 · Eric: «de cada carátula, un botoncito para cambiar de escena»: mockup · mesa · móvil (este, solo si hay móvil). Fuera del enlace */}
              <div class="escenas" role="group" aria-label={en ? `View ${o.nombre} as` : `Ver ${o.nombre} en`} data-escenas>
                <button type="button" data-escena="navegador" aria-label={en ? 'Browser' : 'Navegador'} title={en ? 'Browser' : 'Navegador'}><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18" /></svg></button>
                <button type="button" data-escena="escena" aria-label={en ? 'Desk' : 'Mesa'} title={en ? 'Desk' : 'Mesa'}><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.6" /><path d="M12 16v4M8 20h8" /></svg></button>
                {(o.movil || o.videoMovil) && <button type="button" data-escena="movil" aria-label={en ? 'Phone' : 'Móvil'} title={en ? 'Phone' : 'Móvil'}><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2.2" /><path d="M11 18h2" /></svg></button>}
              </div>
            </li>
            {CORTES.includes(i + 1) && <li class="mentor" data-mentor><Voces k={CORTES.indexOf(i + 1)} /></li>}
            </Fragment>
          ))
        }
        {Array.from({ length: MENTORES - CORTES.length }, (_, j) => CORTES.length + j).map((k) => <li class="mentor" data-mentor hidden><Voces k={k} /></li>)}
      </ul>
    </section>
    <!-- 27/10 · Eric: fuera la cuadrícula de clientes y testimonios («ya la tenemos en la home y aquí es demasiado») -->
    <Visor obras={OBRAS.map((o) => ({ slug: o.slug, nombre: o.nombre, sector: o.sector, colores: o.colores, video: o.portada.src || undefined, poster: o.portada.poster }))} />
  </main>
  <Pie />
</Base>

<script>
  import { t } from '../scripts/i18n';
  import { formar, entrar, preparar, type Forma } from '../scripts/pieza-casa';
  // ── EL BUSCADOR «inteligente», todo en el navegador (sin IA detrás): normaliza (minúsculas, sin acentos), amplía cada palabra con SINÓNIMOS del
  // oficio, acepta prefijos y una errata en palabras de 5 letras o más, y ordena por dónde aparece (nombre > sector y servicios > el resto del caso).
  const SIN_ES: Record<string, string[]> = {
    multidioma: ['idioma', 'idiomas', 'multilingue', 'multilenguaje', 'traduccion', 'traducir', 'i18n', 'localizacion', 'internacional', 'ingles', 'coreano', 'japones', 'chino', 'portugues'],
    fintech: ['finanzas', 'financiero', 'banca', 'banco', 'bancos', 'nominas', 'nomina', 'pagos', 'facturacion', 'factura', 'facturas', 'payroll'],
    ia: ['inteligencia', 'artificial', 'ai', 'agentico', 'agentica', 'agentes', 'llm', 'modelos', 'cuantica'],
    migracion: ['migrar', 'mudanza', 'unificar', 'unificadas', 'redirecciones'],
    cms: ['contenido', 'contenidos', 'colecciones', 'fichas', 'blog'],
    animacion: ['animaciones', 'motion', 'movimiento', 'interaccion', 'interacciones'],
    desarrolladores: ['developers', 'api', 'programadores'],
    educacion: ['colegios', 'escuelas', 'profesores', 'alumnos', 'edtech'],
    renovables: ['energia', 'solar', 'eolica', 'sostenible'],
    ventas: ['b2b', 'comercial', 'comerciales', 'saas', 'crm'],
    logistica: ['ecommerce', 'envios', 'almacen', 'fulfillment'],
    publicidad: ['anuncios', 'ads', 'marketing', 'apps', 'movil'],
  };
  // los mismos grupos, en inglés (los proyectos se indexan en el idioma de la página)
  const SIN_EN: Record<string, string[]> = {
    multilingual: ['language', 'languages', 'multilanguage', 'translation', 'translate', 'i18n', 'localisation', 'localization', 'international', 'english', 'korean', 'japanese', 'chinese', 'portuguese', 'spanish'],
    fintech: ['finance', 'financial', 'banking', 'bank', 'banks', 'payroll', 'payments', 'payment', 'billing', 'invoicing', 'invoice', 'invoices'],
    ai: ['artificial', 'intelligence', 'agentic', 'agents', 'agent', 'llm', 'models', 'quantum'],
    migration: ['migrate', 'moving', 'unify', 'unified', 'redirects', 'redirections'],
    cms: ['content', 'collections', 'blog', 'editorial'],
    animation: ['animations', 'motion', 'movement', 'interaction', 'interactions'],
    developers: ['developer', 'api', 'programmers', 'engineers'],
    education: ['schools', 'school', 'teachers', 'students', 'edtech'],
    renewables: ['energy', 'solar', 'wind', 'sustainable', 'sustainability'],
    sales: ['b2b', 'commercial', 'saas', 'crm'],
    logistics: ['ecommerce', 'shipping', 'warehouse', 'fulfilment', 'fulfillment'],
    advertising: ['ads', 'marketing', 'apps', 'mobile'],
  };
  const SINONIMOS = t(SIN_ES, SIN_EN);
  const norma = (s: string) => s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9#+ ]/g, ' ');
  const inverso = new Map<string, string[]>();
  for (const [k, vs] of Object.entries(SINONIMOS)) { const g = [k, ...vs]; g.forEach((w) => inverso.set(w, g)); }
  const errata1 = (a: string, b: string) => { // distancia de edición ≤ 1
    if (Math.abs(a.length - b.length) > 1) return false;
    let i = 0, j = 0, d = 0;
    while (i < a.length && j < b.length) { if (a[i] === b[j]) { i++; j++; continue; } if (++d > 1) return false; if (a.length > b.length) i++; else if (b.length > a.length) j++; else { i++; j++; } }
    return d + (a.length - i) + (b.length - j) <= 1;
  };
  type Campo = { palabras: string[]; peso: number };
  // cada término: lo que se escribió (admite una errata) y sus sinónimos (solo exactos o como principio de palabra)
  const puntuar = (terminos: { orig: string; variantes: string[] }[], campos: Campo[]) => {
    let total = 0;
    for (const { orig, variantes } of terminos) {
      let mejor = 0;
      for (const c of campos) for (const w of c.palabras) for (const v of variantes) {
        const s = w === v ? 1 : w.startsWith(v) && v.length >= 3 ? 0.8 : v === orig && v.length >= 5 && errata1(w, v) ? 0.6 : 0;
        if (s * c.peso > mejor) mejor = s * c.peso;
      }
      if (!mejor) return 0; // todas las palabras tienen que aparecer (en alguna de sus formas)
      total += mejor;
    }
    return total;
  };

  const caja = document.querySelector<HTMLElement>('[data-todos]')!;
  const mentores = [...caja.querySelectorAll<HTMLElement>('[data-mentor]')];
  const cortes = (n: number) => { const c = Math.max(1, Math.min(mentores.length, Math.round(n / 11))); return Array.from({ length: c }, (_, k) => Math.round((n * (k + 1)) / c)); };
  const lista = caja.querySelector<HTMLElement>('[data-rejilla-obras]')!;
  const items = [...caja.querySelectorAll<HTMLElement>('[data-obra]')];
  const palabras = (s: string) => norma(s).split(/\s+/).filter(Boolean);
  const indice = items.map((it) => ({
    it,
    campos: [
      { palabras: palabras(it.dataset.nombre!), peso: 5 },
      { palabras: palabras(it.dataset.sector + ' ' + (it.dataset.categoria + '|' + it.dataset.servicios!).replace(/\|/g, ' ')), peso: 3 },
      { palabras: palabras(it.dataset.texto!), peso: 1 },
    ] as Campo[],
  }));
  const desps = [...caja.querySelectorAll<HTMLElement>('[data-desp]')], limpiarF = caja.querySelector<HTMLButtonElement>('[data-limpiar-f]')!;
  const ops = [...caja.querySelectorAll<HTMLButtonElement>('[data-f]')];
  const cuenta = caja.querySelector<HTMLElement>('[data-cuenta]')!, vacio = caja.querySelector<HTMLElement>('[data-vacio]')!;
  const q = new URLSearchParams(location.search);
  const F = ['pais', 'tec', 'servicio', 'categoria'] as const;
  // 27/10 · Eric: «para que nunca nunca nos quedemos vacíos, el filtrado tiene que ser independiente: si filtras algo y luego vas a otro y filtras otra cosa,
  // se quita el filtro anterior». UN filtro a la vez (cada opción tiene al menos un proyecto); de una dirección con varios, vale el primero
  const filtro: Record<(typeof F)[number], string> = { pais: '', tec: '', servicio: '', categoria: '' };
  const deUrl = F.find((k) => q.get(k));
  if (deUrl) filtro[deUrl] = q.get(deUrl)!;
  let busca = ''; // sin buscador (el motor de búsqueda se queda por si vuelve)

  let reentrar = false; // reentrar: al filtrar, las piezas vuelven a entrar como al llegar
  // el mosaico de «Más proyectos» de la home (Anteriores.astro › SITIO): columna, proporción y cuánto baja cada pieza (en pasos de 4 px); ocho sitios en
  // filas de 3 · 2 · 3 que se repiten; se reparten según el orden de lo que se ve (al filtrar, el mosaico se recompone)
  // columna · proporción · cuánto baja (pasos de 4 px) · FORMA (las verticales, en móvil; las anchas, en escritorio) · dónde asoma el navegador (x, y, ancho en %)
  // · su giro. Lo de Anteriores.astro › SITIO (ronda 202, Eric).
  type Sitio = [string, string, number, Forma, [number, number, number]?, number?];
  const SITIO: Sitio[] = [
    ['1 / span 3', '1 / 1', 0, 'navegador', [5, 17, 111], -2.5], ['5 / span 4', '1 / 1', 0, 'escena'], ['10 / span 3', '4 / 5', 32, 'tel', undefined, 4],
    ['2 / span 4', '4 / 5', 0, 'movil'], ['8 / span 4', '1 / 1', 24, 'navegador', [7, 11, 132], 0],
    ['1 / span 3', '1 / 1', 0, 'navegador', [6, 17, 118], -2.5], ['5 / span 4', '3 / 4', 0, 'tel', undefined, -4], ['10 / span 3', '4 / 5', 32, 'navegador', [9, 20, 118], 4],
  ];
  // el botoncito de escena de cada carátula: marca la que se ve y, al pulsar, la cambia (la nueva entra enfocándose)
  const marcarEscena = (it: HTMLElement) => { const f = [...(it.querySelector('[data-pieza-casa]')?.classList ?? [])].find((c) => ['navegador', 'escena', 'movil', 'tel'].includes(c));
    it.querySelectorAll<HTMLButtonElement>('[data-escena]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.escena === (f === 'tel' ? 'movil' : f)))); };
  lista.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-escena]'); if (!b || b.getAttribute('aria-pressed') === 'true') return;
    const it = b.closest<HTMLElement>('[data-obra]')!, pz = it.querySelector<HTMLElement>('[data-pieza-casa]')!;
    it.dataset.elegida = b.dataset.escena;
    formar(pz, b.dataset.escena as Forma); marcarEscena(it);
    if (quietoP.matches) return;
    pz.classList.remove('aparece'); void pz.offsetWidth; pz.classList.add('aparece');
    setTimeout(() => pz.classList.remove('aparece'), 650);
  });
  const quietoP = matchMedia('(prefers-reduced-motion: reduce)');
  let soltarT = 0, destinoP = 0; // adónde sube la página al filtrar
  const congelar = () => { if (!lista.style.minHeight) lista.style.minHeight = `${lista.offsetHeight}px`; };
  const soltar = () => { clearTimeout(soltarT); removeEventListener('scrollend', alFin); lista.style.minHeight = ''; };
  const alFin = () => { if (scrollY <= destinoP + 1) soltar(); };
  // se suelta al terminar la subida (scrollend; si el navegador no lo tiene o alguien interrumpe la subida, como mucho a los 2,5 s)
  const soltarAlLlegar = () => {
    clearTimeout(soltarT);
    if (scrollY <= destinoP + 1) { requestAnimationFrame(soltar); return; }
    addEventListener('scrollend', alFin);
    const mirar = () => { if (!lista.style.minHeight) return; if (scrollY <= destinoP + 1) soltar(); else requestAnimationFrame(mirar); };
    requestAnimationFrame(mirar);
    soltarT = window.setTimeout(soltar, 2500);
  };
  const pintar = (mover = false) => {
    const terminos = palabras(busca).map((w) => ({ orig: w, variantes: inverso.get(w) ?? [w] }));
    const pasan = indice
      .filter(({ it }) => F.every((k) => !filtro[k] || (it.dataset[k === 'servicio' ? 'servicios' : k] ?? '').split('|').includes(filtro[k])))
      .map((x, n) => ({ ...x, n, s: terminos.length ? puntuar(terminos, x.campos) : 1 }))
      .filter((x) => x.s > 0)
      .sort((a, b) => b.s - a.s || a.n - b.n);
    // 27/10 · Eric: «a mitad de página, al filtrar, a veces se ve el footer un segundo y luego sube»: con menos proyectos la página encogía bajo el scroll y el
    // navegador saltaba al final antes de la subida. Mientras sube, la rejilla CONSERVA su alto (congelar); se suelta al llegar arriba
    if (mover) congelar();
    items.forEach((it) => (it.hidden = true));
    mentores.forEach((m) => (m.hidden = true));
    // el orden, por relevancia; tras cada tramo, un mentor (el último, al final). El mosaico empieza de nuevo en cada tramo
    const cs = cortes(pasan.length), inicio: number[] = [];
    let m = 0, desde = 0;
    pasan.forEach(({ it }, i) => { inicio.push(desde); lista.append(it); if (cs[m] === i + 1) { mentores[m].hidden = false; lista.append(mentores[m++]); desde = i + 1; } });
    if (!pasan.length) { mentores[0].hidden = false; lista.append(mentores[0]); }
    mentores.slice(m || 1).forEach((x) => lista.append(x)); // los que sobran, al final y escondidos
    pasan.forEach(({ it }, i) => { it.hidden = false; const nueva = it.dataset.visto !== '1'; it.dataset.visto = '1'; it.style.setProperty('--i', String(i % 3)); const st = SITIO[(i - inicio[i]) % SITIO.length], pz = it.querySelector<HTMLElement>('[data-pieza-casa]')!;
      // 26/10 · Eric: «cada proyecto se muestra de una manera y siempre tiene que ser así» y «tu sistema estaba mejor: ahora no siempre se cumplen los
      // espacios»: el SITIO del mosaico pone tamaño y colocación (columna, proporción, cuánto baja); el PROYECTO pone su forma —solo tres: navegador,
      // mesa con la pantalla grande o mesa con el móvil— y su navegador [x, y, ancho, giro] (portfolio-orden.json › piezas), igual filtrando o en cualquier puesto
      it.style.setProperty('--col', st[0]); it.style.setProperty('--ratio', it.dataset.ratio ?? st[1]); it.style.setProperty('--baja', String(st[2]));
      const sb = SITIO[items.indexOf(it) % SITIO.length]; // respaldo para un proyecto sin pieza propia: la de su puesto sin filtros
      const propia = ((it.dataset.forma as Forma | undefined) ?? sb[3]) === 'tel' ? 'movil' : ((it.dataset.forma as Forma | undefined) ?? sb[3]);
      const forma = (it.dataset.elegida as Forma | undefined) ?? propia; // la escena que eligió el visitante con el botoncito (se mantiene al filtrar)
      const nav = it.dataset.navegador?.split(',').map(Number), m = nav ?? [...(sb[4] ?? [10, 23, 116]), sb[5] ?? 0];
      pz.style.setProperty('--mx', m[0] + '%'); pz.style.setProperty('--top', m[1] + '%'); pz.style.setProperty('--mw', m[2] + '%'); pz.style.setProperty('--giro', m[3] + 'deg');
      pz.style.setProperty('--i', String(i % 3 + 1));
      formar(pz, forma); preparar(pz); entrar(pz, reentrar && !nueva); marcarEscena(it);
    });
    ops.forEach((b) => b.setAttribute('aria-pressed', String(filtro[b.dataset.f as (typeof F)[number]] === b.dataset.v)));
    const nAct = F.filter((k) => filtro[k]).length;
    limpiarF.classList.toggle('on', !!nAct); limpiarF.inert = !nAct;
    // sin filtros, la papelera se cierra: la barrita no se queda donde estaba (el recuadro gris a la derecha de la fila, Eric 27/10)
    if (!nAct) (window as any).__miraBarra?.();
    // cada desplegable enseña lo elegido (o «Todos») y se marca cuando filtra
    desps.forEach((d) => { const k = d.dataset.desp as (typeof F)[number], v = d.querySelector<HTMLElement>('[data-desp-v]')!; v.textContent = filtro[k] || v.dataset.todos!; d.classList.toggle('activo', !!filtro[k]); });
    vacio.hidden = pasan.length > 0;
    cuenta.textContent = busca || nAct ? `${pasan.length}/${items.length}` : String(items.length);
    cuenta.setAttribute('aria-label', `${pasan.length} ${pasan.length === 1 ? t('proyecto', 'project') : t('proyectos', 'projects')}`);
    const u = new URL(location.href);
    ([['q', ''], ...F.map((k) => [k, filtro[k]] as const), ['p', '']] as const).forEach(([k, v]) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k)));
    history.replaceState(null, '', u);
    // Eric: al elegir un filtro, la página sube en suave solo hasta donde la fila de filtros se pega arriba (con su aire, `--pega`), y si aún no ha
    // llegado ahí, no se mueve (27/10: primero en móvil, luego también en escritorio; antes subía hasta arriba del todo)
    if (mover) {
      const pega = parseFloat(flota.style.getPropertyValue('--pega')) || 0;
      destinoP = Math.min(scrollY, Math.max(0, Math.round(arriba - pega)));
      scrollTo({ top: destinoP, behavior: scrollY > destinoP + 1 && !quietoP.matches ? 'smooth' : 'instant' }); soltarAlLlegar();
    }
  };
  // los desplegables: uno abierto cada vez; cada lista baja de su caja y cabe en lo que queda de pantalla por abajo
  // abrir y cerrar con transición (clases, no `hidden`: el cierre también se anima); cerrada, la lista es inerte
  const abierta = (d: HTMLElement) => d.classList.contains('abierto');
  const cerrarF = () => desps.forEach((d) => { d.classList.remove('abierto'); requestAnimationFrame(() => (window as any).__miraBarra?.()); d.querySelector<HTMLElement>('[data-desp-menu]')!.inert = true; d.querySelector('[data-desp-b]')!.setAttribute('aria-expanded', 'false'); });
  // la NUBE (Eric): si la lista sigue por abajo (o por arriba), el borde se funde en vez de cortar en seco
  const nube = (m: HTMLElement) => { m.classList.toggle('sigue-abajo', m.scrollTop + m.clientHeight < m.scrollHeight - 2); m.classList.toggle('sigue-arriba', m.scrollTop > 2); };
  desps.forEach((d) => { const m = d.querySelector<HTMLElement>('[data-desp-menu]')!; m.addEventListener('scroll', () => nube(m), { passive: true }); });
  desps.forEach((d) => {
    const b = d.querySelector<HTMLButtonElement>('[data-desp-b]')!, m = d.querySelector<HTMLElement>('[data-desp-menu]')!;
    b.addEventListener('click', () => {
      const abrir = !abierta(d);
      cerrarF();
      if (!abrir) return;
      m.style.maxHeight = `${Math.max(180, Math.min(420, innerHeight - b.getBoundingClientRect().bottom - 24))}px`;
      m.inert = false; d.classList.add('abierto'); b.setAttribute('aria-expanded', 'true');
      nube(m);
    });
  });
  ops.forEach((b) => b.addEventListener('click', () => { F.forEach((k) => (filtro[k] = '')); filtro[b.dataset.f as (typeof F)[number]] = b.dataset.v!; cerrarF(); reentrar = true; pintar(true); reentrar = false; }));
  const limpiar = () => { F.forEach((k) => (filtro[k] = '')); cerrarF(); reentrar = true; pintar(true); reentrar = false; };
  caja.querySelector('[data-limpiar]')!.addEventListener('click', limpiar);
  limpiarF.addEventListener('click', limpiar);
  limpiarF.addEventListener('transitionend', () => (window as any).__miraBarra?.()); // al terminar de abrirse o cerrarse, las celdas ya tienen su ancho
  // LA BARRITA: una píldora que se desliza hasta el filtro (o la opción) bajo el puntero y vuelve al que está abierto (o al elegido) al salir
  const mira = (caja: HTMLElement, sel: string, reposo: () => HTMLElement | null) => {
    const m = caja.querySelector<HTMLElement>(':scope > [data-mira]')!;
    const ir = (el: HTMLElement | null) => {
      if (!el) { m.classList.remove('on'); return; }
      const primera = !m.classList.contains('on');
      if (primera) m.classList.add('sin-viaje'); // la primera vez aparece en su sitio, sin venir de la izquierda
      // la posición, respecto a la caja de la barrita (los botones de la barra van dentro de su .desp, que es su offsetParent)
