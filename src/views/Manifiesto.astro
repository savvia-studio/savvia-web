---
// RONDA 126 · EL MANIFIESTO. RONDA 128: en claro, tipo clusia/about. RONDAS 129–143: en papel. RONDA 144: 3 párrafos seguidos.
// RONDA 152–153: sin papel; el roble del hero y la savia que baja por un canal hasta el texto (en tools/retirados/manifiesto-r153/).
// RONDA 155 · Andoni: «Fuera la raíz que va al texto y la letra grande tiene que ser de este estilo [capitular caligráfica]. Y no quiero usar el
// árbol del hero... Ponemos el brote y las raíces que no se vean de primeras y cuando haces scroll esas raíces te llevan al texto del manifesto.
// Hay que darle el estilo dithering de todo.» · «el brote tiene que verse mucho más pequeño y centrado. Y tiene que coincidir con el 100 % de
// visual height abajo solamente el brote. Solo se ve el brote y una vez empiezas a hacer scroll ya se ve la raíz que apunta al texto centrado.
// Te paso todas las estaciones» · «la T del texto solo tiene que afectar a la primera línea, como el ejemplo».
// · EL BROTE (una lámina por estación: tools/r155/brote-<estación>.webp → tools/r155/partir.cjs: 1000 × 1500, en espejo, sin velo, partida por el
//   cuello de la bellota): primer pantallazo = solo el brote, pequeño, centrado, con la bellota en el borde de abajo (100 lvh). Cae una gota y se
//   dibuja y se pinta con el motor del hero (estela.ts: semitono en los cantos, hervor, canto rasgado).
// · LAS RAÍCES no existen hasta que bajas: crecen con el scroll desde la bellota (crecer(g)) y su punta principal acaba en la capitular. El JS
//   encaja la lámina de las raíces entre la bellota y la capitular (alto, ancho e inclinación: skewX, con tope) → la punta llega siempre a la letra.
// · LA CAPITULAR: la T en Pinyon Script (OFL; copperplate), grande, en la PRIMERA línea: misma línea base, sobresale por arriba, el resto del
//   párrafo sin sangría. Espera apenas insinuada; cuando la raíz la alcanza, bebe (destello de savia) y se asienta en la tinta del texto.
// RONDA 296 (Eric): el texto es la analogía de la savia (entrada con la capitular + tres párrafos, sin lemas ni subrayados). «las raíces las haría
//   mucho más adaptadas al tallo, más pequeñas, más sibilinas, más reduciditas» → las raíces ya no se estiran hasta la capitular: miden 2,2 veces el
//   brote, estrechadas y rectas bajo el cuello; el texto empieza a 240 px de su punta.
// · La estación manda (html[data-estacion] / savvia:estacion): al cambiar, la lámina nueva se descubre con el canto rasgado desde la bellota.
// · Movimiento reducido o sin WebGL: todo a la vista y quieto.
import { Font } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import { manifiestoDe } from '../data/idioma';
import { langDe } from '../lib/i18n';

const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const manifiesto = manifiestoDe(lang);

const parrafos = manifiesto.capitulos.map((c) => c.parrafos.join(' ').replace(/\[\[|\]\]/g, ''));
// la primera letra de la entrada va a la capitular; el párrafo empieza en la segunda.
// ronda 297 (Eric: «esa S es muy rara»; luego, «dejamos la primera s del manifiesto como s normal»): si la entrada empieza por la marca, sin
// capitular: «savvia» va en la letra y el tamaño del texto (siempre en minúscula). `data-cap` queda en un <span> vacío (el JS le pone clases)
const capitular = !manifiesto.entrada.startsWith('savvia');
const inicial = capitular ? manifiesto.entrada.charAt(0) : '';
const entrada = capitular ? manifiesto.entrada.slice(1) : manifiesto.entrada;
// ronda 296: la cortina de savvia agentic (home): cada palabra en una pieza que no se parte, cada letra en un `.c` (entintar.ts › entintarFrases)
const palabras = (t: string) => t.split(/\s+/).filter(Boolean);
---

<Base title={en ? 'The savvia manifesto' : 'Manifiesto de savvia'} description={en ? `${manifiesto.entrada} The savvia manifesto, from the web studio of Eric and Andoni.` : `${manifiesto.entrada} El manifiesto de savvia, el estudio web de Eric y Andoni.`} carga={false}>
  <Font cssVariable="--font-capitular" preload />
  <Nav />
  <Carriles />
  <main id="contenido" class="manifiesto surface-light" data-manifiesto>
    <!-- primer pantallazo: «Manifiesto» y, debajo, el brote, con la bellota en el borde de abajo (ronda 155: «arriba del brote centrado tiene que poner manifiesto») -->
    <header class="portada">
      <h1 class="titulo font-display">{manifiesto.titulo}</h1>
      <figure class="brote" aria-hidden="true" data-brote-caja>
        <img class="respaldo" src="/media/manifiesto/brote-otono.webp" alt="" width="1000" height="310" data-brote-img />
        <canvas data-brote></canvas>
      </figure>
    </header>
    <!-- las raíces: cuelgan de la bellota; el JS las encaja hasta la capitular -->
    <figure class="raices" aria-hidden="true" data-raices-caja>
      <img class="respaldo" src="/media/manifiesto/raices-otono.webp" alt="" width="1000" height="1190" data-raices-img />
      <canvas data-raices></canvas>
    </figure>

    <section class="texto wrap" aria-label={en ? 'The manifesto' : 'El manifiesto'} data-cortina>
      <p class="parrafo primero text-pretty">
        <span class="sr">{manifiesto.entrada}</span><span class:list={[capitular && 'cap']} aria-hidden="true" data-cap>{inicial}</span>{palabras(entrada).map((w) => <><span class="w" aria-hidden="true">{[...w].map((c) => <span class="c">{c}</span>)}</span>{' '}</>)}
      </p>
      {
        parrafos.map((p) => (
          <p class="parrafo text-pretty">
            <span class="sr">{p}</span>
            {palabras(p).map((w) => <><span class="w" aria-hidden="true">{[...w].map((c) => <span class="c">{c}</span>)}</span>{' '}</>)}
          </p>
        ))
      }
      <!-- ronda 296 (Eric): fuera el cierre «Eso es savvia agentic…»; «un pelín de aire» y al final nuestra firma de correo (la de /sistema ›
           Descargas). Eric eligió «Solo los trazos» con el nombre en Family; después, la copa en UN trazo abierto (public/media/manifiesto/rubrica.svg ← tools/firma/rubrica-copa.cjs) -->
      <!-- la firma es un <p> más de la cortina: aparece, «Eric y Andoni» se entinta letra a letra y la rúbrica se dibuja a la vez (de izquierda a derecha) -->
      <p class="firma-final" data-lento="4">
        <img src="/media/manifiesto/rubrica.svg" alt="" width="160" height="104" loading="lazy" decoding="async" data-rubrica />
        <span class="sr">{manifiesto.firma}</span>
        <span class="nombre">{palabras(manifiesto.firma).map((w) => <><span class="w" aria-hidden="true">{[...w].map((c) => <span class="c">{c}</span>)}</span>{' '}</>)}</span>
      </p>
    </section>
  </main>
  <Pie />
</Base>

<style>
  .manifiesto {
    position: relative;
    overflow-x: clip;
    /* EL BROTE: discreto (≈ 19 % de la pantalla en escritorio). La lámina del brote mide 1000 × 310; el cuello de la bellota, al 46 % del ancho */
    --bh: clamp(7rem, 19lvh, 11rem);
    --bw: calc(var(--bh) * 1000 / 310);
    /* ronda 296: las raíces, a la escala del brote (2,2 veces su alto) y estrechadas (0,62 en vez de 1000/1190): finas y rectas bajo el cuello */
    --rh: calc(var(--bh) * 2.2);
    --rw: calc(var(--rh) * 0.62);
    --rl: calc(50% - var(--rw) * 0.46);
    /* de la bellota a la punta visible de la raíz */
    --dist: calc(var(--rh) * 0.937);
    /* ronda 155: «unos 160 px desde las raíces hasta el comienzo del texto» + «otros 80 px» */
    --aire: 240px;
  }
  @media (max-width: 47.99rem) {
    .manifiesto {
      --bh: clamp(6.5rem, 16lvh, 9rem);
    }
  }

  /* ── PRIMER PANTALLAZO: el brote, centrado, con la bellota justo en el borde de abajo (100 lvh) ── */
  .portada {
    position: relative;
    height: 100lvh;
  }
  .titulo {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    margin: 0;
    text-align: center;
    font-size: clamp(3.5rem, 2rem + 7vw, 8.5rem); /* ronda 155: «centrado verticalmente en el hero y más grande» */
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--fg);
  }
  .brote,
  .raices {
    position: absolute;
    margin: 0;
    pointer-events: none;
  }
  .brote {
    bottom: 0;
    left: calc(50% - var(--bw) * 0.46);
    width: var(--bw);
    height: var(--bh);
  }
  /* las raíces nacen en el cuello (100 lvh) y se inclinan desde él */
  .raices {
    top: 100lvh;
    left: var(--rl);
    width: var(--rw);
    height: var(--rh);
    z-index: 0;
  }
  .brote canvas,
  .raices canvas,
  .respaldo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .respaldo { object-fit: fill; }
  .gl .respaldo { visibility: hidden; }

  /* ── EL TEXTO: una columna centrada, con la capitular en la primera línea ── */
  .texto {
    --cuerpo: clamp(1.35rem, 1rem + 1.05vw, 1.8rem); /* ronda 296: «un poquito más grande» → «1,8rem prueba» (antes 1,25 → 1,75 rem) */
    position: relative;
    z-index: 1;
    /* ronda 155: «por debajo del texto del manifiesto hasta la línea horizontal, 240 px» (la línea es la fila de carriles del cierre) */
    padding-bottom: 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(var(--spacing) * 16);
    font-size: var(--cuerpo);
    /* la capitular sobresale ~1,6 renglones por encima del párrafo: su cima queda a --dist de la bellota */
    padding-top: calc(var(--dist) - var(--cuerpo) * 1 + var(--aire));
  }
  .parrafo {
    width: 100%;
    max-width: 30ch;
    font-size: var(--cuerpo);
    line-height: 1.45;
    letter-spacing: -0.005em;
    color: var(--fg);
    font-family: var(--font-display); /* ronda 296 (Eric): «todo en ese tamaño de letra pero letra de heading» */
  }
  .primero { margin-top: calc(var(--cuerpo) * 2.2); }
  /* LA CAPITULAR (como la referencia): mayúscula caligráfica grande en la PRIMERA línea, sobre su línea base. line-height 0: no agranda el
     renglón ni empuja el párrafo; sobresale por arriba y el travesaño cubre el comienzo de «u web» */
  .cap {
    font-family: var(--font-capitular), cursive;
    font-weight: 400;
    font-size: 4.2em;
    line-height: 0;
    letter-spacing: 0;
    margin-right: -0.02em;
    color: var(--fg);
  }
  /* ronda 155: «la T mayúscula, siempre en oscuro»: en la tinta del texto desde el principio, sin esperar a la raíz ni el destello de savia */
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* la cortina de la home (Problemas.astro): la frase sale de 0 a 1 y luego se entinta letra a letra */
  .w { white-space: nowrap; }
  :global(html.anima) .texto .c { opacity: 0.2; }
  :global(html.anima) .texto :is(.parrafo, .firma-final) { opacity: 0; transition: opacity 0.35s ease-out; will-change: opacity; }
  @media (prefers-reduced-motion: reduce) {
    .texto .c { opacity: 1 !important; }
    :global(html.anima) .texto :is(.parrafo, .firma-final) { opacity: 1; transition: none; }
  }
  @media (max-width: 47.99rem) {
    .texto { gap: calc(var(--spacing) * 12); }
  }

  /* ── LA FIRMA: la de correo, centrada en la columna (ronda 296: «esa firma que esté centrada mejor») ── */
  .firma-final {
    width: 100%;
    max-width: 30ch;
    font-family: var(--font-display); /* el «ch» de la columna es el de Family (el de los párrafos) */
    margin-top: calc(var(--spacing) * 16); /* + el hueco de la columna (64): 128 px tras el último párrafo */
  }
  .firma-final { text-align: center; }
  .firma-final img {
    display: block;
    margin-inline: auto;
    width: 80px; /* la rúbrica del correo a su tamaño (75 px), con el margen del viewBox */
    height: auto;
  }
  /* la rúbrica se dibuja con una máscara que avanza de izquierda a derecha (--d, de 0 a 1, lo lleva la cortina) */
  :global(html.anima) .firma-final img {
    --borde: calc(var(--d, 0) * 130% - 30%);
    -webkit-mask-image: linear-gradient(90deg, #000 var(--borde), transparent calc(var(--borde) + 30%));
    mask-image: linear-gradient(90deg, #000 var(--borde), transparent calc(var(--borde) + 30%));
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.anima) .firma-final img { -webkit-mask-image: none; mask-image: none; }
  }
  .firma-final .nombre {
    display: block;
    margin-top: calc(var(--spacing) * 3);
    font-size: 1.5rem; /* en Family, la de los párrafos («Eric y Andoni con letra de heading») */
    line-height: 1.2;
    color: var(--fg);
  }
</style>

<script>
  import { crearEstela, type Estela } from '../scripts/estela';
  import { EST, estacionActual } from '../scripts/estacion';
  import { rgbDe } from '../scripts/tinta';
  import { entintarFrases } from '../scripts/entintar';

  const main = document.querySelector<HTMLElement>('[data-manifiesto]')!;
  // la rúbrica: se dibuja mientras se entinta «Eric y Andoni» (el último <p> de la cortina)
  const rubrica = main.querySelector<HTMLElement>('[data-rubrica]')!;
  let dRub = -1;
  entintarFrases(main.querySelector<HTMLElement>('[data-cortina]')!, (av) => {
    const d = Math.round(av[av.length - 1] * 1000) / 1000;
    if (d !== dRub) { dRub = d; rubrica.style.setProperty('--d', String(d)); }
  });
  const cajaBrote = main.querySelector<HTMLElement>('[data-brote-caja]')!;
  const cajaRaices = main.querySelector<HTMLElement>('[data-raices-caja]')!;
  const imgBrote = main.querySelector<HTMLImageElement>('[data-brote-img]')!;
  const imgRaices = main.querySelector<HTMLImageElement>('[data-raices-img]')!;
  let cvBrote = main.querySelector<HTMLCanvasElement>('[data-brote]')!;
  let cvRaices = main.querySelector<HTMLCanvasElement>('[data-raices]')!;
  const cap = main.querySelector<HTMLElement>('[data-cap]')!;
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const RASGO = "url('/media/rasgo-circulo.png')";

  // en la lámina en espejo: el cuello de la bellota, x 0,46; la punta VISIBLE de la raíz principal (lo último se deshace en puntos), en la mitad
  // de abajo: (0,37 · 0,937). En la capitular (Pinyon Script, por em): el travesaño de la T arranca en x 0,33 y su cima queda 0,12 bajo la del
  // cuadro del texto (ascendente 0,86 − tinta 0,74)
  const BX = 0.46, PX = 0.37, PY = 0.937;
  const fondo = () => rgbDe('niebla', main);
  const cargar = (src: string) => { const i = new Image(); i.src = src; return i; };
  // WebKit sube a veces la <img> webp con alfa como «bad image data» (textura incompleta: un recuadro negro con el semitono). La lámina ya
  // descodificada se pasa al motor copiada en un lienzo 2D, que WebKit sube sin fallos; el motor solo mira complete/naturalWidth y la sube con texImage2D
  const lienzoDe = (i: HTMLImageElement) => {
    const c = document.createElement('canvas');
    c.width = i.naturalWidth || 1; c.height = i.naturalHeight || 1;
    c.getContext('2d')!.drawImage(i, 0, 0);
    return Object.assign(c, { complete: true, naturalWidth: c.width }) as unknown as HTMLImageElement;
  };
  // WebGL 1 a propósito: con WebGL 2 el motor usa mipmaps y, en los destellos del hervor (una lectura dentro de una rama del shader), el nivel de
  // mip queda indefinido: lee la lámina entera promediada y pinta filas de puntos de lado a lado sobre el claro. Sin mipmaps no pasa (la lámina se
  // amplía, no se reduce). Si el lienzo ya tiene un contexto «webgl», crearEstela no puede abrir uno «webgl2» y usa este (mismos atributos).
  const gl1 = (cv: HTMLCanvasElement) => cv.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
  const OPC_BROTE = (gota: boolean) => ({ origen: [BX, 1] as [number, number], dir: -1 as const, soplo: true, gota, manual: gota, sinLuz: true, hd: true, intensidad: 0 });
  const OPC_RAICES = { origen: [BX, 0] as [number, number], dir: 1 as const, soplo: true, sinLuz: true, intensidad: 0 };
  const soltarLienzo = (c: HTMLCanvasElement) => {
    const g = c.getContext('webgl2') || c.getContext('webgl');
    if (g && !g.isContextLost()) g.getExtension('WEBGL_lose_context')?.loseContext();
    c.remove();
  };
  // el canto de papel de acuarela (el del hero al cambiar de estación) que se abre desde (ox, oy)
  const pon = (el: HTMLElement, m: string) => { el.style.setProperty('-webkit-mask', m); el.style.setProperty('mask', m); };
  const revelar = (el: HTMLElement, ox: number, oy: number, dur: number, fin: () => void, viejo: HTMLElement) => {
    let a = 0;
    const paso = (ahora: number) => {
      if (!a) a = ahora;
      const k = Math.min(1, (ahora - a) / dur), e = k * k * (3 - 2 * k), w = el.offsetWidth, h = el.offsetHeight;
      const S = Math.max(8, Math.hypot(w, h) * 2.4 * e);
      pon(el, `${RASGO} ${(ox * w - S / 2).toFixed(1)}px ${(oy * h - S / 2).toFixed(1)}px / ${S.toFixed(1)}px ${S.toFixed(1)}px no-repeat`);
      viejo.style.opacity = String(1 - Math.min(1, Math.max(0, (k - 0.15) / 0.75)));
      if (k < 1) requestAnimationFrame(paso);
      else { pon(el, ''); fin(); }
    };
    pon(el, `${RASGO} 0 0 / 0 0 no-repeat`);
    requestAnimationFrame(paso);
  };

  let est = estacionActual();
  imgBrote.src = `/media/manifiesto/brote-${EST[est]}.webp`;
  imgRaices.src = `/media/manifiesto/raices-${EST[est]}.webp`;
  gl1(cvBrote); gl1(cvRaices);
  const laminaBrote = cargar(imgBrote.src), laminaRaices = cargar(imgRaices.src);
  let brote: Estela | null = null, raices: Estela | null = null;

  // el frente del motor (hacia abajo): gr·1,4 − 0,1 = 0,85·dy + 0,35·|dx|. El g que lleva el frente central hasta dy (en 0 no asoma nada):
  const gDe = (dy: number) => (dy <= 0.03 ? 0 : (0.85 * dy + 0.14 * Math.min(1, (dy - 0.03) / 0.06)) / 1.4);
  const G_PUNTA = (0.85 * PY + 0.35 * Math.abs(PX - BX) + 0.12) / 1.4;
  const LINEA = 0.6; // la raíz alcanza la capitular cuando esta llega aquí (fracción de la pantalla)

  // ── las raíces (a escala del brote, por CSS): se mide su caja y su crecimiento se ata al scroll ──
  let top = 0, alto = 1, g = -1, pend = 0, vivo = true;
  const actualizar = () => {
    pend = 0;
    // en 0 el frente está en la bellota; llega a la punta cuando la capitular está a LINEA de la pantalla
    const S = Math.max(1, top + PY * alto - innerHeight * LINEA);
    const k = reducido || !raices ? 1 : Math.min(1, gDe((scrollY / S) * PY));
    if (Math.abs(k - g) < 0.0008) return;
    g = k;
    raices?.crecer(k);
    const bebe = k >= G_PUNTA;
    if (bebe !== cap.classList.contains('bebe')) {
      cap.classList.toggle('bebe', bebe);
      if (bebe && !reducido) { cap.classList.add('bebiendo'); setTimeout(() => cap.classList.remove('bebiendo'), 900); }
    }
  };
  const encajar = () => {
    const r = cajaRaices.getBoundingClientRect();
    top = r.top + scrollY; alto = r.height;
    g = -1; actualizar();
  };
  const pedir = () => { if (!pend) pend = requestAnimationFrame(actualizar); };

  let vivoR = true;
  // el motor arranca con las láminas YA descodificadas: WebKit subía a la GPU una lámina a medio descodificar (textura incompleta = un recuadro
  // negro con el semitono) en las estaciones que no eran la del respaldo
  const arrancar = () => {
  brote = crearEstela(cvBrote, lienzoDe(laminaBrote), OPC_BROTE(true));
  raices = brote ? crearEstela(cvRaices, lienzoDe(laminaRaices), OPC_RAICES) : null;
  if (brote && raices) {
    document.documentElement.classList.add('semilla-js');
    cajaBrote.classList.add('gl'); cajaRaices.classList.add('gl');
    brote.fondo(...fondo()); raices.fondo(...fondo());
    // el brote: su gota cae en cuanto la lámina está lista
    setTimeout(() => brote?.soltar(), reducido ? 0 : 450);
    // fuera de la pantalla, no se pintan
    new IntersectionObserver(([x]) => { vivo = x.isIntersecting; brote?.visible(vivo); }, { rootMargin: '10% 0px' }).observe(cajaBrote);
    new IntersectionObserver(([x]) => { vivoR = x.isIntersecting; raices?.visible(vivoR); }, { rootMargin: '10% 0px' }).observe(cajaRaices);

    // ── CAMBIO DE ESTACIÓN: la lámina nueva viene pintada y se descubre con el canto rasgado desde la bellota; las raíces, 0,6 s después ──
    let pedida = -1;
    addEventListener('savvia:estacion', (ev) => {
      const n = (ev as CustomEvent).detail.n as number;
      if (n === est) return;
      est = n; pedida = n;
      const nb = cargar(`/media/manifiesto/brote-${EST[n]}.webp`), nr = cargar(`/media/manifiesto/raices-${EST[n]}.webp`);
      Promise.all([nb.decode(), nr.decode()]).catch(() => null).then(() => {
        if (pedida !== n) return;
        imgBrote.src = nb.src; imgRaices.src = nr.src;
        const b2 = cvBrote.cloneNode(false) as HTMLCanvasElement, r2 = cvRaices.cloneNode(false) as HTMLCanvasElement;
        cvBrote.after(b2); cvRaices.after(r2);
        gl1(b2); gl1(r2);
        const tb = crearEstela(b2, lienzoDe(nb), OPC_BROTE(false)), tr = crearEstela(r2, lienzoDe(nr), OPC_RAICES);
        if (!tb || !tr) { b2.remove(); r2.remove(); return; }
        tb.fondo(...fondo()); tr.fondo(...fondo());
        tb.crecer(1); tr.crecer(Math.max(0, g));
        tb.visible(vivo); tr.visible(vivoR);
        const vb = cvBrote, vr = cvRaices;
        cvBrote = b2; cvRaices = r2; brote = tb; raices = tr;
        if (reducido) { soltarLienzo(vb); soltarLienzo(vr); return; }
        revelar(b2, BX, 1, 2400, () => soltarLienzo(vb), vb);
        setTimeout(() => revelar(r2, BX, 0, 2200, () => soltarLienzo(vr), vr), 600);
      });
    });
  }
  g = -1; actualizar();
  };
  Promise.all([laminaBrote.decode(), laminaRaices.decode()]).catch(() => null).then(arrancar);
  addEventListener('scroll', pedir, { passive: true });
  addEventListener('resize', encajar);
  new ResizeObserver(encajar).observe(main);
  document.fonts?.ready.then(encajar);
  encajar();

  (window as any).__manifiesto = () => {
    const r = cap.getBoundingClientRect(), F = parseFloat(getComputedStyle(cap).fontSize);
    return { g, gPunta: G_PUNTA, bebe: cap.classList.contains('bebe'), est: EST[est], punta: { x: r.left + F * 0.33, y: r.top + scrollY + F * 0.12 }, brote: cajaBrote.getBoundingClientRect().toJSON(), raices: cajaRaices.getBoundingClientRect().toJSON() };
  };
</script>
