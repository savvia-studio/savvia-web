---
// 29/10 · LAS PÁGINAS LEGALES (aviso legal, privacidad, cookies). Eric: «el formato tiene que ser como el de neety, editorial» → (2.ª) «estas líneas
// fuera; las columnas no has respetado como en neety o en storybook: esas son tus referencias» · «los números fuera». La estructura del storybook
// (sistema/Libro.astro › .marco-libro) y del caso (Caso.astro › .dos-col): dos columnas 3 · 9 sin hueco; el índice, pegado arriba a la altura de la
// ventana; el contenido, con la línea a su izquierda; los dos arrancan a 160 px. Sin `main > section`: los carriles no dibujan filas, solo los bordes.
// Textos en src/data/legal.ts.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import { legalDe, linea, LEGAL_KEYS, LEGAL_RUTA, VERSION, type Bloque, type LegalKey } from '../data/legal';
import { langDe, ruta } from '../lib/i18n';

interface Props { doc: LegalKey }
const { doc } = Astro.props;
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const d = legalDe(lang, doc);
const secciones = d.bloques.flatMap((b) => (b.k === 'h2' ? [{ id: b.id, t: b.t }] : []));
// la entrada (lo de antes del primer titular) va bajo el titular; cada titular abre una sección con sus bloques
const entrada = d.bloques.flatMap((b) => (b.k === 'lead' ? [b.t] : []));
const grupos: { id: string; t: string; bloques: Bloque[] }[] = [];
for (const b of d.bloques) {
  if (b.k === 'h2') grupos.push({ id: b.id, t: b.t, bloques: [] });
  else if (b.k !== 'lead' && grupos.length) grupos[grupos.length - 1].bloques.push(b);
}
const [y, m] = VERSION.split('-').map(Number);
const fecha = new Intl.DateTimeFormat(en ? 'en-GB' : 'es-ES', { month: 'long', year: 'numeric' }).format(new Date(Date.UTC(y, m - 1, 1)));

---

<Base title={`${d.titulo} · savvia`} description={d.descripcion} carga={false}>
  <Nav />
  <Carriles />
  <main id="contenido" class="legal surface-light">
    <div class="wrap marco">
      <nav class="indice" aria-label={en ? 'Contents' : 'Índice'} data-indice>
        <p class="detail detail-caps rotulo">{en ? 'Contents' : 'Índice'}</p>
        <ol>{secciones.map((s, i) => <li><a href={`#${s.id}`} aria-current={i === 0 ? 'true' : undefined}>{s.t}</a></li>)}</ol>
      </nav>

      <article class="hojas">
        <header class="portada">
          <h1 class="font-display titular">{d.titulo}</h1>
          {entrada.map((t) => <p class="text-sub entrada" set:html={linea(t)} />)}
          <p class="detail rotulo">{en ? `Version of ${fecha}` : `Versión de ${fecha}`}</p>
          {en && <p class="text-aux rotulo">In the event of any discrepancy, the Spanish version prevails.</p>}
        </header>
        {grupos.map((g) => (
          <section id={g.id} class="seccion" aria-labelledby={`h-${g.id}`}>
            <h2 id={`h-${g.id}`}>{g.t}</h2>
            <div class="cuerpo">
              {g.bloques.map((b) => {
                if (b.k === 'p') return <p set:html={linea(b.t)} />;
                if (b.k === 'ul') return b.items.map((t) => <p set:html={linea(t)} />);
                if (b.k === 'datos') return <dl class="datos">{b.filas.map(([k, v]) => <div><dt class="detail">{k}</dt><dd set:html={linea(v)} /></div>)}</dl>;
                if (b.k === 'tabla') return <dl class="filas">{b.filas.map(([que, para, dura]) => <div><dt>{que}</dt><dd>{para}.</dd><dd class="detail dura">{dura}</dd></div>)}</dl>;
              })}
            </div>
          </section>
        ))}
      </article>
    </div>
  </main>
  <Pie />
</Base>

<script>
  // la sección activa del índice: la última cuyo titular ya pasó la línea de lectura (160 px), que baja hasta el pie de la ventana al agotarse el
  // scroll (si no, las secciones cortas del final no se encenderían nunca). Lo mismo que el índice de Neety.
  const indice = document.querySelector<HTMLElement>('[data-indice]');
  if (indice) {
    const enlaces = [...indice.querySelectorAll<HTMLAnchorElement>('a')];
    const titulos = enlaces.map((a) => document.getElementById(a.hash.slice(1))).filter((h): h is HTMLElement => !!h);
    let raf = 0;
    const medir = () => {
      raf = 0;
      const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      const lineaLectura = 160 + Math.min(1, Math.max(0, scrollY / max)) * (innerHeight - 160);
      let activo = 0;
      titulos.forEach((h, i) => { if (h.getBoundingClientRect().top < lineaLectura) activo = i; });
      enlaces.forEach((a, i) => (i === activo ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    const pedir = () => { if (!raf) raf = requestAnimationFrame(medir); };
    medir();
    addEventListener('scroll', pedir, { passive: true });
    addEventListener('resize', pedir);
  }
</script>

<style>
  /* la estructura del storybook (Libro.astro › .marco-libro), con sus mismas medidas */
  .legal { padding-top: calc(var(--spacing) * 32); }
  .marco { display: flex; flex-direction: column; gap: calc(var(--spacing) * 12); }
  @media (width >= 64rem) {
    .legal { padding-top: 0; }
    .marco { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: start; gap: 0; }
    .indice { position: sticky; top: 0; height: 100dvh; padding: calc(var(--spacing) * 40) calc(var(--spacing) * 8) calc(var(--spacing) * 6) 0; overflow-y: auto; scrollbar-width: none; }
    .hojas { position: relative; padding: calc(var(--spacing) * 40) calc(var(--spacing) * 8) var(--space-section); }
    /* la línea de la columna, como la del caso, la del storybook y los carriles: niebla al 14 % por diferencia, hasta el pie */
    .hojas::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 1px; z-index: 40; pointer-events: none; background: color-mix(in srgb, var(--color-niebla) 14%, transparent); mix-blend-mode: difference; }
  }
  @media (width < 64rem) {
    .hojas { order: -1; padding-bottom: var(--space-section); }
    .indice { display: none; } /* como en el storybook: en móvil no hay índice */
  }

  .rotulo { color: var(--fg2); }
  .indice { display: flex; flex-direction: column; gap: calc(var(--spacing) * 3); }
  .indice ol { display: flex; flex-direction: column; gap: calc(var(--spacing) * 1); }
  .indice a { display: block; padding-block: calc(var(--spacing) * 1); font-size: var(--text-ui); color: var(--fg2); transition: color 0.3s ease; }
  .indice a:hover, .indice a[aria-current] { color: var(--fg); }

  /* la portada, en la columna del texto, como la del storybook */
  .portada { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--spacing) * 6); }
  .titular { font-size: clamp(2.5rem, 1rem + 4vw, 5rem); line-height: 1.02; letter-spacing: -0.02em; text-wrap: balance; }
  .entrada { max-width: 64ch; color: var(--fg2); }

  /* cada sección, como las del storybook (Libro.astro › .seccion): el título pequeño (sans 18, 500) en las columnas 1–6 y el texto desde la 7 */
  .seccion { margin-top: calc(var(--spacing) * 24); scroll-margin-top: calc(var(--spacing) * 20); }
  .seccion > h2 { font-family: var(--font-sans); font-size: 1.125rem; font-weight: 500; line-height: 1.3; letter-spacing: 0; }
  .cuerpo { display: flex; flex-direction: column; gap: calc(var(--spacing) * 4); margin-top: calc(var(--spacing) * 4); font-size: 1rem; line-height: 1.6; color: var(--fg2); }
  .cuerpo :global(strong) { font-weight: 600; color: var(--fg); } /* abre su párrafo, como los valores del storybook */
  @media (width >= 48rem) {
    .seccion { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: calc(var(--spacing) * 6); align-items: baseline; }
    .seccion > h2 { grid-column: 1 / span 6; }
    .cuerpo { grid-column: 7 / -1; margin-top: 0; }
  }
  .datos, .filas { display: flex; flex-direction: column; border-top: 1px solid var(--rule); }
  .datos div { display: grid; grid-template-columns: 6rem 1fr; gap: calc(var(--spacing) * 4); padding-block: calc(var(--spacing) * 3); border-bottom: 1px solid var(--rule); }
  .datos dt { padding-top: 0.25em; }
  .datos dd { color: var(--fg); }
  .filas div { display: flex; flex-direction: column; gap: calc(var(--spacing) * 1); padding-block: calc(var(--spacing) * 4); border-bottom: 1px solid var(--rule); }
  .filas dt { font-weight: 600; color: var(--fg); }
  .dura { margin-top: calc(var(--spacing) * 1); }
</style>
