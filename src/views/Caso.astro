  :is(.f-par, .f-par75, .f-par57, .f-trio) .hueco { aspect-ratio: 1 / 1; }
  :is(.f-par, .f-par75, .f-par57, .f-trio) .con-placa .hueco { aspect-ratio: 4 / 3; }
