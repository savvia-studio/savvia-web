        <span class="pt">{sig.nombre}</span>
      </a>
    </nav></div>
  </main>
  <Pie />
</Base>

<script>
  // lo que se anima al llegar (paleta, muestras, escala, espaciado, piezas del mosaico): una vez, cuando asoma un 25 %
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('[data-vivo]').forEach((el) => io.observe(el));
</script>

