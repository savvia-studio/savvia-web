    .f-par .tesela .hueco { aspect-ratio: 5 / 4; }
    .f-par75 > .tesela:nth-child(1) .hueco, .f-par57 > .tesela:nth-child(2) .hueco { aspect-ratio: 4 / 3; }
    .f-par75 > .tesela:nth-child(2) .hueco, .f-par57 > .tesela:nth-child(1) .hueco { aspect-ratio: auto; height: 100%; }
    .f-trio .tesela .hueco { aspect-ratio: 1 / 1; }
