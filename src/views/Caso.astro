<Base title={p.titulo ?? (en ? `${p.nombre}, a savvia project` : `${p.nombre}, un proyecto de savvia`)} description={p.resumen} carga={false}>
  <script is:inline>document.documentElement.classList.add('pz-js');</script>
  <Nav />
  <Carriles />
  <main id="contenido" class="caso surface-light" style={`--claro-marca:${claroMarca}`}>
    <div class="wrap dos-col">
    <aside class="lado" aria-label={en ? 'About the project' : 'Sobre el proyecto'}>
      <div class="lado-pega">
        <!-- 28/10 · Eric: «Proyectos, quitamos de aquí; ya se nos ocurrirá algo». La cabecera se queda vacía: guarda el alto y la línea de debajo -->
        <div class="lado-cab"></div>
        <div class="lado-info">
          <h1 class="font-display nombre" data-entra>{p.nombre}</h1>
          {p.titular && <p class="font-display lado-titular">{p.titular}</p>}
          <!-- Eric (oct.): aquí, lo que hicimos para el cliente (si falta, la entradilla); debajo, la ficha del cliente -->
          <p class="lado-desc">{p.hicimos ?? p.entradilla}</p>
          <dl class="lado-ficha">{fichaLado.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          {p.url && <a class="ir-web" href={p.url} target="_blank" rel="noopener">{p.dominio ?? (en ? 'Visit the site' : 'Ver la web')}</a>}
        </div>
        <!-- RONDA 307, 22.ª · abajo, solo anterior y siguiente, con el nombre del proyecto y la flecha de la casa -->
        {masCasos && todos.length > 1 && <nav class="ant-sig" aria-label={en ? 'More case studies' : 'Más casos de estudio'}>
          <a href={ruta(lang, `/proyectos/${antP.slug}`)} rel="prev"><span class="ojo">{en ? 'Previous' : 'Anterior'}</span><span class="n"><Fragment set:html={flecha('izq')} />{antP.nombre}</span></a>
          <a href={ruta(lang, `/proyectos/${sigP.slug}`)} rel="next"><span class="ojo">{en ? 'Next' : 'Siguiente'}</span><span class="n">{sigP.nombre}<Fragment set:html={flecha()} /></span></a>
        </nav>}
      </div>
    </aside>

    <div class="contenido">
    <div class="barra-caso">
      <i class="desvanece" aria-hidden="true"></i>
    </div>
    <!-- RONDA 154 · LA CARÁTULA: la pieza del portfolio (su degradado y su web saliendo desde abajo), a lo grande -->
    <!-- 28/10 · Eric: «de primeras, el mockup de la mesa, como el del slider de proyectos»: la web de escritorio va en el MONITOR de la lámina del estudio
         (la de la estación de la web), como en el visor (obra/Visor.astro); las webs móviles siguen en su teléfono sobre el degradado -->
    <div class="wrap portada">
      {
        p.portada.movil ? (
          <Pieza p={p} tipo="telefono" grande transicion />
        ) : (
          <div class="portada-mesa" data-portada-mesa data-escena="mesa">
            <div class="pm-mesa pm-e" style={`--z:${ZP};--px:${PANT.x + PANT.w / 2};--py:${PANT.y + PANT.h / 2}`}>
              <img class="pm-foto" data-mesa alt="" width="5120" height="2880" decoding="async" fetchpriority="high" />
              <span class="pm-pant">
                <video muted loop playsinline preload="none" poster={webpCartel(portadaVid.poster)} data-src={portadaVid.src} aria-label={en ? `${p.nombre}'s website` : `La web de ${p.nombre}`} />
              </span>
            </div>
            {MM && p.cubiertaMovil && (
              <>
                <div class="pm-mesa pm-m" style={`--px:${MM.cx};--py:${MM.cy}`} data-pm-quad>
                  <img class="pm-foto" data-mesa-m alt="" width="1672" height="941" decoding="async" />
                  <span class="pm-quad" style={`--mascara:url(${MM.mascara});--cristal:url(${MM.cristal});--vx:${MM.video[0]}%;--vy:${MM.video[1]}%;--vw:${MM.video[2]}%;--vh:${MM.video[3]}%;left:${MM.caja.left.toFixed(3)}%;top:${MM.caja.top.toFixed(3)}%;width:${MM.caja.width.toFixed(3)}%;height:${MM.caja.height.toFixed(3)}%;transform:${MM.matriz}`}>
                    <video muted loop playsinline preload="none" poster={webpCartel(p.cubiertaMovil.poster)} data-src={p.cubiertaMovil.src} aria-label={en ? `${p.nombre}'s website on a phone` : `La web de ${p.nombre} en el móvil`} />
                  </span>
                </div>
                <div class="escenas" role="group" aria-label={en ? `View ${p.nombre} on` : `Ver ${p.nombre} en`}>
                  <button type="button" data-escena-b="mesa" aria-pressed="true" aria-label={en ? 'Desk' : 'Mesa'} title={en ? 'Desk' : 'Mesa'}><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.6" /><path d="M12 16v4M8 20h8" /></svg></button>
                  <button type="button" data-escena-b="movil" aria-pressed="false" aria-label={en ? 'Phone' : 'Móvil'} title={en ? 'Phone' : 'Móvil'}><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2.2" /><path d="M11 18h2" /></svg></button>
                </div>
              </>
            )}
          </div>
        )
      }
      <!-- la lámina de la estación de la web, antes de que se pida ninguna -->
      <script is:inline set:html={`(function(){var s=document.currentScript.parentNode.querySelector('[data-mesa]');if(!s)return;var b='/media/estudio/'+(document.documentElement.dataset.estacion||'otono');s.sizes='(width >= 64rem) ${ZP * 65}vw, ${ZP * 92}vw';s.srcset=b+'-m.webp 1600w, '+b+'.webp 2560w'+(innerWidth<768?'':', '+b+'-xl.webp 5120w');})();`} />
    </div>

    {
      p.contexto.length > 0 && (
        <section class="wrap rej par bloque" aria-labelledby="ctx-h">
          <h2 id="ctx-h" class="t-enc enc">{en ? 'The project' : 'El proyecto'}</h2>
          <!-- 28/10 · si el contexto cuenta una historia (más de dos párrafos), se lee en una columna, en orden -->
          <div class={`c23 ${p.contexto.length > 2 ? 'pila medida' : 'dos'}`}>{p.contexto.map((t) => <p class="t-texto">{t}</p>)}</div>
        </section>
      )
    }

    {p.reto && (
    <section class="wrap rej par bloque" aria-labelledby="reto-h">
      <h2 id="reto-h" class="t-enc enc">{en ? 'The challenge' : 'El reto'}</h2>
      <p class="t-lead c23 medida">{p.reto}</p>
    </section>
    )}

    <!-- 28/10 · LO QUE GANÓ EL CLIENTE (Eric: «lo importante es mostrar el trabajo realizado y el valor que aportamos al cliente»): cada punto, su nombre y su prueba.
         Referencia de limpieza: wearecollins.com/case-studies/robinhood (nombre a un lado, texto al otro, sin filetes) -->
    {
      p.valor && p.valor.length > 0 && (
        <section class="wrap rej par bloque" aria-labelledby="valor-h">
          <h2 id="valor-h" class="t-enc enc">{en ? `What ${p.nombre} gained` : `Lo que ganó ${p.nombre}`}</h2>
          <ul class="c23 valor">
            {p.valor.map((v) => (
              <li data-enfoca>
                <h3 class="t-h">{v.n}</h3>
                <p class="t-texto">{v.d}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* 28/10 · con la cita del cliente y su retrato, el testimonio ilustrado, ENTRE MEDIAS (Eric: «más arriba»): tras lo que ganó el cliente; sin cita, el marcador va al final */}
    {p.cita?.retrato && (
    <section class="wrap bloque testimonio-final" aria-label={en ? 'What the client says' : 'Lo que dice el cliente'}>
      <Voces dato={{ n: p.cita.autor, r: p.cita.rol, retrato: p.cita.retrato, q: p.cita.texto }} cel={2.4} escala={1.2} />
    </section>
    )}

    <!-- 28/10 · DEL FIGMA A LA WEB (Eric: «el Figma también es nuestro, todo hecho y documentado»): capturas de su archivo, en el orden en que se trabajó.
         Va JUSTO DESPUÉS DE LA RESEÑA (Eric, 28/10: «después de la reseña, primero Del Figma a la web») y sin el sitemap: empieza por el esqueleto y los conceptos.
         Una imagen por bloque sobre su tarjeta (referencia de limpieza: wearecollins.com) -->
    {
      figA.length > 0 && (
        <section class="bloque figma" aria-labelledby="figma-h">
          <div class="wrap det-cab">
            <h2 id="figma-h" class="t-enc">{en ? 'From Figma to the site' : 'Del Figma a la web'}</h2>
          </div>
          <div class="wrap fg-lista">
            {figA.map((g) => (
              <figure class={`fg fg-${g.f}`} data-vivo>
                <div class="fg-imgs" style={`--color:${p.colores[0]};--c2:${p.colores[1]};--c3:${p.colores[2]}`}>
                  {g.img.map((src) => <img src={src} alt={en ? `${g.titulo}, in ${p.nombre}’s Figma file` : `${g.titulo}, en el Figma de ${p.nombre}`} loading="lazy" decoding="async" />)}
                </div>
                <figcaption class="t-ojo pie"><span><span class="fuerte">{g.titulo}.</span> {g.pie}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- 28/10 · Eric: «color y tipografía habrá que subirlo»: van justo tras «Del Figma a la web» (la librería ya los enseña en Figma) -->
    <!-- OCTUBRE 2026 · EL SISTEMA, a la manera de brand.dropbox.com (Andoni): el COLOR como tarjetas apiladas que suben al pasar (brand.dropbox.com/color),
         la TIPOGRAFÍA en tarjetas de su paleta con sus rótulos en píldora (…/typography), el MOVIMIENTO en una línea de tiempo que recorre su grabación
         (…/motion) y la ICONOGRAFÍA en una rejilla, si el proyecto la tiene (…/iconography) -->
    {
      p.paleta && (
        <section class="wrap bloque sis-bloque" aria-labelledby="color-h">
          <div class="sis-cab">
            <h2 id="color-h" class="t-enc">{en ? 'Colour' : 'Color'}</h2>
            <p class="t-texto text-fg2 sis-entra">{en ? `The palette of ${p.nombre}, by how much it is used on the delivered site.` : `La paleta de ${p.nombre}, por lo que se usa en la web entregada.`} <span class="solo-puntero">{en ? 'Hover over a colour.' : 'Pasa por encima de cada color.'}</span></p>
          </div>
          <!-- la PALETA de brand.dropbox.com/color, medida en su página: cada color es un panel de cuatro columnas que pisa al anterior y deja ver una;
               al pasar, el panel bajo el puntero SUBE la mitad de su alto y se ladea (−0,03° por cada 1 % que sube), los de su izquierda suben menos
               cuanto más lejos (campana ancha) y los de su derecha casi nada (campana estrecha); sigue al puntero sin saltos (0,4 s,
               cubic-bezier(.15,.5,.05,1)); el nombre y el valor, solo en el que está arriba -->
          <div class="tonos" data-tonos style={`--n:${usados.length}`} role="list" aria-label={usados.map((c) => `${c.n} ${c.hex}`).join(', ')}>
            {usados.map((c, i) => (
              <div class={`tono ${luz(c.hex) ? 'sobre-claro' : 'sobre-oscuro'}`} role="listitem" tabindex="0" style={`--c:${c.hex};--i:${i}`} data-tono>
                <div class="tono-info">
                  <span class="tn">{c.n}</span>
                  <span class="tv">{c.hex}{c.pct !== undefined && <span class="tv-p">{c.pct < 1 ? '< 1' : coma(c.pct)} %</span>}</span>
                </div>
              </div>
            ))}
          </div>
          <p class="t-ojo nota">{en ? 'Usage measured on recordings of the delivered site: every pixel counts towards the nearest colour; photos and gradients aside.' : 'Uso medido en las grabaciones de la web entregada: cada píxel cuenta para el color más cercano; fotos y degradados aparte.'}</p>
        </section>
      )
    }
    {
      p.tipos && (
        <section class="wrap bloque sis-bloque" aria-labelledby="tipo-h">
          <div class="sis-cab">
            <h2 id="tipo-h" class="t-enc">{en ? 'Typography' : 'Tipografía'}</h2>
            {p.medido && <p class="t-texto text-fg2 sis-entra">{p.medido}.{tipoVivo && (en ? ' Headings shown scaled down.' : ' Los titulares, a escala reducida.')}</p>}
          </div>
          {tipoVivo ? (
            <>
              <div class="tf-fams" data-vivo>
                {familiasVivas.map((f) => (
                  <figure class="tf-fam">
                    <span class="tf-aa" style={`font-family:${f.css};font-weight:${f.peso}`}>Aa</span>
                    <figcaption><b>{f.n}</b><span class="t-ojo">{f.uso}</span></figcaption>
                  </figure>
                ))}
              </div>
              <ol class="tf-escala">
                {(p.escala ?? []).map((e) => (
                  <li>
                    <span class="t-ojo tf-n">{NESC_V[e.n] ?? e.n}</span>
                    <span class="tf-m" data-corta={fraseEsc(e.n).length <= 24 ? '' : undefined} style={`--ch:${fraseEsc(e.n).length};font-family:${FUENTE[e.fam]};--fs:${tamEsc(e.px)}px;font-size:${tamEsc(e.px)}px;font-weight:${e.peso};letter-spacing:${lsCss(e.ls)};${/may|upper/.test(e.ls ?? '') ? 'text-transform:uppercase;' : ''}`}>{fraseEsc(e.n)}</span>
                    <span class="t-ojo tf-d">{e.movil && e.movil !== e.px ? `${e.movil} → ${e.px}` : e.px} px</span>
                  </li>
                ))}
              </ol>
            </>
          ) : (
          <div class={`tipo-cartas n${Math.min(p.tipos.length, 2) + (aplicado ? 1 : 0)}`} data-vivo>
              {p.tipos.slice(0, 2).map((t, i) => (
                <figure class="carta" style={`--fondo:${cartaTipo(i)};--k:${i}`} data-carta>
                  <span class="rotulo">{t.uso}, {t.n}</span>
                  <img src={`/media/obra/${p.slug}/tipo-${i + 1}.png`} alt={en ? `${t.n} specimen` : `Muestra de ${t.n}`} loading="lazy" decoding="async" />
                </figure>
              ))}
              {aplicado && (
                <figure class="carta aplicada" style={`--fondo:${cartaTipo(2)};--k:2`} data-carta>
                  <span class="rotulo">{en ? 'Applied' : 'Aplicada'}</span>
                  <img src={`/media/obra/${p.slug}/aplicado.webp`} alt={en ? `Headline, text and button from ${p.nombre}'s website, in its typography` : `Titular, texto y botón de la web de ${p.nombre}, con su tipografía`} loading="lazy" decoding="async" />
                </figure>
              )}
            </div>
          )}
        </section>
      )
    }

    <!-- 28/10 · Eric: el ESPACIADO sube también, tras la tipografía -->
    {
      esp && (
        <section class="wrap rej bloque" aria-labelledby="esp-h">
          <h2 id="esp-h" class="t-enc enc">{en ? 'Spacing' : 'Espaciado'}</h2>
          <div class="c23 espaciado" data-vivo data-esp>
            <div class="esq" aria-hidden="true" style={`--C:${espCont};--S:${espSec};--R:${espRel};--G:${espHue}`}>
              <div class="pag">
                <i class="m m-cont izq"><span>{espCont} px {en ? 'container' : 'de contenedor'}</span></i><i class="m m-cont der" />
                <div class="cont">
                  <div class="sec">
                    <b class="tit" />
                    <div class="tarjetas">
                      <div class="tj"><i class="m m-relleno"><span>{espRel} px {en ? 'padding' : 'de relleno'}</span></i><b /><b /><b class="c" /></div>
                      <i class="m m-hueco gap-m"><span>{espHue} px {usoEsp.hueco}</span></i>
                      <div class="tj"><b /><b /><b class="c" /></div>
                      <i class="m m-hueco gap-m" />
                      <div class="tj"><b /><b /><b class="c" /></div>
                    </div>
                  </div>
                  <i class="m m-seccion entre"><span>{espSec} px {en ? 'between sections' : 'entre secciones'}</span></i>
                  <div class="sec dos"><div class="txt"><b class="tit" /><b /><b /><b class="c" /></div><b class="img" /></div>
                </div>
              </div>
            </div>
            <dl class="claves">
              <div><dt class="t-ojo">{en ? 'Base step' : 'Paso base'}</dt><dd class="cifra">{esp.base ? `${esp.base} px` : (en ? 'Fluid' : 'Fluido')}</dd></div>
              {esp.seccion && <div data-k="seccion"><dt class="t-ojo">{en ? 'Between sections' : 'Entre secciones'}</dt><dd class="cifra">{esp.seccion} px</dd></div>}
              {esp.contenedor && <div data-k="cont"><dt class="t-ojo">{en ? 'Container' : 'Contenedor'}</dt><dd class="cifra">{esp.contenedor} px</dd></div>}
            </dl>
            <ol class="pasos">
              {esp.escala.map((e, i) => (
                <li style={`--px:${e.px};--i:${i}`} data-k={espTipo(e) || undefined}>
                  <span class="t-texto fuerte cifra">{e.px}</span>
                  <span class="caja" aria-hidden="true"><span /></span>
                  <span class="t-ojo">{usoEsp[e.uso] ?? e.uso}, {e.n} {en ? 'times' : 'veces'}</span>
                </li>
              ))}
            </ol>
            <p class="t-ojo nota">{en
              ? `The paddings, margins and gaps that repeat most on the delivered site, at 1440 px and true scale${esp.base ? `. Almost all fall on ${esp.base} px steps` : '. They are fluid sizes, which change with the window width, with no fixed step'}.`
              : `Los rellenos, márgenes y huecos que más se repiten en la web entregada, a 1440 px y a escala real${esp.base ? `. Casi todos caen en pasos de ${esp.base} px` : '. Son tamaños fluidos, que cambian con el ancho de la ventana, sin un paso fijo'}.`}</p>
          </div>
        </section>
      )
    }

    <!-- 28/10 · la segunda parte del Figma (la home y lo que sigue), tras el sistema -->
    {
      figB.length > 0 && (
        <section class="bloque figma" aria-label={en ? 'From Figma to the site, continued' : 'Del Figma a la web, sigue'}>
          <div class="wrap fg-lista">
            {figB.map((g) => (
              <figure class={`fg fg-${g.f}`} data-vivo>
                <div class="fg-imgs" style={`--color:${p.colores[0]};--c2:${p.colores[1]};--c3:${p.colores[2]}`}>
                  {g.img.map((src) => <img src={src} alt={en ? `${g.titulo}, in ${p.nombre}’s Figma file` : `${g.titulo}, en el Figma de ${p.nombre}`} loading="lazy" decoding="async" />)}
                </div>
                <figcaption class="t-ojo pie"><span><span class="fuerte">{g.titulo}.</span> {g.pie}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- CÓMO LA CONSTRUIMOS: los pasos, numerados, en dos columnas que arrancan arriba a la vez -->
    {
      p.proceso && (
        <section class="wrap rej par bloque" aria-labelledby="proc-h">
          <h2 id="proc-h" class="t-enc enc">{en ? 'How we built it' : 'Cómo la construimos'}</h2>
          <ol class="c23 proceso">
            {p.proceso.map((s, i) => (
              <li data-enfoca>
                <h3 class="t-h">{s.n}</h3>
                <p class="t-texto">{s.d}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- 28/10 · DEL DISEÑO A LA ANIMACIÓN (Eric): dos columnas, la pieza tal cual se dibujó en Figma (su marco, entero) y la misma pieza viva en la web;
         las dos con el formato de «Los detalles»: carátula con el degradado de marca y la ventana de cristal (Medio con placa) -->
    {
      p.animacion && (
        <section class="wrap bloque" aria-labelledby="anim-h">
          <div class="sis-cab">
            <h2 id="anim-h" class="t-enc">{p.animacion.titulo}</h2>
            <p class="t-texto text-fg2 sis-entra">{p.animacion.texto}</p>
          </div>
          <div class="anim">
            <figure class="anim-pieza" data-vivo>
              <div class="anim-hueco">
                <Medio medio={{ tipo: 'imagen', src: p.animacion.diseno.src }} color={p.color} alt={en ? `${p.nombre}'s feed cards, as designed in Figma` : `Las tarjetas del feed de ${p.nombre}, tal como se diseñaron en Figma`} proporcion="auto" placa={p.colores[0]} colores={p.colores} />
              </div>
              <figcaption class="t-ojo pie"><span><span class="fuerte">{en ? 'In Figma.' : 'En Figma.'}</span> {p.animacion.diseno.pie}</span></figcaption>
            </figure>
            <figure class="anim-pieza" data-vivo>
              <div class="anim-hueco">
                <Medio medio={{ tipo: 'video', src: p.animacion.web.src, poster: p.animacion.web.poster }} color={p.color} alt={en ? `The feed animated on ${p.nombre}'s website` : `El feed animado en la web de ${p.nombre}`} proporcion="auto" placa={p.colores[0]} colores={p.colores} />
              </div>
              <figcaption class="t-ojo pie"><span><span class="fuerte">{en ? 'On the website.' : 'En la web.'}</span> {p.animacion.web.pie}</span></figcaption>
            </figure>
          </div>
        </section>
      )
    }

    <!-- 28/10 · MICROANIMACIONES (Eric: «cómo se nos permite microanimar en código todo»): la cabecera a dos columnas y la grabación a lo ancho, como las piezas anchas de «Los detalles» -->
    {
      p.micro && (
        <section class="wrap bloque" aria-labelledby="micro-h">
          <div class="sis-cab">
            <h2 id="micro-h" class="t-enc">{p.micro.titulo}</h2>
            <p class="t-texto text-fg2 sis-entra">{p.micro.texto}</p>
          </div>
          <div class="fila f-ancha">
          <figure class="tesela con-placa" data-vivo>
            <div class="hueco">
              <Medio medio={{ tipo: 'video', src: p.micro.video.src, poster: p.micro.video.poster }} color={p.color} alt={en ? `The “How it works” section animated on ${p.nombre}'s website` : `La sección «Cómo funciona» animada en la web de ${p.nombre}`} proporcion="16 / 9" placa={p.colores[0]} colores={p.colores} />
            </div>
            <figcaption class="t-ojo pie"><span><span class="fuerte">{en ? 'How it works.' : 'Cómo funciona.'}</span> {p.micro.video.pie}</span></figcaption>
          </figure>
          </div>
          {(p.micro.mas ?? []).map((m) => (
            <div class="fila f-ancha micro-mas">
            <figure class="tesela con-placa" data-vivo>
              <div class="hueco">
                <Medio medio={{ tipo: 'video', src: m.video.src, poster: m.video.poster }} color={p.color} alt={m.alt} proporcion="16 / 9" placa={p.colores[0]} colores={p.colores} />
              </div>
              <figcaption class="t-ojo pie"><span><span class="fuerte">{m.titulo}.</span> {m.video.pie}</span></figcaption>
            </figure>
            </div>
          ))}
        </section>
      )
    }

    <!-- 28/10 · Eric: CON QUÉ TRABAJAMOS (Ship Studio y Agentation), dos vídeos a dos columnas, como «Del diseño a la animación»; solo los que ya tienen vídeo -->
    {
      p.herramientas && p.herramientas.piezas.some((h) => h.video) && (
        <section class="wrap bloque" aria-labelledby="herr-h">
          <div class="sis-cab">
            <h2 id="herr-h" class="t-enc">{p.herramientas.titulo}</h2>
            <p class="t-texto text-fg2 sis-entra">{p.herramientas.texto}</p>
          </div>
          <div class="anim">
            {p.herramientas.piezas.filter((h) => h.video).map((h) => (
              <figure class="anim-pieza" data-vivo>
                <div class="anim-hueco herr-hueco">
                  <Medio medio={{ tipo: 'video', src: h.video!.src, poster: h.video!.poster }} color={p.color} alt={h.alt} proporcion="auto" placa={p.colores[0]} colores={p.colores} />
                </div>
                <figcaption class="t-ojo pie"><span><span class="fuerte">{h.titulo}.</span> {h.video!.pie}</span></figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- LOS DETALLES (ronda 153, referencia casabien · Hannun): un MOSAICO de imágenes en filas de tamaños distintos sobre la retícula de 12 —
         ancha · a sangre · 6 + 6 · 7 + 5 · 5 + 7 · 4 + 4 + 4—, cada pieza con su número, su título y una frase. Las webs van enteras sobre una
         placa de su color; los primeros planos llenan su hueco. -->
    {/* 28/10 · Eric: fuera «Los detalles» donde el caso ya los enseña con «Del diseño a la animación» y «Microanimaciones» (sinDetalles) */}
    {
      filas.length > 0 && !p.sinDetalles && (
        <section class="bloque detalles" aria-labelledby="det-h">
          <div class="wrap det-cab">
            <h2 id="det-h" class="t-enc">{en ? 'The details' : 'Los detalles'}</h2>
            {(p.nota ?? p.detalles?.[0]?.pie) && <p class="t-ojo">{p.nota ?? p.detalles?.[0]?.pie}</p>}
          </div>
          <div class="mosaico">
            {filas.map((fila) => (
              <div class={`fila f-${fila.f === 'sangre' ? 'ancha' : fila.f} wrap`}>
                {fila.p.map((z) => (
                  <figure class={`tesela ${dePlaca(z, fila.f) ? 'con-placa' : 'sin-placa'} ${z.medio.movil ? 'es-movil' : ''}`} data-vivo>
                    <div class="hueco">
                      <Medio
                        medio={z.medio}
                        color={p.color}
                        alt={en ? `${z.titulo}, on ${p.nombre}'s website` : `${z.titulo}, en la web de ${p.nombre}`}
                        proporcion={fila.f === 'ancha' || fila.f === 'sangre' ? (z.prop ?? '16 / 9') : 'auto'}
                        natural={z.prop ?? '16 / 9'}
                        placa={dePlaca(z, fila.f) ? p.colores[0] : undefined}
                        pos={z.pos}
                        colores={p.colores}
                      />
                    </div>
                    <figcaption class="t-ojo pie">
                      <span><span class="fuerte">{z.titulo}.</span> {z.pie}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      p.apartados.map((a) => (
        <section class="wrap rej par bloque" aria-label={a.titulo}>
          <h2 class="t-enc enc">{a.titulo}</h2>
          <div class={`c23 ${a.texto.length > 1 ? 'dos' : 'medida'}`}>{a.texto.map((t) => <p class="t-texto">{t}</p>)}</div>
        </section>
      ))
    }

    {
      movVideo && !p.sinMovimiento && (
        <section class="wrap bloque sis-bloque" aria-labelledby="mov-h">
          <div class="sis-cab">
            <h2 id="mov-h" class="t-enc">{en ? 'Motion' : 'Movimiento'}</h2>
            <p class="t-texto text-fg2 sis-entra">{movTexto.length ? movTexto.join(' ') : (en ? `How ${p.nombre} moves, from its own recording. Drag the timeline.` : `Cómo se mueve ${p.nombre}, en su propia grabación. Arrastra la línea de tiempo.`)}</p>
          </div>
          <div class="motion" data-motion style={`--c1:${tarjeta(0)};--c2:${tarjeta(1)};--c3:${tarjeta(2)}`}>
            <div class="mo-lienzo">
              <video muted loop playsinline preload="none" data-poster={movVideo.poster} data-poster-cerca data-src={movVideo.src} aria-label={en ? `Recording of ${p.nombre}'s website` : `Grabación de la web de ${p.nombre}`}></video>
            </div>
            <div class="mo-linea" data-mo-linea role="slider" tabindex="0" aria-label={en ? 'Timeline' : 'Línea de tiempo'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
              {MO_PISTAS.map((pi, k) => <span class="pista" style={`--a:${pi[0]};--b:${pi[1]};--k:${k}`}><i /></span>)}
              <span class="cabezal" aria-hidden="true"></span>
            </div>
            <div class="mo-pie t-ojo"><span data-mo-t>00:00</span> / <span data-mo-d>00:00</span><span class="mo-fps">{en ? 'Frame render time' : 'Tiempo por fotograma'} <b data-mo-fps>16.7 ms</b></span></div>
          </div>
          {gestos.length > 0 && (
            <ul class="mo-ejemplos" style={`--n:${gestos.length}`}>
              {gestos.map(({ z, g }, k) => {
                const bg = tarjeta(k), [fa, fb] = formas(bg);
                return (
                  <li class="mo-ej" data-vivo data-gesto>
                    <div class={`abs g-${g}`} style={`--fondo:${bg};--fa:${fa};--fb:${fb}`} aria-hidden="true">
                      {g === 'bucle' && [0, 1, 2, 3, 4].map((i) => <i style={`--k:${i}`} />)}
                      {g === 'pestanas' && (<>{[0, 1, 2, 3].map((i) => <i class="tab" style={`--k:${i}`} />)}<b class="ind" /><em class="pan"><u /></em></>)}
                      {g === 'cuenta' && [0, 1, 2, 3].map((i) => <i style={`--k:${i};--h:${[0.62, 0.9, 0.45, 0.74][i]}`} />)}
                      {g === 'cae' && [0, 1, 2, 3].map((i) => <i style={`--k:${i}`} />)}
                      {g === 'atraca' && (<><b class="api" />{ARCO.map(([x, y], i) => <i style={`--k:${i};--x:${x.toFixed(1)}%;--y:${y.toFixed(1)}%`} />)}</>)}
                      {g === 'comprime' && (<><b class="aro" /><i class="bola" />{[0, 1, 2].map((i) => <em style={`--k:${i}`} />)}</>)}
                      {g === 'traza' && (<svg viewBox="0 0 120 90"><rect class="t-r" x="24" y="18" width="72" height="54" rx="6" pathLength="1" /><circle class="t-c" cx="60" cy="45" r="14" pathLength="1" /></svg>)}
                      {g === 'gira' && [0, 1, 2, 3, 4, 5].map((i) => <i style={`--c:${i % 3};--r:${Math.floor(i / 3)}`} />)}
                      {g === 'filtra' && Array.from({ length: 24 }, (_, i) => <i style={`--c:${i % 6};--r:${Math.floor(i / 6)};--g:${(i * 7) % 3}`} />)}
                      {g === 'releva' && [0, 1, 2].map((i) => <i style={`--k:${i}`} />)}
                      {g === 'escribe' && (<>{[0.62, 0.4, 0.7, 0.3, 0.52].map((w, i) => <i style={`--k:${i};--w:${w * 100}%`} />)}<b class="cursor" /></>)}
                      {g === 'ola' && [0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => <i style={`--k:${i}`} />)}
                      {g === 'orbita' && (<><b class="nucleo" />{[0, 1, 2].map((i) => <i style={`--k:${i};--d:${34 + i * 16}%`} />)}</>)}
                      {g === 'onda' && [0, 1, 2, 3].map((i) => <i style={`--k:${i}`} />)}
                    </div>
                    <h3 class="t-h">{z.titulo}</h3>
                    <p class="t-texto text-fg2">{z.pie}</p>
                  </li>
                );
              })}
            </ul>
          )}
        </section>
      )
    }
    {
      sonidos.length > 0 && (
        <section class="wrap bloque sis-bloque" aria-labelledby="son-h">
          <div class="sis-cab">
            <h2 id="son-h" class="t-enc">{en ? 'Sound' : 'Sonido'}</h2>
            <p class="t-texto text-fg2 sis-entra">{textoSonido ?? (en ? `${p.nombre}'s sounds, as they are in its code.` : `Los sonidos de ${p.nombre}, tal cual están en su código.`)}</p>
          </div>
          <ul class="sonidos" data-vivo>
            {sonidos.map((so) => (
              <li>
                <button type="button" class="son" data-son={JSON.stringify({ v: so.vol, c: so.corte, k: so.capas })} data-son-tipo={so.tipo} aria-label={so.tipo === 'clic' ? (en ? 'Play the click sound' : 'Escuchar el sonido del clic') : (en ? 'Play the hover sound' : 'Escuchar el sonido al pasar el cursor')}>
                  <span class="son-cab"><span class="son-play" aria-hidden="true" /><span class="t-texto fuerte">{so.tipo === 'clic' ? (en ? 'Click' : 'Clic') : (en ? 'Hover' : 'Al pasar el cursor')}</span><span class="t-ojo son-pista">{so.tipo === 'clic' ? (en ? 'Press' : 'Pulsa') : (en ? 'Hover here' : 'Pasa por aquí')}</span></span>
                  <svg class="son-onda" viewBox="0 0 160 40" preserveAspectRatio="none" aria-hidden="true">
                    {so.onda.map((v, i) => <rect x={i + 0.15} y={20 - Math.max(v * 18, 0.4)} width="0.7" height={Math.max(v * 36, 0.8)} />)}
                  </svg>
                  <span class="son-linea" aria-hidden="true">
                    {so.capas.map((c) => <span class="son-tono" style={`--a:0;--b:${(c.dur / DUR_SON) * 100}`}><i /><em>{etiquetaCapa(c)}</em></span>)}
                    <span class="son-cabezal" />
                  </span>
                  <span class="t-ojo son-pie">{en ? `Low-pass at ${so.corte.toLocaleString('en')} Hz over 32 ms, shown 25× slower` : `Paso bajo a ${so.corte.toLocaleString('es')} Hz en 32 ms, a 25× más lento`}</span>
                </button>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      p.iconos && p.iconos.length > 0 && (
        <section class="wrap bloque sis-bloque" aria-labelledby="ico-h">
          <div class="sis-cab">
            <h2 id="ico-h" class="t-enc">{en ? 'Iconography' : 'Iconografía'}</h2>
          </div>
          <ul class="iconos">
            {p.iconos.map((ic) => <li><img src={ic.src} alt={ic.n} loading="lazy" /><span class="t-ojo">{ic.n}</span></li>)}
          </ul>
        </section>
      )
    }

    {/* 28/10 · Eric: «La entrega», con la grabación de la librería en vez del albarán y el libro */}
    {
      p.libreria?.video && (
        <section class="wrap bloque" aria-labelledby="entrega-h">
          <div class="sis-cab">
            <h2 id="entrega-h" class="t-enc">{en ? 'The handover' : 'La entrega'}</h2>
            {((en ? p.libreria.textoEn : p.libreria.texto) ?? []).map((t) => <p class="t-texto text-fg2 sis-entra">{t}</p>)}
            {/* el enlace mínimo de la columna fija («Ver la web»), no un botón (Eric: «más minimalista») */}
            <p class="sis-entra"><a class="ir-web" href={p.libreria.url} target="_blank" rel="noopener">{en ? 'See the library' : 'Ver la librería'}<Fragment set:html={flecha('fuera')} /></a></p>
          </div>
          <div class="fila f-ancha">
          <figure class="tesela con-placa" data-vivo>
            <div class="hueco">
              <Medio medio={{ tipo: 'video', src: p.libreria.video.src, poster: p.libreria.video.poster }} color={p.color} alt={en ? `${p.nombre}'s library, page by page` : `La librería de ${p.nombre}, página a página`} proporcion="16 / 9" placa={p.colores[0]} colores={p.colores} />
            </div>
            <figcaption class="t-ojo pie"><span><span class="fuerte">{en ? 'The library.' : 'La librería.'}</span> {en ? p.libreria.video.pieEn : p.libreria.video.pie}</span></figcaption>
          </figure>
          </div>
        </section>
      )
    }

    {
      lib && (
        <section class="wrap bloque sis-bloque" aria-labelledby="lib-h">
          <div class="sis-cab">
            <h2 id="lib-h" class="t-enc">{en ? 'The handover' : 'La entrega'}</h2>
            {(en ? lib.textoEn : lib.texto) ? (en ? lib.textoEn : lib.texto)!.map((t) => <p class="t-texto text-fg2 sis-entra">{t}</p>) : <p class="t-texto text-fg2 sis-entra">{en ? `Along with the site, ${p.nombre} kept all of this: its design system and the guide to change it with Claude.` : `Con la web, ${p.nombre} se quedó con esto: su sistema de diseño y la guía para cambiarla con Claude.`}</p>}
          </div>
          <!-- LA ENTREGA, como un albarán: las cuatro piezas que se lleva el cliente; la librería (la que se navega debajo) va marcada -->
          <ol class="entrega" data-vivo>
            {lib.entrega.map((e, i) => (
              <li class={e.n === 'La librería' ? 'es-lib' : ''} style={`--k:${i}`}>
                <span class="t-ojo ent-n">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-texto fuerte">{en ? e.nEn : e.n}</span>
                <span class="t-ojo text-fg2">{en ? e.dEn : e.d}</span>
                {e.n === 'La librería' && <span class="t-ojo ent-aqui">{en ? 'Below, the real one ↓' : 'Aquí abajo, la de verdad ↓'}</span>}
              </li>
            ))}
          </ol>
          <!-- LA LIBRERÍA DE VERDAD (Andoni: «la que presentamos sigue sin convencer»): la suya, en un iframe (su CSP deja a savvia.studio y a localhost),
               navegable; encima, accesos a lo que más vende, que saltan a esa sección dentro de ella. Se carga al acercarse; hasta entonces (y si no
               carga en 15 s) se ve su primera pantalla capturada -->
          <figure class="libreria" data-vivo data-lib={lib.url}>
            <div class="lib-accesos" role="group" aria-label={en ? 'Go to a section of the library' : 'Ir a una sección de la librería'}>
              <span class="t-ojo text-fg2">{en ? 'Go to' : 'Ir a'}</span>
              {lib.accesos.map((a) => <button type="button" class="lib-acc" data-ancla={a.ancla} aria-pressed="false">{en ? a.nEn : a.n}</button>)}
              <button type="button" class="lib-cerrar" data-libro-boton aria-expanded="false"><span class="ab">{en ? 'Close the book' : 'Cerrar el libro'}</span><span class="ce">{en ? 'Open the book' : 'Abrir el libro'}</span></button>
            </div>
            <!-- EL LIBRO DE LA MARCA (Andoni eligió esta dirección): la librería se entrega como un libro. Cerrado, la tapa en los colores de su marca con la
                 etiqueta de savvia; al llegar se abre girando sobre el lomo y la página es la librería real. La página ocupa tres cuartos (para que se lea)
                 y la tapa se abre hacia atrás, en perspectiva, en el cuarto que queda -->
            <div class="libro" data-libro style={`--t-fondo:${lib.tapa.fondo};--t-tinta:${lib.tapa.tinta};--t-acento:${lib.tapa.acento}`}>
              <div class="pagina-lib">
                <span class="hojas d" aria-hidden="true" /><span class="hojas b" aria-hidden="true" />
                <div class="lib-ventana" data-ventana>
                  <picture class="lib-cap" aria-hidden="true">
                    <source media="(width < 48rem)" srcset={lib.capturaMovil} />
                    <img src={lib.captura} alt="" loading="lazy" decoding="async" />
                  </picture>
                </div>
              </div>
              <button type="button" class="tapa" data-tapa aria-label={en ? `Open ${p.nombre}'s library` : `Abrir la librería de ${p.nombre}`}>
                <span class="cara frente" aria-hidden="true">
                  <span class="t-marca">{lib.tapa.marca}</span>
                  <span class="t-ojo-l">{en ? 'Library, Design system' : 'Librería, Sistema de diseño'}</span>
                  <span class="t-tit">{en ? lib.tapa.tituloEn : lib.tapa.titulo}</span>
                  <span class="etiqueta"><span class="e-ojo">{en ? 'Delivered with the website' : 'Entregado con la web'}</span><i class="e-savvia" /></span>
                  <span class="t-abrir">{en ? 'Open' : 'Abrir'} ↗</span>
                </span>
                <span class="canto l" aria-hidden="true" /><span class="canto r" aria-hidden="true" />
                <span class="cara dorso" aria-hidden="true"><span class="exlibris"><span class="e-ojo">{en ? 'This book belongs to' : 'Este libro es de'}</span><b>{p.nombre}</b></span></span>
              </button>
            </div>
          </figure>
          <div class="lib-ir"><Cta href={lib.url} externo>{en ? 'See the whole library' : 'Ver la librería entera'}</Cta><span class="t-ojo text-fg2">{en ? 'It’s the real one: browse it here or open it in full.' : 'Es la de verdad: navégala aquí o ábrela entera.'}</span></div>
        </section>
      )
    }

    <section class="wrap rej par bloque" aria-labelledby="dentro-h">
      <h2 id="dentro-h" class="t-enc enc">{en ? 'Under the hood' : 'Por dentro'}</h2>
      <div class="c2">
        {p.stack && p.stack.length > 0 && (<><p class="t-ojo sub">{en ? 'Tools' : 'Herramientas'}</p><ul class="lista herramientas">{p.stack.map((t) => <li class="t-texto"><span class="h-ic" aria-hidden="true" set:html={icoTec(t)} />{t}</li>)}</ul></>)}
      </div>
      <div class="c3">
        {cifras.length > 0 && (<><p class="t-ojo sub">{en ? 'In numbers' : 'En cifras'}</p><ul class="lista">{cifras.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
        {p.descartado && (<><p class="t-ojo sub">{en ? 'What we dropped' : 'Lo que se descartó'}</p><ul class="lista tachada">{p.descartado.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
      </div>
    </section>

    <!-- CONCLUSIÓN (ronda 153): lo que consiguió la web y cómo trabaja el cliente con ella; solo hechos -->
    {
      p.conclusion && p.conclusion.length > 0 && (
        <section class="wrap rej par bloque" aria-labelledby="concl-h">
          <h2 id="concl-h" class="t-enc enc">{en ? 'Conclusion' : 'Conclusión'}</h2>
          <div class="c23 conclusion">
            <p class="t-lead">{p.conclusion[0]}</p>
            {p.conclusion.slice(1).map((t) => <p class="t-texto">{t}</p>)}
          </div>
        </section>
      )
    }

    {
      p.cita && !p.cita.retrato && (
        <section class="wrap rej par bloque" aria-label={en ? 'What the client says' : 'Lo que cuenta el cliente'}>
          <h2 class="t-enc enc">{en ? 'In their words' : 'Lo que cuentan'}</h2>
          <figure class="cita c23">
            <blockquote class="t-lead font-display">{en ? '“' : '«'}{p.cita.texto}{en ? '”' : '»'}</blockquote>
            <figcaption><span class="t-texto fuerte">{p.cita.autor}</span><span class="t-ojo">{p.cita.rol}</span></figcaption>
            {p.cita.video && (
              <a class="btn-primary btn-sm con-video" href={p.cita.video} target="_blank" rel="noopener">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5z" /></svg><span class="btn-tx">{en ? 'Watch the video testimonial' : 'Ver el testimonio en vídeo'}</span>
              </a>
            )}
          </figure>
        </section>
      )
    }

    {/* RONDA 307, 26.ª · Andoni: «al final del case study quitamos nuestro comentario y ponemos un testimonio como en el portfolio, con esa foto; de momento un
         placeholder para que Eric sepa lo que va ahí». MARCADOR: el retrato de JJ Velaz y un texto que lo dice; cuando haya el de cada cliente, va en su ficha. */}
    {!p.cita && (
    <section class="wrap bloque testimonio-final" aria-label={en ? 'What the client says' : 'Lo que dice el cliente'}>
      <Voces dato={{
        n: en ? 'Client name (placeholder)' : 'Nombre del cliente (marcador)',
        r: en ? 'Role, company' : 'Cargo, empresa',
        retrato: '/media/testimonios/juanjo-velaz.webp',
        q: en ? 'The client’s testimonial about this project goes here: two or three lines, with their charcoal portrait. Placeholder for Eric.' : 'Aquí va el testimonio del cliente sobre este proyecto: dos o tres líneas, con su retrato al carboncillo. Marcador para Eric.',
      }} />
    </section>
    )}

    </div>
    </div>
  </main>
  <Pie />
</Base>

<script>
  import { cambiarFoto } from '../scripts/revelar';
  // lo que se anima al llegar (paleta, muestras, escala, espaciado, piezas del mosaico): una vez, cuando asoma un 25 %
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); } }), { threshold: 0.25 });
  document.querySelectorAll('[data-vivo]').forEach((el) => io.observe(el));

  // LA CARÁTULA EN LA MESA · la grabación corre mientras se ve; la lámina sigue a la estación de la web
  const pm = document.querySelector<HTMLElement>('[data-portada-mesa]');
  if (pm) {
    const foto = pm.querySelector<HTMLImageElement>('[data-mesa]')!, fotoM = pm.querySelector<HTMLImageElement>('[data-mesa-m]');
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // suena solo la grabación de la escena que se ve
    const vid = () => pm.querySelector<HTMLVideoElement>(pm.dataset.escena === 'movil' ? '.pm-m video' : '.pm-e video')!;
    let aLaVista = false;
    // (30/10 · rendimiento en móvil) en pantallas estrechas, la grabación normal (960 px) en vez de la grande (1600 px: 3,3 MB la de Neety)
    const sonar = () => { pm.querySelectorAll('video').forEach((x) => x.pause()); if (!aLaVista) return; const v = vid(); if (!v.src && v.dataset.src) v.src = innerWidth < 768 ? v.dataset.src.replace(/-grande\.mp4$/, '.mp4') : v.dataset.src; if (!quieto) v.play().catch(() => {}); };
    new IntersectionObserver(([e]) => { aLaVista = e.isIntersecting; sonar(); }, { threshold: 0.2 }).observe(pm);
    const est = () => document.documentElement.dataset.estacion || 'otono';
    const lamM = () => { if (fotoM && pm.dataset.escena === 'movil') cambiarFoto(fotoM, { src: `/media/anteriores/mesa-movil-${est()}.webp` }); };
    // (30/10) la lámina nueva entra con el rasgado de la estación, ya descargada (antes cambiaba de golpe)
    // (30/10) en el móvil, sin la de 5120 px (era la imagen principal y llegaba a los 9,8 s con 4G lenta)
    addEventListener('savvia:estacion', () => { const b = `/media/estudio/${est()}`; cambiarFoto(foto, { srcset: `${b}-m.webp 1600w, ${b}.webp 2560w${innerWidth < 768 ? '' : `, ${b}-xl.webp 5120w`}` }); lamM(); });
