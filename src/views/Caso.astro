  /* ── EL SISTEMA a la manera de brand.dropbox.com: cada parte con su cabecera (titular a la izquierda, entradilla a la derecha) */
  .sis-cab { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: calc(var(--spacing) * 6); row-gap: calc(var(--spacing) * 4); align-items: end; margin-bottom: calc(var(--spacing) * 12); }
