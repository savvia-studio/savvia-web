---
// RONDA 62 · CASO DE ESTUDIO (referencia: focuslab.agency/work/marketo). RONDA 63: en claro y con mucha más información.
// RONDA 64 (Andoni): «quitamos métricas en grande; más estilo agencia creativa: ir intercalando detalles de la web + detalles de la marca (colores
// puestos de forma animada, tipografía, etc.)». El caso alterna TEXTO y MARCA:
//   nombre · entradilla y ficha (las cifras, pequeñas, en la ficha) · portada · la frase · COLOR (bandas de su paleta que crecen al llegar) ·
//   un DETALLE de la web junto al reto · galería · TIPOGRAFÍA (su muestra, escrita en SU web con SU fuente, que se imprime al llegar) · la web sección
//   a sección · galería · apartados con otro DETALLE · galería · por dentro y lo descartado · la cita · el siguiente.
// Muestras (tipo-1, tipo-2): public/media/obra/<slug>/ (tools/r64-tipos.cjs).
// RONDA 152 · Andoni: «en case studies, no tanto aire y los textos con más consistencia de tamaño y orden; más chicha en cada sección; que cada
// imagen represente bien lo que se dice y muestre los entresijos de la web: que cada caso muestre cómo la hemos construido y los detalles más
// relevantes de una forma bonita». El caso, en este orden: nombre · entradilla y ficha · portada · el proyecto · el reto · CÓMO LA CONSTRUIMOS
// (el proceso, paso a paso) · LOS DETALLES (cada pieza de la web, de cerca, con su vídeo grabado en la web real y el texto que cuenta cómo está
// hecha: tools/r152/) · apartados · el sistema (color y tipografía) · sección a sección · por dentro · la cita · anterior y siguiente.
// RONDA 153 · «que la parte de detalles se presente más con imágenes, como casabien.com/proyectos/rebranding-identidad-hannun, y terminamos con una
// conclusión; en colores y typos, mostrar mejor tamaños y cómo se usan»: LOS DETALLES son un mosaico (ver proyectos.ts › Fila), EL SISTEMA enseña el
// uso medido de cada color, su contraste, la escala real y el botón (medidos en la web) y un ejemplo aplicado; y antes de la cita, la CONCLUSIÓN.
// UNA ESCALA de texto para todo el caso (.t-ojo · .t-enc · .t-h · .t-lead · .t-texto) y una retícula de TRES columnas: el título de cada bloque en
// la primera; el contenido en la segunda y la tercera, siempre arrancando arriba (nada empieza en una columna suelta). Menos aire: 64 → 104 px.
import Base from '../layouts/Base.astro';
import { esPublico } from '../lib/lanzamiento';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import Cta from '../components/Cta.astro';
import Medio from '../components/obra/Medio.astro';
// (30/10) los carteles de las grabaciones, en WebP (la mitad que el JPG) donde lo hay
const webpCartel = (u?: string) => (u && /^\/media\/(obra|anteriores\/video)\/.+\.jpg$/.test(u) ? u.replace(/\.jpg$/, '.webp') : u);
import Pieza from '../components/obra/Pieza.astro';
import Voces from '../components/Voces.astro';
import { flecha } from '../lib/flecha';
import { gestosDe } from '../lib/gestos';
import { mesaMovil } from '../lib/mesa-movil';
import { type Proyecto } from '../data/proyectos';
import { proyectoDe, proyectosDe, servicio } from '../data/idioma';
import { langDe, ruta } from '../lib/i18n';
import espaciado from '../data/espaciado.json';

const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const props = Astro.props as { p: Proyecto; sig: Proyecto; ant: Proyecto };
// los datos llegan en castellano desde getStaticPaths: se resuelven en el idioma de la página
const p = proyectoDe(lang, props.p.slug) ?? props.p;
const cifras = (p.cifras ?? []).map((c) => `${c.v} ${c.t}`);
// RONDA 307 · CASOS EN DOS COLUMNAS (referencia: dsaltaren.com/#work): a la izquierda, fija, la ficha del proyecto (nombre, entradilla, servicios, sector,
// lugar, enlace a la web) y abajo del todo el índice de casos con anterior y siguiente; a la derecha, el contenido, más sobrio.
// 28/10 · Eric: «el modo foco quitamos directamente».
// solo entre los casos que ya se publican (src/lib/lanzamiento.ts · Eric); el actual cuenta aunque no lo sea
const todos = proyectosDe(lang).filter((x) => esPublico(x.slug) || x.slug === p.slug), yo = todos.findIndex((x) => x.slug === p.slug);
// Eric (oct.): «de momento sobra porque saldremos solo con 1 proyecto»: anterior y siguiente, ocultos (vuelven con true)
const masCasos = false;
const antP = todos[(yo - 1 + todos.length) % todos.length], sigP = todos[(yo + 1) % todos.length];
// Eric (oct.): «falta información del cliente: categorías, país si hay y demás» → sector, lugar, año y servicios, cada uno con su rótulo
const fichaLado = [
  [en ? 'Sector' : 'Sector', p.sector ?? ''],
  [en ? 'Location' : 'Lugar', p.ubicacion ?? p.con ?? ''],
  [en ? 'Year' : 'Año', p.anio ?? ''],
  [en ? 'Services' : 'Servicios', p.servicios.map((x) => servicio(lang, x)).join(', ')],
].filter(([, v]) => v) as [string, string][];
const luz = (hex: string) => { const n = parseInt(hex.slice(1), 16), r = n >> 16, gg = (n >> 8) & 255, b = n & 255; return (r * 299 + gg * 587 + b * 114) / 1000 > 150; };
// el fondo de las muestras tipográficas: el color más claro de su paleta (la tinta de la muestra es la suya)
const claroMarca = (p.paleta ?? []).map((c) => c.hex).find((h) => luz(h)) ?? '#FFFFFF';
// RONDA 153 · el contraste WCAG entre dos colores (para «El sistema»: cada color sobre el fondo que más se usa)
const lum = (hex: string) => { const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
const contraste = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };
const nivel = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : r >= 3 ? (en ? 'AA for large text' : 'AA en tamaño grande') : (en ? 'not for text' : 'no para texto'));
const coma = (n: number, d = 1) => (en ? n.toFixed(d).replace(/\.0$/, '') : n.toFixed(d).replace('.', ',').replace(/,0$/, ''));
const usados = [...(p.paleta ?? [])].sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0));
const fondo = usados[0];
const pares = fondo ? usados.slice(1).map((c) => ({ c, r: contraste(c.hex, fondo.hex) })).sort((a, b) => b.r - a.r) : [];
const aplicado = !!p.aplicado;
// 28/10 · Eric: «en vez de La librería (del Figma), ahí mejor subir colores y typo, y luego ya la home»: el Figma se parte en `figmaCorte`;
// entre las dos partes van Color, Tipografía y Espaciado
const corteFigma = p.figmaCorte ?? p.figma?.length ?? 0;
const figA = (p.figma ?? []).slice(0, corteFigma), figB = (p.figma ?? []).slice(corteFigma);
// 28/10 · Eric: «la tipografía, como el storybook»: cartas «Aa» en SUS fuentes (texto vivo) y debajo la escala medida con frases de su web.
// Solo donde la web ya carga todas sus familias (Base.astro); si falta alguna, siguen las cartas con imagen.
const FUENTE: Record<string, string> = { 'Bricolage Grotesque': 'var(--font-bricolage)', Switzer: 'var(--font-switzer)', 'Roboto Mono': 'var(--font-roboto-mono)', Inter: 'var(--font-inter)' };
const famsTipo = [...new Set([...(p.tipos ?? []).map((t) => t.n), ...(p.escala ?? []).map((e) => e.fam)])];
const tipoVivo = !!p.escala?.length && famsTipo.every((n) => FUENTE[n]);
const NDET: Record<string, string> = en ? { H1: 'Headlines', H2: 'Headlines', H3: 'Headlines', Texto: 'Text', Detalle: 'Details' } : { H1: 'Titulares', H2: 'Titulares', H3: 'Titulares', Texto: 'Texto', Detalle: 'Detalles' };
const familiasVivas = famsTipo.map((n) => {
  const t = p.tipos?.find((x) => x.n === n);
  const filas = (p.escala ?? []).filter((e) => e.fam === n);
  return { n, css: FUENTE[n], peso: filas[0]?.peso ?? 400, mayus: filas.some((e) => /may|upper/.test(e.ls ?? '')), uso: t?.uso ?? `${NDET[filas[0]?.n] ?? filas[0]?.n ?? ''}, ${filas[0]?.peso ?? 400}` };
});
const mu = p.muestra;
const fraseEsc = (n: string) => (/^H\d/.test(n) && !/Detalle|Detail/.test(n) ? (en ? mu?.titularEn : mu?.titular) ?? p.nombre : /Detalle|Detail/.test(n) ? (en ? mu?.detalleEn : mu?.detalle) ?? p.nombre : (en ? mu?.textoEn : mu?.texto) ?? p.resumen);
const NESC_V: Record<string, string> = en ? { Texto: 'Text', Detalle: 'Detail', Entradilla: 'Lead' } : {};
// 28/10 · Eric: «too much, ocupa mucho»: los titulares se enseñan comprimidos (hasta 20 px, reales; por encima, al 45 %), en una fila compacta
const tamEsc = (px: number) => (px <= 20 ? px : Math.round(20 + (px - 20) * 0.45));
const lsCss = (ls?: string) => (ls && /em/.test(ls) ? ls.replace('−', '-').replace(',', '.').replace(/\s/g, '') : ls && /may|upper/.test(ls) ? '0.04em' : 'normal');
// las tarjetas de tipografía y del movimiento, en colores de SU paleta (los menos usados primero: los acentos; el fondo, el último)
const acentos = [...usados].reverse();
const tarjeta = (i: number) => (acentos[i % Math.max(acentos.length, 1)]?.hex ?? p.colores[i % 3]);
// las de tipografía: la muestra va en la tinta de su web (oscura), así que las cartas son los colores con luz de su paleta (sin el fondo, que es casi
// blanco); si no hay bastantes, el fondo mismo
const claros = acentos.filter((c) => c !== usados[0] && lum(c.hex) > 0.18);
const cartaTipo = (i: number) => (claros.length ? claros[i % claros.length].hex : usados[0]?.hex ?? p.colores[0]);
// el MOVIMIENTO: su grabación (la toma grande o la portada) y, si el caso lo cuenta, las frases que hablan de cómo se mueve
const movVideo = (() => { const v = p.cubierta ?? p.portada; return v && v.tipo === 'video' ? v : null; })();
const RE_MOV = /movimiento|anima|gsap|scrolltrigger|lenis|transici|motion|cae |entra |sube /i;
const movTexto = [...(p.tecnica ?? []), ...p.apartados.flatMap((x) => x.texto)].filter((t) => RE_MOV.test(t)).slice(0, 1).map((t) => (/[.!?»]$/.test(t.trim()) ? t.trim() : t.trim() + '.'));
// las pistas de la línea de tiempo (inicio y fin en % del recorrido): la forma de la de Dropbox, en los colores de su paleta
// POR DENTRO · cada herramienta con su icono (Simple Icons, CC0: public/media/iconos/tec/); las que no tienen logotipo, un glifo de línea de la casa
const TEC: [RegExp, string][] = [[/next/i, 'nextdotjs'], [/tailwind/i, 'tailwindcss'], [/gsap/i, 'greensock'], [/sanity/i, 'sanity'], [/cloudflare/i, 'cloudflare'], [/vercel/i, 'vercel'], [/figma/i, 'figma'], [/webflow/i, 'webflow'], [/notion/i, 'notion'], [/hubspot/i, 'hubspot'], [/react/i, 'react'], [/^css$/i, 'css3'], [/html/i, 'html5'], [/github/i, 'github']];
const GLIFO: [RegExp, string][] = [
  [/lenis|scroll/i, '<path d="M8 3.5v17M8 3.5 5 6.5M8 3.5l3 3M16 20.5v-17M16 20.5l-3-3M16 20.5l3-3"/>'],
  [/canvas/i, '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M7 15c2-4 4-4 5-2s3 2 5-2"/>'],
  [/audio|sonido/i, '<path d="M3 12h2l2-5 3 10 3-14 3 12 2-3h3"/>'],
  [/cursor|mcp|claude|ia\b/i, '<path d="M12 3.5v4M12 16.5v4M3.5 12h4M16.5 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>'],
];
const ICO_DEF = '<path d="M9 7 4 12l5 5M15 7l5 5-5 5"/>';
const icoTec = (t: string) => {
  const s = TEC.find(([r]) => r.test(t))?.[1];
  if (s) return `<img src="/media/iconos/tec/${s}.svg" alt="" width="18" height="18" loading="lazy" />`;
  const g = GLIFO.find(([r]) => r.test(t))?.[1] ?? ICO_DEF;
  return `<svg viewBox="0 0 24 24">${g}</svg>`;
};
const MO_PISTAS: [number, number][] = [[0, 18], [8, 46], [30, 92], [52, 74], [64, 100]];
// RONDA 188 · el ESPACIADO medido en la web (tools/r188/espacios.cjs): los valores que más se usan, para qué, el paso base, el aire entre secciones
// y el contenedor. Invopop no lo tiene: invopop.com ya no es la web entregada.
type Esp = { escala: { px: number; n: number; uso: string }[]; base: number | null; seccion: number | null; contenedor: number | null };
const esp = (espaciado as Record<string, Esp>)[p.slug];
// RONDA 188 · «la paleta, que tenga más presencia»: en El sistema, a lo ancho de la retícula, un panel por color con su nombre, su valor y cuánto se
// usa; el ancho sigue al uso (con un mínimo para que todos se lean).
const usoEsp: Record<string, string> = en ? { relleno: 'padding', margen: 'margin', hueco: 'gap' } : { relleno: 'relleno', margen: 'margen', hueco: 'entre elementos' };
// el mosaico: el número de cada pieza corre por todas las filas
let nPieza = 0;
// OCTUBRE 2026 · Eric y Andoni: «los detalles los dejamos en 5» → luego, en 3. Se cortan por orden; si la última fila queda a medias, cambia de forma (1 → ancha, 2 → pareja)
const MAX_DETALLES = 3; // Andoni: «en detalles dejamos solo 3» (antes 5)
const filas = (p.mosaico ?? [])
  .map((fila) => ({ ...fila, p: fila.p.filter(() => nPieza < MAX_DETALLES && ++nPieza > 0).map((z, k, a) => ({ ...z, i: nPieza - a.length + k + 1 })) }))
  .filter((fila) => fila.p.length > 0)
  .map((fila, k, todas) => {
    const original = (p.mosaico ?? [])[k]?.p.length ?? fila.p.length;
    if (fila.p.length === original) return fila;
    return { ...fila, f: (fila.p.length === 1 ? 'ancha' : 'par') as typeof fila.f };
  });

// MOVIMIENTO EN ABSTRACTO (Andoni: «los detalles de motion, como una abstracción, como hace Dropbox»: brand.dropbox.com/motion › «Motion Principles» son
// cartas de un color plano con dos o tres formas que repiten el gesto). Cada detalle del caso se clasifica por lo que cuenta (en castellano, del original) y
// se dibuja su gesto con formas en colores de SU paleta. Tres por caso, repartidos entre todos los casos (src/lib/gestos.ts).
const piezasL = (p.mosaico ?? []).flatMap((f) => f.p);
const gestos = gestosDe(p.slug).map(({ i, g }) => ({ z: piezasL[i], g })).filter((x) => x.z);
// las formas: sobre el color de la carta, los dos de su paleta que más contrastan con él
const formas = (bg: string) => { const o = (p.paleta ?? []).map((c) => c.hex).filter((h) => h !== bg).sort((a, b) => contraste(b, bg) - contraste(a, bg)); return [o[0] ?? '#fff', o[1] ?? o[0] ?? '#fff']; };
// el muelle (atraca): seis canales en un arco alrededor de la API
const ARCO = [-165, -135, -105, -75, -45, -15].map((a) => [Math.cos((a * Math.PI) / 180) * 36, Math.sin((a * Math.PI) / 180) * 36]);
// EL ESPACIADO APLICADO (Andoni: «mostrarlo de manera más animada y cómo aplica»): un esquema de su página a escala (1440 px de ancho → el de la columna),
// con el contenedor, dos secciones separadas por SU aire entre secciones, tres tarjetas con SU hueco y SU relleno; cada medida se enciende por turnos
const masUsado = (uso: string) => (esp?.escala ?? []).filter((e) => e.uso === uso).sort((a, b) => b.n - a.n)[0]?.px;
const espRel = esp ? (masUsado('relleno') ?? 24) : 24, espHue = esp ? (masUsado('hueco') ?? masUsado('margen') ?? 16) : 16;
const espSec = esp?.seccion ?? 96, espCont = esp?.contenedor ?? 1280;
const espTipo = (e: { px: number; uso: string }) => (e.px === espRel && e.uso === 'relleno' ? 'relleno' : e.px === espHue && e.uso !== 'relleno' ? 'hueco' : '');
// EL SONIDO (Andoni: «si la web lo tiene, que se pueda ver un ejemplo de los sonidos»): sus tonos, tal cual están en su código, y su forma de onda calculada
// aquí (la suma de las ondas cuadradas con su envolvente, en 32 ms): por columna, el pico de la señal
const DUR_SON = 0.032;
type Capa = NonNullable<Proyecto['sonidos']>[number]['capas'][number];
// la señal, muestreada a 48 kHz: el ruido (pseudoaleatorio con semilla, para que el dibujo sea siempre el mismo) por un paso banda RBJ, y el seno con su caída
const ondaDe = (capas: Capa[]) => {
  const SR = 48000, n = Math.round(SR * DUR_SON), x = new Float32Array(n);
  let sem = 7;
  const azar = () => ((sem = (sem * 16807) % 2147483647) / 2147483647) * 2 - 1;
  const env = (t: number, ataque: number, dur: number, pico: number) => (t < 0 || t > dur ? 0 : t < ataque ? (pico * t) / ataque : pico * Math.exp((Math.log(0.0001 / pico) * (t - ataque)) / (dur - ataque)));
  for (const c of capas) {
    if (c.c === 'ruido') {
      const w = (2 * Math.PI * c.f) / SR, al = Math.sin(w) / (2 * c.q), a0 = 1 + al, b0 = al / a0, a1 = (-2 * Math.cos(w)) / a0, a2 = (1 - al) / a0;
      let x1 = 0, x2 = 0, y1 = 0, y2 = 0;
      for (let i = 0; i < n; i++) { const r = azar(), y = b0 * r - b0 * x2 - a1 * y1 - a2 * y2; x2 = x1; x1 = r; y2 = y1; y1 = y; x[i] += y * env(i / SR, 0.0005, c.dur, c.pico); }
    } else {
      let fase = 0;
      for (let i = 0; i < n; i++) { const t = i / SR, f = c.f * Math.pow(c.fin / c.f, Math.min(1, t / 0.044)); fase += (2 * Math.PI * f) / SR; x[i] += Math.sin(fase) * env(t, c.ataque, c.dur, c.pico); }
    }
  }
  const N = 160, por = Math.ceil(n / N), picos: number[] = [];
  for (let k = 0; k < N; k++) { let m = 0; for (let i = k * por; i < Math.min(n, (k + 1) * por); i++) m = Math.max(m, Math.abs(x[i])); picos.push(m); }
  const mx = Math.max(...picos, 1e-6);
  return picos.map((v) => v / mx);
};
const etiquetaCapa = (c: Capa) => {
  const hz = (v: number) => `${v.toLocaleString(en ? 'en' : 'es')} Hz`, ms = `${Math.round(c.dur * 1000 * 10) / 10} ms`;
  return c.c === 'ruido' ? (en ? `Noise in the ${hz(c.f)} band, ${ms}` : `Ruido en la banda de ${hz(c.f)}, ${ms}`) : (en ? `Sine from ${hz(c.f)} to ${hz(c.fin)}, ${ms}` : `Seno de ${hz(c.f)} a ${hz(c.fin)}, ${ms}`);
};
const sonidos = (p.sonidos ?? []).map((so) => ({ ...so, onda: ondaDe(so.capas) }));
const textoSonido = p.apartados.find((x) => /sonido|sound/i.test(x.titulo))?.texto[0];
// LA LIBRERÍA que entregamos (solo donde la hay publicada: hoy, Neety)
// RONDA 307, 22.ª · Andoni: «de momento fuera la librería en Neety» (vuelve cambiando esta línea por p.libreria)
// 28/10 · Eric: «La entrega» vuelve, con su texto (libreria.texto), para enseñar la librería y lo útil que es para ellos
// 28/10 · Eric: «la librería con el libro también quitamos»: «La entrega» fuera otra vez (vuelve cambiando esta línea por p.libreria)
const lib = undefined as Proyecto['libreria'];

// RONDA 188 · Andoni: «este detalle se sale de las guías; tiene que estar dentro y verse sin cortar». Nada va a sangre: la fila «sangre» ocupa las 12
// columnas, como la ancha, a la proporción real de su vídeo. Y en las parejas y tríos ninguna pieza se recorta: la que no lleva placa se pone ENTERA
// sobre el color de su web (antes llenaba su hueco y perdía los lados).
// octubre 2026 · Andoni: «los gradientes de los detalles, lo más parecidos posible a los del hero»: la placa decide SI va sobre fondo de marca, pero el
// fondo es el MISMO de la carátula (Pieza › g-marca: base colores[0] y las dos manchas de colores[1] y [2])
// la carátula en la MESA (28/10): la pantalla del monitor en la lámina (Visor.astro › PANT) y cuánto se amplía; la grabación, la toma grande si la hay
const PANT = { x: 0.3903, y: 0.3696, w: 0.2178, h: 0.2104 }, ZP = 2.9; // Eric: «un poco menos de zoom, que se vea algo más de aire» (era 3,3 a 2:1)
const portadaVid = p.cubierta ?? p.portada;
// 28/10 · Eric: «y también la vista de mobile, que hay switcher»: con grabación en móvil, la carátula tiene también el MÓVIL de la mesa (la lámina `mesa-movil`
// de /proyectos, con su homografía: lib/mesa-movil.ts) y la cápsula de escena de /proyectos (mesa · móvil). Llega en la mesa
const MM = p.cubiertaMovil ? mesaMovil() : null;
const dePlaca = (z: { placa?: number }, f?: string) => (z.placa !== undefined ? p.paleta?.[z.placa]?.hex : f === 'ancha' || f === 'sangre' ? undefined : p.color);
