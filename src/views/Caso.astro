  .proceso li { display: grid; gap: calc(var(--spacing) * 2); align-content: start; } /* Eric (oct.): «muchas líneas horizontales»: fuera los filetes */
  /* ── LOS DETALLES (ronda 153): mosaico. Entre filas, la mitad del aire de un bloque; en cada fila, las piezas comparten el alto de su hueco
       (subrejilla: la fila de los huecos manda la que lleva proporción; la otra se estira) */
  .det-cab { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: calc(var(--spacing) * 3); margin-bottom: calc(var(--spacing) * 8); }
  .mosaico { display: grid; row-gap: clamp(2.5rem, 1.75rem + 2vw, 4rem); }
