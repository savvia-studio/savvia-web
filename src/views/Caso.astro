  .fg-imgs { display: grid; gap: calc(var(--spacing) * 4); padding: clamp(1.5rem, 1rem + 3vw, 4rem); border-radius: var(--radius-lg); background: radial-gradient(70% 60% at 72% 22% in oklab, var(--c2), transparent 72%), radial-gradient(55% 55% at 8% 96% in oklab, var(--c3), transparent 70%), var(--color); }
  .fg-trio .fg-imgs { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (width < 48rem) { .fg-trio .fg-imgs { grid-template-columns: minmax(0, 1fr); } }
  /* 28/10 · una lámina vertical (el look and feel): estrecha, para que no ocupe varias pantallas */
  .fg-alta .fg-imgs img { max-width: min(100%, 34rem); justify-self: center; }
  .fg-imgs img { display: block; width: 100%; height: auto; padding: 3px; border-radius: 6px; background: color-mix(in srgb, #fff 20%, transparent); -webkit-backdrop-filter: blur(20px) saturate(1.6); backdrop-filter: blur(20px) saturate(1.6); /* el cristal desenfoca el degradado: con el lienzo transparente, dentro queda el rosa (Eric: «mejor rosa») */ box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.32), 0 0 0 1px rgb(0 0 0 / 0.08), 0 28px 56px -24px rgb(20 12 6 / 0.5); }
  .valor { display: grid; gap: calc(var(--spacing) * 8) calc(var(--spacing) * 6); }
