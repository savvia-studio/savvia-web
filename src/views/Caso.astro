---
// RONDA 62 · CASO DE ESTUDIO (referencia: focuslab.agency/work/marketo). RONDA 63: en claro y con mucha más información.
// RONDA 64 (Andoni): «quitamos métricas en grande; más estilo agencia creativa: ir intercalando detalles de la web + detalles de la marca (colores
// puestos de forma animada, tipografía, etc.)». El caso alterna TEXTO y MARCA:
//   nombre · entradilla y ficha (las cifras, pequeñas, en la ficha) · portada · la frase · COLOR (bandas de su paleta que crecen al llegar) ·
//   un DETALLE de la web junto al reto · galería · TIPOGRAFÍA (su muestra, escrita en SU web con SU fuente, que se imprime al llegar) · la web sección
//   a sección · galería · apartados con otro DETALLE · galería · por dentro y lo descartado · la cita · el siguiente.
// Muestras (tipo-1, tipo-2): public/media/obra/<slug>/ (tools/r64-tipos.cjs).
// RONDA 152 · Andoni: «en case studies, no tanto aire y los textos con más consistencia de tamaño y orden; más chicha en cada sección; que cada
// imagen represente bien lo que se dice y muestre los entresijos de la web: que cada caso muestre cómo la hemos construido y los detalles más
// relevantes de una forma bonita». El caso, en este orden: nombre · entradilla y ficha · portada · el proyecto · el reto · CÓMO LA CONSTRUIMOS
// (el proceso, paso a paso) · LOS DETALLES (cada pieza de la web, de cerca, con su vídeo grabado en la web real y el texto que cuenta cómo está
// hecha: tools/r152/) · apartados · el sistema (color y tipografía) · sección a sección · por dentro · la cita · anterior y siguiente.
// RONDA 153 · «que la parte de detalles se presente más con imágenes, como casabien.com/proyectos/rebranding-identidad-hannun, y terminamos con una
// conclusión; en colores y typos, mostrar mejor tamaños y cómo se usan»: LOS DETALLES son un mosaico (ver proyectos.ts › Fila), EL SISTEMA enseña el
// uso medido de cada color, su contraste, la escala real y el botón (medidos en la web) y un ejemplo aplicado; y antes de la cita, la CONCLUSIÓN.
// UNA ESCALA de texto para todo el caso (.t-ojo · .t-enc · .t-h · .t-lead · .t-texto) y una retícula de TRES columnas: el título de cada bloque en
// la primera; el contenido en la segunda y la tercera, siempre arrancando arriba (nada empieza en una columna suelta). Menos aire: 64 → 104 px.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Carriles from '../components/Carriles.astro';
import Pie from '../components/Pie.astro';
import Cta from '../components/Cta.astro';
import Medio from '../components/obra/Medio.astro';
import Pieza from '../components/obra/Pieza.astro';
import { type Proyecto } from '../data/proyectos';
import { proyectoDe, servicio } from '../data/idioma';
import { langDe, ruta } from '../lib/i18n';
import espaciado from '../data/espaciado.json';

const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const props = Astro.props as { p: Proyecto; sig: Proyecto; ant: Proyecto };
// los datos llegan en castellano desde getStaticPaths: se resuelven en el idioma de la página
const p = proyectoDe(lang, props.p.slug) ?? props.p, sig = proyectoDe(lang, props.sig.slug) ?? props.sig, ant = proyectoDe(lang, props.ant.slug) ?? props.ant;
// RONDA 144 (3.ª) · «arriba hay demasiada información: la parte de la derecha, más sutil o reducida»: arriba solo servicios, sector y lugar, en una línea
// pequeña; las herramientas y las cifras bajan a «Por dentro»
const ficha = [
  [en ? 'Services' : 'Servicios', p.servicios.map((x) => servicio(lang, x)).join(' · ')],
  [en ? 'Sector' : 'Sector', p.sector ?? ''],
  [en ? 'Location' : 'Lugar', p.ubicacion ?? p.con ?? ''],
].filter(([, v]) => v) as [string, string][];
const cifras = (p.cifras ?? []).map((c) => `${c.v} ${c.t}`);
const luz = (hex: string) => { const n = parseInt(hex.slice(1), 16), r = n >> 16, gg = (n >> 8) & 255, b = n & 255; return (r * 299 + gg * 587 + b * 114) / 1000 > 150; };
// el fondo de las muestras tipográficas: el color más claro de su paleta (la tinta de la muestra es la suya)
const claroMarca = (p.paleta ?? []).map((c) => c.hex).find((h) => luz(h)) ?? '#FFFFFF';
import { flecha } from '../lib/flecha';
// RONDA 153 · el contraste WCAG entre dos colores (para «El sistema»: cada color sobre el fondo que más se usa)
const lum = (hex: string) => { const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4)); return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2]; };
const contraste = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };
const nivel = (r: number) => (r >= 7 ? 'AAA' : r >= 4.5 ? 'AA' : r >= 3 ? (en ? 'AA for large text' : 'AA en tamaño grande') : (en ? 'not for text' : 'no para texto'));
const coma = (n: number, d = 1) => (en ? n.toFixed(d).replace(/\.0$/, '') : n.toFixed(d).replace('.', ',').replace(/,0$/, ''));
const usados = [...(p.paleta ?? [])].sort((a, b) => (b.pct ?? 0) - (a.pct ?? 0));
const fondo = usados[0];
const pares = fondo ? usados.slice(1).map((c) => ({ c, r: contraste(c.hex, fondo.hex) })).sort((a, b) => b.r - a.r) : [];
const maxPx = Math.max(...(p.escala ?? []).map((e) => e.px), 1);
const aplicado = !!p.aplicado;
// RONDA 188 · el ESPACIADO medido en la web (tools/r188/espacios.cjs): los valores que más se usan, para qué, el paso base, el aire entre secciones
// y el contenedor. Invopop no lo tiene: invopop.com ya no es la web entregada.
type Esp = { escala: { px: number; n: number; uso: string }[]; base: number | null; seccion: number | null; contenedor: number | null };
const esp = (espaciado as Record<string, Esp>)[p.slug];
// RONDA 188 · «la paleta, que tenga más presencia»: en El sistema, a lo ancho de la retícula, un panel por color con su nombre, su valor y cuánto se
// usa; el ancho sigue al uso (con un mínimo para que todos se lean).
const usoEsp: Record<string, string> = en ? { relleno: 'padding', margen: 'margin', hueco: 'gap' } : { relleno: 'relleno', margen: 'margen', hueco: 'entre elementos' };
// el mosaico: el número de cada pieza corre por todas las filas
let nPieza = 0;
const filas = (p.mosaico ?? []).map((fila) => ({ ...fila, p: fila.p.map((z) => ({ ...z, i: ++nPieza })) }));
// RONDA 188 · Andoni: «este detalle se sale de las guías; tiene que estar dentro y verse sin cortar». Nada va a sangre: la fila «sangre» ocupa las 12
// columnas, como la ancha, a la proporción real de su vídeo. Y en las parejas y tríos ninguna pieza se recorta: la que no lleva placa se pone ENTERA
// sobre el color de su web (antes llenaba su hueco y perdía los lados).
const dePlaca = (z: { placa?: number }, f?: string) => (z.placa !== undefined ? p.paleta?.[z.placa]?.hex : f === 'ancha' || f === 'sangre' ? undefined : p.color);
---

<Base title={`${p.nombre} — savvia`} description={p.resumen} carga={false}>
  <script is:inline>document.documentElement.classList.add('pz-js');</script>
  <Nav />
  <Carriles />
  <main id="contenido" class="caso surface-light" style={`--claro-marca:${claroMarca}`}>
    <header class="wrap cabecera">
      <Cta href={ruta(lang, '/proyectos')} class="volver text-fg2" variante="secundario" tam="sm" flecha="izq">{en ? 'Projects' : 'Proyectos'}</Cta>
      <h1 class="font-display nombre" data-entra>{p.nombre}{p.frase && <span class="idea">{p.frase}</span>}</h1>
    </header>

    <section class="wrap rej intro" aria-label={en ? 'The project in one line' : 'El proyecto en una línea'}>
      <p class="t-lead c12" data-enfoca>{p.entradilla}</p>
      <dl class="ficha c-todo" data-enfoca>
        {ficha.map(([k, v]) => (<div><dt class="t-ojo">{k}</dt><dd>{v}</dd></div>))}
        {p.url && <div class="ver-w"><Cta href={p.url} variante="secundario" tam="sm" externo>{en ? 'Visit the site' : 'Ver la web'}</Cta></div>}
      </dl>
    </section>

    <!-- RONDA 154 · LA CARÁTULA: la pieza del portfolio (su degradado y su web saliendo desde abajo), a lo grande -->
    <div class="wrap portada">
      <Pieza p={p} tipo={p.portada.movil ? 'telefono' : 'mancha'} grande transicion />
    </div>

    {
      p.contexto.length > 0 && (
        <section class="wrap rej bloque" aria-labelledby="ctx-h">
          <h2 id="ctx-h" class="t-enc enc">{en ? 'The project' : 'El proyecto'}</h2>
          <div class="c23 dos">{p.contexto.map((t) => <p class="t-texto">{t}</p>)}</div>
        </section>
      )
    }

    <section class="wrap rej bloque" aria-labelledby="reto-h">
      <h2 id="reto-h" class="t-enc enc">{en ? 'The challenge' : 'El reto'}</h2>
      <p class="t-lead c23 medida">{p.reto}</p>
    </section>

    <!-- CÓMO LA CONSTRUIMOS: los pasos, numerados, en dos columnas que arrancan arriba a la vez -->
    {
      p.proceso && (
        <section class="wrap rej bloque" aria-labelledby="proc-h">
          <h2 id="proc-h" class="t-enc enc">{en ? 'How we built it' : 'Cómo la construimos'}</h2>
          <ol class="c23 proceso">
            {p.proceso.map((s, i) => (
              <li data-enfoca>
                <span class="t-ojo num">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="t-h">{s.n}</h3>
                <p class="t-texto">{s.d}</p>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- LOS DETALLES (ronda 153, referencia casabien · Hannun): un MOSAICO de imágenes en filas de tamaños distintos sobre la retícula de 12 —
         ancha · a sangre · 6 + 6 · 7 + 5 · 5 + 7 · 4 + 4 + 4—, cada pieza con su número, su título y una frase. Las webs van enteras sobre una
         placa de su color; los primeros planos llenan su hueco. -->
    {
      filas.length > 0 && (
        <section class="bloque detalles" aria-labelledby="det-h">
          <div class="wrap det-cab">
            <h2 id="det-h" class="t-enc">{en ? 'The details' : 'Los detalles'}</h2>
            {(p.nota ?? p.detalles?.[0]?.pie) && <p class="t-ojo">{p.nota ?? p.detalles?.[0]?.pie}</p>}
          </div>
          <div class="mosaico">
            {filas.map((fila) => (
              <div class={`fila f-${fila.f === 'sangre' ? 'ancha' : fila.f} wrap`}>
                {fila.p.map((z) => (
                  <figure class={`tesela ${dePlaca(z, fila.f) ? 'con-placa' : 'sin-placa'} ${z.medio.movil ? 'es-movil' : ''}`} data-vivo>
                    <div class="hueco">
                      <Medio
                        medio={z.medio}
                        color={p.color}
                        alt={en ? `${z.titulo}, on ${p.nombre}'s website` : `${z.titulo}, en la web de ${p.nombre}`}
                        proporcion={fila.f === 'ancha' || fila.f === 'sangre' ? (z.prop ?? '16 / 9') : 'auto'}
                        natural={z.prop ?? '16 / 9'}
                        placa={dePlaca(z, fila.f)}
                        pos={z.pos}
                        colores={p.colores}
                      />
                    </div>
                    <figcaption class="t-ojo pie">
                      <span class="num">{String(z.i).padStart(2, '0')}</span>
                      <span><span class="fuerte">{z.titulo}.</span> {z.pie}</span>
                    </figcaption>
                  </figure>
                ))}
              </div>
            ))}
          </div>
        </section>
      )
    }

    {
      p.apartados.map((a) => (
        <section class="wrap rej bloque" aria-label={a.titulo}>
          <h2 class="t-enc enc">{a.titulo}</h2>
          <div class={`c23 ${a.texto.length > 1 ? 'dos' : 'medida'}`}>{a.texto.map((t) => <p class="t-texto">{t}</p>)}</div>
        </section>
      ))
    }

    <!-- EL SISTEMA (ronda 153): el COLOR con cuánto se usa (medido), cada uno con su valor y su contraste sobre el fondo principal; la TIPOGRAFÍA
         con su muestra, su escala real (tamaño, interlineado, peso) y su botón, medidos en la web, y un ejemplo aplicado recortado de la propia web -->
    {
      (p.paleta || p.tipos || esp) && (
        <section class="wrap rej bloque sis" aria-labelledby="sis-h">
          <h2 id="sis-h" class="t-enc enc">{en ? 'The system' : 'El sistema'}</h2>
          {p.paleta && (
            <div class="paleta-grande" data-vivo role="img" aria-label={usados.map((c) => `${c.n} ${c.hex} ${coma(c.pct ?? 0)} %`).join(', ')}>
              {usados.map((c, i) => (
                <div class={`panel ${luz(c.hex) ? 'sobre-claro' : 'sobre-oscuro'}`} style={`--c:${c.hex};--g:${Math.max(c.pct ?? 0, 14)};--i:${i}`}>
                  <span class="pn">{c.n}</span>
                  <span class="pv">{c.hex}<br />{c.pct !== undefined ? (c.pct < 1 ? '< 1 %' : `${coma(c.pct)} %`) : ''}</span>
                </div>
              ))}
            </div>
          )}
          <div class="c23 sistema">
            {p.paleta && fondo && pares.length > 0 && (
              <div class="color">
                <p class="t-ojo sub">{en ? 'Contrast on' : 'Contraste sobre'} {fondo.n.toLowerCase()}</p>
                <ul class="pares-c">
                  {pares.map(({ c, r }) => (
                    <li>
                      <span class="aa" style={`--f:${fondo.hex};--t:${c.hex}`} aria-hidden="true">Aa</span>
                      <span class="t-texto fuerte">{coma(r, r >= 10 ? 0 : 1)}:1</span>
                      <span class="t-ojo">{c.n} · {nivel(r)}</span>
                    </li>
                  ))}
                </ul>
                <p class="t-ojo nota">{en ? 'Usage measured on recordings of the delivered site: every pixel counts towards the nearest colour; photos and gradients aside.' : 'Uso medido en las grabaciones de la web entregada: cada píxel cuenta para el color más cercano; fotos y degradados aparte.'}</p>
              </div>
            )}
            {p.tipos && (
              <div class="tipografia">
                <p class="t-ojo sub">{en ? 'Typography' : 'Tipografía'}</p>
                <div class={`tipos ${p.tipos.length > 1 ? 'f2' : ''}`}>
                  {p.tipos.slice(0, 2).map((t, i) => (
                    <figure class="muestra" data-vivo>
                      <div class="hoja"><img src={`/media/obra/${p.slug}/tipo-${i + 1}.png`} alt={en ? `${t.n} specimen` : `Muestra de ${t.n}`} loading="lazy" decoding="async" /></div>
                      <figcaption><span class="t-texto fuerte">{t.n}</span><span class="t-ojo">{t.uso}</span></figcaption>
                    </figure>
                  ))}
                </div>
                {p.escala && (
                  <>
                    <p class="t-ojo sub">{en ? 'Scale' : 'Escala'}</p>
                    <table class="escala" data-vivo>
                      <thead class="sr-only"><tr>{en ? <><th>Level</th><th>Family</th><th>Size and line height</th><th>Weight</th><th>Relative size</th></> : <><th>Nivel</th><th>Familia</th><th>Tamaño e interlineado</th><th>Peso</th><th>Tamaño relativo</th></>}</tr></thead>
                      <tbody>
                        {p.escala.map((e, i) => (
                          <tr style={`--w:${(e.px / maxPx) * 100}%;--i:${i}`}>
                            <th scope="row" class="t-texto fuerte">{e.n}</th>
                            <td class="t-ojo">{e.fam}</td>
                            <td class="t-ojo cifra">{coma(e.px)} px / {e.lh === 'normal' ? 'normal' : coma(e.lh)}</td>
                            <td class="t-ojo cifra">{e.peso}{e.ls ? ` · ${e.ls}` : ''}</td>
                            <td class="raya" aria-hidden="true"><span /></td>
                          </tr>
                        ))}
                        {p.boton && (
                          <tr class="fila-boton">
                            <th scope="row" class="t-texto fuerte">{en ? 'Button' : 'Botón'}</th>
                            <td class="t-ojo">{p.boton.fam}</td>
                            <td class="t-ojo cifra">{coma(p.boton.px)} px · {p.boton.alto} px {en ? 'tall' : 'de alto'}</td>
                            <td class="t-ojo cifra">{p.boton.peso} · {en ? 'radius' : 'radio'} {p.boton.radio >= 999 ? (en ? 'pill' : 'píldora') : `${p.boton.radio} px`}</td>
                            <td class="muestra-boton" aria-hidden="true">
                              <span style={`--b:${p.boton.fondo};--bt:${p.boton.tinta};--br:${Math.min(p.boton.radio, 99)}px;--bh:${p.boton.alto}px${p.boton.nota ? ';opacity:.75' : ''}`}>{p.boton.nota ?? p.boton.fondo}</span>
                            </td>
                          </tr>
                        )}
                      </tbody>
                    </table>
                  </>
                )}
                {aplicado && (
                  <figure class="aplicado" data-vivo>
                    <div class="lamina"><img src={`/media/obra/${p.slug}/aplicado.webp`} alt={en ? `Headline, text and button from ${p.nombre}'s website, in its typography` : `Titular, texto y botón de la web de ${p.nombre}, con su tipografía`} loading="lazy" decoding="async" /></div>
                    <figcaption class="t-ojo">{en ? 'Applied: headline, text and button, cropped from its site in its own typography.' : 'Aplicado: titular, texto y botón, recortados de su web con su tipografía.'}</figcaption>
                  </figure>
                )}
                {p.medido && <p class="t-ojo nota">{p.medido}.</p>}
              </div>
            )}
            {esp && (
              <div class="espaciado" data-vivo>
                <p class="t-ojo sub">{en ? 'Spacing' : 'Espaciado'}</p>
                <dl class="claves">
                  <div><dt class="t-ojo">{en ? 'Base step' : 'Paso base'}</dt><dd class="cifra">{esp.base ? `${esp.base} px` : (en ? 'Fluid' : 'Fluido')}</dd></div>
                  {esp.seccion && <div><dt class="t-ojo">{en ? 'Between sections' : 'Entre secciones'}</dt><dd class="cifra">{esp.seccion} px</dd></div>}
                  {esp.contenedor && <div><dt class="t-ojo">{en ? 'Container' : 'Contenedor'}</dt><dd class="cifra">{esp.contenedor} px</dd></div>}
                </dl>
                <ol class="pasos">
                  {esp.escala.map((e, i) => (
                    <li style={`--px:${e.px};--i:${i}`}>
                      <span class="t-texto fuerte cifra">{e.px}</span>
                      <span class="caja" aria-hidden="true"><span /></span>
                      <span class="t-ojo">{usoEsp[e.uso] ?? e.uso} · {e.n} {en ? 'times' : 'veces'}</span>
                    </li>
                  ))}
                </ol>
                <p class="t-ojo nota">{en
                  ? `The paddings, margins and gaps that repeat most on the delivered site, at 1440 px and true scale${esp.base ? `; almost all fall on ${esp.base} px steps` : '; fluid sizes (they change with the window width), with no fixed step'}.`
                  : `Los rellenos, márgenes y huecos que más se repiten en la web entregada, a 1440 px y a escala real${esp.base ? `; casi todos caen en pasos de ${esp.base} px` : '; tamaños fluidos (cambian con el ancho de la ventana), sin un paso fijo'}.`}</p>
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      p.secciones && (
        <section class="wrap rej bloque" aria-labelledby="secc-h">
          <h2 id="secc-h" class="t-enc enc">{en ? 'The site, section by section' : 'La web, sección a sección'}</h2>
          <ol class="c23 secciones">
            {p.secciones.map((s, i) => (
              <li>
                <span class="t-ojo num">{String(i + 1).padStart(2, '0')}</span>
                <span class="t-texto fuerte">{s.n}</span>
                <span class="t-texto sd">{s.d}</span>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="wrap rej bloque" aria-labelledby="dentro-h">
      <h2 id="dentro-h" class="t-enc enc">{en ? 'Under the hood' : 'Por dentro'}</h2>
      <div class="c2">
        {p.stack && p.stack.length > 0 && (<><p class="t-ojo sub">{en ? 'Tools' : 'Herramientas'}</p><ul class="lista">{p.stack.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
        {p.tecnica && (<><p class="t-ojo sub">{en ? 'How it is built' : 'Cómo está hecha'}</p><ul class="lista">{p.tecnica.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
      </div>
      <div class="c3">
        {cifras.length > 0 && (<><p class="t-ojo sub">{en ? 'In numbers' : 'En cifras'}</p><ul class="lista">{cifras.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
        {p.descartado && (<><p class="t-ojo sub">{en ? 'What we dropped' : 'Lo que se descartó'}</p><ul class="lista tachada">{p.descartado.map((t) => <li class="t-texto">{t}</li>)}</ul></>)}
      </div>
    </section>

    <!-- CONCLUSIÓN (ronda 153): lo que consiguió la web y cómo trabaja el cliente con ella; solo hechos -->
    {
      p.conclusion && p.conclusion.length > 0 && (
        <section class="wrap rej bloque" aria-labelledby="concl-h">
          <h2 id="concl-h" class="t-enc enc">{en ? 'Conclusion' : 'Conclusión'}</h2>
          <div class="c23 conclusion">
            <p class="t-lead">{p.conclusion[0]}</p>
            {p.conclusion.slice(1).map((t) => <p class="t-texto">{t}</p>)}
          </div>
        </section>
      )
    }

    {
      p.cita && (
        <section class="wrap rej bloque" aria-label={en ? 'What the client says' : 'Lo que cuenta el cliente'}>
          <h2 class="t-enc enc">{en ? 'In their words' : 'Lo que cuentan'}</h2>
          <figure class="cita c23">
            <blockquote class="t-lead font-display">{en ? '“' : '«'}{p.cita.texto}{en ? '”' : '»'}</blockquote>
            <figcaption><span class="t-texto fuerte">{p.cita.autor}</span><span class="t-ojo">{p.cita.rol}</span></figcaption>
            {p.cita.video && (
              <a class="btn-primary btn-sm con-video" href={p.cita.video} target="_blank" rel="noopener">
