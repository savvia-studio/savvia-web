              </a>
            )}
          </figure>
        </section>
      )
    }

    <div class="wrap"><nav class="pares" aria-label={en ? 'Previous and next project' : 'Proyecto anterior y siguiente'}>
      <a data-liquido class="par antes" href={ruta(lang, `/proyectos/${ant.slug}`)}>
        <span class="pd t-ojo"><Fragment set:html={flecha('izq')} />{en ? 'Previous' : 'Anterior'}</span>
        <span class="pt">{ant.nombre}</span>
      </a>
