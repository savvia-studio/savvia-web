  .tf-escala { margin-top: calc(var(--spacing) * 8); }
  .tf-escala { container-type: inline-size; }
  /* una fila por tamaño: nombre y medida arriba, la muestra debajo a todo el ancho y en una línea (si no cabe a su tamaño, baja lo justo) */
  .tf-escala li { display: grid; grid-template-columns: calc(var(--spacing) * 20) minmax(0, 1fr) auto; align-items: baseline; gap: calc(var(--spacing) * 4); padding-block: calc(var(--spacing) * 3); border-bottom: 1px solid var(--rule); }
  .tf-escala .tf-m { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* 28/10 · responsive: en móvil la muestra se quedaba en «A qui…» entre el nombre y la medida; ahora va debajo, a todo el ancho, y encoge lo justo
     para caber entera (--ch = letras de la frase; 0,56 em por letra, de sobra para Bricolage); las frases largas de texto, a su tamaño y en dos líneas */
  @media (width < 48rem) {
    .tf-fams { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--spacing) * 3); }
    .tf-fam { aspect-ratio: auto; place-items: stretch; gap: calc(var(--spacing) * 6); padding: calc(var(--spacing) * 8) calc(var(--spacing) * 3) calc(var(--spacing) * 3); }
    .tf-aa { font-size: 2.5rem; translate: none; text-align: center; }
    .tf-fam figcaption { position: static; align-self: end; }
    .tf-escala li { grid-template-columns: minmax(0, 1fr) auto; row-gap: calc(var(--spacing) * 1); }
    .tf-escala .tf-m { grid-column: 1 / -1; grid-row: 2; white-space: normal; }
    /* 29/10 · Eric: «escálalo un poco más para que esté algo más pequeño en mobile»: los titulares, al 72 % (y así XL, L y M ya no empatan al ancho) */
    .tf-escala .tf-m[data-corta] { white-space: nowrap; font-size: min(var(--fs) * 0.72, 100cqi / (var(--ch) * 0.56)) !important; }
  }
  /* 30/10 (pulido exhaustivo, Nilo) · entre 48 y 72 rem (1024 px) la columna de la muestra no daba para «Large» y «Medium» en una línea y se cortaban con «…»: en dos líneas */
  @media (width >= 48rem) and (width < 72rem) { .tf-escala .tf-m { white-space: normal; text-overflow: clip; } }
  .tf-n, .tf-d { color: var(--fg2); }
  .tf-m { line-height: 1.1; text-wrap: balance; min-width: 0; }
  .tipo-cartas { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: calc(var(--spacing) * 6); }
  .carta { position: relative; margin: 0; display: grid; place-items: center; overflow: hidden; border-radius: calc(var(--spacing) * 2); background: var(--fondo); padding: calc(var(--spacing) * 16) calc(var(--spacing) * 8) calc(var(--spacing) * 8); }
  /* Andoni: «la parte de typo, algo más animada»: cada carta entra descubriéndose de abajo arriba (escalonadas), la muestra sube desde el desenfoque y la
     píldora llega después; quietas, la muestra flota muy despacio y sigue al puntero (paralaje, --px/--py del JS) */
  .carta img { width: 100%; height: auto; max-height: 100%; object-fit: contain; translate: var(--px, 0) var(--py, 0); transition: translate 0.9s var(--ease-out-expo), scale 1.2s var(--ease-out-expo); }
  .carta:hover img { scale: 1.04; }
  :global(html.anima) .carta { clip-path: inset(100% 0 0 0 round calc(var(--spacing) * 2)); }
  :global(html.anima) .carta img { opacity: 0; filter: blur(12px); transform: translateY(14%); }
  :global(html.anima) .carta .rotulo { opacity: 0; transform: translateX(-12px); }
  :global(html.anima) .tipo-cartas.visto .carta { clip-path: inset(0 0 0 0 round calc(var(--spacing) * 2)); transition: clip-path 1.2s var(--ease-out-expo) calc(var(--k, 0) * 140ms); }
  :global(html.anima) .tipo-cartas.visto .carta img { opacity: 1; filter: none; transform: none; transition: opacity 0.9s ease calc(0.25s + var(--k, 0) * 140ms), filter 1.1s ease calc(0.25s + var(--k, 0) * 140ms), transform 1.4s var(--ease-out-expo) calc(0.25s + var(--k, 0) * 140ms), translate 0.9s var(--ease-out-expo), scale 1.2s var(--ease-out-expo); animation: flota 7s ease-in-out calc(1.6s + var(--k, 0) * 0.9s) infinite alternate; }
  :global(html.anima) .tipo-cartas.visto .carta .rotulo { opacity: 1; transform: none; transition: opacity 0.6s ease calc(0.7s + var(--k, 0) * 140ms), transform 0.9s var(--ease-out-expo) calc(0.7s + var(--k, 0) * 140ms); }
  @keyframes flota { from { transform: translateY(0); } to { transform: translateY(-1.6%); } }
  .carta.aplicada { padding: calc(var(--spacing) * 16) 0 0 calc(var(--spacing) * 8); place-items: end; }
  .carta.aplicada img { border-radius: calc(var(--spacing) * 2) 0 0 0; box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08); }
  /* Eric (oct.): «las pills no me gustan»: el rótulo, texto suelto en la esquina */
  .rotulo {
    position: absolute;
    left: calc(var(--spacing) * 6);
    top: calc(var(--spacing) * 6);
    z-index: 1;
    color: #241c19;
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .n3 .carta:nth-child(1) { grid-column: 1 / span 7; grid-row: span 2; aspect-ratio: 4 / 4.2; }
  .n3 .carta:nth-child(2), .n3 .carta:nth-child(3) { grid-column: 8 / -1; }
  .n2 .carta { grid-column: span 6; aspect-ratio: 4 / 3; }
  .n1 .carta { grid-column: 1 / -1; aspect-ratio: 16 / 7; }
  @media (width < 64rem) { .tipo-cartas .carta { grid-column: 1 / -1 !important; grid-row: auto !important; aspect-ratio: 4 / 3 !important; } }
  /* MOVIMIENTO (brand.dropbox.com/motion): la grabación en un lienzo con guías y, debajo, una línea de tiempo con pistas en su paleta; el cabezal sigue
     al vídeo y se arrastra para recorrerlo */
  .motion { border: 1px solid var(--rule); }
  .mo-lienzo { position: relative; padding: clamp(1.5rem, 5vw, 4.5rem); background-image: linear-gradient(var(--rule) 1px, transparent 1px), linear-gradient(90deg, var(--rule) 1px, transparent 1px); background-size: calc(100% / 12) calc(100% / 6); background-position: -1px -1px; }
  .mo-lienzo video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 0; outline: 1px solid color-mix(in oklab, #3a6bff 70%, transparent); outline-offset: 6px; background: var(--c1); }
  .mo-linea { position: relative; display: grid; gap: 6px; padding: calc(var(--spacing) * 5) 0; border-top: 1px solid var(--rule); cursor: ew-resize; touch-action: none; outline: none; }
  .mo-linea:focus-visible { box-shadow: inset 0 0 0 2px var(--fg2); }
  .pista { position: relative; height: 14px; }
  .pista i { position: absolute; top: 0; bottom: 0; left: calc(var(--a) * 1%); width: calc((var(--b) - var(--a)) * 1%); border-radius: 3px; background: var(--c1); opacity: 0.85; }
  .pista:nth-child(2n) i { background: var(--c2); }
  .pista:nth-child(3n) i { background: var(--c3); }
  .pista i::before, .pista i::after { content: ''; position: absolute; top: 50%; width: 7px; height: 7px; translate: -50% -50%; rotate: 45deg; background: color-mix(in oklab, #3a6bff 55%, white); }
  .pista i::before { left: 0; }
  .pista i::after { left: 100%; }
  .cabezal { position: absolute; top: 0; bottom: 0; left: calc(var(--t, 0) * 1%); width: 1px; background: #3a6bff; pointer-events: none; }
  .cabezal::before { content: ''; position: absolute; top: 0; left: 50%; translate: -50% 0; border: 6px solid transparent; border-top: 8px solid #3a6bff; }
  .mo-pie { display: flex; align-items: center; gap: 6px; padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4); border-top: 1px solid var(--rule); font-family: var(--font-mono, ui-monospace, monospace); }
  .mo-fps { margin-left: auto; }
  /* ICONOGRAFÍA (brand.dropbox.com/iconography): una rejilla de celdas con filetes, el icono al centro y su nombre debajo */
  .iconos { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .iconos li { display: grid; place-items: center; gap: calc(var(--spacing) * 3); aspect-ratio: 1; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .iconos img { width: 40%; height: auto; transition: scale 0.6s var(--ease-out-expo); }
  .iconos li:hover img { scale: 1.12; }

  /* la flecha de la casa (lib/flecha.ts: el chevrón que se dibuja líquido al pasar), a la escala del nombre. Andoni: «al hacer hover no se subraya el texto, y la
     animación de la flecha mucho más orgánica»: sin subrayado; al pasar, la flecha AVANZA con el muelle de la paleta de Dropbox (se pasa un poco y vuelve) mientras
     se dibuja, y el nombre la acompaña un pelo */
  .sigue-n { display: inline-flex; align-items: center; gap: 0.2em; text-decoration: none !important; }
  /* RONDA (oct.) · Andoni: «la animación de la flecha debería crearse de manera fluida, como el navbar». La rejilla de la barra se funde en una gota con un
     filtro gooey; aquí lo mismo: al pasar, las alas se RECOGEN en el vértice (la gota se hincha y se las traga, todo una masa por el filtro) y vuelven a
     BROTAR de ella con una gotita en cada punta que tira del trazo. Sin muelle ni salto: el nombre y la flecha avanzan con ease-out expo. */
  .goo-def { position: absolute; width: 0; height: 0; }
  .sigue-n > span { transition: translate 0.9s var(--ease-out-expo); }
  .sigue-n :global(.btn-flecha) { width: 0.5em; height: 0.5em; stroke-width: 0.9; transition: translate 0.9s var(--ease-out-expo); }
  .sigue-n :global(.btn-flecha .fl) { filter: url(#goo-sigue); }
  .sigue-n:is(:hover, :focus-visible) > span { translate: 0.03em 0; }
  .sigue-n:is(:hover, :focus-visible) :global(.btn-flecha) { translate: 0.16em 0; }
  .sigue-n:is(:hover, :focus-visible) :global(.btn-flecha .fl-ala) { animation: sg-ala 0.95s cubic-bezier(0.65, 0, 0.35, 1) both !important; }
  .sigue-n:is(:hover, :focus-visible) :global(.btn-flecha .fl-v) { animation: sg-v 0.95s cubic-bezier(0.65, 0, 0.35, 1) both !important; }
  .sigue-n:is(:hover, :focus-visible) :global(.btn-flecha .fl-a) { animation: sg-a 0.95s cubic-bezier(0.65, 0, 0.35, 1) both !important; }
  .sigue-n:is(:hover, :focus-visible) :global(.btn-flecha .fl-b) { animation: sg-b 0.95s cubic-bezier(0.65, 0, 0.35, 1) both !important; }
  @keyframes sg-ala { 0% { stroke-dashoffset: 0; } 30% { stroke-dashoffset: 1; } 38% { stroke-dashoffset: 1; } 100% { stroke-dashoffset: 0; } }
  @keyframes sg-v { 0% { opacity: 1; transform: scale(0.45); } 30% { opacity: 1; transform: scale(1.35); } 44% { opacity: 1; transform: scale(1.2); } 100% { opacity: 1; transform: scale(0.47); } }
  @keyframes sg-a { 0%, 36% { opacity: 0; transform: translate(0, 0) scale(0.9); } 38% { opacity: 1; } 92% { opacity: 1; transform: translate(-4.5px, -4.5px) scale(0.62); } 100% { opacity: 0; transform: translate(-4.5px, -4.5px) scale(0.5); } }
  @keyframes sg-b { 0%, 36% { opacity: 0; transform: translate(0, 0) scale(0.9); } 38% { opacity: 1; } 92% { opacity: 1; transform: translate(-4.5px, 4.5px) scale(0.62); } 100% { opacity: 0; transform: translate(-4.5px, 4.5px) scale(0.5); } }
  .sigue-n :global(.btn-flecha path) { vector-effect: none; }
  /* MOVIMIENTO EN ABSTRACTO (brand.dropbox.com/motion › Motion Principles): cada carta, un color plano de su paleta y dos o tres formas que repiten el gesto
     del detalle. Las formas, en los dos colores de su paleta que más contrastan con la carta. Solo se mueven a la vista (.corre). */
  .mo-ejemplos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--spacing) * 12) calc(var(--spacing) * 6); margin-top: calc(var(--spacing) * 16); }
  .mo-ej h3 { margin-top: calc(var(--spacing) * 5); }
  .mo-ej p { margin-top: calc(var(--spacing) * 2); max-width: 32rem; }
  @media (width < 48rem) { .mo-ejemplos { grid-template-columns: minmax(0, 1fr); } }
  .abs { --e: cubic-bezier(0.65, 0, 0.35, 1); position: relative; aspect-ratio: 4 / 3; border-radius: calc(var(--spacing) * 2); background: var(--fondo); overflow: hidden; }
  .abs > :is(i, b, em) { position: absolute; display: block; }
  .mo-ej:not(.corre) .abs :is(*, ::before, ::after) { animation-play-state: paused !important; }
  :global(html.anima) .mo-ej .abs { clip-path: inset(100% 0 0 0 round calc(var(--spacing) * 2)); }
  :global(html.anima) .mo-ej.visto .abs { clip-path: inset(0 0 0 0 round calc(var(--spacing) * 2)); transition: clip-path 1.2s var(--ease-out-expo); }
  /* bucle · las tarjetas pasan; la del centro, nítida y en su color */
  .g-bucle i { width: 22%; height: 30%; top: 35%; left: 129%; border-radius: 999px; background: var(--fb); animation: ab-bucle 7.5s var(--e) infinite; animation-delay: calc(var(--k) * -1.5s); }
  @keyframes ab-bucle {
    0% { left: 129%; scale: 0.78; filter: blur(3px); opacity: 0.55; background: var(--fb); }
    14%, 20% { left: 99%; scale: 0.78; filter: blur(3px); opacity: 0.55; background: var(--fb); }
    34%, 40% { left: 69%; scale: 0.78; filter: blur(3px); opacity: 0.55; background: var(--fb); }
    54%, 60% { left: 39%; scale: 1; filter: blur(0); opacity: 1; background: var(--fa); }
    74%, 80% { left: 9%; scale: 0.78; filter: blur(3px); opacity: 0.55; background: var(--fb); }
    94%, 100% { left: -21%; scale: 0.78; filter: blur(3px); opacity: 0.55; background: var(--fb); }
  }
  /* pestañas · el indicador salta de una a otra y el panel cambia de forma */
  .g-pestanas .tab { top: 14%; height: 7%; width: 16%; left: calc(14% + var(--k) * 18.5%); border-radius: 999px; background: var(--fb); opacity: 0.4; }
  .g-pestanas .ind { top: 24%; height: 2.5%; width: 16%; left: 14%; border-radius: 999px; background: var(--fa); animation: ab-ind 6s var(--e) infinite; }
  .g-pestanas .pan { left: 14%; right: 14.5%; top: 34%; bottom: 16%; border-radius: 6% / 8%; background: color-mix(in oklab, var(--fb) 28%, transparent); }
  .g-pestanas .pan u { position: absolute; top: 18%; bottom: 18%; left: 10%; width: 30%; border-radius: 999px; background: var(--fa); animation: ab-panel 6s var(--e) infinite; }
  @keyframes ab-ind { 0%, 20% { left: 14%; } 25%, 45% { left: 32.5%; } 50%, 70% { left: 51%; } 75%, 95% { left: 69.5%; } 100% { left: 14%; } }
  @keyframes ab-panel {
    0%, 20% { left: 10%; width: 30%; border-radius: 999px; }
    25%, 45% { left: 55%; width: 35%; border-radius: 14px; }
    50%, 70% { left: 10%; width: 80%; border-radius: 8px; }
    75%, 95% { left: 38%; width: 24%; border-radius: 50%; }
    100% { left: 10%; width: 30%; border-radius: 999px; }
  }
  /* cuenta · las cifras suben hasta su valor, se pasan un pelo y se asientan */
  .g-cuenta::after { content: ''; position: absolute; left: 16%; right: 16%; bottom: 18%; height: 2px; background: var(--fb); opacity: 0.5; }
  .g-cuenta i { bottom: 18%; height: 60%; width: 12%; left: calc(22% + var(--k) * 15%); border-radius: 6px 6px 2px 2px; background: var(--fa); transform-origin: bottom; animation: ab-cuenta 4.2s cubic-bezier(0.3, 1.25, 0.5, 1) infinite; animation-delay: calc(var(--k) * 0.12s); }
  .g-cuenta i:nth-child(2n) { background: var(--fb); }
  @keyframes ab-cuenta { 0% { scale: 1 0.02; } 30%, 75% { scale: 1 var(--h); } 92%, 100% { scale: 1 0.02; } }
  /* cae · las piezas caen con gravedad, rebotan y se apilan */
  .g-cae i { left: 30%; width: 40%; height: 12%; bottom: calc(14% + var(--k) * 13%); border-radius: 8px; background: var(--fa); opacity: 0; animation: ab-cae 5s infinite; animation-delay: calc(var(--k) * 0.35s); }
  .g-cae i:nth-child(2n) { background: var(--fb); }
  @keyframes ab-cae {
    0% { transform: translateY(-900%); opacity: 1; animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    14% { transform: translateY(0); opacity: 1; animation-timing-function: cubic-bezier(0.2, 0.8, 0.3, 1); }
    18% { transform: translateY(-16%); opacity: 1; animation-timing-function: cubic-bezier(0.55, 0, 1, 0.45); }
    22%, 80% { transform: translateY(0); opacity: 1; }
    92% { transform: translateY(-60%); opacity: 0; }
    100% { transform: translateY(-900%); opacity: 0; }
  }
  /* atraca · los canales esperan en un arco y uno a uno atracan en la API */
  .g-atraca .api { left: 42%; top: 56%; width: 16%; height: 21%; border-radius: 16%; background: var(--fa); animation: ab-api 1.2s var(--e) 1.15s infinite; }
  .g-atraca i { --l: calc(46.5% + var(--x)); --t: calc(61.8% + var(--y) * 1.3333); left: var(--l); top: var(--t); width: 7%; aspect-ratio: 1; border-radius: 50%; background: var(--fb); animation: ab-atraca 7.2s var(--e) infinite; animation-delay: calc(var(--k) * 1.2s); }
  @keyframes ab-atraca { 0%, 6% { left: var(--l); top: var(--t); scale: 1; } 16%, 22% { left: 46.5%; top: 61.8%; scale: 0.7; } 32%, 100% { left: var(--l); top: var(--t); scale: 1; } }
  @keyframes ab-api { 0%, 100% { scale: 1; } 12% { scale: 1.1; } }
  /* comprime · la masa se reduce a un punto mientras las lecturas bajan, y vuelve */
  .g-comprime .aro, .g-comprime .bola { left: 50%; top: 50%; aspect-ratio: 1; translate: -50% -50%; border-radius: 50%; }
  .g-comprime .aro { width: 56%; border: 1.5px dashed var(--fb); opacity: 0.6; }
  .g-comprime .bola { width: 54%; background: var(--fa); animation: ab-comp 5s var(--e) infinite; }
  .g-comprime em { left: 7%; top: calc(72% + var(--k) * 6%); width: 14%; height: 2.5%; border-radius: 999px; background: var(--fb); transform-origin: left; animation: ab-lect 5s var(--e) infinite; animation-delay: calc(var(--k) * 0.1s); }
  @keyframes ab-comp { 0%, 12% { scale: 1; } 50%, 70% { scale: 0.12; } 92%, 100% { scale: 1; } }
  @keyframes ab-lect { 0%, 12% { scale: 1 1; } 50%, 70% { scale: 0.25 1; } 92%, 100% { scale: 1 1; } }
  /* traza · primero el contorno, después el color */
  .g-traza svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .g-traza :is(rect, circle) { fill-opacity: 0; stroke-width: 1.4; stroke-dasharray: 1 1; stroke-linecap: round; animation: ab-traza 5s var(--e) infinite; }
  .g-traza rect { fill: var(--fa); stroke: var(--fa); }
  .g-traza circle { fill: var(--fb); stroke: var(--fb); animation-delay: 0.35s; }
  @keyframes ab-traza { 0% { stroke-dashoffset: 1; fill-opacity: 0; } 40% { stroke-dashoffset: 0; fill-opacity: 0; } 55%, 82% { stroke-dashoffset: 0; fill-opacity: 1; } 96%, 100% { stroke-dashoffset: -1; fill-opacity: 0; } }
  /* gira · las piezas dan la vuelta en ola */
  .g-gira i { width: 18%; aspect-ratio: 1; left: calc(19% + var(--c) * 22%); top: calc(22% + var(--r) * 32%); border-radius: 14%; background: var(--fa); animation: ab-gira 4.8s var(--e) infinite; animation-delay: calc((var(--c) + var(--r)) * 0.12s); }
  @keyframes ab-gira {
    0%, 20% { transform: perspective(400px) rotateY(0); background: var(--fa); }
    35% { transform: perspective(400px) rotateY(90deg); background: var(--fa); }
    35.1% { background: var(--fb); }
    50%, 70% { transform: perspective(400px) rotateY(180deg); background: var(--fb); }
    85% { transform: perspective(400px) rotateY(270deg); background: var(--fb); }
    85.1% { background: var(--fa); }
    100% { transform: perspective(400px) rotateY(360deg); background: var(--fa); }
  }
  /* filtra · la rejilla se queda con unos y aparta a los demás, por turnos */
  .g-filtra i { width: 6%; aspect-ratio: 1; left: calc(17% + var(--c) * 13.2%); top: calc(16% + var(--r) * 19%); border-radius: 50%; background: var(--fa); animation: ab-filtra 6s var(--e) infinite; animation-delay: calc(var(--g) * -2s); }
  @keyframes ab-filtra { 0%, 26% { scale: 1; opacity: 1; background: var(--fa); } 36%, 90% { scale: 0.45; opacity: 0.35; background: var(--fb); } 100% { scale: 1; opacity: 1; background: var(--fa); } }
  /* releva · una pantalla sube y se va; la siguiente ocupa su sitio */
  .g-releva i { left: 22%; width: 56%; height: 52%; top: 24%; border-radius: 6% / 8%; background: var(--fa); opacity: 0; animation: ab-releva 6s var(--e) infinite; animation-delay: calc(var(--k) * -2s); }
  .g-releva i:nth-child(2) { background: var(--fb); }
  .g-releva i:nth-child(3) { background: color-mix(in oklab, var(--fa) 55%, var(--fb)); }
  @keyframes ab-releva {
    0% { transform: translateY(26%) scale(0.86); opacity: 0; z-index: 1; }
    12%, 30% { transform: translateY(12%) scale(0.93); opacity: 0.55; z-index: 2; }
    45%, 63% { transform: none; opacity: 1; z-index: 3; }
    78% { transform: translateY(-70%) scale(1.02); opacity: 0; z-index: 3; }
    100% { transform: translateY(26%) scale(0.86); opacity: 0; z-index: 1; }
  }
  /* escribe · las líneas aparecen una tras otra, como el código que se escribe solo */
  .g-escribe i { left: 16%; top: calc(24% + var(--k) * 10%); height: 4.5%; width: var(--w); border-radius: 2px; background: var(--fa); clip-path: inset(0 100% 0 0); animation: ab-escribe 5s steps(14, end) infinite; animation-delay: calc(var(--k) * 0.45s); }
  .g-escribe i:first-child { background: var(--fb); }
  .g-escribe .cursor { left: 16%; top: 78%; width: 2.6%; height: 6%; background: var(--fb); animation: ab-cursor 1s steps(1, end) infinite; }
