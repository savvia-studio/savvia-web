---
// RONDA 117 · EL DIRECTOR SE DESHACE EN EL MANIFIESTO. Andoni: «hay que hacer de alguna manera que al ir a la segunda sección el director no parezca
// cortado… que le salga algo de abajo que tenga sentido y cree a su vez el texto». (Sustituye a RaicesMusicales.astro, que queda guardada: no lo arreglaba.)
// · EN REPOSO las piernas ya no acaban en una línea: se DESHACEN en la trama (una máscara de puntos Bayer, la misma lengua del tramado del director).
// · AL BAJAR, esa parte de abajo se suelta píxel a píxel, de los pies hacia arriba (la máscara sube con el scroll), y cada píxel —con su color real de la
//   lámina— cae como arena y se posa en una palabra del manifiesto: los de más abajo van a las primeras palabras. Cuando a una palabra le han llegado sus
//   píxeles, aparece. Todo atado al scroll (al subir, vuelven al director). Las palabras que aún están bajo la pantalla esperan sus píxeles bajo el borde.
// · Movimiento reducido: solo la máscara quieta; el texto, a la vista.
---

<script>
  const sec = document.querySelector<HTMLElement>('[data-sumi]'), caja = sec?.querySelector<HTMLElement>('[data-caja]'), lamina = sec?.querySelector<HTMLImageElement>('[data-lamina]');
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sec && caja && lamina) {
    // ── la MÁSCARA de trama: opaca arriba; abajo, un degradado tramado en celdas de 3 px. D = cuánto de la figura se ha deshecho (0,16 en reposo)
    const bayer = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16);
    const mc = document.createElement('canvas'), mx = mc.getContext('2d')!;
    let dPrev = -1, cw = 0, ch = 0;
    const mascara = (D: number) => {
      const r = caja.getBoundingClientRect(); const w = Math.round(r.width / 2), h = Math.round(r.height / 2); // ronda 118: celda de 2 px (antes 3: «mucho píxel muerto»)
      if (!w || !h) return; const q = Math.round(D * 60) / 60;
      if (q === dPrev && w === cw && h === ch) return; dPrev = q; cw = w; ch = h;
      mc.width = w; mc.height = h; const im = mx.createImageData(w, h);
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        const yy = y / h, n = Math.sin(x * 0.37 + y * 0.11) * 0.5 + Math.sin(x * 0.091 - y * 0.23) * 0.5; // ruido barato: el canto no es una línea
        const ramp = Math.min(1, Math.max(0, (1 - yy - q * 0.12 + n * 0.035) / (q * 0.88)));
        im.data[(y * w + x) * 4 + 3] = Math.round(ramp * ramp * (3 - 2 * ramp) * 255); // ronda 118 · «mucho píxel muerto abajo»: fundido suave, sin la trama Bayer
        void bayer;
      }
      mx.putImageData(im, 0, 0);
      const url = `url(${mc.toDataURL()})`;
      caja.style.setProperty('-webkit-mask-image', url); caja.style.maskImage = url;
      caja.style.setProperty('-webkit-mask-size', '100% 100%'); caja.style.maskSize = '100% 100%';
      caja.style.removeProperty('image-rendering');
    };
    const avance = () => Math.min(1.2, Math.max(0, scrollY / Math.max(1, sec.offsetHeight * 0.85)));
    const D = (P: number) => 0.06 + 0.42 * Math.min(1, P / 0.75); // ronda 118: en reposo solo se deshace el 6 % de abajo (antes 16 %)
    mascara(D(reducido ? 0 : avance()));
    new ResizeObserver(() => { dPrev = -1; mascara(D(reducido ? 0 : avance())); }).observe(caja);

    const man = document.querySelector<HTMLElement>('[data-manifiesto], .manifiesto');
    const pl = [...(man?.querySelectorAll<HTMLElement>('.pl') ?? [])];
    if (!reducido && pl.length) {
      const cv = document.createElement('canvas'); cv.className = 'disuelve'; cv.setAttribute('aria-hidden', 'true');
      Object.assign(cv.style, { position: 'fixed', inset: '0', width: '100vw', height: '100lvh', pointerEvents: 'none', zIndex: '1' });
      document.body.appendChild(cv); const c = cv.getContext('2d')!;
      type Px = { ox: number; oy: number; col: string; w: number; tx: number; ty: number; p0: number; lado: number; s: number };
      let pix: Px[] = [], docs: number[][] = [], cuantos: number[] = [], listo = false, raf = 0, sucio = true;
      const movil = innerWidth < 768, N = movil ? 900 : 1700, VUELO = 0.3;
      let h = 117; const az = () => ((h = (h * 16807) % 2147483647) / 2147483647);
      const preparar = () => {
        const GW = 260, GH = Math.round((GW * lamina.naturalHeight) / lamina.naturalWidth);
        const t = document.createElement('canvas'); t.width = GW; t.height = GH; const tc = t.getContext('2d', { willReadFrequently: true })!; tc.drawImage(lamina, 0, 0, GW, GH);
        const d = tc.getImageData(0, 0, GW, GH).data, cand: [number, number, string][] = [];
        // de dónde salen: la parte de abajo de la figura (lo que se deshace), más denso cuanto más abajo
        for (let k = 0; k < 60000 && cand.length < N; k++) {
          const x = Math.floor(az() * GW), yy = 0.42 + Math.pow(az(), 0.6) * 0.58, y = Math.min(GH - 1, Math.floor(yy * GH)), i = (y * GW + x) * 4;
          if (d[i + 3] < 140) continue;
          cand.push([x / GW, y / GH, `rgb(${d[i]},${d[i + 1]},${d[i + 2]})`]);
        }
        cand.sort((a, b) => b[1] - a[1]); // los de más abajo, primero
        // cuántos le tocan a cada palabra: según su anchura
        const anch = pl.map((w) => Math.max(8, w.offsetWidth)), tot = anch.reduce((s, v) => s + v, 0);
        cuantos = anch.map((a) => Math.max(5, Math.round((a / tot) * cand.length)));
        pix = []; let j = 0;
        pl.forEach((_, n) => { for (let m = 0; m < cuantos[n] && j < cand.length; m++, j++) {
          const [ox, oy, col] = cand[j];
          pix.push({ ox, oy, col, w: n, tx: az(), ty: 0.25 + az() * 0.55, p0: 0.03 + (j / cand.length) * 0.62 + (az() - 0.5) * 0.05, lado: (az() - 0.5) * 90, s: az() < 0.15 ? 3 : 2 });
        } });
        cuantos = pl.map((_, n) => pix.filter((p) => p.w === n).length);
        listo = true; pl.forEach((w) => w.classList.add('por-llegar')); pedir();
      };
      const medirDocs = () => { const sy = scrollY; docs = pl.map((w) => { const r = w.getBoundingClientRect(); return [r.left, r.top + sy, r.width, r.height]; }); };
      const ocultas: boolean[] = [];
      const pintar = () => {
        raf = 0; if (!listo) return;
        const P = avance(); mascara(D(P));
        const dpr = Math.min(1.5, devicePixelRatio || 1);
        if (cv.width !== Math.round(innerWidth * dpr) || cv.height !== Math.round(innerHeight * dpr)) { cv.width = Math.round(innerWidth * dpr); cv.height = Math.round(innerHeight * dpr); sucio = true; }
        if (sucio) { c.setTransform(1, 0, 0, 1, 0, 0); c.clearRect(0, 0, cv.width, cv.height); sucio = false; }
        if (!docs.length) medirDocs();
        const lr = caja.getBoundingClientRect(), H = innerHeight, sy = scrollY, llegados = new Array(pl.length).fill(0);
        c.setTransform(dpr, 0, 0, dpr, 0, 0);
        for (const p of pix) {
          const e0 = (P - p.p0) / VUELO; if (e0 <= 0) continue;
          const d = docs[p.w], top = d[1] - sy;
          const f = Math.min(1, Math.max(0, (H - top) / (H * 0.12))); // la palabra tiene que estar en pantalla para recibirlo
          const e = Math.min(1, e0), land = Math.min(e, f);
          if (land >= 1) { llegados[p.w]++; continue; }
          const x0 = lr.left + lr.width * p.ox, y0 = lr.top + lr.height * p.oy;
          const x1 = d[0] + d[2] * p.tx, y1 = Math.min(top + d[3] * p.ty, H + 30);
          // primero CAE (gravedad: recto hacia abajo), luego se va a su palabra en curva
          const k = e * e * (3 - 2 * e), kx = Math.pow(k, 1.6);
          const x = x0 + (x1 - x0) * kx + Math.sin(Math.PI * k) * p.lado * 0.4, y = y0 + (y1 - y0) * k;
          if (y > H + 10 || y < -10) continue;
          c.globalAlpha = land < 0.75 ? 0.95 : (1 - land) * 3.8;
          c.fillStyle = p.col; c.fillRect(Math.round(x), Math.round(y), p.s, p.s); sucio = true;
        }
        c.globalAlpha = 1;
        pl.forEach((w, n) => { const o = llegados[n] < cuantos[n] * 0.7; if (ocultas[n] !== o) { ocultas[n] = o; w.classList.toggle('por-llegar', o); } });
      };
      const pedir = () => { if (!raf) raf = requestAnimationFrame(pintar); };
      addEventListener('scroll', pedir, { passive: true });
      addEventListener('resize', () => { docs = []; pedir(); });
      new ResizeObserver(() => { docs = []; pedir(); }).observe(document.body);
      const ir = () => { if (lamina.complete && lamina.naturalWidth) preparar(); else lamina.addEventListener('load', preparar, { once: true }); };
      ir();
      (window as any).__disuelve = () => ({ px: pix.length, ocultas: ocultas.filter(Boolean).length, palabras: pl.length });
    } else mascara(D(0));
  }
</script>
