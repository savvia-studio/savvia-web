  [data-estudio].sentado .titulo-pantalla { visibility: hidden !important; opacity: 0 !important; transition: opacity 0.45s ease, visibility 0s linear 0.45s; }
  [data-estudio].sentado .titulo-pantalla h2 { opacity: 0 !important; transition: opacity 0.18s ease; }
