      // RONDA 13: el grano del titular se contra-escala (en pantalla mide siempre 240 px, como el de la sección): sin «corte» de materia
      titulo.style.setProperty('--gr', `${(240 * K) / s2}px`);
      // la página de inicio del monitor repite el titular al MISMO tamaño relativo: el fundido de uno a otro no se ve
      inicio.style.setProperty('--ft', `${(parseFloat(getComputedStyle(tituloH2).fontSize) / (pw * K * 1.014)) * 100}cqw`);
      if (sal > 0) {
        // SALIDA: la pantalla se llena de Cacao (sin texto) mientras la cámara entra; al final es la página que sigue
        titulo.classList.add('vacio');
        titulo.style.opacity = String(Math.min(1, Math.max(0, (sal - 0.3) / 0.45)));
        titulo.style.visibility = sal > 0.3 ? 'visible' : 'hidden';
        escenario.classList.remove('dentro', 'viva');
      } else {
        titulo.classList.remove('vacio');
        titulo.style.opacity = String(1 - Math.min(1, Math.max(0, (lin - 0.84) / 0.12)));
        titulo.style.visibility = lin >= 0.97 ? 'hidden' : 'visible';
        escenario.classList.toggle('dentro', lin > 0.93);
        if (lin > 0.93 && !empujado) empujar();
        if (lin > 0.965 && !estrenado) estrenar(); // cuando el titular-pantalla ya se ha fundido con el de la página de inicio
        if (lin < 0.93) escenario.classList.remove('viva');
      }
    };
    const pedirE = () => { if (!pedidoE) { pedidoE = true; requestAnimationFrame(entrar); } };
    // RONDA 39 · el dial enseña que gira: al llegar, sube medio paso y vuelve, dos veces, y las flechas laten
    function empujar() {
      empujado = true;
      if (reducido || !matchMedia('(width >= 64rem)').matches) return;
      dial.animate([{ translate: '0 0' }, { translate: '0 -18px' }, { translate: '0 0' }, { translate: '0 18px' }, { translate: '0 0' }], { duration: 1600, delay: 1100, easing: 'ease-in-out' });
      $('[data-guia]').classList.add('late');
    }
    // RONDA 20 · «savvia se tiene que ver con el color claro» sobre la escena: mientras la sección pasa bajo la barra, html.sobre-escena
    let sobre = false;
    const mirarBarra = () => { const r = raiz.getBoundingClientRect(); const si = r.top <= 72 && r.bottom >= 72; if (si !== sobre) { sobre = si; document.documentElement.classList.toggle('sobre-escena', si); } };
    addEventListener('scroll', mirarBarra, { passive: true }); mirarBarra();
    if (reducido) { escenario.classList.add('dentro'); titulo.hidden = true; }
    else { addEventListener('scroll', pedirE, { passive: true }); addEventListener('resize', () => { e = -1; pedirE(); }); entrar(); }
    // La web del monitor se recorre SIEMPRE, pero solo se activa cuando el ratón se MUEVE por la escena: un scroll de página con
    // el cursor quieto en el centro no debe quedarse atrapado dentro del monitor. En táctil, siempre activa.
    escenario.addEventListener('pointermove', (ev) => { if (ev.pointerType !== 'mouse' || e > 0.93) escenario.classList.add('viva'); }, { passive: true });
    escenario.addEventListener('pointerleave', () => !sentado && escenario.classList.remove('viva'));

    // Sonido: nace con un gesto (este clic) y se recuerda.
    const bs = $<HTMLButtonElement>('[data-sonido]');
    const pintarSonido = () => {
      bs.setAttribute('aria-pressed', String(sonido.activo()));
      $('[data-sonido-estado]').textContent = sonido.activo() ? 'on' : 'off';
    };
    bs.addEventListener('click', () => { sonido.alternar(); sonido.estacion(estActual()); pintarSonido(); });
    pintarSonido();

    pintar(true);
  }
</script>

<style>
  /* La pista: una pantalla pegada + 250 lvh de recorrido: 120 para ALEJARSE de la pantalla (entrada), 25 de descanso, 90 para volver a
