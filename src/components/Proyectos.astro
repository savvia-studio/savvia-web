    else { addEventListener('scroll', pedirE, { passive: true }); addEventListener('resize', () => { e = -1; pedirE(); }); entrar(); }
    // La web del monitor se recorre SIEMPRE, pero solo se activa cuando el ratón se MUEVE por la escena: un scroll de página con
    // el cursor quieto en el centro no debe quedarse atrapado dentro del monitor. En táctil, siempre activa.
    escenario.addEventListener('pointermove', (ev) => { if (ev.pointerType !== 'mouse' || e > 0.93) escenario.classList.add('viva'); }, { passive: true });
    // ronda 157: solo el ratón; con el dedo, el navegador dispara pointerleave al levantarlo y soltaba la web recién cogida
    escenario.addEventListener('pointerleave', (ev) => { if (ev.pointerType === 'mouse' && !sentado) { escenario.classList.remove('viva'); explorar(false); } });
    // RONDA 152 (2.ª) · EXPLORAR DE PIE: solo con un movimiento REAL del ratón sobre la pantalla (si el cursor está quieto y la página pasa por debajo,
    // no se activa: el scroll de la página nunca se queda atrapado). La web activa pasa de captura a la real y la rotación se para mientras.
    // RONDA 157 (Eric, Agentation) · «tú, cuando estás sentado, haces clic dentro del monitor y scrolleas la web dentro del monitor. Pues aquí igual.
    // Solo que si haces clic fuera o scrolleas fuera sigues scrolleando a las siguientes secciones»: en B la web se coge con un CLIC dentro del
    // monitor y se suelta con un clic fuera (la rueda fuera mueve la página, que sale de B y la suelta sola). De pie (D) sigue el movimiento del ratón.
    function explorar(si: boolean) {
      if (si === explorando || sentado) return;
      explorando = si;
      if (si) pararC();
      escenario.classList.toggle('explora', si);
      if (si) escenario.classList.remove('mira');
      const w = webs[activo]; desmontar(w); montar(w); ajustar();
      clearTimeout(finAviso);
      if (si) seguir(null);
      pistaScroll.classList.remove('on');
    }
    let finAviso = 0, ultX = -1, ultY = -1;
    // RONDA 160 (Eric, Agentation) · «ese clic para navegar, más presente, como al pasar sobre la pantalla; y si haces clic, que los bordes de la
    // pantalla cojan color»: con ratón, «clic para navegar» va pegado al cursor mientras está sobre el monitor (fase B, sin coger la web); al
    // cogerla, la pantalla se enciende con un filo de savia (.explora). Vive en el <body>: dentro del escenario escalado, `fixed` no vale.
    // ronda 160 (4.ª, Eric: «el puntito y el círculo, AI slop; mejor algo que siga al ratón normal»): la flecha de siempre y, a su lado, el
    // rótulo con un ratón dibujado (botón izquierdo en savia), que la sigue con un poco de retraso
    let cx = 0, cy = 0, ax = 0, ay = 0, rafS = 0;
    const pasoS = () => {
      ax += (cx - ax) * 0.22; ay += (cy - ay) * 0.22;
      sigue.style.setProperty('--x', `${cx}px`); sigue.style.setProperty('--y', `${cy}px`);
      sigue.style.setProperty('--ax', `${ax}px`); sigue.style.setProperty('--ay', `${ay}px`);
      rafS = Math.abs(cx - ax) + Math.abs(cy - ay) > 0.3 || sigue.classList.contains('on') ? requestAnimationFrame(pasoS) : 0;
    };
    function seguir(ev: PointerEvent | null) {
      const on = !!ev, antes = sigue.classList.contains('on');
      if (ev) { cx = ev.clientX; cy = ev.clientY; if (!antes) { ax = cx; ay = cy; } }
      sigue.classList.toggle('on', on);
      if (on && !rafS) rafS = requestAnimationFrame(pasoS);
    }
    escenario.addEventListener('pointerleave', () => queueMicrotask(() => invitarQuieto())); // ronda 171: fuera de la escena, la silla se ancla al monitor
    // RONDA 167 (Eric: «cuando haces scroll sin mover el ratón no aparece el clic para sentarte»): se recuerda dónde está el puntero y, en cada
    // fotograma de la entrada (que va con el scroll), si la escena invita y el puntero está encima, la silla sale ahí sin moverlo. Si el ratón no se
    // ha movido nunca en la página, sale en el centro del monitor.
    let pX = -1, pY = -1;
    addEventListener('pointermove', (ev) => { if (!MOVIL && ev.pointerType === 'mouse') { pX = ev.clientX; pY = ev.clientY; } }, { passive: true });
    const invitarQuieto = () => {
      if (sentado) return;
      if (!invita()) return;
      // RONDA 171 (Eric: «que toda la sección tenga el ratón personalizado y que siempre se muestre aunque no hagas hover»): con el puntero sobre la
      // escena, la silla va en él; si no (fuera de la escena o sin haberlo movido nunca), se ancla en el centro del monitor
      const er = escenario.getBoundingClientRect();
      if (er.bottom <= 0 || er.top >= innerHeight) return seguir(null); // la sección no se ve
      let x = pX, y = pY, encima = x >= er.left && x <= er.right && y >= er.top && y <= er.bottom;
      if (encima) { const sobre = document.elementFromPoint(x, y) as HTMLElement | null; if (sobre?.closest('[data-barra], .ui-info, [data-sentarse]')) encima = false; }
      if (!encima) { const r = $('[data-pantalla]').getBoundingClientRect(); x = r.left + r.width / 2; y = MOVIL ? Math.min(r.bottom + 44, innerHeight - 72) : r.top + r.height / 2; /* ronda 230: en móvil la píldora no tapa la pantalla; ronda 284 (Eric: «debajo, en la parte baja de la pantalla»): DEBAJO del monitor, sin salirse de la parte baja de la ventana */ if (y < 24 || y > innerHeight - 24) return seguir(null); } // anclada al monitor, solo si se ve
      escenario.classList.toggle('mira', encima);
      seguir({ clientX: x, clientY: y } as PointerEvent);
    };
    addEventListener('scroll', () => { if (fase === 'D' || !invita()) invitarQuieto(); if (!invita() && sigue.classList.contains('on')) seguir(null); }, { passive: true });
    // la pantalla no coge el puntero de pie: el movimiento se mira en el escenario y se comprueba si cae dentro del rectángulo del monitor
    escenario.addEventListener('pointermove', (ev) => {
      if (sentado || MOVIL || ev.pointerType !== 'mouse') return;
      if (invita()) { pX = ev.clientX; pY = ev.clientY; invitarQuieto(); return; } // ronda 161/165/171: toda la escena invita a sentarse
      if (explorando || fase !== 'D') return;
      const primero = ultX < 0, mov = Math.abs(ev.clientX - ultX) + Math.abs(ev.clientY - ultY); ultX = ev.clientX; ultY = ev.clientY;
      if (primero) return;
      if (mov < 1) return; // Safari no siempre da movementX: el movimiento se mide a mano
      if (enMonitor(ev.clientX, ev.clientY)) explorar(true);
    }, { passive: true });
    // ronda 161: en B el clic (o el toque: `click` no salta al arrastrar para hacer scroll) te SIENTA, con el viaje de cámara
    // RONDA 266 · Eric: «en esa sección, prácticamente donde toques te haga sentarte»: en táctil el toque vale en TODA la sección (no solo en el escenario) y
    // mientras el escenario ocupe la pantalla (sin exigir el borde exacto de la pista); el selector, la ficha, los botones y los enlaces siguen a lo suyo
    const tocaSentar = () => !sentado && (MOVIL ? (() => { const r = escenario.getBoundingClientRect(); return r.top < innerHeight * 0.4 && r.bottom > innerHeight * 0.6; })() : invita());
    (MOVIL ? raiz : escenario).addEventListener('click', (ev) => {
      if (!tocaSentar()) return;
      if ((ev.target as HTMLElement).closest('[data-barra], .ui-info, button, a')) return; // el selector y la ficha hacen lo suyo
      seguir(null); escenario.classList.remove('mira');
      cargar(); sentar(true);
    });

    // ronda 153: el sonido lo manda el (+) flotante (Mando.astro → savvia:son); el ambiente lo sigue (sonido-estudio.ts)
    addEventListener('savvia:son-estudio', () => sonido.estacion(estActual()));

    pintar(true);
  }
</script>

<style>
  /* RONDA 292 · el mockup va ahora justo tras las raíces: su tierra seguía bajo el escenario (opaco, pegado) y se cortaba en el borde. La mancha va en una capa
