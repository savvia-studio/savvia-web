  }
  .ic.tenue {
    opacity: 0.35;
  }
  .ic.mini {
    width: 2.1cqh;
    height: 2.1cqh;
  }
  /* los iconos de la derecha se van al final (la dirección ya no ocupa el hueco) */
  .direccion + .ic {
    margin-left: auto;
  }
  .direccion {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 40%;
