  /* RONDA 19: la web real. El iframe se maqueta a 1440 px (1024 en móvil) y el JS lo reduce a la pantalla con `transform: scale`. */
  .web :global(iframe) {
    display: block;
    border: 0;
    background: #fff;
    transform-origin: 0 0;
  }
  .web:has(:global(iframe)) {
    overflow: hidden;
  }
  /* la página «carga»: aparece de arriba abajo cuando la barra de progreso termina */
  .web {
    clip-path: inset(0);
    transition:
      opacity 0.35s ease,
      clip-path 0.7s var(--ease-out-expo);
  }
  .web.cargando {
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition: none;
  }

  /* ── INTERFAZ MÍNIMA: texto sobre la escena, sin cajas. Aparece al terminar de entrar. */
  .ui,
  .velo-ui,
  .llamada {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .dentro .ui,
  .dentro .velo-ui,
  .dentro .llamada {
    opacity: 1;
  }
  .ui {
    position: absolute;
    color: var(--color-niebla);
    text-shadow: 0 1px 2px color-mix(in oklab, var(--noche) 70%, transparent), 0 0 18px var(--noche);
  }
  /* un velo Cacao abajo y otro, más leve, arriba: lo justo para que el texto se lea sobre cualquier estación */
  .velo-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, color-mix(in oklab, var(--noche) 80%, transparent), transparent 22%),
      linear-gradient(to bottom, color-mix(in oklab, var(--noche) 88%, transparent) 8%, transparent 40%);
  }
  /* móvil: la ficha va ARRIBA, sobre el cielo (abajo pisaba la llamada de la silla); en escritorio, abajo a la izquierda */
  .ui-info {
    left: calc(var(--spacing) * 5);
    right: calc(var(--spacing) * 5);
    top: calc(var(--spacing) * 16);
  }
  .ficha:not([hidden]) {
    animation: enfocar 0.6s var(--ease-out-expo);
  }
  @keyframes enfocar {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }
  .muestra {
    width: calc(var(--spacing) * 3);
    height: calc(var(--spacing) * 3);
    border-radius: var(--radius-full);
    background: var(--c);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 40%, transparent);
  }
  /* EL DIAL. Móvil: una fila de números, centrada, encima de la barra. Escritorio: dial vertical (más abajo). */
  .ui-lista {
    left: 50%;
    translate: -50% 0;
    bottom: calc(var(--spacing) * 20);
  }
  .dial {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }
  .dial li:not(:nth-child(n + 9):nth-child(-n + 12)) {
    display: none; /* en móvil, solo la copia central */
  }
  .item {
    display: flex;
    gap: calc(var(--spacing) * 3);
    min-height: calc(var(--spacing) * 8);
    min-width: calc(var(--spacing) * 8);
    align-items: center;
    opacity: 0.5;
    transition: opacity 0.4s var(--ease-out-expo);
  }
  .item .nombre,
  .item .raya {
    display: none;
  }
  /* la raya que marca el activo, como en el esquema */
  .raya {
    width: calc(var(--spacing) * 3);
    height: 1px;
    background: currentColor;
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale 0.5s var(--ease-out-expo);
  }
  .item[aria-current='true'] .raya {
    scale: 1 1;
  }
  .ver {
    opacity: 0.7;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
  .ver:hover {
    opacity: 1;
  }
  .item[aria-current='true'] {
    opacity: 1;
  }
  .item[aria-current='true'] .num {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  /* CRISTAL (ronda 11): el material de la interfaz sobre la escena —lista, ficha y barra—, estilo Apple: desenfoque del fondo + velo
     Cacao + filo claro. Así se LEE sobre cualquier estación («el menú lateral con la info se lee mal»). */
  .cristal {
    background: color-mix(in oklab, var(--noche) 58%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    backdrop-filter: blur(22px) saturate(1.5);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 16%, transparent),
      0 12px 32px -12px rgb(0 0 0 / 0.45);
    border-radius: calc(var(--spacing) * 4);
    text-shadow: none;
  }
  /* la barra inferior: píldora recogida con iconos */
  /* RONDA 21 · «el + sin la card cuadrada de fuera y el estilo como teníamos antes, semitransparente»: sin píldora; el (+) y las gotas son
     círculos de cristal (velo Cacao translúcido + desenfoque de fondo + filo) con el icono en Rosa niebla; pulsado = Rosa niebla con el icono en Cacao */
  .ui-mando {
    left: 50%;
    translate: -50% 0;
    bottom: max(calc(var(--spacing) * 4), env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
  }
  /* ── EL ABANICO DE ESTACIONES (ronda 19): el (+) y, alrededor, cuatro gotas que salen de él. Capa de gotas (Rosa niebla, opacas: el
     umbral del filtro gooey trabaja con el alfa) + botones transparentes encima. Ángulos: una circunferencia de 60 px, el arco de arriba. */
  .abanico {
    --R: 64px;
    position: relative;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
  }
  .abanico .blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22; /* la capa líquida es translúcida: el umbral del gooey trabaja antes, sobre las gotas opacas; la opacidad va después */
  }
  .abanico.fundiendo .blobs {
    filter: url(#goo-estaciones);
  }
  .abanico .blob,
  .abanico .grupo .est {
    --a: calc(-200deg + var(--i, 0) * 50deg); /* −200 · −150 · −100 · −50 · 0: del lado izquierdo al lado derecho (ronda 20: la quinta es el sonido) */
    --tx: calc(cos(var(--a)) * var(--R));
    --ty: calc(sin(var(--a)) * var(--R));
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--spacing) * 9);
    height: calc(var(--spacing) * 9);
    margin: calc(var(--spacing) * -4.5) 0 0 calc(var(--spacing) * -4.5);
    border-radius: 50%;
    translate: 0 0;
    transition:
      translate 0.55s cubic-bezier(0.4, 0, 0.2, 1) calc((4 - var(--i, 0)) * 35ms),
      scale 0.45s cubic-bezier(0.4, 0, 0.2, 1) calc((4 - var(--i, 0)) * 35ms),
      opacity 0.3s ease;
  }
  .abanico .blob {
    background: var(--color-niebla);
    scale: 0.35;
  }
  .abanico .blob.mas-blob {
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    margin: calc(var(--spacing) * -6) 0 0 calc(var(--spacing) * -6);
    scale: 1;
  }
  .abanico.abierto .blob:not(.mas-blob),
  .abanico.abierto .grupo .est {
    translate: var(--tx) var(--ty);
    scale: 1;
    /* al abrirse, con muelle (se pasa un poco y vuelve); al cerrarse, sin rebote */
    transition:
      translate 0.7s cubic-bezier(0.34, 1.45, 0.5, 1) calc(var(--i, 0) * 45ms),
      scale 0.6s cubic-bezier(0.34, 1.45, 0.5, 1) calc(var(--i, 0) * 45ms),
      opacity 0.3s ease calc(var(--i, 0) * 45ms);
  }
  .mas-rotulo {
    position: absolute;
    left: calc(100% + var(--spacing) * 3);
    top: 50%;
    translate: 0 -50%;
    white-space: nowrap;
    color: var(--color-niebla);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.55);
    pointer-events: none;
    transition: opacity 0.4s ease, translate 0.5s var(--ease-out-expo);
  }
  .abanico.abierto .mas-rotulo {
    opacity: 0;
    translate: 8px -50%;
  }
  [data-estudio].sentado .mas-rotulo { opacity: 0; }
  .abanico .mas {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: color-mix(in oklab, var(--color-niebla) 80%, transparent);
    background: color-mix(in oklab, var(--noche) 52%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 18%, transparent), 0 10px 28px -12px rgb(0 0 0 / 0.45);
    transition: color 0.3s var(--ease-out-expo), background-color 0.3s var(--ease-out-expo);
  }
  .abanico .mas:hover {
    color: var(--color-niebla);
    background: color-mix(in oklab, var(--noche) 40%, transparent);
  }
  .abanico .mas svg {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    transition: rotate 0.5s var(--ease-out-expo);
  }
  .abanico.abierto .mas svg {
    rotate: 45deg; /* el (+) se vuelve una × */
  }
  .abanico .grupo {
    position: absolute;
    inset: 0;
    pointer-events: none; /* RONDA 22: el grupo (una caja de 48 px encima del (+)) NUNCA coge el puntero: abierto tapaba la × y «costaba cerrarlo» */
  }
  .abanico.abierto .grupo .est {
    pointer-events: auto;
  }
  .ui-mando .abanico .grupo .est {
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--noche) 52%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 18%, transparent);
    color: color-mix(in oklab, var(--color-niebla) 75%, transparent);
    opacity: 0;
  }
  .ui-mando .abanico.abierto .grupo .est {
    opacity: 1;
  }
  .ui-mando .abanico .grupo .est svg {
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
  }
  .ui-mando .abanico .grupo .est:hover {
    background: color-mix(in oklab, var(--color-niebla) 14%, color-mix(in oklab, var(--noche) 45%, transparent));
    color: var(--color-niebla);
    scale: 1.1;
  }
  .ui-mando .abanico .grupo .est[aria-pressed='true'] {
    background: var(--color-niebla);
    color: var(--color-cacao);
  }
  .ui-mando .grupo {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }
  .ui-mando[hidden],
  .barra[hidden] {
    display: none;
  }
  .sep {
    width: 1px;
    height: calc(var(--spacing) * 6);
    margin-inline: calc(var(--spacing) * 1);
    background: color-mix(in oklab, var(--color-niebla) 18%, transparent);
  }
  .ui-mando .est {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    border-radius: calc(var(--spacing) * 4);
    color: color-mix(in oklab, var(--color-niebla) 70%, transparent);
    transition:
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo),
      scale 0.3s var(--ease-out-expo);
  }
  .ui-mando .est svg {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ui-mando .est svg.relleno { fill: currentColor; stroke: none; }
  .ui-mando .est:hover {
    color: var(--color-niebla);
    background: color-mix(in oklab, var(--color-niebla) 10%, transparent);
  }
  .ui-mando .est:active {
    scale: 0.94;
  }
  .ui-mando .est[aria-pressed='true'] {
    color: var(--color-cacao);
    background: var(--color-niebla);
  }
  [data-sonido] .ondas { display: none; }
  [data-sonido][aria-pressed='true'] .ondas { display: inline; }
  [data-sonido][aria-pressed='true'] .mudo { display: none; }
  /* la etiqueta del botón: sale encima al pasar o enfocar */
  .rotulo {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--spacing) * 3);
    translate: -50% 4px;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    border-radius: calc(var(--spacing) * 2);
    background: var(--color-niebla);
    color: var(--color-cacao);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.35s var(--ease-out-expo);
  }
  .est:hover .rotulo,
  .est:focus-visible .rotulo {
    opacity: 1;
    translate: -50% 0;
  }
  .barra {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .barra > * {
    pointer-events: auto;
  }
  /* RONDA 68 · arriba en el centro, un solo cristal: esc + la × (en la esquina estaba el botón del menú). RONDA 76 · vuelven los redondeos:
     píldoras y botones redondos, sin cruces. */
  .arriba {
    border-radius: var(--radius-full);
    position: absolute;
    left: 50%;
    top: max(calc(var(--spacing) * 6), env(safe-area-inset-top));
    translate: -50% 0;
    display: flex;
    align-items: center;
    padding: calc(var(--spacing) * 1);
    color: var(--color-niebla);
    white-space: nowrap;
  }
  .cerrar {
    border-radius: 50%;
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    display: grid;
    place-items: center;
    color: var(--color-niebla);
    transition: scale 0.3s var(--ease-out-expo), background-color 0.3s ease, color 0.3s ease;
  }
  .cerrar:hover {
    background: var(--color-niebla);
    color: var(--color-cacao);
  }
  .cerrar:active {
    scale: 0.94;
  }
  .cerrar svg {
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }
  .otros {
    border-radius: var(--radius-full);
    position: absolute;
    left: 50%;
    bottom: max(calc(var(--spacing) * 6), env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 1);
    color: var(--color-niebla);
    white-space: nowrap;
  }
  .otros .paso {
    border-radius: 50%;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    display: grid;
    place-items: center;
    transition: background-color 0.3s ease, color 0.3s ease, scale 0.3s var(--ease-out-expo);
  }
  .otros .paso:hover {
    background: var(--color-niebla);
    color: var(--color-cacao);
  }
  .otros .paso:active {
    scale: 0.94;
  }
  .otros svg {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cual {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 3);
    min-width: calc(var(--spacing) * 48);
    justify-content: center;
    font-size: var(--text-ui);
    font-weight: 500;
  }
  .cual .detail {
    opacity: 0.6;
  }
  .salir {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding-inline: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    margin-right: calc(var(--spacing) * 1);
    border-right: 1px solid color-mix(in oklab, var(--color-niebla) 18%, transparent);
  }
  kbd {
    border-radius: 6px;
    font: inherit;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    background: color-mix(in oklab, var(--color-niebla) 16%, transparent);
  }
  @media (hover: none) {
    .salir { display: none; } /* en táctil no hay tecla Esc: queda la (x) */
  }

  /* ── LA LLAMADA «SENTARSE»: punto en el respaldo de la silla, línea a 45° y la palabra. Vive en coordenadas de la lámina. */
  .llamada {
    /* la caja del botón va del punto (esquina inferior izquierda) a la palabra: así tiene área de clic y anillo de foco reales */
    position: absolute;
    left: 58.7%;
    top: 81%;
    width: 216px;
    height: 72px;
    translate: 0 -100%;
    color: var(--color-niebla);
    cursor: pointer;
  }
  .punto-silla {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 10px;
    height: 10px;
    margin: -5px;
    border-radius: var(--radius-full);
    background: currentColor;
  }
  .punto-silla::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: inherit;
    border: 1px solid currentColor;
    animation: latido 2.6s var(--ease-out-expo) infinite;
  }
  @keyframes latido {
    from { transform: scale(0.5); opacity: 0.9; }
    to { transform: scale(1.5); opacity: 0; }
  }
  .linea {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 120px;
    height: 64px;
    overflow: visible;
  }
  .linea path {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .llamada span {
    position: absolute;
    left: 128px;
    top: 0;
    line-height: 28px; /* la línea llega a y = 6 de 64 desde arriba de su caja: el centro de la palabra cae ahí */
    white-space: nowrap;
    text-shadow: 0 1px 12px color-mix(in oklab, var(--noche) 80%, transparent);
  }
  .llamada:hover span,
  .llamada:focus-visible span {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  /* en móvil la silla queda cerca del borde derecho: la llamada sale hacia la izquierda */
  @media (width < 48rem) {
    .llamada {
      translate: -100% -100%;
    }
    .punto-silla {
      left: auto;
      right: 0;
    }
    .linea {
      left: auto;
      right: 0;
      scale: -1 1;
    }
    .llamada span {
      left: auto;
      right: 128px;
    }
  }

  @media (width >= 64rem) {
    .ui-info {
      left: auto;
      right: calc(var(--spacing) * 12);
      top: 50%;
      translate: 0 -50%;
      width: min(22vw, 20rem);
      font-weight: 500;
    }
    /* escritorio: la interfaz va a los LADOS del ordenador (esquema de Andoni) → velos laterales, y uno abajo para el mando */
    /* RONDA 13 · «que los gradientes de izquierda y derecha sean radiales, así se van a ver más en la zona de los textos»: dos elipses
       centradas en el dial (izquierda) y en la ficha (derecha); lo más hondo cae justo detrás del texto y se abre hacia el monitor. */
    .velo-ui {
      background:
        radial-gradient(ellipse min(26vw, 26rem) 42% at calc(var(--spacing) * 12 + min(12vw, 11rem)) 50%, color-mix(in oklab, var(--noche) 94%, transparent), color-mix(in oklab, var(--noche) 62%, transparent) 50%, transparent),
        radial-gradient(ellipse min(25vw, 25rem) 42% at calc(100% - var(--spacing) * 12 - min(11vw, 10rem)) 50%, color-mix(in oklab, var(--noche) 94%, transparent), color-mix(in oklab, var(--noche) 62%, transparent) 50%, transparent),
        linear-gradient(to top, color-mix(in oklab, var(--noche) 70%, transparent), transparent 24%);
    }
    /* el dial: una ventana de 5 filas; el activo en el centro; arriba y abajo se funde (máscara) y cada fila pierde foco con la distancia */
    .ui-lista {
      --fila: calc(var(--spacing) * 12);
      left: calc(var(--spacing) * 12);
      right: auto;
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
      height: calc(var(--fila) * 5);
      width: min(24vw, 22rem);
      overflow: hidden;
      font-size: var(--text-lead);
      mask-image: linear-gradient(to bottom, transparent, #000 32%, #000 68%, transparent);
    }
    .dial {
      display: block;
      padding-top: calc(var(--fila) * 2); /* la fila `pos` cae en el centro de la ventana */
      transition: transform 0.7s var(--ease-out-expo);
    }
    .dial.sin,
    .dial.sin .item {
      transition: none;
    }
    .dial li:not(:nth-child(n + 9):nth-child(-n + 12)) {
      display: block;
    }
    .dial .item {
      height: var(--fila);
      width: 100%;
      opacity: calc(1 - var(--d, 0) * 0.34);
      filter: blur(calc(var(--d, 0) * 1.5px));
      scale: calc(1 - var(--d, 0) * 0.05);
      transform-origin: 0 50%;
      transition:
        opacity 0.6s var(--ease-out-expo),
        filter 0.6s var(--ease-out-expo),
        scale 0.6s var(--ease-out-expo);
    }
    .item .nombre {
      display: inline;
    }
    .item .num {
      display: none;
    }
    .item .raya {
      display: block;
    }
    .ui-mando {
      bottom: calc(var(--spacing) * 8);
    }
  }

  /* RONDA 41 · la capa que recoge el PRIMER gesto de scroll sobre la web */
  .capta {
    position: absolute;
    inset: 4.6cqh 0 0;
    z-index: 3;
  }
  /* ── RONDA 39 · LA SEÑAL DE SCROLL dentro de la pantalla: una píldora oscura al pie de la web con la rueda del ratón bajando.
     Todo en unidades de la pantalla (cqh/cqw): crece con ella. Nace invisible (regla dura 3); la enciende el JS. */
  .pista-scroll {
    position: absolute;
    left: 50%;
    bottom: 6cqh;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 2.4cqh;
    padding: 2.2cqh 4cqh 2.2cqh 3cqh;
    border-radius: 99px;
    background: color-mix(in oklab, #000 62%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    font-family: var(--font-mono);
    font-size: max(9px, 5.4cqh);
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: -50% 30%;
    transition: opacity 0.5s ease, translate 0.7s var(--ease-out-expo);
  }
  .pista-scroll.on {
    opacity: 1;
    translate: -50% 0;
    transition-delay: 0.6s;
  }
  .raton {
    position: relative;
    display: block;
    width: max(9px, 6cqh);
    height: max(14px, 9.5cqh);
    border: 1.5px solid currentColor;
    border-radius: 99px;
  }
  .raton i {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 2px;
    height: 22%;
    margin-left: -1px;
    border-radius: 2px;
    background: currentColor;
