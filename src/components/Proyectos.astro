    transition: transform 0.95s cubic-bezier(0.3, 0.6, 0.2, 1);
  }
  /* RONDA 46 · «el menú de la web se queda detrás de la barra de navegación»: la web es un iframe de otro dominio y se desplaza DENTRO de sí
     misma: nunca puede pasar por debajo de la barra, solo quedar tapada. La web empieza bajo la barra, como en un Safari de verdad. */
  .reel-loop {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 3;
    pointer-events: none;
    background: #121213;
    opacity: 0;
    transition: opacity 0.9s ease;
  }
  .reel-loop:global(.listo) { opacity: 1; }
  [data-estudio].sentado .reel-loop:global(.listo),
  .escenario.explora .reel-loop:global(.listo) { opacity: 0; }
  .visor {
    position: absolute;
    inset: 0; /* ronda 66: sin navegador, la web ocupa la pantalla entera */
    /* ronda 159: el filo del bisel (box-shadow de .pantalla) y el visor se tocaban en un borde fraccionario y dejaban una costura clara;
       el visor lo pisa por dentro con su propio filo */
    box-shadow: 0 0 0 2px #121213;
    /* ronda 159: antes #fbfbfa (pestaña en blanco); con la web reducida a una posición fraccionaria, su primera fila y columna
       dejaban ver ese blanco como una línea clara contra el marco. Ya no se teclea la dirección: el fondo es el del bisel. */
    background: #121213;
  }
  /* RONDA 66 · «no puedes hacer scroll hasta que no te sientas»: la web del monitor solo coge el puntero sentado */
  [data-estudio].sentado .pantalla {
    pointer-events: auto;
  }
  /* RONDA 67 · de pie, las capturas se relevan con un FUNDIDO desenfocado y tranquilo */
  [data-estudio]:not(.sentado) .web {
    opacity: 0;
    filter: blur(10px);
    scale: 1.03;
    clip-path: none;
    transition: opacity 1.6s ease, filter 1.8s ease, scale 2.4s var(--ease-out-expo);
  }
  [data-estudio]:not(.sentado) .web.on:not(.cargando) {
    opacity: 1;
    filter: none;
    scale: 1;
  }
  /* «encajar bien el proyecto, tiene una línea blanca por arriba»: era el blanco de la pantalla de la lámina asomando; un filo del color del bisel lo tapa */
  /* RONDA 159 (Eric: «en Multiverse veo una línea blanca con respecto al marco»): con 1,5 px seguía asomando el canto claro de la lámina → 3 px */
  .pantalla {
    box-shadow: 0 0 0 3px #121213;
  }
  /* RONDA 162 · LA CONSTRUCCIÓN (src/scripts/construir.ts): la maqueta en el fondo de la web, la retícula de 12, las cajas que trazan los dos
     cursores y la miniatura que se pinta con el canto rasgado. Todo en unidades de la pantalla (cqh), como la pantalla de carga. */
  .construye {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    background: var(--c-fondo);
    color: var(--c-tinta);
    pointer-events: none;
    display: none;
  }
  .construye:global(.on) { display: block; }
  .construye :global(.c-reticula) {
    position: absolute;
    inset: 0 3%;
    opacity: 0;
    background: repeating-linear-gradient(90deg, color-mix(in oklab, currentColor 9%, transparent) 0 1px, transparent 1px calc(100% / 12));
    border-inline: 1px solid color-mix(in oklab, currentColor 9%, transparent);
  }
  .construye :global(.c-caja) {
    position: absolute;
    border-radius: 0.6cqh;
    background: color-mix(in oklab, currentColor 10%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, currentColor 34%, transparent);
  }
  .construye :global(.c-caja.t) { background: color-mix(in oklab, currentColor 20%, transparent); }
  .construye :global(.c-caja.b) { border-radius: 99px; background: color-mix(in oklab, var(--color-coral) 70%, transparent); box-shadow: none; }
  .construye :global(.c-caja.v) { border-radius: 1.4cqh; background: color-mix(in oklab, currentColor 5%, transparent); }
  .construye :global(.c-caja.r) { border-radius: 50%; background: color-mix(in oklab, currentColor 5%, transparent); }
  /* RONDA 187 · los punteros de savvia agentic (LaPartitura): la flecha de 16, la etiqueta en píldora del color con texto blanco, el clic que encoge
     y la onda; aquí en unidades de la pantalla. Posición, --clic y --onda los pone construir.ts en cada fotograma. */
  .construye :global(.c-cursor) { position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; will-change: transform; opacity: 0; }
  .construye :global(.c-cursor svg) {
    position: relative;
    display: block;
    width: 5.4cqh;
    height: 5.4cqh;
    fill: var(--cc);
    filter: drop-shadow(0 0.3cqh 0.3cqh rgb(0 0 0 / 0.18));
    scale: calc(1 - var(--clic, 0) * 0.2);
    transform-origin: 0.68cqh 0.68cqh;
  }
  .construye :global(.c-cursor b) {
    position: absolute;
    left: 4.2cqh;
    top: 4.8cqh;
    padding: 0.45cqh 1.8cqh;
    border-radius: 999px;
    background: var(--cc);
    color: #fff;
    font: 400 3.4cqh/1.5 var(--font-sans);
    white-space: nowrap;
  }
  .construye :global(.c-cursor .onda) {
    position: absolute;
    left: 0.68cqh;
    top: 0.68cqh;
    width: 9cqh;
    height: 9cqh;
    margin: -4.5cqh 0 0 -4.5cqh;
    border-radius: 50%;
    border: 0.45cqh solid var(--cc);
    opacity: calc((1 - var(--onda, 0)) * min(1, var(--onda, 0) * 20));
    scale: calc(0.2 + var(--onda, 0) * 1.3);
  }
  .construye :global(.c-cursor.agente) { --cc: var(--color-coral); }
  .construye :global(.c-cursor.andoni) { --cc: var(--color-cobalto); }
  .construye :global(.c-cursor.eric) { --cc: var(--color-cereza); }
  .construye :global(.c-pintura) {
    position: absolute;
    z-index: 1; /* por encima de las cajas y la retícula (ronda 188); los cursores, en z 2 */
    top: 0;
    left: 0;
    display: block;
    width: 100%; /* como la captura de .web: a lo ancho, desde arriba */
    height: auto;
    -webkit-mask: url('/media/rasgo-circulo.png') var(--ox) var(--oy) / 0% 0% no-repeat;
    mask: url('/media/rasgo-circulo.png') var(--ox) var(--oy) / 0% 0% no-repeat;
  }
  /* LA PANTALLA DE CARGA (sentado): noche con grano, «savvia», una línea que se llena y el dominio */
  .carga-web {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.6cqh;
    background: var(--noche);
    color: var(--color-niebla);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }
  .carga-logo {
    height: 9cqh;
    aspect-ratio: 2373 / 707; /* ronda 144: vuelve el logotipo de naturaleza (1184 × 439) */
    background: currentColor;
    -webkit-mask: url('/savvia-palabra.svg?v=228') center / contain no-repeat;
    mask: url('/savvia-palabra.svg?v=228') center / contain no-repeat;
  }
  .pantalla.estrenando .carga-web { opacity: 1; transition: opacity 0.7s ease 0.15s; }
  .carga-web .detail { font-size: 2.2cqh; color: color-mix(in oklab, var(--color-niebla) 60%, transparent); }
  .linea-carga {
    width: 22cqh;
    height: 2px;
    background: color-mix(in oklab, var(--color-niebla) 16%, transparent);
    overflow: hidden;
    position: relative;
  }
  .linea-carga::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-coral);
    transform-origin: 0 50%;
    animation: carga-linea 1.4s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }
  @keyframes carga-linea { 0% { transform: scaleX(0); } 60% { transform: scaleX(1); opacity: 1; } 100% { transform: scaleX(1); opacity: 0; } }
  [data-estudio].sentado .pantalla:has(.web.cargando:not([hidden])) .carga-web { opacity: 1; transition-duration: 0.2s; }
  /* el botón de la ficha, más sutil */
  /* RONDA 77 · Andoni: «el botón de ver case study, sin card: que sea solo texto»: texto con el subrayado que crece y la flecha que avanza */
  /* RONDA 134 · el CTA secundario de la casa (Cta.astro): solo el color, en la ficha de cristal sobre la foto */
  .ficha .ficha-ver { color: var(--color-niebla); }
  /* RONDA 172 · EL AVISO DE DESLIZAR (sentado, la primera vez): píldora de cristal al pie de la pantalla, con la rueda que baja; en unidades de la
     pantalla (cqh). La capa `capta-desliza` recoge el primer gesto (rueda, dedo o clic) y se quita: a partir de ahí, la web se recorre normal. */
  .aviso-desliza {
    position: absolute;
    left: 50%;
    bottom: 5cqh;
    z-index: 4; /* ronda 208: por encima de la pantalla de carga (z 3, la última en el documento) */
    display: flex;
    align-items: center;
    gap: 1.8cqh;
    padding: 0.9cqh 3.4cqh 0.9cqh 0.9cqh; /* ronda 213: el disco a ras del borde, como la píldora de la silla */ /* ronda 208: más grande (2,4 → 3,2 cqh de letra); era casi invisible */
    border-radius: 99px;
    background: color-mix(in oklab, var(--noche) 58%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 16%, transparent), 0 1cqh 3cqh -1cqh rgb(0 0 0 / 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--color-niebla);
    font: 500 3.2cqh/1 var(--font-sans);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: -50% 1.5cqh;
    transition: opacity 0.5s ease, translate 0.7s var(--ease-out-expo);
  }
  .aviso-desliza.on { opacity: 1; translate: -50% 0; }
  /* RONDA 213 · Eric: «el icono animado de mouse, que sea algo original, como el de la silla de sentarte»: igual que la silla (disco Coral, glifo de trazo en tinta
     oscura, entra con rebote y se endereza), pero una VENTANA por la que sube una página, en bucle: lo que hay que hacer dentro de la pantalla */
  .aviso-desliza .icono {
    flex: none;
    width: 5.6cqh;
    height: 5.6cqh;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-coral);
    scale: 0.35;
    rotate: -12deg;
    transition: scale 0.3s ease-in, rotate 0.3s ease-in;
  }
  .aviso-desliza.on .icono { scale: 1; rotate: 0deg; transition: scale 0.5s cubic-bezier(0.34, 1.9, 0.5, 1) 0.1s, rotate 0.8s var(--ease-out-expo) 0.2s; }
  .aviso-desliza .icono svg {
    width: 76%;
    height: 76%;
    stroke: #1b1714;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* ronda 214 (Eric: «pon un icono que se entienda mejor»): un chevrón hacia abajo que se enciende y baja, el gesto universal de «sigue bajando» */
  /* móvil: el monitor mide ~300 px y los cqh dejaban el aviso diminuto: en px, al pie de la pantalla (en el centro taparía la web que hay que deslizar) */
  @media (width < 48rem) {
    .aviso-desliza.fuera { position: fixed; bottom: auto; z-index: 60; translate: -50% calc(-100% + 6px); }
    .aviso-desliza.fuera.on { translate: -50% -100%; }
    .aviso-desliza { bottom: 12px; gap: 8px; padding: 5px 16px 5px 5px; font-size: 14px; background: color-mix(in oklab, var(--noche) 78%, transparent); }
    .aviso-desliza .icono { width: 28px; height: 28px; }
  }
  .aviso-desliza .ch { animation: ch-cascada 1.5s ease-in-out infinite; }
  @keyframes ch-cascada { 0%, 100% { opacity: 0.25; transform: translateY(-1px); } 40% { opacity: 1; transform: translateY(1.5px); } }
  @media (prefers-reduced-motion: reduce) { .aviso-desliza .ch { animation: none; } }
  /* RONDA 66 · «en proyectos destacados, quitamos el navegador» (y con él la píldora «desliza dentro») */
  .cromo,
  .tras-cromo,
  .capta {
    display: none !important;
  }
  /* RONDA 152 (2.ª) · «la entrada como antes, pero que puedas hacer scroll en la pantalla para ver el proyecto»: de pie, al mover el ratón sobre el
     monitor la pantalla coge el puntero (la web real o su página entera) y la píldora «desliza dentro» lo cuenta */
  [data-estudio]:not(.sentado) .escenario.explora .pantalla { pointer-events: auto; cursor: ns-resize; }
  [data-estudio]:not(.sentado) .escenario.explora .web { overscroll-behavior: contain; }
  /* RONDA 158 (Eric, Agentation: «en el slider de primeras hago clic en la pantalla y la web no me desliza») · de pie las cuatro webs están
     apiladas (las capturas que rotan) y las que no se ven, a opacidad 0, tapaban a la activa: la rueda caía en una transparente. Solo la activa
     coge el puntero. */
  [data-estudio]:not(.sentado) .web:not(.on) { pointer-events: none; }
  /* RONDA 157 · en B (sentado por scroll) el monitor se coge con un clic: la mano avisa; el esc no sale (de ahí se sale con el scroll) */
  [data-estudio]:not(.sentado) .escenario.asiento .arriba { display: none; } /* ronda 161: sentado desde B, el esc y la × sí */
  .web {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    outline: none;
  }
  .web::-webkit-scrollbar {
    display: none;
  }
  /* la captura y el iframe los crea el JS: sin el ámbito de Astro → :global (como las filas de los carriles, ronda 14) */
  .web :global(img),
  .web :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }
  /* RONDA 19: la web real. El iframe se maqueta a 1710 px (ronda 160; 1024 en móvil) y el JS lo reduce a la pantalla con `transform: scale`. */
  .web :global(iframe) {
    display: block;
    border: 0;
    /* ronda 159: sin fondo blanco; al reducirse, su primera fila y columna se mezclaban con él y dibujaban una línea clara contra el marco */
    background: transparent;
    transform-origin: 0 0;
  }
  .web:has(:global(iframe)) {
    overflow: hidden;
  }
  /* RONDA 290 · Eric (móvil): «a pesar de ser un vídeo, puedes deslizar arriba y abajo»: el vídeo llena la pantalla del monitor y no se desplaza */
  .web:has(:global(video)) {
    overflow: hidden;
  }
  .web :global(video) {
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  /* la página «carga»: aparece de arriba abajo cuando la barra de progreso termina */
  .web {
    clip-path: inset(0);
    transition:
      opacity 0.35s ease,
      clip-path 0.7s var(--ease-out-expo);
  }
  .web.cargando {
    opacity: 0;
    clip-path: inset(0 0 100% 0);
    transition: none;
  }

  /* ── INTERFAZ MÍNIMA: texto sobre la escena, sin cajas. Aparece al terminar de entrar. */
  .ui,
  .velo-ui,
  .llamada {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .dentro .ui,
  .dentro .velo-ui {
    opacity: 1;
  }
  /* RONDA 171 (Eric: «el botón estático de siéntate ya no tiene sentido»): solo para el teclado; se ve al enfocarlo */
  .dentro .llamada:focus-visible {
    opacity: 1;
  }
  .llamada:not(:focus-visible) {
    pointer-events: none;
  }
  .ui {
    position: absolute;
    color: var(--color-niebla);
    text-shadow: 0 1px 2px color-mix(in oklab, var(--noche-honda) 70%, transparent), 0 0 18px var(--noche-honda);
  }
  /* un velo Cacao abajo y otro, más leve, arriba: lo justo para que el texto se lea sobre cualquier estación */
  .velo-ui {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, color-mix(in oklab, var(--noche-honda) 80%, transparent), transparent 22%),
      linear-gradient(to bottom, color-mix(in oklab, var(--noche-honda) 88%, transparent) 8%, transparent 40%);
  }
  /* móvil: la ficha va ARRIBA, sobre el cielo (abajo pisaba la llamada de la silla); en escritorio, abajo a la izquierda */
  .ui-info {
    left: calc(var(--spacing) * 5);
    right: calc(var(--spacing) * 5);
    top: calc(var(--spacing) * 16);
  }
  .ficha:not([hidden]) {
    animation: enfocar 0.6s var(--ease-out-expo);
  }
  @keyframes enfocar {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }
  .muestra {
    width: calc(var(--spacing) * 3);
    height: calc(var(--spacing) * 3);
    border-radius: var(--radius-full);
    background: var(--c);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 40%, transparent);
  }
  /* EL DIAL. Móvil: una fila de números, centrada, encima de la barra. Escritorio: dial vertical (más abajo). */
  .ui-lista {
    left: 50%;
    translate: -50% 0;
    bottom: calc(var(--spacing) * 20);
  }
  .dial {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }
  .dial li:not(:nth-child(n + 9):nth-child(-n + 12)) {
    display: none; /* en móvil, solo la copia central */
  }
  .item {
    display: flex;
    gap: calc(var(--spacing) * 3);
    min-height: calc(var(--spacing) * 8);
    min-width: calc(var(--spacing) * 8);
    align-items: center;
    opacity: 0.5;
    transition: opacity 0.4s var(--ease-out-expo);
  }
  .item .nombre,
  .item .raya {
    display: none;
  }
  /* la raya que marca el activo, como en el esquema */
  .raya {
    width: calc(var(--spacing) * 3);
    height: 1px;
    background: currentColor;
    scale: 0 1;
    transform-origin: 0 50%;
    transition: scale 0.5s var(--ease-out-expo);
  }
  .item[aria-current='true'] .raya {
    scale: 1 1;
  }
  .ver {
    opacity: 0.7;
  }
  .ver:hover {
    opacity: 1;
  }
  .item[aria-current='true'] {
    opacity: 1;
  }
  .item[aria-current='true'] .num {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  /* CRISTAL (ronda 11): el material de la interfaz sobre la escena —lista, ficha y barra—, estilo Apple: desenfoque del fondo + velo
     Cacao + filo claro. Así se LEE sobre cualquier estación («el menú lateral con la info se lee mal»). */
  .cristal {
    background: color-mix(in oklab, var(--noche-honda) 58%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.5);
    backdrop-filter: blur(22px) saturate(1.5);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 16%, transparent),
      0 12px 32px -12px rgb(0 0 0 / 0.45);
    border-radius: calc(var(--spacing) * 4);
    text-shadow: none;
  }
  /* la barra inferior: píldora recogida con iconos */
  /* RONDA 21 · «el + sin la card cuadrada de fuera y el estilo como teníamos antes, semitransparente»: sin píldora; el (+) y las gotas son
     círculos de cristal (velo Cacao translúcido + desenfoque de fondo + filo) con el icono en Rosa niebla; pulsado = Rosa niebla con el icono en Cacao */
  .ui-mando {
    left: 50%;
    translate: -50% 0;
    bottom: max(calc(var(--spacing) * 4), env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
  }
  /* ── EL ABANICO DE ESTACIONES (ronda 19): el (+) y, alrededor, cuatro gotas que salen de él. Capa de gotas (Rosa niebla, opacas: el
     umbral del filtro gooey trabaja con el alfa) + botones transparentes encima. Ángulos: una circunferencia de 60 px, el arco de arriba. */
  .abanico {
    --R: 64px;
    position: relative;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
  }
  .abanico .blobs {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.22; /* la capa líquida es translúcida: el umbral del gooey trabaja antes, sobre las gotas opacas; la opacidad va después */
  }
  .abanico.fundiendo .blobs {
    filter: url(#goo-estaciones);
  }
  .abanico .blob,
  .abanico .grupo .est {
    --a: calc(-200deg + var(--i, 0) * 50deg); /* −200 · −150 · −100 · −50 · 0: del lado izquierdo al lado derecho (ronda 20: la quinta es el sonido) */
    --tx: calc(cos(var(--a)) * var(--R));
    --ty: calc(sin(var(--a)) * var(--R));
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--spacing) * 9);
    height: calc(var(--spacing) * 9);
    margin: calc(var(--spacing) * -4.5) 0 0 calc(var(--spacing) * -4.5);
    border-radius: 50%;
    translate: 0 0;
    transition:
      translate 0.55s cubic-bezier(0.4, 0, 0.2, 1) calc((4 - var(--i, 0)) * 35ms),
      scale 0.45s cubic-bezier(0.4, 0, 0.2, 1) calc((4 - var(--i, 0)) * 35ms),
      opacity 0.3s ease;
  }
  .abanico .blob {
    background: var(--color-niebla);
    scale: 0.35;
  }
  .abanico .blob.mas-blob {
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    margin: calc(var(--spacing) * -6) 0 0 calc(var(--spacing) * -6);
    scale: 1;
  }
  .abanico.abierto .blob:not(.mas-blob),
  .abanico.abierto .grupo .est {
    translate: var(--tx) var(--ty);
    scale: 1;
    /* al abrirse, con muelle (se pasa un poco y vuelve); al cerrarse, sin rebote */
    transition:
      translate 0.7s cubic-bezier(0.34, 1.45, 0.5, 1) calc(var(--i, 0) * 45ms),
      scale 0.6s cubic-bezier(0.34, 1.45, 0.5, 1) calc(var(--i, 0) * 45ms),
      opacity 0.3s ease calc(var(--i, 0) * 45ms);
  }
  .mas-rotulo {
    position: absolute;
    left: calc(100% + var(--spacing) * 3);
    top: 50%;
    translate: 0 -50%;
    white-space: nowrap;
    color: var(--color-niebla);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.55);
    pointer-events: none;
    transition: opacity 0.4s ease, translate 0.5s var(--ease-out-expo);
  }
  .abanico.abierto .mas-rotulo {
    opacity: 0;
    translate: 8px -50%;
  }
  [data-estudio].sentado .mas-rotulo { opacity: 0; }
  .abanico .mas {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: color-mix(in oklab, var(--color-niebla) 80%, transparent);
    background: color-mix(in oklab, var(--noche-honda) 52%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 18%, transparent), 0 10px 28px -12px rgb(0 0 0 / 0.45);
    transition: color 0.3s var(--ease-out-expo), background-color 0.3s var(--ease-out-expo);
  }
  .abanico .mas:hover {
    color: var(--color-niebla);
    background: color-mix(in oklab, var(--noche-honda) 40%, transparent);
  }
  .abanico .mas :global(svg) {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
    transition: rotate 0.5s var(--ease-out-expo);
  }
  .abanico.abierto .mas :global(svg) {
    rotate: 45deg; /* el (+) se vuelve una × */
  }
  .abanico .grupo {
    position: absolute;
    inset: 0;
    pointer-events: none; /* RONDA 22: el grupo (una caja de 48 px encima del (+)) NUNCA coge el puntero: abierto tapaba la × y «costaba cerrarlo» */
  }
  .abanico.abierto .grupo .est {
    pointer-events: auto;
  }
  .ui-mando .abanico .grupo .est {
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--noche-honda) 52%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    backdrop-filter: blur(18px) saturate(1.4);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 18%, transparent);
    color: color-mix(in oklab, var(--color-niebla) 75%, transparent);
    opacity: 0;
  }
  .ui-mando .abanico.abierto .grupo .est {
    opacity: 1;
  }
  .ui-mando .abanico .grupo .est :global(svg) {
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
  }
  .ui-mando .abanico .grupo .est:hover {
    background: color-mix(in oklab, var(--color-niebla) 14%, color-mix(in oklab, var(--noche-honda) 45%, transparent));
    color: var(--color-niebla);
    scale: 1.1;
  }
  .ui-mando .abanico .grupo .est[aria-pressed='true'] {
    background: var(--color-niebla);
    color: var(--color-cacao);
  }
  .ui-mando .grupo {
    display: flex;
    gap: calc(var(--spacing) * 1);
  }
  .ui-mando[hidden],
  .barra[hidden] {
    display: none;
  }
  .sep {
    width: 1px;
    height: calc(var(--spacing) * 6);
    margin-inline: calc(var(--spacing) * 1);
    background: color-mix(in oklab, var(--color-niebla) 18%, transparent);
  }
  .ui-mando .est {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    border-radius: calc(var(--spacing) * 4);
    color: color-mix(in oklab, var(--color-niebla) 70%, transparent);
    transition:
      background-color 0.3s var(--ease-out-expo),
      color 0.3s var(--ease-out-expo),
      scale 0.3s var(--ease-out-expo);
  }
  .ui-mando .est :global(svg) {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
  }
  .ui-mando .est:hover {
    color: var(--color-niebla);
    background: color-mix(in oklab, var(--color-niebla) 10%, transparent);
  }
  .ui-mando .est:active {
    scale: 0.94;
  }
  .ui-mando .est[aria-pressed='true'] {
    color: var(--color-cacao);
    background: var(--color-niebla);
  }
  [data-sonido] .son-on,
  [data-sonido][aria-pressed='true'] .son-off { display: none; }
  [data-sonido][aria-pressed='true'] .son-on,
  [data-sonido] .son-off { display: grid; }
  /* la etiqueta del botón: sale encima al pasar o enfocar */
  .rotulo {
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--spacing) * 3);
    translate: -50% 4px;
    padding: calc(var(--spacing) * 1) calc(var(--spacing) * 2);
    border-radius: calc(var(--spacing) * 2);
    background: var(--color-niebla);
    color: var(--color-cacao);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.25s ease,
      translate 0.35s var(--ease-out-expo);
  }
  .est:hover .rotulo,
  .est:focus-visible .rotulo {
    opacity: 1;
    translate: -50% 0;
  }
  /* RONDA 144 (3.ª) · «al pasar por los iconos no sale el tooltip»: el icono que se mira sube por encima de sus vecinos (el de al lado tapaba su rótulo) */
  .abanico .grupo .est:hover,
  .abanico .grupo .est:focus-visible { z-index: 5; }
  .rotulo { z-index: 6; box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.5); }
  /* RONDA 144 (4.ª) · «al pasar por estos iconos no quiero que salga nada de info»: fuera los rótulos (el nombre queda en aria-label) */
  .abanico .grupo .est .rotulo { display: none; }
  .barra {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .barra > * {
    pointer-events: auto;
  }
  /* RONDA 68 · arriba en el centro, un solo cristal: esc + la × (en la esquina estaba el botón del menú). RONDA 76 · vuelven los redondeos:
     píldoras y botones redondos, sin cruces. */
  .arriba {
    border-radius: var(--radius-full);
    position: absolute;
    left: 50%;
    top: max(calc(var(--spacing) * 6), env(safe-area-inset-top));
    translate: -50% 0;
    display: flex;
    align-items: center;
    padding: calc(var(--spacing) * 1);
    color: var(--color-niebla);
    white-space: nowrap;
  }
  .escenario.aleja { cursor: zoom-out; }
  .cerrar {
    border-radius: var(--radius-full);
    height: calc(var(--spacing) * 10);
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding-inline: calc(var(--spacing) * 3) calc(var(--spacing) * 2);
    color: var(--color-niebla);
    font-size: var(--text-ui);
    font-weight: 500;
    transition: scale 0.3s var(--ease-out-expo), background-color 0.3s ease, color 0.3s ease;
  }
  /* RONDA 188 · Eric: «este hovering es bastante feo»: el relleno Rosa niebla dentro del cristal oscuro dejaba un aro grueso alrededor.
     Ahora el cristal solo se aclara un poco y la × gira; el texto no cambia de color. */
  .cerrar:hover,
  .cerrar:focus-visible {
    background: color-mix(in oklab, var(--color-niebla) 12%, transparent);
  }
  .cerrar :global(svg) { transition: rotate 0.45s var(--ease-out-expo); }
  .cerrar:hover :global(svg) { rotate: 90deg; }
  .cerrar:active {
    scale: 0.96;
  }
  .cerrar :global(svg) {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  .otros {
    border-radius: var(--radius-full);
    position: absolute;
    left: 50%;
    bottom: max(calc(var(--spacing) * 6), env(safe-area-inset-bottom));
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    padding: calc(var(--spacing) * 1);
    color: var(--color-niebla);
    white-space: nowrap;
  }
  .otros .paso {
    border-radius: 50%;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    display: grid;
    place-items: center;
    transition: background-color 0.3s ease, color 0.3s ease, scale 0.3s var(--ease-out-expo);
  }
  .otros .paso:hover {
    background: var(--color-niebla);
    color: var(--color-cacao);
  }
  .otros .paso:active {
    scale: 0.94;
  }
  .otros svg {
    width: calc(var(--spacing) * 6);
    height: calc(var(--spacing) * 6);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .cual {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 3);
    min-width: calc(var(--spacing) * 48);
    justify-content: center;
    font-size: var(--text-ui);
    font-weight: 500;
  }
  kbd {
    border-radius: 6px;
    font: inherit;
    font-size: 0.85em;
    padding: 0 calc(var(--spacing) * 2);
    line-height: 1.6;
    background: color-mix(in oklab, var(--color-niebla) 16%, transparent);
  }
  @media (hover: none) {
    .salir { display: none; } /* en táctil no hay tecla Esc: queda «Levantarse» */
  }

  /* ── LA LLAMADA «SENTARSE»: punto en el respaldo de la silla, línea a 45° y la palabra. Vive en coordenadas de la lámina. */
  .llamada {
    /* la caja del botón va del punto (esquina inferior izquierda) a la palabra: así tiene área de clic y anillo de foco reales */
    position: absolute;
    left: 58.7%;
    top: 81%;
    width: 216px;
    height: 72px;
    translate: 0 -100%;
    color: var(--color-niebla);
    cursor: pointer;
  }
  .punto-silla {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 10px;
    height: 10px;
    margin: -5px;
    border-radius: var(--radius-full);
    background: currentColor;
  }
  .punto-silla::after {
    content: '';
    position: absolute;
    inset: -7px;
    border-radius: inherit;
    border: 1px solid currentColor;
    animation: latido 2.6s var(--ease-out-expo) infinite;
  }
  @keyframes latido {
    from { transform: scale(0.5); opacity: 0.9; }
    to { transform: scale(1.5); opacity: 0; }
  }
  .linea {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 120px;
    height: 64px;
    overflow: visible;
  }
  .linea path {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .llamada span {
    position: absolute;
    left: 128px;
    top: 0;
    line-height: 28px; /* la línea llega a y = 6 de 64 desde arriba de su caja: el centro de la palabra cae ahí */
    white-space: nowrap;
    text-shadow: 0 1px 12px color-mix(in oklab, var(--noche-honda) 80%, transparent);
  }
  /* ronda 136 · sin subrayado al pasar: la palabra se aviva */
  .llamada span { transition: opacity 0.4s var(--ease-out-expo); }
  .llamada:not(:hover):not(:focus-visible) span { opacity: 0.86; }
  /* en móvil la silla queda cerca del borde derecho: la llamada sale hacia la izquierda */
  @media (width < 48rem) {
    .llamada {
      translate: -100% -100%;
    }
    .punto-silla {
      left: auto;
      right: 0;
    }
    .linea {
      left: auto;
      right: 0;
      scale: -1 1;
    }
    .llamada span {
      left: auto;
      right: 128px;
      width: 8.5rem; /* ronda 152: en móvil la palabra se salía de la pantalla por la izquierda: en dos líneas */
      white-space: normal;
      text-align: right;
    }
  }

  @media (width >= 64rem) {
    .ui-info {
      left: auto;
      right: calc(var(--spacing) * 12);
      top: 50%;
      translate: 0 -50%;
      width: min(22vw, 20rem);
      font-weight: 500;
    }
    /* escritorio: la interfaz va a los LADOS del ordenador (esquema de Andoni) → velos laterales, y uno abajo para el mando */
    /* RONDA 13 · «que los gradientes de izquierda y derecha sean radiales, así se van a ver más en la zona de los textos»: dos elipses
       centradas en el dial (izquierda) y en la ficha (derecha); lo más hondo cae justo detrás del texto y se abre hacia el monitor. */
    .velo-ui {
      background:
        radial-gradient(ellipse min(26vw, 26rem) 42% at calc(var(--spacing) * 12 + min(12vw, 11rem)) 50%, color-mix(in oklab, var(--noche-honda) 94%, transparent), color-mix(in oklab, var(--noche-honda) 62%, transparent) 50%, transparent),
        radial-gradient(ellipse min(25vw, 25rem) 42% at calc(100% - var(--spacing) * 12 - min(11vw, 10rem)) 50%, color-mix(in oklab, var(--noche-honda) 94%, transparent), color-mix(in oklab, var(--noche-honda) 62%, transparent) 50%, transparent),
        linear-gradient(to top, color-mix(in oklab, var(--noche-honda) 70%, transparent), transparent 24%);
    }
    /* el dial: una ventana de 5 filas; el activo en el centro; arriba y abajo se funde (máscara) y cada fila pierde foco con la distancia */
    .ui-lista {
      --fila: calc(var(--spacing) * 12);
      left: calc(var(--spacing) * 12);
      right: auto;
      top: 50%;
      bottom: auto;
      translate: 0 -50%;
      height: calc(var(--fila) * 5);
      width: min(24vw, 22rem);
      overflow: hidden;
      font-size: var(--text-lead);
      mask-image: linear-gradient(to bottom, transparent, #000 32%, #000 68%, transparent);
    }
    .dial {
      display: block;
      padding-top: calc(var(--fila) * 2); /* la fila `pos` cae en el centro de la ventana */
      transition: transform 0.7s var(--ease-out-expo);
    }
    .dial.sin,
    .dial.sin .item {
      transition: none;
    }
    .dial li:not(:nth-child(n + 9):nth-child(-n + 12)) {
      display: block;
    }
    .dial .item {
      height: var(--fila);
      width: 100%;
      opacity: calc(1 - var(--d, 0) * 0.34);
      filter: blur(calc(var(--d, 0) * 1.5px));
      scale: calc(1 - var(--d, 0) * 0.05);
      transform-origin: 0 50%;
      transition:
        opacity 0.6s var(--ease-out-expo),
        filter 0.6s var(--ease-out-expo),
        scale 0.6s var(--ease-out-expo);
    }
    .item .nombre {
      display: inline;
    }
    .item .num {
      display: none;
    }
    .item .raya {
      display: block;
    }
    .ui-mando {
      bottom: calc(var(--spacing) * 8);
    }
  }

  /* RONDA 41 · la capa que recoge el PRIMER gesto de scroll sobre la web */
  .capta {
    position: absolute;
    inset: 4.6cqh 0 0;
    z-index: 3;
  }
  /* ── RONDA 39 · LA SEÑAL DE SCROLL dentro de la pantalla: una píldora oscura al pie de la web con la rueda del ratón bajando.
     Todo en unidades de la pantalla (cqh/cqw): crece con ella. Nace invisible (regla dura 3); la enciende el JS. */
  .pista-scroll {
    position: absolute;
    left: 50%;
    bottom: 4cqh;
    z-index: 3;
    display: flex;
    align-items: center;
    /* RONDA 159 (Eric: «este aviso, más minimalista y acorde con el diseño: está enorme») · píldora pequeña de cristal, como la del esc */
    gap: 1.2cqh;
    padding: 1.1cqh 2.2cqh 1.1cqh 1.6cqh;
    border-radius: 99px;
    background: color-mix(in oklab, var(--noche) 52%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 16%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: color-mix(in oklab, var(--color-niebla) 88%, transparent);
    font-family: var(--font-mono);
    font-size: max(8px, 2.4cqh);
    letter-spacing: 0.02em;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    translate: -50% 30%;
    transition: opacity 0.5s ease, translate 0.7s var(--ease-out-expo);
  }
  .pista-scroll.on {
    opacity: 1;
    translate: -50% 0;
    transition-delay: 0.6s;
  }
  .raton {
    position: relative;
    display: block;
    width: max(6px, 2.4cqh);
    height: max(9px, 3.8cqh);
    border: 1px solid currentColor;
    border-radius: 99px;
  }
  .raton i {
    position: absolute;
    left: 50%;
    top: 22%;
    width: 1px;
    height: 24%;
    margin-left: -0.5px;
    border-radius: 2px;
    background: currentColor;
    animation: rueda 1.6s var(--ease-out-expo) infinite;
  }
  @keyframes rueda {
    0% { translate: 0 0; opacity: 0; }
    20% { opacity: 1; }
    70% { translate: 0 120%; opacity: 0; }
    100% { translate: 0 120%; opacity: 0; }
  }
  /* RONDA 160 · la etiqueta que sigue al cursor sobre el monitor y el filo de savia de la pantalla cogida */
  .sigue-cursor {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 60;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .sigue-cursor.on {
    opacity: 1;
  }
  .sigue-cursor .txt {
    position: absolute;
    left: 0;
    top: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 13px 4px 4px;
    border-radius: 99px;
    background: color-mix(in oklab, var(--noche-honda) 64%, transparent); /* ronda 177: --noche-honda (en invierno --noche es nieve y el texto claro no se leía) */
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 14%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--color-niebla);
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 12.5px;
    line-height: 1;
    white-space: nowrap;
    /* RONDA 163 (Eric: «que el ratón se convierta en eso que acabamos de diseñar, para que el usuario se dé cuenta; que se transforme tipo
       liquid»): la píldora ES el cursor: el centro del círculo de la silla va en la punta del puntero (sin retraso) y la flecha del sistema se
       oculta. Al aparecer nace como una GOTA de savia del tamaño del círculo y se estira hasta la píldora con un rebote líquido; al irse, se recoge. */
    transform: translate(calc(var(--x) - 17px), calc(var(--y) - 17px));
    clip-path: inset(0 calc(100% - 34px) 0 0 round 99px);
    transition: clip-path 0.35s cubic-bezier(0.5, 0, 0.75, 0);
  }
  /* móvil: sin puntero, la píldora se centra en el monitor (el punto --x --y es el centro) y nace y se recoge desde su centro */
  .sigue-cursor.fija .txt { transform: translate(calc(var(--x) - 50%), calc(var(--y) - 50%)); clip-path: inset(0 calc(50% - 17px) 0 calc(50% - 17px) round 99px); }
  .sigue-cursor.fija.on .txt { clip-path: inset(0 0 0 0 round 99px); }
  .sigue-cursor.on .txt {
    clip-path: inset(0 0 0 0 round 99px);
    transition: clip-path 0.75s cubic-bezier(0.34, 1.5, 0.5, 1) 0.12s;
  }
  /* ronda 163 (Eric: «el clic para sentarte tiene que tener diseño, como de una silla; el ratón lo quitamos»): una silla de escritorio, la de la escena */
  .sigue-cursor .silla {
    width: 26px;
    height: 26px;
    padding: 3.5px;
    border-radius: 50%;
    background: var(--color-coral);
    stroke: #1b1714;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    scale: 0.35;
    rotate: -12deg;
    transition: scale 0.3s ease-in, rotate 0.3s ease-in;
  }
  /* la gota se hincha de golpe (con rebote) y la silla se endereza, como al girarla para sentarte */
  .sigue-cursor.on .silla { scale: 1; rotate: 0deg; transition: scale 0.5s cubic-bezier(0.34, 1.9, 0.5, 1), rotate 0.8s var(--ease-out-expo) 0.1s; }
  .escenario.mira, .escenario.mira * { cursor: none; } /* ronda 163: el cursor es la silla */
  /* RONDA 160 (3.ª, Eric: «el recuadro de fuera tiene que casar con el del ordenador, con sus redondeados; mejor una luz difuminada, como si
     estuviese detrás de la pantalla»): al coger la web, un resplandor de savia muy desenfocado que asoma POR DETRÁS del monitor. Es la sombra de
     una caja con el rectángulo y el redondeo del monitor (los del marco de sentado, medidos en la lámina): una box-shadow exterior nunca se
     pinta bajo su propia caja, así que el monitor queda limpio y la luz solo sale alrededor. */
  .halo-monitor {
    position: absolute;
    left: calc(39.03% - 0.469%);
    top: calc(36.96% - 0.741%);
    width: calc(21.78% + 0.938%);
    height: calc(21.04% + 1.482%);
    border-radius: 1.16% / 2.07%;
    pointer-events: none;
    opacity: 0;
    /* el color de la luz, por estación (Eric: «hay que ver el color para cada estación»): la savia de la estación, pero más viva
       donde el paisaje se la come (primavera: rosa sobre cielo rosa; invierno: azul sobre nieve azulada) */
    --halo: var(--color-coral);
    --halo-a: 55%;
    --halo-b: 22%;
    box-shadow:
      0 0 calc(3vw / var(--k, 1)) calc(0.6vw / var(--k, 1)) color-mix(in oklab, var(--halo) var(--halo-a), transparent),
      0 0 calc(9vw / var(--k, 1)) calc(2vw / var(--k, 1)) color-mix(in oklab, var(--halo) var(--halo-b), transparent);
    transition: opacity 0.9s var(--ease-out-expo);
  }
  :global(html[data-estacion='primavera']) .halo-monitor { --halo: #ff4f95; --halo-a: 75%; --halo-b: 30%; }
  :global(html[data-estacion='verano']) .halo-monitor { --halo: #d4f56a; --halo-a: 80%; --halo-b: 34%; }
  :global(html[data-estacion='invierno']) .halo-monitor { --halo: #7fb4ff; --halo-a: 85%; --halo-b: 38%; }
  .escenario.explora .halo-monitor {
    opacity: 1;
  }
  /* RONDA 163 (Eric: «cuando estamos sentados, recuperemos el fade blur de detrás de la pantalla, para indicar que el ordenador está encendido»):
     sentado, la luz se enciende al posarse la cámara. La escena va ×k: el desenfoque se divide por k para medir lo mismo en pantalla. */
  [data-estudio].sentado .halo-monitor {
    opacity: 1;
    transition-delay: 0.2s; /* ronda 164 (Eric): «1 segundo antes, al hacer clic en sentarte» (antes 1,2 s, al posarse la cámara) */
  }
  @media (prefers-reduced-motion: reduce) {
    .sigue-cursor, .sigue-cursor * { transition: none; animation: none; }
    .pantalla { transition: none; }
  }
  [data-estudio].sentado .pista-scroll {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .raton i { animation: none; }
  }

  /* ── RONDA 39 · LA GUÍA DEL DIAL (solo escritorio): «Proyectos 01/04» y flechas arriba y abajo de la ventana del dial */
  /* móvil: las flechas a los lados del nombre del proyecto, centradas sobre el (+); el dial de números se va */
  .ui-guia {
    left: 50%;
    translate: -50% 0;
    bottom: calc(var(--spacing) * 20);
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }
  .guia-nombre {
    min-width: 12ch;
    text-align: center;
    font-size: var(--text-ui);
    font-weight: 500;
  }
  .ui-guia .giro {
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    display: grid;
    place-items: center;
    color: var(--color-niebla);
  }
  .ui-guia .giro :global(svg) {
    width: calc(var(--spacing) * 5);
    height: calc(var(--spacing) * 5);
    rotate: -90deg;
  }
  .ui-guia .giro.arriba { order: -1; }
  @media (width < 64rem) {
    .ui-lista { display: none; }
  }
  @media (width >= 64rem) {
    .guia-nombre { display: none; }
    .ui-guia .giro :global(svg) { rotate: none; }
    .ui-guia {
      --fila: calc(var(--spacing) * 12);
      display: block;
      translate: none;
      bottom: auto;
      left: calc(var(--spacing) * 12);
      top: 50%;
      width: min(24vw, 22rem);
      height: 0;
    }
    .giro {
      position: absolute;
      left: calc(var(--spacing) * -2);
      width: calc(var(--spacing) * 10);
      height: calc(var(--spacing) * 10);
      display: grid;
      place-items: center;
      border-radius: 50%;
      color: var(--color-niebla);
      opacity: 0.7;
      transition: opacity 0.3s ease, background-color 0.3s ease, translate 0.4s var(--ease-out-expo);
    }
    .giro:hover,
    .giro:focus-visible {
      opacity: 1;
      background: color-mix(in oklab, var(--color-niebla) 12%, transparent);
    }
    .giro :global(svg) {
      width: calc(var(--spacing) * 5);
      height: calc(var(--spacing) * 5);
    }
    .giro.arriba {
      bottom: calc(var(--fila) * 2.5 + var(--spacing) * 1);
    }
    .giro.abajo {
      top: calc(var(--fila) * 2.5 + var(--spacing) * 1);
    }
    .giro.arriba:hover { translate: 0 -2px; }
    .giro.abajo:hover { translate: 0 2px; }
    /* al llegar, las flechas laten dos veces (acompañan al empujón del dial) */
    .late .giro {
      animation: late 0.8s ease-in-out 1.1s 2;
    }
    @keyframes late {
      50% { opacity: 1; background: color-mix(in oklab, var(--color-niebla) 16%, transparent); }
    }
    .ui-lista {
      cursor: ns-resize;
    }
    [data-estudio].sentado .ui-guia {
      opacity: 0;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .raton i,
    .late .giro {
      animation: none;
    }
  }

  /* Sentado: el escenario ocupa la ventana, la cámara se acerca y el paisaje pierde foco. */
  [data-estudio].sentado .escenario {
    position: fixed;
    z-index: 60; /* escala de z: 0 contenido · 48 velo · 50 menú · 55 nav · 60 escenario sentado */
    inset: 0;
    width: auto;
    height: auto;
  }
  /* RONDA 10: sentado NO se desenfoca nada (el monitor es parte de la lámina y se difuminaba con ella) y el zoom es menor. */
  [data-estudio].sentado .web {
    overscroll-behavior: contain;
  }
  [data-estudio].sentado .ui-lista,
  [data-estudio].sentado .llamada,
  [data-estudio].sentado .velo-ui {
    opacity: 0;
    pointer-events: none;
  }
  /* RONDA 65 · de pie, la escena solo invita a sentarse y a cambiar de estación: ni ficha, ni dial, ni flechas */
  [data-estudio]:not(.sentado) .escenario:not(.asiento) .ui-info,
  [data-estudio] .ui-lista,
  [data-estudio] .ui-guia,
  [data-estudio]:not(.sentado) .velo-ui {
    opacity: 0 !important;
    visibility: hidden;
    pointer-events: none !important;
  }
  /* sentado: la ficha reducida, en cristal, al lado del monitor (en móvil, sobre el selector de proyecto) */
  [data-estudio].sentado .ui-info {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.6s ease 1.1s; /* entra cuando la cámara se ha posado */
  }
  /* RONDA 157 · en B, la misma ficha que sentado (entra con el selector, sin esperar al dolly) */
  [data-estudio]:not(.sentado) .escenario.asiento .ui-info {
    opacity: 1;
    pointer-events: auto;
    transition: opacity 0.6s ease 0.2s;
  }
  .ficha {
    padding: calc(var(--spacing) * 6);
    border-radius: calc(var(--spacing) * 4);
    background: color-mix(in oklab, var(--color-cacao) 58%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-niebla) 16%, transparent);
    color: var(--color-niebla);
  }
  .ficha-cat { color: color-mix(in oklab, var(--color-niebla) 70%, transparent); }
  .ficha-n { font-size: var(--text-h3); line-height: 1.1; margin-top: calc(var(--spacing) * 2); text-wrap: balance; }
  .ficha-d { color: color-mix(in oklab, var(--color-niebla) 80%, transparent); text-wrap: pretty; }
  .ficha,
  .ficha * { text-shadow: none; }
  @media (width >= 64rem) {
    [data-estudio].sentado .ui-info,
    .escenario.asiento .ui-info { right: calc(var(--spacing) * 6); width: min(19vw, 20rem); }
  }
  @media (width < 64rem) {
    [data-estudio].sentado .ui-info,
    .escenario.asiento .ui-info { top: auto; bottom: calc(var(--spacing) * 24); }
    .ficha { padding: calc(var(--spacing) * 4); }
    .ficha-d { display: none; }
    .ficha-ver { margin-top: calc(var(--spacing) * 3); }
  }
  /* RONDA 264 · Eric: «el banner de Playground IEP (categoría, nombre y ver caso de estudio) en mobile lo quitamos por espacio»; en escritorio se mantiene */
  @media (width < 48rem) {
    [data-estudio] .ui-info { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .escena,
    .capa,
    .item,
    .est,
    .blob,
    .ui,
    .llamada {
      transition: none;
    }
    .ficha:not([hidden]) {
      animation: none;
    }
    .punto-silla::after {
      animation: none;
      opacity: 0.5;
    }
  }
</style>


<style is:global>
  /* sin JS no hay entrada: el titular-pantalla no debe tapar la escena */
  html:not(.js) [data-titulo] {
    display: none;
  }
  html.estudio-sentado {
    overflow: hidden;
  }
  /* RONDA 171 (Eric, capturas: la ola y una banda blanca de la sección siguiente encima, al sentarse con la sección saliendo): el escenario fijo vive
     dentro del contexto de apilamiento de su sección; sentado, la sección entera sube por encima de las siguientes */
  [data-estudio].sentado,
  html.estudio-sentado [data-estudio] { /* (este bloque es global: sin :global(), que lo invalidaba entero) */
    position: relative;
    z-index: 58;
  }
</style>
