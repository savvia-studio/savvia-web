---
import sharp from 'sharp';
import Cta from './Cta.astro';
import { home } from '../data/idioma';
import { langDe, ruta } from '../lib/i18n';
import { icono, ICONO_ESTACION } from '../lib/iconos';
// RONDA 152 · los iconos de estación y de la interfaz, de la iconografía de la casa (Phosphor: estaciones rellenas, interfaz regular)
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { proyectos } = home(lang);
const P = proyectos.nuevos;
// RONDA 50 · el TINTE del cristal de la barra: el color medio de la cabecera de cada web (la franja de arriba de su captura, el 4,2 % de su ancho: ~60 px a 1440), medido al compilar
const TINTE: Record<string, string> = {};
for (const p of P) {
  // ronda 126: si falta la captura (un proyecto recién renombrado), el tinte por defecto en vez de romper la página
  const img = sharp(`public/media/proyectos/${p.slug}.webp`);
  const { width = 1 } = await img.metadata().catch(() => ({ width: 0 }));
  if (!width) { TINTE[p.slug] = 'rgb(251 251 250)'; continue; }
  const franja = await img.extract({ left: 0, top: 0, width, height: Math.round(width * 0.042) }).removeAlpha().raw().toBuffer({ resolveWithObject: true });
  let r = 0, g = 0, b = 0; const n = franja.data.length / 3;
  for (let i = 0; i < franja.data.length; i += 3) { r += franja.data[i]; g += franja.data[i + 1]; b += franja.data[i + 2]; }
  TINTE[p.slug] = `rgb(${Math.round(r / n)} ${Math.round(g / n)} ${Math.round(b / n)})`;
}
// ronda 152: la captura de página entera (las webs que no se dejan embeber, para recorrerlas)
const LARGO: Record<string, boolean> = {};
const PESADAS = ['arkdev']; // webs que en el móvil tumban Safari (memoria): allí se pintan más pequeñas (1024 px)
// RONDA 270 · en MÓVIL el monitor enseña un VÍDEO (Screen Studio) en lugar de la web en vivo: el iframe a 1280 px reventaba la memoria de Safari
const VIDEO: Record<string, boolean> = {};
for (const p of P) VIDEO[p.slug] = await sharp(`public/media/proyectos/video/${p.slug}.jpg`).metadata().then(() => true).catch(() => false); // existe el póster = existe el vídeo
for (const p of P) LARGO[p.slug] = await sharp(`public/media/proyectos/${p.slug}-largo.webp`).metadata().then(() => true).catch(() => false);
const EST = ['primavera', 'verano', 'otono', 'invierno'];
const nombreEst: Record<string, string> = en ? { primavera: 'Spring', verano: 'Summer', otono: 'Autumn', invierno: 'Winter' } : { primavera: 'Primavera', verano: 'Verano', otono: 'Otoño', invierno: 'Invierno' };
const pad = (n: number) => String(n).padStart(2, '0');
---

<!--
  EL ESTUDIO (ronda 9). Los proyectos se ven DENTRO del ordenador de la mesa. EL PROTAGONISTA SON LOS PROYECTOS.
  · ENTRAR: al hacer scroll hacia la escena, llega como una lámina enmarcada y crece hasta llenar la pantalla: entras en ella.
    (Pista sticky corta: 100 + 60 lvh. NO pasa proyectos con el scroll: eso sigue siendo lista, flechas o teclado.)
  · Interfaz MÍNIMA sobre la escena, sin cajas: el proyecto abajo a la izquierda, la lista abajo a la derecha, estación y sonido en una línea.
  · SENTARSE sale de la SILLA con una línea de llamada (el recurso clásico de anotar un objeto). Esc o «Levantarse» sale.
  · La web de dentro del monitor se puede recorrer SIEMPRE, también sin sentarse (se activa al mover el ratón por la escena,
    para que un scroll de página con el cursor quieto en el centro no se quede atrapado dentro del monitor).
  · Cada estación trae un detalle SUTIL en el paisaje, tras el cristal: hojas en otoño, nieve en invierno, pétalos en primavera,
    motas de luz en verano. Nunca por delante del monitor ni de los montantes de la ventana.
  Rectángulo de la pantalla medido en la lámina (1920×1080): left 39,219 % · top 37,130 % · 21,406 % × 20,926 %.
  RONDA 19 · láminas NUEVAS de Andoni (la luz cambia con la estación; 1672×941, pegadas en el chat: hace falta el archivo original a 4K):
  pantalla medida por inundación en las cuatro → left 39,18 % · top 37,08 % · 21,48 % × 20,85 % (recortando 0,1 % de bisel).
  RONDA 19 · dentro del monitor va la WEB REAL en un <iframe> (referencia: la maqueta de Eric en Webflow: iframe a 1680 px reducido con
  `transform: scale`): se ven sus animaciones. Solo se monta la del proyecto activo; la que no se deja embeber (Neety) enseña su captura.
  La silla: el centro de su respaldo cae en (58,7 % · 81 %).
-->
<section id="proyectos" class="surface-dark" aria-label={proyectos.pregunta} data-estudio data-sin-fila>
  <div class="pista" data-pista>
    <div class="pegado">
      <div class="escenario" data-escenario>
        <div class="escena" data-escena>
          {
            EST.map((e) => (
              <img class="capa" data-capa={e} data-src={`/media/estudio/${e}.webp`} data-src-m={`/media/estudio/${e}-m.webp`} data-src-xl={`/media/estudio/${e}-xl.webp`} alt="" decoding="async" />
            ))
          }
          <canvas class="aire" aria-hidden="true" data-aire></canvas>
          <!-- RONDA 14 · sentado, el marco del monitor en CSS (nítido a cualquier zoom): pisa al de la foto, que al ampliarse queda blanda.
               RONDA 18 · «cuando te sientas dejamos toda la imagen nítida sin nada»: sentado NO se desenfoca nada (ni paisaje ni aire). -->
          <i class="marco-monitor" aria-hidden="true"></i>
          <!-- RONDA 160: la luz de detrás del monitor al coger la web (la caja tiene la forma del monitor; su sombra solo se pinta por FUERA) -->
          <i class="halo-monitor" aria-hidden="true"></i>
          <div class="pantalla" data-pantalla>
            <!-- La web, ABIERTA EN UN NAVEGADOR: barra con semáforo y dirección; debajo, la página, que se recorre. -->
            <!-- Safari: semáforo, barra lateral, atrás/adelante, campo de dirección con candado y recarga, compartir · nueva · pestañas,
                 y la barra de progreso de la carga. Todo en unidades de la propia pantalla (cqh): crece con ella al sentarse. -->
            <!-- RONDA 50 · lo que hay TRAS la barra de cristal: la parte de arriba de la captura de la web activa (la web real es un iframe de otro
                 dominio y empieza bajo la barra para no taparle el menú; así el cristal se tiñe con los colores de cada proyecto) -->
            <i class="tras-cromo" aria-hidden="true"></i>
            <div class="cromo" aria-hidden="true">
              <span class="semaforo"><i /><i /><i /></span>
              <svg class="ic" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M9 5v14" /></svg>
              <svg class="ic" viewBox="0 0 24 24"><path d="M14.5 6l-6 6 6 6" /></svg>
              <svg class="ic tenue" viewBox="0 0 24 24"><path d="M9.5 6l6 6-6 6" /></svg>
              <span class="direccion">
                <svg class="ic mini" viewBox="0 0 24 24"><rect x="6" y="11" width="12" height="9" rx="2" /><path d="M9 11V8a3 3 0 016 0v3" /></svg>
                <span class="url" data-url></span>
                <svg class="ic mini fin" viewBox="0 0 24 24"><path d="M19 12a7 7 0 11-2.2-5.1M19 4v4h-4" /></svg>
              </span>
              <svg class="ic" viewBox="0 0 24 24"><path d="M12 15V4m0 0l-4 4m4-4l4 4M6 12v6a2 2 0 002 2h8a2 2 0 002-2v-6" /></svg>
              <svg class="ic" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
              <svg class="ic" viewBox="0 0 24 24"><rect x="4" y="8" width="12" height="12" rx="2.5" /><path d="M8 8V6.5A2.5 2.5 0 0110.5 4H17.5A2.5 2.5 0 0120 6.5v7A2.5 2.5 0 0117.5 16H16" /></svg>
              <i class="progreso" data-progreso></i>
            </div>
            <!-- RONDA 13 · «que la primera web que cargue, en ese propio marrón, salga un buscador que typeas la web y carga la primera»:
                 al terminar de entrar, la pantalla sigue siendo el MISMO Cacao del titular (con su grano) y en ella aparece un buscador;
                 se teclea el dominio, carga, y la página de inicio se retira dejando Safari con la web. Los cambios de proyecto, como antes. -->
            <div class="inicio" aria-hidden="true" data-inicio>
              <p class="inicio-tit font-display">{proyectos.titulo}</p>
            </div>
            <!-- RONDA 39 · «hay que poner algún indicador de que se puede hacer scroll en el ordenador»: una píldora al pie de la pantalla, con la
                 rueda del ratón que baja; sale cuando la web ha cargado y se va en cuanto el puntero entra en la pantalla (ya lo has descubierto) -->
            <!-- RONDA 41 · la capa que recoge el PRIMER gesto de scroll sobre la web (el iframe es de otro dominio: no se puede saber si se ha deslizado
                 dentro). Con ese primer gesto la llamada «Desliza dentro» se va y la capa desaparece: a partir de ahí, la web se recorre normal. -->
            <i class="capta" aria-hidden="true" data-capta></i>
            <!-- RONDA 172 (Eric, Agentation sobre el monitor: «un pequeño aviso de que puedes hacer scroll sobre la pantalla; solo la primera vez, hasta que
                 hagas scroll»): sentado, una píldora al pie de la pantalla y una capa que recoge el primer gesto (el iframe es de otro dominio) -->
            <!-- RONDA 208 (Eric: «sentado, no es intuitivo hacer scroll dentro de la pantalla; hay que guiar un poco al usuario, respetando el diseño»): la píldora
                 sale por SESIÓN (no una vez por navegador) cuando la web ya ha cargado, se va al entrar el puntero y vuelve a asomar si pasan unos segundos fuera;
                 ya no hay capa que se trague el primer gesto; y el HILO del borde derecho (carril de cristal con un pulgar de savia que respira) avisa siempre
                 de que la pantalla se recorre -->
            <div class="aviso-desliza" aria-hidden="true" data-aviso-desliza><span class="icono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path class="ch" d="M6.5 9 12 14.5 17.5 9" /></svg></span><span data-aviso-texto>{en ? 'scroll inside to see the site' : 'desliza dentro para ver la web'}</span></div>
            <!-- RONDA 50 · «el indicador de scroll como estaba antes, encima de la pantalla del ordenador»: vuelve la píldora de la ronda 39, al pie
                 de la web; se va con el primer gesto sobre ella (la capa `capta`, ronda 41) -->
            <div class="sigue-cursor" aria-hidden="true" data-sigue><span class="txt"><svg class="silla" viewBox="0 0 24 24" fill="none"><rect class="respaldo" x="7" y="2.5" width="10" height="8.5" rx="3" /><rect x="5" y="12.5" width="14" height="3" rx="1.5" /><path d="M12 15.5v4M7.5 21.5l4.5-2 4.5 2" /></svg>{en ? 'click to sit down' : 'clic para sentarte'}</span></div>
            <p class="pista-scroll" aria-hidden="true" data-pista-scroll><i class="raton"><i></i></i><span data-pista-texto>{en ? 'click to browse' : 'clic para navegar'}</span></p>
            <!-- RONDA 67 · la PANTALLA DE CARGA al sentarse o al cambiar de proyecto sentado: savvia, una línea de savia que corre y el dominio -->
            <!-- RONDA 162 · la CONSTRUCCIÓN del reel antes de cada miniatura (de pie): el agente y nosotros dibujan la maqueta y se pinta la web -->
            <div class="construye" aria-hidden="true" data-construye></div>
            <div class="carga-web" aria-hidden="true"><i class="carga-logo"></i><i class="linea-carga"></i><span class="detail" data-carga-url></span></div>
            <div class="visor">
            {
              P.map((p, i) => (
                <div class="web" data-web={i} data-src={p.url} data-cap={`/media/proyectos/${p.slug}.webp`} data-cap-largo={LARGO[p.slug] ? `/media/proyectos/${p.slug}-largo.webp` : undefined} data-video={VIDEO[p.slug] ? `/media/proyectos/video/${p.slug}` : undefined} data-tinte={TINTE[p.slug]} data-embed={(p as any).embed === false ? 'no' : 'si'} data-pesada={PESADAS.includes(p.slug) ? '' : undefined} tabindex="-1" role="region" aria-label={en ? `${p.n} website` : `Web de ${p.n}`} hidden={i !== 0}>
                  <!-- RONDA 19: aquí se monta, al acercarse, el <iframe> con la web REAL (o su captura si la web no se deja embeber) -->
                </div>
              ))
            }
            </div>
            <!-- RONDA 292 · reunión con JL: de pie, la pantalla enseña el REEL en bucle (sin sonido); al sentarte, los proyectos como siempre -->
            <video class="reel-loop" muted loop playsinline preload="none" poster="/media/reel/reel.jpg" aria-hidden="true" tabindex="-1" disablepictureinpicture data-reel-loop></video>
          </div>
          <!-- La llamada: un punto en la silla, una línea y la palabra. Todo ello es el botón. -->
          <button type="button" class="llamada" data-sentarse>
            <i class="punto-silla" aria-hidden="true"></i>
            <svg class="linea" viewBox="0 0 120 64" fill="none" aria-hidden="true"><path d="M2 62L58 6H118" /></svg>
            <span class="detail detail-caps">{en ? 'Sit down to see the projects' : 'Siéntate a ver los proyectos'}</span>
          </button>
        </div>

        <!-- ENTRADA: al llegar, la pantalla del ordenador LLENA la ventana y enseña el titular; al bajar, la cámara se aleja y el
             titular se queda del tamaño de la pantalla del monitor. Va FUERA de la escena escalada: se rasteriza grande y se reduce (nítido). -->
        <div class="titulo-pantalla" data-titulo>
          <h2 class="font-display">{proyectos.titulo}</h2>
        </div>

        <div class="velo-ui" aria-hidden="true"></div>

        <!-- Proyecto activo: abajo a la izquierda -->
        <!-- RONDA 65 · «quitamos toda la info de los proyectos: la escena solo te incita a sentarte y cambiar de estación. Una vez entras en detalle
             ves una información reducida de cada proyecto y el botón de ver el caso de estudio»: la ficha SOLO sentado -->
        <div class="ui ui-info" aria-live="polite">
          {
            P.map((p, i) => (
              <div class="ficha" data-hechos={i} hidden={i !== 0}>
                <p class="detail ficha-cat">{p.cat}</p>
                <p class="ficha-n font-display">{p.n}</p>
                <p class="text-aux mt-3 ficha-d">{p.d}</p>
                <Cta class="ficha-ver mt-6" href={ruta(lang, `/proyectos/${p.slug}`)} variante="secundario" tam="sm">{en ? 'View case study' : 'Ver caso de estudio'}</Cta>
              </div>
            ))
          }
        </div>

        <!-- EL DIAL (ronda 12): la lista de proyectos como el dial de una radio: gira hacia arriba y hacia abajo SIN FIN, el activo nítido en
             el centro y los de los extremos, difuminados. Rueda, clic, flechas. La lista va repetida 5 veces; el JS la mantiene centrada. -->
        <!-- RONDA 39 · «tiene que ser más notorio que el menú de la izquierda puedes cambiar de proyecto»: flechas arriba y abajo del dial, el
             contador del proyecto y, al llegar, un empujón del dial que enseña que gira -->
        <div class="ui ui-guia" data-guia>
          <!-- RONDA 40 · «quitamos proyectos con números: con las flechas ya es suficiente». En móvil, las flechas a los lados del nombre -->
          <p class="guia-nombre" aria-live="polite" data-guia-nombre>{P[0].n}</p>
          <button type="button" class="giro arriba" data-giro="-1" aria-label={en ? 'Previous project' : 'Proyecto anterior'}><Fragment set:html={icono('caret-up')} /></button>
          <button type="button" class="giro abajo" data-giro="1" aria-label={en ? 'Next project' : 'Proyecto siguiente'}><Fragment set:html={icono('caret-down')} /></button>
        </div>
        <div class="ui ui-lista" data-lista>
          <ol class="dial" data-dial>
            {
              Array.from({ length: 5 }).flatMap((_, v) =>
                P.map((p, i) => (
                  <li>
                    <button type="button" class="item" data-item={i} data-pos={v * P.length + i} tabindex={v === 2 ? 0 : -1} aria-hidden={v === 2 ? 'false' : 'true'}>
                      <i class="raya" aria-hidden="true" />
                      <span class="num tabular-nums">{pad(i + 1)}</span>
                      <span class="nombre">{p.n}</span>
                    </button>
                  </li>
                )),
              )
            }
          </ol>
        </div>

        <!-- BARRA INFERIOR (ronda 11 · «algo estilo Apple, más recogido y con iconitos»): una píldora de cristal con las cuatro
             estaciones y el sonido. El nombre de cada botón sale en una etiqueta al pasar o enfocar. -->
        <!-- RONDA 19 · «los botones de cambiar de estación quiero que vayan bajo un (+) redondeado que cuando lo clicas de él salen los iconos
             como si se fuesen multiplicando haciendo una circunferencia alrededor de él. La animación de separarse del (+) tiene que ser
             líquida»: una capa de GOTAS Rosa niebla (la del (+) y cuatro que nacen de ella) bajo un filtro gooey mientras se separan, y encima
             los botones (transparentes, con el icono). Las gotas se colocan en una circunferencia de 60 px alrededor del (+). -->
        <!-- RONDA 153 · el (+) de estación y sonido sale de la escena: es el mando flotante de toda la web (Mando.astro) -->

        <!-- SENTADO (ronda 12): que quede claro cómo se sale: una (x) arriba a la derecha y, abajo, la tecla Esc. Sin «Abrir la web» aquí. -->
        <div class="barra" data-barra hidden>
          <!-- RONDA 68 · «cuando le das a la (X) abres el menú»: la × estaba justo donde el botón del menú. Ahora va ARRIBA EN EL CENTRO, pegada al aviso
               de esc, en un solo cristal recto con cruces (el idioma del CTA); en la esquina ya no hay nada que clicar dos veces. -->
          <!-- RONDA 175 · JL, sentado, «no sabía levantarse»: la × sola no se leía como salida. Ahora es un BOTÓN CON TEXTO, «Levantarse», con la
               tecla esc al lado; y además se levanta uno haciendo clic o scroll fuera del monitor (cursor de alejar). -->
          <div class="arriba cristal">
            <button type="button" class="cerrar" data-levantarse>
              <Fragment set:html={icono('x')} />
              <span>{en ? 'Stand up' : 'Levantarse'}</span>
              <kbd class="salir">esc</kbd>
            </button>
          </div>
          <!-- RONDA 14 · «en la vista sentado de proyectos que también puedas ver otros»: sin levantarte, anterior · proyecto · siguiente -->
          <div class="otros cristal" role="group" aria-label={en ? 'Switch project' : 'Cambiar de proyecto'}>
            <button type="button" class="paso" data-otro="-1" aria-label={en ? 'Previous project' : 'Proyecto anterior'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6l-6 6 6 6" /></svg></button>
            <p class="cual" aria-live="polite"><span data-otro-nombre>{P[0].n}</span></p>
            <button type="button" class="paso" data-otro="1" aria-label={en ? 'Next project' : 'Proyecto siguiente'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6l6 6-6 6" /></svg></button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap">

  </div>
</section>

<script define:vars={{ datos: P.map((p) => ({ n: p.n, url: p.url, dom: (p as any).dominio ?? new URL(p.url).host, estacion: p.estacion, slug: p.slug })), nombreEst }} is:inline>
  window.__ESTUDIO = { datos, nombreEst };
</script>

<script>
  import { t } from '../scripts/i18n';
  import { crearSonido } from '../scripts/sonido-estudio';
  import { construir } from '../scripts/construir';
  import { EST, estacionActual } from '../scripts/estacion';
  import { revelar, estaVisible } from '../scripts/revelar';

  const raiz0 = document.querySelector<HTMLElement>('[data-estudio]');
  if (raiz0) {
    const raiz: HTMLElement = raiz0;
    const { datos, nombreEst } = (window as any).__ESTUDIO as { datos: { n: string; url: string; dom: string; estacion: string; slug: string }[]; nombreEst: Record<string, string> };
    const $ = <T extends HTMLElement>(s: string) => raiz.querySelector<T>(s)!;
    const $$ = <T extends HTMLElement>(s: string) => [...raiz.querySelectorAll<T>(s)];
    const escenario = $('[data-escenario]'), escena = $('[data-escena]');
    const otroNombre = $('[data-otro-nombre]'); // el selector de la vista sentado (Eric: sin «01/04», solo el nombre)
    const capas = $$<HTMLImageElement>('[data-capa]'), webs = $$('[data-web]'), items = $$<HTMLButtonElement>('[data-item]'), hechos = $$('[data-hechos]');
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sonido = crearSonido();
    // RONDA 65 · «los proyectos no tienen su propia estación, la cambias tú con los botones»: la escena lleva la estación de la web
    let explorando = false;
    let activo = 0, sentado = false, cargado = false, estManual: string | null = EST[estacionActual()];
    const estActual = () => estManual ?? EST[estacionActual()];
    const ests: HTMLButtonElement[] = []; // ronda 153: los botones de estación viven en el mando flotante

    // Las láminas se piden al acercarse la sección: primero la de la estación visible.
    // RONDA 39 · «los mockups del ordenador hay que hacerlos más nítidos»: láminas nuevas de Andoni a 8K → 1600 (móvil), 2560 y 5120 px.
    // Se pide la que cubre la pantalla a su densidad real; sentado (la escena se amplía ×2,4) se sube a la de 5120 sin parpadeo.
    const pedir = (img: HTMLImageElement) => {
      if (img.src) return;
      const px = innerWidth * Math.min(devicePixelRatio || 1, 2);
      img.src = innerWidth < 700 ? img.dataset.srcM! : px > 2600 ? img.dataset.srcXl! : img.dataset.src!;
    };
    // RONDA 232 · el cambio de estación de la mesa, como el del hero: la lámina nueva llega encima ya descodificada y se DESCUBRE con el canto
    // rasgado desde abajo (2,6 s); la vieja se queda entera debajo hasta que la tapa (antes las dos se fundían a la vez: a medio fundido se veía el fondo)
    let cancelarCapa = () => {}, capaPedida = '';
    const ponCapa = () => {
      const id = estActual(), nueva = capas.find((c) => c.dataset.capa === id)!, vieja = capas.find((c) => c.classList.contains('on') && c !== nueva);
      if (capaPedida === id && nueva.classList.contains('on')) return;
      capaPedida = id; cancelarCapa();
      capas.forEach((c) => c.classList.remove('queda', 'llega'));
      if (!vieja || !estaVisible(escenario)) { capas.forEach((c) => c.classList.toggle('on', c === nueva)); return; }
      pedir(nueva);
      vieja.classList.add('queda');
      const ir = () => {
        if (capaPedida !== id) return;
        nueva.classList.add('llega', 'on'); vieja.classList.remove('on');
        cancelarCapa = revelar(nueva, { ox: 0.5, oy: 1, fin: () => { vieja.classList.remove('queda'); nueva.classList.remove('llega'); } });
      };
      (nueva.decode ? nueva.decode() : Promise.resolve()).then(ir, ir);
    };
    const mejorar = (img: HTMLImageElement) => {
      const xl = img.dataset.srcXl!;
      if (!img.src) { img.src = xl; return; }
