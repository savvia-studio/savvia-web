    }
    .giro.arriba:hover { translate: 0 -2px; }
    .giro.abajo:hover { translate: 0 2px; }
    /* al llegar, las flechas laten dos veces (acompañan al empujón del dial) */
    .late .giro {
      animation: late 0.8s ease-in-out 1.1s 2;
