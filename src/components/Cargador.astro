---
// LA CARGA · RONDA 85. Andoni: «que al pulsar los acordes se genere nuestro isotipo, y que sea algo más visual, estilo jugar al Guitar Hero: algo que te incite
// a pulsar, que te den ganas de pulsar» (antes, rondas 83–84: el pentagrama con el acorde en blanco; tools/retirados/Cargador.r84-acorde.astro.txt).
// · EL MÁSTIL: tres carriles en perspectiva que bajan desde el isotipo (arriba, al fondo) hasta tres dianas (abajo). Las NOTAS llegan a ritmo (92 BPM), crecen al
//   acercarse y dejan estela. Se pulsa cuando una nota cruza su diana: clic o toque en cualquier sitio, o las teclas A S D / ← ↓ → / espacio. Cada acierto SUENA
//   (la melodía sube por el acorde de fa), hace saltar chispas y DIBUJA un tramo del ISOTIPO con la plumada de siempre (baja por el grueso, sube por el fino,
//   remata en la bola). Fallar no penaliza: la nota se pierde y vuelve. Seis aciertos = isotipo completo.
// · EL FINAL, como la gota de antes: suena el acorde, el isotipo brilla y de su BOLA se descuelga una nota que CAE (la cámara baja con ella y el hero entra desde
//   abajo) hasta la punta de la batuta del director: suena grave, se abre una onda y el director se dibuja desde ahí.
// · RONDA 97 · «las notas también de jazz, de alguna canción conocida para ver si tu mente la hila»: son el arranque de «When the Saints Go Marching In»
//   (tradicional, dominio público): do · mi · fa · sol, y el acorde final en do. Es la misma canción que el jazz de fondo (src/scripts/jazz.ts) cita después.
// · «saltar», Escape o la rueda la saltan. En cada visita (ronda 84). Movimiento reducido: sin carga.
import isoRaw from '../../public/savvia-isotipo.svg?raw';
const ISO = isoRaw.match(/ d="([^"]+)"/)![1];
---

<div class="cargador" aria-hidden="true" data-cargador>
  <div class="mundo" data-mundo>
    <canvas class="mastil" data-mastil></canvas>
    <!-- el ISOTIPO al fondo del mástil: apenas visible; su copia a plena tinta la destapa la plumada con cada acierto -->
    <svg class="logo" viewBox="0 0 370 439" data-logo>
      <defs><mask id="cg-iso" maskUnits="userSpaceOnUse" x="-100" y="-100" width="600" height="700"><path fill="none" stroke="#fff" stroke-width="54" stroke-linecap="round" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000" stroke-dashoffset="1000" data-plumada /></mask></defs>
      <path class="fija" d={ISO} />
      <path class="vv" d={ISO} mask="url(#cg-iso)" />
    </svg>
    <p class="pista detail" data-carga-pista>
      <span class="cuenta" data-cuenta></span>
      <span class="con-raton">pulsa cuando la nota llegue · ¿la reconoces?</span><span class="sin-raton">toca cuando la nota llegue · ¿la reconoces?</span>
      <button type="button" class="saltar" data-saltar>saltar</button>
    </p>
  </div>
</div>

<script>
  import { rhodesSuelto } from '../scripts/jazz';
  const velo = document.querySelector<HTMLElement>('[data-cargador]');
  const w = window as any, raiz = document.documentElement;
  w.__cargaViva = true; // el salvavidas del <head> solo actúa si este script no llega a correr
  const soltar = () => { if (w.__gotaSuelta) return; w.__gotaSuelta = true; dispatchEvent(new Event('savvia:gota')); };
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const terminar = () => {
    if (hero) hero.style.transform = '';
    if (raiz.classList.contains('cargando')) { raiz.classList.remove('cargando', 'carriles-entran'); void raiz.offsetWidth; raiz.classList.add('carriles-entran'); }
  };
  if (!velo && document.querySelector('[data-entrada], [data-entrada-v]')) { /* ronda 113: carga la cuenta */ }
  else if (!velo || !hero || !raiz.classList.contains('cargando') || scrollY > 40) { terminar(); velo?.remove(); soltar(); }
  else {
    const $ = <T extends Element>(s: string) => velo.querySelector<T>(s)!;
    const cv = $<HTMLCanvasElement>('[data-mastil]'), c = cv.getContext('2d')!, mundo = $<HTMLElement>('[data-mundo]');
    const logo = $<SVGSVGElement>('[data-logo]'), plumada = $<SVGPathElement>('[data-plumada]'), cuenta = $<HTMLElement>('[data-cuenta]');
    const pista = $<HTMLElement>('[data-carga-pista]');
    const NB = getComputedStyle(document.documentElement).getPropertyValue('--tinta-carga').trim() || '#eadde7', CO = '#ff616b'; // ronda 91: la tinta de la paleta clara
    // ronda 92 · «en la clara, que se vean bien detalles como la animación de carga»: carriles, trastes y dianas en la tinta de la paleta (antes, Rosa niebla fijo)
    const TINTA = NB === '#eadde7' ? '234,221,231' : [1, 3, 5].map((k) => parseInt(NB.slice(k, k + 2), 16)).join(',');
    // ── el camino de la plumada por el isotipo (el eje medido en la ronda 68, suavizado)
    const EJE: [number, number][] = [[3, 225], [22, 197], [45, 172], [72, 160], [88, 178], [86, 214], [72, 268], [56, 330], [46, 385], [54, 424], [80, 420], [112, 382], [148, 314], [188, 228], [220, 154], [246, 94], [270, 46], [298, 18], [332, 14], [358, 32], [352, 58], [334, 62], [324, 48]];
    const liso = (q: [number, number][], n = 6): [number, number][] => { const o: [number, number][] = []; for (let k = 0; k < q.length - 1; k++) for (let j = 0; j < n; j++) { const t = j / n; o.push([q[k][0] + (q[k + 1][0] - q[k][0]) * t, q[k][1] + (q[k + 1][1] - q[k][1]) * t]); } o.push(q[q.length - 1]); return o.map((_, i) => { if (i === 0 || i === o.length - 1) return o[i]; let x = 0, y = 0, n2 = 0; for (let k = -3; k <= 3; k++) { const r = o[Math.min(o.length - 1, Math.max(0, i + k))]; x += r[0]; y += r[1]; n2++; } return [x / n2, y / n2] as [number, number]; }); };
    plumada.setAttribute('d', 'M' + liso(EJE).map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L'));
    // ── el juego
    const TOTAL = 4, BEAT = 60 / 74, VIAJE = 1.35; // ronda 99: al tempo del jazz de la web (74 BPM) // ronda 86: «más corta de ejecutar» (antes 6 notas y 1,9 s de viaje) // s que tarda una nota en bajar por el carril
    const MELODIA = [72, 76, 77, 79]; // ronda 97: «Oh, when the saints…» (do · mi · fa · sol)
    const CARRIL = [0, 1, 1, 2]; // por dónde llega cada nota: más aguda, más a la derecha
    type Nota = { k: number; carril: number; t0: number; estado: 'viene' | 'dada' | 'perdida'; tf: number };
    const notas: Nota[] = [];
    type Chispa = { x: number; y: number; vx: number; vy: number; v: number; col: string };
    const chispas: Chispa[] = [];
    const dianas = [0, 0, 0]; // brillo de cada diana al pulsar (decae)
    let aciertos = 0, siguiente = 0, proxima = 0, W = 0, H = 0, dpr = 1, fin = false, parado = false, t00 = 0;
    const g = { vx: 0, vy: 0, sy: 0, ancho: 0, arriba: 0 }; // punto de fuga, línea de las dianas, ancho abajo, ancho arriba
    const medir = () => {
      W = innerWidth; H = innerHeight; dpr = Math.min(2, devicePixelRatio || 1);
      cv.width = W * dpr; cv.height = H * dpr; cv.style.width = W + 'px'; cv.style.height = H + 'px'; c.setTransform(dpr, 0, 0, dpr, 0, 0);
      g.vx = W / 2; g.vy = H * 0.34; g.sy = H * 0.8; g.ancho = Math.min(W * 0.9, 640); g.arriba = g.ancho * 0.16;
      const lh = Math.min(H * 0.22, 190); // el isotipo, al fondo del mástil
      logo.style.height = lh + 'px'; logo.style.left = W / 2 - (lh * 370) / 439 / 2 + 'px'; logo.style.top = g.vy - lh - H * 0.02 + 'px';
    };
    const xCarril = (i: number, p: number) => { const ab = g.vx + (i - 1) * (g.ancho / 3), ar = g.vx + (i - 1) * (g.arriba / 3); return ar + (ab - ar) * p; };
    const yDe = (p: number) => g.vy + (g.sy - g.vy) * p;
    const pDe = (t: number) => Math.pow(Math.max(0, t), 1.45); // se acelera al acercarse (perspectiva)
    const lanzar = (ahora: number) => { if (siguiente >= TOTAL || fin) return; notas.push({ k: siguiente, carril: CARRIL[siguiente], t0: ahora, estado: 'viene', tf: 0 }); siguiente++; };
    const pintarCuenta = () => { cuenta.innerHTML = Array.from({ length: TOTAL }, (_, i) => `<i class="${i < aciertos ? 'si' : ''}"></i>`).join(''); };
    pintarCuenta();
    let pl = 0, plMeta = 0;
    // PULSAR: acierta la nota viva más cercana a su diana si está a menos de ~0,4 pulsos (el carril da igual: que apetezca pulsar)
    const pulsar = (carrilPulsado?: number) => {
      if (fin || parado) return;
      const ahora = performance.now() / 1000;
      let mejor: Nota | null = null, dm = Infinity;
      for (const n of notas) { if (n.estado !== 'viene') continue; const d = Math.abs(ahora - (n.t0 + VIAJE)); if (d < dm) { dm = d; mejor = n; } }
      if (mejor && dm < BEAT * 0.42) {
        mejor.estado = 'dada'; mejor.tf = ahora; aciertos++; dianas[mejor.carril] = 1;
        rhodesSuelto(MELODIA[mejor.k], 0.13, 1.8); rhodesSuelto(MELODIA[mejor.k] - 24, 0.07, 1.4); // ronda 99: «las notas, acordes con la música de la web»: su mismo piano eléctrico
        const x = xCarril(mejor.carril, 1), y = g.sy;
        for (let i = 0; i < 18; i++) { const a = Math.random() * Math.PI * 2, v = 80 + Math.random() * 260; chispas.push({ x, y, vx: Math.cos(a) * v, vy: Math.sin(a) * v - 120, v: 1, col: i % 3 ? NB : CO }); }
        plMeta = aciertos / TOTAL; // la plumada avanza un tramo del isotipo
        pintarCuenta();
        velo.classList.add('jugando');
        if (aciertos >= TOTAL) resolver();
      } else {
        // pulsar a destiempo también suena (bajito) y la diana se enciende: que apetezca seguir
        const i = carrilPulsado ?? 1; dianas[i] = Math.max(dianas[i], 0.45);
        rhodesSuelto(MELODIA[Math.min(aciertos, TOTAL - 1)] - 5, 0.04, 0.6);
      }
    };
    // ── dibujar el mástil
    const frame = (ahora: number) => {
      if (parado) return;
      const t = ahora / 1000;
      if (!t00) { t00 = t; proxima = t + 0.4; }
      if (!fin && t >= proxima && notas.filter((n) => n.estado === 'viene').length < 2) { lanzar(t); proxima = t + BEAT * 1.5; }
      // las notas perdidas vuelven a salir (no se castiga)
      for (const n of notas) if (n.estado === 'viene' && t - n.t0 > VIAJE + BEAT * 0.5) { n.estado = 'perdida'; n.tf = t; siguiente = Math.min(siguiente, n.k); }
      for (let i = notas.length - 1; i >= 0; i--) if (notas[i].estado !== 'viene' && t - notas[i].tf > 0.8) notas.splice(i, 1);
      // la plumada, suave
      pl += (plMeta - pl) * 0.12; plumada.setAttribute('stroke-dashoffset', String(1000 * (1 - Math.min(1, pl + (pl > 0.001 ? 0.01 : 0)))));
      c.clearRect(0, 0, W, H);
      const pulso = Math.exp(-(((t - t00) % BEAT) / BEAT) * 5); // el latido, a tempo
      // CARRILES: tres franjas en perspectiva; se encienden al pulsar
      for (let i = 0; i < 3; i++) {
        const a0 = xCarril(i, 0) - g.arriba / 6, a1 = xCarril(i, 0) + g.arriba / 6, b0 = xCarril(i, 1) - g.ancho / 6, b1 = xCarril(i, 1) + g.ancho / 6;
        const gr = c.createLinearGradient(0, g.vy, 0, g.sy + 30);
        gr.addColorStop(0, `rgba(${TINTA},0)`); gr.addColorStop(1, `rgba(${TINTA},${0.035 + dianas[i] * 0.08})`);
        c.fillStyle = gr; c.beginPath(); c.moveTo(a0, g.vy); c.lineTo(a1, g.vy); c.lineTo(b1, g.sy + 30); c.lineTo(b0, g.sy + 30); c.closePath(); c.fill();
      }
      c.strokeStyle = `rgba(${TINTA},.16)`; c.lineWidth = 1;
      for (let i = 0; i <= 3; i++) { const xa = g.vx + (i - 1.5) * (g.arriba / 3), xb = g.vx + (i - 1.5) * (g.ancho / 3); c.beginPath(); c.moveTo(xa, g.vy); c.lineTo(xb + (xb - xa) * 0.06, g.sy + 30); c.stroke(); }
      // los trastes que bajan a tempo: sensación de avance
      for (let j = 0; j < 6; j++) {
        const f = (((t - t00) / BEAT / 2 + j / 6) % 1), p = pDe(f), y = yDe(p), hw = (g.arriba + (g.ancho - g.arriba) * p) / 2;
        c.strokeStyle = `rgba(${TINTA},${0.1 * p})`; c.beginPath(); c.moveTo(g.vx - hw, y); c.lineTo(g.vx + hw, y); c.stroke();
      }
      // la línea de las dianas y las DIANAS (anillos que laten)
      c.strokeStyle = `rgba(${TINTA},${0.3 + 0.2 * pulso})`; c.lineWidth = 1.2; c.beginPath(); c.moveTo(g.vx - g.ancho / 2 - 20, g.sy); c.lineTo(g.vx + g.ancho / 2 + 20, g.sy); c.stroke();
      for (let i = 0; i < 3; i++) {
        const x = xCarril(i, 1), r = Math.min(26, g.ancho / 18) + pulso * 3 + dianas[i] * 6;
        c.lineWidth = 2; c.strokeStyle = dianas[i] > 0.5 ? CO : `rgba(${TINTA},${0.55 + pulso * 0.3})`;
        c.beginPath(); c.arc(x, g.sy, r, 0, 7); c.stroke();
        if (dianas[i] > 0.02) { c.fillStyle = `rgba(255,97,107,${dianas[i] * 0.35})`; c.beginPath(); c.arc(x, g.sy, r + 10 * dianas[i], 0, 7); c.fill(); }
        dianas[i] *= 0.9;
      }
      // las NOTAS: cabeza brillante con estela; crecen al acercarse
      for (const n of notas) {
        const vida = t - n.t0, p = n.estado === 'viene' ? pDe(vida / VIAJE) : pDe((n.tf - n.t0) / VIAJE);
        const x = xCarril(n.carril, p), y = yDe(p), r = 4 + 13 * p;
        const alfa = n.estado === 'viene' ? Math.min(1, vida * 4) * (p > 1.08 ? Math.max(0, 1 - (p - 1.08) * 6) : 1) : Math.max(0, 1 - (t - n.tf) * 3);
        if (n.estado === 'dada') { c.strokeStyle = `rgba(255,97,107,${alfa})`; c.lineWidth = 2; c.beginPath(); c.arc(x, y, r + (t - n.tf) * 90, 0, 7); c.stroke(); continue; }
        const pa = pDe(Math.max(0, vida - 0.18) / VIAJE), xa = xCarril(n.carril, pa), ya = yDe(pa);
        const ge = c.createLinearGradient(xa, ya, x, y); ge.addColorStop(0, `rgba(${TINTA},0)`); ge.addColorStop(1, `rgba(${TINTA},${0.5 * alfa})`);
        c.strokeStyle = ge; c.lineWidth = r * 1.1; c.lineCap = 'round'; c.beginPath(); c.moveTo(xa, ya); c.lineTo(x, y); c.stroke();
        c.save(); c.translate(x, y); c.rotate(-0.38);
        c.shadowColor = CO; c.shadowBlur = 18 * p; c.fillStyle = n.estado === 'perdida' ? `rgba(${TINTA},.3)` : NB; c.globalAlpha = alfa;
        c.beginPath(); c.ellipse(0, 0, r, r * 0.72, 0, 0, 7); c.fill(); c.restore(); c.globalAlpha = 1; c.shadowBlur = 0;
      }
      for (let i = chispas.length - 1; i >= 0; i--) { const s = chispas[i]; s.vy += 520 / 60; s.x += s.vx / 60; s.y += s.vy / 60; s.v -= 0.025; if (s.v <= 0) { chispas.splice(i, 1); continue; } c.fillStyle = s.col; c.globalAlpha = s.v; c.beginPath(); c.arc(s.x, s.y, 1.8, 0, 7); c.fill(); c.globalAlpha = 1; }
      requestAnimationFrame(frame);
    };
    // ── EL FINAL: el acorde, el isotipo brilla y CAE él mismo a la batuta (como la gota)
    const cubica = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const COLGAR = 360, CAER = 1150; // ronda 86: más corta
    const ondaEn = (x: number, y: number) => {
      const o = document.createElement('div'); o.className = 'onda-batuta'; o.setAttribute('aria-hidden', 'true');
      o.style.left = `${x}px`; o.style.top = `${y}px`; o.innerHTML = '<i></i><i></i><i></i><i></i><i></i>';
      hero.appendChild(o); setTimeout(() => o.remove(), 4000);
    };
    const resolver = () => {
      fin = true;
      setTimeout(() => { [36, 52, 57, 62, 67].forEach((m, i) => rhodesSuelto(m, i ? 0.07 : 0.12, 3.6, i * 0.012)); velo.classList.add('resuelto'); }, 250); // ronda 97: do 6/9, el acorde con que empieza el jazz
      const D = hero.getBoundingClientRect().top; // el hero nace desplazado: lo que baja la cámara
      const caja = hero.querySelector<HTMLElement>('.arbol-caja')!.getBoundingClientRect();
      // RONDA 110 · «que la V caiga hasta donde termina el hero, genere una onda y desde ahí se empiece a generar el ASCII de manera aleatoria»: la meta ya no es la
      // batuta sino el centro del borde de abajo del recuadro (de donde salen los pulsos); en el mundo: el hero aún lleva sumada D
      const mr = hero.querySelector<HTMLElement>('.marco')?.getBoundingClientRect() ?? caja;
      const meta = { x: mr.left + mr.width / 2, y: mr.bottom - 4 };
      // RONDA 86 · «que lo que caiga sea el isotipo de savvia, no una nota; que del isotipo salgan ondas de sonido que generan la vida en la web»: cae el
      // PROPIO isotipo (encogiéndose), y al posarse en la batuta suelta ondas de sonido de las que se dibuja el director
      const lr = logo.getBoundingClientRect();
      const x0 = lr.left + lr.width / 2, y0 = lr.top + lr.height / 2, h0 = lr.height, hFin = Math.max(26, caja.height * 0.09);
      // RONDA 89 · «al terminar de pulsar las notas, el isotipo tiene un frame donde aparece a la derecha antes de caer»: se quitaban left/top y la
      // transformación no llegaba hasta medio segundo después. Ahora el mismo sitio se expresa ya como transformación, en el mismo fotograma
      const ponerEn = (x: number, y: number, extra = '') => { logo.style.transform = `translate3d(${(x - (h0 * 370) / 439 / 2).toFixed(1)}px, ${(y - h0 / 2).toFixed(1)}px, 0)${extra}`; };
      logo.style.transformOrigin = '50% 50%'; ponerEn(x0, y0); logo.style.left = '0px'; logo.style.top = '0px';
      const G = h0 * 0.1;
      let t0 = 0, cSuelta = false, xp = x0, yp = y0;
      const paso = (ahora: number) => {
        if (parado) return;
        if (!t0) t0 = ahora + 500; // deja sonar el acorde y brillar el isotipo
        const t = ahora - t0;
        if (t < 0) return void requestAnimationFrame(paso);
        if (!cSuelta) { cSuelta = true; velo.classList.add('subiendo'); }
        let x = x0, y = y0, sx = 1, sy = 1, ang = 0, cam = 0, blur = 0, al = 1;
        if (t < COLGAR) {
          const q = t / COLGAR, e = q * q * (3 - 2 * q);
          x = x0 + Math.sin(q * 26) * 1.2 * (1 - q); y = y0 + e * G * 1.2; sx = 1 - 0.06 * e; sy = 1 + 0.12 * e; ang = Math.sin(q * 18) * 6 * (1 - q); al = 1;
        } else {
          const q = Math.min(1, (t - COLGAR) / CAER);
          cam = cubica(q);
          const yI = y0 + G * 1.2, pant = yI + (meta.y - D - yI) * Math.pow(q, 2.1);
          y = pant + cam * D;
          x = x0 + (meta.x - x0) * (0.5 - 0.5 * Math.cos(Math.PI * q)) + Math.sin(q * Math.PI * 2) * 12 * (1 - q);
          const v = Math.hypot(x - xp, y - cam * D - yp);
          sy = 1 + Math.min(0.25, v * 0.012); sx = 1 / Math.sqrt(sy); ang = Math.sin(q * Math.PI * 3) * 10 * (1 - q); blur = Math.min(2.2, v * 0.05);
          mundo.style.transform = `translate3d(0, ${(-cam * D).toFixed(1)}px, 0)`;
          hero.style.transform = `translate3d(0, ${((1 - cam) * D).toFixed(1)}px, 0)`;
          if (q >= 1) {
            rhodesSuelto(36, 0.12, 3); rhodesSuelto(79, 0.05, 2.4);
            logo.style.opacity = '0';
            acabar();
            const hr = hero.getBoundingClientRect();
            ondaEn(meta.x - hr.left, meta.y - D - hr.top);
            // ronda 89: la misma onda recorre las capas del hero y sus puntos
            setTimeout(() => dispatchEvent(new CustomEvent('savvia:onda', { detail: { x: meta.x, y: meta.y - D, f: 1.2 } })), 60);
            return;
          }
        }
        xp = x; yp = y - cam * D;
        void al;
        const q2 = t < COLGAR ? 0 : Math.min(1, (t - COLGAR) / CAER), esc = (h0 + (hFin - h0) * Math.pow(q2, 0.8)) / h0;
        ponerEn(x, y, ` rotate(${ang.toFixed(1)}deg) scale(${(esc * sx).toFixed(3)}, ${(esc * sy).toFixed(3)})`);
        logo.style.filter = `drop-shadow(0 0 ${(10 + 10 * (1 - q2)).toFixed(0)}px color-mix(in srgb, var(--color-coral) 70%, transparent))${blur > 0.2 ? ` blur(${blur.toFixed(1)}px)` : ''}`;
        requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };
    const acabar = () => {
      if (parado) return; parado = true;
      try { localStorage.setItem('savvia:carga', '1'); } catch {}
      terminar();
      velo.classList.add('fuera');
      soltar();
      setTimeout(() => velo.remove(), 1200);
    };
    // ── entradas
    const TECLAS: Record<string, number> = { a: 0, s: 1, d: 2, j: 0, k: 1, l: 2, ArrowLeft: 0, ArrowDown: 1, ArrowRight: 2, ' ': 1, Enter: 1 };
    velo.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('[data-saltar]')) return;
      const i = e.clientX < g.vx - g.ancho / 6 ? 0 : e.clientX > g.vx + g.ancho / 6 ? 2 : 1;
      pulsar(i);
    });
    addEventListener('keydown', (e) => {
      if (parado) return;
      if (e.key === 'Escape') return acabar();
      if (e.key in TECLAS) { e.preventDefault(); pulsar(TECLAS[e.key]); }
    });
    $('[data-saltar]').addEventListener('click', () => acabar());
    addEventListener('wheel', () => { if (!fin) acabar(); }, { once: true, passive: true });
    addEventListener('resize', medir);
    medir();
    setTimeout(() => pista.classList.add('ver'), 300);
    document.fonts.ready.then(() => { velo.classList.add('en-marcha'); requestAnimationFrame(frame); });
    // sondas para las pruebas: cuándo llega la próxima nota a su diana
    (window as any).__carga = () => ({ aciertos, llegadas: notas.filter((n) => n.estado === 'viene').map((n) => n.t0 + VIAJE - performance.now() / 1000) });
  }
</script>

