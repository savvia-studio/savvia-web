<style>
  .cargador {
    position: fixed;
    inset: 0;
    z-index: 70; /* escala de z: … 55 nav · 60 escenario sentado · 70 carga */
    overflow: hidden;
    pointer-events: auto; /* mientras dura, el puntero es suyo (debajo no hay nada que tocar) */
