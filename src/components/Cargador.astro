---
// LA CARGA (rondas 15–20). Referencia: off.site (pantalla lisa, el logotipo aparece, de su última letra sale un hilo que baja).
// RONDA 20 · Andoni: «¿podemos hacer que para iniciar la web tengas que hacer un círculo con el ratón? La animación de la gota tiene que parecer
// que dibuja las v realmente».
// · EMPEZAR: aparece «sa  ia» y el visitante DIBUJA UN CÍRCULO con el ratón (o con el dedo): un rastro Naranja sigue al puntero; al cerrar la
//   vuelta, el círculo se encoge hasta el pie de la primera v y se convierte en la gota, que echa a rodar. Pista a los 1,6 s: «dibuja un círculo».
//   Espacio o intro arrancan sin círculo; «saltar», rueda o Escape lo saltan.
// · LAS V SE DIBUJAN A TRAZO: la máscara de las v ya no es un frente en x sino la PLUMADA de la gota: un trazo grueso con puntas redondas que
//   sigue exactamente su camino (baja por el trazo grueso, sube por el fino, rodea el rizo, la ligadura) y se va destapando con
//   `stroke-dashoffset` a la vez que ella avanza. La tinta aparece solo donde la gota ha pasado.
// · El camino por las v está medido en el propio trazo del logotipo y suavizado (Catmull-Rom) al compilar; luego el palo de la i, por debajo
//   del punto, el lomo de la última «a» y la punta de su rabo.
// · DESCOLGARSE (ronda 19): engorda y cae por su peso; un CUELLO la sujeta y se estrangula; resto que se retrae y SATÉLITE detrás.
// · CAER (ronda 19): tiembla, se estira y la ESTELA se desenfoca en la dirección del movimiento. SALPICA en la base del tronco.
// · La cámara baja con ella: logotipo y gota viven en un «mundo» que sube y el HERO SUBE DESDE ABAJO (`html.cargando`, puesto en el <head>).
//   La gota toca el suelo bajo el titular en el mismo instante en que la cámara se posa → `savvia:gota` → el árbol se genera.
// · Recarga a media página o movimiento reducido: sin carga. Sin JS no existe.
// RONDA 66 · «el logo: savvia con la tipografía» y «la animación inicial también tiene que depender de la estación». La palabra en Family; el camino
// de la gota se mide EN EL NAVEGADOR sobre las letras reales (cada letra con un Range; la altura de x de Family, 0,47 em, y la línea base de la fuente).
// RONDA 68 · «que en la animación de carga se dibuje el isotipo únicamente, cae la gota y el isotipo se encaja arriba con savvia»: la gota DIBUJA el
// isotipo (la v caligráfica: sube por la colita, baja por el trazo grueso, sube por el fino y remata en la bola), se descuelga de la bola y cae; mientras
// cae, el isotipo vuela a la barra y se encaja delante de «savvia» (en el sitio exacto del isotipo del logotipo), que aparece con él.
import isoRaw from '../../public/savvia-isotipo.svg?raw';
const ISO = isoRaw.match(/ d="([^"]+)"/)![1];
---

<div class="cargador" aria-hidden="true" data-cargador>
  <!-- el RASTRO del puntero mientras se dibuja el círculo, y el anillo que se encoge hasta ser la gota -->
  <svg class="rastro" data-rastro-svg><polyline points="" data-rastro /><circle class="anillo" r="0" data-anillo /></svg>
  <!-- RONDA 66 · el tiempo de la ESTACIÓN alrededor de la carga: hojas en otoño, nieve en invierno, pétalos en primavera, motas de luz en verano -->
  <canvas class="tiempo" data-tiempo></canvas>
  <!-- el ISOTIPO: apenas visible, y encima su copia a plena tinta que destapa la plumada de la gota (fuera del «mundo»: no baja con la cámara, vuela a la barra) -->
  <svg class="logo" viewBox="0 0 370 439" aria-hidden="true" data-logo>
    <defs><mask id="cg-vv" maskUnits="userSpaceOnUse" x="-100" y="-100" width="600" height="700"><path fill="none" stroke="#fff" stroke-width="50" stroke-linecap="round" stroke-linejoin="round" pathLength="1000" stroke-dasharray="1000" stroke-dashoffset="1000" data-plumada /></mask></defs>
    <path class="fija" d={ISO} />
    <path class="vv" d={ISO} mask="url(#cg-vv)" />
  </svg>
  <div class="mundo" data-mundo>
    <p class="pista detail" data-carga-pista>dibuja un círculo<button type="button" class="saltar" data-saltar>saltar</button></p>
    <!-- el CUELLO que sujeta la gota mientras se descuelga, el resto que se retrae y el satélite (en el sistema del mundo) -->
    <svg class="cuello" viewBox="-20 -4 40 40" data-cuello><path d="" data-cuello-d /><circle class="resto" r="0" data-resto /></svg>
    <i class="satelite" data-satelite></i>
    <!-- la GOTA: cabeza + estela de velocidad con desenfoque de movimiento (el x del viewBox es la dirección de avance: la svg gira) -->
    <svg class="gota" viewBox="-34 -8 42 16" data-gota>
      <defs>
        <filter id="cg-mb" filterUnits="userSpaceOnUse" x="-160" y="-60" width="220" height="120"><feGaussianBlur stdDeviation="0 0" data-mb /></filter>
        <filter id="cg-mbc" filterUnits="userSpaceOnUse" x="-40" y="-40" width="80" height="80"><feGaussianBlur stdDeviation="0 0" data-mbc /></filter>
        <!-- RONDA 65 · «en vez de naranja, una gota más realista de agua/savia»: cuerpo translúcido (se ve el fondo), canto que refracta, luz
             transmitida abajo y un brillo especular arriba. La luz no gira con la gota (el grupo `data-brillo` se contra-rota). -->
        <radialGradient id="cg-agua" cx="0" cy="0" r="6" gradientUnits="userSpaceOnUse">
          <stop offset="0" style="stop-color: var(--gota-a)" stop-opacity=".10" />
          <stop offset=".62" style="stop-color: var(--gota-b)" stop-opacity=".18" />
          <stop offset=".86" style="stop-color: var(--gota-c)" stop-opacity=".5" />
          <stop offset="1" stop-color="#fff3e4" stop-opacity=".85" />
        </radialGradient>
        <radialGradient id="cg-trans" cx="0" cy="3.4" r="4.6" gradientUnits="userSpaceOnUse">
          <stop offset="0" style="stop-color: var(--gota-luz)" stop-opacity=".62" />
          <stop offset="1" style="stop-color: var(--gota-luz)" stop-opacity="0" />
        </radialGradient>
      </defs>
      <path class="estela" filter="url(#cg-mb)" d="M0 -2.4C-22 -1.8 -70 -0.6 -110 0C-70 0.6 -22 1.8 0 2.4Z" transform="scale(0, 1)" data-estela />
      <g filter="url(#cg-mbc)">
        <circle r="6" fill="url(#cg-agua)" />
        <g data-brillo>
          <circle r="4.6" cy="0" fill="url(#cg-trans)" transform="translate(0 .4)" />
          <ellipse cx="-2.1" cy="-2.6" rx="1.7" ry="1.05" transform="rotate(-35 -2.1 -2.6)" fill="#fff" fill-opacity=".92" />
          <circle cx="2.4" cy="-1.2" r=".45" fill="#fff" fill-opacity=".6" />
        </g>
      </g>
    </svg>
  </div>
</div>

<script>
  import { salpicar, formaGota } from '../scripts/gota';
  const velo = document.querySelector<HTMLElement>('[data-cargador]');
  const w = window as any, raiz = document.documentElement;
  w.__cargaViva = true; // el salvavidas del <head> solo actúa si este script no llega a correr
  const soltar = () => { if (w.__gotaSuelta) return; w.__gotaSuelta = true; dispatchEvent(new Event('savvia:gota')); };
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const terminar = () => {
    if (hero) hero.style.transform = '';
    if (raiz.classList.contains('cargando')) { raiz.classList.remove('cargando', 'carriles-entran'); void raiz.offsetWidth; raiz.classList.add('carriles-entran'); }
  };
  if (!velo || !hero || !raiz.classList.contains('cargando') || scrollY > 40) { terminar(); velo?.remove(); soltar(); }
  else {
    const $ = <T extends Element>(s: string) => velo.querySelector<T>(s)!;
    const mundo = $<HTMLElement>('[data-mundo]'), logo = $<SVGSVGElement>('[data-logo]'), plumada = $<SVGPathElement>('[data-plumada]');
    const gota = $<SVGSVGElement>('[data-gota]'), estela = $<SVGPathElement>('[data-estela]'), mb = $<SVGElement>('[data-mb]'), mbc = $<SVGElement>('[data-mbc]');
    const cuello = $<SVGSVGElement>('[data-cuello]'), cuelloD = $<SVGPathElement>('[data-cuello-d]'), resto = $<SVGCircleElement>('[data-resto]');
    const satelite = $<HTMLElement>('[data-satelite]'), pista = $<HTMLElement>('[data-carga-pista]'), rastro = $<SVGPolylineElement>('[data-rastro]'), anillo = $<SVGCircleElement>('[data-anillo]');
    const seno = (t: number) => 0.5 - 0.5 * Math.cos(Math.PI * t);
    const cubica = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const entre = (t: number, a: number, b: number) => Math.min(1, Math.max(0, (t - a) / (b - a)));
    // tiempos (ms) desde que la gota echa a rodar
    const RODAR = 2400, COLGAR = 560, CAER = 1450, FIN = RODAR + COLGAR + CAER;
    let t0 = 0, D = 0, meta = { x: 0, y: 0 }, largo: number[] = [], total = 0, pts: [number, number][] = [], largoVV = 1;
    let px = 0, py = 0, parado = false, estelaS = 0, camAnt = 0, ult = 0, rota = false, satT = -1, satY = 0, satX = 0, arrancando = false;
    // EL CAMINO (ronda 68): el eje del isotipo, medido sobre su dibujo (370 × 439; con un trazo de 50 cubre el 99,8 % de la forma), suavizado; y al
    // final, la bola, de cuya parte de abajo cuelga la gota. `nVV`: cuántos puntos dibuja la plumada.
    let nVV = 1, destino = { x: 0, y: 0, s: 1 };
    const EJE: [number, number][] = [[3, 225], [22, 197], [45, 172], [72, 160], [88, 178], [86, 214], [72, 268], [56, 330], [46, 385], [54, 424], [80, 420], [112, 382], [148, 314], [188, 228], [220, 154], [246, 94], [270, 46], [298, 18], [332, 14], [358, 32], [352, 58], [334, 62], [324, 48]];
    const caminoIso = (): [number, number][] => {
      const liso = (q: [number, number][], n = 6): [number, number][] => { const o: [number, number][] = []; for (let k = 0; k < q.length - 1; k++) for (let j = 0; j < n; j++) { const t = j / n; o.push([q[k][0] + (q[k + 1][0] - q[k][0]) * t, q[k][1] + (q[k + 1][1] - q[k][1]) * t]); } o.push(q[q.length - 1]); return o.map((_, i) => { if (i === 0 || i === o.length - 1) return o[i]; let x = 0, y = 0, c = 0; for (let k = -3; k <= 3; k++) { const r = o[Math.min(o.length - 1, Math.max(0, i + k))]; x += r[0]; y += r[1]; c++; } return [x / c, y / c] as [number, number]; }); };
      const eje = liso(EJE);
      nVV = eje.length;
      plumada.setAttribute('d', 'M' + eje.map(([x, y]) => `${x.toFixed(1)} ${y.toFixed(1)}`).join('L'));
      const cuelga = liso([eje[eje.length - 1], [338, 60], [340, 74]], 5).slice(1);
      const r = logo.getBoundingClientRect(), k = r.width / 370;
      return [...eje, ...cuelga].map(([x, y]) => [r.left + x * k, r.top + y * k] as [number, number]);
    };
    const medir = () => {
      const hr = hero.getBoundingClientRect(); D = hr.top; // el hero nace desplazado: esa es la distancia que baja la cámara
      const r = logo.getBoundingClientRect();
      pts = caminoIso();
      // el sitio del isotipo en la barra: el principio del logotipo (su isotipo ocupa todo el alto y 370/1275 del ancho)
      const nl = document.querySelector('.logo-marca')?.getBoundingClientRect();
      if (nl && nl.height) destino = { x: nl.left - r.left, y: nl.top - r.top, s: nl.height / r.height };
      const c = hero.querySelector('.arbol-caja')!.getBoundingClientRect();
      meta = { x: c.left + c.width / 2, y: c.bottom - 4 }; // en el MUNDO (el hero ya lleva sumada la distancia D)
      largo = [0]; for (let i = 1; i < pts.length; i++) largo.push(largo[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
      total = largo[largo.length - 1]; largoVV = largo[nVV - 1];
    };
    const enCamino = (k: number): [number, number] => {
      const s = k * total; let i = 1; while (i < largo.length - 1 && largo[i] < s) i++;
      const f = (s - largo[i - 1]) / Math.max(1e-6, largo[i] - largo[i - 1]);
      return [pts[i - 1][0] + (pts[i][0] - pts[i - 1][0]) * f, pts[i - 1][1] + (pts[i][1] - pts[i - 1][1]) * f];
    };
    const acabar = (conGota: boolean) => {
      if (parado) return; parado = true;
      try { localStorage.setItem('savvia:carga', '1'); } catch {} // ronda 69: solo la primera vez
      terminar();
      velo.classList.add('fuera');
      if (conGota) logo.style.transform = `translate3d(${destino.x}px, ${destino.y}px, 0) scale(${destino.s})`;
      gota.style.opacity = '0';
      const caja = hero.querySelector<HTMLElement>('.arbol-caja');
      if (conGota && caja) salpicar(caja, caja.offsetWidth / 2, caja.offsetHeight - 4, { n: 11, fuerza: 1.05, color: 'rgba(246, 228, 204, .7)' });
      soltar();
      setTimeout(() => velo.remove(), 1400);
    };
    const brillo = gota.querySelector<SVGGElement>('[data-brillo]')!;
    const ponerGota = (x: number, y: number, ang: number, sx: number, sy: number) => {
      gota.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${ang}rad) scale(${sy.toFixed(3)}, ${sx.toFixed(3)})`;
      brillo.setAttribute('transform', `rotate(${((-ang * 180) / Math.PI).toFixed(1)})`);
    };
    const cuelloPath = (Lc: number, r: number, wa: number, wm: number) =>
      `M${-wa} 0C${-wm} ${Lc * 0.42} ${-r * 0.8} ${Lc * 0.72} ${-r * 0.8} ${Lc}L${r * 0.8} ${Lc}C${r * 0.8} ${Lc * 0.72} ${wm} ${Lc * 0.42} ${wa} 0Z`;
    const paso = (ahora: number) => {
      if (parado) return;
      if (!ult) { ult = ahora; medir(); velo.classList.add('en-marcha'); }
      ult = ahora;
      if (!rota) { requestAnimationFrame(paso); return; }
      const [ax, ay] = pts[pts.length - 1]; // la punta del rabo de la «a» (pantalla)
      let x = 0, y = 0, cam = 0, ang = 0, sx = 1, sy = 1, gordo = 1;
      const t = ahora - t0;
      if (t < RODAR) {
        // RODAR: por las v (se dibujan a su paso, con la plumada), luego por encima de la i y de la a
        const k = seno(entre(t, 0, RODAR));
        [x, y] = enCamino(k);
        plumada.setAttribute('stroke-dashoffset', String(1000 * (1 - Math.min(1, (k * total) / largoVV + 0.012))));
        const vx = x - px, vy = y - py, vel = Math.hypot(vx, vy);
        ang = vel > 0.2 ? Math.atan2(vy, vx) : 0;
        gota.style.opacity = String(entre(t, 0, 180));
      } else if (t < RODAR + COLGAR) {
        // DESCOLGARSE: la gota engorda y cae por su peso; el cuello se alarga y se estrangula
        const k = entre(t, RODAR, RODAR + COLGAR), e = k * k * (3 - 2 * k);
        gordo = 1 + 0.32 * e;
        const r = 6 * gordo, Lc = 3 + 17 * e;
        x = ax + Math.sin(k * 9) * 0.6 * (1 - k); y = ay + Lc;
        cuello.style.opacity = '1'; cuello.style.transform = `translate3d(${ax}px, ${ay}px, 0)`;
        cuelloD.setAttribute('d', cuelloPath(Lc, r, 4.2 - 2.6 * e, r * 0.72 * (1 - Math.pow(k, 1.6)) + 0.7));
        ang = Math.PI / 2; sx = 1 - 0.08 * e; sy = 1 + 0.16 * e;
      } else {
        // CAER: en pantalla acelera (gravedad); la cámara baja con curva suave y se posa a la vez que la gota toca el suelo
        const tCae = t - (RODAR + COLGAR);
        if (tCae < 40) { cuelloD.setAttribute('d', ''); satT = ahora; satX = ax; satY = ay + 9; satelite.style.opacity = '1'; }
        const rk = entre(tCae, 0, 220); resto.setAttribute('r', String(2.4 * (1 - rk))); resto.setAttribute('cy', String(-3 * rk));
        const k = entre(t, RODAR + COLGAR, FIN);
        cam = cubica(k);
        const y0 = ay + 20;
        const pantY = y0 + (meta.y - D - y0) * Math.pow(k, 2.1);
        y = pantY + cam * D;
        x = ax + (meta.x - ax) * seno(k) + Math.sin(k * Math.PI * 2) * 14 * (1 - k);
        mundo.style.transform = `translate3d(0, ${-cam * D}px, 0)`;
        // el isotipo vuela a la barra mientras la gota cae
        const v = cubica(entre(t, RODAR + COLGAR * 0.6, FIN - 150));
        logo.style.transform = `translate3d(${(destino.x * v).toFixed(1)}px, ${(destino.y * v).toFixed(1)}px, 0) scale(${(1 + (destino.s - 1) * v).toFixed(4)})`;
        hero.style.transform = `translate3d(0, ${(1 - cam) * D}px, 0)`;
        if (k > 0.02) velo.classList.add('cayendo');
        gordo = 1.3;
        const velP = Math.abs(y - cam * D - (py - camAnt * D));
        const vx = x - px, vy = y - py;
        ang = Math.PI / 2 + (Math.hypot(vx, vy) > 0.2 ? (Math.atan2(vy, vx) - Math.PI / 2) * 0.5 : 0);
        const f = formaGota(tCae, velP); sx = f.sx; sy = f.sy;
        estelaS += ((tCae > 100 ? Math.min(1, velP * 0.05) : 0) - estelaS) * 0.22;
        estela.setAttribute('transform', `scale(${estelaS.toFixed(3)}, 1)`);
        estela.style.opacity = String(0.42 * estelaS);
        mb.setAttribute('stdDeviation', `${Math.min(9, velP * 0.28).toFixed(2)} 0.4`);
        mbc.setAttribute('stdDeviation', `${Math.min(1.4, velP * 0.035).toFixed(2)} 0.15`);
        if (satT > 0) {
          const ts = (ahora - satT) / 1000, sy2 = satY + 0.5 * 1500 * ts * ts * 0.85;
          satelite.style.transform = `translate3d(${satX}px, ${sy2 + cam * D}px, 0) scale(${1 + ts * 1.2}, ${1 - ts * 0.15})`;
          satelite.style.opacity = String(Math.max(0, 1 - ts * 1.6));
        }
      }
      ponerGota(x, y, ang, gordo * sx, gordo * sy);
      camAnt = cam; px = x; py = y;
      if (t >= FIN) return acabar(true);
      requestAnimationFrame(paso);
    };
    // ── EL CÍRCULO: el puntero deja un rastro; cuando la vuelta se cierra (≥ 340° alrededor de su centro, radio ≥ 18 px), arranca
    const traza: { x: number; y: number; t: number }[] = [];
    const arrancar = (cx: number, cy: number, r: number) => {
      if (arrancando || rota) return; arrancando = true;
      clearTimeout(pistaT); pista.classList.remove('ver');
      velo.classList.add('circulo');
      rastro.setAttribute('points', ''); traza.length = 0; // el rastro desaparece en cuanto se cierra el círculo
      // el anillo se encoge desde el círculo dibujado hasta el pie de la primera v y se vuelve la gota (rAF: los atributos SVG no se animan igual en todos)
      const [gx, gy] = pts[0];
      anillo.style.opacity = '1';
      let a0 = 0;
      const enc = (ahora: number) => {
        if (!a0) a0 = ahora;
        const k = Math.min(1, (ahora - a0) / 520), e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        anillo.setAttribute('cx', String(cx + (gx - cx) * e)); anillo.setAttribute('cy', String(cy + (gy - cy) * e)); anillo.setAttribute('r', String(r + (3 - r) * e));
        if (k < 1) return void requestAnimationFrame(enc);
        anillo.style.opacity = '0'; rota = true; t0 = performance.now(); px = gx; py = gy;
      };
      requestAnimationFrame(enc);
    };
    const mover = (e: PointerEvent) => {
      if (rota || arrancando) return;
      if (e.pointerType === 'touch' && e.buttons === 0) return;
      const ahora = performance.now();
      traza.push({ x: e.clientX, y: e.clientY, t: ahora });
      while (traza.length && ahora - traza[0].t > 1400) traza.shift();
      rastro.setAttribute('points', traza.map((p) => `${p.x},${p.y}`).join(' '));
      if (traza.length < 14) return;
      let cx = 0, cy = 0; for (const p of traza) { cx += p.x; cy += p.y; } cx /= traza.length; cy /= traza.length;
      let giro = 0, radio = 0, prev = Math.atan2(traza[0].y - cy, traza[0].x - cx);
      for (let i = 1; i < traza.length; i++) {
        const a = Math.atan2(traza[i].y - cy, traza[i].x - cx); let d = a - prev; if (d > Math.PI) d -= 2 * Math.PI; if (d < -Math.PI) d += 2 * Math.PI; giro += d; prev = a;
        radio += Math.hypot(traza[i].x - cx, traza[i].y - cy);
      }
      radio /= traza.length - 1;
      if (Math.abs(giro) >= Math.PI * 1.9 && radio >= 18) arrancar(cx, cy, radio);
    };
    addEventListener('pointermove', mover, { passive: true });
    // pista «dibuja un círculo» si a los 1,6 s nadie ha hecho nada
    const pistaT = setTimeout(() => { if (!rota && !arrancando) pista.classList.add('ver'); }, 250); // ronda 68: es el estado inicial
    const saltar = () => acabar(false);
    $('[data-saltar]').addEventListener('click', saltar);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') return saltar();
      if ((e.key === ' ' || e.key === 'Enter') && !rota && !arrancando) { e.preventDefault(); medir(); arrancar(innerWidth / 2, innerHeight / 2, 40); }
    });
    addEventListener('wheel', saltar, { once: true, passive: true });
    document.fonts.ready.then(() => requestAnimationFrame(paso));
    // ── EL TIEMPO DE LA ESTACIÓN (ronda 66): 36 motas que caen (o suben, en verano) detrás de la palabra, en el color de la estación
    {
      const cv = $<HTMLCanvasElement>('[data-tiempo]'), c = cv.getContext('2d')!, dpr = Math.min(2, devicePixelRatio || 1);
      const est = raiz.dataset.estacion || 'otono', arbol = getComputedStyle(raiz).getPropertyValue('--arbol').trim() || '#c65c2d';
      const W = innerWidth, H = innerHeight; cv.width = W * dpr; cv.height = H * dpr; c.scale(dpr, dpr);
      const azar = (a: number, b: number) => a + Math.random() * (b - a);
      const motas = Array.from({ length: 36 }, () => ({ x: azar(0, W), y: azar(-H, H), v: azar(18, 46), r: azar(2, 5), f: azar(0, 6.3), g: azar(-1, 1) }));
      let ant = 0;
      const pinta = (ahora: number) => {
        if (parado || !cv.isConnected) return;
        const dt = ant ? Math.min(0.05, (ahora - ant) / 1000) : 0; ant = ahora;
        c.clearRect(0, 0, W, H);
        for (const m of motas) {
          const sube = est === 'verano';
          m.y += (sube ? -0.35 : 1) * m.v * dt; m.f += dt * (est === 'invierno' ? 0.8 : 1.6);
          const x = m.x + Math.sin(m.f) * (est === 'otono' ? 22 : 10);
          if (!sube && m.y > H + 10) { m.y = -10; m.x = azar(0, W); }
          if (sube && m.y < -10) { m.y = H + 10; m.x = azar(0, W); }
          c.save(); c.translate(x, m.y);
          if (est === 'invierno') { c.globalAlpha = 0.5; c.fillStyle = '#eef3fb'; c.beginPath(); c.arc(0, 0, m.r * 0.6, 0, 7); c.fill(); }
          else if (est === 'verano') { c.globalAlpha = 0.35 + 0.3 * Math.sin(m.f * 2); c.fillStyle = '#ffe3a0'; c.beginPath(); c.arc(0, 0, m.r * 0.45, 0, 7); c.fill(); }
          else if (est === 'primavera') { c.rotate(m.f); c.globalAlpha = 0.6; c.fillStyle = m.g > 0 ? '#f7dfe6' : '#fbeef2'; c.beginPath(); c.ellipse(0, 0, m.r, m.r * 0.6, 0, 0, 7); c.fill(); }
          else { c.rotate(m.f * 0.7 + m.g); c.globalAlpha = 0.55; c.fillStyle = m.g > 0 ? arbol : '#d9a441'; c.beginPath(); c.ellipse(0, 0, m.r * 1.4, m.r * 0.7, 0, 0, 7); c.fill(); }
          c.restore();
        }
        requestAnimationFrame(pinta);
      };
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) requestAnimationFrame(pinta);
    }
  }
</script>

