  .instrumento.dibuja :global(.m) { stroke-dashoffset: 0; transition: stroke-dashoffset 0.55s cubic-bezier(0.5, 0, 0.3, 1) calc(0.1s + var(--o) * 0.32s); }
  /* la bola cae al final, como el punto del isotipo; las partes que se mueven aparecen con ella */
  .instrumento :global(.bola) { scale: 0; transform-box: fill-box; transform-origin: 50% 50%; }
