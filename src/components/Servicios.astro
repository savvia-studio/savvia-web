---
import { langDe } from '../lib/i18n';
import { home } from '../data/idioma';
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { servicios } = home(lang);
// RONDA 132 · Andoni: «que saliera cada servicio y al lado una card marcándose con un check los puntos que cubre, uno detrás de otro».
// RONDA 133 · Andoni: «en vez de hacerte pasar por todos en scroll, que tú puedas seleccionar cuál quieres y que la card cambie los checks en función de eso.
// Para los checks quiero que pase como un cursor que los va marcando y hace el sonidito de click cuando lo marca. Y que los checks se rellenen animadamente
// según se clican». Fuera la escena fija de 300 lvh. Sección normal: a la izquierda el SELECTOR de las tres formas (botones con aria-pressed, ← → con el
// teclado; la activa enseña su descripción) y a la derecha la TARJETA con los dieciséis puntos. Al elegir una forma, un CURSOR (la flecha de un sistema
// operativo, dibujada) recorre la tarjeta de arriba abajo y se para solo donde algo cambia: los puntos que sobran los desmarca deprisa; los que tocan, los
// pulsa (se hunde, suena el clic de la web) y el check se RELLENA de tinta desde el punto del clic y luego se dibuja la marca. Cambiar a mitad cancela y
// reempieza. La primera forma se recorre sola al llegar la sección (sin sonido si el audio aún no está despierto). Móvil: píldoras encima de la tarjeta.
// Movimiento reducido: sin cursor, los checks en su sitio al instante.
const L = servicios.lista;
const GRUPOS = servicios.grupos;
const quien = (t: string) => L.map((s, k) => (s.tags.includes(t) ? k : -1)).filter((k) => k >= 0).join(' ');
// la tarjeta, en dos columnas en escritorio: Estrategia + Diseño | Desarrollo + Después (8 y 8)
const COLS = [GRUPOS.slice(0, 2), GRUPOS.slice(2)];
// «Qué incluye <u>la colaboración</u>:» → solo el nombre del servicio va subrayado
const subrayar = (t: string) => t.replace(/^(Qué incluye (?:la |el )?|What (?:the )?|Includes (?:the )?)(.*?)( includes:|:)$/, '$1<u>$2</u>$3');
const Check = `<svg class="check" viewBox="0 0 20 20" aria-hidden="true"><circle class="onda" cx="10" cy="10" r="9" /><circle class="aro" cx="10" cy="10" r="8.25" /><circle class="relleno" cx="10" cy="10" r="8.25" /><path class="v" d="M6 10.4 8.7 13 14 7.2" pathLength="1" /></svg>`;
---

<section id="servicios" class="surface-warm" aria-labelledby="serv-h" data-servicios data-sube data-sin-fila>
  <div class="wrap section-y">
    <h2 id="serv-h" class="text-h2 max-w-[16ch]" data-entra>{servicios.titulo}</h2>
    <p class="text-sub text-fg2 mt-4">{servicios.sub}</p>

    <div class="cuerpo mt-12" data-serv>
      <!-- RONDA 134 · Andoni: «aprovechar las guías para poner la card y los servicios entre líneas que unen las guías de las esquinas y con las + en
           los extremos». Dos filas de carriles (Carriles.astro las traza de carril a carril, con sus cruces) arriba y abajo del bloque, y un
           divisor vertical entre selector y tarjeta con una cruz en cada extremo. -->
      <i class="fila-guia arriba" data-carril-fila aria-hidden="true"></i>
      <i class="fila-guia abajo" data-carril-fila aria-hidden="true"></i>
      <span class="divisor" aria-hidden="true"><i class="cruz"></i><i class="cruz fin"></i></span>
      <div class="izq">
        <div class="selector" role="group" aria-label={en ? 'Ways of working' : 'Formas de trabajar'} data-selector>
          {
            L.map((s, k) => (
              <div class={`fila${k === 0 ? ' on' : ''}`} data-fila={k}>
                <button type="button" class="opcion" aria-pressed={k === 0 ? 'true' : 'false'} aria-describedby={`serv-d-${k}`} aria-controls="serv-tarjeta" data-opcion={k} tabindex={k === 0 ? 0 : -1}>
                  <span class="nombre font-display">{s.corto}</span>
                </button>
                <div class="d-caja">
                  <p id={`serv-d-${k}`} class="d text-sub">{s.d}</p>
                </div>
              </div>
            ))
          }
        </div>
        <div class="d-movil" aria-hidden="true">
          {L.map((s, k) => <p class={`text-aux${k === 0 ? ' on' : ''}`} data-dm={k}>{s.d}</p>)}
        </div>
      </div>

      <div class="tarjeta" id="serv-tarjeta" data-tarjeta-serv>
        <p class="cab font-display" data-cab data-cabs={JSON.stringify(L.map((s) => s.cab))} set:html={subrayar(L[0].cab)} />
        <div class="cols">
          {
            COLS.map((col) => (
              <div class="col">
                {col.map((g) => (
                  <div class="grupo">
                    <p class="g detail">{g.n}</p>
                    <ul>
                      {g.items.map((t) => (
                        <li class={`punto text-aux${L[0].tags.includes(t) ? ' on' : ''}`} data-quien={quien(t)}>
                          <Fragment set:html={Check} />
                          <span>{t}</span>
                          <span class="sr-only" data-sr>{L[0].tags.includes(t) ? (en ? '(included)' : '(incluido)') : (en ? '(not included)' : '(no incluido)')}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
            ))
          }
        </div>
        <div class="cursor" aria-hidden="true" data-cursor>
          <svg class="flecha" viewBox="0 0 20 24"><path d="M1.5 1.5v17.2l4.4-4.1 2.9 6.6 3-1.3-2.9-6.5h6.1z" /></svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { EN } from '../scripts/i18n';
  const raiz = document.querySelector<HTMLElement>('[data-serv]');
  const quieto = matchMedia('(prefers-reduced-motion: reduce)');
  if (raiz) {
    const tarjeta = raiz.querySelector<HTMLElement>('[data-tarjeta-serv]')!;
    const cursor = raiz.querySelector<HTMLElement>('[data-cursor]')!;
    const flecha = cursor.querySelector<SVGElement>('.flecha')!;
    const cab = raiz.querySelector<HTMLElement>('[data-cab]')!;
    const opciones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-opcion]')];
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-fila]')];
    const dm = [...raiz.querySelectorAll<HTMLElement>('[data-dm]')];
    const L_CAB = JSON.parse(cab.dataset.cabs || '[]') as string[];
    const puntos = [...tarjeta.querySelectorAll<HTMLLIElement>('li[data-quien]')].map((li) => ({
      li,
      s: (li.dataset.quien || '').split(' ').filter(Boolean).map(Number),
      sr: li.querySelector<HTMLElement>('[data-sr]')!,
      c: li.querySelector<SVGElement>('.check')!,
    }));
    type Punto = (typeof puntos)[number];
    let activa = 0, turno = 0, visto = false;
    let pos = { x: 0, y: 0 }, movs: Animation[] = [];
    const EASE = 'cubic-bezier(0.22, 1, 0.36, 1)';

    const marcar = (p: Punto, on: boolean) => {
      p.li.classList.toggle('on', on);
      p.sr.textContent = EN ? (on ? '(included)' : '(not included)') : (on ? '(incluido)' : '(no incluido)');
    };
    const fijar = (k: number) => puntos.forEach((p) => marcar(p, p.s.includes(k)));
    const esperar = (ms: number, t: number) => new Promise<boolean>((r) => setTimeout(() => r(t === turno), ms));
    const centro = (p: Punto) => {
      const a = tarjeta.getBoundingClientRect(), b = p.c.getBoundingClientRect();
      return { x: b.left - a.left + b.width / 2, y: b.top - a.top + b.height / 2 };
    };
    const parar = () => { movs.forEach((m) => m.cancel()); movs = []; cursor.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`; };
    const llevar = async (x: number, y: number, ms: number, t: number) => {
      const de = `translate3d(${pos.x}px, ${pos.y}px, 0)`, a = `translate3d(${x}px, ${y}px, 0)`;
      pos = { x, y };
      cursor.style.transform = a;
      const m = cursor.animate([{ transform: de }, { transform: a }], { duration: ms, easing: EASE });
      movs.push(m);
      try { await m.finished; } catch { return false; }
      return t === turno;
    };
    const pulsar = (rapido: boolean) => {
      movs.push(flecha.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(0.8) translate(1px, 1px)', offset: 0.45 }, { transform: 'scale(1)' }],
        { duration: rapido ? 150 : 230, easing: 'ease-out' },
      ));
    };

    const recorrer = async (k: number, sonar: boolean) => {
      const t = ++turno;
      parar();
      if (quieto.matches) { fijar(k); cursor.classList.remove('ve'); return; }
      const cola = puntos.filter((p) => p.li.classList.contains('on') !== p.s.includes(k));
      if (!cola.length) { cursor.classList.remove('ve'); return; }
      // entra por la esquina de arriba a la derecha de la tarjeta (o sigue donde estaba, si ya se veía)
      if (!cursor.classList.contains('ve')) {
        pos = { x: tarjeta.clientWidth - 28, y: 14 };
        cursor.style.transform = `translate3d(${pos.x}px, ${pos.y}px, 0)`;
        cursor.classList.add('ve');
      }
      for (const p of cola) {
        const pone = p.s.includes(k);
        const c = centro(p);
        const d = Math.hypot(c.x - pos.x, c.y - pos.y);
        const ms = pone ? Math.min(320, 140 + d * 0.28) : Math.min(200, 90 + d * 0.18);
        if (!(await llevar(c.x, c.y, ms, t))) return;
        pulsar(!pone);
        if (!(await esperar(pone ? 70 : 40, t))) return;
        marcar(p, pone);
        // ronda 190 · Eric: «los sonidos de tap de la ilustración animada quitamos»: el cursor marca en silencio
        if (!(await esperar(pone ? 70 : 30, t))) return;
      }
      if (!(await esperar(420, t))) return;
      cursor.classList.remove('ve');
    };

    const elegir = (k: number, sonar = true) => {
      activa = k;
      opciones.forEach((o, i) => { o.setAttribute('aria-pressed', String(i === k)); o.tabIndex = i === k ? 0 : -1; });
      filas.forEach((f, i) => f.classList.toggle('on', i === k));
      dm.forEach((p, i) => p.classList.toggle('on', i === k));
      cab.innerHTML = L_CAB[k].replace(/^(Qué incluye (?:la |el )?|What (?:the )?|Includes (?:the )?)(.*?)( includes:|:)$/, '$1<u>$2</u>$3');
      visto = true;
      recorrer(k, sonar);
    };
    opciones.forEach((o, i) => {
      o.addEventListener('click', () => { if (i !== activa || !visto) elegir(i); });
      o.addEventListener('keydown', (e) => {
        const n = opciones.length;
        let j = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') j = (activa + 1) % n;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') j = (activa - 1 + n) % n;
        else if (e.key === 'Home') j = 0;
        else if (e.key === 'End') j = n - 1;
        if (j < 0) return;
        e.preventDefault();
        opciones[j].focus();
        elegir(j);
      });
    });

    if (!quieto.matches) {
      // con JS, la tarjeta espera vacía y la primera forma se marca al llegar la sección
      tarjeta.classList.add('sin-transicion');
      puntos.forEach((p) => marcar(p, false));
      requestAnimationFrame(() => requestAnimationFrame(() => tarjeta.classList.remove('sin-transicion')));
      const io = new IntersectionObserver((es) => {
        if (!es.some((e) => e.isIntersecting)) return;
        io.disconnect();
        if (!visto) elegir(activa, true);
      }, { rootMargin: '0px 0px -25% 0px', threshold: 0.15 });
      io.observe(tarjeta);
    }
    quieto.addEventListener('change', () => { if (quieto.matches) { turno++; parar(); fijar(activa); cursor.classList.remove('ve'); } });
    (window as any).__servicios = { elegir, activa: () => activa };
  }
</script>

<style>
  /* ronda 152 · «a servicios dejarles más aire por abajo, 80 px más» */
  /* ronda 192 · «falta un poco de espacio aquí abajo» (Eric): +80 más (la gota de la sección siguiente se come parte del hueco) */
  /* ronda 191 · Eric: «cada sección, arriba y abajo, el mismo espacio hasta su línea»: los 160 px extra (para la gota de la sección siguiente, que
     sube ~240 px) se reparten por igual: línea de arriba → titular = línea de abajo del bloque → fin de la sección */
  /* ronda 215 · Eric: «hay mucho espacio» entre Más proyectos y Servicios, y entre Servicios y la siguiente: los 272 px de arriba y de abajo (192 + 80) bajan a 144 y 163 en escritorio */
  [data-servicios] > .wrap { padding-top: max(4rem, calc(var(--space-section) * 0.75)); padding-bottom: calc(clamp(90px, 24lvh, 240px) * 0.9); } /* ronda 216: abajo, casi la altura de la gota de Estudio (.sube: clamp(90px, 24lvh, 240px)); antes 163 (0,85 × la sección) */
  @media (width < 48rem) { [data-servicios] > .wrap { padding-top: 1.5rem; } } /* ronda 292 · móvil: «el titular un poco más arriba» */
  /* ── EL BLOQUE ENTRE GUÍAS (ronda 134): las líneas de arriba y abajo son filas de los carriles; el bloque se apoya en ellas */
  .cuerpo { --hueco: calc(var(--spacing) * 16); position: relative; display: grid; gap: calc(var(--spacing) * 8); align-items: stretch; padding-block: calc(var(--spacing) * 6) calc(var(--spacing) * 12); } /* ronda 268: móvil, la línea de abajo (con sus +) más abajo: 48 px tras la lista (Eric) */
  @media (width >= 64rem) {
    .cuerpo { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--hueco); padding-block: 0; }
  }
  .fila-guia { position: absolute; left: 0; width: 0; height: 0; pointer-events: none; }
  .fila-guia.arriba { top: 0; }
  .fila-guia.abajo { bottom: 0; }
  /* el divisor: la misma línea y las mismas cruces que los carriles (niebla al 14 % y al 70 %, mezcla por diferencia) */
  .divisor {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc((100% - var(--hueco)) * 5 / 12 + var(--hueco) / 2);
    width: 1px;
    pointer-events: none;
    mix-blend-mode: difference;
    background: color-mix(in srgb, var(--color-niebla) 14%, transparent);
  }
  .divisor .cruz {
    position: absolute;
    top: 0;
    left: 0;
    width: 9px;
    height: 9px;
    translate: -4px -4px;
    background:
      linear-gradient(color-mix(in srgb, var(--color-niebla) 70%, transparent), color-mix(in srgb, var(--color-niebla) 70%, transparent)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(color-mix(in srgb, var(--color-niebla) 70%, transparent), color-mix(in srgb, var(--color-niebla) 70%, transparent)) 0 50% / 100% 1px no-repeat;
  }
  .divisor .cruz.fin { top: auto; bottom: 0; translate: -4px 4px; }
  @media (width >= 64rem) {
    .divisor { display: block; }
  }

  /* ── EL SELECTOR (escritorio: tres filas grandes; la activa abre su descripción; la primera arranca en la línea de arriba) */
  .selector { display: flex; flex-direction: column; }
  .fila { border-bottom: 1px solid var(--rule); }
  .fila:last-child { border-bottom: 0; } /* la línea de abajo ya es la guía */
  .opcion {
    display: flex;
    align-items: baseline;
    gap: calc(var(--spacing) * 4);
    width: 100%;
    padding-block: calc(var(--spacing) * 6);
    text-align: left;
    color: var(--fg);
    cursor: pointer;
    border-radius: calc(var(--spacing) * 2);
  }
  .opcion:focus-visible { outline: 2px solid var(--fg); outline-offset: 4px; }
  .nombre {
    font-size: clamp(2.25rem, 1.4rem + 2.2vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    opacity: 0.6; /* 28/10: 0,38 daba 2:1 (texto grande, mínimo 3:1); 0,6 pasa en las cuatro estaciones */
    transition: opacity 0.35s ease;
  }
  .fila:not(.on) .opcion:hover .nombre { opacity: 0.8; }
  .fila.on .nombre { opacity: 1; }
  .d-caja { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.55s var(--ease-out-expo); }
  .d-caja > .d { overflow: hidden; min-height: 0; }
  .fila.on .d-caja { grid-template-rows: 1fr; }
  .d {
    color: var(--fg2);
    text-wrap: pretty;
    max-width: 34ch;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .fila.on .d { opacity: 1; padding-bottom: calc(var(--spacing) * 6); transition: opacity 0.5s ease 0.12s; }
  .d-movil { display: none; }

  /* ── MÓVIL Y TABLETA: píldoras encima de la tarjeta, la descripción debajo */
  @media (width < 64rem) {
    .selector { flex-direction: row; flex-wrap: wrap; gap: calc(var(--spacing) * 2); border-top: 0; }
    .fila { border-bottom: 0; flex: none; }
    .d-caja { display: none; }
    .opcion {
      padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3);
      border-radius: 999px;
      box-shadow: inset 0 0 0 1px var(--rule-strong);
      align-items: center;
      transition: background-color 0.3s ease, color 0.3s ease;
    }
    /* RONDA 268 · Eric: «probemos estas pill con typo heading»: las píldoras en la letra de titular (Family 400), un poco más grandes porque la serif lee pequeña */
    .nombre { font-family: var(--font-display); font-size: 1.125rem; font-weight: 400; letter-spacing: -0.01em; line-height: 1.2; opacity: 0.8; }
    .fila.on .opcion { background: var(--fg); color: var(--color-niebla); }
    .d-movil { display: grid; margin-top: calc(var(--spacing) * 4); }
    .d-movil p { grid-area: 1 / 1; color: var(--fg2); text-wrap: pretty; opacity: 0; transition: opacity 0.35s ease; }
    .d-movil p.on { opacity: 1; transition-delay: 0.1s; }
  }

  /* ── LA TARJETA (papel claro sobre el salvia) */
  /* ── LA TARJETA (ronda 134: sin caja propia; es la celda entre las guías, a la derecha del divisor) */
  .tarjeta {
    position: relative;
    padding-block: calc(var(--spacing) * 12); /* ronda 191: el mismo aire que el selector hasta las dos líneas (48 px) */
  }
  @media (width >= 64rem) {
    .selector { padding-block: calc(var(--spacing) * 6); } /* + los 24 de cada opción = 48 px hasta cada línea */
  }
  .cab { margin-top: calc(var(--spacing) * -4); color: var(--fg); font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem); line-height: 1.1; letter-spacing: -0.02em; } /* «Qué incluye…» en letra de titular, un pelín más arriba (Eric) */
  .cab :global(u) { text-decoration-thickness: 1px; text-underline-offset: 0.18em; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; column-gap: calc(var(--spacing) * 8); margin-top: calc(var(--spacing) * 8); }
  .grupo + .grupo { margin-top: calc(var(--spacing) * 6); }
  .g { color: var(--fg2); padding-bottom: calc(var(--spacing) * 2); border-bottom: 1px solid var(--rule); }
  .punto {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    min-height: calc(var(--spacing) * 8);
    padding-block: calc(var(--spacing) * 1);
    border-bottom: 1px solid var(--rule);
    color: var(--fg);
    opacity: 0.76; /* 28/10: lo que no incluye, al 40 % daba 2,1:1; al 76 %, más de 4,5 en las cuatro estaciones (lo distingue el check vacío) */
    transition: opacity 0.25s ease;
  }
  .punto.on { opacity: 1; transition: opacity 0.4s ease; }

  /* el check: un aro; al pulsarlo, la tinta lo llena desde el punto del clic (el centro, donde cae la punta del cursor), sale una onda y se dibuja la marca */
  .punto :global(.check) { flex: none; width: 20px; height: 20px; overflow: visible; }
  .punto :global(.check) :global(circle),
  .punto :global(.check) :global(.v) { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .punto :global(.check) :global(.aro) { stroke: var(--rule-strong); stroke-width: 1.1; opacity: 0.4; transition: opacity 0.25s ease; }
  .punto :global(.check) :global(.relleno) {
    fill: var(--fg);
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0);
    transition: transform 0.18s ease-in;
  }
  .punto :global(.check) :global(.onda) {
    stroke: var(--fg);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    transform: scale(0.6);
  }
  .punto :global(.check) :global(.v) {
    stroke: var(--color-niebla);
    stroke-width: 1.4; /* RONDA 144 · Eric: «el tic, un poco más finito» (antes 2) */
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.12s ease-in;
  }
  .punto.on :global(.check) :global(.aro) { opacity: 1; }
  .punto.on :global(.check) :global(.relleno) { transform: scale(1); transition: transform 0.36s cubic-bezier(0.34, 1.5, 0.64, 1); }
  .punto.on :global(.check) :global(.onda) { animation: serv-onda 0.6s var(--ease-out-expo) both; }
  .punto.on :global(.check) :global(.v) { stroke-dashoffset: 0; transition: stroke-dashoffset 0.4s var(--ease-out-expo) 0.14s; }
  @keyframes serv-onda {
    0% { opacity: 0.55; transform: scale(0.6); }
    100% { opacity: 0; transform: scale(1.9); }
  }
  .tarjeta.sin-transicion .punto,
  .tarjeta.sin-transicion :global(.check) :global(*) { transition: none !important; animation: none !important; }

  /* el cursor: la flecha de un sistema operativo, con la punta en (0, 0) */
  .cursor {
    position: absolute;
    left: 0;
    top: 0;
    width: 20px;
    height: 24px;
    margin: -2px 0 0 -2px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }
  .cursor.ve { opacity: 1; transition-duration: 0.2s; }
  .flecha { display: block; width: 100%; height: 100%; overflow: visible; transform-origin: 2px 2px; filter: drop-shadow(0 2px 3px color-mix(in oklab, var(--color-cacao) 28%, transparent)); }
  .flecha path { fill: var(--color-cacao); stroke: var(--color-niebla); stroke-width: 1.3; stroke-linejoin: round; }

