  }
  /* ── RONDA 95 · la frase y su SELECTOR de casos (sustituye a la tira de entradas de la ronda 92) */
  .frase { max-width: 60rem; text-wrap: pretty; }
  /* la píldora y su punto nunca se separan; en pantallas estrechas van siempre en su propia línea (si no, al cambiar de ancho saltaban de línea) */
  .con-sel { white-space: nowrap; }
  @media (width < 40rem) { .con-sel { display: block; margin-top: calc(var(--spacing) * 2); } .selector { margin-inline: 0; } }
