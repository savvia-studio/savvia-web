---
import { servicios } from '../data/home';
// RONDA 73 · «la sección de tres maneras de trabajar contigo tenemos que mejorarla, no me gusta; démosle una vuelta». Lo que fallaba desde la ronda 66: una nube de
// etiquetas que viajaba de una forma a otra y nunca quedaba claro de cuál era. Ahora es una TABLA: las tres formas en columnas (nombre y lo que es) y lo que
// incluye cada una en filas, ordenadas en cuatro grupos. Donde una forma lo incluye cae una gota de savia; donde no, un filete. Una banda de CRISTAL con las
// cruces del CTA marca la columna que miras (sigue al puntero; por defecto, la primera). Las gotas caen fila a fila al llegar. En móvil, tres fichas con su lista.
const L = servicios.lista;
const GRUPOS: { n: string; items: string[] }[] = [
  { n: 'Estrategia', items: ['Narrativa de la web', 'Arquitectura de contenidos', 'Auditoría de tu web'] },
  { n: 'Diseño y movimiento', items: ['Diseño digital', 'Sistema de diseño', 'Ilustraciones animadas (Lottie)', 'Animaciones 3D', 'Interacciones GSAP'] },
  { n: 'Desarrollo', items: ['Desarrollo agéntico', 'Integraciones con CMS (Sanity, Supabase…)', 'Multilenguaje', 'Migraciones de Webflow y WordPress a IA', 'SEO técnico', 'Accesibilidad y rendimiento'] },
  { n: 'Después', items: ['La receta: savvia.md', 'Formación a tu equipo'] },
];
const tiene = (k: number, t: string) => L[k].tags.includes(t);
let fila = 0;
---

<section id="servicios" class="surface-warm" aria-labelledby="serv-h" data-servicios data-sube>
  <div class="wrap section-y">
    <h2 id="serv-h" class="text-h2 max-w-[16ch]" data-entra>{servicios.titulo}</h2>
    <p class="text-sub text-fg2 mt-4">{servicios.sub}</p>

    <!-- ESCRITORIO: la tabla -->
    <div class="tabla mt-16 lg:mt-24" role="table" aria-label="Qué incluye cada forma de trabajar" data-tabla data-col="0">
      <i class="banda" aria-hidden="true" data-banda></i>
      <!-- RONDA 74 · «que los titulares sigan el scroll para que puedas seguir leyendo lo que incluye cada uno»: la cabecera se queda pegada bajo la barra
           y, pegada, se recoge (solo nombre y cuenta) -->
      <i class="centinela" aria-hidden="true" data-centinela></i>
      <div class="fila cabeza" role="row" data-cabeza>
        <span class="celda etiqueta" role="columnheader"><span class="sr-only">Qué incluye</span></span>
        {
          L.map((s, k) => (
            <div class="celda col" role="columnheader" data-c={k}>
              <h3 class="nombre font-display">{s.corto}</h3>
              <p class="d text-aux mt-3">{s.d}</p>
            </div>
          ))
        }
      </div>
      {
        GRUPOS.map((g) => (
          <>
            <div class="fila grupo" role="row"><span class="celda detail" role="rowheader">{g.n}</span></div>
            {g.items.map((t) => (
              <div class="fila item" role="row" style={`--f:${fila++}`} data-fila>
                <span class="celda etiqueta text-ui" role="rowheader">{t}</span>
                {L.map((_, k) => (
                  <span class="celda marca" role="cell" data-c={k}>
                    {tiene(k, t) ? <i class="si" aria-label="Incluido" style={`--k:${k}`} /> : <i class="no" aria-label="No incluido" />}
                  </span>
                ))}
              </div>
            ))}
          </>
        ))
      }
    </div>

    <!-- MÓVIL: tres fichas, cada una con su lista -->
    <div class="fichas mt-12">
      {
        L.map((s) => (
          <article class="ficha-s">
            <h3 class="nombre font-display">{s.corto}</h3>
            <p class="d text-aux mt-3">{s.d}</p>
            <ul class="lista-s mt-6">
              {GRUPOS.flatMap((g) => g.items).filter((t) => s.tags.includes(t)).map((t) => <li class="text-ui"><i class="si" aria-hidden="true" />{t}</li>)}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabla = document.querySelector<HTMLElement>('[data-tabla]');
  if (tabla) {
    const banda = tabla.querySelector<HTMLElement>('[data-banda]')!, cabezas = [...tabla.querySelectorAll<HTMLElement>('.cabeza [data-c]')];
    // la banda de cristal se coloca sobre la columna activa (toda la altura de la tabla)
    const colocar = () => {
      const k = Number(tabla.dataset.col || 0), c = cabezas[k], t = tabla.getBoundingClientRect(), r = c.getBoundingClientRect();
      banda.style.transform = `translateX(${(r.left - t.left).toFixed(1)}px)`; banda.style.width = `${r.width.toFixed(1)}px`;
    };
    // RONDA 76 · Eric: «la interacción del cambio, no sé si está muy fina»: la columna cambia por INTENCIÓN (el puntero se queda 90 ms en ella), no al
    // rozarla al cruzar en diagonal; y al salir de la tabla vuelve a la que se miraba (sin saltos)
    let intento = 0;
    tabla.addEventListener('pointerover', (e) => {
      const c = (e.target as HTMLElement).closest<HTMLElement>('[data-c]');
      clearTimeout(intento);
      if (c && c.dataset.c !== tabla.dataset.col) intento = window.setTimeout(() => { tabla.dataset.col = c.dataset.c; colocar(); }, 90);
    });
    tabla.addEventListener('pointerleave', () => clearTimeout(intento));
    addEventListener('resize', colocar); document.fonts?.ready.then(colocar); colocar();
    // pegada: cuando el centinela (justo encima de la cabecera) pasa bajo la barra
    const cab = tabla.querySelector<HTMLElement>('[data-cabeza]')!;
    const top = () => parseFloat(getComputedStyle(cab).top) || 0;
    let ioP: IntersectionObserver | null = null;
    const vigilar = () => { ioP?.disconnect(); ioP = new IntersectionObserver((e) => cab.classList.toggle('pegada', !e[0].isIntersecting && e[0].boundingClientRect.top < top()), { rootMargin: `-${Math.round(top()) + 1}px 0px 0px 0px` }); ioP.observe(tabla.querySelector('[data-centinela]')!); };
    vigilar(); addEventListener('resize', vigilar);
    // las gotas caen fila a fila al llegar
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('llega'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
    tabla.querySelectorAll('[data-fila]').forEach((f) => io.observe(f));
  }
</script>

<style>
  /* ── LA TABLA (escritorio) */
  .tabla {
    display: none;
    position: relative;
    --cols: minmax(0, 4fr) repeat(3, minmax(0, 2.6fr));
  }
  .fila {
    display: grid;
    grid-template-columns: var(--cols);
    column-gap: calc(var(--spacing) * 6);
    align-items: center;
  }
  .celda { position: relative; z-index: 1; }
  .centinela { display: block; height: 1px; }
  .cabeza {
    position: sticky;
    top: calc(var(--spacing) * 22); /* bajo la barra */
    z-index: 2;
    align-items: start;
    padding-bottom: calc(var(--spacing) * 2);
    background-color: var(--bg);
    background-image: url('/media/grano.png');
    background-size: 240px 240px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.4s ease;
  }
  .cabeza .col { padding: calc(var(--spacing) * 6) calc(var(--spacing) * 4) 0; }
  /* la cabecera tapa la banda: la columna activa lleva su mismo tinte */
  .tabla[data-col='0'] .cabeza [data-c='0'],
  .tabla[data-col='1'] .cabeza [data-c='1'],
  .tabla[data-col='2'] .cabeza [data-c='2'] { background: color-mix(in oklab, var(--fg) 6%, transparent); align-self: stretch; }
  .cabeza .d { overflow: hidden; }
  .cabeza .d { max-height: 12em; transition: max-height 0.5s var(--ease-out-expo), opacity 0.3s ease, margin 0.5s var(--ease-out-expo); }
  .cabeza.pegada { border-bottom-color: var(--rule-strong, var(--rule)); }
  /* pegada, el fondo sube hasta el borde de la pantalla: las filas no asoman bajo la barra */
  .cabeza.pegada::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: calc(var(--spacing) * 22);
    background: inherit;
  }
  .cabeza.pegada .d { max-height: 0; opacity: 0; margin-top: 0; }
  .cabeza.pegada .col { padding-top: calc(var(--spacing) * 3); padding-bottom: calc(var(--spacing) * 3); }
  .nombre {
    font-size: clamp(2rem, 1.2rem + 1.6vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .d { color: var(--fg2); text-wrap: pretty; }
  .grupo {
    padding-top: calc(var(--spacing) * 8);
    padding-bottom: calc(var(--spacing) * 3);
    border-bottom: 1px solid var(--rule-strong, var(--rule));
  }
  .grupo .celda { color: var(--fg2); grid-column: 1 / -1; }
  .item {
    min-height: calc(var(--spacing) * 12);
    border-bottom: 1px solid var(--rule);
  }
  .item .etiqueta { padding-block: calc(var(--spacing) * 3); }
  .marca { display: grid; place-items: center; align-self: stretch; }
  /* incluido: una gota de savia; no incluido: un filete */
  .si {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-coral);
  }
  .no {
    display: inline-block;
    width: 14px;
    height: 1px;
    background: color-mix(in oklab, var(--fg) 28%, transparent);
  }
  /* las gotas caen fila a fila (y cada una, un poco después que la de su izquierda) */
  :global(html.anima) .item .si {
    scale: 0;
    translate: 0 -10px;
    transition: scale 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), translate 0.6s var(--ease-out-expo);
    transition-delay: calc(var(--k) * 90ms);
  }
  :global(html.anima) .item.llega .si { scale: 1; translate: 0 0; }
  /* la columna que miras: menos tinta en las demás */
  .col, .marca { transition: opacity 0.6s var(--ease-out-expo); }
  .tabla[data-col='0'] [data-c]:not([data-c='0']),
  .tabla[data-col='1'] [data-c]:not([data-c='1']),
  .tabla[data-col='2'] [data-c]:not([data-c='2']) { opacity: 0.5; }
  /* la BANDA de cristal sobre la columna activa (ronda 76: redondeada, sin cruces) */
  .banda {
    border-radius: calc(var(--spacing) * 4);
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0;
    background: color-mix(in oklab, var(--fg) 6%, transparent); /* sin desenfoque de fondo: emborronaba los filetes de las filas */
    pointer-events: none;
    transition: transform 0.7s var(--ease-out-expo), width 0.7s var(--ease-out-expo);
  }
  /* ── LAS FICHAS (móvil) */
  .fichas { display: grid; gap: calc(var(--spacing) * 12); }
  .ficha-s {
    border-radius: calc(var(--spacing) * 4);
    padding: calc(var(--spacing) * 6);
    background: color-mix(in oklab, var(--fg) 7%, transparent);
  }
  .lista-s { display: grid; gap: calc(var(--spacing) * 3); }
  .lista-s li { display: flex; align-items: center; gap: calc(var(--spacing) * 3); }
  .lista-s .si { flex: none; width: 8px; height: 8px; }
  @media (width >= 64rem) {
    .tabla { display: block; }
    .fichas { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .banda, .col, .marca { transition: none; }
    :global(html.anima) .item .si { scale: 1; translate: 0 0; transition: none; }
  }
</style>
