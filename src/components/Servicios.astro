  }
  .valor.on, .valor.sale { transition: translate 0.7s var(--ease-out-expo), opacity 0.45s ease, filter 0.6s var(--ease-out-expo); }
  /* filter: none (no blur(0)): WebKit dejaba el texto ya posado algo blando; none ↔ blur() interpola igual */
  .valor.on { opacity: 1; translate: 0 0; filter: none; }
  .valor.sale { opacity: 0; translate: 0 -70%; filter: blur(3px); }
  .chev, .hilo { display: none !important; } /* ronda 117: sin cheurones ni hilo: solo la palabra */
  .chev { flex: none; width: 10px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; opacity: 0.6; }
  /* el hilo del tiempo: en el filo de abajo de la píldora, en la tinta del texto (el Coral sobre el Salvia no se vería) */
  .hilo {
    position: absolute;
    left: calc(var(--spacing) * 4);
    right: calc(var(--spacing) * 3);
    bottom: -1px; /* sobre el filo de abajo: el borde se va llenando de tinta (bajo el texto se leía como un subrayado) */
    height: 1px;
    background: color-mix(in oklab, var(--fg) 55%, transparent);
    transform-origin: 0 50%;
    scale: 0 1;
    opacity: 0;
  }
  .selector.corre .hilo { opacity: 1; scale: 1 1; transition: scale var(--paso, 3.4s) linear, opacity 0.3s ease; }
  /* ── RONDA 92 · los instrumentos a PLUMILLA (el modo del isotipo): formas rellenas en la tinta del texto, escritas al entrar */
