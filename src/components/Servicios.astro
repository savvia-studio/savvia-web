---
import { servicios } from '../data/home';
const LETRA = ['01', '02', '03', '04']; // ronda 44 · «los servicios no van por letras, van por número»
// RONDA 53 · una petición REAL del manual de Neety (neety.treseiscero.app/library › «Añadir secciones nuevas»), tal cual la escribe su equipo
const PETICION = '«Añade una métrica más a la sección “Por qué Neety”: 3x reuniones cualificadas.»';
// RONDA 54 · «cuando haces hover, representar un ejemplo real pero cómo se ejecuta, cómo se va construyendo cada caso». Cada demo es un PROCESO en bucle:
//   Web a medida · Zernio: el briefing (su tesis real), el boceto (las cajas de su hero, medidas en su captura), el sistema (sus colores) y la web real.
//   Cambios con IA · Neety: la petición real de su manual, lo que hace el agente (los pasos que el manual le pide), la vista previa y publicado.
//   Equipos con IA · Neety: el recorrido de su equipo por su manual real (cuatro apartados: recibir, cambiar, añadir, buenas prácticas).
const BRIEF = ['Zernio · API de redes y mensajería', 'para desarrolladores', 'la idea: 23 canales, una sola llamada', 'tono: técnico y cercano'];
// el hero de Zernio (zernio-hero.webp, 4:3) en cajas: barra, aviso, titular (2 líneas), subtítulo, dos botones y la ventana de código
const CAJAS = [
  { c: 'nav', x: 4, y: 2, w: 92, h: 4 },
  { c: 'aviso', x: 39, y: 19, w: 22, h: 3 },
  { c: 'tit', x: 22, y: 25, w: 56, h: 6 },
  { c: 'tit', x: 22, y: 32, w: 56, h: 6 },
  { c: 'sub', x: 28, y: 40, w: 44, h: 6 },
  { c: 'cta', x: 37.5, y: 51, w: 11, h: 4.5 },
  { c: 'cta2', x: 49.5, y: 51, w: 13, h: 4.5 },
  { c: 'codigo', x: 15, y: 62, w: 70, h: 38 },
];
const AGENTE = ['lee la receta de la web', 'usa Naranja Core y la tarjeta blanca', 'la añade en español e inglés', 'la revisa en el móvil'];
const MANUAL = [{ f: 'recibir', t: 'recibir' }, { f: 'cambiar', t: 'cambiar' }, { f: 'secciones', t: 'añadir' }, { f: 'practicas', t: 'publicar' }];
---

<!--
  SERVICIOS (rondas 39–40). Referencia de Andoni: athleticsnyc.com, «Our specialties» (medida en tools/ref39/): lista tipográfica ENORME con letra de
  índice; la tinta de cada nombre SE LLENA con el scroll. RONDA 40 · «al hacer hover no usamos lo mismo que la referencia: pensemos qué puede salir que
  tenga sentido con lo que se cuenta. Y fuera el savvia agentic de aquí»: al pasar por un servicio (o enfocarlo) las otras se retiran y, entre el
  nombre y lo que te llevas, sale una DEMO pequeña de lo que ES ese servicio, en bucle:
    A · Web nueva  — la página nace en BOCETO (cajas a trazos) y se pinta: de la idea a la web (el mismo gesto que las tarjetas de los dolores).
    B · Evolución  — la web que ya tienes recibe una sección nueva y otro idioma, y sale publicada: cambios en días.
    C · Formación  — tu equipo va marcando lo que ya sabe hacer con agentes: leer su savvia, pedir un cambio, revisarlo y publicarlo.
  En móvil (sin hover) la demo va debajo, siempre, y corre mientras se ve. Sección en Rosa arcilla (ronda 40: después de Proyectos la web es clara).
-->
<section id="servicios" class="surface-warm" aria-labelledby="serv-h" data-servicios data-sube>
  <div class="wrap section-y">
    <h2 id="serv-h" class="text-h2 max-w-[16ch]" data-entra>{servicios.titulo}</h2>
    <ol class="lista mt-16 lg:mt-24" data-lista>
      {
        servicios.lista.map((s, i) => (
          <li class="servicio" data-servicio={i}>
            <span class="letra detail tabular-nums" aria-hidden="true">{LETRA[i]}</span>
            <button type="button" class="nombre font-display" aria-expanded="false" aria-describedby={`serv-d${i}`} data-nombre>
              <span class="tinta" data-tinta>{s.corto}</span>
            </button>
            <div class={`demo d-${s.demo}`} aria-hidden="true" data-demo>
              <div class="mini">
                <span class="barra"><i /><i /><i /><b class="dir">{s.demo === 'nueva' ? 'zernio.treseiscero.app' : s.demo === 'formacion' ? 'neety · manual' : 'neety · agente'}</b></span>
                {s.demo === 'nueva' && (
                  <div class="obra">
                    <div class="fase f-brief">
                      <p class="etq-f">briefing</p>
                      {BRIEF.map((l, k) => <p class="linea-b" style={`--k:${k}`}>{l}</p>)}
                    </div>
                    <div class="fase f-boceto" aria-hidden="true">
                      {CAJAS.map((c) => <i class={`caja ${c.c}`} style={`left:${c.x}%;top:${c.y}%;width:${c.w}%;height:${c.h}%`} />)}
                    </div>
                    <img class="fase f-web" src="/media/servicios/zernio-hero.webp" alt="" width="720" height="540" loading="lazy" decoding="async" />
                    <span class="pasos-obra">{['briefing', 'boceto', 'sistema', 'web'].map((t, k) => <b style={`--k:${k}`}>{t}</b>)}</span>
                  </div>
                )}
                {s.demo === 'evolucion' && (
                  <div class="obra">
                    <div class="fase f-pide">
                      <p class="quien-pide">su equipo pide</p>
                      <p class="peticion">{PETICION.split(' ').map((w, n) => <span style={`--n:${n}`}>{w} </span>)}</p>
                      <div class="agente">
                        {AGENTE.map((l, k) => <p class="paso-ag" style={`--k:${k}`}><i />{l}</p>)}
                      </div>
                    </div>
                    <div class="fase f-vista">
                      <img src="/media/servicios/neety-hero.webp" alt="" width="720" height="540" loading="lazy" decoding="async" />
                      <span class="metrica"><b>3x</b> reuniones cualificadas</span>
                      <span class="publicado">publicado en neety.com ✓</span>
                    </div>
                    <span class="pasos-obra">{['pide', 'agente', 'revisa', 'publica'].map((t, k) => <b style={`--k:${k}`}>{t}</b>)}</span>
                  </div>
                )}
                {s.demo === 'formacion' && (
                  <div class="obra manual">
                    {MANUAL.map((m, k) => <img class="hoja" style={`--k:${k}`} src={`/media/servicios/manual-${m.f}.webp`} alt="" width="760" height="570" loading="lazy" decoding="async" />)}
                    <span class="pasos-obra">{MANUAL.map((m, k) => <b style={`--k:${k}`}>{m.t}</b>)}</span>
                  </div>
                )}
              </div>
              <p class="fuente detail"><b>Ejemplo real · {s.ejemplo.de}</b> {s.ejemplo.que}</p>
            </div>
            <div class="bajada" id={`serv-d${i}`}>
              <p class="text-ui font-medium">{s.t}</p>
              <p class="text-aux text-fg2 mt-2">{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const raiz = document.querySelector<HTMLElement>('[data-servicios]');
  if (raiz) {
    const lista = raiz.querySelector<HTMLElement>('[data-lista]')!;
    const items = [...raiz.querySelectorAll<HTMLElement>('[data-servicio]')];
    const botones = items.map((li) => li.querySelector<HTMLButtonElement>('[data-nombre]')!);
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const conRaton = matchMedia('(width >= 64rem) and (hover: hover) and (pointer: fine)');
    let abierto = -1;
    // al abrirse, la demo empieza desde el principio (se clona: todas sus piezas van a una)
    const reiniciar = (li: HTMLElement) => { const d = li.querySelector('.mini')!; d.replaceWith(d.cloneNode(true)); };
    // RONDA 54 · cada proceso dura 10 s y usa retrasos (palabras, pasos del agente) que CSS solo aplica en la primera vuelta: mientras está abierto,
    // se reinicia entero cada 10 s y cada vuelta se construye igual que la primera
    const relojes = new Map<HTMLElement, number>();
    const encender = (li: HTMLElement, on: boolean) => {
      if (on === li.classList.contains('on')) return;
      clearInterval(relojes.get(li));
      if (on) { reiniciar(li); relojes.set(li, window.setInterval(() => reiniciar(li), 10000)); }
      li.classList.toggle('on', on);
    };
    const abrir = (i: number) => {
      if (i === abierto) return;
      abierto = i;
      lista.classList.toggle('con-uno', i >= 0);
      items.forEach((li, k) => encender(li, k === i));
      botones.forEach((b, k) => b.setAttribute('aria-expanded', String(k === i)));
    };
    botones.forEach((b, i) => {
      b.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse' && conRaton.matches) abrir(i); });
      b.addEventListener('focus', () => { if (conRaton.matches) abrir(i); });
      b.addEventListener('click', () => { if (conRaton.matches) abrir(i); });
    });
    lista.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') abrir(-1); });
    lista.addEventListener('focusout', (e) => { if (!lista.contains(e.relatedTarget as Node)) abrir(-1); });
    // sin ratón: cada demo corre mientras se ve
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (!conRaton.matches) encender((e.target as HTMLElement).closest<HTMLElement>('.servicio')!, e.isIntersecting); }), { threshold: 0.4 });
    raiz.querySelectorAll('[data-demo]').forEach((d) => io.observe(d));

    // LA TINTA QUE SE LLENA: cada nombre pasa de apagado a plena tinta, de izquierda a derecha, mientras cruza la parte baja de la pantalla
    const tintas = [...raiz.querySelectorAll<HTMLElement>('[data-tinta]')];
    if (reducido) tintas.forEach((t) => t.style.setProperty('--p', '106%'));
    else {
      let visible = false, pedido = false;
      const pintar = () => {
        pedido = false;
        const vh = innerHeight;
        tintas.forEach((t) => { const r = t.getBoundingClientRect(); const p = Math.min(1, Math.max(0, (vh * 0.92 - r.top) / (vh * 0.42))); t.style.setProperty('--p', `${(p * 112).toFixed(1)}%`); });
      };
      const pedir = () => { if (visible && !pedido) { pedido = true; requestAnimationFrame(pintar); } };
      new IntersectionObserver((e) => { visible = e[0].isIntersecting; pedir(); }, { rootMargin: '10% 0px' }).observe(lista);
      addEventListener('scroll', pedir, { passive: true });
      addEventListener('resize', pedir);
      pintar();
    }
  }
</script>

<style>
  .lista {
    border-top: 1px solid var(--rule);
  }
  .servicio {
    position: relative;
    display: grid;
    grid-template-columns: calc(var(--spacing) * 8) minmax(0, 1fr);
    column-gap: calc(var(--spacing) * 3);
    row-gap: calc(var(--spacing) * 4);
    padding-block: calc(var(--spacing) * 6);
    border-bottom: 1px solid var(--rule);
    transition: opacity 0.5s var(--ease-out-expo), filter 0.5s var(--ease-out-expo);
  }
  .letra {
    padding-top: 0.9em;
    color: var(--fg2);
  }
  .nombre {
    justify-self: start;
    text-align: left;
    font-size: clamp(3rem, 1.4rem + 5.2vw, 6rem); /* 48 → 96 */
    line-height: 1;
    letter-spacing: -0.025em;
    cursor: default;
  }
  /* la tinta que se llena con el scroll: plena hasta --p, apagada después */
  .tinta {
    background: linear-gradient(90deg, var(--fg) calc(var(--p, 0%) - 6%), color-mix(in oklab, var(--fg) 28%, transparent) calc(var(--p, 0%) + 6%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .bajada,
  .demo {
    grid-column: 2;
  }
  .bajada {
    max-width: 34ch;
  }

  /* ── LA DEMO: una ventana pequeña en Rosa niebla con la página dibujada en Cacao */
  .demo {
    width: min(100%, 20rem);
  }
  .mini {
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--spacing) * 3);
    background: var(--color-niebla);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-cacao) 12%, transparent), 0 18px 40px -22px color-mix(in oklab, var(--color-cacao) 55%, transparent);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--color-cacao);
    container-type: inline-size;
  }
  .barra {
    display: flex;
    gap: 1.6cqw;
    padding: 2.6cqw 3.2cqw;
    border-bottom: 1px solid color-mix(in oklab, var(--color-cacao) 12%, transparent);
  }
  .barra i {
    width: 2cqw;
    height: 2cqw;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-cacao) 22%, transparent);
  }
  .lienzo {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2.6cqw;
    padding: 5cqw 6cqw;
  }
  .b {
    display: block;
    border-radius: 1.2cqw;
    background: color-mix(in oklab, var(--color-cacao) 16%, transparent);
  }
  .b.tit { height: 5.2cqw; width: 72%; background: var(--color-cacao); }
  .b.tit.corta { width: 46%; }
  .b.txt { height: 2cqw; width: 88%; }
  .b.txt.corta { width: 56%; }
  /* las demos solo corren con su servicio abierto (o, sin ratón, a la vista) */
  .servicio:not(.on) .demo *,
  .servicio:not(.on) .demo *::before,
  .servicio:not(.on) .demo *::after {
    animation-play-state: paused !important;
  }

  /* RONDA 54 · LOS PROCESOS (bucle de 10 s): cada demo va por cuatro fases y abajo se encienden sus pasos */
  .dir {
    margin-left: auto;
    margin-right: auto;
    padding-right: 6cqw;
    font: 400 3.6cqw/1 var(--font-mono);
    color: color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  .obra {
    position: relative;
    flex: 1;
    overflow: hidden;
    background: #fff;
    --t: 10s;
  }
  .fase {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .pasos-obra {
    position: absolute;
    left: 3cqw;
    right: 3cqw;
    bottom: 3cqw;
    display: flex;
    gap: 1.4cqw;
    z-index: 3;
  }
  .pasos-obra b {
    flex: 1;
    padding: 1.2cqw 0;
    border-radius: 99px;
    text-align: center;
    font: 400 3.2cqw/1 var(--font-mono);
    color: var(--color-cacao);
    background: color-mix(in oklab, var(--color-niebla) 92%, transparent);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--color-cacao) 14%, transparent);
    opacity: 0.45;
    animation: paso-on var(--t) linear infinite both;
    animation-delay: calc(var(--k) * var(--t) / 4 - var(--t)); /* negativo: cada uno arranca ya en su fase */
  }
  /* cada paso, encendido durante su cuarto del bucle */
  @keyframes paso-on {
    0%, 24% { opacity: 1; background: var(--color-cacao); color: var(--color-niebla); }
    26%, 100% { opacity: 0.45; }
  }

  /* 01 · WEB A MEDIDA (Zernio): briefing → boceto → sistema → web */
  .f-brief {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.4cqw;
    padding: 0 9cqw 10cqw;
    background: var(--color-niebla);
    animation: fase-1 var(--t) ease infinite both;
  }
  .etq-f {
    font: 400 3.2cqw/1 var(--font-mono);
    color: color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  .linea-b {
    font-size: 4.6cqw;
    line-height: 1.3;
    animation: linea-b var(--t) ease infinite both;
    animation-delay: calc(var(--k) * 0.35s);
  }
  @keyframes linea-b { 0% { opacity: 0; translate: 0 4px; } 4%, 100% { opacity: 1; translate: 0 0; } }
  @keyframes fase-1 { 0%, 23% { opacity: 1; } 27%, 100% { opacity: 0; } }
  .f-boceto {
    background: #fff;
    animation: fase-2 var(--t) ease infinite both;
  }
  @keyframes fase-2 { 0%, 22% { opacity: 0; } 26%, 76% { opacity: 1; } 82%, 100% { opacity: 0; } }
  .caja {
    position: absolute;
    border-radius: 1cqw;
    border: 1px dashed color-mix(in oklab, var(--color-cacao) 45%, transparent);
    animation: caja var(--t) ease infinite both;
  }
  /* del trazo a trazos (boceto) al color de Zernio (sistema): fondo #F8F4EE, tinta #251A17, acento #FE5A28 de su titular y su botón */
  .caja.tit { --pinta: #251a17; }
  .caja.cta, .caja.aviso { --pinta: #fe5a28; }
  .caja.cta2, .caja.sub, .caja.nav { --pinta: #e8ddd3; }
  .caja.codigo { --pinta: #fbf8f4; }
  @keyframes caja {
    0%, 26% { background: transparent; }
    30%, 48% { background: transparent; border-color: color-mix(in oklab, var(--color-cacao) 45%, transparent); }
    54%, 100% { background: var(--pinta); border-color: transparent; }
  }
  .f-web {
    object-fit: cover;
    object-position: top;
    animation: fase-4 var(--t) ease infinite both;
  }
  @keyframes fase-4 { 0%, 72% { opacity: 0; } 78%, 96% { opacity: 1; } 100% { opacity: 0; } }

  /* 02 · CAMBIOS CON IA (Neety): pide → el agente → vista previa → publicado */
  .f-pide {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.6cqw;
    padding: 0 7cqw 10cqw;
    background: var(--color-niebla);
    animation: fase-ab var(--t) ease infinite both;
  }
  @keyframes fase-ab { 0%, 47% { opacity: 1; } 52%, 100% { opacity: 0; } }
  .quien-pide {
    font: 400 3.2cqw/1 var(--font-mono);
    color: color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  .peticion {
    font-size: 4.6cqw;
    line-height: 1.3;
    text-wrap: pretty;
  }
  .peticion span {
    animation: palabra var(--t) ease infinite both;
    animation-delay: calc(var(--n) * 0.1s);
  }
  @keyframes palabra { 0% { opacity: 0; } 2%, 100% { opacity: 1; } }
  .agente {
    display: grid;
    gap: 1.2cqw;
    margin-top: 1cqw;
  }
  .paso-ag {
    display: flex;
    align-items: center;
    gap: 2cqw;
    font: 400 3.3cqw/1.2 var(--font-mono);
    animation: paso-ag var(--t) ease infinite both;
    animation-delay: calc(2.6s + var(--k) * 0.45s);
  }
  .paso-ag i {
    width: 2.2cqw;
    height: 2.2cqw;
    border-radius: 50%;
    border: 1px solid currentColor;
    background: var(--color-coral);
    border-color: var(--color-coral);
  }
  @keyframes paso-ag { 0% { opacity: 0; translate: -4px 0; } 3%, 100% { opacity: 1; translate: 0 0; } }
  .f-vista {
    animation: fase-cd var(--t) ease infinite both;
  }
  .f-vista img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  @keyframes fase-cd { 0%, 48% { opacity: 0; } 53%, 98% { opacity: 1; } 100% { opacity: 0; } }
  /* la métrica nueva entra en la vista previa con el estilo de Neety (tarjeta blanca, Berenjena) */
  .metrica {
    position: absolute;
    left: 7cqw;
    top: 56%;
    padding: 2cqw 3cqw;
    border-radius: 2cqw;
    background: #fff;
    color: #431b44;
    font-size: 3.8cqw;
    box-shadow: 0 0 0 1px rgb(67 27 68 / 0.12), 0 2cqw 5cqw -2cqw rgb(67 27 68 / 0.35);
    animation: metrica var(--t) var(--ease-out-expo) infinite both;
  }
  .metrica b {
    font-weight: 600;
    color: #fe8238;
  }
  .publicado {
    position: absolute;
    right: 5cqw;
    top: 5cqw;
    padding: 1.6cqw 2.6cqw;
    border-radius: 99px;
    background: var(--color-cacao);
    color: var(--color-niebla);
    font: 400 3.2cqw/1 var(--font-mono);
    animation: publicado var(--t) var(--ease-out-expo) infinite both;
  }
  @keyframes publicado { 0%, 76% { opacity: 0; translate: 0 -6px; } 80%, 100% { opacity: 1; translate: 0 0; } }
  @keyframes metrica { 0%, 56% { opacity: 0; scale: 0.9; } 62%, 100% { opacity: 1; scale: 1; } }

  /* 03 · EQUIPOS CON IA (Neety): cuatro apartados de su manual, uno tras otro */
  .manual .hoja {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    animation: hoja var(--t) ease infinite both;
    animation-delay: calc(var(--k) * var(--t) / 4 - var(--t)); /* negativo: cada uno arranca ya en su fase */
  }
  @keyframes hoja { 0% { opacity: 0; translate: 0 3%; } 3%, 24% { opacity: 1; translate: 0 0; } 28%, 100% { opacity: 0; translate: 0 -2%; } }

  .fuente {
    margin-top: calc(var(--spacing) * 3);
    color: var(--fg2);
    text-wrap: pretty;
  }
  .fuente b {
    font-weight: 400;
    color: var(--fg);
  }

  @media (width >= 64rem) {
    .servicio {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: calc(var(--spacing) * 6);
      align-items: center;
      padding-block: calc(var(--spacing) * 8);
    }
    .letra { grid-column: 1; align-self: start; }
    .nombre { grid-column: 2 / span 4; }
    .demo { grid-column: 6 / span 4; grid-row: 1; width: 100%; }
    .bajada { grid-column: 10 / span 3; grid-row: 1; }
  }
  /* con ratón: la demo está plegada hasta que pasas por su servicio; las demás filas se retiran */
  @media (width >= 64rem) and (hover: hover) and (pointer: fine) {
    .nombre { cursor: pointer; }
    .demo {
      margin-block: calc(var(--spacing) * -6);
      opacity: 0;
      scale: 0.94;
      filter: blur(8px);
      transition: opacity 0.3s ease, scale 0.5s var(--ease-out-expo), filter 0.4s ease;
      pointer-events: none;
