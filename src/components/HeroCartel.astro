---
// EL CARTEL · RONDA 113. Andoni: «el hero, algo que sea como una obra de arte: un póster que pondrías en tu cuarto. Sorpréndeme».
// Tesis: el hero es un CARTEL DE CONCIERTO en la tradición suiza (los «musica viva» de Müller-Brockmann para la Tonhalle de Zúrich: anillos concéntricos
// partidos en arcos sobre fondo liso) y los arcos no son decoración: son la PARTITURA REAL del lo-fi que suena en la web (`jazz.ts › partituraWeb()`),
// una vuelta de ocho compases enrollada alrededor del isotipo. Cada anillo es una parte («cada agente en su parte»): charles, caja, cuatro voces del acorde,
// la melodía en Coral («a una sola voz»), el bajo y el bombo. Una AGUJA de lectura gira a tempo (una vuelta = ocho compases) y cada arco se ENCIENDE justo
// cuando suena su nota: el cartel se toca. La melodía solo se enciende en las vueltas en que de verdad suena.
// · Entrada (tras la cuenta de la carga, `savvia:gota`): como un plano de vídeo, la cámara se aleja del isotipo mientras los anillos se trazan de dentro
//   afuera; el titular sube palabra a palabra y al final la ficha.
// · El titular vive en un claro: los arcos se apagan bajo el bloque de texto (se leen siempre).
// · El ratón da profundidad: cada anillo se desplaza según su radio. En cada «uno» del compás, el isotipo marca el tiempo.
// · Movimiento reducido: el cartel compuesto y quieto (la aguja, parada arriba).
import { hero } from '../data/home';
import { isoV } from '../lib/rich';
import isoRaw from '../../public/savvia-isotipo.svg?raw';
const ISO = isoRaw.match(/ d="([^"]+)"/)![1];
const palabras = hero.h1.split(' ');
---

<section class="cartel" aria-labelledby="h1" data-hero data-cartel>
  <canvas class="lienzo" aria-hidden="true" data-cartel-lienzo></canvas>
  <svg class="fuente" viewBox="0 0 370 439" aria-hidden="true" data-fuente><path d={ISO} /></svg>
  <div class="wrap texto" data-cartel-texto>
    <h1 id="h1" class="titular font-display">{palabras.map((p, i) => <Fragment>{i > 0 && ' '}<span class="pal"><span style={`--i:${i}`}>{p}</span></span></Fragment>)}</h1>
    <p class="sub text-lead text-fg2" set:html={isoV(hero.h2)} />
    <dl class="ficha detail">
      <div><dt>Dirección</dt><dd>Eric y Andoni</dd></div>
      <div><dt>Suena</dt><dd>Lo-fi en do · <span class="tabular-nums">♩ = 74</span></dd></div>
      <div><dt>Compás</dt><dd class="tabular-nums" data-compas>1 de 8</dd></div>
      <div><dt>Donostia</dt><dd class="tabular-nums" data-hora></dd></div>
    </dl>
  </div>
</section>

<script>
  import { partituraWeb, fase } from '../scripts/jazz';
  const sec = document.querySelector<HTMLElement>('[data-cartel]');
  if (sec) {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const cv = sec.querySelector<HTMLCanvasElement>('[data-cartel-lienzo]')!, c = cv.getContext('2d')!;
    const fuente = sec.querySelector<SVGSVGElement>('[data-fuente]')!, texto = sec.querySelector<HTMLElement>('[data-cartel-texto]')!;
    const titular = sec.querySelector<HTMLElement>('.titular')!, compasEl = sec.querySelector<HTMLElement>('[data-compas]')!;
    // ── LAS PARTES: radio (fracción de R), grosor (px a R = 560) y si va en Coral. De dentro afuera, de lo más fino a lo más pesado (como el cartel suizo)
    const PARTES: Record<string, { r: number; w: number; co?: boolean; et?: string }> = {
      caja: { r: 0.19, w: 5, et: 'caja · pruebas' },
      acorde3: { r: 0.26, w: 4 }, acorde2: { r: 0.3, w: 5 }, acorde1: { r: 0.34, w: 6 }, acorde0: { r: 0.38, w: 7, et: 'acordes · diseño' },
      melodia: { r: 0.47, w: 9, co: true, et: 'melodía · voz' },
      bajo: { r: 0.59, w: 17, et: 'bajo · arquitectura' },
      bombo: { r: 0.76, w: 24, et: 'bombo · estrategia' },
    };
    const NOMBRES = Object.keys(PARTES);
    const notas = partituraWeb().map((n) => ({ ...n, p: PARTES[n.voz], ri: NOMBRES.indexOf(n.voz) }));
    const VUELTA = 32, TAU = Math.PI * 2;
    // ── los colores, del propio CSS (oscuro o claro)
    let TINTA = '234,221,231', CORAL = '255,97,107';
    const rgb = (s: string) => (s.match(/\d+(\.\d+)?/g) || []).slice(0, 3).join(',');
    const leerColores = () => { TINTA = rgb(getComputedStyle(sec).color) || TINTA; };
    // ── geometría
    let W = 0, H = 0, dpr = 1, cx = 0, cy = 0, R = 0, s = 1, claro = { x: 0, y: 0, w: 0, h: 0 }, ficha = { x: 0, y: 0, w: 0, h: 0 };
    const medir = () => {
      const r = sec.getBoundingClientRect(); W = r.width; H = r.height; dpr = Math.min(2, devicePixelRatio || 1);
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      const movil = W < 768;
      cx = W * (movil ? 0.56 : 0.69); cy = H * (movil ? 0.33 : 0.46);
      R = movil ? Math.min(W * 0.92, H * 0.46) : Math.min(W * 0.42, H * 0.74); s = R / 560;
      const hv = R * 0.24, wv = (hv * 370) / 439;
      fuente.style.height = hv + 'px'; fuente.style.left = cx - wv / 2 + 'px'; fuente.style.top = cy - hv / 2 + 'px';
      const t = texto.querySelector('.titular')!.getBoundingClientRect(), sb = texto.querySelector('.sub')!.getBoundingClientRect();
      claro = { x: t.left - r.left, y: t.top - r.top, w: Math.max(t.width, sb.width), h: sb.bottom - t.top };
      const f = texto.querySelector('.ficha')!.getBoundingClientRect(); ficha = { x: f.left - r.left, y: f.top - r.top, w: f.width, h: f.height };
      leerColores(); pintar(performance.now());
    };
    // ── la entrada (tras la cuenta) y el ratón
    let t0Entrada = -1, mx = 0, my = 0, ox = 0, oy = 0, marca = 0, px0 = -1, py0 = -1, foco = '', focoA = 0;
    const expo = (u: number) => (u >= 1 ? 1 : 1 - Math.pow(2, -10 * u));
    const ENTRADA = 3.2;
    const pintar = (ahora: number) => {
      c.setTransform(dpr, 0, 0, dpr, 0, 0); c.clearRect(0, 0, W, H);
      const e = t0Entrada < 0 ? 0 : reducido ? 99 : (ahora - t0Entrada) / 1000;
      // la cámara: se aleja del isotipo (de 1,5 a 1) con la curva de un plano de cine
      const cam = 1 + 0.5 * (1 - expo(Math.min(1, e / 2.8)));
      ox += (mx - ox) * 0.05; oy += (my - oy) * 0.05;
      const beat = reducido ? 0 : ((fase(ahora) % VUELTA) + VUELTA) % VUELTA, vuelta = Math.floor(fase(ahora) / VUELTA), suenaMel = vuelta % 2 === 1;
      c.save(); c.translate(cx, cy); c.scale(cam, cam); c.lineCap = 'butt';
      for (const n of notas) {
        const p = n.p, rr = p.r * R, a0 = (n.b / VUELTA) * TAU - Math.PI / 2, a1 = ((n.b + n.len) / VUELTA) * TAU - Math.PI / 2;
        // el trazado de entrada: cada anillo empieza un poco después que el de dentro, y cada arco según su sitio en la vuelta
        const d = 0.25 + n.ri * 0.12 + (n.b / VUELTA) * 0.55, u = expo(Math.max(0, Math.min(1, (e - d) / 0.9)));
        if (u <= 0) continue;
        // encendido: mientras suena, entero; después, se apaga en ~1,3 tiempos
        let luz = 0;
        if (!reducido && (!p.co || suenaMel)) { const rel = (((beat - n.b) % VUELTA) + VUELTA) % VUELTA; luz = rel < n.len ? 1 : Math.exp(-(rel - n.len) / 1.3); }
        const base = p.co ? 0.62 : 0.42 + 0.14 * n.v, enFoco = foco && (n.voz === foco || (foco === 'acorde0' && n.voz.startsWith('acorde'))), a = (base + (1 - base) * luz) * (foco ? (enFoco ? 1 / Math.max(0.5, base) : 1 - 0.55 * focoA) : 1);
        const px = ox * p.r * 18, py = oy * p.r * 18; // profundidad: los anillos de fuera se mueven más
        c.strokeStyle = `rgba(${p.co ? CORAL : TINTA},${a.toFixed(3)})`; c.lineWidth = p.w * s * (1 + 0.18 * luz);
        c.beginPath(); c.arc(px, py, rr, a0, a0 + (a1 - a0) * u); c.stroke();
      }
      // LA AGUJA de lectura: un hilo que gira a tempo (una vuelta = ocho compases)
      if (e > 1.4 && !reducido) {
        const ag = (beat / VUELTA) * TAU - Math.PI / 2, al = Math.min(1, (e - 1.4) / 1.2) * 0.32;
        c.strokeStyle = `rgba(${TINTA},${al})`; c.lineWidth = 1;
        c.beginPath(); c.moveTo(Math.cos(ag) * R * 0.12, Math.sin(ag) * R * 0.12); c.lineTo(Math.cos(ag) * R * 0.9, Math.sin(ag) * R * 0.9); c.stroke();
        c.fillStyle = `rgba(${CORAL},${Math.min(1, al * 3)})`; c.beginPath(); c.arc(Math.cos(ag) * R * 0.47, Math.sin(ag) * R * 0.47, 3.2 * Math.max(0.7, s), 0, TAU); c.fill();
      }
      // «cada agente en su parte»: al pasar el ratón por un anillo, ese anillo se enciende y aparece su nombre junto al cursor (en reposo, el cartel limpio)
      focoA += ((foco ? 1 : 0) - focoA) * 0.12;
      if (foco && focoA > 0.02) {
        const p = PARTES[foco];
        c.save(); c.setTransform(dpr, 0, 0, dpr, 0, 0);
        c.font = `12px ${getComputedStyle(document.documentElement).getPropertyValue('--font-mono') || 'monospace'}`; c.textBaseline = 'middle';
        c.fillStyle = `rgba(${p.co ? CORAL : TINTA},${(0.9 * focoA).toFixed(3)})`; c.fillText(p.et || '', px0 + 16, py0 + 26); c.restore();
      }
      c.restore();
      // EL CLARO del titular: los arcos se apagan bajo el texto (sombra desenfocada de un rectángulo dibujado fuera del lienzo)
      c.save(); c.globalCompositeOperation = 'destination-out'; c.fillStyle = '#000'; c.shadowColor = 'rgba(0,0,0,0.9)'; c.shadowBlur = 48;
      const lejos = 10000; c.shadowOffsetX = lejos * dpr; c.shadowOffsetY = 0;
      c.fillRect(claro.x - 24 - lejos, claro.y - 16, claro.w + 48, claro.h + 32);
      c.shadowColor = 'rgba(0,0,0,0.8)'; c.shadowBlur = 32; c.fillRect(ficha.x - 16 - lejos, ficha.y - 12, ficha.w + 32, ficha.h + 24); c.restore();
      // el isotipo marca el «uno»
      if (!reducido) { const m = Math.exp(-(ahora - marca) / 260); fuente.style.transform = `translate(${ox * 2}px, ${oy * 2}px) scale(${(1 + 0.07 * m).toFixed(4)})`; }
    };
    // ── el bucle: solo con el hero a la vista
    let visto = true, raf = 0;
    const bucle = (ahora: number) => { raf = 0; if (!visto) return; pintar(ahora); if (!reducido || t0Entrada < 0 || (ahora - t0Entrada) / 1000 < ENTRADA + 1) raf = requestAnimationFrame(bucle); };
    const pedir = () => { if (!raf) raf = requestAnimationFrame(bucle); };
    new IntersectionObserver(([x]) => { visto = x.isIntersecting; if (visto) pedir(); }).observe(sec);
    new ResizeObserver(() => medir()).observe(sec);
    if (matchMedia('(pointer: fine)').matches && !reducido) addEventListener('pointermove', (ev) => {
      mx = (ev.clientX / innerWidth - 0.5) * 2; my = (ev.clientY / innerHeight - 0.5) * 2;
      const r = sec.getBoundingClientRect(); px0 = ev.clientX - r.left; py0 = ev.clientY - r.top;
      const d = Math.hypot(px0 - cx, py0 - cy) / R; let mejor = '', dm = 0.03;
      if (t0Entrada >= 0 && (ev.target as Element)?.closest?.('[data-cartel]') && !(ev.target as Element).closest('a, button, h1, p, dl')) for (const k of NOMBRES) { const q = Math.abs(PARTES[k].r - d); if (q < dm) { dm = q; mejor = k.startsWith('acorde') ? 'acorde0' : k; } }
      foco = mejor; pedir();
    }, { passive: true });
    addEventListener('savvia:pulso', (ev) => { const d = (ev as CustomEvent).detail; if (d.k === 0) { marca = performance.now(); compasEl.textContent = `${(d.bar % 8) + 1} de 8`; } });
    // la hora del estudio, al minuto
    const hora = sec.querySelector<HTMLElement>('[data-hora]')!, fmt = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
    const tic = () => { hora.textContent = fmt.format(new Date()); setTimeout(tic, 60000 - (Date.now() % 60000) + 50); }; tic();
    // dónde está el isotipo (la cuenta de la carga vuela hasta aquí)
    (window as any).__cartelFuente = () => fuente.getBoundingClientRect();
    const empezar = () => { if (t0Entrada >= 0) return; t0Entrada = performance.now(); sec.classList.add('encendido'); pedir(); };
    if ((window as any).__gotaSuelta) empezar(); else addEventListener('savvia:gota', empezar, { once: true });
    medir(); pedir();
  }
</script>

<style>
  .cartel {
    position: relative;
    min-height: 100lvh;
    overflow: hidden;
    color: var(--fg);
    display: flex;
    align-items: flex-end;
  }
  .lienzo { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .fuente {
    position: absolute;
    width: auto;
    fill: var(--color-coral);
    opacity: 0;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .cartel.encendido .fuente { opacity: 1; }
  .texto {
    position: relative;
    width: 100%;
    padding-bottom: calc(var(--spacing) * 12);
  }
  .titular {
    font-size: clamp(2.9rem, 1.2rem + 6vw, 6.4rem);
    line-height: 0.96;
    letter-spacing: -0.012em;
    max-width: 11.5ch;
    text-wrap: balance;
  }
  .pal { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.12em; margin-bottom: -0.12em; }
  .pal > span { display: inline-block; transform: translateY(108%); transition: transform 1.1s cubic-bezier(0.16, 1, 0.3, 1); transition-delay: calc(1.1s + var(--i) * 70ms); }
  .encendido .pal > span { transform: none; }
  .sub {
    margin-top: calc(var(--spacing) * 6);
    max-width: 34ch;
    text-wrap: pretty;
    opacity: 0;
    transition: opacity 1.2s ease 1.9s;
  }
  .encendido .sub { opacity: 1; }
  .ficha {
    margin-top: calc(var(--spacing) * 16);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: calc(var(--spacing) * 6);
    opacity: 0;
    transition: opacity 1.2s ease 2.5s;
  }
  .encendido .ficha { opacity: 1; }
  .ficha dt { color: var(--fg2); }
  .ficha dd { margin-top: calc(var(--spacing) * 1); }
  @media (max-width: 767px) {
    .texto { padding-bottom: calc(var(--spacing) * 8); }
    .ficha { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: calc(var(--spacing) * 8); gap: calc(var(--spacing) * 4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pal > span, .sub, .ficha, .fuente { transition: none; }
  }
</style>
