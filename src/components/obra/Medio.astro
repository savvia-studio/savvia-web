---
// RONDA 62 · un medio de un proyecto (portada o galería): vídeo en bucle y sin sonido sobre el color de su web. Se descarga y corre solo a la
// vista (`al="vista"`) o al pasar el cursor (`al="pasar"`, las tarjetas del listado: si no, el póster). Las webs móviles, dentro de un teléfono.
import type { Medio } from '../../data/proyectos';
import sharp from 'sharp';
interface Props {
  medio: Medio;
  color: string;
  alt: string;
  al?: 'vista' | 'pasar';
  proporcion?: string; // p. ej. '16 / 10'
  clase?: string;
  transicion?: string; // ronda 63: nombre de la transición compartida entre páginas (la tarjeta del listado ↔ la portada del caso)
  // ronda 153 · el mosaico de los casos: `proporcion="auto"` llena el hueco que le da la fila; `placa` pone el vídeo ENTERO y centrado sobre ese
  // color (con su proporción real, `natural`); `pos` encuadra el vídeo cuando llena un hueco de otra proporción
  placa?: string;
  natural?: string;
  pos?: string;
  colores?: [string, string, string]; // ronda 227: con placa, el degradado de marca de «Más proyectos» (las dos manchas sobre la placa)
}
const { medio, color, alt, al = 'vista', proporcion = '16 / 10', clase = '', transicion, placa, natural = '16 / 9', pos, colores } = Astro.props;
// RONDA 227 · «que ninguna imagen de los casos salga cortada»: sobre placa, la ventana toma la proporción REAL del archivo (la del póster en los vídeos),
// leída al compilar; antes valía la `prop` del dato (p. ej. «1 / 1» en fotos apaisadas) y la imagen se recortaba a esa forma
const fuente = medio.tipo === 'video' ? medio.poster : medio.src;
const real = placa && fuente ? await sharp(`public${fuente}`).metadata().then((m) => (m.width && m.height ? `${m.width} / ${m.height}` : null), () => null) : null;
const estilo = [`--color:${placa ?? color}`, placa && colores ? `--c2:${colores[1]};--c3:${colores[2]}` : '', `--prop:${proporcion}`, `--r:${real ?? natural}`, pos ? `--pos:${pos}` : '', transicion ? `view-transition-name:${transicion}` : ''].filter(Boolean).join(';');
---

<div class={`medio ${medio.movil ? 'movil' : ''} ${placa ? 'placa' : ''} ${proporcion === 'auto' ? 'lleno' : ''} ${clase}`} style={estilo} data-obra-medio data-al={al}>
  <div class="marco">
    {
      medio.tipo === 'video' ? (
        <video muted loop playsinline preload="none" poster={medio.poster} data-src={medio.src} aria-label={alt} />
      ) : (
        <img src={medio.src} alt={alt} loading="lazy" decoding="async" />
      )
    }
  </div>
</div>

<script>
  import { jugar } from '../../scripts/jugar';
  // un solo observador para todos los medios de la página
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cargar = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) v.src = v.dataset.src; };
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video'); if (!v) return;
    if (e.isIntersecting) { cargar(v); if (!reducido) jugar(v); } else v.pause();
  }), { rootMargin: '200px 0px' });
  document.querySelectorAll<HTMLElement>('[data-obra-medio]').forEach((m) => {
    const v = m.querySelector('video'); if (!v) return;
    if (m.dataset.al === 'vista') { io.observe(m); return; }
    // al pasar: la tarjeta entera (el enlace que la contiene) enciende su vídeo
    const t = m.closest('a') || m;
    t.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType !== 'mouse' || reducido) return; cargar(v); jugar(v); });
    t.addEventListener('pointerleave', () => v.pause());
    t.addEventListener('focusin', () => { if (reducido) return; cargar(v); jugar(v); });
    t.addEventListener('focusout', () => v.pause());
  });
</script>

<style>
  .medio {
    position: relative;
    aspect-ratio: var(--prop);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color);
    isolation: isolate;
  }
  .marco {
    position: absolute;
    inset: 0;
  }
  .marco video,
  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 0);
    display: block;
  }
  /* ronda 153 · el mosaico: llena el hueco de su fila */
  .lleno {
    aspect-ratio: auto;
    height: 100%;
  }
  /* sobre una placa de color: la web entera, a su proporción, centrada (todo dentro de transform: nunca translate y transform juntos) */
  .placa {
    container-type: size;
  }
  /* RONDA 227 · los marcos de Eric («Más proyectos»): sobre la placa, el degradado de marca (las dos manchas, en oklab) y la web dentro de la VENTANA
     DE CRISTAL: marco fino igual por los cuatro lados, sin barra, radios concéntricos (la web, entera: el marco no recorta nada) */
  .placa:not(.movil) {
    background: radial-gradient(70% 60% at 72% 22% in oklab, var(--c2, var(--color)), transparent 72%), radial-gradient(55% 55% at 8% 96% in oklab, var(--c3, var(--color)), transparent 70%), var(--color);
  }
  .placa:not(.movil) .marco {
    --r-fuera: 6px;
    --m: 3px;
    inset: auto;
    left: 50%;
    top: 50%;
    width: min(86cqw, calc(82cqh * var(--r) + 2 * var(--m)));
    aspect-ratio: auto;
    transform: translate(-50%, -50%);
    padding: var(--m);
    border-radius: var(--r-fuera);
    overflow: hidden;
    background: color-mix(in srgb, #fff 20%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 28px 56px -24px rgb(20 12 6 / 0.5);
  }
  .placa:not(.movil) .marco video,
  .placa:not(.movil) .marco img {
    height: auto;
    aspect-ratio: var(--r);
    border-radius: calc(var(--r-fuera) - var(--m));
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  /* las webs móviles: un teléfono centrado sobre el color de su web */
  .movil .marco {
    inset: 8% auto 8% 50%;
    translate: -50% 0;
    aspect-ratio: 390 / 844;
    padding: 0.55%;
    border-radius: 7cqh;
    background: #1a110c;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25), 0 24px 60px -24px rgb(0 0 0 / 0.5);
    container-type: size;
  }
  .movil {
    container-type: size;
  }
  .movil .marco video {
    border-radius: 6cqh;
  }
</style>
