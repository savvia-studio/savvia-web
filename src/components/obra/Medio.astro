---
// RONDA 62 · un medio de un proyecto (portada o galería): vídeo en bucle y sin sonido sobre el color de su web. Se descarga y corre solo a la
// vista (`al="vista"`) o al pasar el cursor (`al="pasar"`, las tarjetas del listado: si no, el póster). Las webs móviles, dentro de un teléfono.
import type { Medio } from '../../data/proyectos';
interface Props {
  medio: Medio;
  color: string;
  alt: string;
  al?: 'vista' | 'pasar';
  proporcion?: string; // p. ej. '16 / 10'
  clase?: string;
  transicion?: string; // ronda 63: nombre de la transición compartida entre páginas (la tarjeta del listado ↔ la portada del caso)
  // ronda 153 · el mosaico de los casos: `proporcion="auto"` llena el hueco que le da la fila; `placa` pone el vídeo ENTERO y centrado sobre ese
  // color (con su proporción real, `natural`); `pos` encuadra el vídeo cuando llena un hueco de otra proporción
  placa?: string;
  natural?: string;
  pos?: string;
}
const { medio, color, alt, al = 'vista', proporcion = '16 / 10', clase = '', transicion, placa, natural = '16 / 9', pos } = Astro.props;
const estilo = [`--color:${placa ?? color}`, `--prop:${proporcion}`, `--r:${natural}`, pos ? `--pos:${pos}` : '', transicion ? `view-transition-name:${transicion}` : ''].filter(Boolean).join(';');
---

<div class={`medio ${medio.movil ? 'movil' : ''} ${placa ? 'placa' : ''} ${proporcion === 'auto' ? 'lleno' : ''} ${clase}`} style={estilo} data-obra-medio data-al={al}>
  <div class="marco">
    {
      medio.tipo === 'video' ? (
        <video muted loop playsinline preload="none" poster={medio.poster} data-src={medio.src} aria-label={alt} />
      ) : (
        <img src={medio.src} alt={alt} loading="lazy" decoding="async" />
      )
    }
  </div>
</div>

<script>
  // un solo observador para todos los medios de la página
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cargar = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) v.src = v.dataset.src; };
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target.querySelector('video'); if (!v) return;
    if (e.isIntersecting) { cargar(v); if (!reducido) v.play().catch(() => {}); } else v.pause();
  }), { rootMargin: '200px 0px' });
  document.querySelectorAll<HTMLElement>('[data-obra-medio]').forEach((m) => {
    const v = m.querySelector('video'); if (!v) return;
    if (m.dataset.al === 'vista') { io.observe(m); return; }
    // al pasar: la tarjeta entera (el enlace que la contiene) enciende su vídeo
    const t = m.closest('a') || m;
    t.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType !== 'mouse' || reducido) return; cargar(v); v.play().catch(() => {}); });
    t.addEventListener('pointerleave', () => v.pause());
    t.addEventListener('focusin', () => { if (reducido) return; cargar(v); v.play().catch(() => {}); });
    t.addEventListener('focusout', () => v.pause());
  });
</script>

<style>
  .medio {
    position: relative;
    aspect-ratio: var(--prop);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color);
    isolation: isolate;
  }
  .marco {
    position: absolute;
    inset: 0;
  }
  .marco video,
  .marco img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 0);
    display: block;
  }
  /* ronda 153 · el mosaico: llena el hueco de su fila */
  .lleno {
    aspect-ratio: auto;
    height: 100%;
  }
  /* sobre una placa de color: la web entera, a su proporción, centrada (todo dentro de transform: nunca translate y transform juntos) */
  .placa {
    container-type: size;
  }
  .placa:not(.movil) .marco {
    inset: auto;
    left: 50%;
    top: 50%;
    width: min(86cqw, calc(82cqh * var(--r)));
    aspect-ratio: var(--r);
    transform: translate(-50%, -50%);
    border-radius: calc(var(--radius-lg) * 0.6);
    overflow: hidden;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.08);
  }
  /* las webs móviles: un teléfono centrado sobre el color de su web */
  .movil .marco {
    inset: 8% auto 8% 50%;
    translate: -50% 0;
    aspect-ratio: 390 / 844;
    padding: 0.55%;
    border-radius: 7cqh;
    background: #1a110c;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25), 0 24px 60px -24px rgb(0 0 0 / 0.5);
    container-type: size;
  }
  .movil {
    container-type: size;
  }
  .movil .marco video {
    border-radius: 6cqh;
  }
</style>
