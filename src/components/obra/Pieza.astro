---
// RONDA 63 · «los proyectos destacados, representarlos como en la sección "Más proyectos"»: la PIEZA de Anteriores.astro, reutilizable. Tipos:
//   · mancha: degradado de aerógrafo con los tres colores de la web del cliente y un navegador LADEADO que se sale por abajo y por un lado
//   · claro: degradado pálido y el navegador RECTO, cortado por abajo; el nombre en Cacao
//   · escena: la mesa de Andoni en una estación, con la web DENTRO del monitor (pantalla medida en la lámina)
//   · telefono: degradado y la web móvil en un teléfono de pie
// El nombre, grande, arriba a la izquierda; el vídeo real de la web corre al pasar (o a la vista en táctil). Enlaza al caso.
import type { Proyecto } from '../../data/proyectos';
import { langDe, ruta } from '../../lib/i18n';
import { servicio } from '../../data/idioma';
interface Props {
  p: Proyecto;
  tipo: 'mancha' | 'claro' | 'escena' | 'telefono';
  est?: string; // estación de la mesa (escena)
  zoom?: number; // escena: cuántas veces se amplía la lámina
  cy?: number; // escena: a qué altura de la pieza cae el centro de la pantalla
  giro?: number;
  transicion?: boolean; // lleva el nombre de la transición compartida con la portada del caso
  sube?: boolean; // ronda 130: solo la rejilla de «Todos los proyectos»: navegador recto, cortado por abajo, que sube al entrar
  href?: string; // ronda 191: el slider de /proyectos enlaza también webs sin caso (se abren en su web)
  fondo?: string; // ronda 206: fondo generado (artefacto «Fondos de proyectos») en lugar del degradado de marca
  grande?: boolean; // ronda 154: la CARÁTULA del caso de estudio: la misma pieza a todo el ancho y alta, sin nombre ni pie, con el vídeo a la vista
}
const { p, tipo, est = 'otono', zoom = 3, cy = 0.58, giro = -6, transicion = false, sube = false, grande = false, href, fondo } = Astro.props;
const lang = langDe(Astro.currentLocale);
const destino = ruta(lang, href ?? `/proyectos/${p.slug}`), fuera = /^https?:/.test(destino);
const [c1, c2, c3] = p.colores;
const PANT = { x: 0.3903, y: 0.3696, w: 0.2178, h: 0.2104 }; // la pantalla del monitor en la lámina (ronda 26)
const left = 50 - (PANT.x + PANT.w / 2) * zoom * 100, py = PANT.y + PANT.h / 2;
const video = grande ? (p.cubierta ?? p.portada) : sube && tipo !== 'telefono' && p.portada.movil && p.escritorio ? p.escritorio : p.portada; // ronda 131: la rejilla, siempre en escritorio · ronda 154: la carátula, con su toma grande (1920 px)
// RONDA 154 · Andoni: «la primera carátula de los case studies, con el gradiente y saliendo desde abajo el proyecto, como en todos los proyectos, pero
// más grande». `grande`: la pieza no es un enlace (ya estás en el caso), ocupa las 12 columnas y ~78 lvh, el navegador (o el teléfono) va RECTO y
// centrado, cortado por el borde de abajo, y SUBE un poco al llegar; el vídeo corre a la vista (póster primero)
const Tag = grande ? 'div' : 'a';
// ronda 129: sobre un fondo de marca claro (p. ej. el amarillo de Remerge en el teléfono), el nombre va en Cacao
const claroFondo = (() => { const n = parseInt(c1.slice(1), 16); return ((n >> 16) * 299 + ((n >> 8) & 255) * 587 + (n & 255) * 114) / 1000 > 150; })();
---

<Tag href={grande ? undefined : destino} target={!grande && fuera ? '_blank' : undefined} rel={!grande && fuera ? 'noopener' : undefined} class={`pieza ${tipo}${tipo !== 'escena' && claroFondo ? ' fondo-claro' : ''}${sube ? ' pz-sube' : ''}${grande ? ' pz-grande' : ''}`} style={`--c1:${c1};--c2:${c2};--c3:${c3};--giro:${giro}deg`} data-pieza-obra data-a-la-vista={grande ? '' : undefined}>
  <div class={`lamina ${tipo === 'escena' ? '' : 'g-marca'}${fondo ? ' con-fondo' : ''}`} style={[transicion ? `view-transition-name: obra-${p.slug}` : '', fondo ? `--fondo:url('${fondo}')` : ''].filter(Boolean).join(';') || undefined}>
    {
      tipo === 'escena' ? (
        <div class="mesa" style={`--z:${zoom};--left:${left.toFixed(2)};--cy:${cy};--py:${py}`}>
          <img class="foto" src={`/media/estudio/${est}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />
          <span class="pantalla"><video class="vid" muted loop playsinline preload="none" poster={video.poster} data-src={video.src} aria-label={lang === 'en' ? `${p.nombre}'s website` : `La web de ${p.nombre}`} /></span>
        </div>
      ) : tipo === 'telefono' ? (
        <div class="telefono-m"><video class="vid" muted loop playsinline preload="none" poster={video.poster} data-src={video.src} aria-label={lang === 'en' ? `${p.nombre}'s website` : `La web de ${p.nombre}`} /></div>
      ) : (
        <div class="mockup">
          <video class="vid" muted loop playsinline preload="none" poster={video.poster} data-src={video.src} aria-label={lang === 'en' ? `${p.nombre}'s website` : `La web de ${p.nombre}`} />
        </div>
      )
    }
    {!grande && <h3 class="nombre font-display">{p.nombre}</h3>}
    {!grande && <span class="vid-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.8" y="6.6" width="12.6" height="10.8" rx="2.4" /><path d="M15.4 10.4l5.2-3v9.2l-5.2-3z" /></svg></span>}
  </div>
  {!grande && <p class="pie detail text-fg2">{p.sector && <span class="text-fg">{p.sector}</span>}{p.sector && p.servicios.length > 0 && ' · '}{p.servicios.slice(0, 3).map((s) => servicio(lang, s)).join(', ')}</p>}
</Tag>

<script>
  // el vídeo: al pasar el cursor (o al enfocar); en táctil, mientras la pieza está a la vista
  const tactil = matchMedia('(hover: none)').matches, reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const tocar = (v: HTMLVideoElement, si: boolean) => { if (si) { if (!v.src && v.dataset.src) v.src = v.dataset.src; if (!reducido) v.play().catch(() => {}); } else v.pause(); };
  const io = new IntersectionObserver((es) => es.forEach((e) => tocar(e.target.querySelector('video')!, e.isIntersecting)), { threshold: 0.5 });
  // ronda 126: la web sube desde abajo al entrar la pieza en pantalla (y se queda)
  const ve = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('vista'); ve.unobserve(e.target); } }), { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
  document.querySelectorAll<HTMLElement>('[data-pieza-obra]:is(.pz-sube, .pz-grande)').forEach((pz) => ve.observe(pz));
  document.querySelectorAll<HTMLElement>('[data-pieza-obra]').forEach((pz) => {
    const v = pz.querySelector('video')!;
    v.addEventListener('playing', () => pz.classList.add('suena'));
    v.addEventListener('pause', () => pz.classList.remove('suena'));
    if (tactil || pz.hasAttribute('data-a-la-vista')) { io.observe(pz); return; }
    pz.addEventListener('pointerenter', () => tocar(v, true));
    pz.addEventListener('pointerleave', () => tocar(v, false));
    pz.addEventListener('focus', () => tocar(v, true));
    pz.addEventListener('blur', () => tocar(v, false));
  });
</script>

<style>
  .pieza {
    display: block;
    min-width: 0;
    color: inherit;
  }
  .lamina {
    position: relative;
    aspect-ratio: var(--ratio, 4 / 5);
    overflow: hidden;
    border-radius: var(--radius-lg);
    isolation: isolate;
    container-type: size;
  }
  /* los fondos de degradado: manchas muy desenfocadas (aerógrafo) con los colores de la web del cliente (RONDA 152: sin el grano: fuera grano.png en toda la web) */
  .g-marca::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -2;
    /* RONDA 154 · «el gradiente de Neety se ve sucio»: las manchas se mezclan en OKLAB (en sRGB, dos colores claros se cruzan por un gris turbio)
       RONDA 227 · como en «Más proyectos» (Eric, ronda 206: el artefacto «Fondos de proyectos»): las dos manchas sobre la propia pieza, sin desenfoque */
    background: radial-gradient(70% 60% at 72% 22% in oklab, var(--c2), transparent 72%), radial-gradient(55% 55% at 8% 96% in oklab, var(--c3), transparent 70%), var(--c1);
    transition: transform 1.6s var(--ease-out-expo);
  }
  .nombre {
    position: absolute;
    z-index: 2;
    left: calc(var(--spacing) * 4);
    top: calc(var(--spacing) * 3);
    right: calc(var(--spacing) * 4);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    /* RONDA 156 · Eric: «la tipo debería ser blanca»: el nombre va sobre el fondo de la PIEZA (la marca del cliente), no sobre la página: blanco
       siempre, Cacao solo si la marca es clara (antes leía --tinta, oscura en invierno: oscuro sobre oscuro) */
    color: var(--nombre-tinta, #f5f5f7);
    text-wrap: balance;
  }
  /* RONDA 130 · «que el titular de cada proyecto no quede tan alto»: en la rejilla, el nombre baja un paso (h3 → lead), se separa del borde de arriba
     (32 px) y se alinea con el canto izquierdo del navegador (7 %) */
  .pieza.pz-sube .nombre {
    left: 7%;
    right: 7%;
    top: calc(var(--spacing) * 8);
    font-size: var(--text-lead);
    line-height: 1.3;
    letter-spacing: 0;
  }
  .claro,
  .fondo-claro {
    --nombre-tinta: var(--color-cacao);
  }
  .pieza.fondo-claro .nombre {
    text-shadow: none;
  }
  .escena .nombre,
  .mancha .nombre,
  .telefono .nombre {
    text-shadow: 0 1px 18px color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  .pie {
    margin-top: calc(var(--spacing) * 4);
  }
  /* el icono de vídeo, abajo a la derecha; se retira mientras suena */
  .vid-ic {
    position: absolute;
    z-index: 3;
    right: calc(var(--spacing) * 3);
    bottom: calc(var(--spacing) * 3);
    display: inline-flex;
    padding: calc(var(--spacing) * 2);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, #1a1210 55%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-niebla);
    transition: opacity 0.4s ease, scale 0.5s var(--ease-out-expo), filter 0.4s ease;
  }
  .vid-ic svg {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linejoin: round;
  }
  .pieza.suena .vid-ic {
    opacity: 0;
    filter: blur(4px);
  }
  /* el navegador · RONDA 227 · Andoni: «en portfolio y case studies faltan los nuevos marcos propuestos por Eric»: la VENTANA DE CRISTAL de «Más proyectos»
     (Anteriores.astro, rondas 189 y 195 de Eric): un marco fino de cristal (velo claro + desenfoque del fondo + filo de luz) igual por los cuatro lados,
     sin barra ni puntitos, radios concéntricos; la web dentro con sus esquinas */
  .mockup {
    --r-fuera: 6px;
    --marco: 3px;
    position: absolute;
    padding: var(--marco);
    border-radius: var(--r-fuera);
    overflow: hidden;
    background: color-mix(in srgb, #fff 20%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 32px 60px -22px rgb(20 12 6 / 0.55);
  }
  /* RONDA 68 · «revisar que las miniaturas estén bien encajadas y la web no se vea cortada»: el navegador, ENTERO dentro de su pieza, bajo el nombre
     (lo más ancho que quepa en el 62 % de abajo), con la web a su proporción real (16:9, la de las grabaciones: ya no se recorta por los lados); la
     mancha, apenas ladeada; el claro, recto */
  /* RONDA 126 · Andoni: «en todos los proyectos quiero que las webs se vean más grandes y salgan como desde abajo»: el navegador, mucho más ancho (88 %),
     arranca bajo el nombre y se sale por el borde de abajo de la pieza (la pieza lo recorta); al entrar en pantalla SUBE desde abajo (`.vista`) */
  /* RONDA 129 · Andoni: «la card más pequeña y que los proyectos salgan de abajo» (captura: el navegador RECTO, bajo el nombre, cortado por el borde de
     abajo). El navegador mide el 86 % del ancho, va centrado y su alto (web 16:9 + barra) se conoce en cqw: `--top` lo coloca bajo el nombre o, si la
     pieza es alta, lo baja hasta que al menos un 18 % quede fuera; nunca se le ven las esquinas de abajo. En reposo, ese es su sitio (sin JS, también);
     con JS (`html.pz-js`), espera bajo el borde y SUBE al entrar en pantalla (`.vista`). Solo `transform` (nunca `translate:` junto a `transform:`). */
  /* RONDA 130 · Andoni: «lo de que saliera de abajo solo era aplicarlo a la parte de todos los proyectos». Por defecto (los destacados) vuelve el
     navegador de la ronda 68: ENTERO dentro de la pieza, bajo el nombre; la mancha, apenas ladeada; el claro, recto. Solo `transform`. */
  .mancha .mockup,
  .claro .mockup {
    left: 0;
    right: 0;
    margin-inline: auto;
    bottom: 9%;
    width: min(84%, calc((62cqh - 6px) * 16 / 9));
    transition: transform 0.9s var(--ease-out-expo);
  }
  .mancha .mockup {
    transform: rotate(calc(var(--giro) * 0.4));
  }
  /* LA REJILLA (`.pz-sube`, ronda 129 → 130): el navegador RECTO al 86 %, alineado con el nombre, cortado por el borde de abajo (nunca se le ven las
     esquinas de abajo: al menos un 18 % fuera); con JS (`html.pz-js`) espera bajo el borde y SUBE al entrar en pantalla (`.vista`). */
  .pieza.pz-sube .mockup {
    --top: max(calc(var(--spacing) * 8 + var(--text-lead) * 1.3 + var(--spacing) * 4), calc(100cqh - 0.82 * (48.375cqw + 6px)));
    left: 7%;
    right: auto;
    margin-inline: 0;
    bottom: auto;
    top: var(--top);
    width: 86%;
    transform: translateY(0);
    transition: transform 1.1s var(--ease-out-expo);
    transition-delay: calc(var(--fila-i, 0) * 90ms);
  }
  :global(html.pz-js) .pieza.pz-sube:not(.vista) .mockup {
    transform: translateY(calc(100cqh - var(--top) + 8px));
  }
  /* sobre un degradado claro, el cristal se oscurece un poco para que la ventana se lea (como en «Más proyectos») */
  .claro .mockup,
  .fondo-claro .mockup {
    background: color-mix(in srgb, #302018 7%, transparent);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.5),
      0 0 0 1px rgb(48 32 24 / 0.1),
      0 24px 48px -20px rgb(48 32 24 / 0.35);
  }
  .mockup .vid {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: 50% 0;
    border-radius: calc(var(--r-fuera) - var(--marco));
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  /* la mesa, con la web dentro del monitor */
  .mesa {
    position: absolute;
    width: calc(var(--z) * 100cqw);
    aspect-ratio: 16 / 9;
    left: calc(var(--left) * 1cqw);
    top: calc(var(--cy) * 100cqh - var(--py) * var(--z) * 56.25cqw);
    transition: scale 1.6s var(--ease-out-expo);
    transform-origin: 50% var(--py);
  }
  .mesa .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mesa .pantalla {
    position: absolute;
    z-index: 2;
    left: 39.03%;
    top: 36.96%;
    width: 21.78%;
    height: 21.04%;
    overflow: hidden;
    background: #fbfbfa;
  }
  .mesa .vid {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  .escena .lamina::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to bottom, color-mix(in oklab, var(--color-cacao) 55%, transparent), transparent 34%);
  }
  /* el teléfono de pie (ronda 68: por el alto, así entra entero en cualquier proporción de pieza) */
  .telefono-m {
    position: absolute;
    left: 0;
    right: 0;
    margin-inline: auto;
    bottom: 7%;
    height: 68%;
    aspect-ratio: 390 / 844;
    padding: 1.2%;
    border-radius: 4.2cqh;
    background: #1a110c;
    box-shadow: 0 30px 60px -20px rgb(30 16 8 / 0.6);
    transition: transform 0.9s var(--ease-out-expo);
  }
  /* en la rejilla: la misma lógica que el navegador, sube desde abajo y el borde lo corta */
  .pieza.pz-sube .telefono-m {
    --top: max(calc(var(--spacing) * 8 + var(--text-lead) * 1.3 + var(--spacing) * 4), 24cqh);
    top: var(--top);
    bottom: auto;
    height: 96cqh;
    transform: translateY(0);
    transition: transform 1.1s var(--ease-out-expo);
    transition-delay: calc(var(--fila-i, 0) * 90ms);
  }
  :global(html.pz-js) .pieza.pz-sube:not(.vista) .telefono-m {
    transform: translateY(calc(100cqh - var(--top) + 8px));
  }
  .telefono-m .vid {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 3.6cqh;
  }
  /* al pasar: el navegador se endereza y sube un poco */
  .pieza:not(.pz-sube):is(.mancha, .claro):is(:hover, :focus-visible) .mockup {
    transform: translateY(-4%);
  }
  .pieza:not(.pz-sube).telefono:is(:hover, :focus-visible) .telefono-m {
    transform: translateY(-5%);
  }
  .pieza.pz-sube.vista:is(.mancha, .claro):is(:hover, :focus-visible) .mockup,
  .pieza.pz-sube.vista.telefono:is(:hover, :focus-visible) .telefono-m {
    transform: translateY(calc(var(--spacing) * -2));
    transition-delay: 0s;
  }
  .escena:hover .mesa,
  .escena:focus-visible .mesa {
    scale: 1.06;
  }
  /* RONDA 206 · el fondo generado del artefacto «Fondos de proyectos» (con su grano), en lugar de las manchas */
  .lamina.con-fondo::before { background: var(--fondo) center / cover no-repeat; }
  .pieza:not(.pz-grande):hover .g-marca::before {
    transform: scale(1.04); /* ronda 227: como en «Más proyectos» (el fondo ya no sobra por los lados para girar) */
  }
  /* RONDA 154 · LA CARÁTULA del caso (`grande`): la lámina a lo ancho y alta; el navegador recto, centrado y grande, con un 18 % por debajo del borde
     (nunca se le ven las esquinas de abajo); en móvil, una lámina 4:5 con el navegador casi a lo ancho. Con JS, espera un poco más abajo y SUBE al
     llegar (`.vista`). Solo `transform`. */
  /* ronda 190 (Andoni: «a la primera vista del proyecto le sobra mucho espacio por arriba»): la lámina con la proporción justa para que el navegador
     (80 % del ancho, 7 % desde arriba) quede cortado por abajo, sin el hueco de antes (medía 78 lvh y el navegador se bajaba hasta su borde) */
  /* RONDA 227 · Andoni: «la portada de arriba, darle un poco más de aire»: la lámina algo más alta (12:5 → 11:5) y el navegador baja del 7 % al 12 % */
  .pz-grande .lamina {
    aspect-ratio: 11 / 5;
    height: auto;
  }
  .pz-grande.telefono .lamina { aspect-ratio: 2 / 1; }
  .pz-grande .mockup {
    --ancho: min(80cqw, 74rem);
    left: 0;
    right: 0;
    margin-inline: auto;
    bottom: auto;
    width: var(--ancho);
    top: 12cqh; /* ronda 227 (ronda 190: 7 %) */
    transform: translateY(0);
    transition: transform 1.6s var(--ease-out-expo);
    --r-fuera: 10px; /* la ventana grande, con el marco proporcionado */
    --marco: 5px;
  }
  /* la carátula enseña la toma entera (las de Eric, `-grande`, son 16:10): sin recorte de proporción */
  .pz-grande .mockup .vid { aspect-ratio: auto; height: auto; }
  .pz-grande .telefono-m {
    top: 8cqh;
    bottom: auto;
    height: 112cqh;
    padding: 0.9%;
    border-radius: 6.2cqh;
    transform: translateY(0);
    transition: transform 1.6s var(--ease-out-expo);
  }
  .pz-grande .telefono-m .vid { border-radius: 5.4cqh; }
  :global(html.pz-js) .pz-grande:not(.vista) :is(.mockup, .telefono-m) {
    transform: translateY(12cqh);
  }
  @media (width < 48rem) {
    .pz-grande .lamina { height: auto; aspect-ratio: 2 / 1; }
    .pz-grande .mockup { --ancho: 92cqw; --r-fuera: 7px; --marco: 3px; top: 10cqh; }
    .pz-grande.telefono .lamina { aspect-ratio: 4 / 5; }
    .pz-grande .telefono-m { top: 10cqh; height: 104cqh; }
  }
  .pieza:focus-visible {
    outline: 2px solid var(--fg);
    outline-offset: calc(var(--spacing) * 1);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.pz-js) .pieza.pz-sube:not(.vista) .mockup,
    :global(html.pz-js) .pieza.pz-sube:not(.vista) .telefono-m,
    :global(html.pz-js) .pz-grande:not(.vista) :is(.mockup, .telefono-m) { transform: none; }
    .mockup,
    .mesa,
    .telefono-m,
    .g-marca::before {
      transition: none;
    }
  }
</style>
