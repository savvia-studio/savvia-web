---
import { hero } from '../data/home';
import { rich } from '../lib/rich';
---

<!--
  HERO (ronda 13). Andoni pasa una ACUARELA de roble (copa en otoño que se deshace en estelas horizontales, línea de suelo y raíces):
  «te paso una imagen y ya veremos cómo la animamos, quiero probar».
  · `tools/recorte-hero.py`: se recorta del fondo hueso (el color de la zona translúcida sale de la tinta vecina: sin halo sobre Cacao)
    y se parte por la línea de suelo → `hero-arbol.webp` (aquí) y `hero-raices.webp` (Raices.astro). Centradas en el tronco.
  · ANIMACIÓN (`src/scripts/estela.ts`, ronda 14): una gota de savia cae a la base del tronco, corre por el suelo y el árbol BROTA de ahí;
    en reposo, tramado en color y canto (se funde con el grano del fondo) y una deriva de color muy lenta. Más pequeño que en la 13.
  · El roble de PALABRAS de la ronda 12 (`src/scripts/palabras.ts`) sigue en el código, sin uso: se vuelve a él cambiando el import.
  · Regla dura 3: el lienzo nace invisible. Sin WebGL queda la lámina como imagen. Con movimiento reducido, ya compuesto y quieto.
-->
<section class="hero relative flex flex-col items-center overflow-hidden" aria-labelledby="h1" data-hero data-sin-fila>
  <!-- PRUEBA hero-claro: con ?hero=blanco|claro el hero pasa a superficie clara antes del primer pintado (texto Cacao; la barra lo detecta sola) -->
  <script is:inline>if (document.documentElement.classList.contains('hero-claro')) document.currentScript.parentElement.classList.add('surface-light');</script>
  <!-- RONDA 27 · «ese rayo de luz que entre desde arriba afectando a todo el hero, como si entrase por una ventana desde la naturaleza, con sombras
       muy sutiles, y que se mueva siguiendo al ratón»: dos haces oblicuos de Rosa niebla, más fuertes arriba, que se desplazan con el puntero;
       el titular proyecta una sombra que se mueve al contrario, y los haces del árbol (en el shader) siguen la misma luz -->
  <div class="luz" aria-hidden="true" data-luz><i class="haz a"></i></div>
  <div class="wrap titular flex flex-col items-center text-center">
    <h1 id="h1" class="text-h1 max-w-[20ch]" set:html={rich(hero.h1)} />
    <p class="text-lead text-fg2 mt-4 lg:mt-6">{hero.h2}</p>
  </div>
  <div class="pie-arbol">
    <!-- EL MARCO (rondas 15–17, captura de sythera): el recuadro de detrás del árbol, entre los dos carriles. RONDA 17: «lo hacemos más alto,
         que llegue hasta estar a 40 px del subtítulo» → ocupa toda la caja del pie (que empieza a 40 px del subtítulo) hasta el pie del hero.
         Puntos Rosa niebla al 10 % → 0 %. Arriba, su fila de carriles con cruces ([data-carril-fila]). -->
    <!-- RONDA 147–148 · el hero: sin cruces; vuelve solo la línea horizontal (la del marco y la de las raíces, data-carril-fila="sin-cruces") -->
    <div class="marco" aria-hidden="true" data-carril-fila="sin-cruces" data-carril-desfase="-40"></div>
    <!-- RONDA 25 · en las esquinas de abajo DEL RECUADRO (en su misma caja, pero fuera de su máscara, que se desvanece a 0 abajo y los borraba):
         «desde 2020» y la estación (la de HOY al cargar; el clic en el árbol la cambia) -->
    <!-- RONDA 65 · «sustituimos desde 2020 por la hora y la estación por desde 2020»: la hora de Donostia (el estudio), en vivo -->
    <p class="esquina desde detail tabular-nums" data-hora></p>
    <p class="esquina estacion detail">desde 2020</p>
    <!-- RONDA 21 · «cuando clicas para cambiar de color que no haga la animación de redibujado; el redibujado solo con la carga»: el clic cambia
         de ESTACIÓN (otoño → invierno → primavera → verano) con un viraje suave del color; nada se redibuja. El hover ya no hace nada. -->
    <div class="arbol-caja" aria-hidden="true" data-arbol>
      <!-- el HALO (clusia): el propio árbol muy desenfocado detrás; su color sangra en el fondo cuando ya está pintado -->
      <i class="halo" aria-hidden="true"></i>
      <!-- RONDA 66 · el roble de CADA ESTACIÓN (láminas de Andoni, tools/r66-robles.py → /media/hero/arbol-<estación>.webp): se elige al parsear -->
      <img alt="" width="1260" height="583" decoding="async" fetchpriority="high" data-lamina />
      <script is:inline>document.currentScript.previousElementSibling.src = '/media/hero/arbol-' + (document.documentElement.dataset.estacion || 'otono') + '.webp';</script>
      <canvas class="lienzo" data-lienzo></canvas>
    </div>
    <!-- RONDA 20 · «al clicar el árbol me gusta que cambie de color, que cambien como de estaciones»: el nombre de la estación, en mono, al pasar -->
  </div>
</section>

<script>
  import { crearEstela } from '../scripts/estela';
  import { EST, NOCHE, estacionActual, fijarEstacion } from '../scripts/estacion';
  import { rgbDe } from '../scripts/tinta';
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const img = hero.querySelector<HTMLImageElement>('[data-lamina]')!;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // RONDA 15: la gota la trae la carga (Cargador.astro): resbala por las letras de «savvia», cae aquí y avisa con `savvia:gota`.
    // Al tocar el suelo: la savia corre por la línea, el árbol se DIBUJA y se PINTA con canto rasgado; luego sangra el halo.
    // RONDA 66 · cada estación tiene su lámina: el motor ya no tiñe la hoja (intensidad 0), el color viene pintado
    let cv = hero.querySelector<HTMLCanvasElement>('[data-lienzo]')!;
    // PRUEBA hero-claro: el fondo hacia el que se hunde el árbol es el del hero (blanco o Rosa niebla), no la noche de la estación
    const html = document.documentElement.classList;
    const fondoClaro: [number, number, number] | null = html.contains('hero-blanco') ? [255, 255, 255] : html.contains('hero-claro') ? rgbDe('niebla') : null;
    const fondoDe = (n: number) => fondoClaro ?? NOCHE[n];
    // RONDA 67 · «en primavera me gustaba el tono rosáceo, estilo cerezo»: en primavera el motor vuelve a teñir la hoja (su color de la tabla, rosa)
    const tinte = (n: number) => (n === 2 ? 0.9 : 0);
    // RONDA 144 · Eric: «en invierno quitaría la rendija y ese gradiente que hace efecto de ruido, que sea todo más blanquecino»: en invierno el árbol
    // no hierve ni lanza destellos horizontales (soplo apagado); en las demás estaciones sí («parece más vivo»)
    let t = crearEstela(cv, img, { origen: [0.5, 1], dir: -1, soplo: estacionActual() !== 1, gota: true, manual: true, hd: true, sinLuz: !!fondoClaro, intensidad: tinte(estacionActual()) });
    if (t && (estacionActual() === 2 || estacionActual() === 1)) t.estacion(estacionActual()); // ronda 76: el invierno, sin hojas (raleo) y nevado
    const w = window as any;
    // RONDA 30: al caer la gota, primero ENTRA EL HAZ desde arriba (luz-entra); la luz sobre el árbol la pone el shader al terminar de pintarse
    const brota = () => { t?.soltar(); hero.classList.add('luz-entra'); setTimeout(() => hero.classList.add('crecido'), reducido ? 0 : 4200); };
    // RONDA 83 · Eric: «la parrilla detrás del árbol tiene que sincronizarse antes de la entrada del árbol»: sin animación de carga (html.sin-carga, puesto
    // en el <head>) todo arrancaba a la vez y el árbol iba por la mitad con las líneas aún trazándose. Ahora la PARRILLA entra primero (puntos del marco,
    // línea y cruces, a una) y el árbol espera a que esté puesta. Con carga no se espera: el árbol nace en el impacto de la gota.
    const ESPERA = document.documentElement.classList.contains('sin-carga') && !reducido ? 900 : 0;
    const suelta = () => { if (ESPERA) setTimeout(brota, ESPERA); else brota(); };
    if (w.__gotaSuelta) suelta(); else addEventListener('savvia:gota', suelta, { once: true });
    if (!t) hero.classList.add('sin-gl');
    // HUEVO DE PASCUA (ronda 21): clic = la estación siguiente (solo vira el color).
    // RONDA 39: la estación es de TODA la web (fondo oscuro, árbol y raíces: src/scripts/estacion.ts). El clic la cambia para todos; si la cambia
    // otro (los botones de estación de Proyectos), el árbol la sigue (pintándose si se ve; de golpe si no).
    const caja = hero.querySelector<HTMLElement>('[data-arbol]')!;
    let est = estacionActual(), heroVisible = true;
    const rotular = () => { hero.dataset.estacion = EST[est]; };
    // la hora del estudio (Donostia), al minuto
    const hora = hero.querySelector<HTMLElement>('[data-hora]')!;
    const fmt = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
    // ronda 66: «solo la hora, sin Donostia»
    const tic = () => { hora.textContent = fmt.format(new Date()); setTimeout(tic, 60000 - (Date.now() % 60000) + 50); };
    tic();
    rotular();
    if (t) t.fondo(...fondoDe(est));
    // CAMBIO DE ESTACIÓN (ronda 66): la lámina nueva se DIBUJA y se PINTA encima de la vieja (líneas y pintura rasgada desde la base, 2,4 s, el gesto de
    // la carga) y al acabar la vieja suelta su contexto WebGL. Sin ver el hero o antes de crecer, de golpe.
    let luzV = 0, pedida = -1;
    const revelar = (el: HTMLElement, ox: number, oy: number, dur: number, fin: () => void, viejo?: HTMLElement) => {
      let a = 0;
      const pon = (m: string) => { el.style.setProperty('-webkit-mask', m); el.style.setProperty('mask', m); };
      const paso = (ahora: number) => {
        if (!a) a = ahora;
        const k = Math.min(1, (ahora - a) / dur), e = k * k * (3 - 2 * k), w = el.offsetWidth, h = el.offsetHeight, S = Math.max(8, Math.hypot(w, h) * 2.4 * e);
        pon(`url('/media/rasgo-circulo.png') ${(ox * w - S / 2).toFixed(1)}px ${(oy * h - S / 2).toFixed(1)}px / ${S.toFixed(1)}px ${S.toFixed(1)}px no-repeat`);
        // el viejo se apaga detrás del frente (si no, se transparentaba y desaparecía de golpe al final: el «salto»)
        if (viejo) viejo.style.opacity = String(1 - Math.min(1, Math.max(0, (k - 0.15) / 0.75)));
        if (k < 1) requestAnimationFrame(paso); else { pon(''); fin(); }
      };
      pon(`url('/media/rasgo-circulo.png') 0 0 / 0 0 no-repeat`);
      requestAnimationFrame(paso);
    };
    const soltarLienzo = (c: HTMLCanvasElement) => { { const g = (c.getContext('webgl') || c.getContext('webgl2')); if (g && !g.isContextLost()) g.getExtension('WEBGL_lose_context')?.loseContext(); } c.remove(); };
    const cambiarLamina = (n: number) => {
      pedida = n;
      const nueva = new Image(); nueva.decoding = 'async'; nueva.src = `/media/hero/arbol-${EST[n]}.webp`;
      nueva.onload = () => {
        if (pedida !== n || !t) return;
        // clonado del lienzo actual: así lleva el atributo de ámbito de Astro (con createElement los estilos del componente no le llegan)
        const cv2 = cv.cloneNode(false) as HTMLCanvasElement; cv2.classList.remove('listo'); cv.after(cv2);
        const t2 = crearEstela(cv2, nueva, { origen: [0.5, 1], dir: -1, soplo: n !== 1, hd: true, sinLuz: !!fondoClaro, intensidad: tinte(n) });
        if (!t2) { cv2.remove(); return; }
        if (n === 2 || n === 1) t2.estacion(n);
        const viejo = cv; cv = cv2; t = t2; img.src = nueva.src;
        t2.fondo(...fondoDe(n)); t2.luz(luzV); t2.visible(heroVisible); t2.crecer(1);
        if (!heroVisible || reducido || !hero.classList.contains('crecido')) return soltarLienzo(viejo);
        // RONDA 67 · «en algunas estaciones tiene un salto raro»: el lienzo nuevo ya viene PINTADO y se descubre con el canto de papel rasgado que crece
        // desde la base del tronco (2,4 s), sin el destello de líneas del dibujo; al acabar, el viejo se retira
        revelar(cv2, 0.5, 1, 2600, () => soltarLienzo(viejo), viejo);
      };
    };
    caja.addEventListener('click', () => { if (!hero.classList.contains('crecido')) return; fijarEstacion(est + 1, 'hero'); });
    addEventListener('savvia:estacion', (ev) => {
      const n = (ev as CustomEvent).detail.n as number;
      if (n === est) return;
      est = n; rotular();
      if (!t) return;
      cambiarLamina(n);
    });
    new IntersectionObserver((e) => { heroVisible = e[0].isIntersecting; t?.visible(heroVisible); }).observe(hero);
    // la luz sigue al ratón (con retraso); con movimiento reducido o en táctil se queda quieta
    // RONDA 29 · «tiene que parecer que el haz incide en el árbol, no al revés»: el brillo del árbol (shader) se coloca EXACTAMENTE bajo el haz
    // principal del hero: misma inclinación (18°: tan = 0,325, la del shader) y misma x a la altura de la copa, con el ratón incluido
    const alinear = (mx: number) => {
      if (!t) return;
      const hr = hero.getBoundingClientRect(), cr = caja.getBoundingClientRect();
      const base = hr.width * 0.57 + mx * 0.38 * innerWidth; // centro del haz «a» (left 40 % + ancho 34 %) en el hero
      const xTop = base - 0.325 * (cr.top - hr.top - hr.height * 0.5); // el haz gira sobre su centro (a media altura del hero)
      const d = (xTop - (cr.left - hr.left)) / cr.width; // en fracciones de la caja del árbol
      luzV = 0.95 * d - 0.62; t.luz(luzV);
    };
    alinear(0); addEventListener('resize', () => alinear(0));
    if (!reducido && matchMedia('(hover: hover)').matches) {
      let mx = 0, my = 0, tx = 0, ty = 0, raf = 0;
      const seguir = () => {
        raf = 0;
        mx += (tx - mx) * 0.05; my += (ty - my) * 0.05;
        hero.style.setProperty('--lx', mx.toFixed(4)); hero.style.setProperty('--ly', my.toFixed(4));
        alinear(mx);
        if (Math.abs(tx - mx) + Math.abs(ty - my) > 0.001) raf = requestAnimationFrame(seguir);
      };
      hero.addEventListener('pointermove', (e) => { const r = hero.getBoundingClientRect(); tx = (e.clientX - r.left) / r.width - 0.5; ty = (e.clientY - r.top) / r.height - 0.5; if (!raf) raf = requestAnimationFrame(seguir); }, { passive: true });
      hero.addEventListener('pointerleave', () => { tx = 0; ty = 0; if (!raf) raf = requestAnimationFrame(seguir); });
    }
  }
</script>

<style>
  .hero {
    --tinta-hero: var(--color-niebla); /* la tinta de los detalles (haz, puntos y trazos del marco) */
    --lx: 0; /* el ratón, de −0,5 a 0,5 */
    --ly: 0;
    min-height: 100lvh;
    padding-top: calc(var(--spacing) * 24);
    padding-bottom: 0; /* RONDA 16: el pie del árbol ES el pie del hero («para que no se vea el corte»); las raíces nacen justo debajo */
  }
  /* PRUEBA hero-claro (?hero=blanco|claro): los detalles que eran Rosa niebla pasan a Cacao; con «blanco», el fondo es blanco puro */
  :global(html.hero-claro) .hero {
    --tinta-hero: var(--color-cacao);
  }
  :global(html.hero-blanco) .hero {
    --bg: #fff;
  }
  /* sobre claro no hay haz (en oscuro se leía como una banda gris); tampoco su brillo sobre el árbol (sinLuz, en el script) */
  :global(html.hero-claro) .hero .luz {
    display: none;
  }
  /* RONDA 132 · en invierno el hero es NIEVE: un haz de luz claro sobre blanco no se ve (y en oscuro sería una banda de sombra): se retira con un fundido */
  :global(html[data-estacion='invierno']) .hero .luz {
    opacity: 0;
  }
  /* RONDA 83 · Eric: «esto tiene que estar más arriba, dejar más aire abajo» → (a partes iguales) «un poco más abajo»: el hueco libre ya no va
     entero ENCIMA del titular (ronda 14): dos tercios encima y un tercio debajo; el marco y el árbol se quedan abajo (los 40 px al marco pasan
     a ser el mínimo). La caja del titular ocupa el hueco y lo reparte con dos separadores */
  .titular {
    flex: 1 0 auto;
    position: relative;
    z-index: 1;
  }
  .titular::before,
  .titular::after {
    content: '';
    flex: 2;
  }
  .titular::after {
    flex: 1;
  }
  /* ronda 31: sin sombra en el titular («no la quiero») */
  /* LA LUZ: dos haces oblicuos que entran desde arriba (más fuertes en lo alto), sobre todo el hero, en «screen»; se desplazan con el ratón */
  .luz {
    position: absolute;
    inset: 0;
    z-index: 0; /* ronda 30: por DETRÁS del titular (z 1) y del árbol */
    pointer-events: none;
    overflow: hidden;
    /* ronda 29: sin mezcla «screen» (Safari no la pintaba fuera del lienzo del árbol): luz normal, Rosa niebla translúcida */
    opacity: 0;
    translate: 0 -18%;
    transition: opacity 2.2s ease, translate 2.6s var(--ease-out-expo);
    /* ronda 28: «tiene que salir desde arriba y atravesar el árbol»: llega entera hasta abajo, solo se apaga en el último tramo */
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 55%, rgb(0 0 0 / 0.45) 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 55%, rgb(0 0 0 / 0.45) 100%);
  }
  /* ronda 30: el haz ENTRA desde arriba al caer la gota; el árbol se pinta debajo y su luz (shader) llega al final */
  .luz-entra .luz {
    opacity: 1;
    translate: 0 0;
  }
  /* UN solo haz, sutil (pico 0,11), que sale de un punto arriba (más ancho y claro al nacer, se abre y se apaga hacia abajo) */
  .luz .haz {
    position: absolute;
    top: -20%;
    bottom: -20%;
    width: 34%;
    left: 40%;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--tinta-hero) 3%, transparent) 30%, color-mix(in srgb, var(--tinta-hero) 7.5%, transparent) 50%, color-mix(in srgb, var(--tinta-hero) 3%, transparent) 70%, transparent); /* ronda 31: pico 0,075 */
    transform: translateX(calc(var(--lx) * 38vw)) skewX(-18deg); /* 18°: la misma inclinación que el brillo del árbol */
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .luz .haz { transform: skewX(-18deg); }
    .luz { transition: none; }
  }
  .pie-arbol {
    margin-top: 2.5rem; /* 40 px como mínimo (ronda 17); desde la 83 el titular reparte el hueco libre y suele haber más */
    padding-top: calc(var(--spacing) * 8);
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .arbol-caja {
    position: relative;
    width: var(--roble-w);
    aspect-ratio: 1260 / 583; /* el tronco ya está en el centro de la lámina */
  }
  .marco {
    --gutter: calc(var(--spacing) * 5);
    --punto: color-mix(in srgb, var(--tinta-hero) 10%, transparent); /* Rosa niebla al 10 % */
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    translate: -50% 0;
    width: min(100% - var(--gutter) * 2, var(--contenido));
    /* «el fondo detrás del árbol va de color sólido a nada […] replicarlo pero con puntos que son casi del color del fondo. Nuestro color
       claro al 10 % y que vaya a 0 %»: retícula de puntos a 45° (la misma del semitono del árbol) que se desvanece hacia abajo */
    /* RONDA 146 · Andoni: «quita la parrilla de detrás del árbol, los puntos»: sin la trama de puntos (rondas 16–145); quedan los lados a trazos */
    -webkit-mask-image: linear-gradient(to bottom, #000, transparent 96%);
    mask-image: linear-gradient(to bottom, #000, transparent 96%);
    /* RONDA 149 · «las líneas verticales, continuas, que no haya ningún dashed»: fuera los lados a trazos (los carriles ya dibujan la línea continua) */
    pointer-events: none;
  }
  /* RONDA 83 · sin animación de carga, los puntos del marco entran A LA VEZ que la línea y las cruces de los carriles (Carriles.astro: 0,2 s de espera),
     y el árbol después (ESPERA, en el script). Con carga, el marco sube con el hero, como siempre. */
  :global(html.sin-carga) .marco {
    animation: asomar-marco 0.7s ease 0.2s both;
  }
  @keyframes asomar-marco {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.sin-carga) .marco { animation: none; }
  }
  @media (width >= 48rem) {
    .marco { --gutter: calc(var(--spacing) * 8); }
  }
  @media (width >= 64rem) {
    .marco { --gutter: calc(var(--spacing) * 12); }
  }
  /* ronda 66: el halo y el grano se recortan con la lámina de la estación */
  .arbol-caja { --hoja-lamina: url('/media/hero/arbol-otono.webp'); }
  .hero[data-estacion='invierno'] .arbol-caja { --hoja-lamina: url('/media/hero/arbol-invierno.webp'); }
  .hero[data-estacion='primavera'] .arbol-caja { --hoja-lamina: url('/media/hero/arbol-primavera.webp'); }
  .hero[data-estacion='verano'] .arbol-caja { --hoja-lamina: url('/media/hero/arbol-verano.webp'); }
  .arbol-caja {
    pointer-events: auto; /* el huevo de pascua */
    cursor: pointer;
  }
  /* el MISMO grano de la página por encima del árbol: una sola materia */
  .arbol-caja::after {
    content: '';
    position: absolute;
    inset: 0;
    background: none;
    /* recortado a la forma del árbol: suelto, el grano doble dibujaba la CAJA como un rectángulo más claro (cazado mirando) */
    -webkit-mask: var(--hoja-lamina) center / 100% 100% no-repeat;
    mask: var(--hoja-lamina) center / 100% 100% no-repeat;
    opacity: 0;
    transition: opacity 1.5s ease;
  }
  .crecido .arbol-caja::after {
    opacity: 0.9;
  }
  .esquina {
    --gutter: calc(var(--spacing) * 5);
    --marco-w: min(100% - var(--gutter) * 2, var(--contenido));
    position: absolute;
    bottom: calc(var(--spacing) * 3);
    color: var(--fg2);
    opacity: 0;
    transition: opacity 0.8s ease 0.4s;
    pointer-events: none;
    z-index: 2;
  }
  @media (width >= 48rem) { .esquina { --gutter: calc(var(--spacing) * 8); } }
  @media (width >= 64rem) { .esquina { --gutter: calc(var(--spacing) * 12); } }
  .estacion { right: calc((100% - var(--marco-w)) / 2 + var(--spacing) * 4); }
  .desde { left: calc((100% - var(--marco-w)) / 2 + var(--spacing) * 4); }
  .crecido .esquina {
    opacity: 1;
  }
