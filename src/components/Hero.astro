---
import { hero } from '../data/home';
import { rich, isoV } from '../lib/rich';
---

<!--
  HERO (ronda 13). Andoni pasa una ACUARELA de roble (copa en otoño que se deshace en estelas horizontales, línea de suelo y raíces):
  «te paso una imagen y ya veremos cómo la animamos, quiero probar».
  · `tools/recorte-hero.py`: se recorta del fondo hueso (el color de la zona translúcida sale de la tinta vecina: sin halo sobre Cacao)
    y se parte por la línea de suelo → `hero-arbol.webp` (aquí) y `hero-raices.webp` (Raices.astro). Centradas en el tronco.
  · ANIMACIÓN (`src/scripts/estela.ts`, ronda 14): una gota de savia cae a la base del tronco, corre por el suelo y el árbol BROTA de ahí;
    en reposo, tramado en color y canto (se funde con el grano del fondo) y una deriva de color muy lenta. Más pequeño que en la 13.
  · El roble de PALABRAS de la ronda 12 (`src/scripts/palabras.ts`) sigue en el código, sin uso: se vuelve a él cambiando el import.
  · Regla dura 3: el lienzo nace invisible. Sin WebGL queda la lámina como imagen. Con movimiento reducido, ya compuesto y quieto.
-->
<section class="hero relative flex flex-col items-center overflow-hidden" aria-labelledby="h1" data-hero>
  <!-- RONDA 27–31 · el haz de luz que entra desde arriba y sigue al ratón -->
  <div class="luz" aria-hidden="true" data-luz><i class="haz a"></i></div>
  <div class="wrap titular flex flex-col items-center text-center">
    <h1 id="h1" class="text-h1 max-w-[20ch]" set:html={rich(hero.h1)} />
    <p class="text-lead text-fg2 mt-4 lg:mt-6" set:html={isoV(hero.h2)} />
  </div>
  <div class="pie-arbol">
    <!-- EL MARCO (rondas 15–17): retícula de puntos Rosa niebla al 10 % → 0 %. Ronda 89: las ondas de los atriles la recorren -->
    <!-- RONDA 91 · «el fondo que teníamos para el director lo quitamos» (la terraza: public/media/hero/fondo.webp, sin uso) -->
    <div class="marco" aria-hidden="true" data-carril-fila><canvas class="puntos" data-puntos></canvas></div>
    <p class="esquina desde detail tabular-nums" data-hora></p>
    <p class="esquina estacion detail">desde 2020</p>
    <!-- RONDA 89 · «las diferentes partes del hero en diferentes capas: el director primero, luego atriles y luego fondo». La lámina de Andoni partida
         (tools/r89/capas.py: máscara de persona + la batuta) en dos capas con la MISMA caja: los atriles detrás y el director delante; cada una con su
         paralaje. «Después del hero el director queda cortado»: la escena se funde por abajo en la niebla del suelo y, al bajar, el director se hunde en ella -->
    <div class="arbol-caja" aria-hidden="true" data-arbol>
      <i class="halo" aria-hidden="true"></i>
      <!-- RONDA 96 (2.ª) · «lo que sale del director tiene que pasar ENTRE los objetos»: un tercer plano, por detrás de los atriles (se cuela tras sus peanas) -->
      <canvas class="magia fondo" aria-hidden="true" data-magia="fondo"></canvas>
      <div class="capa atriles" data-capa="atriles">
        <img alt="" width="1490" height="1105" decoding="async" data-atriles-lamina />
        <canvas class="lienzo" data-atriles-lienzo></canvas>
      </div>
      <!-- RONDA 90 · «la magia tiene que parecer que pasa ENTRE los elementos»: dos planos de magia. El de en medio (entre los atriles y el director): lo que
           viaja a las pantallas y cruza por detrás de su espalda; el de delante: lo que sale de sus manos y vuelve a ellas -->
      <canvas class="magia medio" aria-hidden="true" data-magia="medio"></canvas>
      <div class="capa director" data-capa="director">
        <img alt="" width="1490" height="1105" decoding="async" fetchpriority="high" data-lamina />
        <!-- ronda 96: las láminas pintadas solo las pide `?estilo=pintura` (los estilos papel y retrato traen las suyas) -->
        <!-- ronda 96 (2.ª): el estilo de serie, EN COLOR con el motor del árbol, usa las láminas nuevas como textura -->
        <script is:inline>(function () { var q = location.search, d = document.currentScript.previousElementSibling, a = d.closest('[data-arbol]').querySelector('[data-atriles-lamina]');
          if (/[?&]estilo=pintura/.test(q)) { d.src = '/media/hero/director.webp'; a.src = '/media/hero/atriles.webp'; }
          else if (/[?&]estilo=(color|retrato)/.test(q)) { d.src = '/media/hero/retrato-director.webp'; a.src = '/media/hero/retrato-atriles.webp'; }
          else if (!/[?&]estilo=papel/.test(q)) d.src = '/media/hero/jazz-director.webp'; })();</script>
        <canvas class="lienzo" data-lienzo></canvas>
      </div>
      <canvas class="magia frente" aria-hidden="true" data-magia="frente"></canvas>
    </div>
  </div>
  <!-- RONDA 89 · LA MAGIA («como el mago que te paso»): una estela de polvo de estrellas con cabeza de cometa dorada sale de la batuta, pasa por cada atril
       (que se ENCIENDE y suelta una onda por todo el hero) y vuelve a la mano del director; descansa y vuelve a empezar -->
</section>

<script>
  import { crearEstela, type Estela } from '../scripts/estela';
  import { crearPapel } from '../scripts/papel';
  import { crearRetrato } from '../scripts/retrato';
  import { crearAscii } from '../scripts/ascii';
  import { bandas, fase } from '../scripts/jazz';
  import { crearReticula } from '../scripts/reticula';
  import { NOCHE } from '../scripts/estacion';
  import { golpe, tocar, tecla } from '../scripts/musica';
  // RONDA 96 (2.ª) · muestras de una lámina (para el manifiesto): trozos con tinta, su sitio y su color fundido con el fondo
  function muestrasDe(src: string, caja: () => DOMRect) {
    let lista: { i: number; x: number; y: number; w: number; h: number; a: number; col: string; pen: string }[] = [];
    const img = new Image(); img.decoding = 'async'; img.src = src;
    img.addEventListener('load', () => {
      const W = 418, H = Math.round((W * img.naturalHeight) / img.naturalWidth), o = document.createElement('canvas'); o.width = W; o.height = H;
      const oc = o.getContext('2d', { willReadFrequently: true })!; oc.drawImage(img, 0, 0, W, H); const px = oc.getImageData(0, 0, W, H).data;
      let sem = 7; const az = () => { sem = (sem * 16807) % 2147483647; return sem / 2147483647; };
      const out: typeof lista = [];
      for (let k = 0, n = 0; k < 260 && n < 30000; n++) {
        const x = Math.floor(az() * W), y = Math.floor(az() * H), j = (y * W + x) * 4; if (px[j + 3] < 200) continue;
        const m = (q: number, f: number) => Math.round(px[j + q] * 0.78 + f * 0.22), w = 0.026 + az() * 0.022;
        out.push({ i: k, x: x / W, y: y / H, w, h: w * (0.34 + az() * 0.12) * (W / H), a: (az() - 0.5) * 0.5, col: `rgb(${m(0, 59)},${m(1, 35)},${m(2, 27)})`, pen: 'rgba(36,28,25,0.62)' }); k++;
      }
      lista = out;
    });
    return { caja, muestras: (n: number) => lista.slice(0, n).sort((p, q) => q.y - p.y), huecos: () => {}, soloPalabras: /ascii/.test(src) || src.includes('jazz') };
  }
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const caja = hero.querySelector<HTMLElement>('[data-arbol]')!;
    // RONDA 96 · «en el hero quiero probar otro estilo, el de los retratos de los testimonios»: el RETRATO es el de serie (src/scripts/retrato.ts, con las
    // láminas nuevas de Andoni: tools/r96/capas.py); el papel queda en `?estilo=papel` y el pintado en `?estilo=pintura`. La lámina nueva es más apaisada
    // (1672 × 941): sus puntos (batuta, mano, atriles, pantallas) se midieron sobre ella; los de las otras dos siguen siendo los de 1490 × 1105
    // RONDA 96 (2.ª) · «las quiero A COLOR, con el efecto que teníamos en el árbol, como que se distorsionaba; los ordenadores, más pequeños»: el de serie es
    // `color` (las láminas nuevas, con los atriles encogidos sobre su base, pintadas por el motor del árbol: se dibujan desde la batuta, hierven, se deshacen
    // en semitono por los cantos y las ondas las desplazan). El retrato en una tinta queda en `?estilo=retrato`
    const q0 = location.search;
    // RONDA 97 · «el director con ASCII, que reaccione a la música (jazz calmado de fondo) con pulsos»: el de serie es `ascii` (src/scripts/ascii.ts, con las
    // mismas láminas nuevas); el color con el motor del árbol queda en `?estilo=color`
    const estilo = /[?&]estilo=pintura/.test(q0) ? 'pintura' : /[?&]estilo=papel/.test(q0) ? 'papel' : /[?&]estilo=retrato/.test(q0) ? 'retrato' : /[?&]estilo=color/.test(q0) ? 'color' : 'ascii';
    const retrato = estilo === 'retrato' || estilo === 'color' || estilo === 'ascii'; // usan la lámina nueva (sus puntos y su caja)
    const clara = document.documentElement.dataset.paleta === 'clara';
    hero.classList.add(`estilo-${estilo}`); if (!retrato) hero.classList.add('estilo-antiguo');
    const BATUTA: [number, number] = retrato ? [0.583, 0.015] : [0.632, 0.02];
    // las tres capas, pintadas por el motor. Todas nacen desde la batuta (la carga deja caer el isotipo ahí: `savvia:gota`)
    const capa = (cv: string, img: string, extra: object) => crearEstela(hero.querySelector<HTMLCanvasElement>(cv)!, hero.querySelector<HTMLImageElement>(img)!, { origen: BATUTA, dir: -1, radial: true, sinGota: true, tramado: true, tramadoBpm: 0, soplo: true, gota: true, manual: true, intensidad: 0, ...extra });
    // RONDA 90 · el director y los atriles hechos de etiquetas de papel (vídeo v0.mp4). RONDA 91 · «me mola el estilo papel»: es el de serie; el pintado de
    // antes queda en `?estilo=pintura`. El papel se hace con las láminas NÍTIDAS (tools/r89/capas.py), que el collage necesita detalle
    const papel = estilo === 'papel';
    const nitida = (src: string) => { const i = new Image(); i.decoding = 'async'; i.src = src; return i; };
    // RONDA 94 · «que el director mueva los brazos»: el rig (hombro → mano, en fracciones de la lámina; medido sobre director-nitido.webp) y el compás (92 BPM)
    const BRAZOS = [{ hombro: [0.372, 0.33] as [number, number], mano: [0.205, 0.11] as [number, number], ancho: 0.1 }, { hombro: [0.578, 0.32] as [number, number], mano: [0.735, 0.15] as [number, number], ancho: 0.1 }]; // ronda 95: más anchos: la manga entera va con el brazo (si no, su borde se quedaba quieto detrás: «parece que se duplican»)
    // RONDA 94 · «que se note la iluminación de la luz de arriba en el director (hero oscuro)»: `luzHaz` pinta el haz sobre el papel
    const enPapel = (cv: string, src: string, sem: number, batuta?: [number, number, number, number], mueve = false) => crearPapel(hero.querySelector<HTMLCanvasElement>(cv)!, nitida(src), { origen: BATUTA, semilla: sem, batuta, luzHaz: !clara, ...(mueve ? { brazos: BRAZOS, bpm: 46, amplitud: 0.75 } : {}) }) as unknown as Estela; // ronda 95: «en claro, la ilustración del mismo color que el oscuro» (fuera el pop de las rondas 92–94: `pop` sigue en papel.ts) · brazos más tranquilos: a medio tiempo y con menos recorrido
    const enRetrato = (cv: string, src: string, sem: number) => crearRetrato(hero.querySelector<HTMLCanvasElement>(cv)!, nitida(src), { origen: BATUTA, clara, semilla: sem }) as unknown as Estela;
    const color = estilo === 'color', ascii = estilo === 'ascii';
    // RONDA 103 · «que el director mueva los brazos como orquestando»: los dos hombros (medidos en jazz-director.webp) y una línea que deja fuera la cabeza;
    // la batuta marca cada tiempo (cae en el tiempo y rebota; el 1, más hondo) y la mano izquierda la acompaña en espejo, más suave y respirando cada dos compases
    const MIEMBROS = [
      { p: [0.66, 0.3] as [number, number], t: [0.56, 0] as [number, number], lado: 0.03, r0: 0.02, r1: 0.12 },
      { p: [0.34, 0.3] as [number, number], t: [0.44, 0] as [number, number], lado: -0.03, r0: 0.02, r1: 0.12 },
    ];
    // RONDA 104 · «que se note más y más orgánico, no a saltos»: curvas continuas (antes el golpe de cada tiempo arrancaba de cero: saltaba). La batuta baja al
    // tiempo y sube entre tiempos (un coseno), más honda en el 1 y el 3, y deriva despacio con la frase; la izquierda, en espejo, más suave y algo detrás
    // RONDA 107 · «este efecto de movimiento (ascii.fm)»: STOP-MOTION. La pose se toma en tres fotogramas por tiempo (abajo en el tiempo, rebote, arriba) y se
    // sostiene hasta el siguiente, como el galope de ascii.fm; los cantos hierven en cada fotograma. `?mov=suave` vuelve al movimiento continuo de la ronda 104
    const stop = !/[?&]mov=suave/.test(location.search);
    const dirigir = (t: number) => {
      const f = fase(t), b = stop ? Math.floor(f * 3) / 3 : f, T = Math.PI * 2, i = Math.floor(f * 3) % 3;
      // en stop-motion, tres poses de verdad distintas por tiempo (abajo · a media subida · arriba); en continuo, el coseno
      const golpe = stop ? [1, 0.42, 0][i] : 0.5 + 0.5 * Math.cos(T * b), acento = 0.78 + 0.22 * Math.cos(T * Math.floor(b) / 2);
      const der = 0.24 * golpe * acento - 0.06 + 0.05 * Math.sin(T * b / 8);
      const izq = -(0.15 * (stop ? [0.6, 1, 0.2][i] : 0.5 + 0.5 * Math.cos(T * b - 0.7)) * acento - 0.04) - 0.07 * Math.sin(T * b / 8 + 1.3);
      return [der, izq];
    };
    const enAscii = (cv: string, img: string, celda?: number) => crearAscii(hero.querySelector<HTMLCanvasElement>(cv)!, hero.querySelector<HTMLImageElement>(img)!, { origen: BATUTA, clara, bandas, celda, miembros: MIEMBROS, angulos: dirigir, hueco: true, teclear: () => tecla({ vol: 0.028 }), // ronda 108: se escribe signo a signo, tecleando
       fotogramas: stop ? (t: number) => Math.floor(fase(t) * 3) : undefined, vel: 190, vida: 6.5, texto: /[?&]ascii=rampa/.test(location.search) ? undefined : document.querySelector('[data-manifiesto] .texto')?.textContent || undefined }) as unknown as Estela | null;
    // RONDA 100 · «¿el ASCII hecho con letras o palabras, para que tenga más sentido con la animación hacia la siguiente sección?»: el director está ESCRITO con el
    // texto del manifiesto (que luego sale volando a su sitio); la rampa de caracteres, en `?ascii=rampa`
    // RONDA 98 · «modificamos el director hacia algo más jazz»: la lámina nueva de Andoni (traje, ordenadores de los 80) es UNA capa en ASCII
    const t = estilo === 'pintura' ? capa('[data-lienzo]', '[data-lamina]', { hd: true }) : color ? capa('[data-lienzo]', '[data-lamina]', { hd: true, tramado: false }) : ascii ? enAscii('[data-lienzo]', '[data-lamina]') : null;
    const tA = papel ? enPapel('[data-atriles-lienzo]', '/media/hero/atriles-nitido.webp', 11) : ascii ? null : color ? capa('[data-atriles-lienzo]', '[data-atriles-lamina]', { hd: true, tramado: false }) : retrato ? enRetrato('[data-atriles-lienzo]', '/media/hero/retrato-atriles.webp', 11) : capa('[data-atriles-lienzo]', '[data-atriles-lamina]', { hd: true });
    // la batuta, de la punta a la mano (en la lámina): una tira de papel
    const tD = papel ? enPapel('[data-lienzo]', '/media/hero/director-nitido.webp', 7, [0.632, 0.02, 0.733, 0.132], true) : estilo === 'retrato' ? enRetrato('[data-lienzo]', '/media/hero/retrato-director.webp', 7) : null;
    const capas = [t, tA, tD].filter(Boolean) as Estela[];
    // ronda 92 · el manifiesto saca sus palabras de las etiquetas REALES del director
    // en color, las tarjetas del manifiesto se desprenden de trozos REALES de la lámina (su sitio y su color); el lienzo WebGL no deja huecos
    if (color || ascii) (window as any).__papelDirector = muestrasDe(ascii ? '/media/hero/jazz-director.webp' : '/media/hero/retrato-director.webp', () => hero.querySelector<HTMLCanvasElement>('[data-lienzo]')!.getBoundingClientRect());
    else (window as any).__papelDirector = tD ? { caja: () => hero.querySelector<HTMLCanvasElement>('[data-lienzo]')!.getBoundingClientRect(), muestras: (n: number) => (tD as any).muestras(n), huecos: (l: number[]) => (tD as any).huecos(l) } : null;
    const w = window as any;
    const suelta = () => { capas.forEach((c) => c.soltar()); hero.classList.add('luz-entra'); setTimeout(() => hero.classList.add('crecido'), reducido ? 0 : 4200); };
    if (w.__gotaSuelta) suelta(); else addEventListener('savvia:gota', suelta, { once: true });
    if ((estilo === 'pintura' || color || ascii) && !t) hero.classList.add('sin-gl');
    // ronda 91 · en la paleta clara el fondo del hero es Neutro claro: las etiquetas se funden con él
    if (clara) hero.classList.add('clara');
    capas.forEach((c) => (clara ? c.fondo(245, 247, 255) : c.fondo(...NOCHE[0])));
    // la hora del estudio (Donostia), al minuto
    const hora = hero.querySelector<HTMLElement>('[data-hora]')!;
    const fmt = new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' });
    const tic = () => { hora.textContent = fmt.format(new Date()); setTimeout(tic, 60000 - (Date.now() % 60000) + 50); };
    tic();
    // ── LAS ONDAS: una onda nace en un punto de PANTALLA y recorre todas las capas y la retícula de puntos
    const ondasPuntos: { x: number; y: number; t0: number; f: number }[] = [];
    const onda = (x: number, y: number, f = 1) => { if (reducido) return; capas.forEach((c) => c.onda(x, y, f)); ondasPuntos.push({ x, y, t0: performance.now(), f }); despertarPuntos(); };
    addEventListener('savvia:onda', (e) => { const d = (e as CustomEvent).detail; onda(d.x, d.y, d.f ?? 1); ret?.onda(d.x, d.y, 1, [1, 0.38, 0.42]); }); // ronda 110: la onda del aterrizaje recorre también la retícula
    // RONDA 102 · «los pulsos, al ritmo de los del footer (una onda cada dos compases, lenta), siempre del mismo color (coral), siempre desde el mismo sitio:
    // centrados desde abajo; a su paso REVELAN los colores del ASCII (ascii.ts) y lo mueven más». La retícula del recuadro lleva el anillo coral
    // (antes, ronda 99–100: una onda por tiempo, de colores y desde cualquier punto de la figura)
    if (ascii) addEventListener('savvia:pulso', (e) => {
      const d = (e as CustomEvent).detail;
      if (!heroVisto || !hero.classList.contains('crecido') || !t || d.k !== 0) return; // ronda 103 · «más ondas: un punto intermedio»: una por compás (antes, cada dos; en la 99, una por tiempo)
      const mr = marco.getBoundingClientRect(), x = mr.left + mr.width / 2, y = mr.bottom - 4;
      (t as unknown as { onda(x: number, y: number, f: number, c: number[]): void }).onda(x, y, 1, [1, 0.38, 0.42]);
      ret?.onda(x, y, 0.9, [1, 0.38, 0.42]);
    });
    // ── LOS PUNTOS del recuadro: quietos salvo cuando pasa una onda (ronda 89: fuera el pulso a tempo, «no tenía un porqué») o suena una nota
    const marco = hero.querySelector<HTMLElement>('.marco')!, pc = marco.querySelector<HTMLCanvasElement>('[data-puntos]')!, px = pc.getContext('2d')!;
    let heroVisto = true, rafP = 0, quietos = false;
    const VEL = 380, VIDA = 3.4;
    // RONDA 100 · «el pulso se tiene que propagar por todos los puntos del hero, por todo el recuadro»: en ASCII, la retícula del marco es la de reticula.ts
    // ronda 103 · «que se expandan por todo el cuadrado de puntitos»: más rápida y más larga, llega a las esquinas de arriba
    const ret = ascii ? crearReticula(pc, { alfa: 0.12, vel: 190, ancho: 56, vida: 6.5 }) : null;
    const puntos = (ahora: number) => {
      rafP = 0;
      if (ret) return;
      if (!heroVisto) return;
      const r = marco.getBoundingClientRect(), dpr = Math.min(2, devicePixelRatio || 1);
      if (pc.width !== Math.round(r.width * dpr) || pc.height !== Math.round(r.height * dpr)) { pc.width = Math.round(r.width * dpr); pc.height = Math.round(r.height * dpr); quietos = false; }
      for (let i = ondasPuntos.length - 1; i >= 0; i--) if ((ahora - ondasPuntos[i].t0) / 1000 > VIDA) ondasPuntos.splice(i, 1);
      const gl = reducido ? 0 : golpe();
      if (!ondasPuntos.length && gl < 0.01 && quietos) return; // nada que mover: no se repinta
      quietos = !ondasPuntos.length && gl < 0.01;
      px.setTransform(dpr, 0, 0, dpr, 0, 0); px.clearRect(0, 0, r.width, r.height);
      const os = ondasPuntos.map((o) => { const e = (ahora - o.t0) / 1000; return { x: o.x - r.left, y: o.y - r.top, rad: e * VEL, a: o.f * Math.pow(1 - e / VIDA, 1.6) * Math.min(1, e * 6) }; });
      const cr = caja.getBoundingClientRect(), bx = cr.left - r.left + cr.width * 0.5, by = cr.top - r.top + cr.height * 0.4;
      px.fillStyle = clara ? '#241c19' : '#eadde7';
      for (let y = 4, fila = 0; y < r.height; y += 4, fila++) {
        const baja = 1 - y / (r.height * 0.96); if (baja <= 0) break;
        for (let x = fila % 2 ? 4 : 0; x < r.width; x += 8) {
          let o = 0;
          for (const w2 of os) { const d = Math.hypot(x - w2.x, y - w2.y); o += Math.exp(-Math.pow((d - w2.rad) / 48, 2)) * w2.a; }
          const rr = 1.15 + o * 1.3 + gl * 0.9 * Math.exp(-Math.hypot(x - bx, y - by) / 420);
          px.globalAlpha = Math.min(0.6, (0.1 + o * 0.3 + gl * 0.2) * baja);
          px.beginPath(); px.arc(x, y, rr, 0, 6.283); px.fill();
        }
      }
      px.globalAlpha = 1;
      rafP = window.setTimeout(() => requestAnimationFrame(puntos), 33) as unknown as number;
    };
    const despertarPuntos = () => { quietos = false; if (!rafP && heroVisto) rafP = requestAnimationFrame(puntos); };
    // ── LA MAGIA (el mago de la referencia: cometa dorado, polvo de estrellas que titila y cae, estrellas de cuatro puntas)
