---
import { home, fichasDe } from '../data/idioma';
import { langDe } from '../lib/i18n';
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { preguntas: preguntasBase, pie } = home(lang);
const preguntas = { ...preguntasBase, lista: fichasDe(lang) as { q: string; a: string; claves: string[]; chip: boolean; ctas?: { t: string; h: string }[] }[] };
const personas = (en ? personasEn : personasEs) as Record<string, string>[];
const T = en
  ? { conversacion: 'Conversation with', tu: 'You: ', escribiendo: 'Typing', suele: 'What people usually ask', otra: 'Ask another question…' }
  : { conversacion: 'Conversación con', tu: 'Tú: ', escribiendo: 'Está escribiendo', suele: 'Lo que suele preguntar la gente', otra: 'Escribe otra pregunta…' };
const CARA = ['/media/equipo/cara-andoni-transparente.webp', '/media/equipo/cara-eric-transparente.webp'];
const NOMBRE = personas.map((p) => p.nombre); // [Andoni, Eric]
// `{yo}` = quien contesta · `{otro}` = su compañero · `{yo.ciudad}`, `{otro.correo}`… = datos de cada uno (src/data/personas.json)
const resolver = (t: string, quien: number) => t.replaceAll('{donostia}', 'Donostia').replace(/\{(yo|otro)(?:\.(\w+))?\}/g, (_, w, k) => personas[w === 'yo' ? quien : 1 - quien][k || 'nombre']);
import { flecha } from '../lib/flecha';
import personasEs from '../data/personas.json';
import personasEn from '../data/personas.en.json';
---

<!--
  PREGUNTAS (ronda 43 · «las FAQs hacerlas más originales»). Una CONVERSACIÓN con Eric y Andoni, no un acordeón. Debajo, las preguntas que suele hacer la
  gente, como sugerencias: al pulsar una, aparece como tu mensaje, uno de los dos «está escribiendo…» (con su cara) y contesta. Y puedes escribir la tuya:
  se busca entre las respuestas escritas por palabras clave, en el navegador y sin ningún modelo detrás (la página lo dice); si no está, te ofrece
  mandársela por correo. Contestan por turnos (Andoni, Eric…). Sin JS o con movimiento reducido: la conversación entera, a la vista.
-->
<section id="preguntas" class="surface-light" aria-label={preguntas.pregunta} data-preguntas data-sube>
  <div class="wrap section-y">
    <div class="grid-12 gap-y-12">
      <div class="col-span-4 lg:col-span-5">
        <h2 class="text-h2" data-entra>{preguntas.titulo}</h2>
        <p class="mt-6 flex items-center gap-3">
          <span class="caras" aria-hidden="true"><img src={CARA[1]} alt="" width="144" height="144" loading="lazy" decoding="async" /><img src={CARA[0]} alt="" width="144" height="144" loading="lazy" decoding="async" /></span>
          <span>
            <span class="text-ui block font-medium">{preguntas.firma}</span>
            <span class="text-aux text-fg2 block">{preguntas.nota}</span>
          </span>
        </p>
      </div>
      <div class="col-span-4 lg:col-span-6 lg:col-start-7" data-enfoca style="--d:2">
        <div class="charla" role="log" aria-live="polite" aria-label={`${T.conversacion} ${preguntas.firma}`} data-charla>
          {
            preguntas.lista.map((x, i) => (
              <div class={`intercambio ${i === 0 ? 'q-on a-on' : 'pendiente'}`} data-i={i} data-claves={x.claves.join(' ')} data-ctas={(x as { ctas?: unknown }).ctas ? JSON.stringify((x as { ctas?: unknown }).ctas) : undefined} hidden={i > 6}>
                <p class="burbuja tu"><span class="sr-only">{T.tu}</span>{x.q}</p>
                <div class="resp">
                  <img class="cara" src={CARA[i % 2]} alt="" width="144" height="144" loading="lazy" decoding="async" />
                  <div class="burbuja ellos">
                    <p class="quien detail">{NOMBRE[i % 2]}</p>
                    <p data-respuesta data-raw={x.a}>{resolver(x.a, i % 2)}</p>
                  </div>
                </div>
              </div>
            ))
          }
          <div class="escribiendo" hidden data-escribiendo>
            <img class="cara" src={CARA[1]} alt="" width="144" height="144" loading="lazy" decoding="async" data-escribe-cara />
            <p class="burbuja ellos puntos" aria-label={T.escribiendo}><i></i><i></i><i></i></p>
          </div>
        </div>
        <div class="sugeridas" data-sugeridas>
          <p class="detail text-fg2">{T.suele}</p>
          <div class="chips">
            {(() => { let n = 0; return preguntas.lista.map((x, i) => i > 0 && <button type="button" class="chip" data-q={i} data-prio={x.chip ? '' : undefined} hidden={++n > 6}>{x.q}</button>); })()}
          </div>
        </div>
        <form class="compositor" data-libre novalidate>
          <label for="otra" class="sr-only">{preguntas.libre.etiqueta}</label>
          <input id="otra" name="otra" type="text" autocomplete="off" maxlength="160" placeholder={T.otra} class="campo text-ui" aria-describedby="otra-ayuda" />
          <button type="submit" class="mandar" aria-label={preguntas.libre.boton}><Fragment set:html={flecha()} /></button>
        </form>
        <p id="otra-ayuda" class="text-aux text-fg2 mt-3">{preguntas.libre.ayuda}</p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ sinRespuesta: preguntas.libre.sinRespuesta, correo: pie.correo, cal: pie.cal, caras: CARA, nombres: NOMBRE, personas }} is:inline>
  window.__PREG = { sinRespuesta, correo, cal, caras, nombres, personas };
</script>
<script>
  import { t } from '../scripts/i18n';
  import { mejorFicha } from '../scripts/buscar-ficha';
  const raiz = document.querySelector<HTMLElement>('[data-preguntas]');
  if (raiz) {
    const { sinRespuesta, correo, cal, caras, nombres, personas } = (window as any).__PREG as { sinRespuesta: string; correo: string; cal: string; caras: string[]; nombres: string[]; personas: Record<string, string>[] };
    // `{donostia}` alterna «Donostia» y «San Sebastián» (empieza por una al azar)
    let alterna = Math.random() < 0.5 ? 0 : 1;
    const ciudad = () => ['Donostia', 'San Sebastián'][alterna ^= 1];
    const resolver = (t: string, quien: number) => t.replace(/\{donostia\}/g, ciudad).replace(/\{(yo|otro)(?:\.(\w+))?\}/g, (_, w, k) => personas[w === 'yo' ? quien : 1 - quien][k || 'nombre']);
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const charla = raiz.querySelector<HTMLElement>('[data-charla]')!, escribiendo = raiz.querySelector<HTMLElement>('[data-escribiendo]')!, caraEsc = raiz.querySelector<HTMLImageElement>('[data-escribe-cara]')!;
    const inter = [...raiz.querySelectorAll<HTMLElement>('.intercambio')];
    let turno = 1, ocupado = false; // la primera la contestó Andoni: ahora le toca a Eric
    const bordes = () => {
      charla.classList.toggle('desplazada', charla.scrollTop > 2);
      charla.classList.toggle('hay-mas', charla.scrollTop + charla.clientHeight < charla.scrollHeight - 2);
    };
    charla.addEventListener('scroll', bordes, { passive: true });
    new MutationObserver(bordes).observe(charla, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['class', 'hidden'] });
    addEventListener('resize', bordes); bordes();
    const bajar = () => charla.scrollTo({ top: charla.scrollHeight, behavior: reducido ? 'auto' : 'smooth' });
    // una pregunta → su burbuja; «está escribiendo…» con la cara de quien contesta; y la respuesta
    // `pendiente`: si la respuesta aún se está buscando (pregunta libre), la pregunta ya está en pantalla y «está escribiendo…» espera a que llegue
    const conversar = (ex: HTMLElement, quien: number, alFinal?: () => void, pendiente?: Promise<unknown>) => {
      ocupado = true;
      charla.insertBefore(ex, escribiendo);
      ex.hidden = false; ex.classList.remove('pendiente'); ex.classList.add('q-on');
      const r = ex.querySelector<HTMLElement>('.resp');
      if (r) { r.querySelector<HTMLImageElement>('.cara')!.src = caras[quien]; r.querySelector('.quien')!.textContent = nombres[quien]; }
      bajar();
      setTimeout(() => {
        caraEsc.src = caras[quien]; escribiendo.hidden = reducido; charla.insertBefore(escribiendo, null); bajar();
        (pendiente ?? Promise.resolve()).catch(() => {}).then(() => {
          const rr = ex.querySelector<HTMLElement>('[data-respuesta]');
          if (rr && rr.dataset.raw !== undefined) rr.textContent = resolver(rr.dataset.raw, quien);
          // botones de la respuesta (ctas en preguntas.json): «cal» = el CTA de la casa (Contáctanos); lo demás, enlaces con {yo}/{otro}
          ex.querySelector('.ctas')?.remove();
          if (rr && ex.dataset.ctas) {
            const caja = document.createElement('div');
            [...rr.attributes].filter((at) => at.name.startsWith('data-astro-cid')).forEach((at) => caja.setAttribute(at.name, ''));
            caja.className = 'ctas';
            (JSON.parse(ex.dataset.ctas) as { t: string; h: string }[]).forEach((c, k) => {
              const a = document.createElement('a');
              [...rr.attributes].filter((at) => at.name.startsWith('data-astro-cid')).forEach((at) => a.setAttribute(at.name, ''));
              a.className = k === 0 ? 'cta cta-1' : 'cta';
              a.textContent = resolver(c.t, quien);
              a.href = c.h === 'cal' ? cal || `mailto:${correo}` : resolver(c.h, quien);
              if (/^https?:/.test(a.href)) { a.target = '_blank'; a.rel = 'noopener'; }
              if (a.href.startsWith('mailto:')) a.dataset.copiar = a.href.slice(7).split('?')[0];
              caja.append(a);
            });
            rr.after(caja);
          }
          const largo = rr?.textContent?.length ?? 80;
          const espera = reducido ? 0 : Math.min(pendiente ? 600 : 2000, 700 + largo * 7);
          setTimeout(() => { escribiendo.hidden = true; ex.classList.add('a-on'); ocupado = false; alFinal?.(); bajar(); }, espera);
        });
      }, reducido ? 0 : 450);
    };
    // SUGERENCIAS: salen 6 y, al usar una, entra otra en su lugar
    // salen todas, poco a poco y siempre en orden aleatorio
    const mezclar = <T,>(a: T[]) => { for (let k = a.length - 1; k > 0; k--) { const j = Math.floor(Math.random() * (k + 1)); [a[k], a[j]] = [a[j], a[k]]; } return a; };
    const todas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-q]')];
    const chips = mezclar(todas);
    chips.forEach((b, k) => { b.hidden = k >= 6; b.parentElement!.append(b); });
    chips.forEach((b) => b.addEventListener('click', () => {
      if (ocupado) return;
      const ex = inter[Number(b.dataset.q)];
      b.remove();
      const siguiente = chips.find((c) => c.hidden && c.isConnected);
      if (siguiente) siguiente.hidden = false;
      conversar(ex, turno); turno = 1 - turno;
      if (!raiz.querySelector('[data-q]:not([hidden])')) raiz.querySelector<HTMLElement>('[data-sugeridas]')!.hidden = true;
    }));
    // LA PREGUNTA LIBRE: por palabras clave (exacta = 2 puntos; misma raíz = 1) como respaldo; el modelo solo elige entre respuestas ya escritas
    const fichas = inter.map((d) => ({ claves: new Set(d.dataset.claves!.split(' ')), ctas: d.dataset.ctas || '', a: (d.querySelector<HTMLElement>('[data-respuesta]')!.dataset.raw ?? d.querySelector('[data-respuesta]')!.textContent!) }));
    const form = raiz.querySelector<HTMLFormElement>('[data-libre]')!, campo = form.querySelector<HTMLInputElement>('input')!;
    // MANDAN LAS RESPUESTAS ESCRITAS (api/preguntar.js, OpenRouter): si una encaja, sale esa tal cual; si no, la IA redacta con lo que ya hemos escrito y
    // se avisa de que es IA; si ni así, por correo. Si falla o no hay clave, la búsqueda por palabras de arriba.
    type Veredicto = { tipo: 'escrita'; i: number } | { tipo: 'ia' | 'fuera'; texto: string } | { tipo: 'ninguna' };
    const elegir = async (q: string, local: number, quien: number): Promise<Veredicto> => {
      const respaldo: Veredicto = local >= 0 ? { tipo: 'escrita', i: local } : { tipo: 'ninguna' };
      try {
        const r = await fetch('/api/preguntar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pregunta: q, quien, lang: t('es', 'en') }), signal: AbortSignal.timeout(14000) });
        if (!r.ok) return respaldo;
        const v = await r.json();
        if (v.tipo === 'escrita' && Number.isInteger(v.i) && v.i >= 0 && v.i < fichas.length) return v;
        if ((v.tipo === 'ia' || v.tipo === 'fuera') && typeof v.texto === 'string' && v.texto) return v;
        return v.tipo === 'ninguna' ? v : respaldo;
      } catch { return respaldo; }
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const q = campo.value.trim();
      if (q.length < 3 || ocupado) return campo.focus();
      // LÍMITE POR SESIÓN: 12 preguntas libres (la barrera de verdad, contra bots, está en el servidor: por IP y con tope de gasto)
      let hechas = 0; try { hechas = Number(sessionStorage.getItem('savvia-preguntas') || 0); } catch {}
      if (hechas >= 12) { campo.value = ''; campo.placeholder = t('Mejor escríbenos por email', 'Better email us'); campo.disabled = true; return; }
      try { sessionStorage.setItem('savvia-preguntas', String(hechas + 1)); } catch {}
      ocupado = true; campo.value = '';
      const local = mejorFicha(q, fichas);
      // se CLONA un intercambio de la página (así trae el ámbito de estilos de Astro, que un innerHTML no llevaría) y se rellena
      const ex = inter[0].cloneNode(true) as HTMLElement;
      ex.className = inter[0].className.replace(/\b(q-on|a-on)\b/g, '').trim() + ' pendiente';
      ex.removeAttribute('data-i'); ex.removeAttribute('data-claves'); ex.removeAttribute('data-ctas');
      ex.querySelector('.tu')!.lastChild!.textContent = q;
      const rp = ex.querySelector<HTMLElement>('[data-respuesta]')!;
      rp.dataset.raw = ''; rp.textContent = '';
      // la pregunta sale en el chat AL INSTANTE; la respuesta se rellena cuando llega (la IA tarda un par de segundos)
      const pendiente = elegir(q, local, turno).then((v) => {
        const mejor = v.tipo === 'escrita' ? v.i : -1;
        rp.dataset.raw = v.tipo === 'ia' || v.tipo === 'fuera' ? v.texto : mejor >= 0 ? fichas[mejor].a : sinRespuesta;
        rp.textContent = rp.dataset.raw;
        if (mejor >= 0 && fichas[mejor].ctas) ex.dataset.ctas = fichas[mejor].ctas;
        if (v.tipo === 'ia' || (v.tipo !== 'fuera' && mejor < 0)) {
          const a = document.createElement('a');
          [...rp.attributes].filter((at) => at.name.startsWith('data-astro-cid')).forEach((at) => a.setAttribute(at.name, ''));
          a.className = 'por-correo'; a.textContent = v.tipo === 'ia' ? t('Respuesta rápida con IA, confirmársela a Eric y Andoni', 'Quick AI answer: have Eric and Andoni confirm it') : t('Mandársela por correo', 'Send it by email');
          a.href = `mailto:${correo}?subject=${encodeURIComponent(t('Una pregunta', 'A question'))}&body=${encodeURIComponent(q)}`;
          rp.after(a);
        }
      });
      conversar(ex, turno, undefined, pendiente); turno = 1 - turno;
    });
    (window as any).__preguntar = (q: string) => { campo.value = q; form.requestSubmit(); };
    (window as any).__faq = (i: number) => raiz.querySelector<HTMLButtonElement>(`[data-q="${i}"]`)?.click();
  }
</script>

<style>
  .caras {
    display: inline-flex;
  }
  .caras img {
    display: block;
    width: calc(var(--spacing) * 12);
    height: calc(var(--spacing) * 12);
    border-radius: var(--radius-full); /* ronda 71: las caras, redondas */
    object-fit: cover;
    background: var(--cara-fondo, color-mix(in oklab, var(--color-niebla) 72%, var(--color-salvia, #96BFE6)));
    box-shadow: 0 0 0 2px var(--bg);
  }
  .caras img + img {
    margin-left: calc(var(--spacing) * -3);
  }
  /* ── LA CONVERSACIÓN · RONDA 69 · «que mantenga la estética sin redondeos de los CTA»: caras, burbujas, sugerencias, campo y botón, rectos; el
     compositor lleva las cruces del CTA */
  .charla {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 6);
    max-height: min(34rem, 64lvh);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 1) calc(var(--spacing) * 2) 0;
  }
  /* los difuminados de arriba y de abajo solo cuando hay conversación por encima o por debajo (al cargar, la primera pregunta se ve entera) */
  .charla {
    --ft: 0px;
    --fb: 0px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 var(--ft), #000 calc(100% - var(--fb)), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 var(--ft), #000 calc(100% - var(--fb)), transparent 100%);
  }
  .charla.desplazada { --ft: calc(var(--spacing) * 6); }
  .charla.hay-mas { --fb: calc(var(--spacing) * 6); }
  .charla::-webkit-scrollbar {
    display: none;
  }
  .intercambio {
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
  }
  :global(html.js) .intercambio.pendiente {
    display: none;
  }
  :global(html.js) .intercambio:not(.a-on) .resp {
    display: none;
  }
  .burbuja {
    padding: calc(var(--spacing) * 3) calc(var(--spacing) * 4);
    font-size: var(--text-ui);
    line-height: 1.45;
    text-wrap: pretty;
  }
  /* tú: a la derecha, en Cacao */
  .burbuja.tu {
    align-self: flex-end;
    max-width: 82%;
    border-radius: 18px 18px 4px 18px;
    background: var(--color-cacao);
    color: var(--color-niebla);
    font-weight: 500;
  }
  /* ellos: a la izquierda, con su cara; burbuja clara con filo */
  .resp,
  .escribiendo {
    display: flex;
    align-items: flex-end;
    gap: calc(var(--spacing) * 3);
    max-width: 92%;
  }
  .escribiendo[hidden] {
    display: none;
  }
  .cara {
    flex: none;
    width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
    border-radius: var(--radius-full);
    object-fit: cover;
    background: var(--cara-fondo, color-mix(in oklab, var(--color-niebla) 72%, var(--color-salvia, #96BFE6)));
  }
  .burbuja.ellos {
    border-radius: 18px 18px 18px 4px;
    background: color-mix(in oklab, #fff 58%, transparent);
    box-shadow: inset 0 0 0 1px var(--rule);
    color: var(--color-cacao);
    font-size: var(--text-body);
  }
  .quien {
    color: var(--fg2);
    margin-bottom: calc(var(--spacing) * 1);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2);
    margin-top: calc(var(--spacing) * 4);
  }
  .cta {
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cacao) 30%, transparent);
    font-size: var(--text-aux);
    font-weight: 500;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
  .cta-1 {
    background: var(--color-cacao);
    color: var(--color-niebla);
    box-shadow: none;
  }
  .cta:hover,
  .cta:focus-visible {
    box-shadow: inset 0 0 0 1px var(--color-cacao);
  }
  .cta-1:hover,
  .cta-1:focus-visible {
    background: color-mix(in oklab, var(--color-cacao) 82%, var(--color-niebla));
  }
  .por-correo {
    display: inline-block;
    margin-top: calc(var(--spacing) * 3);
    font-size: var(--text-ui);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  /* al llegar: la burbuja entra en foco desde abajo */
  .q-on .tu,
  .a-on .resp,
  .escribiendo:not([hidden]) {
    animation: llega 0.55s var(--ease-out-expo) both;
  }
  @keyframes llega {
    from { opacity: 0; translate: 0 10px; filter: blur(6px); }
  }
  .puntos {
    display: flex;
    gap: 5px;
    padding-block: calc(var(--spacing) * 4);
  }
  .puntos i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--fg2);
    animation: punto 1.1s ease-in-out infinite;
  }
  .puntos i:nth-child(2) { animation-delay: 0.15s; }
  .puntos i:nth-child(3) { animation-delay: 0.3s; }
  @keyframes punto {
    0%, 60%, 100% { translate: 0 0; opacity: 0.4; }
    30% { translate: 0 -4px; opacity: 1; }
  }
  /* ── las sugerencias y el compositor */
  .sugeridas {
    margin-top: calc(var(--spacing) * 8);
    padding-top: calc(var(--spacing) * 6);
    border-top: 1px solid var(--rule);
  }
  .sugeridas[hidden] {
    display: none;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--spacing) * 2);
    margin-top: calc(var(--spacing) * 3);
  }
  .chip {
    padding: calc(var(--spacing) * 2) calc(var(--spacing) * 4);
    border-radius: var(--radius-full);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-cacao) 30%, transparent);
    font-size: var(--text-aux);
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
  .chip:hover,
  .chip:focus-visible {
    background: var(--color-cacao);
    color: var(--color-niebla);
    box-shadow: none;
  }
  .compositor {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3); /* ronda 76: vuelven los redondeos: campo en píldora y botón redondo */
    margin-top: calc(var(--spacing) * 6);
  }
  .campo {
    flex: 1;
    min-width: 0;
    min-height: calc(var(--spacing) * 12);
    padding-inline: calc(var(--spacing) * 4);
    border-radius: var(--radius-full);
