    const brisa = (ahora: number) => { reloj = 0; if (!viendo || reducido) return; pintarVerde(xaU, xeU, ahora / 1000); reloj = requestAnimationFrame(brisa); };
    new IntersectionObserver((en) => { viendo = en[0].isIntersecting; if (viendo && !reloj) reloj = requestAnimationFrame(brisa); }).observe(cv);
    sembrar();
    if (reducido) { raiz.classList.add('llegaron'); pintarVerde(1e6, -1e6); }
    // RONDA 144 · Eric: «esta entrada no me convence (hay tomas en las que no somos muy fieles): que aparezcamos los dos directamente». Sin paseo: al
    // asomar la fila, la foto de los dos sube un poco y sale del desenfoque (0,9 s); el paseo de las rondas 11–141 queda en el código, sin usarse.
    const DIRECTO = true;
    if (!reducido && DIRECTO) {
      a.style.opacity = e.style.opacity = '0';
      juntos.style.opacity = '0';
      const io2 = new IntersectionObserver((en) => {
        if (!en[0].isIntersecting) return;
        io2.disconnect();
        juntos.animate(
          [{ opacity: 0, transform: 'translateY(28px)', filter: 'blur(10px)' }, { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' }],
          { duration: 900, easing: 'cubic-bezier(.16,1,.3,1)' },
        );
        juntos.style.opacity = '1';
        raiz.classList.add('llegaron');
        gestos.forEach((g) => g && precargar(g));
