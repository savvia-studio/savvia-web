        const giro = () => CELDAS - 3 + Math.min(2, Math.floor(((lin - 0.9) / 0.055) * 3));
        const ia = lin >= 0.9 ? giro() : Math.floor((xa - xa0) / ((ZANCADA * ESC[0] * ch) / 1000)) % CICLO;
        const ie = lin >= 0.9 ? giro() : Math.floor((xe0 - xe) / ((ZANCADA * ESC[1] * ch) / 1000)) % CICLO;
