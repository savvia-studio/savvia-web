    position: relative;
    height: var(--ch);
    overflow-x: clip; /* ronda 126: por abajo no recorta (ahí va el pie de foto) */
    overflow-y: visible;
    /* ronda 138: aire debajo para que, al acabar el paseo (fila al 70 %), la sección siguiente no asome: ≥ 30 % de la pantalla con el relleno de la sección */
    margin-bottom: max(calc(var(--spacing) * 12), calc(36lvh - var(--space-section)));
