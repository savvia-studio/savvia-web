---
import { langDe } from '../lib/i18n';
import { home } from '../data/idioma';
import { ILUSTRACIONES, GESTOS } from '../data/ilustraciones-equipo';
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { estudio } = home(lang);
const [A, E] = estudio.personas;
---

<!--
  ¿QUIÉNES ESTÁN DETRÁS? (ronda 11). Andoni: «salgamos Eric y yo a cada lado, nos juntemos al centro a medida que sale el titular y luego
  si haces hover en alguno de nosotros, de alguna forma que encaje con la web, salen nuestras descripciones».
  · Los fotogramas son los del zip de Andoni (`tools/andar.cjs` → `public/media/equipo/`): 4 poses de paso + 1 girando, por persona, y
    la pose final de los dos juntos. Andoni entra por la izquierda y Eric por la derecha.
  · Lo mueve el SCROLL (ida y vuelta): la posición sale del progreso de la sección y la POSE sale de lo que han andado (un paso cada
    ~0,2 del ancho de la celda), así nunca patinan. El último 20 % frena; al llegar giran al frente y funden a la pose final.
  · La descripción de cada uno sale con el recurso de la web: la LÍNEA DE LLAMADA (la de «Sentarse»), y el otro se retira.
    Con ratón, al pasar; con teclado, al enfocar; en táctil, al tocar.
  · RONDA 132 · Andoni: «en la versión musical teníamos unos monigotes que se veían más realistas, hay que recuperarlos»: la secuencia v03
    (la de la ronda 95 de la rama `musica`: andoni-paso.webp · eric-paso.webp · juntos-v03.webp), montada como pide su LEEME. Los de la ronda 11
    (andoni.webp · eric.webp) siguen en la carpeta, sin uso.
  · RONDA 137 · Andoni: «te paso la nueva secuencia de andado y otra que funciona al hacer hover. Yo, Andoni, tiro a canasta. Eric hace un revés de
    tenis.» Del storyboard (`tools/r137-equipo/montar.py`): tiras de 9 celdas por persona (8 de paso + llegada de pie, alineadas por el torso y la línea
    de pies), la pose final nueva (juntos-r137.webp, lienzo 384 × 320 del tablero a ×1,5) y 8 fotogramas de gesto por persona en ese mismo lienzo.
    Las figuras del tablero miden ~245 px: se sirven a ×1,5 y el paseo se queda en un tamaño comedido para que no se vean blandas.
  · RONDA 138 · Andoni: «te paso los fotogramas a mayor calidad» (tools/r138-equipo/fuente: tiras a 4×) · «como entramos hay que dejar más aire por
    abajo» · «el titular, con el tamaño del resto de titulares». `tools/r138-equipo/montar.py`: celdas de 504 × 840 (se sirven a ~×2), pose final en DOS
    capas (juntos-andoni.webp + juntos-eric.webp, lienzo 1092 × 840) = el primer fotograma de cada gesto, así el gesto arranca sin salto; las tiras de
    andar se escalan a su último fotograma (de frente) = la pose final. La «05_final_pose_exact_reference» NO se usa: es un recorte de la foto real
    (otro estilo, cortado por los muslos y con Eric casi entero fuera). El paseo acaba con la fila al 70 % de la pantalla y deja aire debajo.
  · RONDA 140 · Andoni descarta los fotogramas generados (r137–139: «las caras se veían mal») y vuelve a los REALES de la ronda 132, ahora desde los
    MASTERS a resolución completa (tools/r140-equipo/fuente/masters, 600 × 1000 por pose, sin ampliar; `tools/r140-equipo/montar.cjs`): tiras de 5 celdas
    (andoni-paso-r140.webp · eric-paso-r140.webp: 4 pasos + llegada) y la pose final conjunta (juntos-r140.webp, 1200 × 1000), montadas como la v03
    (celda = alto × 0,6, pose final = alto × 1,2, centros a 477,253 y 705,270 / 1000; paseo hasta el 94 %, celda 4 desde el 93 %, fundido 96,5–100 %).
    Sin gestos por ahora (`gesto: []`: el gancho queda, sin hacer nada). Lo de las rondas 137–138, en tools/retirados/equipo-r139/.
  · RONDA 254 · Andoni: «quitamos los frames, dejamos a Andoni y Eric parados y cuando hovereamos, las cards que salen acompañadas por ilustraciones» (el
    estilo de su referencia: cómic a línea gruesa con trama de puntos, los objetos SALEN DE LA CABEZA). Fuera los gestos (canasta y pase): los dos, de pie.
    RONDA 259 · «más protagonismo, sin cards ni letras»: al pasar, de la cabeza de cada uno salen GRANDES sus tres objetos (src/data/ilustraciones-equipo.ts),
    se dibujan a tinta y hacen su gesto; las aficiones en texto quedan solo para lectores de pantalla.
  · Con movimiento reducido: la pose final, sin paseo. Los textos de cada uno son FALTA (datos de Andoni y Eric: no se inventan).
-->
<section id="estudio" class="surface-dark section-y relative" aria-label={estudio.pregunta} data-equipo data-sube data-sube-eco>
  <svg class="defs-eq" width="0" height="0" aria-hidden="true"><defs><linearGradient id="papel-eq" gradientUnits="userSpaceOnUse" x1="-20" y1="-10" x2="120" y2="150"><stop offset="0" stop-color="#fdfaf4" /><stop offset="1" stop-color="#e8dfd2" /></linearGradient><linearGradient id="brillo-eq" gradientUnits="userSpaceOnUse" x1="-30" y1="-6" x2="130" y2="142"><stop offset=".26" stop-color="#fff" stop-opacity="0" /><stop offset=".38" stop-color="#fff" stop-opacity=".34" /><stop offset=".47" stop-color="#fff" stop-opacity="0" /><stop offset=".6" stop-color="#fff" stop-opacity=".1" /><stop offset=".66" stop-color="#fff" stop-opacity="0" /></linearGradient><pattern id="trama-eq" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><circle cx="3" cy="3" r="1.45" fill="currentColor" /></pattern></defs></svg>
  <!-- RONDA 191 · Eric: «con todo lo que he contado, ¿cómo reharías el layout?» → DOS COLUMNAS: a la izquierda, alineados a la izquierda como el
       manifiesto, el titular de Andoni y la entradilla (las tres cifras, quitadas el 15/10); a la derecha, Eric y Andoni en 3D con
       sus llamadas y la hierba. En móvil se apila: texto y los dos. -->
  <div class="wrap estudio-grid">
    <div class="lado-texto">
    <h2 class="text-h1 max-w-[15ch] titulo-estudio" data-entra>{estudio.titulo}</h2>
    <p class="text-sub text-fg2 mt-4 lg:mt-6 max-w-[34rem] whitespace-pre-line" data-enfoca style="--d:2">{estudio.texto}</p>
    </div>
    <div class="paseo" data-paseo>
      <!-- RONDA 12 · «Eric y Andoni generan vegetación a su paso hasta juntarse»: hierba, helechos y alguna flor que BROTAN del suelo por
           donde ya han pasado. Un lienzo; cada brizna crece según lo lejos que quedó el que la pisó. Lo mueve el mismo scroll. -->
      <canvas class="verde" aria-hidden="true" data-verde></canvas>
      <!-- RONDA 13: una segunda capa de briznas cortas DELANTE de los pies: los dos quedan dentro de la hierba, no encima -->
      <canvas class="verde delante" aria-hidden="true" data-verde-delante></canvas>
      <!-- RONDA 141 · tiras de 12 poses reconstruidas (tools/r141-equipo/montar.cjs): tamaño y sitio de la celda, en unidades del alto (--ch) -->
      {[A, E].map((p, i) => (
        <i class={`andador ${i ? 'e' : 'a'}`} aria-hidden="true" data-andador={i}
          style={`--src:url('${p.paseo.src}');--w:${(p.paseo.celda * p.paseo.s) / 1000};--h:${(p.paseo.alto * p.paseo.s) / 1000};--top:${p.paseo.arriba / 1000}`}
          data-izq={p.paseo.izq} data-s={p.paseo.s}></i>
      ))}
      <div class="juntos" data-juntos>
        <img class="mitad ma" src="/media/equipo/juntos-r140.webp" alt="" width="1200" height="1000" loading="lazy" decoding="async" />
        <img class="mitad me" src="/media/equipo/juntos-r140.webp" alt={en ? 'Andoni and Eric, standing side by side' : 'Andoni y Eric, de pie, uno junto al otro'} width="1200" height="1000" loading="lazy" decoding="async" />
        <!-- RONDA 129 · Andoni: «que el nombre salga como el de la silla, lo de sentarse, y cuando hagamos hover en uno de los dos cada uno hará
             un gesto característico (los fotogramas llegarán) y saldrán sus hobbies como cayendo de su nombre».
             · Cada uno: un punto en el pecho, la línea a 45° y su nombre (la llamada de «Sentarse»); todo ello es el botón. Andoni, hacia la
               izquierda; Eric, hacia la derecha.
             · Al pasar (ratón), enfocar (teclado) o tocar (dedo): caen sus aficiones del nombre, el otro se retira un poco y, si tiene fotogramas
               (`estudio.personas[].gesto`), se reproduce su gesto sobre su mitad de la pose final.
             · Las mitades de la figura también responden al ratón y al toque (no son botones: el botón es la llamada). -->
        {[A, E].map((p, i) => <span class={`zona z${i}`} aria-hidden="true" data-zona={i}></span>)}
        {
          [A, E].map((p, i) => (
            <div class={`persona p${i}`}>
              <button type="button" class="llamada-q" aria-expanded="false" aria-controls={`aficiones-${i}`} aria-label={en ? `${p.n}: interests` : `${p.n}: sus aficiones`} data-quien={i} data-gesto-src="[]">
                <i class="punto" aria-hidden="true"></i>
                <svg class="linea" viewBox="0 0 120 64" fill="none" aria-hidden="true"><path d="M2 62L58 6H118" pathLength="1" /></svg>
                <span class="nombre detail detail-caps">{p.n}</span>
              </button>
              <ul class="aficiones" id={`aficiones-${i}`} aria-label={en ? `${p.n}'s interests` : `Aficiones de ${p.n}`} data-aficiones={i}>
                {p.hobbies.map((h, k) => (
                  <li style={`--k:${k}`}>
                    {(() => {
                      // ronda 262: la pegatina entera en un SVG (dibujo + nombre a mano), en capas: canto · troquel · tinta · brillo
                      const d = ILUSTRACIONES[p.n as 'Andoni' | 'Eric'][k], t = `<text x="50" y="121" text-anchor="middle" class="t">${h}</text>`;
                      return <svg class="ilu pegatina" data-ilu={GESTOS[p.n as 'Andoni' | 'Eric'][k]} viewBox="-30 -6 160 148" fill="none" stroke="currentColor" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                        set:html={`<g class="canto" transform="translate(0.6 2.6)">${d}${t}</g><g class="troquel">${d}${t}</g><g class="tinta">${d}${t}</g><g class="brillo">${d}${t}</g>`} />;
                    })()}
                    <span class="solo-lectores">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  {
  }
  import { estacionActual } from "../scripts/estacion";
  const raiz = document.querySelector<HTMLElement>('[data-equipo]');
  if (raiz) {
    const paseo = raiz.querySelector<HTMLElement>('[data-paseo]')!, [a, e] = [...raiz.querySelectorAll<HTMLElement>('[data-andador]')];
    const juntos = raiz.querySelector<HTMLElement>('[data-juntos]')!, quienes = [...raiz.querySelectorAll<HTMLButtonElement>('[data-quien]')];
    const zonas = [...raiz.querySelectorAll<HTMLElement>('[data-zona]')], listas = [...raiz.querySelectorAll<HTMLElement>('[data-aficiones]')];
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    // ronda 141 · 12 poses por persona: 9 de paso (1–9, en ciclo, elegidas por lo andado) y 3 de giro a cámara (10–12, atadas al final del paseo).
    // El sitio de la celda a la llegada (izq, en unidades de la foto de 1200 × 1000) y su escala (s: unidades por px nativo) los mide montar.cjs:
    // el 12 cae sobre la figura de la foto (alto + máximo solape), así el fundido a la foto no salta.
    const CICLO = 9, CELDAS = 12, ZANCADA = 42; // px nativos por pose (un ciclo de dos pasos ≈ 380 px de la pose)
    const IZQ = [a, e].map((el) => +el.dataset.izq!), ESC = [a, e].map((el) => +el.dataset.s!);

    // ── RONDA 129 · LAS AFICIONES CAEN DEL NOMBRE. Cada píldora sale del nombre (medido: dx, dy hasta su sitio final), cae acelerando como algo
    //    con peso, se posa SIN rebote (frena en el último tramo) y queda casi recta, con un giro mínimo («nada que reste seriedad»). Al cerrar,
    //    suben un poco y se apagan. Con movimiento reducido, aparecen sin caer.
    const GIRO = [-7, 5, -3, 4, -5]; // ronda 261: pegatinas, ladeadas como pegadas a mano
    const caer = (i: number) => {
      const ul = listas[i], nombre = quienes[i].querySelector<HTMLElement>('.nombre')!;
      ul.getAnimations({ subtree: true }).forEach((an) => an.cancel());
      ul.classList.add('abierta');
      if (reducido) { ul.querySelectorAll('.ilu').forEach((sv) => sv.classList.add('viva')); return; }
      const n = nombre.getBoundingClientRect(), cx = n.left + n.width / 2, cy = n.top + n.height / 2;
      [...ul.children].forEach((li, k) => {
        const r = (li as HTMLElement).getBoundingClientRect(), g = GIRO[k % GIRO.length];
        const dx = cx - (r.left + r.width / 2), dy = cy - (r.top + r.height / 2);
        const t = 620 + k * 60, giro0 = g * 6;
        li.animate(
          [
            { transform: `translate(${dx}px, ${dy}px) rotate(${giro0}deg) scale(.86)`, opacity: 0, easing: 'cubic-bezier(.55,0,.85,.45)' },
            { offset: 0.12, opacity: 1 },
            { offset: 0.74, transform: `translate(0px, -3px) rotate(${g.toFixed(2)}deg) scale(1)`, easing: 'cubic-bezier(.2,.7,.3,1)' },
            { transform: 'translate(0, 0) rotate(0deg) scale(1)', opacity: 1 }, // el giro final lo pone el CSS (`rotate`): sin salto al terminar
          ],
          { duration: t, delay: 40 + k * 110, fill: 'backwards' },
        );
        // ronda 261: PEGATINAS: llegan hechas y, al tocar su sitio, se pegan (un aplastado breve, como al presionarla con el dedo); luego, su gesto
        const peg = li.querySelector<SVGSVGElement>('.pegatina');
        const llega = 40 + k * 110 + t * 0.74;
        // ronda 262: en el aire, la sombra va lejos y difusa; al tocar, se pega (sombra de contacto) y se aplasta un instante, como al presionarla
        peg?.animate([{ filter: 'drop-shadow(0 18px 14px rgb(0 0 0 / .22)) drop-shadow(0 0 0 rgb(0 0 0 / 0))' }, { filter: 'var(--sombra-pegada)' }], { duration: t * 0.74, delay: 40 + k * 110, easing: 'cubic-bezier(.55,0,.85,.45)', fill: 'backwards' });
        peg?.animate([{ transform: 'scale(1)' }, { transform: 'scale(1.06, .92)', offset: 0.35 }, { transform: 'scale(1)' }], { duration: 260, delay: llega, easing: 'cubic-bezier(.2,.7,.3,1)' });
      });
    };
    // ── RONDA 258 · «sorpréndeme con las ilustraciones»: cada una se DIBUJA A TINTA trazo a trazo (como el roble del hero), luego se IMPRIME su trama
    //    y su relleno, y entonces cobra vida con su gesto (CSS, clase .viva): el vapor del café sube, la azada golpea y brota el tallo, el balón gira,
    //    los AirPods suenan, los botones del mando parpadean, el baloncesto deja su estela. Con movimiento reducido, aparecen hechas y quietas.
    const dibujar = (svg: SVGSVGElement, retraso: number) => {
      svg.classList.remove('viva');
      const trazos = [...svg.querySelectorAll<SVGGeometryElement>('path, circle, rect, ellipse')];
      trazos.forEach((el, n) => {
        el.setAttribute('pathLength', '1');
        el.animate([{ strokeDasharray: '1', strokeDashoffset: 1, fillOpacity: 0 }, { offset: 0.7, strokeDashoffset: 0, fillOpacity: 0 }, { strokeDasharray: '1', strokeDashoffset: 0, fillOpacity: 1 }],
          { duration: 760, delay: retraso + n * 55, easing: 'cubic-bezier(.65,0,.35,1)', fill: 'backwards' });
      });
      const fin = retraso + trazos.length * 55 + 760;
      setTimeout(() => { if (svg.closest('.abierta')) svg.classList.add('viva'); }, fin);
    };
    const recoger = (i: number) => {
      listas[i].querySelectorAll('.ilu').forEach((sv) => sv.classList.remove('viva'));
      const ul = listas[i];
      if (!ul.classList.contains('abierta')) return;
      ul.getAnimations({ subtree: true }).forEach((an) => an.cancel());
      if (reducido) { ul.classList.remove('abierta'); return; }
      const ans = [...ul.children].map((li, k) =>
        li.animate([{ opacity: 1 }, { transform: 'translateY(-8px)', opacity: 0 }], { duration: 220, delay: k * 30, easing: 'ease-in', fill: 'forwards' }),
      );
      Promise.all(ans.map((an) => an.finished)).then(() => { ul.classList.remove('abierta'); ans.forEach((an) => an.cancel()); }, () => {});
    };

    // ── EL GESTO (ronda 206: 60 fotogramas por persona a 30 fps; Andoni tira a canasta, Eric da un pase con el pie bajo; tools/r206/montar.cjs). `estudio.personas[i].gesto` = lista de
    //    {src, x, y, w, h}: cada fotograma recortado a su silueta, nativo, y su caja en % de la pose final (montar.cjs: 01 y 12 encajados sobre la foto).
    //    Al pasar / enfocar / tocar: fundido de 120 ms de su mitad de la foto al 01, las 12 poses UNA vez a 11 fps y fundido de 120 ms del 12 a la foto.
    //    Si el puntero se va a mitad, el gesto TERMINA (no se invierte ni se corta); volver a pasar mientras dura no lo reinicia. Cada uno, el suyo.
    //    Con movimiento reducido, no se reproduce. Sonda: window.__gesto(i, f) pinta el fotograma f (−1 = la foto) sin reloj.
    type Marco = { src: string; x: number; y: number; w: number; h: number };
    const FPS = 30, FUNDE = 120; // ronda 206: los gestos nuevos vienen a 30 por segundo (2 s; el primero y el último, la pose de reposo)
    const gestos = quienes.map((b, i) => {
      let src: Marco[] = [];
      try { src = JSON.parse(b.dataset.gestoSrc || '[]'); } catch {}
      if (!src.length) return null;
      const caja = document.createElement('div');
      caja.className = `gesto g${i}`; caja.setAttribute('aria-hidden', 'true');
      juntos.appendChild(caja);
      return { src, caja, imgs: [] as HTMLImageElement[], cargados: null as Promise<unknown> | null, reloj: 0, va: false, saliendo: false };
    });
    const precargar = (g: NonNullable<(typeof gestos)[number]>) =>
      (g.cargados ??= Promise.all(g.src.map((m) => {
        const im = document.createElement('img'); im.alt = ''; im.decoding = 'async'; im.src = m.src;
        Object.assign(im.style, { left: `${m.x}%`, top: `${m.y}%`, width: `${m.w}%`, height: `${m.h}%` });
        g.imgs.push(im); g.caja.appendChild(im);
        return im.decode().catch(() => {});
      })));
    const ver = (g: NonNullable<(typeof gestos)[number]>, f: number) => g.imgs.forEach((im, k) => im.classList.toggle('on', k === f));
    const mitades = [juntos.querySelector<HTMLElement>('.ma')!, juntos.querySelector<HTMLElement>('.me')!];
    // la mitad de la foto se esconde / vuelve SIN transición (el fundido lo hace la capa del gesto, que va encima)
    const mitad = (i: number, oculta: boolean) => {
      const m = mitades[i]; m.style.transition = 'none'; juntos.classList.toggle(`oculta-${i}`, oculta);
      void m.offsetWidth; requestAnimationFrame(() => { m.style.transition = ''; });
    };
    // RONDA 142 · «cerciorarse de que no se reproducen los 2»: nunca dos gestos a la vez. Si se mira al otro mientras el primero aún dura, el segundo
    // ESPERA (pendiente) y arranca cuando el primero empieza su fundido de vuelta a la foto (los dos fundidos de 120 ms se cruzan; nada más).
    let pendiente: number | null = null;
    const ocupado = (i: number) => { const o = gestos[1 - i]; return !!o && o.va && !o.saliendo; };
    const soltarPendiente = () => {
      const k = pendiente; pendiente = null;
      if (k !== null && juntos.dataset.mira === String(k)) tocarGesto(k);
    };
    const tocarGesto = (i: number) => {
      const g = gestos[i]; if (!g || reducido || g.va) return;
      if (ocupado(i)) { pendiente = i; return; }
      precargar(g).then(() => {
        if (g.va || juntos.dataset.mira !== String(i)) return;
        if (ocupado(i)) { pendiente = i; return; }
        g.va = true; g.saliendo = false;
        ver(g, 0);
        juntos.classList.add(`ve-gesto-${i}`);
        // un solo reloj, que empieza en el PRIMER fotograma pintado (no en la promesa: el primer pintado puede tardar). La opacidad de la capa la
        // lleva él (no una transición CSS): la mitad de la foto solo se esconde cuando la capa ya cubre del todo.
        const dura = (g.src.length / FPS) * 1000;
        let t0 = -1, oculta = false, saliendo = false;
        const paso = (ahora: number) => {
          if (t0 < 0) t0 = ahora;
          const t = ahora - t0;
          if (t < FUNDE) { g.caja.style.opacity = String(t / FUNDE); g.reloj = requestAnimationFrame(paso); return; }
          if (!oculta) { g.caja.style.opacity = '1'; mitad(i, true); oculta = true; }
          if (t < FUNDE + dura) {
            ver(g, Math.min(g.src.length - 1, Math.floor(((t - FUNDE) / 1000) * FPS)));
            // (ronda 144: Andoni despegaba con un translateY; ronda 189: los fotogramas nuevos ya traen el salto)
            g.reloj = requestAnimationFrame(paso); return;
          }
          if (!saliendo) { saliendo = true; g.saliendo = true; ver(g, g.src.length - 1); mitad(i, false); soltarPendiente(); } // la foto vuelve DEBAJO del 12, que se funde
          const k = (t - FUNDE - dura) / FUNDE;
          if (k < 1) { g.caja.style.opacity = String(1 - k); g.reloj = requestAnimationFrame(paso); return; }
          g.caja.style.opacity = '0'; juntos.classList.remove(`ve-gesto-${i}`); g.va = false; g.saliendo = false;
        };
        g.reloj = requestAnimationFrame(paso);
      });
    };
    (window as any).__gesto = (i: number, f: number) => {
      const g = gestos[i]; if (!g) return Promise.resolve(false);
      return precargar(g).then(() => {
        cancelAnimationFrame(g.reloj); g.va = false; g.saliendo = false;
        if (f < 0) { mitad(i, false); g.caja.style.opacity = '0'; juntos.classList.remove(`ve-gesto-${i}`); return true; }
        ver(g, f); g.caja.style.opacity = '1'; juntos.classList.add(`ve-gesto-${i}`); mitad(i, true); return true;
      });
    };

    // una abierta cada vez
    let abierta: number | null = null;
    const abrir = (i: number | null) => {
      if (i === abierta) return;
      if (abierta !== null) recoger(abierta); // ronda 141: el gesto en marcha termina solo
      abierta = i;
      if (pendiente !== i) pendiente = null;
      quienes.forEach((b, k) => b.setAttribute('aria-expanded', String(k === i)));
      juntos.dataset.mira = i === null ? '' : String(i);
      if (i !== null) { caer(i); tocarGesto(i); }
    };
    // ronda 128: con el dedo, tocar enfoca (abre) y en el mismo gesto llega el clic: si el foco acaba de abrirla, el clic no la cierra
    let abiertaEn = 0;
    quienes.forEach((b, i) => {
      b.addEventListener('focus', () => { if (raton !== i) { abrir(i); abiertaEn = performance.now(); } });
      b.addEventListener('blur', () => { if (raton === null) abrir(null); });
      b.addEventListener('click', () => { if (performance.now() - abiertaEn < 400) return; abrir(abierta === i ? null : i); });
    });
    // ── RONDA 142 · EL RATÓN: una sola decisión para los dos. Antes cada zona y cada llamada tenía su pointerenter/leave: al pasar de la figura de Eric
    //    a su nombre (otro elemento) saltaba leave → enter y el gesto volvía a empezar «al dejar de hacer hover»; y al cruzar de uno a otro, el
    //    primero aún sonaba cuando arrancaba el segundo. Ahora `.juntos` escucha el movimiento y decide quién está debajo: su llamada (punto, línea y
    //    nombre) cuenta como suya; sobre las figuras manda el TORSO más cercano (frontera a mitad de los dos pechos, 38 % y 54 % de la foto, con un
    //    margen de histéresis para que no parpadee en la raya). Solo un cambio de persona abre o cierra: una vez por entrada.
    const FRONTERA = 0.46, HIST = 0.015;
    let raton: number | null = null;
    const dentro = (r: DOMRect, x: number, y: number) => x >= r.left && x <= r.right && y >= r.top && y <= r.bottom;
    const quienEn = (x: number, y: number): number | null => {
      for (const k of [0, 1]) if (dentro(quienes[k].getBoundingClientRect(), x, y)) return k;
      const j = juntos.getBoundingClientRect(), a0 = zonas[0].getBoundingClientRect(), a1 = zonas[1].getBoundingClientRect();
      if (y < j.top || y > j.bottom || x < a0.left || x > a1.right) return null;
      const f = (x - j.left) / j.width, lim = FRONTERA + (raton === 0 ? HIST : raton === 1 ? -HIST : 0);
      return f < lim ? 0 : 1;
    };
    const mirar = (k: number | null) => { if (k === raton) return; raton = k; abrir(k); };
    juntos.addEventListener('pointermove', (ev) => { if (ev.pointerType === 'mouse') mirar(quienEn(ev.clientX, ev.clientY)); }, { passive: true });
    juntos.addEventListener('pointerleave', (ev) => { if (ev.pointerType === 'mouse') mirar(null); });
    // las mitades de la figura con el dedo: tocar abre (no son botones: no cogen el foco)
    let tipo = '';
    zonas.forEach((z, i) => {
      z.addEventListener('pointerdown', (ev) => { tipo = ev.pointerType; });
      z.addEventListener('click', () => { if (tipo === 'mouse') return; abiertaEn = performance.now(); abrir(abierta === i ? null : i); });
    });
    // con el dedo, tocar fuera de los dos la cierra
    document.addEventListener('pointerdown', (ev) => { if (ev.pointerType !== 'mouse' && abierta !== null && !juntos.contains(ev.target as Node)) abrir(null); }, { passive: true });
    // ── la vegetación (ronda 13 · «tiene que ser mucho más sintetizada con el fondo y orgánica; ahora parece un pegote»):
    //   · COLOR: los de la acuarela del hero (oliva, ocre, hoja seca, nogal), nunca verde saturado; cada brizna con su propia opacidad.
    //   · FORMA: briznas afiladas (un relleno que se estrecha hasta la punta), curvas, de grosor y altura desiguales; en MATAS, no en fila.
    //   · FUNDIDO: sale de una sombra baja del propio Cacao; la punta se aclara y se pierde; los lados del paseo se desvanecen.
    //   · VIDA: brisa lenta (solo mientras se ve y ya brotada); dos capas: detrás de ellos y, muy corta, delante de los pies.
    // RONDA 24 · «que la estela que dejamos Eric y yo se parezca a las ilustraciones del hero y el footer»: en vez de briznas dibujadas, la HIERBA
    // de la acuarela del pie (`/media/pie/hierba.webp`, su franja baja) se destapa por donde ya han pasado, con canto blando; delante de los pies,
    // una franja más corta de la misma lámina. Sin brisa: es una acuarela.
    const cv = raiz.querySelector<HTMLCanvasElement>('[data-verde]')!, cx = cv.getContext('2d')!;
    const cv2 = raiz.querySelector<HTMLCanvasElement>('[data-verde-delante]')!, cx2 = cv2.getContext('2d')!;
    type Brizna = { x: number; h: number; c: number; l: number; w: number; a: number; fase: number; flor: number; delante: boolean };
    let briznas: Brizna[] = [], VW = 0, VH = 0, xaU = -1e6, xeU = 1e6, reloj = 0, avanceU = 0;
    // RONDA 43 · «la estela que dejamos Eric y yo también se tiene que adaptar a las estaciones»: los tonos de las briznas, el resplandor del suelo y
    // las flores de cada estación (en el orden de src/scripts/estacion.ts: otoño · invierno · primavera · verano). Otoño, los de la acuarela.
    const PALETAS: { t: number[][]; suelo: string; flor: [string, string]; pFlor: number }[] = [
      { t: [[112, 106, 58], [150, 128, 70], [136, 96, 58], [99, 64, 47], [168, 150, 92]], suelo: '126,84,60', flor: ['rgba(246,83,64,.55)', 'rgba(229,172,158,.6)'], pFlor: 0.955 },
      { t: [[150, 160, 175], [190, 198, 210], [120, 128, 145], [210, 215, 225], [100, 108, 125]], suelo: '110,118,140', flor: ['rgba(255,255,255,.85)', 'rgba(230,236,245,.8)'], pFlor: 0.9 },
      { t: [[120, 150, 80], [150, 170, 95], [100, 130, 70], [170, 185, 110], [130, 140, 85]], suelo: '150,95,110', flor: ['rgba(199,107,131,.8)', 'rgba(244,201,213,.85)'], pFlor: 0.88 },
      { t: [[90, 125, 65], [120, 145, 75], [75, 105, 55], [160, 150, 80], [103, 131, 77]], suelo: '90,110,70', flor: ['rgba(242,201,90,.8)', 'rgba(255,236,190,.7)'], pFlor: 0.94 },
    ];
    let paleta = PALETAS[estacionActual()], TONOS = paleta.t;
    // RONDA 232 · el cambio de estación de la estela, fluido como el del hero: los tonos viajan de una paleta a otra en 2,4 s (antes, de golpe)
    let virando = 0;
    addEventListener('savvia:estacion', (ev) => {
      const de = TONOS.map((c) => c.slice()), meta = PALETAS[(ev as CustomEvent).detail.n as number], id = ++virando;
      if (reducido) { paleta = meta; TONOS = meta.t; pintarVerde(xaU, xeU, performance.now() / 1000); return; }
      let a = 0;
      const paso = (ahora: number) => {
        if (id !== virando) return;
        if (!a) a = ahora;
        const k = Math.min(1, (ahora - a) / 2400), e = k * k * (3 - 2 * k);
        TONOS = meta.t.map((c, i) => c.map((v, j) => Math.round(de[i][j] + (v - de[i][j]) * e)));
        if (k > 0.5) paleta = meta;
        pintarVerde(xaU, xeU, ahora / 1000);
        if (k < 1) requestAnimationFrame(paso); else TONOS = meta.t;
      };
      requestAnimationFrame(paso);
    });
    const sembrar = () => {
      const r = cv.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2); VW = r.width; VH = r.height;
      for (const [c, x] of [[cv, cx], [cv2, cx2]] as const) { c.width = Math.round(VW * dpr); c.height = Math.round(VH * dpr); x.setTransform(dpr, 0, 0, dpr, 0, 0); }
      let sd = 31; const rnd = () => ((sd = (sd * 1664525 + 1013904223) % 4294967296) / 4294967296);
      briznas = [];
      // matas: centros sembrados; cada mata, un puñado de briznas abiertas en abanico
      // más matas y más altas hacia el centro (donde se juntan); hacia los lados se aclara el prado
      const matas = Math.round(VW / 16); // ronda 29: «que se note más» (27: VW/26)
      for (let m = 0; m < matas; m++) {
        const u = rnd(), mx = u < 0.55 ? VW / 2 + (rnd() + rnd() + rnd() - 1.5) * VW * 0.32 : rnd() * VW;
        const n = 3 + Math.floor(rnd() * 7), alta = (0.45 + rnd() * 0.55) * (0.7 + 0.5 * Math.max(0, 1 - Math.abs(mx / VW - 0.5) * 2.2));
        for (let j = 0; j < n; j++) {
          const alto = rnd(), delante = rnd() < 0.22;
          briznas.push({
            x: mx + (rnd() - 0.5) * 16, h: (delante ? 7 + alto * 12 : 12 + alto * alto * 44) * alta, c: Math.floor(rnd() * TONOS.length),
            l: (rnd() - 0.5) * 1.3 + (j - n / 2) * 0.08, w: 1.1 + rnd() * 1.6, a: 0.6 + rnd() * 0.3, fase: rnd() * 6.28, flor: rnd(), delante,
