  #estudio { padding-block: calc(var(--space-section) + clamp(4rem, 2rem + 7lvh, 7.5rem)); padding-top: max(5rem, calc(var(--space-section) * 0.85)); } /* ronda 215: menos aire arriba (Eric: «hay mucho espacio») */
  .estudio-grid { display: grid; gap: calc(var(--spacing) * 16); align-items: center; }
  .lado-texto { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  @media (width >= 64rem) {
    .estudio-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: calc(var(--spacing) * 12); }
  }
  .paseo {
    --ch: clamp(16rem, 34vw, 26rem); /* alto de la pose final (ronda 141: las poses reconstruidas son nativas, figuras de 333–475 px; a 26rem las figuras miden
