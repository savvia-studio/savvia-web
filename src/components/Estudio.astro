  }
  /* cada andador: una tira de 12 celdas (ronda 141: 9 de paso + 3 de giro); tamaño y sitio en unidades de --ch (montar.cjs); el JS elige la celda */
  .andador {
    position: absolute;
    left: 0;
    top: calc(var(--ch) * var(--top));
