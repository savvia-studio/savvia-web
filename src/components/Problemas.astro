---
import { home } from '../data/idioma';
import { langDe } from '../lib/i18n';
const { problemas } = home(langDe(Astro.currentLocale));
// RONDA 292 · reunión con JL: el manifiesto vive DENTRO de la sección blanca de savvia agentic (`incrustada`): sin fondo propio, mismo efecto cortina
const { incrustada = false } = Astro.props;
// RONDA 186 · la sección 2 como MANIFIESTO (sustituye a Dolores.astro, que queda guardado). Texto de la sesión de narrativa del 21-sep (Drive con José
// Luis). Se ENTINTA LETRA A LETRA, en orden de lectura, atado al scroll (sin fijar nada): de la entrada de la sección a que el final del texto llega a
// media pantalla. Cada palabra va en una pieza que no se parte; la marca ([[…]]) entera. Sin JS o con movimiento reducido: todo a plena tinta.
type Trozo = { t: string; marca: boolean };
const partir = (p: string): Trozo[] =>
  p.replace(/\]\]([.,;:]+)/g, '$1]]').split(/(\[\[.*?\]\])/).filter(Boolean).flatMap((seg): Trozo[] => {
    const marca = seg.startsWith('[[');
    const limpio = seg.replace(/^\[\[|\]\]$/g, '');
    return marca ? [{ t: limpio, marca }] : limpio.split(/\s+/).filter(Boolean).map((t) => ({ t, marca }));
  });
---

<div id="problemas" class:list={['problemas', incrustada ? 'incrustada' : 'surface-dark']} role="group" aria-label={problemas.aria} data-problemas data-sin-fila>
  <div class="wrap">
    <div class="texto text-h2">
      {problemas.parrafos.map((p) => (
        <p>
          <span class="sr-only">{p.replace(/\[\[|\]\]/g, '')}</span>
          {partir(p).map((w) => <><span class="w" aria-hidden="true">{[...w.t].map((c) => <span class="c">{c}</span>)}</span>{' '}</>)}
        </p>
      ))}
    </div>
  </div>
</div>

<style>
  .problemas {
    position: relative;
    padding-block: clamp(6rem, 3rem + 14lvh, 12rem) clamp(14rem, 8rem + 26lvh, 22rem); /* abajo, más que la gota de la sección siguiente (hasta 240 px) */
    /* la mancha de tierra de las raíces sigue aquí, con el centro en la línea de suelo (una altura de raíces más arriba), como hacían los Dolores */
    background-image: radial-gradient(var(--tierra-mancha) at 50% calc(-1 * var(--raices-h)), var(--tierra-paradas));
    background-repeat: no-repeat;
  }
  /* dentro de savvia agentic (fondo claro): sin la mancha de tierra y con el aire justo antes de la ilustración */
  .problemas.incrustada {
    background-image: none;
    padding-block: 0 clamp(1rem, 0.5rem + 3lvh, 2rem);
  }
  .incrustada :global(.wrap) { padding-inline: 0; max-width: none; }
  @media (width >= 48rem) { .problemas.incrustada { padding-bottom: clamp(3rem, 2rem + 6lvh, 6rem); } } /* escritorio: «que respire todo un poco más» (móvil, como estaba) */
  .texto {
    max-width: 14em; /* en em del propio texto: ~28 caracteres por línea (ronda 186: «más estrecho») */
    margin-inline: auto;
    font-family: var(--font-display);
  }
  .texto p + p { margin-top: 1.1em; }
  .w { white-space: nowrap; }
  .c { color: var(--fg); }
  :global(html.anima) .c { opacity: 0.2; }
  /* Frases (ronda 209): su opacidad la lleva el scroll (script), de 0 a 1 antes de entintarse */
  :global(html.anima) .texto p { opacity: 0; transition: opacity 0.35s ease-out; will-change: opacity; }
  @media (prefers-reduced-motion: reduce) {
    .c { opacity: 1 !important; }
    :global(html.anima) .texto p { opacity: 1; transition: none; }
  }
</style>

<script>
  // Frase a frase, atado al scroll: la frase sale de opacidad 0 a 1 y SOLO ENTONCES se entinta letra a letra; luego la siguiente.
  const sec = document.querySelector<HTMLElement>('[data-problemas]');
  const texto = sec?.querySelector<HTMLElement>('.texto');
  if (sec && texto && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ps = [...texto.querySelectorAll<HTMLElement>('p')];
    const grupos = ps.map((p) => [...p.querySelectorAll<HTMLElement>('.c')]);
    const FADE = 40, BLANDO = 10;
    const pesos = grupos.map((g) => FADE + g.length + BLANDO);
    const total = pesos.reduce((a, b) => a + b, 0);
    const ops = grupos.map((g) => new Float32Array(g.length).fill(0.2));
    const opP = ps.map(() => -1);
    let ini = 0, fin = 1, pedido = false;
    // Histéresis: al subir, el deshacer espera a que el texto haya bajado ~25 % de la pantalla (el avance se congela ese tramo).
    let off = 0, ult = scrollY;
    const alScroll = () => {
      const d = scrollY - ult; ult = scrollY;
      const gap = innerHeight * 0.03;
      off = d < 0 ? Math.min(gap, off - d) : Math.max(0, off - d * 0.5);
      pedir();
    };
    const medir = () => {
      const r = texto.getBoundingClientRect(), y = r.top + scrollY;
      ini = y - innerHeight * 0.8;
      fin = y + r.height - innerHeight * 0.8;
    };
    const pintar = () => {
      pedido = false;
      const t = Math.min(1, Math.max(0, (scrollY + off - ini) / Math.max(1, fin - ini))) * total;
      let base = 0;
      grupos.forEach((g, i) => {
        const l = t - base;
        base += pesos[i];
        const u = Math.min(1, Math.max(0, l / FADE)), f = Math.round(u * u * u * (u * (6 * u - 15) + 10) * 1000) / 1000; // smootherstep
        if (f !== opP[i]) { opP[i] = f; ps[i].style.opacity = String(f); }
        const n = Math.max(0, l - FADE);
        for (let k = 0; k < g.length; k++) {
          const o = Math.round((0.2 + 0.8 * Math.min(1, Math.max(0, (n - k) / BLANDO))) * 50) / 50;
          if (o !== ops[i][k]) { ops[i][k] = o; g[k].style.opacity = String(o); }
        }
      });
    };
    const pedir = () => { if (!pedido) { pedido = true; requestAnimationFrame(pintar); } };
    const remedir = () => { medir(); pedir(); };
    addEventListener('scroll', alScroll, { passive: true });
    addEventListener('resize', remedir);
    document.fonts?.ready.then(remedir);
    new ResizeObserver(remedir).observe(document.body);
    remedir();
  }
</script>
