---
import { problemas } from '../data/home';
// RONDA 186 · la sección 2 como MANIFIESTO (sustituye a Dolores.astro, que queda guardado). Texto de la sesión de narrativa del 21-sep (Drive con José
// Luis). Se ENTINTA LETRA A LETRA, en orden de lectura, atado al scroll (sin fijar nada): de la entrada de la sección a que el final del texto llega a
// media pantalla. Cada palabra va en una pieza que no se parte; la marca ([[…]]) entera. Sin JS o con movimiento reducido: todo a plena tinta.
type Trozo = { t: string; marca: boolean };
const partir = (p: string): Trozo[] =>
  p.replace(/\]\]([.,;:]+)/g, '$1]]').split(/(\[\[.*?\]\])/).filter(Boolean).flatMap((seg): Trozo[] => {
    const marca = seg.startsWith('[[');
    const limpio = seg.replace(/^\[\[|\]\]$/g, '');
    return marca ? [{ t: limpio, marca }] : limpio.split(/\s+/).filter(Boolean).map((t) => ({ t, marca }));
  });
---

<section id="problemas" class="problemas surface-dark" aria-label={problemas.aria} data-problemas data-sin-fila>
  <div class="wrap">
    <div class="texto text-h2">
      {problemas.parrafos.map((p) => (
        <p aria-label={p.replace(/\[\[|\]\]/g, '')}>
          {partir(p).map((w) => <><span class="w" aria-hidden="true">{[...w.t].map((c) => <span class="c">{c}</span>)}</span>{' '}</>)}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  .problemas {
    position: relative;
    padding-block: clamp(6rem, 3rem + 14lvh, 12rem) clamp(14rem, 8rem + 26lvh, 22rem); /* abajo, más que la gota de la sección siguiente (hasta 240 px) */
    /* la mancha de tierra de las raíces sigue aquí, con el centro en la línea de suelo (una altura de raíces más arriba), como hacían los Dolores */
    background-image: radial-gradient(var(--tierra-mancha) at 50% calc(-1 * var(--raices-h)), var(--tierra-paradas));
    background-repeat: no-repeat;
  }
  .texto {
    max-width: 14em; /* en em del propio texto: ~28 caracteres por línea (ronda 186: «más estrecho») */
    margin-inline: auto;
    font-family: var(--font-display);
  }
  .texto p + p { margin-top: 1.1em; }
  .w { white-space: nowrap; }
  .c { color: var(--fg); }
  :global(html.anima) .c { opacity: 0.2; }
  @media (prefers-reduced-motion: reduce) {
    .c { opacity: 1 !important; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-problemas]');
  const texto = sec?.querySelector<HTMLElement>('.texto');
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (sec && texto && !reducido) {
    const cs = [...texto.querySelectorAll<HTMLElement>('.c')];
    const N = cs.length, BLANDO = 14; // letras en la franja que se va entintando
    const ops = new Float32Array(N).fill(0.2);
    let ini = 0, fin = 1;
    const medir = () => {
      const r = texto.getBoundingClientRect(), y = r.top + scrollY;
      ini = y - innerHeight * 0.8;            // empieza cuando el texto asoma al 80 % de la pantalla
      fin = y + r.height - innerHeight * 0.62; // acaba cuando su final llega al 62 % (antes de que asome la sección siguiente)
    };
    let pedido = false;
    const pintar = () => {
      pedido = false;
      const p = Math.min(1, Math.max(0, (scrollY - ini) / Math.max(1, fin - ini)));
      const n = p * (N + BLANDO);
      for (let i = 0; i < N; i++) {
        const k = Math.min(1, Math.max(0, (n - i) / BLANDO));
        const o = Math.round((0.2 + 0.8 * k) * 50) / 50;
        if (o !== ops[i]) { ops[i] = o; cs[i].style.opacity = String(o); }
      }
    };
    const pedir = () => { if (!pedido) { pedido = true; requestAnimationFrame(pintar); } };
    const io = new IntersectionObserver((es) => {
      if (es[0].isIntersecting) { addEventListener('scroll', pedir, { passive: true }); pedir(); }
      else { removeEventListener('scroll', pedir); pedir(); }
    }, { rootMargin: '20% 0px' });
    const remedir = () => { medir(); pedir(); };
    medir(); io.observe(sec);
    addEventListener('resize', remedir);
    document.fonts?.ready.then(remedir);
    new ResizeObserver(remedir).observe(document.body);
  }
</script>
