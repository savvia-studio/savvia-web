// 28/10 · /en/storybook: lo mismo en inglés, al lado (por página y por id de pieza); los archivos y las rutas no se traducen
import { langDe, ruta } from '../../lib/i18n';
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const PAGINA_EN: Record<string, string> = { Inicio: 'Home', 'En todas las páginas': 'On every page', Portfolio: 'Portfolio', 'Caso de estudio': 'Case study', Lab: 'Lab', Manifiesto: 'Manifesto', '404': '404' };
const ESTS_EN: Record<string, string> = { otono: 'Autumn', invierno: 'Winter', primavera: 'Spring', verano: 'Summer' };
const PIEZA_EN: Record<string, { nombre: string; que: string; de: string }> = {
  'inicio-hero': { nombre: 'Hero', que: 'Headline and subtitle over the oak of the season, which the tree engine draws and paints from where the drop falls. In the frame, the time and “since 2020”.', de: 'Copy in src/data/home.ts › hero, illustration in public/media/hero/, engine in src/scripts/estela.ts.' },
  'inicio-raices': { nombre: 'Roots', que: 'The roots of the oak below the ground line, painted once in the season of the website: the step from the hero to what lies beneath.', de: 'Illustration of the season in public/media/hero/, painted with src/scripts/estela.ts.' },
  'inicio-proyectos': { nombre: 'Featured projects', que: 'The studio desk: standing, the monitor shows the reel of the season on a silent loop; when you sit down, the camera moves in and you walk through the real website of each project built with agentic development. On mobile, its video.', de: 'Projects in src/data/home.ts › proyectos.nuevos, illustrations in public/media/estudio/, reel in public/media/reel/.' },
  'inicio-agentic': { nombre: 'savvia agentic', que: 'It opens with the manifesto, which inks itself letter by letter as you scroll; then, the Neety library used in real time: the agents pick up its pieces and build the page in front of you.', de: 'src/data/home.ts › problemas and partitura (with its libreria).' },
  'inicio-mas-proyectos': { nombre: 'More projects', que: 'The project mosaic, each piece in the gradient of its brand with the website that plays on hover; a button on each piece changes its scene (browser, desk or mobile) and a click opens the viewer. After the first five, the grid of quotes, logos and figures takes up a whole row.', de: 'src/data/home.ts › proyectos.anteriores, cells and testimonials, src/data/proyectos.ts, videos in public/media/anteriores/.' },
  'inicio-servicios': { nombre: 'Services', que: 'The three ways of working with you; when you pick one, a cursor ticks off on the card the points it includes.', de: 'src/data/home.ts › servicios (list and groups).' },
  'inicio-estudio': { nombre: 'Eric and Andoni', que: 'The two of them, standing together; when you hover over each one, their three hobbies, drawn in ink, come out of their head, large. The only section in the first person.', de: 'src/data/home.ts › estudio, src/data/ilustraciones-equipo.ts, poses in public/media/equipo/.' },
  'inicio-preguntas': { nombre: 'Questions', que: 'The frequently asked questions as a conversation: suggestions and a free question, answered by Eric and Andoni.', de: 'src/data/home.ts › preguntas.' },
  'inicio-pie': { nombre: 'Footer', que: 'The landscape of the season is drawn after the drop of the logo; “Contact us” sits between the mountains and opens on hover.', de: 'src/data/home.ts › pie and nav, layers in public/media/pie/. It is the same on every page.' },
  'comun-menu': { nombre: 'Bar and menu', que: 'Logo, the radio (five bars that dance with what is playing), the season icon and the grid that opens the menu in a card, with the reel in miniature.', de: 'src/data/home.ts › nav, reel by season and language in src/scripts/reel.ts and public/media/reel/.' },
  'comun-carga': { nombre: 'Loader', que: 'Only on the first visit: the visitor draws a circle, the circle gathers into a drop and the drop falls to the foot of the oak, where the hero is born.', de: '`?carga=1` forces it so it can be reviewed; it does not show in automated browsers.' },
  'comun-chat': { nombre: 'Chat', que: 'Prototype. A glass button at the bottom right opens a guided brief (End-to-end, Collaboration, Consulting) and free questions. It hides in the hero, with the menu open, when seated and next to Questions. `?chat=0` removes it.', de: 'src/data/home.ts › pie (email and calendar) and estudio (the faces).' },
  'portfolio-todos': { nombre: 'All projects', que: '“Custom websites.” and, below it, the row of filters (country, technology, service and category), which sticks to the top as you scroll. All the projects one after another, each in its own form (browser, desk or mobile, with its button to change it).', de: 'src/data/proyectos.ts and src/data/portfolio-orden.json (order, forms and settings for each piece); the filters go in the address (?pais, ?tec…).' },
  'portfolio-mentor': { nombre: 'Mentor', que: 'Every eleven projects, a mentor across the full width: their charcoal portrait draws itself and the quote rises word by word. The same component closes each case study.', de: 'src/data/home.ts › proyectos.testimonios, portraits in public/media/testimonios/.' },
  'portfolio-visor': { nombre: 'Viewer', que: 'When you open a piece, the studio desk at full size with the project website on the monitor, always on the desk; arrows to move on to the next one.', de: 'Desk illustration at 5120 px in public/media/estudio/, large video of each project in public/media/obra/.' },
  'caso-cabecera': { nombre: 'Case header', que: 'The fixed column on the left: name, the idea in grey, the standfirst, services, sector and location, the link to the website and, at the bottom, previous and next. On the right, the case, with a ring that measures how much you have read.', de: 'src/data/proyectos.ts (one entry per project).' },
