  'manifiesto-portada': { nombre: 'Cover', que: '“Manifesto” and the sprouting acorn of the season, drawn with the tree engine.', de: 'Illustrations in public/media/manifiesto/.' },
  'manifiesto-texto': { nombre: 'The text', que: 'The opening with the drop cap and six paragraphs that ink themselves as you read: what savvia is, the problem, how we start (from within, like sap), what we deliver to you, the guardrails and the close; at the end, the savvia signature.', de: 'src/data/manifiesto.ts (and manifiesto.en.ts) › entrada and capitulos.' },
  '404': { nombre: 'The weather on top', que: 'The 404 in large type and, on top, the weather of the season: leaves, snow, flowers or grass that settle.', de: 'Copy in the page itself.' },
};
const L = (p: Pieza) => (en && PIEZA_EN[p.id] ? { ...p, ...PIEZA_EN[p.id] } : p);
---

<section id="catalogo" class="seccion" aria-labelledby="h-catalogo">
  <h2 id="h-catalogo" class="font-display text-h2">{en ? <>Section catalogue</> : <>Catálogo de secciones</>}</h2>
  {en ? <p class="cat-intro">
    Each piece of the website, captured from the real website: how it looks, which file it lives in and where its content comes from. The thumbnails are rebuilt with
    {" "}<span class="detail">node tools/r180/miniaturas.cjs</span>.
  </p> : <p class="cat-intro">
    Cada pieza de la web, capturada de la web real: cómo se ve, en qué archivo vive y de dónde sale su contenido. Las miniaturas se rehacen con
    {" "}<span class="detail">node tools/r180/miniaturas.cjs</span>.
  </p>}

  {
    GRUPOS.map((g) => (
      <div class="cat-grupo">
        <h3 class="cat-pag">
          {en ? PAGINA_EN[g.pagina] ?? g.pagina : g.pagina}
          {g.ruta && <a class="detail cat-ruta" href={ruta(lang, g.ruta)}>{ruta(lang, g.ruta)}</a>}
        </h3>
        <ul class="cat-rej">
          {g.piezas.map(L).map((p) => (
            <li class="cat-tarjeta">
              {p.video ? (
                <figure class="cat-vid" data-cat-vid={VID[p.id]}>
                  <video class="cat-mini" src={`/media/sistema/catalogo/video/${VID[p.id]}-otono.mp4`} poster={`/media/sistema/catalogo/video/${VID[p.id]}-otono.jpg`} muted loop playsinline preload="none" aria-label={en ? `${p.nombre}, in motion` : `${p.nombre}, en movimiento`} data-cat-v></video>
                  <div class="cat-est" role="radiogroup" aria-label={en ? `See ${p.nombre} in` : `Ver ${p.nombre} en`}>
                    {ESTS.map(([e, n], k) => <button type="button" role="radio" aria-checked={k === 0 ? 'true' : 'false'} data-cat-est={e}>{en ? ESTS_EN[e] : n}</button>)}
                  </div>
                </figure>
              ) : (
                <img class="cat-mini" src={`/media/sistema/catalogo/${p.id}.webp`} alt={en ? `Screenshot of ${p.nombre}` : `Captura de ${p.nombre}`} width="1200" height="750" loading="lazy" decoding="async" />
              )}
              <div class="cat-texto">
                <p class="cat-nombre">{p.nombre}</p>
                <p class="detail cat-archivo">{p.archivo}</p>
                <p class="cat-que">{p.que}</p>
                <p class="cat-de">{p.de}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<script>
  // 28/10 · el pie y el 404 en movimiento: suenan (mudos) solo a la vista; cuatro botones los pasan por las estaciones sin cambiar la de la página
  {
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLElement>('[data-cat-vid]').forEach((fig) => {
      const v = fig.querySelector<HTMLVideoElement>('[data-cat-v]')!, base = fig.dataset.catVid!;
      let visto = false;
      new IntersectionObserver(([e]) => { visto = e.isIntersecting; if (visto && !quieto) v.play().catch(() => {}); else v.pause(); }, { rootMargin: '10% 0px' }).observe(fig);
      fig.querySelectorAll<HTMLButtonElement>('[data-cat-est]').forEach((b) => b.addEventListener('click', () => {
        const e = b.dataset.catEst!;
        fig.querySelectorAll('[data-cat-est]').forEach((x) => x.setAttribute('aria-checked', String(x === b)));
        v.poster = `/media/sistema/catalogo/video/${base}-${e}.jpg`; v.src = `/media/sistema/catalogo/video/${base}-${e}.mp4`;
        if (visto && !quieto) v.play().catch(() => {});
      }));
    });
  }
</script>

<style>
  /* Los valores, los de Libro.astro (sus estilos son de ámbito y no llegan aquí) */
  .seccion { padding-top: calc(var(--spacing) * 24); margin-top: calc(var(--spacing) * 24); border-top: 1px solid var(--rule); scroll-margin-top: calc(var(--spacing) * 20); }
  .cat-intro { margin-top: calc(var(--spacing) * 4); max-width: 60ch; font-size: var(--text-body); line-height: 1.6; color: var(--fg2); text-wrap: pretty; }
  .cat-grupo { margin-top: calc(var(--spacing) * 16); }
  .cat-grupo:first-of-type { margin-top: calc(var(--spacing) * 12); }
  .cat-pag { display: flex; align-items: baseline; gap: calc(var(--spacing) * 3); padding-bottom: calc(var(--spacing) * 3); border-bottom: 1px solid var(--rule); font-family: var(--font-display); font-size: var(--text-h3); line-height: var(--text-h3--line-height); font-weight: 400; }
  .cat-ruta { color: var(--fg2); text-decoration: none; }
  .cat-ruta:hover { color: var(--fg); }
  .cat-rej { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--spacing) * 12) calc(var(--spacing) * 6); margin: calc(var(--spacing) * 8) 0 0; padding: 0; list-style: none; }
