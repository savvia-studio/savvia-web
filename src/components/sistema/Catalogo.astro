    piezas: [
      { id: 'lab', nombre: 'La mesa del lab', archivo: 'src/components/lab/Mesa.astro', que: 'Un lienzo sin fin que se arrastra: la tarjeta de cristal de savvia lab, raíces hacia cada experimento y el fondo a elegir. Cada experimento se abre en grande, con el enlace a su web.', de: 'src/data/lab.ts (experimentos y mundo), vídeos en public/media/lab/.' },
