  .ci-e.on .ci-pto { background: var(--s); box-shadow: 0 0 0 4px var(--carta), 0 0 0 9px color-mix(in oklab, var(--s) 22%, transparent); }
  .ci-n { margin-top: calc(var(--spacing) * 8); font-size: var(--text-h3); line-height: var(--text-h3--line-height); }
  .ci-savia { margin-top: calc(var(--spacing) * 3); font-size: var(--text-body); line-height: 1.6; text-wrap: pretty; }
  .ci-proy { margin-top: calc(var(--spacing) * 6); font-size: var(--text-aux); line-height: 1.6; color: var(--fg2); text-wrap: pretty; }
