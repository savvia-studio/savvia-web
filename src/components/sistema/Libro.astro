              <div class="ic-c"><span class="ic-ondas" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span><span class="detail">música, la radio de la barra</span><span class="detail ic-p">propio</span></div>
              <div class="ic-c"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H11l-4.2 3.2v-3.2H6.5a2 2 0 0 1-2-2z" /></svg><span class="detail">chat</span><span class="detail ic-p">trazo</span></div>
              <div class="ic-c"><Fragment set:html={icono('caret-right')} /><span class="detail">enviar</span><span class="detail ic-p">trazo</span></div>
              <div class="ic-c"><Fragment set:html={icono('caret-down')} /><span class="detail">plegar el chat</span><span class="detail ic-p">trazo</span></div>
