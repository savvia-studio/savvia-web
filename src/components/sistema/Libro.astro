  @keyframes ci-activo { 0% { opacity: 0.3; scale: 0.82; animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1); } 6%, 22% { opacity: 1; scale: 1; animation-timing-function: ease-in-out; } 28%, 100% { opacity: 0.3; scale: 0.82; } }
