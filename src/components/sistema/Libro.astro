                  <span class="v-sem"><i /><i /><i /></span>
                  <span class="v-tab on"><img class="v-fav" src="/favicon-otono.png?v=226" data-est-src="/favicon-{est}.png?v=226" alt="" width="16" height="16" /><span class="v-tit">{en ? <>savvia: AI with judgement</> : <>savvia: IA con criterio</>}</span><Fragment set:html={icono('x', 'regular', 'v-x')} /></span>
                  <span class="v-tab"><img class="v-fav" src="/favicon-otono.png?v=226" data-est-src="/favicon-{est}.png?v=226" alt="" width="16" height="16" /><span class="v-tit">{en ? <>savvia projects</> : <>Proyectos de savvia</>}</span><Fragment set:html={icono('x', 'regular', 'v-x')} /></span>
                  <span class="v-mas"><Fragment set:html={icono('plus')} /></span>
                </div>
                <div class="v-dir"><span>savvia.studio</span></div>
