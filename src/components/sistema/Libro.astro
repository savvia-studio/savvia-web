const ESCALA_EN: [string, string][] = [
  ['H1', 'We elevate your website'], ['H2', 'We elevate your website'], ['H3', 'We elevate your website'],
  ['Lead', 'Specialists in orchestrating agentic development.'], ['Subtitle', 'Specialists in orchestrating agentic development.'],
