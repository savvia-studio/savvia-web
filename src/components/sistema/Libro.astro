  .ciclo.cartas .ci-roble { opacity: 1; filter: none; scale: 1; width: 100%; }
  .ciclo.cartas .ci-n { margin: calc(var(--spacing) * 2) calc(var(--spacing) * 6) 0; font-size: 1.375rem; line-height: 1.2; color: inherit; }
  .ciclo.cartas .ci-savia { margin: calc(var(--spacing) * 2) calc(var(--spacing) * 6) 0; font-size: var(--text-aux); color: color-mix(in srgb, var(--ci-tinta) 80%, transparent); max-width: 34ch; }
  .ciclo.cartas .ci-proy { margin: calc(var(--spacing) * 2) calc(var(--spacing) * 6) 0; font-size: var(--text-aux); color: color-mix(in srgb, var(--ci-tinta) 66%, transparent); max-width: 34ch; }
  .ciclo.cartas .ci-proy b { display: inline; margin: 0 0.35em 0 0; font-weight: 500; color: inherit; }
  /* invierno es nieve sobre el fondo: su filo va en una capa POR ENCIMA del roble (la imagen, con su fondo de nieve, tapaba la sombra interior al crecer)
     y, donde el anillo muerde su esquina, el contorno del hueco lleva el mismo trazo (.ci-a-filo) */
  .ciclo.cartas .ci-e[data-ci='3']::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; box-shadow: inset 0 0 0 1px rgb(34 48 62 / 0.12); pointer-events: none; }
  .ci-a-filo { fill: none; stroke: rgb(34 48 62 / 0.12); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .ciclo.cartas .ci-vuelta { position: static; translate: none; margin-top: calc(var(--spacing) * 6); }
