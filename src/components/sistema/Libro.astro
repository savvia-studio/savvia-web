                  <span class="pf-boton">{en ? <>Follow</> : <>Seguir</>}</span>
                </div>
              </div>
              <figcaption class="detail apl-pie">{en ? <>Social profile, background and avatar of the season</> : <>Perfil en redes, fondo y avatar de la estación</>}</figcaption>
            </figure>
            <figure class="apl-p apl-chat">
              <div class="chat" aria-hidden="true">
                <p class="burbuja yo">{en ? <>Shall I send you the website of the people making our new one?</> : <>¿Te paso la web de los que nos van a hacer la nueva?</>}</p>
                <div class="burbuja yo enlace">
                  <img src="/media/sistema/aplicaciones/og-otono.jpg" data-est-src="/media/sistema/aplicaciones/og-{est}.jpg" alt="" width="1200" height="630" loading="lazy" decoding="async" />
                  <span class="en-t">{en ? <>savvia: AI with judgement</> : <>savvia: IA con criterio</>}</span>
