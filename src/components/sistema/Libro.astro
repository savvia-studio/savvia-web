    .rg { -webkit-mask: none; mask: none; }
    .cp { clip-path: none; }
    .est-cic i:first-child { opacity: 1; }
  }

  /* ── APLICACIONES */
  .app { place-items: center; }
  .og { width: 84%; height: auto; border-radius: 8px; box-shadow: 0 18px 40px -22px rgb(48 32 24 / 0.6); }
