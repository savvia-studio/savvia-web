  .m-hijos { margin: calc(var(--spacing) * 3) 0 0 calc(var(--spacing) * 2); padding-left: calc(var(--spacing) * 3); border-left: 1px solid var(--rule); display: flex; flex-direction: column; gap: calc(var(--spacing) * 2); }
  .m-hijos li { position: relative; font-size: var(--text-aux); line-height: 1.35; color: var(--fg2); }
  .m-hijos li::before { content: ''; position: absolute; left: calc(var(--spacing) * -3); top: 0.7em; width: calc(var(--spacing) * 2); border-top: 1px solid var(--rule); }
