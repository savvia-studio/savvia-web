      camino.setAttribute('d', d + 'Z');
      const activo = Math.min(n - 1, Math.max(0, Math.floor(u / PASO)));
      const fin = Math.min(1, Math.max(0, (u - total + 0.6) / 0.6));
      Q.forEach((q, i) => {
        const v = vis[i], on = i === activo && fin < 1;
        v.q.setAttribute('x', String(q.p[0] - 0.75)); v.q.setAttribute('y', String(q.p[1] - 0.75)); v.q.setAttribute('width', '1.5'); v.q.setAttribute('height', '1.5');
        v.q.classList.toggle('on', on);
