  .pt-tab { display: inline-flex; align-items: center; gap: calc(var(--spacing) * 2); max-width: 100%; padding: calc(var(--spacing) * 2) calc(var(--spacing) * 3); border-radius: 8px 8px 0 0; background: #f6f1f4; font-size: 0.8125rem; white-space: nowrap; overflow: hidden; }
