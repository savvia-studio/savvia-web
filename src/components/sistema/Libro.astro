  if (op === 'nota') return `${T0}<tr><td style="font-size:15px;line-height:22px;color:#3B231B;"><b style="font-weight:600;">${nombre}</b><span style="color:${GRIS};">, savvia</span></td></tr>${lin('Desarrollo agéntico, Donostia', `font-size:13px;line-height:20px;color:${GRIS};`)}${lin(web)}<tr><td style="padding:14px 0 0 0;"><table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;"><tr><td style="padding:0 10px 0 0;vertical-align:middle;">${img(base, 'mini-{est}', 40, 40)}</td><td style="vertical-align:middle;font-size:12px;line-height:17px;color:${GRIS};">{nota}</td></tr></table></td></tr></table>`;
  if (op === 'lado') return `${T0}<tr><td style="padding:0 14px 0 0;vertical-align:middle;">${img(base, 'roble', 64, 57)}</td><td style="vertical-align:middle;"><table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">${lin(nombre)}${lin(web)}</table></td></tr></table>`;
  if (op === 'trazos') return `${T0}<tr><td style="padding:0 0 8px 0;">${img(base, 'trazos', 75, 47)}</td></tr>${lin(nombre)}${lin(web)}</table>`; // 24/10, 5.ª: más pequeños, con cuerpo e inclinados, como una rúbrica
  if (op === 'trazos-izq') return `${T0}<tr><td style="padding:0 14px 0 0;vertical-align:middle;">${img(base, 'trazos', 75, 47)}</td><td style="vertical-align:middle;"><table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">${lin(nombre)}${lin(web)}</table></td></tr></table>`; // 24/10, 7.ª
  if (op === 'trazos-der') return `${T0}<tr><td style="vertical-align:middle;"><table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">${lin(nombre)}${lin(web)}</table></td><td style="padding:0 0 0 14px;vertical-align:middle;">${img(base, 'trazos', 75, 47)}</td></tr></table>`;
  if (op === 'color') return `${T0}<tr><td style="padding:0 0 8px 0;">${img(base, 'mini-{est}', 64, 64)}</td></tr>${lin(nombre)}${lin(web)}</table>`; // 24/10, 5.ª: el roble pequeño de la estación (el del favicon), sin trazos
  if (op === 'avatar') return `${T0}<tr><td style="padding:0 14px 0 0;vertical-align:middle;">${img(base, 'avatar-{est}', 56, 56)}</td><td style="vertical-align:middle;"><table cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">${lin(nombre, 'font-weight:600;')}${lin(web)}</table></td></tr></table>`;
