  .liq::before { content: ''; position: absolute; z-index: -1; left: 10%; top: 50%; width: 260%; aspect-ratio: 1; border-radius: 47% 53% 44% 56% / 55% 45% 57% 43%; background: #302018; transform: translate(-50%, -50%) scale(0); transition: transform 0.7s cubic-bezier(0.33, 1, 0.68, 1); }
