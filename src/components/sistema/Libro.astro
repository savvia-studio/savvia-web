<script>
  import { jugar } from '../../scripts/jugar';
  import { fijarEstacion, estacionActual, EST, NOCHE } from '../../scripts/estacion';
  import { crearEstela } from '../../scripts/estela';
  import { caerRealista } from '../../scripts/gota';
  import { brotar } from '../../scripts/brotar';
  import { t as tr } from '../../scripts/i18n';
  // 24/10 · las imágenes que eran de otoño siguen a la estación de la página (data-est-src lleva {est}); al cargar y en cada cambio
  const ponerImgEst = () => { const e = EST[estacionActual()] ?? 'otono'; document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-est-src]').forEach((i) => { const v = i.dataset.estSrc!.replaceAll('{est}', e); if (i.getAttribute('src') === v) return; const enMarcha = i instanceof HTMLVideoElement && !i.paused; i.src = v; if (enMarcha) (i as HTMLVideoElement).play().catch(() => {}); }); };
  ponerImgEst(); addEventListener('savvia:estacion', ponerImgEst);
  // Firma de correo · el selector de opciones: cambia las dos firmas, lo que copian y la del correo de ejemplo (se recuerda en este navegador)
  const opc = document.querySelector<HTMLElement>('.dl-opc');
  if (opc) {
    const NEST: Record<string, string> = tr({ otono: 'otoño', invierno: 'invierno', primavera: 'primavera', verano: 'verano' }, { otono: 'autumn', invierno: 'winter', primavera: 'spring', verano: 'summer' });
    // Nota de campo: el pie de la firma, uno por estación (el roble es el de la portada de esa estación)
    const NOTA: Record<string, string> = tr({
      otono: '* El roble de nuestra portada, en otoño.<br>Donostia.',
      invierno: '* El roble de nuestra portada, sin hojas.<br>Invierno en Donostia.',
      primavera: '* El roble de nuestra portada, rebrotando.<br>Primavera en Donostia.',
      verano: '* El roble de nuestra portada, en verano.<br>Donostia.',
    }, {
      otono: '* The oak on our cover, in autumn.<br>Donostia.',
      invierno: '* The oak on our cover, without leaves.<br>Winter in Donostia.',
      primavera: '* The oak on our cover, budding again.<br>Spring in Donostia.',
      verano: '* The oak on our cover, in summer.<br>Donostia.',
    });
    const CRUDO = opc.dataset.firmaOps!;
    // las opciones que llevan el roble de la estación ({est}) se rehacen con la de ese momento: al cargar y cada vez que la página cambia de estación
    const deEstacion = (): Record<string, [string, string][]> => { const est = EST[estacionActual()] ?? 'otono'; return JSON.parse(CRUDO.replaceAll('{estn}', NEST[est] ?? 'otoño').replaceAll('{nota}', NOTA[est] ?? NOTA.otono).replaceAll('{est}', est)); };
    let OPS = deEstacion(), actual = 'trazos';
    const poner = (id: string) => {
      if (!OPS[id]) return;
      actual = id;
      opc.querySelectorAll<HTMLButtonElement>('[data-op]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.op === id)));
      document.querySelectorAll<HTMLElement>('.dl-firma').forEach((f) => { const [ver, copiar] = OPS[id][+f.dataset.k!]; f.querySelector('.dl-papel')!.innerHTML = ver; f.querySelector<HTMLElement>('.dl-copiar')!.dataset.firma = copiar; });
      const dc = document.querySelector('.dc-firma'); if (dc) dc.innerHTML = OPS[id][0][0];
    };
    addEventListener('savvia:estacion', () => { OPS = deEstacion(); poner(actual); });
    opc.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-op]'); if (b) { poner(b.dataset.op!); try { localStorage.setItem('savvia:firma', b.dataset.op!); } catch {} } });
    let guardada: string | null = new URLSearchParams(location.search).get('firma'); if (!guardada) try { guardada = localStorage.getItem('savvia:firma'); } catch {}
    poner(guardada && OPS[guardada] ? guardada : actual); // la de serie también: lleva {est} y {nota}, que se rellenan aquí
  }
  // Firma de correo: se copia como HTML (con la imagen publicada) y como texto.
  document.querySelectorAll<HTMLButtonElement>('.dl-copiar').forEach((b) => b.addEventListener('click', async () => {
    const antes = tr('Copiar firma', 'Copy signature');
    try {
      await navigator.clipboard.write([new ClipboardItem({
        'text/html': new Blob([b.dataset.firma!], { type: 'text/html' }),
        'text/plain': new Blob([b.dataset.texto!], { type: 'text/plain' }),
      })]);
      b.textContent = tr('Copiada', 'Copied');
    } catch {
      // sin permiso de portapapeles: se selecciona la firma pintada y se copia como selección (lleva el HTML y la imagen con su dirección completa)
      const papel = b.closest('.dl-firma')!.querySelector('.dl-papel')!, r = document.createRange(), sel = getSelection()!;
      r.selectNodeContents(papel); sel.removeAllRanges(); sel.addRange(r);
      const ok = document.execCommand('copy'); sel.removeAllRanges();
      b.textContent = ok ? tr('Copiada', 'Copied') : tr('Selecciónala y cópiala', 'Select it and copy it');
    }
    setTimeout(() => (b.textContent = antes), 2200);
  }));
  // RONDA 154 · el roble de cada estación, pintado por el motor del hero (mismas opciones: la primavera teñida de cerezo, el invierno sin hojas y sin hervor)
  document.querySelectorAll<HTMLElement>('.est-robles .rb').forEach((rb) => {
    const img = rb.querySelector('img')!, cv = rb.querySelector('canvas')!;
    const n = EST.indexOf(rb.dataset.est as any);
    const arrancar = () => {
      const t = crearEstela(cv, img, { origen: [0.5, 1], dir: -1, soplo: n !== 1, hd: true, intensidad: n === 2 ? 0.9 : 0 });
      if (!t) return;
      if (n === 2 || n === 1) t.estacion(n);
      t.fondo(...NOCHE[n]); t.crecer(1); t.visible(true);
      rb.classList.add('motor');
      new IntersectionObserver((es) => t.visible(es[0].isIntersecting && rb.classList.contains('on'))).observe(rb);
      new MutationObserver(() => t.visible(rb.classList.contains('on'))).observe(rb, { attributes: true, attributeFilter: ['class'] });
    };
    if (img.complete && img.naturalWidth) arrancar(); else img.addEventListener('load', arrancar, { once: true });
  });

  // 28/10 · las pequeñas piezas, vivas: cada check se marca y se desmarca (vuelve a sonar su onda); la rejilla abre y cierra como en la barra
  document.querySelectorAll<HTMLButtonElement>('[data-pz-check]').forEach((b) => b.addEventListener('click', () => { const on = !b.classList.contains('on'); b.classList.toggle('on', on); b.setAttribute('aria-pressed', String(on)); }));
  document.querySelectorAll<HTMLButtonElement>('[data-pz-rejilla]').forEach((b) => b.addEventListener('click', () => b.setAttribute('aria-expanded', String(b.getAttribute('aria-expanded') !== 'true'))));
  // 28/10 · la despedida: al verse, cae la gota y nace el roble; después, «escribiendo…» y la frase de cada uno, por turnos
