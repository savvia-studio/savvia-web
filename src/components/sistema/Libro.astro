  /* el isotipo, centrado y legible sobre cualquier foto: un velo oscuro muy blando detrás y sombra */
  .pz-foto::after { content: ''; position: absolute; inset: 0; background: radial-gradient(closest-side circle at 50% 50%, rgb(20 12 8 / 0.42), rgb(20 12 8 / 0.12) 60%, transparent); pointer-events: none; }
