  .par:hover .pt { color: var(--bg); transition-delay: 0.15s; }
  .escuchando { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 999px; background: color-mix(in oklab, #eadde7 9%, transparent); font-size: var(--text-ui); font-weight: 500; }
