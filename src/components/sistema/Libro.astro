  .escala { margin-top: calc(var(--spacing) * 10); }
  .escala li { display: grid; grid-template-columns: calc(var(--spacing) * 20) minmax(0, 1fr) auto; align-items: baseline; gap: calc(var(--spacing) * 4); padding-block: calc(var(--spacing) * 4); border-bottom: 1px solid var(--rule); }
  .e-n, .e-d { color: var(--fg2); }
  .e-m { line-height: 1.1; text-wrap: balance; } /* 28/10: frases enteras, que partan si no caben */
  .e-m.display { font-family: var(--font-display); }
  .e-m.sans { font-family: var(--font-sans); }
  .e-m.mono { font-family: var(--font-mono); }
  @media (width < 48rem) { .escala li { grid-template-columns: 1fr; gap: calc(var(--spacing) * 1); } }

  /* ── VOZ */
  /* 28/10 · Eric: «cuida el aire entre secciones»: la cita iba a 40 px del párrafo y a 128 de la sección siguiente; ahora 96 arriba */
  /* 28/10 · Andoni: «la cita de narrativa tampoco me convence como está puesta» → una tarjeta en la noche de la estación (como la cubierta), la frase centrada,
     una gota de savia encima y la nota en mono debajo */
  /* (4.ª) · «los símbolos, sin las imágenes de abajo»: tarjetas de texto, sutiles (el texto al 4 % sobre el fondo); el nombre y su frase */
  .simb { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); /* 29/10 · cuatro, sin el fruto */ gap: calc(var(--spacing) * 3); margin: calc(var(--spacing) * 10) 0 0; padding: 0; list-style: none; }
  .simb li { display: grid; align-content: start; gap: calc(var(--spacing) * 2); padding: calc(var(--spacing) * 6) calc(var(--spacing) * 5); border-radius: var(--radius-lg); background: color-mix(in oklab, var(--fg) 4%, var(--bg, #F5F5F7)); }
  .simb-n { margin: 0; font-size: 1.25rem; line-height: 1.2; color: var(--fg); }
  .simb-q { margin: 0; color: var(--fg); opacity: 0.7; }
  .simb-d { margin: 0; font-size: var(--text-aux); line-height: 1.5; color: var(--fg2); text-wrap: pretty; }
  @media (width >= 40rem) and (width < 64rem) { .simb { grid-template-columns: repeat(2, minmax(0, 1fr)); } } /* 2 × 2 */
  @media (width < 40rem) { .simb { grid-template-columns: repeat(2, minmax(0, 1fr)); } .simb li:last-child:nth-child(odd) { grid-column: 1 / -1; } } /* el quinto, a lo ancho: no queda huérfano */

  /* ── COMPONENTES */
  .comp { margin-top: calc(var(--spacing) * 16); }
  .comp-t { font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.2; font-weight: 400; }
  .comp-d { margin-top: calc(var(--spacing) * 3); color: var(--fg2); max-width: 70ch; line-height: 1.5; }
  .comp .placa, .comp .fila { margin-top: calc(var(--spacing) * 5); }
  /* RONDA 178 · stack, piezas y herramientas */
  .dev-filas { margin-top: calc(var(--spacing) * 10); border-top: 1px solid var(--rule); }
  .dev-filas > div { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr); gap: calc(var(--spacing) * 6); padding-block: calc(var(--spacing) * 4); border-bottom: 1px solid var(--rule); }
  .dev-filas dt { font-family: var(--font-display); font-size: 1.25rem; line-height: 1.3; }
  .dev-filas dd { color: var(--fg2); line-height: 1.55; }
  /* 28/10 (2.ª) · «la iconografía en stack y skills, más elegante»: cada icono en su placa (40 px, filo de 1 px, radio de la casa) al lado del nombre;
     todos en la tinta secundaria y a 18 px, logotipo o Iconoir, para que se lean como un sistema; si son dos, la segunda placa monta sobre la primera */
  .con-ic dt { display: flex; align-items: center; gap: calc(var(--spacing) * 4); }
  .ic-fila { display: flex; flex: none; }
  .ic-fila :global(svg) { box-sizing: content-box; width: 1.125rem; height: 1.125rem; padding: 0.6875rem; border-radius: var(--radius-lg); background: #F5F5F7; box-shadow: inset 0 0 0 1px var(--rule); color: var(--fg2); transition: color 0.3s ease, box-shadow 0.3s ease; }
  .ic-fila :global(svg + svg) { margin-left: -0.625rem; box-shadow: inset 0 0 0 1px var(--rule), 0 0 0 3px var(--bg, #F5F5F7); }
  .ic-fila :global(.ic-linea) { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .con-ic > div:hover .ic-fila :global(svg) { color: var(--fg); box-shadow: inset 0 0 0 1px var(--rule-strong, var(--rule)); }
  @media (width < 48rem) { .dev-filas > div { grid-template-columns: 1fr; gap: calc(var(--spacing) * 2); } }
  .dev-piezas { margin-top: calc(var(--spacing) * 10); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--spacing) * 12) calc(var(--spacing) * 8); }
  @media (width < 48rem) { .dev-piezas { grid-template-columns: 1fr; gap: calc(var(--spacing) * 8); } }
  .dev-piezas li { border-top: 1px solid var(--rule); padding-top: calc(var(--spacing) * 4); }
  .dp-t { font-family: var(--font-display); font-size: var(--text-h3); line-height: 1.2; font-weight: 400; }
  .dp-de { margin-top: calc(var(--spacing) * 2); color: var(--fg2); }
  .dp-como { margin-top: calc(var(--spacing) * 3); line-height: 1.55; color: var(--fg2); }
  /* RONDA 178 · el monitor de Proyectos destacados: montado (las mismas medidas que Proyectos.astro) y su despiece */
  .monitor-demo .placa { aspect-ratio: 16 / 10; }
  /* la escena a su proporción (16:9, la de la lámina) y ampliada ×2,2 alrededor del centro de la pantalla */
  /* 29/10 · Andoni: «el monitor del storybook, centrarlo bien»: el centrado vertical ya no va con `translate` (sumado a `transform`, algún Safari lo
     colocaba mal): margen negativo de medio alto (9/32 del ancho) y la pantalla en el centro de la escala */
  .md-escena { position: absolute; left: 0; top: 50%; width: 100%; aspect-ratio: 16 / 9; margin-top: -28.125%; transform: scale(2.2); transform-origin: 49.92% 47.48%; }
  .md-escena > img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .md-halo, .md-pantalla, .md-caja { position: absolute; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; }
  .md-halo { left: calc(39.03% - 0.469%); top: calc(36.96% - 0.741%); width: calc(21.78% + 0.938%); height: calc(21.04% + 1.482%); border-radius: 1.16% / 2.07%;
    box-shadow: 0 0 1.4rem 0.3rem color-mix(in oklab, var(--color-coral) 55%, transparent), 0 0 4rem 1rem color-mix(in oklab, var(--color-coral) 22%, transparent); }
  .md-pantalla { overflow: hidden; background: #121213; box-shadow: 0 0 0 1.5px #121213; }
  .md-pantalla img, .md-pantalla video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .md-caja { outline: 0.5px dashed color-mix(in oklab, #F5F5F7 80%, transparent); outline-offset: 2px; }
  .md-caja span { position: absolute; left: 0; top: 100%; margin-top: 3px; font-size: 3.5px; white-space: nowrap; color: #F5F5F7; }
  .md-despiece { perspective: 60rem; }
  .md-pila { position: relative; width: 52%; margin-top: 12%; translate: -14% 0; aspect-ratio: 16 / 9; transform-style: preserve-3d; transform: rotateX(56deg) rotateZ(-34deg); }
  .md-capa { position: absolute; inset: 0; transform-style: preserve-3d; border-radius: 4px; transition: transform 0.9s var(--ease-out-expo); }
  .md-capa img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .md-rotulos { position: absolute; top: 18%; right: 8%; display: grid; gap: calc(var(--spacing) * 3); margin: 0; padding: 0; list-style: none; color: #F5F5F7; }
  .md-capa.c1 { transform: translateZ(0); }
  .md-capa.c1 img { opacity: 0.85; }
  .md-capa.c2 { transform: translateZ(1.75rem); }
  .md-capa.c2 i { position: absolute; left: 38.56%; top: 36.22%; width: 22.72%; height: 22.52%; border-radius: 1.16% / 2.07%; box-shadow: 0 0 1.2rem 0.3rem color-mix(in oklab, var(--color-coral) 60%, transparent); }
  .md-capa.c3 { transform: translateZ(3.5rem); }
  .md-capa.c3 i { position: absolute; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; border-radius: 1px; background: #121213; box-shadow: 0 0 0 1px color-mix(in oklab, #F5F5F7 40%, transparent); }
  .md-capa.c4 { inset: auto; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; transform: translateZ(5.25rem); }
  .md-capa.c4 img { object-position: top; border-radius: 1px; }
  .md-capa.c4 b { left: 280%; top: 62%; } /* el borde derecho y la mitad de la pila, medidos desde la caja de la web */
  .md-despiece:hover .c2 { transform: translateZ(2.5rem); }
  .md-despiece:hover .c3 { transform: translateZ(5rem); }
  .md-despiece:hover .c4 { transform: translateZ(7.5rem); }
  .md-capas { margin-top: calc(var(--spacing) * 4); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: calc(var(--spacing) * 4) calc(var(--spacing) * 8); counter-reset: md; max-width: 64rem; }
  @media (width < 64rem) { .md-capas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (width < 48rem) { .md-capas { grid-template-columns: 1fr; } .md-rotulos { display: none; } }
  /* 29/10 · Eric: los pies como los del caso de Neety (Caso.astro › .t-ojo .pie): Timeless Sans en tamaño auxiliar, tinta al 50 % y el nombre al 100 % */
  .md-capas li { font-family: var(--font-sans); font-size: var(--text-aux); line-height: 1.45; color: color-mix(in oklab, var(--fg) 50%, transparent); max-width: 44em; }
  .md-capas b { color: var(--fg); font-weight: inherit; }
  .md-capas code, .comp-d code { font-family: var(--font-mono); font-size: 0.92em; color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .md-capa { transition: none; } }
  .demos { aspect-ratio: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: calc(var(--spacing) * 6); padding: calc(var(--spacing) * 14) calc(var(--spacing) * 6); }
  .placa.clara.demos { flex-direction: column; }
  .buscar-demo { display: flex; align-items: center; width: min(100%, 30rem); height: 44px; padding: 4px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--rule); font-size: var(--text-ui); }
  .bd-l { flex: 1; display: flex; align-items: center; gap: 8px; padding-inline: 12px; color: var(--fg2); }
  .bd-f { position: relative; display: inline-flex; align-items: center; gap: 8px; height: 100%; padding-inline: 16px; font-weight: 500; color: var(--fg2); }
  .bd-f::before { content: ''; position: absolute; left: 0; top: 25%; bottom: 25%; width: 1px; background: var(--rule); }
  .bd-f b { display: grid; place-items: center; min-width: 20px; height: 20px; border-radius: 999px; background: #302018; color: #eadde7; font: 400 11px var(--font-mono); }
  .buscar-demo svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
