  /* ronda 153 · la galería del isotipo (casabien · Taqta): piezas a sangre, pegadas, oscuras y claras */
  .iso-galeria { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 6px; margin-top: calc(var(--spacing) * 8); }
  .pz { position: relative; margin: 0; overflow: hidden; border-radius: 4px; min-height: 0; }
