<script>
  import { jugar } from '../../scripts/jugar';
  import { fijarEstacion, estacionActual, EST, NOCHE } from '../../scripts/estacion';
  import { crearEstela } from '../../scripts/estela';
  // 24/10 · las imágenes que eran de otoño siguen a la estación de la página (data-est-src lleva {est}); al cargar y en cada cambio
  const ponerImgEst = () => { const e = EST[estacionActual()] ?? 'otono'; document.querySelectorAll<HTMLImageElement | HTMLVideoElement>('[data-est-src]').forEach((i) => { const v = i.dataset.estSrc!.replaceAll('{est}', e); if (i.getAttribute('src') === v) return; const enMarcha = i instanceof HTMLVideoElement && !i.paused; i.src = v; if (enMarcha) (i as HTMLVideoElement).play().catch(() => {}); }); };
  ponerImgEst(); addEventListener('savvia:estacion', ponerImgEst);
  // Firma de correo · el selector de opciones: cambia las dos firmas, lo que copian y la del correo de ejemplo (se recuerda en este navegador)
  const opc = document.querySelector<HTMLElement>('.dl-opc');
  if (opc) {
    const NEST: Record<string, string> = { otono: 'otoño', invierno: 'invierno', primavera: 'primavera', verano: 'verano' };
    // Nota de campo: el pie de la firma, uno por estación (el roble es el de la portada de esa estación)
    const NOTA: Record<string, string> = {
      otono: '* El roble de nuestra portada, en otoño.<br>Donostia.',
      invierno: '* El roble de nuestra portada, sin hojas.<br>Invierno en Donostia.',
      primavera: '* El roble de nuestra portada, rebrotando.<br>Primavera en Donostia.',
      verano: '* El roble de nuestra portada, en verano.<br>Donostia.',
    };
    const CRUDO = opc.dataset.firmaOps!;
    // las opciones que llevan el roble de la estación ({est}) se rehacen con la de ese momento: al cargar y cada vez que la página cambia de estación
    const deEstacion = (): Record<string, [string, string][]> => { const est = EST[estacionActual()] ?? 'otono'; return JSON.parse(CRUDO.replaceAll('{estn}', NEST[est] ?? 'otoño').replaceAll('{nota}', NOTA[est] ?? NOTA.otono).replaceAll('{est}', est)); };
    let OPS = deEstacion(), actual = 'trazos';
    const poner = (id: string) => {
      if (!OPS[id]) return;
      actual = id;
      opc.querySelectorAll<HTMLButtonElement>('[data-op]').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.op === id)));
      document.querySelectorAll<HTMLElement>('.dl-firma').forEach((f) => { const [ver, copiar] = OPS[id][+f.dataset.k!]; f.querySelector('.dl-papel')!.innerHTML = ver; f.querySelector<HTMLElement>('.dl-copiar')!.dataset.firma = copiar; });
      const dc = document.querySelector('.dc-firma'); if (dc) dc.innerHTML = OPS[id][0][0];
    };
    addEventListener('savvia:estacion', () => { OPS = deEstacion(); poner(actual); });
    opc.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-op]'); if (b) { poner(b.dataset.op!); try { localStorage.setItem('savvia:firma', b.dataset.op!); } catch {} } });
    let guardada: string | null = new URLSearchParams(location.search).get('firma'); if (!guardada) try { guardada = localStorage.getItem('savvia:firma'); } catch {}
    poner(guardada && OPS[guardada] ? guardada : actual); // la de serie también: lleva {est} y {nota}, que se rellenan aquí
  }
  // Firma de correo: se copia como HTML (con la imagen publicada) y como texto.
  document.querySelectorAll<HTMLButtonElement>('.dl-copiar').forEach((b) => b.addEventListener('click', async () => {
    const antes = 'Copiar firma';
    try {
      await navigator.clipboard.write([new ClipboardItem({
        'text/html': new Blob([b.dataset.firma!], { type: 'text/html' }),
        'text/plain': new Blob([b.dataset.texto!], { type: 'text/plain' }),
      })]);
      b.textContent = 'Copiada';
    } catch {
      // sin permiso de portapapeles: se selecciona la firma pintada y se copia como selección (lleva el HTML y la imagen con su dirección completa)
      const papel = b.closest('.dl-firma')!.querySelector('.dl-papel')!, r = document.createRange(), sel = getSelection()!;
      r.selectNodeContents(papel); sel.removeAllRanges(); sel.addRange(r);
      const ok = document.execCommand('copy'); sel.removeAllRanges();
      b.textContent = ok ? 'Copiada' : 'Selecciónala y cópiala';
    }
    setTimeout(() => (b.textContent = antes), 2200);
  }));
  // RONDA 154 · el roble de cada estación, pintado por el motor del hero (mismas opciones: la primavera teñida de cerezo, el invierno sin hojas y sin hervor)
  document.querySelectorAll<HTMLElement>('.est-robles .rb').forEach((rb) => {
    const img = rb.querySelector('img')!, cv = rb.querySelector('canvas')!;
    const n = EST.indexOf(rb.dataset.est as any);
    const arrancar = () => {
      const t = crearEstela(cv, img, { origen: [0.5, 1], dir: -1, soplo: n !== 1, hd: true, intensidad: n === 2 ? 0.9 : 0 });
      if (!t) return;
      if (n === 2 || n === 1) t.estacion(n);
      t.fondo(...NOCHE[n]); t.crecer(1); t.visible(true);
      rb.classList.add('motor');
      new IntersectionObserver((es) => t.visible(es[0].isIntersecting && rb.classList.contains('on'))).observe(rb);
      new MutationObserver(() => t.visible(rb.classList.contains('on'))).observe(rb, { attributes: true, attributeFilter: ['class'] });
    };
    if (img.complete && img.naturalWidth) arrancar(); else img.addEventListener('load', arrancar, { once: true });
  });

  // el índice sigue la lectura
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-ir]')];
  const secciones = enlaces.map((a) => document.getElementById(a.dataset.ir!)!).filter(Boolean);
  const indiceNav = document.querySelector<HTMLElement>('.indice');
  const marcar = (id: string) => enlaces.forEach((a) => {
    const on = a.dataset.ir === id;
    a.toggleAttribute('aria-current', on);
    // ronda 180: el índice es largo; el apartado que se lee se queda a la vista dentro de él (sin mover la página)
    if (on && indiceNav && indiceNav.scrollHeight > indiceNav.clientHeight) {
      const t = a.offsetTop - indiceNav.clientHeight / 2;
      indiceNav.scrollTo({ top: Math.max(0, t), behavior: 'smooth' });
    }
  });
  const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) marcar(e.target.id); }, { rootMargin: '-30% 0px -65% 0px' });
  secciones.forEach((s) => io.observe(s));
  // la construcción se dibuja al llegar
  document.querySelectorAll<HTMLElement>('[data-construccion]').forEach((cons) => {
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { cons.classList.add('visto'); o.disconnect(); } }, { threshold: 0.3 }).observe(cons);
    // 24.ª · «Volver a construir»: se borra sin transición y se vuelve a montar
    cons.querySelector('[data-cons-otra]')?.addEventListener('click', () => { cons.classList.add('reinicia'); cons.classList.remove('visto'); void cons.offsetWidth; cons.classList.remove('reinicia'); cons.classList.add('visto'); });
  });
  const escena = document.querySelector<HTMLElement>('[data-escena-est]');
  document.documentElement.classList.add('bb-est'); // el cambio de estación, más corto aquí (ver el estilo)
  const datos = JSON.parse(document.querySelector('[data-estaciones-datos]')?.textContent || '[]') as Record<string, any>[];
  let actual = -2;
  const poner = (i: number) => {
    if (i === actual || !escena) return; actual = i;
    if (EST[estacionActual()] !== datos[i].id) fijarEstacion(EST.indexOf(datos[i].id as any), 'brandbook');
    escena.dataset.actual = String(i);
    escena.querySelectorAll<HTMLElement>('[data-cab],[data-punto],[data-roble]').forEach((el) => el.classList.toggle('on', Number(el.dataset.cab ?? el.dataset.punto ?? el.dataset.roble) === i));
    escena.querySelectorAll<HTMLElement>('[data-punto]').forEach((el) => el.setAttribute('aria-checked', String(+el.dataset.punto! === i)));
    const cs = (datos[i] as any).colores as string[][];
    escena.querySelectorAll<HTMLElement>('[data-c]').forEach((el) => (el.hidden = !cs[+el.dataset.c!]));
    const comun = escena.querySelector<HTMLElement>('[data-comun]'); if (comun) comun.hidden = cs[0][2] === '#F5F5F7'; // en invierno el fondo ya es el blanco: no se repite
    // 25.ª · el nombre y el valor de cada color se funden (salen, cambian y entran) en vez de saltar
    const texto = (el: HTMLElement, v: string, k: number) => { if (el.textContent === v) return; const a = el.animate([{ opacity: 1, filter: 'blur(0)' }, { opacity: 0, filter: 'blur(3px)' }], { duration: 260, delay: k * 50, easing: 'ease-in', fill: 'forwards' }); a.onfinish = () => { el.textContent = v; a.cancel(); el.animate([{ opacity: 0, filter: 'blur(3px)' }, { opacity: 1, filter: 'blur(0)' }], { duration: 520, easing: 'cubic-bezier(.16,1,.3,1)' }); }; };
    escena.querySelectorAll<HTMLElement>('[data-hex-c]').forEach((el) => texto(el, cs[+el.dataset.hexC!]?.[2] ?? '', +el.dataset.hexC!));
    escena.querySelectorAll<HTMLElement>('[data-nombre-c]').forEach((el) => texto(el, cs[+el.dataset.nombreC!]?.[1] ?? '', +el.dataset.nombreC!));
    escena.classList.toggle('clara', datos[i].id === 'invierno');
  };
  // RONDA 307, 24.ª · la estación la eliges tú con el selector (la página entera la sigue); al entrar, la de la página
  escena?.querySelectorAll<HTMLButtonElement>('[data-punto]').forEach((b) => b.addEventListener('click', () => poner(+b.dataset.punto!)));
  { const hoy = datos.findIndex((d) => d.id === document.documentElement.dataset.estacion); poner(hoy < 0 ? 0 : hoy); }
  addEventListener('savvia:estacion', () => { const k = datos.findIndex((d) => d.id === document.documentElement.dataset.estacion); if (k >= 0 && k !== actual) poner(k); });
  // el índice se aparta mientras la escena de estaciones o el pie ocupan la pantalla
  {
    const tapan = [document.querySelector('body > footer, footer')].filter(Boolean) as Element[]; // 24.ª: la escena ya no tapa el índice
    const vis = new Map<Element, boolean>();
    const ioI = new IntersectionObserver((es) => { es.forEach((e) => vis.set(e.target, e.isIntersecting)); document.documentElement.classList.toggle('bb-sin-indice', [...vis.values()].some(Boolean)); }, { rootMargin: '-10% 0px -10% 0px' });
    tapan.forEach((t) => ioI.observe(t));
  }
  (window as any).__bbEstacion = () => document.documentElement.dataset.estacion;
  // RONDA 154 · la construcción del isotipo como en un editor de vectores: un CÍRCULO PERFECTO con sus anclas y manejadores (los mismos que el
  // isotipo, ajustados con tools/r154/isotipo-bezier.cjs) y el cursor que los va moviendo uno a uno hasta la forma final.
  document.querySelectorAll<SVGSVGElement>('[data-morfo-svg]').forEach((svg) => {
    type A = { p: number[]; in: number[]; out: number[]; v: number; i: number };
    const AN = JSON.parse(svg.dataset.bezier!) as A[];
    const camino = svg.querySelector<SVGPathElement>('[data-morfo]')!, esq = svg.querySelector<SVGGElement>('[data-esqueleto]')!, cursor = svg.querySelector<SVGPathElement>('[data-cursor]')!;
    const NS = 'http://www.w3.org/2000/svg', CX = 32, CY = 32, R = 23.6, n = AN.length;
    const a0 = Math.atan2(AN[0].p[1] - CY, AN[0].p[0] - CX);
    const m = AN.reduce((k, a, i) => (a.v > AN[k].v ? i : k), 0);
    // el estado de partida: cada ancla sobre el círculo en su fracción del recorrido, con manejadores tangentes de longitud exacta (4/3·tan(Δ/4)·R)
    const ang = (v: number) => a0 - v * 2 * Math.PI;
    // el círculo perfecto: un anillo (contorno de fuera y de dentro, como el trazo del isotipo), cada ancla en su fracción del recorrido y
    // manejadores tangentes de longitud exacta (4/3·tan(Δ/4)·r), orientados hacia el ancla vecina
    const RAD = AN.map((_, i) => (i === 0 || i === m ? R : i < m ? R + 1.1 : R - 1.1));
    const ANG = AN.map((a) => ang(a.v));
    const dif = (x: number, y: number) => { let d = y - x; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };
    const circ = AN.map((_, i) => {
      const ap = ANG[i], r = RAD[i], p = [CX + r * Math.cos(ap), CY + r * Math.sin(ap)];
      const man = (j: number) => { const d = dif(ap, ANG[j]), h = (4 / 3) * Math.tan(Math.abs(d) / 4) * r, sg = Math.sign(d) || 0; return [p[0] - Math.sin(ap) * h * sg, p[1] + Math.cos(ap) * h * sg]; };
      return { p, out: man((i + 1) % n), in: man((i - 1 + n) % n) };
    });
    const el = (t: string, c: string) => { const e = document.createElementNS(NS, t); e.setAttribute('class', c); esq.append(e); return e; };
    const vis = AN.map(() => ({ li: el('line', 'g-man'), lo: el('line', 'g-man'), hi: el('circle', 'g-mpt'), ho: el('circle', 'g-mpt'), q: el('rect', 'g-ancla') }));
    const mix = (a: number[], b: number[], k: number) => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k];
    const suave = (t: number) => (t <= 0 ? 0 : t >= 1 ? 1 : t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const PASO = 0.5; // cada ancla tarda 1 unidad; la siguiente empieza a 0,62
    const total = (n - 1) * PASO + 1;
    const pintar = (T: number) => {
      const u = T * total;
      const Q = AN.map((a, i) => { const k = suave(u - i * PASO); return { p: mix(circ[i].p, a.p, k), in: mix(circ[i].in, a.in, k), out: mix(circ[i].out, a.out, k), k }; });
      let d = `M${Q[0].p[0].toFixed(2)} ${Q[0].p[1].toFixed(2)}`;
      for (let i = 0; i < n; i++) { const a = Q[i], b = Q[(i + 1) % n]; d += `C${a.out[0].toFixed(2)} ${a.out[1].toFixed(2)} ${b.in[0].toFixed(2)} ${b.in[1].toFixed(2)} ${b.p[0].toFixed(2)} ${b.p[1].toFixed(2)}`; }
      camino.setAttribute('d', d + 'Z');
      const activo = Math.min(n - 1, Math.max(0, Math.floor(u / PASO)));
      const fin = Math.min(1, Math.max(0, (u - total + 0.6) / 0.6));
      Q.forEach((q, i) => {
        const v = vis[i], on = i === activo && fin < 1;
        v.q.setAttribute('x', String(q.p[0] - 0.75)); v.q.setAttribute('y', String(q.p[1] - 0.75)); v.q.setAttribute('width', '1.5'); v.q.setAttribute('height', '1.5');
        v.q.classList.toggle('on', on);
        ([[v.li, v.hi, q.in], [v.lo, v.ho, q.out]] as const).forEach(([l, c, h]) => { l.setAttribute('x1', String(q.p[0])); l.setAttribute('y1', String(q.p[1])); l.setAttribute('x2', String(h[0])); l.setAttribute('y2', String(h[1])); c.setAttribute('cx', String(h[0])); c.setAttribute('cy', String(h[1])); c.setAttribute('r', '0.5'); l.classList.toggle('on', on); c.classList.toggle('on', on); });
      });
      const qa = Q[activo].p;
      cursor.setAttribute('transform', `translate(${(qa[0] + 0.5).toFixed(2)} ${(qa[1] + 0.5).toFixed(2)})`);
      cursor.style.opacity = String(T > 0.01 ? 1 - fin : 0);
      esq.style.opacity = String(1 - fin);
      camino.style.fillOpacity = String(fin * 0.94);
      camino.style.strokeWidth = String(0.35 * (1 - fin));
    };
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { pintar(1); return; }
    pintar(0);
    let raf = 0;
    const tocar = () => {
      cancelAnimationFrame(raf);
      const t0 = performance.now() + 700, DUR = 8400;
      const paso = (ahora: number) => { const t = Math.min(1, Math.max(0, (ahora - t0) / DUR)); pintar(t); if (t < 1) raf = requestAnimationFrame(paso); };
      raf = requestAnimationFrame(paso);
    };
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { tocar(); o.disconnect(); } }, { threshold: 0.45 }).observe(svg);
    let ultimo = 0;
    svg.closest('figure')?.addEventListener('pointerenter', () => { if (performance.now() - ultimo < 9000) return; ultimo = performance.now(); pintar(0); tocar(); });
  });
  // ronda 266 · los vídeos de Movimiento: suenan (mudos) solo a la vista; con movimiento reducido se quedan en su primer fotograma
  {
    const quieto = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => { const v = e.target as HTMLVideoElement; if (e.isIntersecting && !quieto) jugar(v); else v.pause(); }), { rootMargin: '10% 0px' });
    document.querySelectorAll<HTMLVideoElement>('[data-mv]').forEach((v) => io.observe(v));
  }
  // RONDA 307, 24.ª · la demo del botón: un cursor entra por un lado, la savia nace ahí (las mismas --gx/--gy/--gd de cta-liquido.ts), sale por otro y se
  // recoge hacia allí; en bucle mientras se ve. Si pasas tú el ratón, manda el tuyo y la demo espera.
  document.querySelectorAll<HTMLElement>('[data-cta-demo]').forEach((fig) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const esc = fig.querySelector<HTMLElement>('.cta-escena')!, b = fig.querySelector<HTMLElement>('[data-cta-boton]')!, cur = fig.querySelector<SVGElement>('[data-cta-cursor]')!;
    const RUTAS = [[[-0.35, 0.5], [0.28, 0.55], [1.35, 0.4]], [[0.85, -0.9], [0.8, 0.4], [0.1, 1.9]], [[0.5, 2], [0.45, 0.6], [-0.4, -0.6]]];
    let viva = false, tuyo = false, k = 0;
    const pos = (fx: number, fy: number) => { const eb = esc.getBoundingClientRect(), bb = b.getBoundingClientRect(); return [bb.left - eb.left + fx * bb.width, bb.top - eb.top + fy * bb.height]; };
    const fijar = (fx: number, fy: number) => { const bb = b.getBoundingClientRect(); const x = Math.min(1, Math.max(0, fx)), y = Math.min(1, Math.max(0, fy)); b.style.setProperty('--gx', (x * 100).toFixed(1) + '%'); b.style.setProperty('--gy', (y * 100).toFixed(1) + '%'); b.style.setProperty('--gd', (Math.hypot(Math.max(x, 1 - x) * bb.width, Math.max(y, 1 - y) * bb.height) * 2.24).toFixed(0) + 'px'); };
    const ir = (a: number[], c: number[], ms: number) => cur.animate([{ transform: `translate(${a[0]}px, ${a[1]}px)` }, { transform: `translate(${c[0]}px, ${c[1]}px)` }], { duration: ms, easing: 'cubic-bezier(.45,0,.2,1)', fill: 'forwards' }).finished;
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const vuelta = async () => {
      while (viva) {
        if (tuyo) { await espera(400); continue; }
        const [de, dentro, fuera] = RUTAS[k++ % RUTAS.length], p0 = pos(de[0], de[1]), p1 = pos(dentro[0], dentro[1]), p2 = pos(fuera[0], fuera[1]);
        cur.style.opacity = '1';
        await ir(p0, p1, 900); if (tuyo || !viva) continue;
        // entra: el borde por donde cruzó (el punto medio entre fuera y dentro, recortado al botón)
        fijar((de[0] + dentro[0]) / 2, (de[1] + dentro[1]) / 2); b.classList.add('demo-hover');
