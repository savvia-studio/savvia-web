  /* ronda 153 · el logotipo nuevo: isotipo + palabra */
  .iso-masc { display: block; background: currentColor; -webkit-mask: url('/savvia-isotipo-gota.svg') center / contain no-repeat; mask: url('/savvia-isotipo-gota.svg') center / contain no-repeat; aspect-ratio: 1; }
