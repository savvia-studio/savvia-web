  .nivel i { width: 2px; height: 100%; border-radius: 2px; background: color-mix(in oklab, #eadde7 70%, transparent); animation: bb-nivel 1.1s ease-in-out infinite alternate; }
  .nivel i:nth-child(2) { animation-delay: -0.4s; }
