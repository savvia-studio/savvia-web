      });
      const qa = Q[activo].p;
      cursor.setAttribute('transform', `translate(${(qa[0] + 0.5).toFixed(2)} ${(qa[1] + 0.5).toFixed(2)})`);
      cursor.style.opacity = String(T > 0.01 ? 1 - fin : 0);
      esq.style.opacity = String(1 - fin);
      camino.style.fillOpacity = String(fin * 0.94);
