<script>
  import { fijarEstacion, estacionActual, EST, NOCHE } from '../../scripts/estacion';
  import { crearEstela } from '../../scripts/estela';
  // RONDA 154 · el roble de cada estación, pintado por el motor del hero (mismas opciones: la primavera teñida de cerezo, el invierno sin hojas y sin hervor)
  document.querySelectorAll<HTMLElement>('.est-robles .rb').forEach((rb) => {
    const img = rb.querySelector('img')!, cv = rb.querySelector('canvas')!;
    const n = EST.indexOf(rb.dataset.est as any);
    const arrancar = () => {
      const t = crearEstela(cv, img, { origen: [0.5, 1], dir: -1, soplo: n !== 1, hd: true, intensidad: n === 2 ? 0.9 : 0 });
      if (!t) return;
      if (n === 2 || n === 1) t.estacion(n);
      t.fondo(...NOCHE[n]); t.crecer(1); t.visible(true);
      rb.classList.add('motor');
      new IntersectionObserver((es) => t.visible(es[0].isIntersecting && rb.classList.contains('on'))).observe(rb);
      new MutationObserver(() => t.visible(rb.classList.contains('on'))).observe(rb, { attributes: true, attributeFilter: ['class'] });
    };
    if (img.complete && img.naturalWidth) arrancar(); else img.addEventListener('load', arrancar, { once: true });
  });

  // el índice sigue la lectura
  const enlaces = [...document.querySelectorAll<HTMLAnchorElement>('[data-ir]')];
  const secciones = enlaces.map((a) => document.getElementById(a.dataset.ir!)!).filter(Boolean);
  const indiceNav = document.querySelector<HTMLElement>('.indice');
  const marcar = (id: string) => enlaces.forEach((a) => {
    const on = a.dataset.ir === id;
    a.toggleAttribute('aria-current', on);
    // ronda 180: el índice es largo; el apartado que se lee se queda a la vista dentro de él (sin mover la página)
    if (on && indiceNav && indiceNav.scrollHeight > indiceNav.clientHeight) {
      const t = a.offsetTop - indiceNav.clientHeight / 2;
      indiceNav.scrollTo({ top: Math.max(0, t), behavior: 'smooth' });
    }
  });
  const io = new IntersectionObserver((es) => { for (const e of es) if (e.isIntersecting) marcar(e.target.id); }, { rootMargin: '-30% 0px -65% 0px' });
  secciones.forEach((s) => io.observe(s));
  // la construcción se dibuja al llegar
  document.querySelectorAll('[data-construccion]').forEach((cons) => new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { cons.classList.add('visto'); o.disconnect(); } }, { threshold: 0.3 }).observe(cons));
  // LAS ESTACIONES (ronda 144, 3.ª): el avance por el tramo fijo elige la estación (cuatro cuartos); fuera del tramo, la de hoy
  const deHoy = estacionActual();
  const tramo = document.querySelector<HTMLElement>('[data-estaciones]');
  const escena = document.querySelector<HTMLElement>('[data-escena-est]');
  const datos = JSON.parse(document.querySelector('[data-estaciones-datos]')?.textContent || '[]') as Record<string, any>[];
  let actual = -2;
  const poner = (i: number) => {
    if (i === actual || !escena) return; actual = i;
    if (i < 0) { fijarEstacion(deHoy, 'brandbook'); return; }
    fijarEstacion(EST.indexOf(datos[i].id as any), 'brandbook');
    escena.dataset.actual = String(i);
    escena.querySelectorAll<HTMLElement>('[data-cab],[data-punto],[data-roble]').forEach((el) => el.classList.toggle('on', Number(el.dataset.cab ?? el.dataset.punto ?? el.dataset.roble) === i));
    const cs = (datos[i] as any).colores as string[][];
    escena.querySelectorAll<HTMLElement>('[data-c]').forEach((el) => (el.hidden = !cs[+el.dataset.c!]));
    const comun = escena.querySelector<HTMLElement>('[data-comun]'); if (comun) comun.hidden = cs[0][2] === '#F5F5F7'; // en invierno el fondo ya es el blanco: no se repite
    escena.querySelectorAll<HTMLElement>('[data-hex-c]').forEach((el) => (el.textContent = cs[+el.dataset.hexC!]?.[2] ?? ''));
    escena.querySelectorAll<HTMLElement>('[data-nombre-c]').forEach((el) => (el.textContent = cs[+el.dataset.nombreC!]?.[1] ?? ''));
    escena.classList.toggle('clara', datos[i].id === 'invierno');
  };
  const medir = () => {
    if (!tramo) return;
    const r = tramo.getBoundingClientRect(), recorrido = r.height - innerHeight;
    const p = -r.top / Math.max(1, recorrido);
    // fuera del tramo (la escena ya no cubre el centro de la pantalla), la de hoy; dentro, la del cuarto que se recorre
    poner(r.top > innerHeight * 0.5 || r.bottom < innerHeight * 0.5 ? -1 : Math.min(datos.length - 1, Math.max(0, Math.floor(p * datos.length))));
  };
  addEventListener('scroll', medir, { passive: true }); addEventListener('resize', medir); medir();
  // el índice se aparta mientras la escena de estaciones o el pie ocupan la pantalla
  {
    const tapan = [document.querySelector('[data-escena-est]'), document.querySelector('body > footer, footer')].filter(Boolean) as Element[];
    const vis = new Map<Element, boolean>();
    const ioI = new IntersectionObserver((es) => { es.forEach((e) => vis.set(e.target, e.isIntersecting)); document.documentElement.classList.toggle('bb-sin-indice', [...vis.values()].some(Boolean)); }, { rootMargin: '-10% 0px -10% 0px' });
    tapan.forEach((t) => ioI.observe(t));
  }
  (window as any).__bbEstacion = () => document.documentElement.dataset.estacion;
  // RONDA 154 · la construcción del isotipo como en un editor de vectores: un CÍRCULO PERFECTO con sus anclas y manejadores (los mismos que el
  // isotipo, ajustados con tools/r154/isotipo-bezier.cjs) y el cursor que los va moviendo uno a uno hasta la forma final.
  document.querySelectorAll<SVGSVGElement>('[data-morfo-svg]').forEach((svg) => {
    type A = { p: number[]; in: number[]; out: number[]; v: number; i: number };
    const AN = JSON.parse(svg.dataset.bezier!) as A[];
    const camino = svg.querySelector<SVGPathElement>('[data-morfo]')!, esq = svg.querySelector<SVGGElement>('[data-esqueleto]')!, cursor = svg.querySelector<SVGPathElement>('[data-cursor]')!;
    const NS = 'http://www.w3.org/2000/svg', CX = 32, CY = 32, R = 23.6, n = AN.length;
    const a0 = Math.atan2(AN[0].p[1] - CY, AN[0].p[0] - CX);
    const m = AN.reduce((k, a, i) => (a.v > AN[k].v ? i : k), 0);
    // el estado de partida: cada ancla sobre el círculo en su fracción del recorrido, con manejadores tangentes de longitud exacta (4/3·tan(Δ/4)·R)
    const ang = (v: number) => a0 - v * 2 * Math.PI;
    // el círculo perfecto: un anillo (contorno de fuera y de dentro, como el trazo del isotipo), cada ancla en su fracción del recorrido y
    // manejadores tangentes de longitud exacta (4/3·tan(Δ/4)·r), orientados hacia el ancla vecina
    const RAD = AN.map((_, i) => (i === 0 || i === m ? R : i < m ? R + 1.1 : R - 1.1));
    const ANG = AN.map((a) => ang(a.v));
    const dif = (x: number, y: number) => { let d = y - x; while (d > Math.PI) d -= 2 * Math.PI; while (d < -Math.PI) d += 2 * Math.PI; return d; };
    const circ = AN.map((_, i) => {
      const ap = ANG[i], r = RAD[i], p = [CX + r * Math.cos(ap), CY + r * Math.sin(ap)];
      const man = (j: number) => { const d = dif(ap, ANG[j]), h = (4 / 3) * Math.tan(Math.abs(d) / 4) * r, sg = Math.sign(d) || 0; return [p[0] - Math.sin(ap) * h * sg, p[1] + Math.cos(ap) * h * sg]; };
      return { p, out: man((i + 1) % n), in: man((i - 1 + n) % n) };
    });
    const el = (t: string, c: string) => { const e = document.createElementNS(NS, t); e.setAttribute('class', c); esq.append(e); return e; };
    const vis = AN.map(() => ({ li: el('line', 'g-man'), lo: el('line', 'g-man'), hi: el('circle', 'g-mpt'), ho: el('circle', 'g-mpt'), q: el('rect', 'g-ancla') }));
    const mix = (a: number[], b: number[], k: number) => [a[0] + (b[0] - a[0]) * k, a[1] + (b[1] - a[1]) * k];
    const suave = (t: number) => (t <= 0 ? 0 : t >= 1 ? 1 : t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
    const PASO = 0.5; // cada ancla tarda 1 unidad; la siguiente empieza a 0,62
    const total = (n - 1) * PASO + 1;
