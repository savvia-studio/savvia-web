  .ci-lista { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(5, auto); column-gap: calc(var(--spacing) * 12); margin: 0; padding: 0 calc(var(--spacing) * 8); list-style: none; }
  .ci-e { position: relative; display: grid; grid-row: span 5; grid-template-rows: subgrid; justify-items: center; text-align: center; }
  /* 28/10 (6.ª) · los textos, siempre a plena tinta (se leen todos, también los que no están encendidos); lo que se apaga es el roble */
  .ci-roble { opacity: 0.45; filter: saturate(0.6); transition: opacity 0.9s var(--ease-out-expo), filter 0.9s var(--ease-out-expo), scale 1.2s var(--ease-out-expo); }
