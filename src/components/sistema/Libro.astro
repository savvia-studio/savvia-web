const escalaL = escala.map(([n, v, px, fam, cls, txt], k) => (en ? [ESCALA_EN[k][0], v, px, fam, cls, ESCALA_EN[k][1]] : [n, v, px, fam, cls, txt]) as [string, string, string, string, string, string]);
