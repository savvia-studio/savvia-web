    for (const b of bs) b.addEventListener('click', () => { fig.dataset.brEst = b.dataset.brBoton; for (const x of bs) x.setAttribute('aria-pressed', String(x === b)); });
  });
  // RONDA 307, 24.ª · la demo del botón: un cursor entra por un lado, la savia nace ahí (las mismas --gx/--gy/--gd de cta-liquido.ts), sale por otro y se
  // recoge hacia allí; en bucle mientras se ve. Si pasas tú el ratón, manda el tuyo y la demo espera.
  document.querySelectorAll<HTMLElement>('[data-cta-demo]').forEach((fig) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const esc = fig.querySelector<HTMLElement>('.cta-escena')!, b = fig.querySelector<HTMLElement>('[data-cta-boton]')!, cur = fig.querySelector<SVGElement>('[data-cta-cursor]')!;
    const RUTAS = [[[-0.35, 0.5], [0.28, 0.55], [1.35, 0.4]], [[0.85, -0.9], [0.8, 0.4], [0.1, 1.9]], [[0.5, 2], [0.45, 0.6], [-0.4, -0.6]]];
    let viva = false, tuyo = false, k = 0;
    const pos = (fx: number, fy: number) => { const eb = esc.getBoundingClientRect(), bb = b.getBoundingClientRect(); return [bb.left - eb.left + fx * bb.width, bb.top - eb.top + fy * bb.height]; };
    const fijar = (fx: number, fy: number) => { const bb = b.getBoundingClientRect(); const x = Math.min(1, Math.max(0, fx)), y = Math.min(1, Math.max(0, fy)); b.style.setProperty('--gx', (x * 100).toFixed(1) + '%'); b.style.setProperty('--gy', (y * 100).toFixed(1) + '%'); b.style.setProperty('--gd', (Math.hypot(Math.max(x, 1 - x) * bb.width, Math.max(y, 1 - y) * bb.height) * 2.24).toFixed(0) + 'px'); };
    const ir = (a: number[], c: number[], ms: number) => cur.animate([{ transform: `translate(${a[0]}px, ${a[1]}px)` }, { transform: `translate(${c[0]}px, ${c[1]}px)` }], { duration: ms, easing: 'cubic-bezier(.45,0,.2,1)', fill: 'forwards' }).finished;
    const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const vuelta = async () => {
      while (viva) {
        if (tuyo) { await espera(400); continue; }
        const [de, dentro, fuera] = RUTAS[k++ % RUTAS.length], p0 = pos(de[0], de[1]), p1 = pos(dentro[0], dentro[1]), p2 = pos(fuera[0], fuera[1]);
        cur.style.opacity = '1';
        await ir(p0, p1, 900); if (tuyo || !viva) continue;
        // entra: el borde por donde cruzó (el punto medio entre fuera y dentro, recortado al botón)
        fijar((de[0] + dentro[0]) / 2, (de[1] + dentro[1]) / 2); b.classList.add('demo-hover');
        await espera(1500); if (tuyo || !viva) continue;
        await ir(p1, p2, 800);
        fijar((dentro[0] + fuera[0]) / 2, (dentro[1] + fuera[1]) / 2); b.classList.remove('demo-hover');
        cur.style.opacity = '0'; await espera(900);
      }
