  { id: 'verano', n: 'Verano', meses: 'junio – agosto', noche: '#1B3125', tinta: '#F5F5F7', colores: [['fondo', 'Bosque', '#1B3125'], ['roble', 'Hoja', '#6F9A4E'], ['savia', 'Lima', '#B9E26C'], ['bloque', 'Prado', '#CFE6A4']], frase: 'Bosque de noche y hoja al sol; la savia es la lima.' },
  { id: 'otono', n: 'Otoño', meses: 'septiembre – noviembre', noche: '#3B231B', tinta: '#F5F5F7', colores: [['fondo', 'Cacao', '#3B231B'], ['roble', 'Cobre', '#C65C2D'], ['savia', 'Coral', '#FF616B'], ['bloque', 'Hoja seca', '#ECBF8F']], frase: 'La casa: Cacao tostado y cobre; la savia es el Coral.' },
  { id: 'invierno', n: 'Invierno', meses: 'diciembre – febrero', noche: '#F5F5F7', tinta: '#22303E', colores: [['fondo', 'Nieve', '#F5F5F7'], ['roble', 'Roble desnudo', '#7D8BA3'], ['savia', 'Glaciar', '#4F8AD6'], ['bloque', 'Hielo', '#CADCEE'], ['tinta', 'Pizarra', '#22303E']], frase: 'La web se vuelve nieve y el roble, desnudo; la savia es el azul glaciar.' },
];
const escala = [
  ['H1', 'var(--text-h1)', '44 → 72', 'Family 400', 'display'],
  ['H2', 'var(--text-h2)', '34 → 48', 'Family 400', 'display'],
  ['H3', 'var(--text-h3)', '26 → 32', 'Family 400', 'display'],
  ['Lead', 'var(--text-lead)', '20', 'Timeless Sans 300', 'sans'],
  ['Subtítulo', 'var(--text-sub)', '18', 'Timeless Sans 300', 'sans'],
  ['Cuerpo', 'var(--text-body)', '17 → 18', 'Timeless Sans 420', 'sans'],
  ['Interfaz', 'var(--text-ui)', '16', 'Timeless Sans 500', 'sans'],
  ['Detalle', 'var(--text-detail)', '13', 'Timeless Grotesk 300', 'grot'],
] as const;
const seDice = ['orquestar', 'criterio', 'elevar', 'desarrollo agéntico', 'a medida', 'de principio a fin', 'documentado', 'fuente de verdad', 'claridad', 'contigo', 'Eric y Andoni']; // ronda 156 (Eric): «Donostia» ya no se dice
const noSeDice = ['prompt', 'vibe coding', '«lavado de cara»', 'años de experiencia', 'número de clientes', '«pioneros»', 'jerga de generador'];
