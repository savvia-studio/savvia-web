};
// lo que sale pintado en el servidor, ya en otoño (el selector lo cambia a la estación de la página al cargar): así no se pide ninguna imagen con {est}
const deServidor = (h: string) => h.replaceAll('{est}', 'otono').replaceAll('{estn}', 'otoño').replaceAll('{nota}', '* El roble de nuestra portada, en otoño.<br>Donostia.');
