    .est-txt, .est-robles, .est-paleta { grid-column: 1 / -1; }
    .est-robles { max-width: 18rem; }
    .est-paleta { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: calc(var(--spacing) * 4) calc(var(--spacing) * 2); }
    .est-paleta .est-u { display: none; }
  }
  .est-pila { display: grid; overflow: clip; overflow-clip-margin: 0.25em; }
  .est-paleta [data-nombre-c], .est-paleta [data-hex-c] { display: block; overflow: clip; } .est-paleta :global(.ln) { display: block; }
  .est-cab { grid-area: 1 / 1; opacity: 0; translate: 0 12px; transition: opacity 0.6s ease, translate 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
  .est-cab.on { opacity: 1; translate: 0 0; }
