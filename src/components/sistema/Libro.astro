  .estaciones { position: relative; height: calc(var(--n) * 100lvh); margin-top: calc(var(--spacing) * 16); }
  .escena-est {
    --tinta-est: var(--color-niebla); /* ronda 151: la tinta de las estaciones oscuras es su papel */
    position: sticky;
    top: 0;
    height: 100lvh;
    display: grid;
    align-items: center;
    background: var(--noche);
    color: var(--tinta-est);
    /* el fondo ya viaja con --noche (registrada): una transición propia encima lo perseguía y alargaba el cambio */
    transition: color 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  /* «la transición entre estaciones va muy lenta; smooth sí, pero fluido»: en el storybook la casa entera cambia en 0,8 s (en la web, 2,4 s);
     la tinta da su golpe a mitad del fundido, como allí. Mismo orden que la lista de global.css (:root) */
  :global(html.bb-est) {
    transition-duration: 0.8s, 0.8s, 0.8s, 0.4s, 0.4s, 0.8s, 0.8s, 0.8s, 0.8s, 0.8s;
    transition-delay: 0s, 0s, 0s, 0.04s, 0.04s, 0s, 0s, 0s, 0s, 0s;
    transition-timing-function: cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.9, 0, 0.1, 1), cubic-bezier(0.9, 0, 0.1, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1), cubic-bezier(0.33, 1, 0.68, 1);
  }
  .escena-est.clara { --tinta-est: #302018; }
  .est-dentro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: calc(var(--spacing) * 6); row-gap: calc(var(--spacing) * 8); align-items: center; }
  .est-txt { grid-column: 4 / span 4; }
  .est-robles { grid-column: 8 / span 5; display: grid; }
  .est-robles .rb { grid-area: 1 / 1; position: relative; opacity: 0; scale: 0.98; filter: blur(6px); transition: opacity 0.6s ease, scale 0.8s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease; }
  .est-robles .rb.on { opacity: 1; scale: 1; filter: none; }
  .est-robles img { display: block; width: 100%; height: auto; }
  /* RONDA 154 · «el árbol del brandbook, como lo tenemos en el hero, en todas las estaciones»: lo pinta el MISMO motor con las mismas opciones */
  .est-robles canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: none; }
  .est-robles .rb.motor canvas { display: block; }
  .est-robles .rb.motor img { visibility: hidden; }
  .est-paleta { grid-column: 4 / span 9; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: calc(var(--spacing) * 5) calc(var(--spacing) * 3); }
  .est-paleta .est-m { aspect-ratio: 16 / 9; }
