  }
  .ci-vuelta span { padding-inline: calc(var(--spacing) * 3); background: var(--carta); }
  @media (width < 64rem) {
    .ci-lista { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; row-gap: calc(var(--spacing) * 12); padding: 0; } .ci-e { grid-row: auto; grid-template-rows: none; align-content: start; justify-items: start; } .ci-savia, .ci-proy { max-width: none; }
    .ci-via { display: none; } .ci-e { opacity: 1; text-align: left; } .ci-pto { justify-self: start; margin-left: 50%; } .ci-vuelta { position: static; translate: none; justify-content: flex-start; margin-top: calc(var(--spacing) * 8); }
    .ciclo { padding-bottom: 0; }
  }
