    esc.addEventListener('pointerleave', () => { tuyo = false; });
    new IntersectionObserver((es) => { const v = es[0].isIntersecting; if (v && !viva) { viva = true; vuelta(); } else if (!v) { viva = false; b.classList.remove('demo-hover'); cur.style.opacity = '0'; } }, { threshold: 0.4 }).observe(fig);
  });
  // RONDA 307, 25.ª · el esquema del espaciado (como en los casos): cada medida se enciende por turnos mientras se ve; al pasar por una fila, esa
  document.querySelectorAll<HTMLElement>('[data-esp]').forEach((el) => {
    const orden = ['seccion', 'hueco', 'cont']; // 28/10: fuera el «relleno de tarjeta» (no hay uno común en la web)
    let k = 0, t = 0, fijo = false, visible = false;
    const poner = (q: string) => (el.dataset.on = q);
    const siguiente = () => { if (!fijo && visible) poner(orden[k++ % orden.length]); };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; clearInterval(t); if (visible) { siguiente(); t = window.setInterval(siguiente, 2600); } }, { threshold: 0.3 }).observe(el);
    el.querySelectorAll<HTMLElement>('[data-k]').forEach((row) => { row.addEventListener('pointerenter', () => { fijo = true; poner(row.dataset.k!); }); row.addEventListener('pointerleave', () => { fijo = false; }); });
  });
</script>

