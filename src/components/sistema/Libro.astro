  /* las tres a la misma altura: cada una ocupa columnas en proporción a su formato (3:2 · 3:2 · 4:5) */
  .pz-helecho, .pz-anillos, .pz-gota { grid-column: auto; aspect-ratio: auto; height: clamp(16rem, 30vw, 26rem); }
