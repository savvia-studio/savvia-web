// ── LA CONSTRUCCIÓN: anclas y manejadores de cada trazo del logotipo (comandos absolutos)
const trazos = [...logoRaw.matchAll(/ d="([^"]+)"/g)].map((m) => m[1]);
type Pt = [number, number];
const anclas: Pt[] = [], manejos: [Pt, Pt][] = [], controles: Pt[] = [];
const cajas: { x0: number; x1: number; y0: number; y1: number }[] = [];
for (const d of trazos) {
  const tk = d.match(/[MCQLHVZ]|-?\d*\.?\d+(?:e-?\d+)?/gi) ?? [];
  let i = 0, cmd = '', cx = 0, cy = 0;
  const n = () => parseFloat(tk[i++]);
  const caja = { x0: 1e9, x1: -1e9, y0: 1e9, y1: -1e9 };
  const mete = (p: Pt) => { caja.x0 = Math.min(caja.x0, p[0]); caja.x1 = Math.max(caja.x1, p[0]); caja.y0 = Math.min(caja.y0, p[1]); caja.y1 = Math.max(caja.y1, p[1]); };
  while (i < tk.length) {
    if (/[MCQLHVZ]/i.test(tk[i])) cmd = tk[i++].toUpperCase();
    if (cmd === 'Z') continue;
    if (cmd === 'M' || cmd === 'L') { cx = n(); cy = n(); anclas.push([cx, cy]); mete([cx, cy]); if (cmd === 'M') cmd = 'L'; }
    else if (cmd === 'H') { cx = n(); anclas.push([cx, cy]); mete([cx, cy]); }
    else if (cmd === 'V') { cy = n(); anclas.push([cx, cy]); mete([cx, cy]); }
    else if (cmd === 'C') {
      const a: Pt = [n(), n()], b: Pt = [n(), n()], e: Pt = [n(), n()];
      manejos.push([[cx, cy], a], [b, e]); controles.push(a, b); anclas.push(e); mete(e);
      cx = e[0]; cy = e[1];
    } else if (cmd === 'Q') {
      const a: Pt = [n(), n()], e: Pt = [n(), n()];
      manejos.push([[cx, cy], a], [a, e]); controles.push(a); anclas.push(e); mete(e);
      cx = e[0]; cy = e[1];
    } else i++;
  }
  cajas.push(caja);
}
