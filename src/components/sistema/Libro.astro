  .tarjeta-v.dorso .detail { font-size: clamp(0.6rem, 1.2vw, 0.8125rem); }
  /* ronda 152 · la iconografía */
  .iconos-bb ul { display: grid; grid-template-columns: repeat(4, 1fr); gap: calc(var(--spacing) * 6) calc(var(--spacing) * 4); margin-top: calc(var(--spacing) * 6); }
  .iconos-bb li { display: grid; justify-items: center; gap: calc(var(--spacing) * 2); color: var(--fg); }
  .iconos-bb :global(svg) { width: 2rem; height: 2rem; }
