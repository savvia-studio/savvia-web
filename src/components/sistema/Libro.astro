  .ciclo.cartas .ci-e[data-ci='3'] { order: 3; }
  .ciclo.cartas .ci-e[data-ci='0'] { --q: 0; } .ciclo.cartas .ci-e[data-ci='1'] { --q: 1; } .ciclo.cartas .ci-e[data-ci='2'] { --q: 2; } .ciclo.cartas .ci-e[data-ci='3'] { --q: 3; }
  .ci-anillo { position: absolute; left: 50%; top: 50%; z-index: 2; display: grid; place-items: center; width: 72px; aspect-ratio: 1; translate: -50% -50%; list-style: none; }
  /* (7.ª) · «por donde corta el círculo, mantener el redondeo de los extremos»: el hueco es el disco más ocho filetes de 8 px donde toca el canto de
     cada tarjeta (calculados al compilar: tangentes al disco y al canto), en el color del fondo */
  .ci-a-hueco { position: absolute; left: 50%; top: 50%; width: 120px; height: 120px; translate: -50% -50%; overflow: visible; fill: var(--bg, #F5F5F7); }
  /* (7.ª) · el círculo interior (Andoni, 9.ª: «me gustaba más el de antes»): una órbita fina con una estela de savia (degradado cónico) que sigue a la
     gota, y un punto por estación en su color; da la vuelta en 24 s, empezando en la primavera (arriba a la izquierda) */
  .ci-orbita { position: relative; display: block; width: 48px; height: 48px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--rule); }
  .ci-cola { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from 0deg, transparent 0deg 250deg, color-mix(in srgb, var(--fg) 55%, transparent) 360deg); /* (11.ª) neutra: la tinta */ -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px)); mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1.5px)); animation: ci-giro 24s linear infinite; }
  .ci-gota { position: absolute; inset: 0; animation: ci-giro 24s linear infinite; }
  .ci-gota::after { content: ''; position: absolute; left: 50%; top: -3px; width: 7px; height: 7px; margin-left: -3.5px; border-radius: 50%; background: var(--fg); box-shadow: 0 0 0 3px color-mix(in srgb, var(--fg) 14%, transparent); }
  /* (10.ª) · «dentro, un círculo concéntrico que cambie de color según la estación por la que pasa»: con el mismo reloj de 24 s */
  .ci-nucleo { position: absolute; inset: 13px; border-radius: 50%; background: var(--c0); animation: ci-nucleo 24s infinite; }
  @keyframes ci-nucleo { 0%, 21% { background: var(--c0); } 25%, 46% { background: var(--c1); } 50%, 71% { background: var(--c2); } 75%, 96% { background: var(--c3); } 100% { background: var(--c0); } }
  @keyframes ci-giro { from { transform: rotate(-90deg); } to { transform: rotate(270deg); } }
  /* el roble de la estación por la que pasa la gota, encendido; los demás, en voz baja (6 s cada estación) */
  /* (9.ª) · «el árbol inactivo con bastante transparencia y más pequeño; cuando pasa el círculo, al 100 % y más grande»: 6 s por estación */
