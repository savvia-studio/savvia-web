  .gota-d { width: 28px; height: 28px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: radial-gradient(circle at 35% 30%, #fff 0 12%, transparent 13%), radial-gradient(circle, rgb(255 243 228 / 0.15), rgb(48 32 24 / 0.35)); box-shadow: inset 0 -3px 6px rgb(48 32 24 / 0.25), 0 6px 10px -6px rgb(48 32 24 / 0.5); animation: gota-cae 2.4s cubic-bezier(0.55, 0, 0.85, 0.45) infinite; }
