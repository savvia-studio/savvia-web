  .cons-otra { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin-right: auto; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: color-mix(in oklab, currentColor 35%, transparent); cursor: pointer; }
