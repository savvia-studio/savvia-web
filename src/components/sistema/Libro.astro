  .fam b { font-weight: 500; }
  .fam .detail { opacity: 0.8; }
  /* 29/10 · Eric (prueba, solo en el storybook): sobre lo claro, el primario MACIZO en vez de cristal (al 82 % el Cacao se lavaba a gris y el texto niebla tiraba a lila).
     Si gusta, pasa a global.css › :is(.surface-light, …) .btn-primary para toda la web */
  /* solo los que van sobre claro (la descarga y la demo de la savia); los de la muestra de Componentes van sobre la noche y siguen de cristal, con su filo */
  #descargas .btn-primary, .mv-cta .btn-primary { background: var(--noche-honda, #302018); -webkit-backdrop-filter: none; backdrop-filter: none; color: #f5f5f7; box-shadow: inset 0 0 0 1px color-mix(in oklab, #eadde7 12%, transparent), 0 12px 28px -14px rgb(48 32 24 / 0.45); }
  #descargas .btn-primary:hover, #descargas .btn-primary:focus-visible, .mv-cta .btn-primary:hover, .mv-cta .btn-primary:focus-visible { color: #302018; }
  /* 29/10 · Eric: los rótulos pequeños, con menos espacio entre letras */
  .detail { letter-spacing: -0.01em; }
