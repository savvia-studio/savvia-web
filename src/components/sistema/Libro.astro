  .est-m { display: block; aspect-ratio: 4 / 3; margin-bottom: calc(var(--spacing) * 3); border-radius: var(--radius-lg); background: var(--c); box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--tinta-est) 22%, transparent); }
  .est-mn { font-size: var(--text-ui); font-weight: 500; }
