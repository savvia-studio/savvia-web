  .est-frase { margin-top: calc(var(--spacing) * 5); font-size: var(--text-body); line-height: 1.55; opacity: 0.8; max-width: 30ch; }
  .est-puntos { display: flex; gap: calc(var(--spacing) * 4); margin-top: calc(var(--spacing) * 8); font-size: var(--text-aux); }
  .est-puntos li { opacity: 0.4; transition: opacity 0.4s ease; }
