  @keyframes bb-nivel { from { scale: 1 0.25; } to { scale: 1 1; } }
  .checks { display: flex; gap: 14px; }
  /* 28/10 · el check de Servicios y la rejilla del menú, vivos (mismas reglas que Servicios.astro y Nav.astro, a mayor tamaño) */
  .pz-check { display: grid; place-items: center; padding: 6px; border: 0; background: none; color: #302018; cursor: pointer; border-radius: var(--radius-full); }
  .pz-check :global(.check) { width: 30px; height: 30px; overflow: visible; }
  .pz-check :global(circle), .pz-check :global(.v) { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .pz-check :global(.aro) { stroke: rgb(48 32 24 / 0.35); stroke-width: 1.1; opacity: 0.4; transition: opacity 0.25s ease; }
  .pz-check :global(.relleno) { fill: currentColor; transform-box: fill-box; transform-origin: center; transform: scale(0); transition: transform 0.18s ease-in; }
  .pz-check :global(.onda) { stroke: currentColor; stroke-width: 1; transform-box: fill-box; transform-origin: center; opacity: 0; transform: scale(0.6); }
  .pz-check :global(.v) { stroke: #F5F5F7; stroke-width: 1.4; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.12s ease-in; }
