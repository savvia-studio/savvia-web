  /* la escena a su proporción (16:9, la de la lámina) y ampliada ×2,2 alrededor del centro de la pantalla */
  .md-escena { position: absolute; left: 0; top: 50%; width: 100%; aspect-ratio: 16 / 9; translate: 0 -50%; transform: scale(2.2); transform-origin: 49.92% 47.48%; }
  .md-escena > img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .md-halo, .md-pantalla, .md-caja { position: absolute; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; }
  .md-halo { left: calc(39.03% - 0.469%); top: calc(36.96% - 0.741%); width: calc(21.78% + 0.938%); height: calc(21.04% + 1.482%); border-radius: 1.16% / 2.07%;
    box-shadow: 0 0 1.4rem 0.3rem color-mix(in oklab, var(--color-coral) 55%, transparent), 0 0 4rem 1rem color-mix(in oklab, var(--color-coral) 22%, transparent); }
  .md-pantalla { overflow: hidden; background: #121213; box-shadow: 0 0 0 1.5px #121213; }
  .md-pantalla img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .md-caja { outline: 0.5px dashed color-mix(in oklab, #F5F5F7 80%, transparent); outline-offset: 2px; }
  .md-caja span { position: absolute; left: 0; top: 100%; margin-top: 3px; font-size: 3.5px; white-space: nowrap; color: #F5F5F7; }
  .md-despiece { perspective: 60rem; }
  .md-pila { position: relative; width: 52%; margin-top: 12%; aspect-ratio: 16 / 9; transform-style: preserve-3d; transform: rotateX(56deg) rotateZ(-34deg); }
  .md-capa { position: absolute; inset: 0; transform-style: preserve-3d; border-radius: 4px; transition: transform 0.9s var(--ease-out-expo); }
  .md-capa img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }
  .md-capa b { position: absolute; left: 100%; top: 50%; margin-left: 0.75rem; white-space: nowrap; color: #F5F5F7; transform: rotateZ(34deg) rotateX(-56deg); transform-origin: 0 0; }
  .md-capa.c1 { transform: translateZ(0); }
  .md-capa.c1 img { opacity: 0.85; }
  .md-capa.c2 { transform: translateZ(1.75rem); }
  .md-capa.c2 i { position: absolute; left: 38.56%; top: 36.22%; width: 22.72%; height: 22.52%; border-radius: 1.16% / 2.07%; box-shadow: 0 0 1.2rem 0.3rem color-mix(in oklab, var(--color-coral) 60%, transparent); }
  .md-capa.c3 { transform: translateZ(3.5rem); }
  .md-capa.c3 i { position: absolute; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; border-radius: 1px; background: #121213; box-shadow: 0 0 0 1px color-mix(in oklab, #F5F5F7 40%, transparent); }
  .md-capa.c4 { inset: auto; left: 39.03%; top: 36.96%; width: 21.78%; height: 21.04%; transform: translateZ(5.25rem); }
  .md-capa.c4 img { object-position: top; border-radius: 1px; }
  .md-capa.c4 b { left: 280%; top: 62%; } /* el borde derecho y la mitad de la pila, medidos desde la caja de la web */
  .md-despiece:hover .c2 { transform: translateZ(2.5rem); }
  .md-despiece:hover .c3 { transform: translateZ(5rem); }
  .md-despiece:hover .c4 { transform: translateZ(7.5rem); }
  .md-capas { margin-top: calc(var(--spacing) * 6); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: calc(var(--spacing) * 4) calc(var(--spacing) * 8); counter-reset: md; max-width: 64rem; }
  @media (width < 48rem) { .md-capas { grid-template-columns: 1fr; } .md-capa b { display: none; } }
  .md-capas li { line-height: 1.5; color: var(--fg2); }
  .md-capas b { color: var(--fg); font-weight: 500; }
  .md-capas code, .comp-d code { font-family: var(--font-mono); font-size: 0.92em; color: var(--fg); }
  @media (prefers-reduced-motion: reduce) { .md-capa { transition: none; } }
  .demos { aspect-ratio: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: calc(var(--spacing) * 6); padding: calc(var(--spacing) * 14) calc(var(--spacing) * 6); }
  .placa.clara.demos { flex-direction: column; }
  .buscar-demo { display: flex; align-items: center; width: min(100%, 30rem); height: 44px; padding: 4px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--rule); font-size: var(--text-ui); }
  .bd-l { flex: 1; display: flex; align-items: center; gap: 8px; padding-inline: 12px; color: var(--fg2); }
  .bd-f { position: relative; display: inline-flex; align-items: center; gap: 8px; height: 100%; padding-inline: 16px; font-weight: 500; color: var(--fg2); }
  .bd-f::before { content: ''; position: absolute; left: 0; top: 25%; bottom: 25%; width: 1px; background: var(--rule); }
  .bd-f b { display: grid; place-items: center; min-width: 20px; height: 20px; border-radius: 999px; background: #302018; color: #eadde7; font: 400 11px var(--font-mono); }
  .buscar-demo svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; }
  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; }
  .chips span { display: inline-flex; align-items: center; gap: 4px; height: 32px; padding-inline: 12px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--rule); font-size: 0.875rem; color: color-mix(in oklab, #302018 75%, transparent); }
  .chips sup { font: 400 10px var(--font-mono); opacity: 0.6; vertical-align: 0; }
  .chips .on { background: #302018; color: #eadde7; box-shadow: none; }
  .par { --par-ease: cubic-bezier(0.25, 1, 0.5, 1); position: relative; isolation: isolate; overflow: hidden; display: grid; gap: calc(var(--spacing) * 3); align-content: start; padding: calc(var(--spacing) * 6); border: 1px solid var(--rule); border-radius: var(--radius-lg); transition: border-color 0.6s var(--par-ease); }
  .par::before { content: ''; position: absolute; z-index: -1; left: var(--gx, 50%); top: var(--gy, 50%); width: var(--gd, 260%); aspect-ratio: 1; border-radius: 47% 53% 44% 56% / 55% 45% 57% 43%; background: var(--fg); transform: translate(-50%, -50%) scale(0); transition: transform 0.8s cubic-bezier(0.33, 1, 0.68, 1); pointer-events: none; }
  .par:hover::before { transform: translate(-50%, -50%) scale(1) rotate(24deg); }
  .despues { text-align: right; justify-items: end; }
  .pd { display: inline-flex; align-items: center; gap: calc(var(--spacing) * 2); color: var(--fg2); transition: color 0.45s var(--par-ease); }
  .pt { font-family: var(--font-display); font-size: 1.5rem; line-height: 1.15; color: color-mix(in oklab, var(--fg) 82%, transparent); transition: color 0.45s var(--par-ease); }
  .par:hover { border-color: var(--fg); }
  .par:hover .pd { color: color-mix(in oklab, var(--bg) 72%, transparent); transition-delay: 0.15s; }
  .par:hover .pt { color: var(--bg); transition-delay: 0.15s; }
  .escuchando { display: inline-flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 999px; background: color-mix(in oklab, #eadde7 9%, transparent); font-size: var(--text-ui); font-weight: 500; }
  .caras { display: flex; }
  .caras img { width: 30px; height: 30px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px #302018; }
  .caras img + img { margin-left: -8px; }
  .nivel { display: inline-flex; align-items: center; gap: 2px; height: 12px; }
  .nivel i { width: 2px; height: 100%; border-radius: 2px; background: color-mix(in oklab, #eadde7 70%, transparent); animation: bb-nivel 1.1s ease-in-out infinite alternate; }
  .nivel i:nth-child(2) { animation-delay: -0.4s; }
  .nivel i:nth-child(3) { animation-delay: -0.8s; }
  .nivel i:nth-child(4) { animation-delay: -0.2s; }
  @keyframes bb-nivel { from { scale: 1 0.25; } to { scale: 1 1; } }
  .checks { display: flex; gap: 14px; }
  .checks :global(.chk) { width: 30px; height: 30px; fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .checks :global(.chk circle) { fill: #302018; stroke: #302018; }
  .checks :global(.chk path) { stroke: #eadde7; stroke-width: 1.4; stroke-dasharray: 1; animation: bb-check 2.4s ease infinite; }
  .checks :global(.chk:nth-child(2) path) { animation-delay: 0.3s; }
  .checks :global(.chk:nth-child(3) path) { animation-delay: 0.6s; }
  @keyframes bb-check { 0%, 10% { stroke-dashoffset: 1; } 30%, 100% { stroke-dashoffset: 0; } }
  .rejilla-menu { display: grid; grid-template-columns: repeat(3, 6px); gap: 6px; }
  .rejilla-menu i { width: 6px; height: 6px; border-radius: 50%; background: #302018; }

  /* ── TEXTURA Y MOVIMIENTO */
  .grano { background: #eadde7; box-shadow: inset 0 0 0 1px var(--rule); }
  .semitono { background: radial-gradient(circle, rgb(48 32 24 / 0.55) 1.15px, transparent 1.7px) 0 0 / 8px 8px, radial-gradient(circle, rgb(48 32 24 / 0.55) 1.15px, transparent 1.7px) 4px 4px / 8px 8px, color-mix(in oklab, #302018 5%, #eadde7); }
  .carriles-d i { position: absolute; display: block; font-style: normal; }
  .cr-v { top: 0; bottom: 0; width: 1px; background: color-mix(in oklab, #302018 25%, transparent); }
  .cr-v.a { left: 18%; } .cr-v.b { right: 18%; }
  .cr-h { left: 0; right: 0; top: 40%; height: 1px; background: color-mix(in oklab, #302018 25%, transparent); }
  .cr-x { top: 40%; translate: -50% -52%; font: 300 16px var(--font-mono); color: #302018; }
  .cr-x.a { left: 18%; } .cr-x.b { left: 82%; }
  .curva svg { width: 60%; fill: none; stroke: var(--color-coral); stroke-width: 1.6; stroke-linecap: round; overflow: visible; }
  .bola { fill: #302018; stroke: none; offset-path: path('M4 56 C 20 8, 40 4, 96 4'); animation: bb-curva 2.4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes bb-curva { 0% { offset-distance: 0%; } 70%, 100% { offset-distance: 100%; } }
  .pal { display: inline-flex; gap: 0.25em; font-size: 2rem; overflow: hidden; padding-block: 0.1em; }
  .pal span { display: inline-block; animation: bb-pal 3s cubic-bezier(0.16, 1, 0.3, 1) infinite both; }
  .pal span:nth-child(2) { animation-delay: 0.08s; } .pal span:nth-child(3) { animation-delay: 0.16s; }
  @keyframes bb-pal { 0% { translate: 0 110%; } 30%, 100% { translate: 0 0; } }
  .enf { font-size: 1.125rem; animation: bb-enf 3s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes bb-enf { 0% { filter: blur(8px); opacity: 0.2; } 40%, 100% { filter: blur(0); opacity: 1; } }
  .campana { background: color-mix(in oklab, #302018 5%, #eadde7); box-shadow: inset 0 0 0 1px var(--rule); }
  .cp { position: absolute; inset: 0; background: #302018; animation: bb-cp 3.2s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes bb-cp { 0% { clip-path: ellipse(0% 0% at 50% 100%); } 70%, 100% { clip-path: ellipse(90% 120% at 50% 100%); } }
  .campana figcaption { color: #eadde7; z-index: 1; }
  .rg { position: absolute; inset: 18% 22% 22%; background: url('/media/hero/arbol-otono.webp') center / contain no-repeat; -webkit-mask: url('/media/rasgo-circulo.png') 50% 100% / 0% 0% no-repeat; mask: url('/media/rasgo-circulo.png') 50% 100% / 0% 0% no-repeat; animation: bb-rg 3.4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  @keyframes bb-rg { 0% { -webkit-mask-size: 0% 0%; mask-size: 0% 0%; } 70%, 100% { -webkit-mask-size: 260% 260%; mask-size: 260% 260%; } }
  .liq { position: relative; isolation: isolate; overflow: hidden; display: inline-grid; place-items: center; height: 48px; padding-inline: 24px; border-radius: 999px; box-shadow: inset 0 0 0 1px #302018; font-weight: 500; transition: color 0.45s ease; }
  .liq::before { content: ''; position: absolute; z-index: -1; left: 10%; top: 50%; width: 260%; aspect-ratio: 1; border-radius: 47% 53% 44% 56% / 55% 45% 57% 43%; background: #302018; transform: translate(-50%, -50%) scale(0); transition: transform 0.7s cubic-bezier(0.33, 1, 0.68, 1); }
  .liquido-d:hover .liq { color: #eadde7; }
  .liquido-d:hover .liq::before { transform: translate(-50%, -50%) scale(1) rotate(28deg); }
  .gota-d { width: 28px; height: 28px; border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%; background: radial-gradient(circle at 35% 30%, #fff 0 12%, transparent 13%), radial-gradient(circle, rgb(255 243 228 / 0.15), rgb(48 32 24 / 0.35)); box-shadow: inset 0 -3px 6px rgb(48 32 24 / 0.25), 0 6px 10px -6px rgb(48 32 24 / 0.5); animation: gota-cae 2.4s cubic-bezier(0.55, 0, 0.85, 0.45) infinite; }
  @keyframes gota-cae { 0% { translate: 0 -60px; opacity: 0; } 15% { opacity: 1; } 80% { translate: 0 30px; opacity: 1; } 100% { translate: 0 30px; opacity: 0; scale: 1.6 0.3; } }
  .onda-b { display: flex; align-items: center; gap: 3px; height: 40px; width: 60%; }
  .onda-b i { flex: 1; height: 100%; border-radius: 2px; background: color-mix(in oklab, #eadde7 38%, transparent); animation: bb-ola 1.1s ease-in-out calc(var(--k) * -0.13s) infinite alternate, bb-turno 4s ease infinite; }
  @keyframes bb-ola { from { scale: 1 0.25; } to { scale: 1 1; } }
  @keyframes bb-turno { 0%, 30%, 80%, 100% { background: color-mix(in oklab, #eadde7 38%, transparent); } 40%, 70% { background: var(--color-coral); } }
  .est-cic { position: relative; width: 56px; height: 56px; }
  .est-cic i { position: absolute; inset: 0; color: var(--c); animation: bb-est 8s ease infinite; opacity: 0; }
  .est-cic i :global(svg) { width: 100%; height: 100%; }
  .est-cic i:nth-child(2) { animation-delay: 2s; } .est-cic i:nth-child(3) { animation-delay: 4s; } .est-cic i:nth-child(4) { animation-delay: 6s; }
  @keyframes bb-est { 0% { opacity: 0; scale: 0.6; } 6%, 25% { opacity: 1; scale: 1; } 31%, 100% { opacity: 0; scale: 1.1; } }

  /* RONDA 155 · movimiento solo de naturaleza: raíces que crecen, la hoja que cae y se posa, brotar */
  .raices-d svg { width: 44%; translate: 0 -10%; fill: none; stroke: var(--color-cacao); stroke-width: 1.1; stroke-linecap: round; overflow: visible; }
  .raices-d circle { fill: var(--color-coral); stroke: none; }
  .raices-d path { stroke-dasharray: 100; stroke-dashoffset: 100; animation: bb-raiz 4.2s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  .raices-d path:nth-of-type(n + 2) { stroke-width: 0.7; animation-delay: 0.5s; }
  .raices-d path:nth-of-type(n + 4) { animation-delay: 0.9s; }
  @keyframes bb-raiz { 0% { stroke-dashoffset: 100; } 55%, 85% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  .hj { position: relative; width: 100%; height: 100%; }
  .hj :global(svg) { position: absolute; left: 44%; top: 0; width: 26px; height: 26px; color: #C65C2D; animation: bb-hoja 5s cubic-bezier(0.37, 0, 0.63, 1) infinite; }
  .hoja-d::after { content: ''; position: absolute; left: 22%; right: 22%; bottom: 26%; height: 1px; background: var(--rule); }
  @keyframes bb-hoja { 0% { translate: 0 -10%; rotate: -20deg; opacity: 0; } 8% { opacity: 1; } 30% { translate: 34px 22%; rotate: 25deg; } 52% { translate: -18px 40%; rotate: -15deg; } 70%, 92% { translate: 8px 57%; rotate: 78deg; opacity: 1; } 100% { translate: 8px 57%; rotate: 78deg; opacity: 0; } }
  .br { width: 34%; overflow: visible; }
  .br .tallo, .br .suelo { fill: none; stroke: var(--color-cacao); stroke-width: 1.4; stroke-linecap: round; }
  .br .suelo { stroke: var(--rule); stroke-width: 1; }
  .br .tallo { stroke-dasharray: 30; stroke-dashoffset: 30; animation: bb-tallo 4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  .br .h1, .br .h2 { fill: #8DB84A; transform-box: fill-box; scale: 0; animation: bb-brota 4s cubic-bezier(0.16, 1, 0.3, 1) infinite; }
  .br .h1 { transform-origin: 100% 100%; animation-delay: 0.6s; } .br .h2 { transform-origin: 0% 100%; animation-delay: 0.85s; fill: #6F9A4E; }
  @keyframes bb-tallo { 0% { stroke-dashoffset: 30; opacity: 1; } 40%, 85% { stroke-dashoffset: 0; opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 0; } }
  @keyframes bb-brota { 0% { scale: 0; opacity: 1; } 40%, 70% { scale: 1; opacity: 1; } 85%, 100% { scale: 1; opacity: 0; } }

  /* RONDA 155 · iconografía */
  .ic-est { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; margin-top: calc(var(--spacing) * 10); }
  .ic-e { position: relative; margin: 0; aspect-ratio: 3 / 4; border-radius: 4px; background: var(--f); color: var(--t); display: grid; place-items: center; overflow: hidden; }
  .ic-e :global(svg) { width: 38%; height: auto; color: var(--s); transition: scale 0.9s cubic-bezier(0.16, 1, 0.3, 1); }
  .ic-e:hover :global(svg) { scale: 1.08; }
  .ic-e figcaption { position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 2px; padding: calc(var(--spacing) * 4); }
  .ic-e figcaption .font-display { font-size: 1.35rem; }
  .ic-e figcaption .detail { opacity: 0.6; }
  .ic-e.clara { box-shadow: inset 0 0 0 1px var(--rule); }
  .ic-par { display: grid; grid-template-columns: 5fr 7fr; gap: 6px; margin-top: 6px; }
  .ic-cons { position: relative; margin: 0; min-height: 18rem; border-radius: 4px; background: var(--color-cacao); color: #F5F5F7; display: grid; place-items: center; overflow: hidden; }
  .ic-rej, .ic-cons :global(.ic-gr) { grid-area: 1 / 1; height: 68%; width: auto; aspect-ratio: 1; }
  .ic-cons { padding-bottom: calc(var(--spacing) * 6); }
  .ic-rej line { stroke: rgb(245 245 247 / 0.09); stroke-width: 0.04; }
  .ic-rej .k { fill: none; stroke: var(--color-coral); stroke-width: 0.05; opacity: 0.7; }
  .ic-rej .zona { fill: none; stroke: rgb(245 245 247 / 0.35); stroke-width: 0.05; stroke-dasharray: 0.3 0.3; }
  .ic-cons :global(.ic-gr) { color: #F5F5F7; }
  .ic-cons :global(.ic-gr) { fill: none; } .ic-cons :global(.ic-gr path) { stroke-width: 1.5; }
  .ic-cota { position: absolute; left: calc(var(--spacing) * 4); right: calc(var(--spacing) * 4); bottom: calc(var(--spacing) * 3); display: flex; justify-content: space-between; gap: 8px; opacity: 0.6; }
  .ic-ui { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; }
  .ic-c { position: relative; display: grid; place-items: center; align-content: center; gap: calc(var(--spacing) * 2); border-radius: 4px; background: #F5F5F7; box-shadow: inset 0 0 0 1px var(--rule); color: var(--color-cacao); padding: calc(var(--spacing) * 4) 0; transition: background 0.5s ease; }
  .ic-c :global(svg) { width: 1.9rem; height: 1.9rem; }
  .ic-c .detail { color: color-mix(in oklab, var(--color-cacao) 70%, transparent); }
  .ic-c .ic-p { position: absolute; top: calc(var(--spacing) * 2); right: calc(var(--spacing) * 2.5); font-size: 0.6875rem; opacity: 0.6; }
  .ic-c:hover { background: color-mix(in oklab, var(--color-coral) 14%, #F5F5F7); }
  .cat-g ul { gap: 0 !important; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); grid-template-columns: repeat(auto-fill, minmax(6.5rem, 1fr)) !important; }
  .cat-g li { aspect-ratio: 1; align-content: center; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); transition: background 0.4s ease; }
  .cat-g li:hover { background: color-mix(in oklab, var(--color-coral) 12%, transparent); }
  .cat-g li :global(svg) { width: 1.75rem !important; height: 1.75rem !important; }
  @media (width < 48rem) {
    .ic-est { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ic-par { grid-template-columns: 1fr; }
    .ic-ui { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* RONDA 155 · aplicaciones en escenas */
  .apl { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 6px; margin-top: calc(var(--spacing) * 10); }
  .apl-p { position: relative; margin: 0; border-radius: 4px; overflow: hidden; display: grid; place-items: center; }
  .apl-pie { position: absolute; left: calc(var(--spacing) * 4); bottom: calc(var(--spacing) * 3); right: calc(var(--spacing) * 4); opacity: 0.6; }
  .apl-tarjetas { grid-column: span 7; aspect-ratio: 7 / 5; background: radial-gradient(120% 90% at 30% 20%, #f3ece4, #e2d6ca); color: var(--color-cacao); }
  .apl-tarjetas .tarjeta-v { grid-area: 1 / 1; width: 44%; box-shadow: 0 1px 1px rgb(48 32 24 / 0.15), 0 14px 24px -12px rgb(48 32 24 / 0.45), 0 40px 60px -30px rgb(48 32 24 / 0.35); }
  /* ronda 266 · «algunas se ven raras»: las dos caras se separan (el reverso se lee: su texto arriba a la izquierda, donde no lo tapa el anverso) */
  .apl-tarjetas .tarjeta-v.dorso { rotate: -6deg; translate: -54% -6%; background: #F5F5F7; color: var(--color-cacao); place-items: start; align-content: start; }
  .apl-tarjetas .cara { rotate: 4deg; translate: 54% 8%; background: var(--color-cacao); color: #F5F5F7; display: grid; place-items: center; gap: 0.343em; font-size: clamp(1rem, 2.6vw, 1.9rem); }
  .apl-tarjetas .tv-lock { font-size: clamp(1.3rem, 3.2vw, 2.5rem); translate: 0 -0.08em; }
  .tv-sombra { display: none; }
  .apl-chat { grid-column: span 5; aspect-ratio: 5 / 5; background: var(--color-cacao); color: #F5F5F7; }
  .chat { display: grid; gap: 8px; width: 78%; font-size: 0.9375rem; line-height: 1.35; margin-bottom: calc(var(--spacing) * 10); }
  .burbuja { margin: 0; max-width: 86%; padding: 10px 14px; border-radius: 18px; }
