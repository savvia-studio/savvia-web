  .m-rama { position: relative; min-width: 0; }
  .m-rama::before { content: ''; position: absolute; left: 50%; top: calc(var(--spacing) * -6); height: calc(var(--spacing) * 6); border-left: 1px solid var(--rule-strong); }
  .m-pag { display: flex; flex-direction: column; gap: calc(var(--spacing) * 1); padding: calc(var(--spacing) * 4); border-radius: var(--radius-lg); background: #F5F5F7; color: var(--color-cacao); box-shadow: inset 0 0 0 1px var(--rule); transition: box-shadow 0.3s ease, transform 0.3s cubic-bezier(.16,1,.3,1); }
