const OPC_FIRMA: { id: string; n: string; nEn?: string }[] = [{ id: 'trazos', n: 'Trazo arriba', nEn: 'Stroke on top' }]; // RONDA 307, 24.ª: una sola firma (las demás, en el historial)
// las que cambian con la estación llevan {est} y {estn}; el selector los cambia por la de hoy (la de la web)
const img = (base: string, f: string, w: number, h: number, extra = '') => `<img src="${base}/descargas/savvia-firma-${f}.png" width="${w}" height="${h}" alt="savvia" style="display:block;border:0;width:${w}px;height:${h}px;${extra}">`;
const lin = (t: string, extra = '') => `<tr><td style="font-size:15px;line-height:22px;color:#3B231B;${extra}">${t}</td></tr>`;
