const GUARDARRAILES_EN: Fila[] = [
  ['npx astro check', 'Zero errors before anything counts as done.'],
  ['npx astro build', 'That it builds. Do not run it while another tool’s development server is writing to dist/ at the same time.'],
  ['node tools/spacing-lint.cjs', 'That every spacing is on the scale of the guide: 1 2 3 4 6 8 12 16 24 32 (+ 14 on mobile).'],
  ['node tools/verify.cjs <url>', 'Real Chrome and WebKit, at 1280×720 and 390×844: clean console, zero responses ≥ 400 and no overflow.'],
  ['lvh and dvh, never vh', 'Screen heights, in lvh or dvh: vh jumps on mobile when the browser bar moves.'],
  ['<script is:inline> in the head', 'Whatever has to be there in the first frame (the season, the page class). Otherwise, it flickers.'],
  ['grep before a global class', 'Before introducing a new class or global selector, search for it. In round 155 a new .ia painted the AI pixel in the footer.'],
  ['// on its own line', 'A // comment never with code after it on the same line: it swallows the rest and breaks the script (it happened three times).'],
