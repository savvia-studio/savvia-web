---
import { home } from '../data/idioma';
import { langDe } from '../lib/i18n';
import personasEs from '../data/personas.json';
import personasEn from '../data/personas.en.json';
const lang = langDe(Astro.currentLocale);
const personas = lang === 'en' ? personasEn : personasEs;
const { pie } = home(lang);
const T = lang === 'en'
  ? { abrir: 'Open the chat', hola: 'Shall we talk?', chat: 'Chat with Eric and Andoni', nombres: 'Eric and Andoni', suelen: 'We usually reply the same day', cerrar: 'Close the chat', escribe: 'Write your message', ph: 'Write a question…', enviar: 'Send', prefieres: 'Prefer email?' }
  : { abrir: 'Abrir el chat', hola: '¿Hablamos?', chat: 'Chat con Eric y Andoni', nombres: 'Eric y Andoni', suelen: 'Solemos contestar en el día', cerrar: 'Cerrar el chat', escribe: 'Escribe tu mensaje', ph: 'Escribe una pregunta…', enviar: 'Enviar', prefieres: '¿Prefieres el correo?' };
// el icono de chat es el propio (burbuja con rabillo, trazo 1,7), no el de Iconoir: Eric lo prefirió
const chatR = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"><path d="M4.5 6.5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v7.5a2 2 0 0 1-2 2H11l-4.2 3.2v-3.2H6.5a2 2 0 0 1-2-2z"></path></svg>';
import plegarR from 'iconoir/icons/regular/nav-arrow-down.svg?raw';
import xR from 'iconoir/icons/regular/xmark.svg?raw';
import enviarR from 'iconoir/icons/regular/nav-arrow-right.svg?raw';
const ico = (svg: string) => svg.replace(/\s(width|height)="24"/g, '').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const CARA = ['/media/equipo/cara-andoni-transparente.webp', '/media/equipo/cara-eric-transparente.webp'];
---

<!--
  CHAT FLOTANTE · PROTOTIPO (ronda 206, puesto siempre desde la ronda 205; ?chat=0 lo quita en esa sesión). La conversación de «Preguntas» como panel plegable abajo a la derecha, con un
  BRIEF guiado que se adapta a los tres servicios (End-to-end · Colaboración · Consultoría) y las preguntas libres siempre disponibles.
  · Cerrado: círculo de cristal (el mismo del (+) de la ronda 21) con un píxel Iris, que es el detalle de IA. No aparece en el hero: entra tras la primera
    pantalla y se esconde cuando se ve la sección «Pregunta» (ahí ya está la conversación entera) y mientras el menú está abierto o se está sentado.
  · Abierto: el panel se DIBUJA desde el botón con el mismo `dibujar()` que el menú (radio 12). Nunca se abre solo.
  · Datos: src/data/brief.json (pasos y reacciones) · src/data/preguntas.json (las respuestas escritas) · src/data/personas.json · api/preguntar.js.
  · PROTOTIPO: aún NO envía nada. Al terminar, el resumen queda en pantalla y se avisa.
-->
<div class="cf cf-fuera" data-cf hidden data-cal={pie.cal} data-correo={pie.correo} data-caras={JSON.stringify(CARA)} data-personas={JSON.stringify(personas)}>
  <i class="cf-velo" aria-hidden="true"></i>
  <button type="button" class="cf-btn" data-cf-btn aria-expanded="false" aria-controls="cf-panel" aria-label={T.abrir}>
    <span class="cf-ic cf-ic-chat" set:html={ico(chatR)} />
    <span class="cf-ic cf-ic-plegar" set:html={ico(plegarR)} />
  </button>
  <button type="button" class="cf-hola" data-cf-hola tabindex="-1" aria-hidden="true">{T.hola}</button>
  <section class="cf-panel surface-light" id="cf-panel" role="dialog" aria-label={T.chat} data-cf-panel hidden>
    <header class="cf-cab">
      <span class="cf-caras" aria-hidden="true"><img src={CARA[1]} alt="" width="72" height="72" /><img src={CARA[0]} alt="" width="72" height="72" /></span>
      <span class="cf-quien"><b>{T.nombres}</b><small>{T.suelen}</small></span>
      <button type="button" class="cf-x" data-cf-x aria-label={T.cerrar}><span set:html={ico(xR)} /></button>
    <i class="cf-linea" data-cf-linea aria-hidden="true"></i>
    </header>
    <div class="cf-lista" role="log" aria-live="polite" data-cf-lista></div>
    <form class="cf-form" data-cf-form novalidate>
      <label for="cf-campo" class="sr-only">{T.escribe}</label>
      <input id="cf-campo" type="text" maxlength="160" autocomplete="off" placeholder={T.ph} data-cf-campo />
      <button type="submit" class="cf-mandar" aria-label={T.enviar} data-cf-mandar><span set:html={ico(enviarR)} /></button>
    </form>
    <p class="cf-mail">{T.prefieres} <a class="link" href={`mailto:${pie.correo}`} data-copiar={pie.correo}>{pie.correoTexto}</a></p>
  </section>
</div>

<script>
  import { t } from '../scripts/i18n';
  import { mejorFicha } from '../scripts/buscar-ficha';
  import briefEs from '../data/brief.json';
  import briefEn from '../data/brief.en.json';
  import fichasEs from '../data/preguntas.json';
  import fichasEn from '../data/preguntas.en.json';
  import { dibujar } from '../scripts/dibujar';
  import { tinta } from '../scripts/tinta';

  type Opcion = { t: string; r?: string; ruta?: string };
  type Paso = { q: string; tipo: string; opciones?: Opcion[]; ph?: string; r?: string };
  type Cta = { t: string; h: string; enlace?: boolean };
  const brief = t(briefEs, briefEn);
  const fichasJson = t(fichasEs, fichasEn);
  const fichas = fichasJson as { q: string; a: string; claves: string[]; ctas?: Cta[] }[];
  const PASOS = brief.pasos as Record<string, Paso>;
  const RUTAS = brief.rutas as Record<string, string[]>;

  const raiz = document.querySelector<HTMLElement>('[data-cf]');
  const local = ['localhost', '127.0.0.1'].includes(location.hostname); // en local, el prototipo va puesto siempre y visible desde el hero (?chat=0 lo quita; ?chat=1 solo tras la primera pantalla)
  const activo = (() => {
    try {
      const q = new URLSearchParams(location.search);
      if (q.has('chat')) sessionStorage.setItem('savvia:chat', q.get('chat') === '0' ? '0' : q.get('chat') === 'hero' ? 'hero' : '1');
      return sessionStorage.getItem('savvia:chat') ?? '1';
    } catch { return new URLSearchParams(location.search).get('chat') ?? '1'; }
  })();
  const enHero = activo === 'hero'; // ?chat=hero: también visible desde el hero, para decidir si queda o no
  if (raiz && activo !== '0') {
    raiz.hidden = false;
    raiz.classList.toggle('cf-local', local);
    const cfg = raiz.dataset;
    const caras: string[] = JSON.parse(cfg.caras!);
    const personas: Record<string, string>[] = JSON.parse(cfg.personas!);
    const cal = cfg.cal || '', correo = cfg.correo!;
    const btn = raiz.querySelector<HTMLButtonElement>('[data-cf-btn]')!;
    const panel = raiz.querySelector<HTMLElement>('[data-cf-panel]')!;
    const lista = raiz.querySelector<HTMLElement>('[data-cf-lista]')!;
    const form = raiz.querySelector<HTMLFormElement>('[data-cf-form]')!;
    const campo = raiz.querySelector<HTMLInputElement>('[data-cf-campo]')!;
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const esperar = (ms: number) => new Promise<void>((r) => setTimeout(r, reducido ? 0 : ms));

    // `{yo}` = quien contesta · `{otro}` = su compañero · `{yo.ciudad}`… · `{nombre}` = lo que escribió el visitante
    let quien = Math.random() < 0.5 ? 0 : 1;
    const datos: Record<string, string> = {};
    const resolver = (t: string) =>
      t.replace(/\{donostia\}/g, 'Donostia')
        .replace(/\{nombre\}/g, datos.nombre || '')
        .replace(/\{(yo|otro)(?:\.(\w+))?\}/g, (_, w, k) => personas[w === 'yo' ? quien : 1 - quien][k || 'nombre']);

    // ── APARECER / DESAPARECER el botón: nunca en el hero; no con «Pregunta» a la vista, ni con el menú abierto ni sentado
    const html = document.documentElement;
    let abierto = false, preguntasVisible = false, pieCerca = false;
    let desdeOculto = false; // se abrió estando el botón escondido (p. ej. desde «Contáctanos» del pie): el botón NO asoma ni mientras está abierto ni al cerrar (Eric: «sale por un segundo el icono»)
    // el color del icono: el fondo REAL que tiene debajo (en invierno el hero es claro, en otoño oscuro): el primer elemento con color de fondo sólido
    const luminancia = (c: string) => {
      const m = c.match(/[\d.]+/g); if (!m || m.length < 3) return null;
      if (m.length > 3 && +m[3] < 0.6) return null; // transparente: se mira lo de debajo
      const [r, g, b] = m.slice(0, 3).map((v) => { const x = +v / 255; return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4; });
      return 0.2126 * r + 0.7152 * g + 0.0722 * b;
    };
    const fondoClaro = () => {
      const rb = btn.getBoundingClientRect(), x = rb.left + rb.width / 2, y = rb.top + rb.height / 2;
      for (const e of document.elementsFromPoint(x, y)) {
        if (raiz.contains(e)) continue;
        const l = luminancia(getComputedStyle(e).backgroundColor);
        if (l !== null) return l > 0.4;
      }
      return (luminancia(getComputedStyle(html).backgroundColor) ?? 0) > 0.4;
    };
    const heroEl = document.querySelector('[data-hero]');
    let raf = 0;
    const refrescarBtn = () => {
      const lejos = enHero || (scrollY > 0 && (heroEl ? heroEl.getBoundingClientRect().bottom < innerHeight * 0.8 : scrollY > innerHeight * 0.9)); // RONDA 264 · Eric: «discreto»: nada en el hero; aparece en cuanto asoma la segunda sección (el borde del hero sube del 80 % de la pantalla)
      const oculto = !lejos || preguntasVisible || pieCerca || html.classList.contains('menu-abierto') || html.classList.contains('estudio-sentado');
      raiz.classList.toggle('cf-fuera', oculto && (!abierto || desdeOculto));
      if (!abierto) desdeOculto = false;
      if (!raf) raf = requestAnimationFrame(() => { raf = 0; raiz.classList.toggle('cf-claro', fondoClaro()); });
    };
    addEventListener('scroll', refrescarBtn, { passive: true });
    addEventListener('resize', refrescarBtn);
    new MutationObserver(refrescarBtn).observe(html, { attributes: true, attributeFilter: ['class'] });
    const sec = document.getElementById('preguntas');
    if (sec) new IntersectionObserver((es) => { preguntasVisible = es[0].isIntersecting; refrescarBtn(); }, { threshold: 0.15 }).observe(sec);
    refrescarBtn();

    // ── «¿Hablamos?»: un susurro junto al icono. A los 8 s de verlo, se queda 5 s y se va; vuelve cada 45 s, hasta HOLA_MAX veces por visita.
    //    Si el visitante abre el chat, no vuelve. (Decisión pendiente de Eric: cuántas veces y cada cuánto.)
    const hola = raiz.querySelector<HTMLElement>('[data-cf-hola]')!;
    hola.addEventListener('click', () => btn.click()); // también es clicable: abre el chat
    const HOLA_MAX = 3, HOLA_CADA = 45000;
    let holaVeces = 0, holaFin = false;
    try { holaVeces = +(sessionStorage.getItem('savvia:chat-hola') ?? 0); } catch {}
    if (!reducido) {
      const intentar = (espera: number) => setTimeout(() => {
        if (holaFin || holaVeces >= HOLA_MAX) return;
        if (abierto || raiz.classList.contains('cf-fuera')) return intentar(3000);
        holaVeces++;
        try { sessionStorage.setItem('savvia:chat-hola', String(holaVeces)); } catch {}
        raiz.classList.add('cf-hola-on');
        setTimeout(() => { raiz.classList.remove('cf-hola-on'); intentar(HOLA_CADA); }, 5000);
      }, espera);
      btn.addEventListener('click', () => { holaFin = true; }, { once: true });
      intentar(8000);
    }

    // RONDA 228 · Eric: «que el ¿Hablamos? no aparezca en el pie: ya está el Contáctanos» (vuelve la palabra, que abre este mismo chat). En el pie solo queda el
    // icono; la palabra sale al pasar por encima, como en el resto de la página
    // (aparece ya cuando la gota del pie asoma por debajo de «Preguntas»: 80 px DESPUÉS de que el pie asome (margen negativo))
    const pie = document.querySelector('footer');
    if (pie) new IntersectionObserver((es) => { pieCerca = es[0].isIntersecting; raiz.classList.toggle('cf-hola-pie', pieCerca); refrescarBtn(); }, { rootMargin: '0px 0px -80px 0px' }).observe(pie);

    // el velo de fondo no va sobre el hero (el árbol se ve mejor sin desenfoque): mientras el hero ocupa la pantalla, se quita
    const hero = document.querySelector('[data-hero]');
    if (hero) new IntersectionObserver((es) => { raiz.classList.toggle('cf-en-hero', es[0].isIntersecting); refrescarBtn(); }, { threshold: 0.5 }).observe(hero);

    // ── ABRIR / CERRAR: el panel se dibuja desde el botón, como el menú
    const poner = (si: boolean, centrado = false) => {
      if (si === abierto) return;
      if (si) raiz.classList.toggle('cf-centrado', centrado); // desde «Contáctanos» del pie, el modal sale centrado en escritorio
      if (si) desdeOculto = raiz.classList.contains('cf-fuera');
      abierto = si;
      btn.setAttribute('aria-expanded', String(si));
      btn.setAttribute('aria-label', si ? t('Cerrar el chat', 'Close the chat') : t('Abrir el chat', 'Open the chat'));
      raiz.classList.toggle('cf-abierto', si);
      const rb = btn.getBoundingClientRect(), origen: [number, number] = raiz.classList.contains('cf-centrado') && innerWidth >= 1024 ? [innerWidth / 2, innerHeight / 2] : [rb.left + rb.width / 2, rb.top + rb.height / 2];
      const linea = tinta('cacao', 0.55);
      if (si) {
        panel.hidden = false;
        panel.classList.add('on');
        dibujar(panel, { estacion: true, abrir: true, origen, color: linea, alTerminar: () => campo.focus({ preventScroll: true }) });
        if (!arrancado) { arrancado = true; empezar(); }
        else setTimeout(() => campo.focus({ preventScroll: true }), reducido ? 0 : 900);
      } else {
        // como el menú: el panel sigue visible mientras la pintura se recoge hacia el botón; `on` se quita al terminar
        dibujar(panel, { estacion: true, abrir: false, origen, color: linea, alTerminar: () => { if (!abierto) { panel.classList.remove('on'); panel.hidden = true; } refrescarBtn(); } });
        btn.focus({ preventScroll: true });
      }
      refrescarBtn();
    };
    btn.addEventListener('click', () => poner(!abierto));
    raiz.querySelector('[data-cf-x]')!.addEventListener('click', () => poner(false));
    addEventListener('keydown', (e) => e.key === 'Escape' && abierto && poner(false));
    // clic fuera del chat = se pliega
    document.addEventListener('pointerdown', (e) => { if (abierto && !raiz.contains(e.target as Node)) poner(false); });
    new MutationObserver(() => html.classList.contains('menu-abierto') && abierto && poner(false)).observe(html, { attributes: true, attributeFilter: ['class'] });

    // ── la lista: difuminado de arriba y de abajo solo cuando hay conversación por encima o por debajo
    const bordes = () => {
      lista.classList.toggle('cf-desp', lista.scrollTop > 2);
      lista.classList.toggle('cf-mas', lista.scrollTop + lista.clientHeight < lista.scrollHeight - 2);
    };
    lista.addEventListener('scroll', bordes, { passive: true });
    new MutationObserver(bordes).observe(lista, { childList: true, subtree: true, characterData: true });
    const bajar = () => lista.scrollTo({ top: lista.scrollHeight, behavior: reducido ? 'auto' : 'smooth' });

    // ── mensajes
    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls: string, txt?: string) => { const e = document.createElement(tag); e.className = cls; if (txt !== undefined) e.textContent = txt; return e; };
    let ultimaCara: HTMLElement | null = null, ultimoQuien = -1;
    const escribiendo = el('div', 'cf-m cf-bot');
    escribiendo.innerHTML = `<span class="cf-cara"></span><p class="cf-b cf-pts" aria-label="${t('Está escribiendo', 'Typing')}"><i></i><i></i><i></i></p>`;
    const filaBot = (): HTMLElement => {
      const f = el('div', 'cf-m cf-bot');
      const cara = el('span', 'cf-cara'); const img = el('img', ''); img.alt = ''; img.width = 72; img.height = 72; img.src = caras[quien]; cara.append(img);
      if (ultimaCara && ultimoQuien === quien) ultimaCara.style.visibility = 'hidden';
      ultimaCara = cara; ultimoQuien = quien;
      f.append(cara);
      return f;
    };
    const quitarOpciones = () => lista.querySelectorAll('.cf-ops').forEach((e) => e.remove());
    const pensar = async (ms: number) => {
      const img = escribiendo.querySelector('.cf-cara')!;
      img.innerHTML = `<img src="${caras[quien]}" alt="" width="72" height="72">`;
      lista.append(escribiendo); bajar();
      await esperar(ms);
      escribiendo.remove();
    };
    const bot = async (textos: string[], ctas?: Cta[]) => {
      for (let i = 0; i < textos.length; i++) {
        const t = resolver(textos[i]);
        await pensar(Math.min(1500, 450 + t.length * 9));
        const f = filaBot();
        const burbuja = el('p', 'cf-b', t);
        f.append(burbuja);
        lista.append(f); bajar();
        if (ctas && i === textos.length - 1) {
          // RONDA 290 · Eric: el enlace «Respuesta rápida con IA…» va DENTRO del bocadillo de la respuesta, bajo el texto; los botones, fuera
          const dentro = ctas.filter((x) => x.enlace), fuera = ctas.filter((x) => !x.enlace);
          if (dentro.length) { const c = botones(dentro); c.className = 'cf-en-burbuja'; burbuja.append(c); }
          if (fuera.length) lista.append(botones(fuera));
          bajar();
        }
      }
    };
    const botones = (ctas: Cta[]) => {
      const c = el('div', 'cf-ctas');
      ctas.forEach((x, k) => {
        const a = el('a', x.enlace ? 'cf-por-correo' : k === 0 ? 'cf-cta cf-cta-1' : 'cf-cta', resolver(x.t));
        a.href = x.h === 'cal' ? cal || `mailto:${correo}` : resolver(x.h);
        if (/^https?:/.test(a.href)) { a.target = '_blank'; a.rel = 'noopener'; }
        if (a.href.startsWith('mailto:')) a.dataset.copiar = a.href.slice(7).split('?')[0];
        c.append(a);
      });
      return c;
    };
    const tu = (t: string) => { quitarOpciones(); const p = el('p', 'cf-b cf-tu', t); lista.append(p); bajar(); };
    const opciones = (items: string[], alElegir: (t: string, i: number) => void, extra?: { t: string; fn: () => void }) => {
      quitarOpciones();
      const c = el('div', 'cf-ops');
      items.forEach((t, i) => { const b = el('button', 'cf-op', t); b.type = 'button'; b.addEventListener('click', () => alElegir(t, i)); c.append(b); });
      if (extra) { const b = el('button', 'cf-op cf-op-s', extra.t); b.type = 'button'; b.addEventListener('click', extra.fn); c.append(b); }
      lista.append(c); bajar();
    };

    // ── el BRIEF
    const respuestas: { q: string; a: string }[] = [];
    let ruta = '', secuencia: string[] = [], idx = -1, paso: string | null = null, esperaTexto: null | { id: string; tipo: string; sig: () => void } = null, arrancado = false, ocupado = false;
    const total = () => secuencia.length + 1; // + contacto
    const linea = raiz.querySelector<HTMLElement>('[data-cf-linea]')!;
    const pintarProg = () => {
      if (!ruta) { linea.style.setProperty('--p', '0'); return; }
      const n = Math.min(Math.max(0, idx + 1), total()), t = total();
      linea.style.setProperty('--p', String(n / t));
    };
    const ponerCampo = (ph: string, bloqueo = false) => { campo.placeholder = ph; campo.type = 'text'; campo.dataset.modo = bloqueo ? 'texto' : 'libre'; };

    const empezar = async () => {
      ocupado = true;
      await bot(brief.saludo);
      await mostrarServicio();
      ocupado = false;
    };
    const mostrarServicio = async () => {
      await bot([...((brief.servicio as { expl?: string[] }).expl ?? []), brief.servicio.q]);
      paso = 'servicio';
      const ops = brief.servicio.opciones as Opcion[];
      opciones(ops.map((o) => o.t), async (t, i) => {
        if (ocupado) return; ocupado = true;
        tu(t); respuestas.push({ q: brief.servicio.q, a: t });
        ruta = ops[i].ruta!; secuencia = ['servicio', ...RUTAS[ruta]];
        idx = 0; pintarProg();
        quien = 1 - quien;
        await bot([ops[i].r!]);
        await siguiente();
        ocupado = false;
      }, { t: brief.servicio.solo.t, fn: async () => {
        if (ocupado) return; ocupado = true; quitarOpciones();
        tu(brief.servicio.solo.t); quien = 1 - quien; await bot([brief.servicio.solo.r]); ocupado = false;
      } });
    };
    const siguiente = async () => {
      idx++; pintarProg(); quien = 1 - quien;
      const id = secuencia[idx];
      if (!id) { await contacto(0); return; }
      await mostrarPaso(id);
    };
    const mostrarPaso = async (id: string) => {
      const p = PASOS[id]; paso = id;
      await bot([p.q]);
      if (p.tipo === 'texto') { esperaTexto = { id, tipo: 'texto', sig: siguiente }; ponerCampo(p.ph || t('Escribe aquí…', 'Write here…'), true); campo.focus({ preventScroll: true }); return; }
      if (p.tipo === 'varios') {
        const marcadas = new Set<string>();
        quitarOpciones();
        const c = el('div', 'cf-ops');
        p.opciones!.forEach((o) => {
          const b = el('button', 'cf-op', o.t); b.type = 'button'; b.setAttribute('aria-pressed', 'false');
          b.addEventListener('click', () => { const on = !marcadas.has(o.t); on ? marcadas.add(o.t) : marcadas.delete(o.t); b.setAttribute('aria-pressed', String(on)); listo.disabled = marcadas.size === 0; });
          c.append(b);
        });
        const listo = el('button', 'cf-op cf-op-ok', t('Listo', 'Done')); listo.type = 'button'; listo.disabled = true;
        listo.addEventListener('click', async () => {
          if (ocupado || !marcadas.size) return; ocupado = true;
          const t = [...marcadas].join(', ');
          tu(t); respuestas.push({ q: p.q, a: t }); quien = 1 - quien;
          if (p.r) await bot([p.r]);
          await siguiente(); ocupado = false;
        });
        c.append(listo); lista.append(c); bajar();
        return;
      }
      opciones(p.opciones!.map((o) => o.t), async (t, i) => {
        if (ocupado) return; ocupado = true;
        tu(t); respuestas.push({ q: p.q, a: t }); quien = 1 - quien;
        if (p.opciones![i].r) await bot([p.opciones![i].r!]);
        await siguiente(); ocupado = false;
      });
    };
    const contacto = async (k: number): Promise<void> => {
      const c = (brief.contacto as { id: string; q: string; ph: string; tipo: string }[])[k];
      if (!c) { await terminar(); return; }
      paso = 'contacto';
      await bot([c.q]);
      esperaTexto = { id: c.id, tipo: c.tipo, sig: () => contacto(k + 1) };
      ponerCampo(c.ph, true); campo.focus({ preventScroll: true });
      if (c.tipo === 'opcional') opciones([], () => {}, { t: t('Saltar', 'Skip'), fn: async () => { if (ocupado) return; ocupado = true; esperaTexto = null; tu(t('Saltar', 'Skip')); quien = 1 - quien; ponerCampo(t('Escribe una pregunta…', 'Write a question…')); await contacto(k + 1); ocupado = false; } });
    };
    const terminar = async () => {
      idx = secuencia.length; pintarProg(); ponerCampo(t('Escribe una pregunta…', 'Write a question…'));
      quien = 1 - quien;
      const fin = (brief.fin as string[]).map((t) => t);
      await pensar(700);
      const f = filaBot(); const r = el('div', 'cf-b cf-resumen');
      r.append(el('p', 'cf-rt', t('Esto es lo que nos has contado', 'This is what you told us')));
      respuestas.forEach((x) => { const l = el('p', 'cf-rl'); l.innerHTML = '<small></small><span></span>'; l.querySelector('small')!.textContent = x.q; l.querySelector('span')!.textContent = x.a; r.append(l); });
      ([['nombre', t('Nombre', 'Name')], ['email', 'Email'], ['mas', t('Algo más', 'Anything else')]] as const).forEach(([id, etiqueta]) => {
        if (!datos[id]) return;
        const l = el('p', 'cf-rl'); l.innerHTML = '<small></small><span></span>';
        l.querySelector('small')!.textContent = etiqueta; l.querySelector('span')!.textContent = datos[id];
        r.append(l);
      });
      f.append(r); lista.append(f); bajar();
      quien = 1 - quien;
      await bot(fin, [{ t: t('Reservar una llamada de 15 minutos', 'Book a 15-minute call'), h: 'cal' }, { t: t('Contactar vía email', 'Contact via email'), h: `mailto:${correo}` }]);
      (window as any).__chatBrief = { ruta, respuestas, datos }; // para la fase 2 (envío)
    };

    // ── PREGUNTAS LIBRES: la web y la IA contestan; si hay brief en marcha, se vuelve a él
    const buscar = (q: string) => mejorFicha(q, fichas);
    const libre = async (q: string) => {
      let hechas = 0; try { hechas = Number(sessionStorage.getItem('savvia-preguntas') || 0); } catch {}
      if (hechas >= 12) { tu(q); await bot([t('Mejor escríbenos por email.', 'Better email us.')]); campo.disabled = true; return; }
      try { sessionStorage.setItem('savvia-preguntas', String(hechas + 1)); } catch {}
      ocupado = true; tu(q); quien = 1 - quien;
      const local = buscar(q);
      let v: { tipo: string; i?: number; texto?: string } = local >= 0 ? { tipo: 'escrita', i: local } : { tipo: 'ninguna' };
      const api = (async () => {
        try {
          const r = await fetch('/api/preguntar', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pregunta: q, quien, lang: t('es', 'en') }), signal: AbortSignal.timeout(14000) });
          if (!r.ok) return;
          const d = await r.json();
          if (d.tipo === 'escrita' && Number.isInteger(d.i) && d.i >= 0 && d.i < fichas.length) v = d;
          else if ((d.tipo === 'ia' || d.tipo === 'fuera') && d.texto) v = d;
          else if (d.tipo === 'ninguna') v = d;
        } catch { /* respaldo local */ }
      })();
      const img = escribiendo.querySelector('.cf-cara')!; img.innerHTML = `<img src="${caras[quien]}" alt="" width="72" height="72">`;
      lista.append(escribiendo); bajar();
      await Promise.all([api, esperar(700)]);
      escribiendo.remove();
      if (v.tipo === 'escrita') { const f = fichas[v.i!]; await bot([f.a], f.ctas); }
      else if (v.tipo === 'ia' || v.tipo === 'fuera') await bot([v.texto!], v.tipo === 'ia' ? [{ t: t('Respuesta rápida con IA, confirmársela a Eric y Andoni', 'Quick AI answer: have Eric and Andoni confirm it'), h: `mailto:${correo}?subject=${encodeURIComponent(t('Una pregunta', 'A question'))}&body=${encodeURIComponent(q)}`, enlace: true }] : undefined);
      else await bot([t('Esa no la tenemos escrita todavía. Mándanosla y te contestamos nosotros, normalmente en el día.', "We haven't written that one yet. Send it to us and we'll answer you ourselves, usually the same day.")], [{ t: t('Mandársela por correo', 'Send it by email'), h: `mailto:${correo}?subject=${encodeURIComponent(t('Una pregunta', 'A question'))}&body=${encodeURIComponent(q)}`, enlace: true }]);
      await reofrecer();
      ocupado = false;
    };
    const reofrecer = async () => {
      if (esperaTexto) return;
      if (!ruta) { opciones([], () => {}, { t: t('Cuéntanos tu proyecto', 'Tell us about your project'), fn: async () => { if (ocupado) return; ocupado = true; quitarOpciones(); tu(t('Cuéntanos tu proyecto', 'Tell us about your project')); quien = 1 - quien; await mostrarServicio(); ocupado = false; } }); return; }
      if (paso && paso !== 'servicio' && PASOS[paso] && idx < secuencia.length) { quien = 1 - quien; await bot([t('Seguimos con tu brief.', "Let's carry on with your brief.")]); await mostrarPaso(paso); }
      else if (paso === 'servicio') { quien = 1 - quien; await bot([t('Seguimos con tu brief.', "Let's carry on with your brief.")]); await mostrarServicio(); }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const txt = campo.value.trim();
      if (!txt || ocupado) return campo.focus();
      if (esperaTexto) {
        const e2 = esperaTexto;
        // RONDA 290 · Eric: «en el formulario multi-step conecta la IA también por si preguntan cosas»: si en un paso de texto lo escrito es una PREGUNTA, la contesta el chat
        // (escritas + IA) y el paso se retoma; no se toma por respuesta del brief
        const esPregunta = (e2.tipo === 'texto' || e2.tipo === 'opcional') && (/[?¿]/.test(txt) || /^(c[oó]mo|cu[aá]nt|qu[eé]|por qu[eé]|cu[aá]l|qui[eé]n|d[oó]nde|cu[aá]ndo|puedo|pod[eé]is|hac[eé]is|ten[eé]is|incluye|how|what|why|which|who|where|when|can|do you|does|is |are )/i.test(txt));
        if (esPregunta) {
          esperaTexto = null; campo.value = '';
          await libre(txt);
          if (!esperaTexto) { esperaTexto = e2; ponerCampo(campo.placeholder, true); }
          return;
        }
        if (e2.tipo === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(txt)) { ocupado = true; tu(txt); campo.value = ''; quien = 1 - quien; await bot([t('Parece que falta algo en ese email. ¿Me lo escribes otra vez?', 'Something seems to be missing from that email. Could you type it again?')]); ocupado = false; return; }
        ocupado = true; esperaTexto = null; campo.value = ''; tu(txt);
        quitarOpciones(); ponerCampo(t('Escribe una pregunta…', 'Write a question…'));
        if (PASOS[e2.id]) { respuestas.push({ q: PASOS[e2.id].q, a: txt }); datos[e2.id] = txt; if (PASOS[e2.id].r) { quien = 1 - quien; await bot([PASOS[e2.id].r!]); } }
        else datos[e2.id] = txt;
        await e2.sig();
        ocupado = false;
        return;
      }
      campo.value = '';
      await libre(txt);
    });
    // atajos para probar: window.__chat.abrir()
    (window as any).__chat = { abrir: (centrado = false) => poner(true, centrado), cerrar: () => poner(false), estado: () => ({ ocupado, espera: esperaTexto && esperaTexto.id, paso, idx, ruta }) };
  }
</script>

