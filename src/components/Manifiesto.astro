        vuelos.forEach((v, n) => { if (v.oculta !== ocultar[n]) { v.oculta = ocultar[n]; v.w.classList.toggle('por-llegar', ocultar[n]); } });
        pd.huecos(sueltas);
      };
      const pedirP = () => { if (!rafP2) rafP2 = requestAnimationFrame(volar); };
      addEventListener('scroll', pedirP, { passive: true }); addEventListener('resize', () => { reales = false; vuelos.forEach((v) => { v.fs = 0; v.img = undefined; }); pedirP(); });
      // el collage tarda en montarse: se reintenta hasta tener sus etiquetas
      const espera = () => { pedirP(); if (!reales) setTimeout(espera, 300); }; espera();
    }
    // el entintado: la tinta llega a la palabra que está a la altura del 62 % de la pantalla (y a todo lo de antes)
    if (reducido) pl.forEach((p) => p.classList.add('tinta'));
    else {
      let raf = 0, hasta = -1;
      const medir = () => {
        raf = 0;
        const lim = innerHeight * 0.62;
        let n = 0;
        for (const p of pl) { const r = p.getBoundingClientRect(); if (r.top < lim) n++; else break; }
        if (n !== hasta) { pl.forEach((p, i) => p.classList.toggle('tinta', i < n)); hasta = n; }
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(medir); }, { passive: true });
      addEventListener('resize', medir); medir();
    }
  }
</script>

