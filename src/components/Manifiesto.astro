          const x = x0 + (x1 - x0) * k + Math.sin(Math.PI * k) * v.lado, y = y0 + (y1 - y0) * k - Math.sin(Math.PI * Math.min(1, k * 1.6)) * 26;
          if (y > H + 40) return;
          const ang = v.rot0 * (1 - k) + Math.sin(Math.PI * k) * v.giro * 0.35;
          const fs = v.fs || (v.fs = parseFloat(getComputedStyle(v.w).fontSize)), anchoF = r.width + 10, altoF = fs * 0.95;
          const ancho0 = v.mw * lr.width, alto0 = v.mh * lr.height;
          const kk = Math.min(1, k * 1.15), ancho = ancho0 + (anchoF - ancho0) * kk, alto = alto0 + (altoF - alto0) * kk;
          const papelA = land < 0.7 ? 1 : 1 - (land - 0.7) / 0.3;
          pintado = true;
          // la tarjeta se pinta UNA vez, a su tamaño de llegada, en su propio recorte; luego solo se coloca (rasterizar el texto en cada fotograma costaba el doble)
