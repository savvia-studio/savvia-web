              const cs = getComputedStyle(v.w); oc.fillStyle = cs.color; oc.font = `${cs.fontWeight} ${(fs * k2).toFixed(1)}px ${cs.fontFamily}`; oc.textAlign = 'center'; oc.textBaseline = 'middle';
              oc.fillText(v.t || (v.t = v.w.textContent || ''), o.width / 2, o.height / 2, o.width);
