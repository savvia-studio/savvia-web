---
import { receta } from '../data/home';
const pad = (n: number) => String(n + 1).padStart(2, '0');
// RONDA 66 · «en el md de referencia hay cosas que cambian de color como si tuviesen un link; eso lo trasladamos»: en cada línea, los valores de la receta
// (colores en hexadecimal, archivos .md, tokens de espacio, medidas en px) van en el color de enlace, subrayados con puntos
const TOKEN = /(#[0-9A-Fa-f]{6}|\b[\w/-]+\.md\b|\b(?:xtiny|xxhuge)\b|\d+(?:\s*\/\s*\d+)?\s*px|\d+%)/g;
const trozos = (l: string) => l.split(TOKEN).map((t, i) => ({ t, tok: i % 2 === 1 }));
// la tinta A MANO (Coral): trazos con pulso (no geométricos), en una caja de 100 × 20 que se estira a la línea que marcan
const TRAZO: Record<string, string> = {
  circulo: 'M10 5 C 34 -1, 82 0, 96 7 C 103 13, 86 19.5, 50 19 C 17 18.6, 0 15.5, 3 9.5 C 5.5 4.5, 15 2.2, 32 2.4',
  subraya: 'M1 18.5 C 22 16.8, 48 19.6, 74 17.6 S 96 17, 99 16.2',
  tacha: 'M1 11.5 C 24 9.4, 52 12.4, 76 10.2 S 95 10.6, 99 9.2',
};
---

<!--
  LA RECETA DE PAPEL (rondas 53–55). Ronda 55, Andoni: «la receta me gusta, pero igual podríamos hacer algo estilo que a medida que haces scroll se va
  imprimiendo el ticket: un ticket continuo con los diferentes pasos, y por encima salen esos resaltes digitales».
  · LA IMPRESORA: una ranura oscura que se queda fija a tres cuartos de la pantalla (sticky) mientras pasa la sección; el ticket SALE DE ELLA con el
    scroll, a tirones de una línea (la cadencia de una térmica): lo que ya está por encima de la ranura está impreso; lo de debajo, aún no existe.
  · UN SOLO TICKET, largo, con los cinco pasos seguidos (01 tu marca → 02 el arnés → 03 tu equipo pide → 04 queda escrito → 05 la cuenta), canto
    dentado arriba y abajo. Es la receta REAL entregada a Neety (su library).
  · HUMANO: la TINTA A MANO en Coral se dibuja sobre cada paso cuando termina de imprimirse (círculo, subrayado, tachado, vistos).
  · DIGITAL: a la vez, a su lado (izquierda y derecha, alternando) aterriza la pieza de interfaz de ese paso, recta y nítida.
  Sin JS o con movimiento reducido: el ticket entero, marcado y con sus piezas.
-->
<section id="la-savvia" class="surface-light receta relative" aria-labelledby="receta-h" data-receta data-sube>
  <div class="wrap section-y">
    <h2 id="receta-h" class="text-h1 max-w-[14ch]" data-entra>{receta.titulo}</h2>
    <p class="text-sub arnes mt-6 lg:mt-8 max-w-[34ch]" data-enfoca>{receta.arnes}</p>
    <!-- RONDA 56 · el ticket va ENGANCHADO a la boca de la impresora y sale hacia arriba; la impresora, fija mientras dura (escenario sticky) -->
    <div class="imprenta" data-imprenta>
      <div class="escenario" data-escenario>
        <div class="boca" data-boca>
          <div class="ticket" data-ticket>
            <div class="papel" data-papel>
              <p class="cab"><span class="logo-t" role="img" aria-label="savvia"></span></p>
              <p class="sub-cab">la receta de la web de Neety</p>
              <p class="raya" aria-hidden="true">= = = = = = = = = = = = = =</p>
              {
                receta.tiras.map((t, i) => (
                  <section class={`bloque ${i % 2 ? 'izq' : 'der'}`} aria-label={`${pad(i)} · ${t.paso}`} data-bloque>
                    <p class="paso"><b>{pad(i)}</b> · {t.paso}</p>
                    <p class="titulo-b">{t.t}</p>
                    <p class="raya" aria-hidden="true">{t.raya}</p>
                    <div class="cuerpo">
                      {t.lineas.map((l, k) => {
                        const m = t.marcas.find(([n]) => n === k)?.[1];
                        return (
                          <span class="ln">
                            <span class="tx">
                              {l ? trozos(l).map((q) => (q.tok ? <span class="tok">{q.t}</span> : q.t)) : ' '}
                              {m && m !== 'visto' && (
                                <svg class={`tinta ${m}`} viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true"><path d={TRAZO[m]} pathLength="1" /></svg>
                              )}
                              {m === 'visto' && (
                                <svg class="tinta visto" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.2 8.6 C 3.6 9.6, 5 11.2, 6.1 13 C 8 8.6, 10.6 5, 14 2.4" pathLength="1" /></svg>
                              )}
                            </span>
                          </span>
                        );
                      })}
                    </div>
                    <div class={`dig dig-${t.digital.tipo}`} aria-hidden={t.digital.tipo === 'boton' ? undefined : 'true'}>
                      {t.digital.tipo === 'tabla' && (
                        <>
                          <span class="dig-cab">{t.digital.txt}</span>
                          <span class="tabla-d">
                            {t.digital.filas!.map((f, k) => (
                              <>
                                <i class="sw" style={`--c:${t.digital.colores![k]}`} />
                                <span>{f[0]}</span>
                                <code>{f[1]}</code>
                                <code class="tk">{f[2]}</code>
                              </>
                            ))}
                          </span>
                        </>
                      )}
                      {t.digital.tipo === 'bloqueo' && (
                        <>
                          <span class="dig-cab">{t.digital.cab}</span>
                          <span class="fila-d"><i class="x">✕</i>{t.digital.txt}</span>
                          <span class="fin">→ {t.digital.fin}</span>
                        </>
                      )}
                      {t.digital.tipo === 'agente' && (
                        <>
                          <span class="fila-d trabaja"><i class="giro-d" />{t.digital.txt}</span>
                          {t.digital.pasos!.map((q, k) => <span class="paso-d" style={`--k:${k}`}>✓ {q}</span>)}
                          <span class="fila-d listo">{t.digital.fin}</span>
                        </>
                      )}
                      {t.digital.tipo === 'diff' && (
                        <>
                          <span class="dig-cab"><i class="punto" />{t.digital.txt}<b class="mas">{t.digital.fin}</b></span>
                          {t.digital.pasos!.map((q, k) => <code class="diff-l" style={`--k:${k}`}>{q}</code>)}
                        </>
                      )}
                      {t.digital.tipo === 'boton' && (
                        <a class="boton-lib" href={t.digital.href} target="_blank" rel="noopener" aria-label={`${t.digital.txt} (se abre en otra pestaña)`}>
                          <svg class="ci-chispa" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3c.4 3.9 2.1 5.6 6 6-3.9.4-5.6 2.1-6 6-.4-3.9-2.1-5.6-6-6 3.9-.4 5.6-2.1 6-6z" /></svg>
                          <span class="ci-txt">{t.digital.txt}</span>
                          <span class="ci-env" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 19V5M6 11l6-6 6 6" /></svg></span>
                        </a>
                      )}
                    </div>
                    {i < receta.tiras.length - 1 && <p class="raya sep" aria-hidden="true">- - - - - - - - - - - - - - -</p>}
                  </section>
                ))
              }
            </div>
          </div>
        </div>
        <div class="impresora" data-impresora>
          <i class="ranura" aria-hidden="true"></i><i class="led" aria-hidden="true" data-led></i>
          <!-- RONDA 57 · «poner en esa sección para activar y quitar sonido»: el altavoz, en la propia impresora -->
          <button type="button" class="altavoz" aria-pressed="true" aria-label="Quitar el sonido de la impresora" data-altavoz>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path class="caja" d="M4 9.5h3.2L12 5.5v13l-4.8-4H4z" /><path class="ondas" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11" /><path class="tacha" d="M15.5 9.5l5 5M20.5 9.5l-5 5" /></svg>
            <span class="detail">sonido</span>
          </button>
        </div>
        <!-- RONDA 74 · «quitamos los detalles florales de las secciones, las dejamos limpias»: fuera la maleza de la impresora (ronda 57) -->
      </div>
    </div>
    <p class="nota detail mt-16 lg:mt-24">
      <span>{receta.nota}</span>
    </p>
  </div>
</section>

<script>
  // RONDA 56 · «que parezca que se imprime de verdad: uno de verdad va más a tirones; y sonido de ticket que se imprime».
  // · El SCROLL dice hasta dónde hay que imprimir (objetivo); la IMPRESORA va a su ritmo: ráfagas de líneas (28–40 ms cada una), pausas cortas cada
  //   pocas líneas y una larga entre pasos; nunca «desimprime». Cada línea es un tirón: el papel sube una línea en dos golpes (con un rebote de 1 px) y
  //   la impresora vibra. El ticket va enganchado a la boca: lo impreso sale hacia ARRIBA.
  // · SONIDO: una grabación real de una térmica (ver «el sonido», ronda 59); solo después de un gesto en la página (el navegador no deja sonar antes)
  //   y nunca si el sonido de la web está apagado (savvia:sonido = 0).
  const sec = document.querySelector<HTMLElement>('[data-receta]');
  if (sec) {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const imprenta = sec.querySelector<HTMLElement>('[data-imprenta]')!, ticket = sec.querySelector<HTMLElement>('[data-ticket]')!;
    const imp = sec.querySelector<HTMLElement>('[data-impresora]')!;
    const bloques = [...sec.querySelectorAll<HTMLElement>('[data-bloque]')];
    const LINEA = 19;
    let H = 0, impreso = 0, objetivo = 0, vista = false, raf = 0, hasta = 0, rafaga = 0, ultimo = 0;
    // ── el sonido
    // RONDA 59 · «el sonido de la receta, más realista; si hace falta, sácalo de internet». Una GRABACIÓN real de una térmica Epson (Pixabay,
    // «freesound_community», licencia de Pixabay: uso libre, sin atribución; original en tools/fuente-impresora-pixabay-82477.mp3):
    // impresora.mp3 = 7,6 s de impresión continua, en bucle mientras la impresora tira (desde un punto al azar, para que no se repita);
    // cuchilla.mp3 = el corte del papel al terminar. Entre línea y línea, un microcorte de volumen que lo ata a los tirones de la pantalla.
    let ac: AudioContext | null = null, bufImp: AudioBuffer | null = null, bufCorte: AudioBuffer | null = null;
    const callado = () => { try { return localStorage.getItem('savvia:son') !== '1'; } catch { return true; } };
    const cargar = async (url: string) => { const r = await fetch(url); return ac!.decodeAudioData(await r.arrayBuffer()); };
    const despertar = () => {
      if (ac || callado()) return;
      try {
        ac = new AudioContext();
        cargar('/media/sonido/impresora.mp3').then((b) => (bufImp = b)).catch(() => {});
        cargar('/media/sonido/cuchilla.mp3').then((b) => (bufCorte = b)).catch(() => {});
      } catch { ac = null; }
    };
    ['pointerdown', 'keydown', 'touchend'].forEach((ev) => addEventListener(ev, despertar, { once: true, passive: true }));
    const VOL = 0.28; // ronda 59: «la impresora, más bajo» (antes 0,55)
    let motor: { m: GainNode; f: AudioBufferSourceNode } | null = null, pitado = false;
    const listo = () => { if (!ac || callado()) return false; if (ac.state === 'suspended') ac.resume(); return ac.state === 'running'; };
    const arrancar = () => {
      if (motor || !listo() || !bufImp) return;
      const a = ac!, t = a.currentTime, m = a.createGain();
      m.gain.setValueAtTime(0, t); m.gain.linearRampToValueAtTime(VOL, t + 0.012); m.connect(a.destination);
      const f = a.createBufferSource(); f.buffer = bufImp; f.loop = true; f.playbackRate.value = 0.97 + Math.random() * 0.06;
      f.connect(m); f.start(t, Math.random() * (bufImp.duration - 0.5));
      motor = { m, f };
    };
    const parar = () => {
      if (!motor || !ac) return;
      const t = ac.currentTime, { m, f } = motor;
      m.gain.cancelScheduledValues(t); m.gain.setValueAtTime(m.gain.value, t); m.gain.linearRampToValueAtTime(0, t + 0.04);
      f.stop(t + 0.06);
      motor = null;
    };
    const zrrt = () => {
      arrancar();
      if (!motor || !ac) return;
      const t = ac.currentTime, g = motor.m.gain;
      g.cancelScheduledValues(t); g.setValueAtTime(VOL * 0.55, t); g.linearRampToValueAtTime(VOL, t + 0.01); // el microcorte entre líneas
    };
    // la cuchilla: el corte grabado
    const pitar = () => {
      if (pitado || !listo() || !bufCorte) return;
      pitado = true;
      const a = ac!, f = a.createBufferSource(), g = a.createGain(); g.gain.value = 0.4;
      f.buffer = bufCorte; f.connect(g).connect(a.destination); f.start(a.currentTime + 0.15);
    };
    // el ALTAVOZ: comparte la preferencia de la web (savvia:sonido); pulsarlo ya es el gesto que deja sonar
    const altavoz = sec.querySelector<HTMLButtonElement>('[data-altavoz]')!;
    const pintarAltavoz = () => { const on = !callado(); altavoz.setAttribute('aria-pressed', String(on)); altavoz.setAttribute('aria-label', on ? 'Quitar el sonido de la impresora' : 'Poner el sonido de la impresora'); altavoz.classList.toggle('mudo', !on); };
    altavoz.addEventListener('click', () => {
      const on = callado();
      try { localStorage.setItem('savvia:son', on ? '1' : '0'); } catch {}
      if (on) { despertar(); ac?.resume(); } else parar();
      pintarAltavoz();
    });
    pintarAltavoz();
    // ── la impresora
    // RONDA 57 · «el ticket, cuando haces scroll hacia arriba una vez abierto, se buguea y se ve mal: una vez abierto lo dejamos abierto y puedes hacer
    // scroll en él metiéndose por donde ha salido». Lo IMPRESO se queda impreso (no se reimprime ni suena), pero lo que ASOMA de la impresora sigue al
    // scroll en los dos sentidos: al subir, el papel vuelve a meterse por la boca; al bajar, sale otra vez (ya impreso). Nunca asoma más de lo impreso.
    let asoma = 0, abierto = false;
    // RONDA 58 · «una vez hecha la animación de scroll no quiero secuestrar el scroll para volver arriba: el ticket se queda abierto y puedes scrollear
    // sobre él». Al terminar de imprimir, el escenario deja de ir fijo: se ANCLA en la página justo donde está (sin salto) y el ticket queda fuera entero
    const escenario = sec.querySelector<HTMLElement>('[data-escenario]')!;
    const abrir = () => {
      if (abierto) return;
      abierto = true;
      const r = imprenta.getBoundingClientRect(), p = Math.max(0, Math.min(r.height - innerHeight, -r.top));
      escenario.style.position = 'absolute'; escenario.style.left = '0'; escenario.style.right = '0'; escenario.style.top = `${p}px`;
      asoma = H; colocar(); sec.classList.add('abierta');
    };
    const colocar = () => {
      ticket.style.setProperty('--impreso', `${asoma}px`);
      bloques.forEach((b) => { if (b.offsetTop + b.offsetHeight <= impreso + 4) b.classList.add('marcado'); });
      ticket.classList.toggle('acabado', impreso >= H - 1);
    };
    const medir = () => { H = ticket.offsetHeight; imprenta.style.setProperty('--alto', `${H}px`); pedir(); };
    const bucle = (ahora: number) => {
      raf = 0;
      const r = imprenta.getBoundingClientRect();
      const scroll = Math.max(0, Math.min(H, Math.round(-r.top + innerHeight * 0.18)));
      objetivo = Math.max(objetivo, scroll);
      if (!abierto) {
        const antes = asoma;
        asoma = Math.min(impreso, scroll);
        if (asoma !== antes) colocar();
      }
      if (impreso < objetivo && ahora >= hasta) {
        // un tirón: una línea, en dos golpes
        const lejos = objetivo - impreso > LINEA * 14; // muy atrás: dos líneas por tirón (recupera, como una térmica a plena velocidad)
        impreso = Math.min(H, impreso + LINEA * (lejos ? 2 : 1));
        if (!abierto) asoma = Math.min(impreso, scroll);
        ticket.classList.remove('tiron'); void ticket.offsetWidth; ticket.classList.add('tiron');
        imp.classList.add('en-marcha');
        zrrt(); colocar();
        rafaga++;
        const finDePaso = bloques.some((b) => Math.abs(b.offsetTop + b.offsetHeight - impreso) < LINEA);
        const pausa = lejos ? 0 : finDePaso ? 300 + Math.random() * 160 : rafaga >= 4 + Math.floor(Math.random() * 5) ? 80 + Math.random() * 120 : 0;
        if (pausa) rafaga = 0;
        hasta = ahora + 28 + Math.random() * 12 + pausa;
        ultimo = ahora;
      } else if (ahora - ultimo > 140) { imp.classList.remove('en-marcha'); parar(); if (impreso >= H && H > 0) { pitar(); abrir(); } }
      if (impreso < objetivo || imp.classList.contains('en-marcha')) raf = requestAnimationFrame(bucle); // termina lo que le toca aunque ya no se vea
    };
    const pedir = () => { if (vista && !raf) raf = requestAnimationFrame(bucle); };
    if (reducido) { sec.classList.add('sin-imprenta'); bloques.forEach((b) => b.classList.add('marcado')); }
    else {
      sec.classList.add('con-imprenta');
      new ResizeObserver(medir).observe(ticket);
      new IntersectionObserver((e) => { vista = e[0].isIntersecting; pedir(); }, { rootMargin: '10% 0px' }).observe(imprenta);
      addEventListener('scroll', pedir, { passive: true });
      medir(); colocar();
    }
    (window as any).__receta = () => ({ impreso: `${impreso}px`, asoma, alto: H, objetivo, marcados: bloques.map((b) => b.classList.contains('marcado')), sonido: ac?.state ?? 'sin gesto' });
  }
</script>

<style>
  .arnes {
    color: var(--fg2);
  }
  /* LA IMPRENTA (ronda 56): tan alta como el ticket más una pantalla; dentro, un ESCENARIO fijo (sticky) con la impresora a tres cuartos de la pantalla
     y, encima de su boca, el ticket que sale hacia arriba (lo que aún no ha salido queda recortado bajo la boca) */
  .imprenta {
    position: relative;
    height: calc(var(--alto, 110rem) + 100lvh);
    /* RONDA 67 · «una vez impresa, que no quede tanto espacio entre la receta y el titular»: la imprenta arranca 40 lvh más arriba (la impresora, a tres
       cuartos de su escenario, sigue cayendo bajo el titular; el ticket sale hacia arriba siempre por debajo de él) */
    margin-top: -52lvh;
  }
  .sin-imprenta .imprenta { margin-top: calc(var(--spacing) * 16); }
  .escenario {
    position: sticky;
    top: 0;
    height: 100lvh;
    isolation: isolate; /* las ramas de detrás (z −1) quedan tras el papel sin irse detrás de la sección */
  }
  .boca {
    position: absolute;
    left: 0;
    right: 0;
    top: -300lvh;
    bottom: 14lvh; /* la boca, a ras de la impresora (100 − 86) */
    clip-path: inset(0 -100vw 0 -100vw); /* solo recorta por abajo (la boca); por los lados, las piezas digitales salen libres */
    pointer-events: none;
  }
  .ticket {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: min(84vw, 22rem);
    translate: -50% calc(100% - var(--impreso, 0px));
    pointer-events: auto;
  }
  /* un TIRÓN: el papel ya ha subido la línea; lo acaba de subir en dos golpes, con un rebote de 1 px */
  .ticket.tiron .papel {
    animation: tiron 0.07s steps(2, end);
  }
  @keyframes tiron {
    0% { transform: translateY(10px); }
    60% { transform: translateY(-1px); }
    100% { transform: translateY(0); }
  }
  /* LA IMPRESORA: la ranura oscura con su labio y un piloto; vibra mientras imprime */
  .impresora {
    position: absolute;
    left: 50%;
    top: 86lvh; /* ronda 76 · Eric: «que la impresora empiece aquí abajo, no en medio» (antes 72) */
    translate: -50% -7px;
    z-index: 5; /* por delante de las ramas (que sí van por delante del papel): el altavoz, siempre a la vista */
    width: min(92vw, 27rem);
    height: 14px;
    border-radius: 7px;
    background: color-mix(in oklab, var(--color-cacao) 88%, #000);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--color-niebla) 60%, transparent) inset, 0 8px 18px -8px color-mix(in oklab, var(--color-cacao) 60%, transparent);
  }
  .impresora.en-marcha {
    animation: vibra 0.05s linear infinite;
  }
  @keyframes vibra {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(0.6px); }
  }
  /* el ALTAVOZ, a la derecha de la impresora */
  .altavoz {
    position: absolute;
    left: calc(100% + var(--spacing) * 3);
    top: 50%;
    translate: 0 -50%;
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1.5);
    color: var(--fg2);
    cursor: pointer;
    pointer-events: auto;
  }
  .altavoz:hover,
  .altavoz:focus-visible {
    color: var(--fg);
  }
  .altavoz svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .altavoz .tacha { display: none; }
  .altavoz.mudo .ondas { display: none; }
  .altavoz.mudo .tacha { display: inline; }
  @media (width < 64rem) {
    .altavoz { left: auto; right: 0; top: calc(100% + var(--spacing) * 3); translate: none; }
  }
  .ranura {
    position: absolute;
    left: 8%;
    right: 8%;
    top: 6px;
    height: 2px;
    border-radius: 2px;
    background: #000;
  }
  .led {
    position: absolute;
    right: 3%;
    top: 5px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-coral) 35%, #000);
    transition: background 0.15s ease, box-shadow 0.15s ease;
  }
  .en-marcha .led {
    background: var(--color-coral);
    box-shadow: 0 0 6px var(--color-coral);
  }
  /* sin movimiento: el ticket entero, en su sitio, y la impresora encima */
  .sin-imprenta .imprenta { height: auto; }
  .sin-imprenta .escenario { position: relative; height: auto; display: flex; flex-direction: column; align-items: center; }
  .sin-imprenta .boca { position: relative; inset: auto; clip-path: none; order: 2; }
  .sin-imprenta .ticket { position: relative; left: auto; translate: none; }
  .sin-imprenta .impresora { position: relative; left: auto; top: auto; translate: none; order: 1; margin-bottom: -7px; }
  /* EL PAPEL: térmico, casi blanco, con grano; dentado arriba y abajo (arrancado de la bobina) */
  .papel {
    --diente: 7px;
    position: relative;
    isolation: isolate;
