---
// OTROS TRABAJOS (rondas 17–18). Andoni: «otros trabajos lo quiero mostrar más estilo agencia creativa […] northmail.app, como tienen la sección
// "Channels designed for life's moments": así quiero mostrar los proyectos. Con mockups, gradientes de ese estilo».
// Referencia medida: titular grande arriba a la izquierda; MOSAICO asimétrico sobre 12 columnas (piezas de tamaños distintos, escalonadas, con
// mucho aire); cada pieza = una imagen con el nombre GRANDE encima, arriba a la izquierda, y un pie pequeño debajo; la primera pieza es un
// degradado de aerógrafo con un icono y el texto de entrada.
// RONDA 18 · «le tenemos que dar más aire […] y no podemos usar el mismo gradiente en todos. Lo ideal sería usar en algunas imágenes un mockup
// con fondo realista como el que hemos puesto con estaciones. Tener variedad. Y que entren con alguna animación»:
//   · TRES tipos de pieza: `escena` (la mesa de Andoni en una estación, con la web del cliente DENTRO del monitor: la pantalla está medida
//     en la lámina), `claro` (degradado pálido, navegador RECTO y cortado por abajo, nombre en Cacao) y `mancha` (degradado intenso u oscuro,
//     navegador ladeado). Ninguna repite fondo. Iris no entra (significa «la IA»). Excepción consciente a «sin degradados» de DESIGN.md.
//   · AIRE: piezas más estrechas, tres filas escalonadas con huecos de columna vacíos y 128 px entre filas.
//   · ENTRADA: cada pieza se descubre de abajo arriba (recorte), su fondo llega ampliado y se asienta, y el mockup sube después.
// RONDA 19 · Andoni: «las barras de los navegadores son muy gordas y en Remerge deberíamos enseñar la versión móvil. Luego estaría guay que al
// hacer hover se viera el vídeo de cada proyecto». Y dos láminas más de la mesa: un MÓVIL en la mesa y un iMac en la mesa de ROBLE.
//   · Cada pieza lleva el VÍDEO real de la web del cliente (Chrome real recorriendo la página, `tools/grabar-otros.cjs` → mp4 de 7 s, sin
//     sonido; Remerge grabada a 390 px como móvil). Se reproduce al pasar el cursor o enfocar; en táctil, mientras la pieza está a la vista.
//     El primer fotograma es el póster. (brag redibuja la web en HTML: para webs ajenas es mejor grabar la real.)
//   · Las pantallas del móvil y del iMac no son rectas: están en PERSPECTIVA. Sus cuatro esquinas se han medido en la lámina y de ahí sale una
//     HOMOGRAFÍA (cuadrado unidad → cuadrilátero) que se aplica como `matrix3d`; los términos de perspectiva y traslación van en píxeles, así que
//     dependen del tamaño real de la lámina en pantalla: el JS mide la mesa y deja la escala en `--s`.
//   · Barras de navegador a 16 px (antes 24).
import { proyectos, voces } from '../data/home';
import Flora from './Flora.astro';
const A = proyectos.anteriores;
type Sitio = { col: string; ratio: string; baja: number; tipo: 'escena' | 'claro' | 'mancha' | 'movil' | 'roble'; g?: string; giro?: number; est?: string; zoom?: number; cy?: number };
// Los DEGRADADOS salen de los colores de la web de cada cliente (home.ts › color); las escenas no llevan degradado (llevan la mesa).
// RONDA 40 · «los testimonios ponemos menos cantidad y que sean animados y vayan rotando; si se nos ocurre alguna manera original de mostrarlos,
// mejor»: TRES voces en un solo sitio del mosaico, junto a Isotrol. Cada cita entra palabra a palabra (el gesto de los titulares), un hilo de savia
// mide su tiempo bajo el nombre de quien la dice, y si habla de un proyecto del mosaico, ese proyecto se SEÑALA (un punto de savia en su pie).
const SITIO: Sitio[] = [
  { col: '5 / span 4', ratio: '3 / 4', baja: 0, tipo: 'escena', est: 'otono', zoom: 3.3, cy: 0.6 },
  { col: '10 / span 3', ratio: '4 / 5', baja: 32, tipo: 'mancha', g: 'g-marca', giro: 5 },
  { col: '2 / span 5', ratio: '5 / 4', baja: 0, tipo: 'mancha', g: 'g-marca', giro: 6 }, // ronda 20: «Cubbo lo dejamos como estaba con el fondo de gradiente» (el iMac de roble queda en QUAD, sin uso)
  { col: '8 / span 4', ratio: '1 / 1', baja: 24, tipo: 'movil', zoom: 1.9, cy: 0.5 }, // ronda 30: con 1,35 la lámina (16:9) no cubría la pieza cuadrada (ni redondeaba)
  { col: '5 / span 4', ratio: '4 / 5', baja: 0, tipo: 'escena', est: 'invierno', zoom: 2.7, cy: 0.58 },
];
const V = voces.filter((v) => v.rota);
// RONDA 42 · «los testimonios no van antes de nuestros proyectos, van entre medias, y que puedas cambiar de testimonio con unas flechas muy sutiles»:
// una fila entera en medio del mosaico (tras la primera fila de proyectos), centrada; el nombre de quien habla entre dos flechas finas.
// la pantalla del monitor dentro de la lámina de la mesa (medida en la ronda 6)
const PANT = { x: 0.3903, y: 0.3696, w: 0.2178, h: 0.2104 }; // ronda 26: la caja blanca entera
const LAM = { w: 1672, h: 941 };
// las pantallas en perspectiva: esquinas medidas por inundación en la lámina (px): TL · TR · BR · BL
const QUAD: Record<string, { foto: string; q: [number, number][] }> = {
  movil: { foto: 'mesa-movil', q: [[974, 188], [1194, 183], [1184, 708], [950, 695]] },
  roble: { foto: 'mesa-roble', q: [[792, 274], [1220, 249], [1212, 535], [781, 519]] },
};
// homografía del cuadrado unidad al cuadrilátero (Heckbert): x' = (a·u + b·v + c) / (g·u + h·v + 1)
function homografia(p: [number, number][]) {
  const [[x0, y0], [x1, y1], [x2, y2], [x3, y3]] = p;
  const dx1 = x1 - x2, dx2 = x3 - x2, dx3 = x0 - x1 + x2 - x3, dy1 = y1 - y2, dy2 = y3 - y2, dy3 = y0 - y1 + y2 - y3;
  const det = dx1 * dy2 - dx2 * dy1;
  const g = (dx3 * dy2 - dx2 * dy3) / det, h = (dx1 * dy3 - dx3 * dy1) / det;
  return { a: x1 - x0 + g * x1, b: x3 - x0 + h * x3, c: x0, d: y1 - y0 + g * y1, e: y3 - y0 + h * y3, f: y0, g, h };
}
// la caja de la pantalla (px de la lámina) y la matriz que la lleva a sus esquinas; los términos con píxeles se dejan como variables
function escenaQuad(k: string) {
  const { q } = QUAD[k];
  const x0 = Math.min(q[0][0], q[3][0]), y0 = Math.min(q[0][1], q[1][1]), x1 = Math.max(q[1][0], q[2][0]), y1 = Math.max(q[2][1], q[3][1]);
  const W = x1 - x0, H = y1 - y0;
  const n = q.map(([x, y]) => [(x - x0) / W, (y - y0) / H] as [number, number]);
  const m = homografia(n);
  const r = (v: number) => +v.toFixed(6);
  // matrix3d(m11 m12 m13 m14 · m21 m22 m23 m24 · m31… · m41 m42 m43 m44): x' = m11x + m21y + m41; w' = m14x + m24y + 1
  const matriz = `matrix3d(${r(m.a)}, ${r((m.d * H) / W)}, 0, calc(${r(m.g / W)} / var(--s)), ${r((m.b * W) / H)}, ${r(m.e)}, 0, calc(${r(m.h / H)} / var(--s)), 0, 0, 1, 0, calc(${r(m.c * W)} * var(--s)), calc(${r(m.f * H)} * var(--s)), 0, 1)`;
  return { x0, y0, W, H, cx: (x0 + x1) / 2 / LAM.w, cy: (y0 + y1) / 2 / LAM.h, matriz };
}
---

<section id="anteriores" class="surface-light section-y" aria-labelledby="ant-h" data-sube>
  <div class="wrap">
    <!-- RONDA 24 · «ver todos los proyectos a la derecha del titular pegado a la línea derecha, con una animación más fluida, como que se rellena de
         naranja, y la flecha más minimalista» -->
    <div class="cabecera flex flex-wrap items-end justify-between gap-6">
      <h2 id="ant-h" class="text-h1 max-w-[12ch]" data-entra>{proyectos.titulo2}</h2>
      <a href={proyectos.enlace.href} class="todos text-ui font-medium"><span>{proyectos.enlace.label}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M14 7l5 5-5 5" /></svg></a>
    </div>
    <div class="mosaico mt-24 lg:mt-32">
      <!-- la pieza de entrada: solo degradado, con el símbolo (la gota) y el texto debajo -->
      <!-- RONDA 18 · «el logo que está encima del gradiente, ser los de los proyectos rotando con un efecto líquido de transición»: los cinco
           logotipos se relevan fundiéndose como gotas (filtro gooey solo durante el relevo: en reposo el logotipo se ve limpio) y el degradado
           de detrás vira a los colores de cada proyecto (@property: los colores se interpolan). -->
      <div class="pieza entrada" data-pieza style="--i:0">
        <div class="lamina g-marca rota" data-rota data-colores={JSON.stringify(A.map((c) => c.color))} style={`--c1:${A[0].color[0]};--c2:${A[0].color[1]};--c3:${A[0].color[2]}`}>
          <div class="logos" role="img" aria-label={`Logotipos: ${A.map((c) => c.n).join(', ')}`}>
            {A.map((c, i) => <i class={i === 0 ? 'on' : ''} style={`--logo:url('/media/anteriores/logos/${c.logo}.svg')`} data-logo />)}
          </div>
        </div>
        <p class="pie text-aux text-fg2 mt-4">{proyectos.intro2}</p>
      </div>
      {
        A.map((c, i) => {
          const s = SITIO[i];
          // escena: la lámina se amplía `zoom` veces y se coloca para que el centro de la pantalla caiga en (50 %, cy) de la pieza
          const Z = s.zoom ?? 3;
          const quad = s.tipo === 'movil' || s.tipo === 'roble' ? escenaQuad(s.tipo) : null;
          const cx = quad ? quad.cx : PANT.x + PANT.w / 2, py = quad ? quad.cy : PANT.y + PANT.h / 2, left = 50 - cx * Z * 100;
          const esMovil = s.tipo === 'movil';
          // el VÍDEO de la web (con su primer fotograma de póster); Remerge, grabada como móvil. (Como HTML: Astro no renderiza funciones JSX.)
          const video = `<video class="vid" muted loop playsinline preload="none" poster="/media/anteriores/video/${c.slug}.jpg" width="${esMovil ? 390 : 960}" height="${esMovil ? 844 : 600}" aria-label="Recorrido por la web de ${c.n}" data-vid><source src="/media/anteriores/video/${c.slug}.mp4" type="video/mp4" /></video>`;
          return (
            <>
            {i === 2 && (

              <figure class="voces" data-voces data-alguno={V.some((v) => v.video) ? '' : undefined}>
                <Flora lamina="helecho" fondo="niebla" opacidad={0.4} soloEscritorio estilo="left:-15rem;top:-2rem;width:13rem" />
                <Flora lamina="brezo" fondo="niebla" opacidad={0.35} voltear soloEscritorio estilo="right:-13rem;bottom:-3rem;width:11rem" />
        <div class="citas">
          {V.map((v, k) => (
            <blockquote class={`cita ${k === 0 ? 'on' : ''}`} data-cita={k} data-de={v.de} data-video={v.video || undefined} data-poster={v.poster || undefined} data-ar={v.video ? v.ar.toFixed(4) : undefined} aria-hidden={k === 0 ? 'false' : 'true'}>
              {`«${v.q}»`.split(' ').map((w, n) => <><span class="pal"><span style={`--n:${n}`}>{w}</span></span>{' '}</>)}
            </blockquote>
          ))}
        </div>
        <figcaption class="autor">
          <span class="quien-fila">
          <button type="button" class="flecha-v" aria-label="Testimonio anterior" data-voz="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5L9 12l5.5 5.5" /></svg></button>
          <span class="quienes">
            {V.map((v, k) => (
              <span class={`quien ${k === 0 ? 'on' : ''}`} data-quien={k} aria-hidden={k === 0 ? 'false' : 'true'}>
                <span class="nombre-v">{v.n}</span>
                <span class="rol">{v.r}</span>
              </span>
            ))}
          </span>
          <button type="button" class="flecha-v" aria-label="Testimonio siguiente" data-voz="1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 6.5L15 12l-5.5 5.5" /></svg></button>
          </span>
          <!-- RONDA 47 · «quitamos la barra de progreso y el icono del vídeo lo hacemos más sutil, más mimetizado con el fondo»: la cámara ocupa el
               sitio del hilo de tiempo, centrada bajo el nombre, en línea fina del color del texto (sin cristal) -->
          <button type="button" class="vid-voz" aria-label="Ver el vídeo del testimonio" aria-haspopup="dialog" data-voz-video><i class="gota" aria-hidden="true"></i><i class="onda" aria-hidden="true"></i><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.8" y="6.6" width="12.6" height="10.8" rx="2.4" /><path d="M15.4 10.4l5.2-3v9.2l-5.2-3z" /></svg></button>
        </figcaption>
      </figure>
            )}
            <a class={`pieza ${s.tipo}`} data-slug={c.slug} href={`https://${c.dominio}`} target="_blank" rel="noopener" data-pieza style={`--col:${s.col};--ratio:${s.ratio};--baja:${s.baja};--giro:${s.giro ?? 0}deg;--i:${(i % 3) + 1};--c1:${c.color[0]};--c2:${c.color[1]};--c3:${c.color[2]}`}>
              <div class={`lamina ${s.g ?? ''}`}>
                {s.tipo === 'escena' ? (
                  <div class="mesa" style={`--z:${Z};--left:${left.toFixed(2)};--cy:${s.cy};--py:${py}`}>
                    <img class="foto" src={`/media/estudio/${s.est}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />
                    <span class="pantalla"><Fragment set:html={video} /></span>
                  </div>
                ) : quad ? (
                  <div class="mesa" style={`--z:${Z};--left:${left.toFixed(2)};--cy:${s.cy};--py:${py}`} data-mesa-quad>
                    <img class="foto" src={`/media/anteriores/${QUAD[s.tipo].foto}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />
                    <span class="pantalla quad" style={`left:${((quad.x0 / LAM.w) * 100).toFixed(3)}%;top:${((quad.y0 / LAM.h) * 100).toFixed(3)}%;width:${((quad.W / LAM.w) * 100).toFixed(3)}%;height:${((quad.H / LAM.h) * 100).toFixed(3)}%;transform:${quad.matriz}`}><Fragment set:html={video} /></span>
                  </div>
                ) : (
                  <div class="mockup">
                    <span class="cromo" aria-hidden="true"><i /><i /><i /><b>{c.dominio}</b></span>
                    <Fragment set:html={video} />
                  </div>
                )}
                <h3 class="nombre font-display">{c.n}</h3>
                <!-- RONDA 41 · «añadir un icono de que los mockups tienen vídeo al hacer hover»: se ve en reposo y se retira mientras el vídeo suena -->
                <span class="vid-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="2.8" y="6.6" width="12.6" height="10.8" rx="2.4" /><path d="M15.4 10.4l5.2-3v9.2l-5.2-3z" /></svg></span>
              </div>
              <p class="pie detail text-fg2 mt-4"><span class="text-fg">{c.dominio}</span>{c.sector && <> · {c.sector}</>}</p>
            </a>
            </>
          );
        })
      }
    </div>
  </div>
  <!-- RONDA 46 · EL REPRODUCTOR de los testimonios en vídeo: una tarjeta oscura que se PINTA desde la cámara (el cambio de estación del árbol, como
       el menú), el vídeo sin los controles del navegador y, debajo, los nuestros: reproducir, el hilo de savia que mide y busca, el tiempo en mono
       y el sonido. Esc, la × o un clic fuera lo cierran (se recoge hacia la cámara). -->
  <dialog class="reproductor" aria-labelledby="rep-n" data-reproductor>
    <div class="rep-panel surface-dark" data-rep-panel>
      <header class="rep-cab">
        <p class="rep-quien"><span id="rep-n" class="nombre-v" data-rep-n></span><span class="rol" data-rep-r></span></p>
        <button type="button" class="rep-x" aria-label="Cerrar el vídeo" data-rep-cerrar><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg></button>
      </header>
      <div class="rep-vista">
        <video class="rep-video" playsinline preload="metadata" data-rep-video></video>
        <button type="button" class="rep-grande" aria-label="Reproducir" tabindex="-1" data-rep-grande><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg></button>
      </div>
      <div class="rep-mandos">
        <button type="button" class="rep-bt" aria-label="Reproducir" data-rep-play>
          <svg class="ic-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z" /></svg>
          <svg class="ic-pausa" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13M16 5.5v13" /></svg>
        </button>
        <span class="rep-hilo" role="slider" tabindex="0" aria-label="Posición del vídeo" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-rep-hilo><i></i></span>
        <span class="rep-t detail" data-rep-t>0:00 / 0:00</span>
        <button type="button" class="rep-bt" aria-label="Silenciar" data-rep-son>
          <svg class="ic-son" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" /><path d="M15.5 9.2a4 4 0 010 5.6M18 6.8a7.5 7.5 0 010 10.4" /></svg>
          <svg class="ic-mudo" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" /><path d="M16 10l4 4M20 10l-4 4" /></svg>
        </button>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { dibujar } from '../scripts/dibujar';
  // RONDA 19 · el VÍDEO de cada web: al pasar el cursor o enfocar la pieza; en táctil (sin hover), mientras la pieza está a la vista.
  // Con movimiento reducido no se reproduce solo. La fuente se carga la primera vez que hace falta (preload="none").
  {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches, conRaton = matchMedia('(hover: hover)').matches;
    const vids = [...document.querySelectorAll<HTMLVideoElement>('[data-vid]')];
    const tocar = (v: HTMLVideoElement, si: boolean) => { if (si) { v.play().catch(() => {}); } else { v.pause(); } };
    vids.forEach((v) => {
      const pieza = v.closest('[data-pieza]')!;
      v.addEventListener('playing', () => pieza.classList.add('suena'));
      v.addEventListener('pause', () => pieza.classList.remove('suena'));
      if (reducido) return;
      if (conRaton) {
        pieza.addEventListener('pointerenter', () => tocar(v, true));
        pieza.addEventListener('pointerleave', () => tocar(v, false));
        pieza.addEventListener('focusin', () => tocar(v, true));
        pieza.addEventListener('focusout', () => tocar(v, false));
      } else new IntersectionObserver((e) => tocar(v, e[0].isIntersecting), { threshold: 0.55 }).observe(pieza);
    });
    // las pantallas en perspectiva: la homografía lleva píxeles → hace falta la escala real de la lámina (--s = ancho de la mesa / 1672)
    const mesas = [...document.querySelectorAll<HTMLElement>('[data-mesa-quad]')];
    const ro = new ResizeObserver((es) => es.forEach((e) => (e.target as HTMLElement).style.setProperty('--s', String(e.contentRect.width / 1672))));
    mesas.forEach((m) => { m.style.setProperty('--s', String(m.offsetWidth / 1672)); ro.observe(m); });
  }
  // ── LAS VOCES QUE ROTAN (ronda 40): 9 s cada una; se paran con el puntero encima, fuera de pantalla o con movimiento reducido; el nombre se elige
  {
    const caja = document.querySelector<HTMLElement>('[data-voces]');
    if (caja) {
      const citas = [...caja.querySelectorAll<HTMLElement>('[data-cita]')], quienes = [...caja.querySelectorAll<HTMLElement>('[data-quien]')];
      const piezas = [...document.querySelectorAll<HTMLElement>('#anteriores [data-slug]')];
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches, DUR = 9000;
      const camara = caja.querySelector<HTMLButtonElement>('[data-voz-video]')!;
      let k = 0, visible = false, quieto = false, t0 = 0, raf = 0, t = 0, viendo = false;
      const poner = (n: number) => {
        k = (n + citas.length) % citas.length;
        citas.forEach((c, i) => { c.classList.toggle('on', i === k); c.setAttribute('aria-hidden', String(i !== k)); });
        quienes.forEach((q, i) => { q.classList.toggle('on', i === k); q.setAttribute('aria-hidden', String(i !== k)); });
        piezas.forEach((p) => p.classList.toggle('citado', p.dataset.slug === citas[k].dataset.de));
        const hay = !!citas[k].dataset.video; camara.classList.toggle('apagada', !hay); camara.tabIndex = hay ? 0 : -1; camara.setAttribute('aria-hidden', String(!hay));
        t = 0; t0 = performance.now();
      };
      const paso = (ahora: number) => {
        raf = 0;
        if (!visible || reducido) return;
        if (quieto || viendo) t0 = ahora - t * DUR;
        else { t = (ahora - t0) / DUR; if (t >= 1) poner(k + 1); }
        raf = requestAnimationFrame(paso);
      };
      caja.querySelectorAll<HTMLButtonElement>('[data-voz]').forEach((b) => b.addEventListener('click', () => poner(k + Number(b.dataset.voz))));
      // ── RONDA 46 · EL REPRODUCTOR
      const dlg = document.querySelector<HTMLDialogElement>('[data-reproductor]')!, panel = dlg.querySelector<HTMLElement>('[data-rep-panel]')!;
      const vid = dlg.querySelector<HTMLVideoElement>('[data-rep-video]')!, hilo = dlg.querySelector<HTMLElement>('[data-rep-hilo]')!;
      const bPlay = dlg.querySelector<HTMLButtonElement>('[data-rep-play]')!, bSon = dlg.querySelector<HTMLButtonElement>('[data-rep-son]')!;
      const tTxt = dlg.querySelector<HTMLElement>('[data-rep-t]')!, grande = dlg.querySelector<HTMLButtonElement>('[data-rep-grande]')!;
      const mmss = (x: number) => { const n = Math.max(0, Math.floor(x || 0)); return `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`; };
      const pintarT = () => {
        const d = vid.duration || 0, p = d ? vid.currentTime / d : 0;
        hilo.style.setProperty('--p', p.toFixed(4)); hilo.setAttribute('aria-valuenow', String(Math.round(p * 100)));
        tTxt.textContent = `${mmss(vid.currentTime)} / ${mmss(d)}`;
      };
