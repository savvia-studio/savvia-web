        pz.classList.add(f === 'navegador' ? pz.dataset.nav! : f);
        pz.dataset.forma = f;
        // la pantalla en perspectiva necesita la escala real de su mesa (oculta medía 0)
        if (ve?.matches('[data-mesa-quad]')) ve.style.setProperty('--s', String(ve.offsetWidth / 1672));
        // el póster del vídeo de la escena que llega (el observador de carteles no ve lo que estaba oculto)
        ve?.querySelectorAll<HTMLVideoElement>('video[data-poster]').forEach((v) => { if (!v.poster) v.poster = v.dataset.poster!; });
        pz.dispatchEvent(new Event('pieza:forma'));
        if (quieto) return;
        pz.classList.remove('aparece'); void pz.offsetWidth; pz.classList.add('aparece');
        setTimeout(() => pz.classList.remove('aparece'), 650);
      });
    });
    document.getElementById('anteriores')?.classList.add('con-escenas'); // sin JS, el botoncito no está
  }
  // ENTRADA de cada pieza al asomar (sin JS o con movimiento reducido están ya puestas: los estados ocultos cuelgan de html.anima)
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visto'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
  document.querySelectorAll('[data-pieza]').forEach((p) => io.observe(p));
  // RONDA 77 · los HEROES que rotan en la pieza de entrada: cada 4,2 s, solo a la vista; el que se va se desenfoca y el que llega enfoca (el relevo de
  // la casa) y el degradado vira a los colores de su web (@property --c1…3)
  const rota = document.querySelector<HTMLElement>('[data-rota]');
  if (rota && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const hs = [...rota.querySelectorAll<HTMLElement>('[data-heroe]')], ns = [...rota.closest('.pieza')!.querySelectorAll<HTMLElement>('[data-heroe-n]')], colores: string[][] = JSON.parse(rota.dataset.colores!), claros: boolean[] = JSON.parse(rota.dataset.claros!);
    let k = 0, reloj = 0;
    // RONDA 78 · «al cambiar entre proyectos, que tenga alguna animación»: el navegador que se va se hunde y se desenfoca; el nuevo SUBE desde abajo a su
    // sitio (como entran las piezas); el nombre sale palabra a palabra por arriba y el nuevo sube desde su máscara (el gesto de los titulares)
    const sig = () => {
      const va = k; hs[va].classList.remove('on'); hs[va].classList.add('sale'); ns[va].classList.remove('on'); ns[va].classList.add('sale');
      setTimeout(() => { hs[va].classList.remove('sale'); ns[va].classList.remove('sale'); }, 1700);
      k = (k + 1) % hs.length; hs[k].classList.add('on'); ns[k].classList.add('on');
      colores[k].forEach((c, i) => rota.style.setProperty(`--c${i + 1}`, c));
      rota.classList.toggle('tinta-oscura', claros[k]);
    };
    // ronda 190: las capturas, ya descodificadas antes del primer relevo (el que llegaba entraba en blanco y se pintaba a media pasada)
    new IntersectionObserver((e) => { clearInterval(reloj); if (e[0].isIntersecting) { rota.querySelectorAll('img').forEach((im) => im.decode().catch(() => {})); reloj = window.setInterval(sig, 4600); } }, { threshold: 0.3 }).observe(rota);
  }
</script>

<style>
