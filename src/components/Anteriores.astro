---
// OTROS TRABAJOS (rondas 17–18). Andoni: «otros trabajos lo quiero mostrar más estilo agencia creativa […] northmail.app, como tienen la sección
// "Channels designed for life's moments": así quiero mostrar los proyectos. Con mockups, gradientes de ese estilo».
// Referencia medida: titular grande arriba a la izquierda; MOSAICO asimétrico sobre 12 columnas (piezas de tamaños distintos, escalonadas, con
// mucho aire); cada pieza = una imagen con el nombre GRANDE encima, arriba a la izquierda, y un pie pequeño debajo; la primera pieza es un
// degradado de aerógrafo con un icono y el texto de entrada.
// RONDA 18 · «le tenemos que dar más aire […] y no podemos usar el mismo gradiente en todos. Lo ideal sería usar en algunas imágenes un mockup
// con fondo realista como el que hemos puesto con estaciones. Tener variedad. Y que entren con alguna animación»:
//   · TRES tipos de pieza: `escena` (la mesa de Andoni en una estación, con la web del cliente DENTRO del monitor: la pantalla está medida
//     en la lámina), `claro` (degradado pálido, navegador RECTO y cortado por abajo, nombre en Cacao) y `mancha` (degradado intenso u oscuro,
//     navegador ladeado). Ninguna repite fondo. Iris no entra (significa «la IA»). Excepción consciente a «sin degradados» de DESIGN.md.
//   · AIRE: piezas más estrechas, tres filas escalonadas con huecos de columna vacíos y 128 px entre filas.
//   · ENTRADA: cada pieza se descubre de abajo arriba (recorte), su fondo llega ampliado y se asienta, y el mockup sube después.
// RONDA 19 · Andoni: «las barras de los navegadores son muy gordas y en Remerge deberíamos enseñar la versión móvil. Luego estaría guay que al
// hacer hover se viera el vídeo de cada proyecto». Y dos láminas más de la mesa: un MÓVIL en la mesa y un iMac en la mesa de ROBLE.
//   · Cada pieza lleva el VÍDEO real de la web del cliente (Chrome real recorriendo la página, `tools/grabar-otros.cjs` → mp4 de 7 s, sin
//     sonido; Remerge grabada a 390 px como móvil). Se reproduce al pasar el cursor o enfocar; en táctil, mientras la pieza está a la vista.
//     El primer fotograma es el póster. (brag redibuja la web en HTML: para webs ajenas es mejor grabar la real.)
//   · Las pantallas del móvil y del iMac no son rectas: están en PERSPECTIVA. Sus cuatro esquinas se han medido en la lámina y de ahí sale una
//     HOMOGRAFÍA (cuadrado unidad → cuadrilátero) que se aplica como `matrix3d`; los términos de perspectiva y traslación van en píxeles, así que
//     dependen del tamaño real de la lámina en pantalla: el JS mide la mesa y deja la escala en `--s`.
//   · Barras de navegador a 16 px (antes 24).
import { home } from '../data/idioma';
import { langDe, ruta } from '../lib/i18n';
import { CASOS_LISTOS } from '../lib/lanzamiento';
// 28/10 · Eric: con caso de estudio (lanzamiento.ts › CASOS_LISTOS), la card lleva al CASO, no al visor; el slug de la home es el del dominio (neety-com → neety)
const casoDe = (c: { slug: string; dominio?: string }) => CASOS_LISTOS.find((s) => c.slug === s || c.dominio?.startsWith(`${s}.`));
const lang = langDe(Astro.currentLocale), en = lang === 'en';
const { proyectos } = home(lang);
import { proyectos as OBRA } from '../data/proyectos';
// RONDA 77 · Andoni: «donde estaban los logos pusimos el reel, pero prefiero HEROES que van rotando con el estilo del resto, rotando entre varios»: la
// pieza de entrada es una pieza de marca más (degradado de su web + navegador que asoma), que rota entre los heroes de los destacados
// RONDA 78 · «que todos los títulos se lean sobre el fondo»: si el fondo de su web es claro (luminancia relativa del primer color > 0,5), el nombre va en Cacao
const claro = (hex: string) => { const [r, g, b] = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((c) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)); return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.5; };
const A = proyectos.anteriores;
const T = proyectos.testimonios;
// RONDA 292 · el slider de los 4 mentores con retrato fuera del mosaico (probado dentro y vuelto a quitar; irá a cada caso de estudio); `true` lo devuelve
const VOZ_EN_MOSAICO = false;
import sharp from 'sharp';
import MESA_MOVIL from '../data/mesa-movil.json';
// las webs que tienen grabación en móvil (<slug>-movil.mp4); las demás, en el móvil, enseñan la de escritorio recortada
const CON_MOVIL = new Set(['remerge', 'neety-com', 'cubbo']); // ronda 204: Neety, grabada por Eric en móvil (Screen Studio, 500 × 1080) · ronda 206: Cubbo (Chrome a 390 px, tools/r189/grabar.cjs)
// RONDA 65 · dos FRANJAS entre filas del mosaico: HECHOS Y LOGOTIPOS tras la primera (estilo minimum.run: una línea, la frase a la izquierda, los hechos
// numerados a la derecha y el muro de logotipos en baldosas, cada logotipo una máscara en el color del texto) y TESTIMONIOS tras la tercera (la captura de
// Andoni: franja oscura a sangre, una línea sobre cada uno, el RETRATO grabado —la imagen la prepara Andoni; sin ella, la tarjeta empieza por la cita—,
// el nombre y el cargo). Fuera las voces que rotaban, el reproductor dormido y la flora.
type Sitio = { col: string; ratio: string; baja: number; tipo: 'escena' | 'claro' | 'mancha' | 'movil' | 'roble' | 'tel'; g?: string; giro?: number; est?: string; zoom?: number; cy?: number; izq?: boolean; espejo?: boolean; fondo?: string; barrido?: number; m?: [number, number, number] };
// Los DEGRADADOS salen de los colores de la web de cada cliente (home.ts › color); las escenas no llevan degradado (llevan la mesa).
// RONDA 40 · «los testimonios ponemos menos cantidad y que sean animados y vayan rotando; si se nos ocurre alguna manera original de mostrarlos,
// mejor»: TRES voces en un solo sitio del mosaico, junto a Isotrol. Cada cita entra palabra a palabra (el gesto de los titulares), un hilo de savia
// mide su tiempo bajo el nombre de quien la dice, y si habla de un proyecto del mosaico, ese proyecto se SEÑALA (un punto de savia en su pie).
const SITIO: Sitio[] = [
  // RONDA 202 · Eric, desde el artefacto «Fondos de proyectos»: proporción, giro y el navegador colocado a mano en cada pieza (`m`: x, y y ancho, en % de la pieza)
  { col: '1 / span 3', ratio: '1 / 1', baja: 0, tipo: 'mancha', g: 'g-marca', giro: -2.5, m: [5, 17, 111], fondo: '/media/anteriores/fondos/mas-wisable.webp' },
  { col: '5 / span 4', ratio: '1 / 1', baja: 0, tipo: 'escena', est: 'otono', zoom: 2.88, cy: 0.5 },
  { col: '10 / span 3', ratio: '4 / 5', baja: 32, tipo: 'mancha', g: 'g-marca', giro: 4.5, m: [10, 23, 116] },
  { col: '2 / span 4', ratio: '4 / 5', baja: 0, tipo: 'movil', zoom: 2.3, cy: 0.47, espejo: true }, // ronda 206: Cubbo, el móvil de la mesa en ESPEJO y con la cámara más abierta (el de Neety, en cuadro cerrado)
  { col: '8 / span 4', ratio: '1 / 1', baja: 24, tipo: 'claro', g: 'g-marca', giro: 0, m: [7, 11, 132], fondo: '/media/anteriores/fondos/mas-transcend.webp' },
  { col: '1 / span 3', ratio: '1 / 1', baja: 8, tipo: 'mancha', g: 'g-marca', giro: -2.5, m: [6, 17, 118] },
  { col: '5 / span 4', ratio: '3 / 4', baja: 8, tipo: 'movil', zoom: 2.5, cy: 0.5 }, // el móvil sobre la mesa; sin grabación en móvil, la de escritorio recortada
  { col: '10 / span 3', ratio: '4 / 5', baja: 40, tipo: 'mancha', g: 'g-marca', giro: 4, m: [9, 20, 118] },
];
// RONDA 42 · «los testimonios no van antes de nuestros proyectos, van entre medias, y que puedas cambiar de testimonio con unas flechas muy sutiles»:
// una fila entera en medio del mosaico (tras la primera fila de proyectos), centrada; el nombre de quien habla entre dos flechas finas.
// la pantalla del monitor dentro de la lámina de la mesa (medida en la ronda 6)
const PANT = { x: 0.3903, y: 0.3696, w: 0.2178, h: 0.2104 }; // ronda 26: la caja blanca entera
const LAM = { w: 1672, h: 941 };
const ZV = 2.5; // 27/10 · en el visor, cuánto se amplía la lámina para que el monitor llene el panel (obra/Visor.astro)
// las pantallas en perspectiva: esquinas medidas por inundación en la lámina (px): TL · TR · BR · BL
const QUAD: Record<string, { foto: string; q: [number, number][] }> = {
  // 27/10 · Eric (el marco del móvil: «muy fiel a la realidad», «sin muesca», «cuidado con el 1 px en blanco», «que no se recorte tanto arriba»): las esquinas de la
  // pantalla, MEDIDAS en la foto (una recta por borde del cristal): la caja negra 4 px por fuera y el vídeo 1 px, en src/data/mesa-movil.json (tools/mesa-movil/mascara.cjs, que hace también la máscara)
  movil: { foto: 'mesa-movil', q: MESA_MOVIL.movil.caja as [number, number][] }, // ronda 67: esquinas de las rectas ajustadas a los cuatro bordes de la pantalla (antes, las de dentro del redondeo)
  'movil-espejo': { foto: 'mesa-movil-espejo', q: MESA_MOVIL['movil-espejo'].caja as [number, number][] }, // ronda 206: la lámina del móvil volteada (x' = 1672 − x; esquinas TL·TR·BR·BL reordenadas)
  roble: { foto: 'mesa-roble', q: [[792, 274], [1220, 249], [1212, 535], [781, 519]] },
};
// homografía del cuadrado unidad al cuadrilátero (Heckbert): x' = (a·u + b·v + c) / (g·u + h·v + 1)
function homografia(p: [number, number][]) {
  const [[x0, y0], [x1, y1], [x2, y2], [x3, y3]] = p;
  const dx1 = x1 - x2, dx2 = x3 - x2, dx3 = x0 - x1 + x2 - x3, dy1 = y1 - y2, dy2 = y3 - y2, dy3 = y0 - y1 + y2 - y3;
  const det = dx1 * dy2 - dx2 * dy1;
  const g = (dx3 * dy2 - dx2 * dy3) / det, h = (dx1 * dy3 - dx3 * dy1) / det;
  return { a: x1 - x0 + g * x1, b: x3 - x0 + h * x3, c: x0, d: y1 - y0 + g * y1, e: y3 - y0 + h * y3, f: y0, g, h };
}
// la caja de la pantalla (px de la lámina) y la matriz que la lleva a sus esquinas; los términos con píxeles se dejan como variables
function escenaQuad(k: string) {
  const { q } = QUAD[k];
  const x0 = Math.min(q[0][0], q[3][0]), y0 = Math.min(q[0][1], q[1][1]), x1 = Math.max(q[1][0], q[2][0]), y1 = Math.max(q[2][1], q[3][1]);
  const W = x1 - x0, H = y1 - y0;
  const n = q.map(([x, y]) => [(x - x0) / W, (y - y0) / H] as [number, number]);
  const m = homografia(n);
  const r = (v: number) => +v.toFixed(6);
  // matrix3d(m11 m12 m13 m14 · m21 m22 m23 m24 · m31… · m41 m42 m43 m44): x' = m11x + m21y + m41; w' = m14x + m24y + 1
  const matriz = `matrix3d(${r(m.a)}, ${r((m.d * H) / W)}, 0, calc(${r(m.g / W)} / var(--s)), ${r((m.b * W) / H)}, ${r(m.e)}, 0, calc(${r(m.h / H)} / var(--s)), 0, 0, 1, 0, calc(${r(m.c * W)} * var(--s)), calc(${r(m.f * H)} * var(--s)), 0, 1)`;
  return { x0, y0, W, H, cx: (x0 + x1) / 2 / LAM.w, cy: (y0 + y1) / 2 / LAM.h, matriz };
}
// el paisaje barrido de la variante v en las cuatro estaciones (el CSS elige el de la estación de la web)
const BARRIDO = (v: number) => ['primavera', 'verano', 'otono', 'invierno'].map((e) => `--b-${e}:url('/media/anteriores/fondos/barrido-${v}-${e}.webp')`).join(';');
// 27/10 · las escenas que no son la propia de cada card (el botoncito): el navegador de las cards de mesa, por proporción; y el vídeo de escritorio o de móvil
const NAV_ALT: Record<string, [number, number, number]> = { '1 / 1': [6, 17, 118], '4 / 5': [10, 23, 116], '3 / 4': [9, 20, 118] };
// las que tienen grabación en móvil (`<slug>-movil.mp4`, con su póster `.jpg`): si el póster se lee, la hay (como la toma grande del visor)
// 29/10 · Eric: sin móvil aunque haya grabación, las que no convencen en el teléfono (Home of Ambrose, Transcend, Isotrol y GOW; igual que en Portfolio.astro › SIN_MOVIL)
const SIN_MOVIL = new Set(['home-of-ambrose', 'transcend-network', 'isotrol', 'gow-delivery']);
const GRABADA_MOVIL = new Set((await Promise.all(A.filter((c) => !SIN_MOVIL.has(c.slug)).map((c) => sharp(`public/media/anteriores/video/${c.slug}-movil.jpg`).metadata().then(() => c.slug, () => '')))).filter(Boolean));
const NAV_GIRO: Record<string, number> = { '1 / 1': -2.5, '4 / 5': 4.5, '3 / 4': 4 };
const vid = (c: { slug: string; n: string }, movil: boolean) => `<video class="vid" muted loop playsinline preload="none" data-poster="/media/anteriores/video/${c.slug}${movil ? '-movil' : ''}.jpg" width="${movil ? 390 : 960}" height="${movil ? (c.slug === 'cubbo' ? 798 : 844) : 600}" aria-label="${en ? `Walkthrough of the ${c.n} website` : `Recorrido por la web de ${c.n}`}" data-vid><source src="/media/anteriores/video/${c.slug}${movil ? '-movil' : ''}.mp4" type="video/mp4" /></video>`;
import { flecha } from '../lib/flecha';
import Cuadricula from './Cuadricula.astro'; // ronda 296: la cuadrícula, en su componente (también va en /proyectos)
import { icono } from '../lib/iconos';
---

<section id="anteriores" class="surface-light section-y anteriores" aria-labelledby="ant-h" data-sin-fila>
  <div class="wrap">
    <!-- RONDA 189 · Eric: «después del mockup deberíamos poner el grid de reviews y demás»: la cuadrícula (citas, logotipos y cifras) abre la
         sección, justo tras Proyectos destacados; antes iba tras la primera fila del mosaico -->
    <!-- RONDA 24 · «ver todos los proyectos a la derecha del titular pegado a la línea derecha, con una animación más fluida, como que se rellena de
         naranja, y la flecha más minimalista» -->
    <!-- RONDA 190 · «quita el titular "Más proyectos"» + «deja el espacio que ocupaba en blanco»: el titular sigue ocupando su sitio,
         invisible (aria-labelledby lo sigue leyendo aunque esté oculto) -->
    <div class="cabecera flex flex-wrap items-end justify-between gap-6 hidden">
      <h2 id="ant-h" class="text-h1 max-w-[12ch] mt-24 lg:mt-32 invisible">{proyectos.titulo2}</h2>
    </div>
    <div class="mosaico">
      <!-- RONDA 191 · Eric: «aquí a la izquierda quitamos lo de destacados y ponemos Home of Ambrose con otro gradiente y el vídeo»: fuera la pieza de
           entrada que rotaba (rondas 77–191); su sitio (columnas 1–3, cuadrada) lo ocupa Home of Ambrose como una pieza más (SITIO[0]) -->
      {
        A.map((c, i) => {
          const s = SITIO[i];
          // escena: la lámina se amplía `zoom` veces y se coloca para que el centro de la pantalla caiga en (50 %, cy) de la pieza
          const Z = s.zoom ?? 3;
          const clave = s.espejo ? 'movil-espejo' : s.tipo;
          const quad = s.tipo === 'movil' || s.tipo === 'roble' ? escenaQuad(clave) : null;
          const cx = quad ? quad.cx : PANT.x + PANT.w / 2, py = quad ? quad.cy : PANT.y + PANT.h / 2, left = 50 - cx * Z * 100;
          const esMovil = (s.tipo === 'movil' || s.tipo === 'tel') && CON_MOVIL.has(c.slug);
          // el VÍDEO de la web (con su primer fotograma de póster); Remerge, grabada como móvil. (Como HTML: Astro no renderiza funciones JSX.)
          const video = `<video class="vid" muted loop playsinline preload="none" data-poster="/media/anteriores/video/${c.slug}${esMovil ? '-movil' : ''}.jpg" width="${esMovil ? 390 : 960}" height="${esMovil ? (c.slug === 'cubbo' ? 798 : 844) : 600}" aria-label="${en ? `Walkthrough of the ${c.n} website` : `Recorrido por la web de ${c.n}`}" data-vid><source src="/media/anteriores/video/${c.slug}${esMovil ? '-movil' : ''}.mp4" type="video/mp4" /></video>`;
          // 27/10 · las ESCENAS: la propia (la del sitio, como siempre) y las otras dos, para el botoncito. `nav` = la clase del navegador (mancha o claro)
          const propia = s.tipo === 'escena' ? 'escena' : s.tipo === 'movil' || s.tipo === 'tel' ? 'movil' : 'navegador';
          const nav = s.tipo === 'claro' ? 'claro' : 'mancha';
          // el navegador de las cards que no lo llevan: colocado como sus vecinas de la misma proporción (sin efecto en la escena propia: solo lo leen .mancha/.claro .mockup)
          const m = s.m ?? NAV_ALT[s.ratio], giro = s.giro ?? (s.m ? 0 : NAV_GIRO[s.ratio] ?? 0);
          const vEscritorio = vid(c, false), vMovil = vid(c, true);
          // el móvil de la mesa (sin espejo), solo si hay grabación en móvil
          const qAlt = propia !== 'movil' && GRABADA_MOVIL.has(c.slug) ? escenaQuad('movil') : null;
          return (
            <>
            {/* RONDA 292 · Eric: «tras savvia agentic los 5 proyectos, luego el grid y luego 3 proyectos más»: la cuadrícula ocupa una fila entera del mosaico, entre el 5.º y el 6.º */}
            {i === 5 && (
    <div class="cuadricula-arriba">
      <Cuadricula />
    </div>
            )}
            {VOZ_EN_MOSAICO && i === 5 && (
              <figure class="banda voz" data-banda data-voz>
                <!-- RONDA 67 · «a los retratos, el estilo dithering, que se mimeticen más con el fondo; el cambio, animado con el estilo de savvia»: cada retrato
                     se pinta como TRAMA DE PUNTOS en el color del texto (lienzo 2D; la imagen es solo la fuente) y el relevo es el pintado rasgado de savvia -->
                <div class="retratos" aria-hidden="true" data-retratos>
                  {T.map((t, k) => <img class="fuente-r" src={t.retrato} alt="" width="800" height="800" loading="lazy" decoding="async" data-retrato />)}
                  <canvas class="retrato-cv" data-rc></canvas>
                  <canvas class="retrato-cv" data-rc></canvas>
                </div>
                <div class="voz-txt">
                  <div class="citas">
                    {T.map((t, k) => <blockquote class={`vq font-display ${k === 0 ? 'on' : ''}`} aria-hidden={k === 0 ? 'false' : 'true'} data-vq>{en ? `“${t.q}”` : `«${t.q}»`}</blockquote>)}
                  </div>
                  <div class="pie-voz">
                  <figcaption class="autor">
                    <span class="quienes">
                      {T.map((t, k) => <span class={`quien ${k === 0 ? 'on' : ''}`} aria-hidden={k === 0 ? 'false' : 'true'} data-quien><b>{t.n}</b><span>{t.r}</span></span>)}
                    </span>
                  </figcaption>
                  <!-- RONDA 144 · la barra de cristal de la casa (Eric: «las flechas no tienen el mismo espacio a cada lado») -->
                  <div class="barra-cristal barra-voz" role="group" aria-label={en ? 'Testimonials' : 'Testimonios'}>
                    <button type="button" class="paso" aria-label={en ? 'Previous testimonial' : 'Testimonio anterior'} data-paso="-1"><Fragment set:html={flecha('izq')} /></button>
                    <button type="button" class="paso" aria-label={en ? 'Next testimonial' : 'Testimonio siguiente'} data-paso="1"><Fragment set:html={flecha()} /></button>
                  </div>
                  </div>
                </div>
              </figure>
            )}
            {/* 27/10 · Eric: «en la home tienes que dejar como están, PERO sí que tenemos que dar la oportunidad de cambiar de mobile/mesa y eso como en proyecto»: cada card
                va en una CELDA (lleva el sitio del mosaico y las variables) con el botoncito de escena al lado del enlace, fuera de él (como Portfolio.astro › li[data-obra]) */}
            <div class="celda" data-celda style={`--col:${s.col};--ratio:${s.ratio};--baja:${s.baja};${m ? `--mx:${m[0]}%;--top:${m[1]}%;--mw:${m[2]}%;` : s.ratio === '3 / 4' ? '--top:20%;' : ''}--giro:${giro}deg;--i:${(i % 3) + 1};--c1:${c.color[0]};--c2:${c.color[1]};--c3:${c.color[2]}`}>
            <a class={`pieza ${s.tipo} ${s.izq ? 'izq' : ''} ${s.tipo !== 'claro' && claro(c.color[0]) ? 'tinta-oscura' : ''}`} data-slug={c.slug} data-tipo={s.tipo} data-forma={propia} data-nav={nav} href={casoDe(c) ? ruta(lang, `/proyectos/${casoDe(c)}`) : `https://${c.dominio}`} target={casoDe(c) ? undefined : '_blank'} rel={casoDe(c) ? undefined : 'noopener'} data-caso={casoDe(c) ? '' : undefined} data-pieza>
              <div class={`lamina ${s.g ?? 'g-marca'} ${s.fondo || s.barrido != null ? 'con-fondo' : ''} ${s.barrido != null ? 'barrido' : ''}`} style={s.fondo ? `--fondo:url('${s.fondo}')` : s.barrido != null ? BARRIDO(s.barrido) : undefined}>
                {/* las escenas que no son la suya: ocultas, sin descargar nada hasta que se eligen (las fotos llevan data-src; los vídeos, preload="none" y el póster al verse) */}
                {propia !== 'navegador' && <div class="mockup" data-f="navegador"><Fragment set:html={vEscritorio} /></div>}
                {propia !== 'escena' && (
                  <div class="mesa alt" data-f="escena" style={`--z:2.88;--left:${(50 - (PANT.x + PANT.w / 2) * 2.88 * 100).toFixed(2)};--cy:0.5;--py:${PANT.y + PANT.h / 2}`}>
                    {['primavera', 'verano', 'otono', 'invierno'].map((e) => <img class="foto foto-e" data-e={e} data-src={`/media/estudio/${e}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />)}
                    <span class="pantalla"><Fragment set:html={vEscritorio} /></span>
                  </div>
                )}
                {propia !== 'movil' && qAlt && (
                  <div class="mesa alt" data-f="movil" style={`--z:2.5;--left:${(50 - qAlt.cx * 2.5 * 100).toFixed(2)};--cy:0.5;--py:${qAlt.cy}`} data-mesa-quad>
                    {['primavera', 'verano', 'otono', 'invierno'].map((e) => <img class="foto foto-e" data-e={e} data-src={`/media/anteriores/${QUAD.movil.foto}-${e}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />)}
                    <span class="pantalla quad" style={`--mascara:url(/media/anteriores/${QUAD.movil.foto}-mascara.png?v=5);--cristal:url(/media/anteriores/${QUAD.movil.foto}-cristal.png?v=5);--vx:${MESA_MOVIL.movil.video[0]}%;--vy:${MESA_MOVIL.movil.video[1]}%;--vw:${MESA_MOVIL.movil.video[2]}%;--vh:${MESA_MOVIL.movil.video[3]}%;left:${((qAlt.x0 / LAM.w) * 100).toFixed(3)}%;top:${((qAlt.y0 / LAM.h) * 100).toFixed(3)}%;width:${((qAlt.W / LAM.w) * 100).toFixed(3)}%;height:${((qAlt.H / LAM.h) * 100).toFixed(3)}%;transform:${qAlt.matriz}`}><Fragment set:html={vMovil} /></span>
                  </div>
                )}
                {s.tipo === 'escena' ? (
                  <div class="mesa" data-f="escena" style={`--z:${Z};--left:${left.toFixed(2)};--cy:${s.cy};--py:${py}`}>
                    {/* RONDA 232 · Andoni: «el de Home of Ambrose no cambia el mockup de estación»: la mesa del estudio, una lámina por estación (como el móvil) */}
                    {['primavera', 'verano', 'otono', 'invierno'].map((e) => <img class="foto foto-e" data-e={e} src={`/media/estudio/${e}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />)}
                    <span class="pantalla"><Fragment set:html={video} /></span>
                  </div>
                ) : quad ? (
                  <div class="mesa" data-f="movil" style={`--z:${Z};--left:${left.toFixed(2)};--cy:${s.cy};--py:${py}`} data-mesa-quad>
                    {/* RONDA 209 · el móvil de la mesa en la estación de la web (una lámina por estación; en espejo, la misma volteada): solo se pinta y se descarga
                        la de la estación activa */}
                    {['primavera', 'verano', 'otono', 'invierno'].map((e) => <img class="foto foto-e" data-e={e} src={`/media/anteriores/${QUAD[clave].foto}-${e}.webp`} alt="" width="1672" height="941" loading="lazy" decoding="async" />)}
                    <span class="pantalla quad" style={`${s.tipo === 'movil' ? `--mascara:url(/media/anteriores/${QUAD[clave].foto}-mascara.png?v=5);--cristal:url(/media/anteriores/${QUAD[clave].foto}-cristal.png?v=5);--vx:${MESA_MOVIL[clave as 'movil'].video[0]}%;--vy:${MESA_MOVIL[clave as 'movil'].video[1]}%;--vw:${MESA_MOVIL[clave as 'movil'].video[2]}%;--vh:${MESA_MOVIL[clave as 'movil'].video[3]}%;` : ''}left:${((quad.x0 / LAM.w) * 100).toFixed(3)}%;top:${((quad.y0 / LAM.h) * 100).toFixed(3)}%;width:${((quad.W / LAM.w) * 100).toFixed(3)}%;height:${((quad.H / LAM.h) * 100).toFixed(3)}%;transform:${quad.matriz}`}><Fragment set:html={video} /></span>
                  </div>
                ) : s.tipo === 'tel' ? (
                  <div class="tel-m"><span class="tel-pant"><Fragment set:html={video} /></span></div>
                ) : (
                  <div class="mockup" data-f="navegador">
                    <Fragment set:html={video} />
                  </div>
                )}
                <!-- RONDA 41 · «añadir un icono de que los mockups tienen vídeo al hacer hover»: se ve en reposo y se retira mientras el vídeo suena -->
                <span class="vid-ic" aria-hidden="true"><Fragment set:html={icono('video-camera', 'fill')} /></span>
                <!-- RONDA 215 · Eric: «cuando estás en hover, otro botón como el del vídeo pero para que hagan clic»: la LUPA ocupa el sitio del icono de vídeo al pasar y avisa de que la card abre el visor -->
                {casoDe(c) && <span class="abre-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>}
                {!casoDe(c) && <span class="abre-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.4 15.4 20 20M8 10.5h5M10.5 8v5" /></svg></span>}
              </div>
              <div class="pie pie-pieza mt-4">
                <h3 class="nombre-pie font-display">{c.n}</h3>
                {c.sector && <p class="detail text-fg2">{c.sector}</p>}{/* RONDA 189 · Eric: a la derecha, solo la categoría (sin el dominio) */}
              </div>
            </a>
            {/* el botoncito de ESCENA (el de /proyectos: Portfolio.astro › .escenas): navegador · mesa · móvil (este, solo si hay grabación en móvil) */}
            <div class="escenas" role="group" aria-label={en ? `View ${c.n} as` : `Ver ${c.n} en`} data-escenas>
              <button type="button" data-escena="navegador" aria-label={en ? 'Browser' : 'Navegador'} title={en ? 'Browser' : 'Navegador'} aria-pressed={propia === 'navegador' ? 'true' : 'false'}><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 9h18" /></svg></button>
              <button type="button" data-escena="escena" aria-label={en ? 'Desk' : 'Mesa'} title={en ? 'Desk' : 'Mesa'} aria-pressed={propia === 'escena' ? 'true' : 'false'}><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="1.6" /><path d="M12 16v4M8 20h8" /></svg></button>
              {(propia === 'movil' || qAlt) && <button type="button" data-escena="movil" aria-label={en ? 'Phone' : 'Móvil'} title={en ? 'Phone' : 'Móvil'} aria-pressed={propia === 'movil' ? 'true' : 'false'}><svg viewBox="0 0 24 24"><rect x="7" y="3" width="10" height="18" rx="2.2" /><path d="M11 18h2" /></svg></button>}
            </div>
            </div>
            </>
          );
        })
      }
    </div>
  </div>
  <!-- RONDA 214 · Eric: «que al hacer clic en cada card se vea el mockup en grande, rollo slider modal»: un VISOR sobre la página (dialog nativo). Una lámina con el fondo de
       la marca y la web grabada en grande (navegador de cristal; el móvil, de pie), el nombre y el sector debajo, y el slider entre los ocho con flechas, teclado y
       gesto. La card sigue siendo un enlace a la web (sin JS, o con Cmd/Ctrl, va allí); el visor lleva solo la barra de flechas. -->
  <dialog class="vis" data-vis aria-label={en ? 'Projects' : 'Proyectos'} aria-hidden="true">
    <button type="button" class="vis-x barra-cristal" aria-label={en ? 'Close' : 'Cerrar'} data-vis-cerrar><span class="paso"><Fragment set:html={icono('x', 'regular')} /></span></button>
    <div class="vis-caja" data-vis-caja>
      <div class="vis-panel" data-vis-panel>
        {
          A.map(async (c) => {
            // 27/10 · Eric: «cuando se abre el slide, que se abra SOLO con desktop mesa»: cada proyecto, en la MESA del estudio (la lámina de 5120 px en la estación de la
            // web) con su web de ESCRITORIO en el monitor, como el visor de /proyectos (obra/Visor.astro), aunque la card enseñe el móvil. Fuera el navegador de cristal.
            // RONDA 215 · la toma GRANDE (`<slug>-grande.mp4/.jpg`) si existe; si no, la de la card
            const chico = `/media/anteriores/video/${c.slug}`;
            const grande = await sharp(`public${chico}-grande.jpg`).metadata().then((m) => m, () => null);
            const base = grande ? `${chico}-grande` : chico;
            return (
              <article class="vis-slide" data-vis-slide data-n={c.n} data-caso={casoDe(c) ? ruta(lang, `/proyectos/${casoDe(c)}`) : undefined} data-sector={c.sector ?? ''} aria-hidden="true" style={`--vf:${claro(c.color[0]) ? '#f6f7fb' : '#000'}`}>
                <div class="vis-mesa" style={`--z:${ZV};--px:${PANT.x + PANT.w / 2};--py:${PANT.y + PANT.h / 2}`}>
                  <img class="vis-foto" data-mesa="/media/estudio/{est}-xl.webp" alt="" width="5120" height="2880" decoding="async" />
                  <span class="vis-pant">
                    <video class="vis-vid" muted loop playsinline preload="none" data-visor-poster={`${base}.jpg`} data-src={`${base}.mp4`} aria-label={en ? `Walkthrough of the ${c.n} website` : `Recorrido por la web de ${c.n}`}></video>
                  </span>
                </div>
              </article>
            );
          })
        }
      </div>
      <div class="vis-pie">
        <div class="vis-quien" data-vis-quien>
          <h3 class="vis-nombre font-display" data-vis-nombre></h3>
          <p class="detail vis-sector" data-vis-sector></p>
          <a class="btn-secondary btn-sm vis-caso" href="#" hidden data-vis-caso><span class="btn-tx">{en ? 'View case study' : 'Ver caso de estudio'}</span><Fragment set:html={flecha()} /></a>
        </div>
        <div class="vis-acciones">
          <div class="barra-cristal" role="group" aria-label={en ? 'Projects' : 'Proyectos'}>
            <button type="button" class="paso" aria-label={en ? 'Previous project' : 'Proyecto anterior'} data-vis-paso="-1"><Fragment set:html={flecha('izq')} /></button>
            <button type="button" class="paso" aria-label={en ? 'Next project' : 'Proyecto siguiente'} data-vis-paso="1"><Fragment set:html={flecha()} /></button>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { jugar } from '../scripts/jugar';
  import { crearEstela } from '../scripts/estela';
  import { rasgarCopia, estaVisible, cambiarFoto } from '../scripts/revelar';
  import { EST, estacionActual } from '../scripts/estacion';
  // RONDA 232 · «al cambiar de estación, los mockups fluidos como el hero»: la mesa (una foto por estación, por CSS) y los paisajes barridos (una
  // imagen de fondo por estación, por CSS) cambiaban de golpe (Safari no funde background-image). Al cambiar, se congela una copia del aspecto
  // VIEJO encima de cada pieza a la vista y se le abre un agujero con el canto rasgado desde abajo, como el árbol del hero.
  {
    let prev = EST[estacionActual()] as string;
    // la foto de la mesa de la estación de la web, pedida al acercarse la pieza. 29/10 · Eric: «la home tarda en cargar»: antes se pedían las CUATRO
    // (≈ 2 MB en el móvil, para ver una); la de otra estación se pide al cambiar, y el rasgado espera a que esté descodificada (ver abajo)
    const cerca = new IntersectionObserver((en) => en.forEach((e) => { if (!e.isIntersecting) return; const i = e.target.querySelector<HTMLImageElement>(`.foto-e[data-e="${EST[estacionActual()]}"]`); if (i) i.loading = 'eager'; cerca.unobserve(e.target); }), { rootMargin: '400px 0px' });
    document.querySelectorAll('.mesa').forEach((m) => cerca.observe(m));
    // el cartel de cada vídeo (≈15 JPG de 40–120 KB) se pide al acercarse, no al cargar la página: un <video poster> no admite loading=lazy
    const carteles = new IntersectionObserver((en) => en.forEach((e) => { if (!e.isIntersecting) return; const v = e.target as HTMLVideoElement; if (v.dataset.poster) v.poster = v.dataset.poster; carteles.unobserve(v); }), { rootMargin: '800px 0px' });
    document.querySelectorAll<HTMLVideoElement>('video[data-poster]').forEach((v) => carteles.observe(v));
    addEventListener('savvia:estacion', () => {
      const viejo = prev; prev = EST[estacionActual()];
      if (viejo === prev) return;
      document.querySelectorAll<HTMLElement>('.lamina.barrido').forEach((l) => {
        if (!estaVisible(l)) return;
        const c = document.createElement('div');
        c.style.cssText = `position:absolute;inset:-2%;pointer-events:none;background:var(--b-${viejo}) center / cover no-repeat`;
        l.prepend(c); rasgarCopia(c, { ox: 0.5, oy: 1, ref: l });
      });
      document.querySelectorAll<HTMLElement>('.mesa').forEach((m) => {
        const img = m.querySelector<HTMLImageElement>(`.foto-e[data-e="${viejo}"]`);
        if (!img || !estaVisible(m)) return;
        // la propia foto vieja (ya descodificada: una copia nueva llegaba en blanco el primer fotograma en Chrome), encima de todas y bajo la pantalla (z 2);
        // al acabar vuelve a su sitio y el CSS la esconde
        img.style.cssText = 'display:block;position:absolute;inset:0;z-index:1;pointer-events:none';
        // (30/10) el rasgado espera a que la foto nueva esté descodificada: con red lenta se abría sobre el hueco y la pantalla parpadeaba
        const nueva = m.querySelector<HTMLImageElement>(`.foto-e[data-e="${prev}"]`);
        if (nueva) nueva.loading = 'eager';
        // (30/10, iPhone) en táctil la vieja se funde en vez de rasgarse: el rasgado repinta su máscara cada fotograma debajo del vídeo que suena y lo hacía parpadear
        const tactil = !matchMedia('(hover: hover)').matches;
        const fundir = () => { img.style.transition = 'opacity 1.4s ease'; requestAnimationFrame(() => { img.style.opacity = '0'; }); setTimeout(() => { img.style.cssText = ''; }, 1500); };
        Promise.race([nueva?.decode().catch(() => {}), new Promise((r) => setTimeout(r, 5000))]).then(() => (tactil ? fundir() : rasgarCopia(img, { ox: 0.5, oy: 1, ref: m.closest<HTMLElement>('.lamina') ?? undefined, fin: () => { img.style.cssText = ''; } })));
      });
    });
  }
  // RONDA 214 · EL VISOR de los proyectos (ver el dialog `data-vis`): clic en una card → la web en grande; flechas, teclado (← → Esc) y gesto entre los ocho.
  {
    const vis = document.querySelector<HTMLDialogElement>('[data-vis]');
    const piezas = [...document.querySelectorAll<HTMLElement>('[data-pieza]')];
    if (vis && piezas.length) {
      const slides = [...vis.querySelectorAll<HTMLElement>('[data-vis-slide]')];
      const quien = vis.querySelector<HTMLElement>('[data-vis-quien]')!, nombre = vis.querySelector<HTMLElement>('[data-vis-nombre]')!, sector = vis.querySelector<HTMLElement>('[data-vis-sector]')!;
      const panel = vis.querySelector<HTMLElement>('[data-vis-panel]')!;
      const verCaso = vis.querySelector<HTMLAnchorElement>('[data-vis-caso]');
      const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let cur = -1, vuelta: HTMLElement | null = null, cerrando = 0;
      const vid = (i: number) => slides[i].querySelector<HTMLVideoElement>('video')!;
      // 27/10 · la mesa, en la lámina de la estación de la web (la de 5120 px: el monitor ocupa medio panel); vira con ella
      const mesa = (i: number) => { const im = slides[i].querySelector<HTMLImageElement>('[data-mesa]')!; const u = im.dataset.mesa!.replace('{est}', document.documentElement.dataset.estacion || 'otono'); if (im.getAttribute('src') !== u) im.src = u; };
      // (30/10) con el visor abierto, la lámina nueva entra con el rasgado, ya descargada
      addEventListener('savvia:estacion', () => slides.forEach((s) => { const im = s.querySelector<HTMLImageElement>('[data-mesa]'); if (im?.getAttribute('src')) cambiarFoto(im, { src: im.dataset.mesa!.replace('{est}', document.documentElement.dataset.estacion || 'otono') }); }));
      // la fuente del vídeo se pone la primera vez que hace falta (preload="none"): el visor abre con el póster y no gasta red en los ocho
      const carga = (i: number) => {
        mesa(i);
        const v = vid(i);
        if (v.dataset.cargado) return;
        v.dataset.cargado = '1';
        if (v.dataset.visorPoster) v.poster = v.dataset.visorPoster;
        const so = document.createElement('source'); so.src = v.dataset.src!; so.type = 'video/mp4'; v.appendChild(so); v.load();
      };
      // RONDA 218 · Safari se quedaba sin memoria: cada vídeo del visor, una vez cargado, no se soltaba nunca. Ahora solo viven el actual y sus dos vecinos, y al cerrar se sueltan todos
      const soltar = (i: number) => {
        const v = vid(i);
        if (!v.dataset.cargado) return;
        v.pause(); v.querySelectorAll('source').forEach((x) => x.remove()); v.removeAttribute('src'); v.load();
        delete v.dataset.cargado;
      };
      const ir = (n: number, animar = true) => {
        n = (n + slides.length) % slides.length;
        const cambia = n !== cur;
        cur = n;
        slides.forEach((sl, i) => {
          const on = i === n;
          sl.classList.toggle('on', on); sl.setAttribute('aria-hidden', on ? 'false' : 'true');
          const v = vid(i);
          if (on) {
            // cada vez que se abre una card o se llega a un proyecto, su vídeo EMPIEZA DE CERO (Eric); al irse se para
            carga(i); if (cambia) v.currentTime = 0;
            jugar(v);
          } else { v.pause(); }
        });
        carga((n + 1) % slides.length); carga((n - 1 + slides.length) % slides.length);
        slides.forEach((_, i) => { const d = (i - n + slides.length) % slides.length; if (d > 1 && d < slides.length - 1) soltar(i); });
        const d = slides[n].dataset;
        nombre.textContent = d.n ?? ''; sector.textContent = d.sector ?? '';
        if (verCaso) { verCaso.hidden = !d.caso; if (d.caso) verCaso.href = d.caso; } // Eric: «aquí poner Ver caso de estudio»: solo si el proyecto tiene caso
        if (cambia && animar && !reducido) quien.animate([{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }], { duration: 520, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
      };
      vis.addEventListener('close', () => slides.forEach((_, i) => soltar(i)));
      // RONDA 280 · la caja y la lámina en píxeles ENTEROS (el centrado cae en un píxel exacto). 27/10: sin el navegador de cristal, ya no hay marco que medir
      const caja = vis.querySelector<HTMLElement>('[data-vis-caja]')!;
      const ajusta = () => {
        if (!vis.open) return;
        caja.style.width = ''; caja.style.marginTop = ''; panel.style.height = '';
        const VW = vis.clientWidth, VH = vis.clientHeight;
        let W = Math.floor(caja.getBoundingClientRect().width);
        if ((VW - W) % 2) W -= 1; // misma paridad que la ventana: el centrado cae en un píxel exacto
        const H = Math.round(W / 1.6);
        caja.style.width = W + 'px'; panel.style.height = H + 'px';
        caja.style.alignSelf = 'start';
        const pie = caja.getBoundingClientRect().height - panel.getBoundingClientRect().height;
        caja.style.marginTop = Math.max(0, Math.floor((VH - H - pie) / 2)) + 'px';
      };
      addEventListener('resize', ajusta);
      const abre = (i: number) => {
        if (vis.open) return;
        vuelta = document.activeElement as HTMLElement | null;
        clearTimeout(cerrando); vis.classList.remove('cierra');
        cur = -1; // al abrir, siempre «cambia»: el vídeo empieza de cero aunque sea el mismo proyecto de la vez anterior
        ir(i, false);
        vis.showModal(); vis.removeAttribute('aria-hidden'); ajusta();
        document.documentElement.style.overflow = 'hidden';
      };
      const cierra = () => {
        if (!vis.open || vis.classList.contains('cierra')) return;
        vis.classList.add('cierra');
        cerrando = window.setTimeout(() => vis.close(), reducido ? 0 : 280);
      };
      vis.addEventListener('close', () => {
        vis.classList.remove('cierra'); vis.setAttribute('aria-hidden', 'true');
        document.documentElement.style.overflow = '';
        slides.forEach((_, i) => vid(i).pause());
        vuelta?.focus({ preventScroll: true });
      });
      vis.addEventListener('cancel', (e) => { e.preventDefault(); cierra(); }); // Esc: con la misma salida suave
      piezas.forEach((pz, i) => pz.addEventListener('click', (e) => {
        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return; // con modificador, va a la web como siempre
        if (pz.hasAttribute('data-caso')) return; // 28/10 · con caso de estudio, el clic va al caso
        // 28/10 · Eric: «en mobile clico y me va a la URL de la web final: eso NUNCA»: también en móvil abre el visor (antes, ronda 268, iba a la web)
        e.preventDefault(); abre(i);
      }));
      vis.querySelectorAll<HTMLElement>('[data-vis-paso]').forEach((b) => b.addEventListener('click', () => ir(cur + Number(b.dataset.visPaso))));
      vis.querySelector('[data-vis-cerrar]')!.addEventListener('click', cierra);
      // clic fuera de la lámina y de los controles = cerrar
      vis.addEventListener('click', (e) => { const t = e.target as HTMLElement; if (t === vis || t.matches('[data-vis-caja]')) cierra(); });
      vis.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); ir(cur + 1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); ir(cur - 1); }
      });
      // gesto: arrastrar en horizontal sobre la lámina
      let x0 = 0, y0 = 0, seguir = false;
      panel.addEventListener('pointerdown', (e) => { x0 = e.clientX; y0 = e.clientY; seguir = e.pointerType !== 'mouse'; });
      panel.addEventListener('pointerup', (e) => {
        if (!seguir) return;
        seguir = false;
        const dx = e.clientX - x0, dy = e.clientY - y0;
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) ir(cur + (dx < 0 ? 1 : -1));
      });
    }
  }
  // RONDA 206 · el navegador de mancha y claro, al pasar (o enfocar): centrado, recto y entero. Se mide una vez por entrada: la escala que lo lleva al 88 % del ancho de
  // la pieza y el desplazamiento de su esquina (origen 0 0) para que quede en el centro; solo transformaciones, así que ida y vuelta son la misma curva.
  {
    const conHover = matchMedia('(hover: hover)').matches;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const tactiles: { pz: HTMLElement; entra: () => void; sale: () => void }[] = [];
      // 27/10 · todas las piezas llevan navegador (el botoncito de escena puede ponerlo): solo se mueve si es la escena que se ve
      document.querySelectorAll<HTMLElement>('[data-pieza]').forEach((pz) => {
        const mk = pz.querySelector<HTMLElement>('.mockup[data-f="navegador"]'), lam = pz.querySelector<HTMLElement>('.lamina');
        if (!mk || !lam) return;
        const entra = () => {
          if (pz.dataset.forma !== 'navegador' || !mk.offsetWidth) return;
          pz.classList.add('interactivo');
          const W = lam.clientWidth, H = lam.clientHeight, s = (W * 0.88) / mk.offsetWidth;
          mk.style.setProperty('--hs', String(s));
          mk.style.setProperty('--hx', ((W - mk.offsetWidth * s) / 2 - mk.offsetLeft).toFixed(1) + 'px');
