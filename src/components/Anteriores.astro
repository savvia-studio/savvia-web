      width: 1px;
      background: var(--linea);
      transform-origin: 50% 0;
      transform: scaleY(0);
      transition: transform 1.4s cubic-bezier(0.65, 0, 0.35, 1) calc(0.5s + var(--c) * 0.15s);
    }
    .gx {
      position: absolute;
      top: calc(var(--r) * 50%);
      left: calc(var(--c) * 100% / 3);
      width: 9px;
      height: 9px;
      translate: -4px -4px;
      background:
        linear-gradient(var(--cruz), var(--cruz)) 50% 0 / 1px 100% no-repeat,
        linear-gradient(var(--cruz), var(--cruz)) 0 50% / 100% 1px no-repeat;
      opacity: 0;
      transition: opacity 0.6s ease calc(1.2s + var(--c) * 0.08s);
    }
    .cuadricula.trazada .gh { transform: scaleX(1); }
    .cuadricula.trazada .gv { transform: scaleY(1); }
    .cuadricula.trazada .gx { opacity: 1; }
  }
  :global(html:not(.anima)) .gh, :global(html:not(.anima)) .gv { transform: none; }
  :global(html:not(.anima)) .gx { opacity: 1; }
  .cq { font-size: var(--text-ui); line-height: 1.5; min-height: 4.5em; color: var(--fg); text-wrap: pretty; }
  .cn, .cr { font-size: var(--text-aux); }
  .cn { margin-top: calc(var(--spacing) * 2); color: var(--fg); font-weight: 500; }
  .cr { color: var(--fg2); }
  .mk {
    display: block;
    background: var(--fg);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }
  .mk.grande { width: min(var(--lw), 90%); height: var(--lh); }
  /* ronda 189 · el 90 % se mide contra la celda (si no, la caja del item encogía con el logo y la `escala` no se notaba) */
  .item.marca { width: 100%; }
  .marca-txt {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
    font-size: calc(var(--spacing) * 6);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--fg);
  }
  .marca-txt .mk { width: 1.4em; height: 0.75em; }
  .cv { font-size: var(--text-h2); line-height: 1; color: var(--fg); }
  @media (width >= 48rem) {
    .cuadricula { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  /* la persona de cada cita: el nombre en la tipografía de titulares, algo mayor (ronda 189) */
  .cn { font-family: var(--font-display); font-weight: 400 !important; font-size: var(--text-lead) !important; line-height: 1.15; }
  /* ── EL TESTIMONIO que rota (ronda 66): el retrato al carboncillo a la izquierda, la cita en Family y quién la dice entre dos flechas finas; en claro */
  .voz {
    display: grid;
    gap: calc(var(--spacing) * 8);
    align-items: center;
    margin-block: calc(var(--spacing) * 8);
  }
  .retratos {
    display: grid;
    width: min(100%, 22rem);
    aspect-ratio: 1 / 1;
    justify-self: center;
  }
  .fuente-r { display: none; }
  .retratos { position: relative; }
  .retrato-cv {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    opacity: 0;
    filter: blur(6px);
    transition: opacity 0.35s cubic-bezier(0.4, 0, 1, 1), filter 0.35s cubic-bezier(0.4, 0, 1, 1);
  }
  .retrato-cv.on { opacity: 1; filter: none; transition: opacity 0.2s ease; }
  .retrato-cv { mix-blend-mode: multiply; } /* ronda 69: la tinta se hunde en el grano del papel */
  .retrato-cv.motor { mix-blend-mode: normal; } /* ronda 152: el motor del roble ya se funde con el papel */
  /* RONDA 193 · Eric: «el espacio entre reseña y nombre siempre el mismo; centramos el contenido aunque unas sean más altas». Cada cita va pegada
     al pie de la pila (el hueco hasta el nombre no cambia) y en escritorio la pila mide lo que la cita activa (lo pone el JS al relevar, con la
     anterior ya ida): el bloque, centrado junto al retrato. En móvil se reserva la más alta, para que la página no salte. */
  .citas { display: grid; grid-template-rows: minmax(0, 1fr); }
  @media (width >= 64rem) { .voz.js .citas { transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1); } }
  .vq {
    grid-area: 1 / 1;
    align-self: end;
    font-size: var(--text-h3);
    line-height: 1.2;
    text-wrap: pretty;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .vq.on { opacity: 1; }
  /* RONDA 193 · la cita sube palabra a palabra (sustituye al tecleo de la ronda 68): la que llega espera a que se vaya la anterior (--d0) y cada
     palabra sale 24 ms después de la anterior; la que se va, todas a la vez y más rápido */
  .voz { --sube: cubic-bezier(0.22, 1, 0.36, 1); --d0: 0ms; }
  .vq.partida { opacity: 1; transition: none; }
  .vq.partida :global(.w) { display: inline-block; }
  .vq.partida :global(.w > span) {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.45em);
    filter: blur(6px);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.4, 0, 1, 1), filter 0.3s ease;
  }
  .vq.partida.on :global(.w > span) {
    opacity: 1;
    transform: none;
    filter: none;
    transition: opacity 0.7s ease, transform 0.9s var(--sube), filter 0.7s ease;
    transition-delay: calc(var(--d0) + var(--w) * 24ms);
  }
  .autor {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 3);
    margin-top: calc(var(--spacing) * 8);
  }
  .quienes { display: grid; min-width: 0; }
  .quien {
    grid-area: 1 / 1;
    display: grid;
    gap: calc(var(--spacing) * 1);
    --dq: 300ms;
  }
  .quien > * { opacity: 0; transform: translateY(0.5em); filter: blur(4px); transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.4, 0, 1, 1), filter 0.3s ease; }
  .quien.on > * { opacity: 1; transform: none; filter: none; transition: opacity 0.7s ease, transform 0.9s var(--sube), filter 0.7s ease; transition-delay: calc(var(--d0) + var(--dq)); }
  .quien.on > span { transition-delay: calc(var(--d0) + var(--dq) + 110ms); }
  /* las flechas, la primera vez, al final del todo */
  .voz.js .barra-voz { opacity: 0; transition: opacity 0.8s ease 0.9s; }
  .voz.js.vista .barra-voz { opacity: 1; }
  .quien b { font-weight: 500; color: var(--fg); }
  .quien span { color: var(--fg2); }
  /* RONDA 144 (2.ª) · Andoni: «los botones del slider de testimonios, a la derecha de los nombres, pegados a la guía derecha y mucho más sutiles,
     mimetizados con el fondo»: la barra de la casa sin velo ni sombra, un filete del color de las reglas y la tinta apagada */
  /* RONDA 144 (3.ª) · «los botones de cambiar de testimonio, debajo del nombre, y solo las flechas: sin número, sin la caja que lo rodea» */
  .pie-voz { display: flex; flex-direction: column; align-items: flex-start; gap: calc(var(--spacing) * 4); margin-top: calc(var(--spacing) * 8); }
  .pie-voz .autor { margin-top: 0; }
  .barra-voz {
    gap: calc(var(--spacing) * 1);
    padding: 0;
    margin-left: calc(var(--spacing) * -2);
    background: transparent;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
    box-shadow: none;
    color: var(--fg2);
  }
  .barra-voz .paso { width: calc(var(--spacing) * 8); height: calc(var(--spacing) * 8); }
  .barra-voz .paso:hover:not(:disabled) { background: color-mix(in oklab, var(--fg) 8%, transparent); color: var(--fg); }
  .barra-voz .paso :global(.btn-flecha) { width: 1rem; height: 1rem; }

  .flecha-v {
    display: grid;
    place-items: center;
    width: calc(var(--spacing) * 10);
    height: calc(var(--spacing) * 10);
    border-radius: 50%;
    color: var(--fg2);
    transition: color 0.5s cubic-bezier(0.25, 1, 0.5, 1), background-color 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }
  .flecha-v:hover { color: var(--fg); background: color-mix(in oklab, var(--fg) 8%, transparent); }
  .flecha-v :global(.btn-flecha) { font-size: 1rem; } /* RONDA 135 · la flecha de la casa (sale y vuelve a entrar al pasar) */
  @media (width >= 64rem) {
    .voz { grid-template-columns: 5fr 7fr; gap: calc(var(--spacing) * 16); margin-block: calc(var(--spacing) * 16); }
    .retratos { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .item, .retrato-cv, .vq, .quien, .quien > *, .vq :global(.w > span) { transition: none !important; }
  }
  .lamina {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-lg);
    isolation: isolate;
    container-type: inline-size;
    /* RONDA 189 · Eric: «al pasar, el redondeado no va bien» (esquinas rectas mientras el fondo escala bajo la ventana de cristal): una máscara lisa
       obliga al navegador a recortar con las esquinas también las capas compuestas */
    -webkit-mask-image: linear-gradient(#000, #000);
    mask-image: linear-gradient(#000, #000);
  }
  .entrada .lamina {
    aspect-ratio: 3 / 2;
    display: grid;
    place-items: center;
  }
  .entrada .lamina { display: block; }
  /* los que no están, fuera (con !important: la entrada de las piezas, html.anima .pieza.visto .mockup, pone opacidad y posición a todos los navegadores).
     RONDA 78 · el relevo: el nuevo sube desde abajo (18 %) y enfoca; el que se va baja un poco y se desenfoca */
  /* RONDA 81 · Andoni: «no me gusta cómo rotan; una animación más fluida»: sin desenfoque ni saltos. Los navegadores van en FILA, como una tira que avanza:
     el que está se desliza hacia la izquierda y el siguiente entra por la derecha a la vez, con la misma curva lenta (1,4 s, entrada y salida suaves) */
  /* RONDA 190 · Eric: «como pasan las slides tiene que ser más smooth» (el que llega ya trae su captura cargada y descodificada) y después «el
     slider me sigue sin gustar: tiene que ser fade»: FUNDIDO cruzado en su sitio: el que llega aparece encima mientras el que se
     va se apaga debajo (1,2 s), sin desplazamiento. */
  /* (con !important: la regla de entrada html.anima .pieza.visto .mockup pisaba la transición y el relevo saltaba de golpe) */
  .heroe { transition: opacity 1.2s ease !important; }
  .heroe:not(.on) { opacity: 0 !important; transition: none !important; }
  .heroe.on { z-index: 1; }
  .heroe.sale { opacity: 0 !important; transition: opacity 1.2s ease 0.3s !important; }
  .heroe.on { opacity: 1 !important; }
  .heroe img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: 50% 0; }
  .entrada .rota-n { display: grid; transition: color 0.8s ease; }
  .entrada .rota-n > span { grid-area: 1 / 1; }
  .entrada .pal { display: inline-block; overflow: hidden; vertical-align: top; padding-bottom: 0.08em; margin-right: 0.25em; }
  /* RONDA 82 · «el titular anterior se vuelve a ver»: al quitarle `.sale`, la palabra volvía a su sitio de espera (abajo) ANIMADA y cruzaba la vista. El
     regreso es instantáneo; solo se animan la entrada (.on) y la salida (.sale) */
  .entrada .pal > span { display: inline-block; translate: 0 110%; transition: none; }
  .entrada .rota-n > span.on .pal > span { translate: 0 0; transition: translate 1.1s cubic-bezier(0.65, 0, 0.35, 1) calc(0.25s + var(--n, 0) * 0.06s); }
  .entrada .rota-n > span.sale .pal > span { translate: 0 -110%; transition: translate 0.9s cubic-bezier(0.65, 0, 0.35, 1); }
  .entrada .rota-n .pal:nth-child(2) > span { --n: 1; }
  .entrada .rota-n .pal:nth-child(3) > span { --n: 2; }
  /* sobre el fondo claro de su web (Playground, Neety…), el nombre en Cacao y sin sombra */
  /* RONDA 156 · cada nombre lleva SU tinta (la de su fondo), no el h3: así el que entra y el que sale no comparten color a medio relevo (Eric: «no se lee») */
  .entrada .nombre > span.oscura { color: var(--color-cacao); text-shadow: none; }
  @media (prefers-reduced-motion: reduce) { .entrada .pal > span { translate: none !important; } }
  .rota { transition: --c1 1.4s cubic-bezier(0.65, 0, 0.35, 1), --c2 1.4s cubic-bezier(0.65, 0, 0.35, 1), --c3 1.4s cubic-bezier(0.65, 0, 0.35, 1); }
  @media (width >= 64rem) {
    .mosaico {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      row-gap: calc(var(--spacing) * 48); /* ronda 67: «más aire entre todo el contenido verticalmente» (antes 32) */
    }
    .pieza {
      grid-column: var(--col);
      margin-top: calc(var(--spacing) * var(--baja, 0));
    }
    .pieza .lamina {
      aspect-ratio: var(--ratio);
    }
    .entrada {
      grid-column: 1 / span 3;
    }
    .entrada .lamina {
      aspect-ratio: 1 / 1;
    }
  }

  /* ── LOS FONDOS de degradado: manchas muy desenfocadas (aerógrafo) + el grano de la web. Cada uno, distinto. */
  .lamina[class*='g-']::before {
    content: '';
    position: absolute;
    inset: -30%;
    z-index: -2;
    background: var(--manchas);
    filter: blur(34px);
    transition: transform 1.6s var(--ease-out-expo);
  }
  .lamina::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: none;
  }
  /* de MARCA: los tres colores medidos en la web del cliente (fondo, secundario, acento) */
  .g-marca {
    --manchas: radial-gradient(70% 60% at 72% 22% in oklab, var(--c2), transparent 72%), radial-gradient(55% 55% at 8% 96% in oklab, var(--c3), transparent 70%), var(--c1); /* ronda 154: mezcla en oklab (sin grises turbios) */
  }
  .rota {
    transition: --c1 1.4s ease, --c2 1.4s ease, --c3 1.4s ease;
  }
  .claro,
  .tel {
    --nombre-tinta: var(--color-cacao);
  }
  /* RONDA 76 · el fondo de MARCA con imagen (la madera de Naterra, los aerogeneradores de Isotrol) en lugar de las manchas */
  .lamina.con-fondo::before {
    inset: 0;
    background: var(--fondo) center / cover no-repeat;
    filter: none;
  }
  .pieza:hover .lamina.con-fondo::before { transform: scale(1.04); }
  /* RONDA 189 · el BARRIDO: el paisaje de la estación con desenfoque de movimiento; vira con ella (fundido de 1,2 s) */
  .lamina.barrido::before {
    background: var(--b-otono) center / cover no-repeat;
    transition: transform 1.6s var(--ease-out-expo), background-image 1.2s ease;
  }
  :global(html[data-estacion='primavera']) .lamina.barrido::before { background-image: var(--b-primavera); }
  :global(html[data-estacion='verano']) .lamina.barrido::before { background-image: var(--b-verano); }
  :global(html[data-estacion='invierno']) .lamina.barrido::before { background-image: var(--b-invierno); }
  /* RONDA 190 · fuera el canto de NUBE de la ronda 189 (Eric: «se han quedado legacy»; Andoni: «no me convence que los bordes de la card se
     difuminen»): las piezas de paisaje, con las esquinas nítidas de todas. */
  .lamina.barrido::before { inset: -2%; }
  /* Eric: «bajamos un poco el aire de arriba»: la ventana sube del 34 % al 24 % */
  .lamina.barrido .mockup { top: 24%; }

  /* el TELÉFONO de Remerge: de pie en el centro, algo ladeado, con su web móvil */
  .tel-m {
    position: absolute;
    left: 50%;
    top: 16%;
    width: 38%;
    aspect-ratio: 390 / 844;
    translate: -50% 0;
    rotate: var(--giro, -4deg);
    padding: 2.4%;
    border-radius: 14% / 6.5%;
    background: #141214;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.3), 0 28px 50px -14px rgb(40 36 10 / 0.55);
    transition: translate 0.9s var(--ease-out-expo), rotate 0.9s var(--ease-out-expo);
  }
  .tel-pant { display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 11.5% / 5.3%; background: #fbfbfa; }
  .tel-pant :global(.vid) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .pieza:hover .tel-m { translate: -50% -3%; rotate: 0deg; }

  /* los LOGOTIPOS que rotan: cada uno es una máscara (se pinta en Rosa niebla, o en Cacao sobre el amarillo de Remerge) */
  .logos {
    position: relative;
    width: 62%;
    aspect-ratio: 5 / 2;
  }
  .logos i {
    position: absolute;
    inset: 0;
    background: var(--color-niebla);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    opacity: 0;
    filter: blur(16px);
    scale: 0.97;
    transition: opacity 0.8s ease, filter 1s ease, scale 1s var(--ease-out-expo), background-color 1s ease;
  }
  .logos i.on {
    opacity: 1;
    filter: blur(0);
    scale: 1;
    transition-delay: 0.25s; /* el que llega entra cuando el que se va ya se ha desenfocado */
  }
  .logos i:nth-child(4) {
    background: var(--color-cacao); /* Remerge: fondo claro */
  }

  /* ── el icono de vídeo: una píldora de cristal oscuro arriba a la derecha; al pasar crece un poco y, mientras el vídeo suena, se retira */
  .vid-ic {
    position: absolute;
    z-index: 3;
    right: calc(var(--spacing) * 3);
    bottom: calc(var(--spacing) * 3);
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1);
    padding: calc(var(--spacing) * 2);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, #1a1210 55%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-niebla);
    transition: opacity 0.4s ease, scale 0.5s var(--ease-out-expo), filter 0.4s ease;
  }
  .vid-ic :global(svg) {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  .pieza:hover .vid-ic {
    scale: 1.06;
  }
  .pieza.suena .vid-ic {
    opacity: 0;
    filter: blur(4px);
  }
  /* RONDA 162 · Eric: «el título del cliente arriba a la izquierda no me convence; puede estar en el pie de la card». En las piezas de proyecto el
     nombre baja al PIE, fuera de la imagen: nombre en Family a tamaño medio y, a la derecha, dominio · sector. La imagen queda limpia.
     (La pieza de entrada, la que rota, conserva su nombre encima: su relevo vive ahí.) */
  .pie-pieza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--spacing) * 4);
    flex-wrap: wrap;
  }
  .nombre-pie {
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .pie-pieza .detail { text-align: right; }
  /* ── el nombre, grande, encima (arriba a la izquierda) */
  .nombre {
    position: absolute;
    z-index: 2;
    left: calc(var(--spacing) * 4);
    top: calc(var(--spacing) * 3);
    right: calc(var(--spacing) * 4);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    /* RONDA 156 · Eric: «la tipo debería ser blanca; en dark queda poco legible, y tiene que ir sincronizado con la estación»: el nombre va sobre el
       FONDO DE LA PIEZA (la marca del cliente), no sobre la página: blanco siempre, y Cacao solo si la marca es clara. Antes leía --tinta, que en
       invierno es oscura: Routal o Kuanta salían en oscuro sobre su fondo oscuro. */
    color: var(--nombre-tinta, #f5f5f7);
    text-wrap: balance;
  }
  .escena .nombre,
  .mancha .nombre {
    text-shadow: 0 1px 18px color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  /* ronda 152: degradado claro (Monad) → el nombre en tinta oscura, sin sombra */
  .pieza.tinta-oscura .nombre { color: var(--color-cacao); text-shadow: none; }

  /* ── ESCENA: la mesa en una estación, con la web dentro del monitor. Todo en unidades de la propia pieza (cqw). */
  .mesa {
    position: absolute;
    width: calc(var(--z) * 100cqw);
    aspect-ratio: 16 / 9;
    left: calc(var(--left) * 1cqw);
    /* alto de la lámina ampliada = z·100·9/16 cqw; el centro de la pantalla (py) va a la altura cy de la pieza (su alto: 100cqh) */
    top: calc(var(--cy) * 100cqh - var(--py) * var(--z) * 56.25cqw);
    transition: scale 1.6s var(--ease-out-expo);
    transform-origin: 50% var(--py);
  }
  .lamina:has(.mesa) {
    container-type: size;
  }
  .mesa .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mesa .pantalla {
    position: absolute;
    z-index: 2; /* por encima del grano de la pieza (::after, z 1): la web se ve limpia */
    left: 39.03%;
    top: 36.96%;
    width: 21.78%;
    height: 21.04%;
    overflow: hidden;
    /* ronda 190 · Eric: «se ve un mini marco blanco entre el marco del ordenador y el vídeo»: era el blanco de la pantalla de la lámina asomando en el
       borde fraccionario (y el fondo claro de la caja). Fondo en el negro del bisel y un filo de 2 px de ese negro por fuera (como en Proyectos, ronda 159). */
    background: #121213;
    box-shadow: 0 0 0 2px #121213;
  }
  /* RONDA 43 · «Remerge e Isotrol no encajan bien en el mockup»: el <video> lo inserta set:html y NO lleva el ámbito de Astro: estas reglas no se
