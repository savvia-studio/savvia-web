    position: absolute;
    inset: -30%;
    z-index: -2;
    background: var(--manchas);
    filter: blur(34px);
    transition: transform 1.6s var(--ease-out-expo);
  }
  .lamina::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: none;
  }
  /* de MARCA: los tres colores medidos en la web del cliente (fondo, secundario, acento) */
  .g-marca {
    --manchas: radial-gradient(70% 60% at 72% 22% in oklab, var(--c2), transparent 72%), radial-gradient(55% 55% at 8% 96% in oklab, var(--c3), transparent 70%), var(--c1); /* ronda 154: mezcla en oklab (sin grises turbios) */
  }
  .rota {
    transition: --c1 1.4s ease, --c2 1.4s ease, --c3 1.4s ease;
  }
  .claro,
  .tel {
    --nombre-tinta: var(--color-cacao);
  }
  /* RONDA 76 · el fondo de MARCA con imagen (la madera de Naterra, los aerogeneradores de Isotrol) en lugar de las manchas */
  .lamina.con-fondo::before {
    inset: 0;
    background: var(--fondo) center / cover no-repeat;
    filter: none;
  }
  .pieza:hover .lamina.con-fondo::before { transform: scale(1.04); }
  /* RONDA 206 · Eric: «Kymatio no lo has puesto como el artefacto»: el degradado de hoy, tal cual lo pinta el artefacto «Fondos de proyectos» (las dos manchas sobre
     la propia pieza), sin el desenfoque ni el 160 % de antes, que desplazaba las manchas */
  .lamina.g-marca:not(.con-fondo)::before { inset: 0; filter: none; }
  /* RONDA 189 · el BARRIDO: el paisaje de la estación con desenfoque de movimiento; vira con ella (fundido de 1,2 s) */
  .lamina.barrido::before {
    background: var(--b-otono) center / cover no-repeat;
    transition: transform 1.6s var(--ease-out-expo); /* ronda 232: sin fundido de background-image (el relevo lo hace el script, como el hero) */
  }
  :global(html[data-estacion='primavera']) .lamina.barrido::before { background-image: var(--b-primavera); }
  :global(html[data-estacion='verano']) .lamina.barrido::before { background-image: var(--b-verano); }
  :global(html[data-estacion='invierno']) .lamina.barrido::before { background-image: var(--b-invierno); }
  /* RONDA 190 · fuera el canto de NUBE de la ronda 189 (Eric: «se han quedado legacy»; Andoni: «no me convence que los bordes de la card se
     difuminen»): las piezas de paisaje, con las esquinas nítidas de todas. */
  .lamina.barrido::before { inset: -2%; }
  /* Eric: «bajamos un poco el aire de arriba»: la ventana sube del 34 % al 24 % */
  .lamina.barrido .mockup { top: 24%; }

  /* el TELÉFONO de Remerge: de pie en el centro, algo ladeado, con su web móvil */
  .tel-m {
    position: absolute;
    left: 50%;
    top: 16%;
    width: 38%;
    aspect-ratio: 390 / 844;
    translate: -50% 0;
    rotate: var(--giro, -4deg);
    padding: 2.4%;
    border-radius: 14% / 6.5%;
    background: #141214;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.3), 0 28px 50px -14px rgb(40 36 10 / 0.55);
    transition: translate 0.9s var(--ease-out-expo), rotate 0.9s var(--ease-out-expo);
  }
  .tel-pant { display: block; width: 100%; height: 100%; overflow: hidden; border-radius: 11.5% / 5.3%; background: #fbfbfa; }
  .tel-pant :global(.vid) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .pieza:hover .tel-m { translate: -50% -3%; rotate: 0deg; }

  /* los LOGOTIPOS que rotan: cada uno es una máscara (se pinta en Rosa niebla, o en Cacao sobre el amarillo de Remerge) */
  .logos {
    position: relative;
    width: 62%;
    aspect-ratio: 5 / 2;
  }
  .logos i {
    position: absolute;
    inset: 0;
    background: var(--color-niebla);
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    opacity: 0;
    filter: blur(16px);
    scale: 0.97;
    transition: opacity 0.8s ease, filter 1s ease, scale 1s var(--ease-out-expo), background-color 1s ease;
  }
  .logos i.on {
    opacity: 1;
    filter: blur(0);
    scale: 1;
    transition-delay: 0.25s; /* el que llega entra cuando el que se va ya se ha desenfocado */
  }
  .logos i:nth-child(4) {
    background: var(--color-cacao); /* Remerge: fondo claro */
  }

  /* ── el icono de vídeo: una píldora de cristal oscuro arriba a la derecha; al pasar crece un poco y, mientras el vídeo suena, se retira */
  .vid-ic {
    position: absolute;
    z-index: 3;
    right: calc(var(--spacing) * 3);
    bottom: calc(var(--spacing) * 3);
    display: inline-flex;
    align-items: center;
    gap: calc(var(--spacing) * 1);
    padding: calc(var(--spacing) * 2);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, #1a1210 55%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-niebla);
    transition: opacity 0.4s ease, scale 0.5s var(--ease-out-expo), filter 0.4s ease;
  }
  .vid-ic :global(svg) {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  /* en táctil no hay vídeo que anunciar (de pie se queda el póster): fuera el icono */
  @media (hover: none) { .vid-ic { display: none; } }
  .pieza:hover .vid-ic {
    scale: 1.06;
  }
  .pieza.suena .vid-ic {
    opacity: 0;
    filter: blur(4px);
  }

  /* la lupa (RONDA 215): misma cápsula de cristal que el icono de vídeo y en su mismo sitio; al pasar, el de vídeo se va y entra la lupa, que invita al clic (abre el visor) */
  .abre-ic {
    position: absolute;
    z-index: 3;
    right: calc(var(--spacing) * 3);
    bottom: calc(var(--spacing) * 3);
    display: inline-flex;
    padding: calc(var(--spacing) * 2);
    border-radius: var(--radius-full);
    background: color-mix(in oklab, #1a1210 55%, transparent);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--color-niebla);
    opacity: 0;
    scale: 0.7;
    filter: blur(4px);
    pointer-events: none;
    transition: opacity 0.4s ease, scale 0.5s var(--ease-out-expo), filter 0.4s ease;
  }
  .abre-ic svg { width: calc(var(--spacing) * 4); height: calc(var(--spacing) * 4); }
  @media (hover: hover) {
    .pieza:hover .abre-ic, .pieza:focus-visible .abre-ic { opacity: 1; scale: 1; filter: none; }
    .pieza:hover .vid-ic, .pieza:focus-visible .vid-ic { opacity: 0; filter: blur(4px); }
  }
  /* 28/10 · Eric: «¿y un usuario sin hover?» · «en este estado algo tiene que haber que incite el clic, sutil»: con caso, la FLECHA ocupa SIEMPRE el sitio de la
     cámara (en reposo, en táctil y al pasar, cuando crece un pelo como la cámara); las demás siguen con cámara y lupa */
  .pieza[data-caso] .vid-ic { display: none; }
  .pieza[data-caso] .abre-ic { opacity: 1; scale: 1; filter: none; }
  @media (hover: hover) { .pieza[data-caso]:is(:hover, :focus-visible) .abre-ic { scale: 1.06; } }
  /* RONDA 162 · Eric: «el título del cliente arriba a la izquierda no me convence; puede estar en el pie de la card». En las piezas de proyecto el
     nombre baja al PIE, fuera de la imagen: nombre en Family a tamaño medio y, a la derecha, dominio · sector. La imagen queda limpia.
     (La pieza de entrada, la que rota, conserva su nombre encima: su relevo vive ahí.) */
  .pie-pieza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--spacing) * 4);
    flex-wrap: wrap;
  }
  .nombre-pie {
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.625rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
  }
  .pie-pieza .detail { text-align: right; }
  /* ── el nombre, grande, encima (arriba a la izquierda) */
  .nombre {
    position: absolute;
    z-index: 2;
    left: calc(var(--spacing) * 4);
    top: calc(var(--spacing) * 3);
    right: calc(var(--spacing) * 4);
    font-size: var(--text-h3);
    line-height: 1.1;
    letter-spacing: -0.01em;
    /* RONDA 156 · Eric: «la tipo debería ser blanca; en dark queda poco legible, y tiene que ir sincronizado con la estación»: el nombre va sobre el
       FONDO DE LA PIEZA (la marca del cliente), no sobre la página: blanco siempre, y Cacao solo si la marca es clara. Antes leía --tinta, que en
       invierno es oscura: Routal o Quantus salían en oscuro sobre su fondo oscuro. */
    color: var(--nombre-tinta, #f5f5f7);
    text-wrap: balance;
  }
  .escena .nombre,
  .mancha .nombre {
    text-shadow: 0 1px 18px color-mix(in oklab, var(--color-cacao) 55%, transparent);
  }
  /* ronda 152: degradado claro (Monad) → el nombre en tinta oscura, sin sombra */
  .pieza.tinta-oscura .nombre { color: var(--color-cacao); text-shadow: none; }

  /* ── ESCENA: la mesa en una estación, con la web dentro del monitor. Todo en unidades de la propia pieza (cqw). */
  .mesa {
    position: absolute;
    width: calc(var(--z) * 100cqw);
    aspect-ratio: 16 / 9;
    left: calc(var(--left) * 1cqw);
    /* alto de la lámina ampliada = z·100·9/16 cqw; el centro de la pantalla (py) va a la altura cy de la pieza (su alto: 100cqh) */
    top: calc(var(--cy) * 100cqh - var(--py) * var(--z) * 56.25cqw);
    transition: scale 1.6s var(--ease-out-expo);
    transform-origin: 50% var(--py);
  }
  .lamina:has(.mesa) {
    container-type: size;
  }
  .mesa .foto {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* ronda 209: el móvil de la mesa, en la estación de la web (otoño si no hay otra) */
  .mesa .foto-e { display: none; }
  @media (hover: none) { .mesa .foto-e { transform: translateZ(0); } } /* (30/10) en táctil, en su capa: el fundido de estación no cambia el árbol de capas bajo el vídeo */
  .mesa .foto-e[data-e='otono'] { display: block; }
  :global(html[data-estacion='primavera']) .mesa .foto-e[data-e='primavera'],
  :global(html[data-estacion='verano']) .mesa .foto-e[data-e='verano'],
  :global(html[data-estacion='invierno']) .mesa .foto-e[data-e='invierno'] { display: block; }
  :global(html:is([data-estacion='primavera'], [data-estacion='verano'], [data-estacion='invierno'])) .mesa .foto-e[data-e='otono'] { display: none; }
  .mesa .pantalla {
    position: absolute;
    z-index: 2; /* por encima del grano de la pieza (::after, z 1): la web se ve limpia */
    left: 39.03%;
    top: 36.96%;
    width: 21.78%;
    height: 21.04%;
    overflow: hidden;
    /* ronda 190 · Eric: «se ve un mini marco blanco entre el marco del ordenador y el vídeo»: era el blanco de la pantalla de la lámina asomando en el
       borde fraccionario (y el fondo claro de la caja). Fondo en el negro del bisel y un filo de 2 px de ese negro por fuera (como en Proyectos, ronda 159). */
    background: #121213;
    box-shadow: 0 0 0 2px #121213;
  }
  /* RONDA 43 · «Remerge e Isotrol no encajan bien en el mockup»: el <video> lo inserta set:html y NO lleva el ámbito de Astro: estas reglas no se
     aplicaban nunca (el vídeo quedaba a su tamaño y con object-fit: contain: bandas en la pantalla y, en el móvil, la web recortada) → :global */
  .mesa .pantalla :global(.vid) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
  }
  /* la pantalla en PERSPECTIVA: caja en % de la lámina y la homografía como matrix3d (sus píxeles, vía --s) */
  .mesa .pantalla.quad {
    transform-origin: 0 0;
    /* RONDA 268 · Eric (Cubbo): «1 px en blanco arriba, entre el vídeo y el marco»: la caja era transparente y por la fila que el vídeo no cubría asomaba el blanco de la
       pantalla de la lámina. Fondo en el negro del bisel (como en el monitor, ronda 190) */
    background: #121213;
    border-radius: 2px;
  }
  /* 27/10 · Eric: «tiene que ser muy fiel a la realidad» · «con muesca»: fuera el border-radius (12,5 % / 5,8 % ≈ 30 px; la foto, 20–24 y distinto en cada
     esquina por la perspectiva). La MÁSCARA es el cristal de la propia lámina (tools/mesa-movil/mascara.cjs): esquinas y muesca, las de la foto */
  .movil .mesa .pantalla.quad {
    border-radius: 0;
    box-shadow: none;
    /* (Eric: «rellénala de negro»): la pantalla, negra (su fondo #121213) y con la forma del cristal real; el vídeo, dentro, con la forma limpia */
    -webkit-mask: var(--cristal) 0 0 / 100% 100% no-repeat;
    mask: var(--cristal) 0 0 / 100% 100% no-repeat;
  }
  /* el filo de la foto ondula: la caja negra va 4 px por fuera del cristal y el vídeo, dentro, en el rectángulo del cristal + 1 px (mesa-movil.json › video) */
  .movil .mesa .pantalla.quad > :global(*) {
    position: absolute;
    left: var(--vx);
    top: var(--vy);
    width: var(--vw);
    height: var(--vh);
    -webkit-mask: var(--mascara) 0 0 / 100% 100% no-repeat;
    mask: var(--mascara) 0 0 / 100% 100% no-repeat;
  }
  .escena .lamina::before,
  .movil .lamina::before,
  .roble .lamina::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* RONDA 162 · sin velo: el nombre ya no va sobre la foto */
    background: none;
  }
  /* sobre la foto, un velo arriba para que el nombre se lea siempre (regla junto a la de las pantallas en perspectiva) */

  /* ── el MOCKUP: una ventana de navegador con la web real.
     RONDA 189 · Eric: «el mockup de la web, mucho mejor: más moderno y translúcido, y que el rectángulo de arriba no tenga tanto aire». La ventana
     entera es CRISTAL (velo claro + desenfoque del fondo que hay detrás + filo de luz): un marco fino de 4 px alrededor de la web y una barra de 10 px
     arriba, dentro del mismo cristal (sin franja propia); la web va dentro con sus esquinas redondeadas. */
  .mockup {
    --ease-suave: cubic-bezier(0.32, 0.72, 0, 1); /* ronda 206: sin rebote */
    position: absolute;
    display: flex;
    flex-direction: column;
    /* Eric: radios concéntricos, interior = exterior − relleno (12 − 4 = 8) */
    --r-fuera: 6px; /* Eric: «demasiado redondeado»: 12 → 9; ronda 194, Andoni: «muy redondeado comparado con la card» (8 px): 9 → 6 (dentro, 6 − 3 = 3) */
    --marco: 3px;
    /* ronda 195 · Eric: «no hace falta que el mockup tenga la url arriba; que ocupe lo mismo abajo que arriba»: fuera la barra, el marco igual por los cuatro lados */
    padding: var(--marco);
    border-radius: var(--r-fuera);
    overflow: hidden;
    background: color-mix(in srgb, #fff 20%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.6);
    backdrop-filter: blur(20px) saturate(1.6);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.32),
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 0 0 1px rgb(0 0 0 / 0.08),
      0 32px 60px -22px rgb(20 12 6 / 0.55);
    transition: translate 0.9s var(--ease-out-expo), rotate 0.9s var(--ease-out-expo);
  }
  /* RONDA 67 · «el proyecto de Cubbo salía como de un lado, y ahora no; me gustaba como estaba y aplicarlo en otros proyectos»: vuelve el navegador que
     ASOMA ladeado y se sale por un lado y por abajo (la ronda 18), en todas las piezas con navegador; el lado alterna (`izq`) */
  .mancha .mockup,
  .claro .mockup {
    left: var(--mx, 14%);
    top: var(--top, 34%); /* ronda 190 · Eric: «el aire de arriba hay que reducir» en las piezas altas (3:4): 20 % */
    width: var(--mw, 118%);
    rotate: var(--giro, -6deg);
    transform-origin: 0 0;
  }
  .pieza.izq .mockup {
    left: auto;
    right: 14%;
    transform-origin: 100% 0;
  }
  /* sobre un degradado claro, el cristal se oscurece un poco para que la ventana se lea */
  .claro .mockup,
  .tinta-oscura .mockup {
    background: color-mix(in srgb, #302018 7%, transparent);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.5),
      0 0 0 1px rgb(48 32 24 / 0.1),
      0 24px 48px -20px rgb(48 32 24 / 0.35);
  }
  /* la web dentro del cristal, con sus esquinas y su filo; también la imagen de los heroes que rotan en la pieza de entrada (Eric: «la parte interior, bordeada») */
  .mockup :global(.vid),
  .mockup.heroe > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--r-fuera) - var(--marco));
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  /* Eric: «los puntitos no están bien puestos»: iban a 2 px del canto, montados en la curva de la esquina (radio 12). Ahora empiezan donde acaba la
     curva de la web de dentro (radio interior = 8 px desde el marco) y van centrados en una barra de 12 px */
  .cromo {
    position: relative;
    flex: none;
    display: flex;
    align-items: center;
    gap: 4px;
    height: 12px;
    padding-inline: calc(var(--r-fuera) - var(--marco));
  }
  .cromo i {
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.55);
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12);
  }
  .claro .cromo i,
  .tinta-oscura .cromo i { background: rgb(48 32 24 / 0.22); box-shadow: none; }
  .cromo b {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    max-width: 60%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.34rem;
    letter-spacing: 0.01em;
    color: rgb(255 255 255 / 0.78);
  }
  .claro .cromo b,
  .tinta-oscura .cromo b { color: rgb(48 32 24 / 0.55); }

  /* ── al pasar */
  .escena:hover .mesa,
  .escena:focus-visible .mesa,
  .movil:hover .mesa,
  .movil:focus-visible .mesa,
  .roble:hover .mesa,
  .roble:focus-visible .mesa {
    scale: 1.06;
  }
  .pieza:is(a):hover .lamina[class*='g-']::before {
    transform: scale(1.15) rotate(8deg);
  }
  .pieza:is(a):focus-visible {
    outline: 2px solid var(--color-niebla);
    outline-offset: calc(var(--spacing) * 1);
  }

  /* ── ENTRADA: la pieza se descubre de abajo arriba; su contenido llega un poco después */
  :global(html.anima) .pieza .lamina {
    clip-path: inset(100% 0 0 0 round var(--radius-lg));
  }
  :global(html.anima) .pieza .mockup,
  :global(html.anima) .pieza .mesa,
  :global(html.anima) .pieza .logos {
    translate: 0 22%;
  }
  :global(html.anima) .pieza .mesa {
    translate: 0 6%;
    scale: 1.12;
  }
  :global(html.anima) .pieza .nombre,
  :global(html.anima) .pieza .pie {
    opacity: 0;
  }
  :global(html.anima) .pieza.visto .lamina {
    clip-path: inset(0 0 0 0 round var(--radius-lg));
    transition: clip-path 1.2s var(--ease-out-expo) calc(var(--i) * 110ms);
  }
  :global(html.anima) .pieza.visto .mockup,
  :global(html.anima) .pieza.visto .mesa,
  :global(html.anima) .pieza.visto .logos {
    translate: 0 0;
    scale: 1;
    transition: translate 1.4s var(--ease-out-expo) calc(0.12s + var(--i) * 110ms), scale 1.8s var(--ease-out-expo) calc(var(--i) * 110ms), rotate 0.9s var(--ease-out-expo);
  }
  :global(html.anima) .pieza.visto .nombre,
  :global(html.anima) .pieza.visto .pie {
    opacity: 1;
    transition: opacity 0.9s ease calc(0.55s + var(--i) * 110ms);
  }
  /* RONDA 206 · Eric: «al hacer hover, el mockup centrado y que se vea la web entera; al salir, vuelve al estado inicial» · «cuidado con el rebote de ida y vuelta,
     smoothness»: el navegador (mancha y claro) se coloca por TRANSFORMACIÓN (translate + scale + rotate a 0; el JS mide cuánto) y no por left/top/width, con la misma
     curva y duración y SIN retardo en la ida y en la vuelta (antes, la vuelta heredaba los retardos y duraciones distintas de la entrada: de ahí el rebote) */
  :global(html.anima) .pieza.interactivo .mockup,
  .pieza.interactivo .mockup {
    transition: translate 0.8s var(--ease-suave), scale 0.8s var(--ease-suave), rotate 0.8s var(--ease-suave);
    will-change: translate, scale, rotate;
  }
  :global(html.anima) .pieza.interactivo.centra .mockup,
  .pieza.interactivo.centra .mockup {
    translate: var(--hx, 0px) var(--hy, 0px);
    scale: var(--hs, 1);
    rotate: 0deg;
  }
  /* RONDA 290 · táctil: el navegador nace ya recto y centrado, sin transición (ni la de la entrada ni la del scroll) */
  :global(html.anima) .pieza.fijo .mockup,
  .pieza.fijo .mockup { transition: none !important; will-change: auto; }
  :global(html.anima) .escena.visto:hover .mesa,
  :global(html.anima) .movil.visto:hover .mesa,
