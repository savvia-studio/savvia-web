const FEED = [
  { tipo: 'empresas', titulo: L.hero.tarjeta.titulo, filas: L.hero.tarjeta.filas.map(([n, v], j) => ({ n, v, c: ['#2f9e6d', '#3a6fd8', '#d9412b'][j] })) },
  { tipo: 'personas', titulo: '3 personas clave encontradas', filas: [
    { n: 'Jon Martínez', r: 'Director de compras · Betsaide', v: 94, c: '#a7c5f9' },
    { n: 'Nerea Aguirre', r: 'Directora de operaciones · Arania', v: 91, c: '#f2c7a5' },
    { n: 'Inés Etxebarria', r: 'Directora de planta · Fagor Automation', v: 88, c: '#d9b8d4' },
  ] },
