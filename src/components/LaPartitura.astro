      if (modo === 'h') {
        ins.forEach((c, i) => { const y = (i - 4.5) * 44; c.x = -250 - c.w; c.y = y - BH / 2; c.P = curvaH(-250, y, -SW / 2 - 1, 0, 0.55, 0.5); });
        outs.forEach((c, j) => { const y = (j - (outs.length - 1) / 2) * (outs.length > 6 ? 44 : 56); c.x = 250; c.y = y - BH / 2; c.P = curvaH(SW / 2 + 1, 0, 250, y, 0.5, 0.55); });
      } else {
        const filasDe = (cs: Caja[]) => {
          const out: Caja[][] = [[]];
          let ancho = 0;
          for (const c of cs) { if (ancho && ancho + 10 + c.w > 440) { out.push([]); ancho = 0; } out[out.length - 1].push(c); ancho += (ancho ? 10 : 0) + c.w; }
          return out;
        };
        const colocar = (fs: Caja[][], y0: number, dir: 1 | -1) => fs.forEach((fila, r) => {
          const tw = fila.reduce((s, c) => s + c.w, 0) + (fila.length - 1) * 10;
          let x = -tw / 2;
          const yc = y0 + dir * (dir === 1 ? r : fs.length - 1 - r) * 40;
          for (const c of fila) { c.x = x; c.y = yc - BH / 2; x += c.w + 10; }
        });
        colocar(filasDe(ins), -SH / 2 - 110 - BH / 2, -1);
        colocar(filasDe(outs), SH / 2 + 110 + BH / 2, 1);
        ins.forEach((c) => { c.P = curvaV(c.x + c.w / 2, c.y + BH, 0, -SH / 2 - 1, 0.55, 0.5); });
        outs.forEach((c) => { c.P = curvaV(0, SH / 2 + 1, c.x + c.w / 2, c.y, 0.5, 0.45); });
      }
      for (const c of cajas) {
        c.g.setAttribute('transform', `translate(${f2(c.x)} ${f2(c.y)})`);
        const tx = c.g.querySelector('text')!;
        tx.setAttribute('x', String(PAD));
        tx.setAttribute('y', f2(BH / 2 + FS * 0.34));
        c.tabla = tablaArco(c.P);
        c.hilo.setAttribute('d', dDe(c.P));
        c.pulso.setAttribute('d', dDe(c.P));
      }
      // ronda 203 · Eric: «un mensajito de CMS, Sanity por ejemplo; los logos no hacen falta»: a la derecha de «Subir blog al CMS», en escritorio
      cmsTx = null;
      if (modo === 'h') {
        const cms = outs[SALE.findIndex((x) => /CMS/.test(x))];
        if (cms) { cmsTx = el('text', { class: 'cms', x: f2(cms.w + 10), y: f2(BH / 2 + 4) }, cms.g) as SVGTextElement; cmsTx.textContent = tr('✓ en Sanity', '✓ in Sanity'); }
      }

      // ── LA CÁMARA: vistas calculadas de la geometría
      const caja = (cs: { x: number; y: number; w: number; h: number }[]) => {
        const x0 = Math.min(...cs.map((c) => c.x)), y0 = Math.min(...cs.map((c) => c.y)), x1 = Math.max(...cs.map((c) => c.x + c.w)), y1 = Math.max(...cs.map((c) => c.y + c.h));
        return { x0, y0, x1, y1, w: x1 - x0, h: y1 - y0 };
      };
      const hoja = { x: -SW / 2, y: -SH / 2, w: SW, h: SH };
      const todo = caja([...cajas, hoja]), ci = caja(ins);
      const sR = Math.min((W * 0.9) / todo.w, (H * 0.84) / todo.h);
      REST = { S: sR, cx: (todo.x0 + todo.x1) / 2, cy: (todo.y0 + todo.y1) / 2 };
      if (modo === 'h') {
        const s = Math.min(sR * 1.24, (H * 0.92) / ci.h);
        INS = { S: s, cx: ci.x0 + (W * 0.43) / s, cy: (ci.y0 + ci.y1) / 2 };
        INS2 = { S: s * 1.04, cx: INS.cx + 6, cy: INS.cy };
        FOLD = { S: (W * 0.42) / SW, cx: 0, cy: 0 };
      } else {
        const s = Math.min(sR * 1.3, (W * 0.94) / ci.w);
        INS = { S: s, cx: 0, cy: ci.y0 + (H * 0.36) / s };
        INS2 = { S: s * 1.04, cx: 0, cy: INS.cy + 6 };
        FOLD = { S: (W * 0.72) / SW, cx: 0, cy: 0 };
      }
      DENTRO = { S: HOLD, cx: 0, cy: 0 };
      CAM = [
        [0, REST, EZ.lin], [1.9, REST, EZ.lin], [2.5, INS, EZ.camara], [3.1, INS2, EZ.deriva], [3.6, FOLD, EZ.camara], [ABRE, FOLD, EZ.lin],
        [4.45, DENTRO, EZ.zambullida], [SUBE[0], DENTRO, EZ.lin], [SUBE[1], REST, EZ.subida], [LOOP, REST, EZ.lin],
      ];
      medirVentana();
      montarPicks();
      for (const c of curs) ult.delete(c);
      for (const c of cajas) ult.delete(c.g);
    };

    const camara = (t: number): Vista => {
      let q = 0;
      while (q < CAM.length - 2 && CAM[q + 1][0] <= t) q++;
      const [t0, A] = CAM[q], [t1, B, ez] = CAM[q + 1];
      const p = ez(prog(t, t0, t1));
      return { S: Math.exp(lerp(Math.log(A.S), Math.log(B.S), p)), cx: lerp(A.cx, B.cx, p), cy: lerp(A.cy, B.cy, p) };
    };
    const sx = (v: Vista, x: number) => W / 2 + v.S * (x - v.cx), sy = (v: Vista, y: number) => H / 2 + v.S * (y - v.cy);

    // ── LA APP por dentro
    const Q = <T extends Element>(s: string) => [...win.querySelectorAll<T>(s)];
    const pz = Object.fromEntries(Q<HTMLElement>('[data-pz]').map((e) => [e.dataset.pz!, e])) as Record<string, HTMLElement>;
    const composer = win.querySelector<HTMLElement>('[data-composer]')!, escrito = win.querySelector<HTMLElement>('[data-escrito]')!, caret = win.querySelector<HTMLElement>('[data-caret]')!;
    const enviar = win.querySelector<HTMLElement>('[data-enviar]')!, estado = win.querySelector<HTMLElement>('[data-estado]')!, estadoTxt = win.querySelector<HTMLElement>('[data-estado-txt]')!;
    const estadoAv = win.querySelector<HTMLElement>('[data-estado-av]')!, estadoQuien = win.querySelector<HTMLElement>('[data-estado-quien]')!, estadoPieza = win.querySelector<HTMLElement>('[data-estado-pieza]')!;
    const publicar = win.querySelector<HTMLElement>('[data-publicar]')!, lienzo = win.querySelector<HTMLElement>('[data-lienzo]')!;
    const chips = Q<HTMLElement>('[data-chip]'), scroller = win.querySelector<HTMLElement>('[data-scroller]')!, secEls = SECS.map((n) => win.querySelector<HTMLElement>(`[data-sec="${n}"]`)!);
    const neety = win.querySelector<HTMLElement>('[data-neety]')!;
    // RONDA 188 · la réplica del hero de Neety: la película mueve su cinta (`pintar`, en segundos reales de SU guion) y su punto (`latir`)
    type NH = { pintar: (t: number) => void; latir: (l: number) => void; marquesina: (t: number) => void; desplazar: (y: number) => void };
    const BAJA = curva(0.65, 0, 0.35, 1);
    const vpNH = win.querySelector<HTMLElement & { __nh?: NH }>('[data-nh-vp]')!, puntoLib = win.querySelector<HTMLElement>('.fc-dot')!;
    let WW = 1360, WH = 720;
    const sitio = new Map<Element, { x: number; y: number; w: number; h: number }>();
    let offs: number[] = [0, 0, 0, 0, 0];
    const medirVentana = () => {
      WW = win.offsetWidth; WH = win.offsetHeight; sitio.clear();
      const tope = Math.max(0, scroller.offsetHeight - scroller.parentElement!.offsetHeight);
      offs = secEls.map((e) => Math.min(tope, e.offsetTop));
    };
    const rectLocal = (e: HTMLElement) => {
      let r = sitio.get(e);
      if (r) return r;
      // dentro de la réplica de Neety las medidas van en su espacio de 768 px: al salir de ella se escalan (×ancho del hueco / 768)
      let x = 0, y = 0, k = 1, n: HTMLElement | null = e;
      while (n && n !== win) {
        x += n.offsetLeft; y += n.offsetTop;
        const p = n.offsetParent as HTMLElement | null;
        if (p === vpNH) { k = neety.clientWidth / 768; x *= k; y *= k; }
        n = p;
      }
      r = { x, y, w: e.offsetWidth * k, h: e.offsetHeight * k };
      sitio.set(e, r);
      return r;
    };
    const ventanaEn = (v: Vista) => { const s = v.S / HOLD; return { s, x: sx(v, 0) - (WW * s) / 2, y: sy(v, 0) - (WH * s) / 2 }; };

    // ── EL SCROLL de la librería (función pura del tiempo): antes de cada pick la columna principal baja hasta su sección
    const scrollE = curva(0.45, 0, 0.15, 1);
    const VENT = picks.map((p, i) => (i > 0 && p.sec !== picks[i - 1].sec ? { a: SECS.indexOf(picks[i - 1].sec), b: SECS.indexOf(p.sec), t0: p.tg - 0.68, t1: p.tg - 0.2 } : null)).filter(Boolean) as { a: number; b: number; t0: number; t1: number }[];
    const scrollY = (t: number) => {
      let y = offs[0];
      for (const v of VENT) if (t >= v.t0) y = lerp(offs[v.a], offs[v.b], scrollE(prog(t, v.t0, v.t1)));
      return y;
    };
    // cuánto «mira» el índice a cada sección (el punto naranja de la barra lateral sigue al scroll)
    const sobre = (t: number) => {
      const o = [1, 0, 0, 0, 0];
      for (const v of VENT) if (t >= v.t0) { const q = scrollE(prog(t, v.t0, v.t1)); o.fill(0); o[v.a] = 1 - q; o[v.b] = q; }
      return o;
    };
    const indiceEls = SECS.map((n) => Q<HTMLElement>(`[data-s="${n}"]`));
    // lo que se coge (en la librería) y dónde cae (en la home); la COPIA que viaja es un clon del elemento
    const srcEl = picks.map((p) => win.querySelector<HTMLElement>(`[data-src="${p.src}"]`)!);
    const slotEl = picks.map((p) => win.querySelector<HTMLElement>(`[data-slot="${p.slot}"]`)!);
    const gh = srcEl.map((e) => { const c = e.cloneNode(true) as HTMLElement; c.removeAttribute('data-src'); c.classList.remove('pk'); c.classList.add('gh'); c.setAttribute('aria-hidden', 'true'); win.appendChild(c); return c; });
    const GRAB: [number, number] = [0.6, 0.56];
    const SEND = picks.map(() => 0.8);
    type Datos = { gw: number; gh: number; s: number; ox: number; oy: number };
    let dat: Datos[] = [];
    const montarPicks = () => {
      dat = picks.map((_, i) => {
        const r = rectLocal(srcEl[i]), d = rectLocal(slotEl[i]);
        gh[i].style.width = `${r.w}px`;
        gh[i].style.height = `${r.h}px`;
        // la copia acaba un poco más pequeña que el original, y nunca mayor que su hueco ×1,3
        // el botón (ronda 188): la copia llega EXACTA a la píldora de la home (antes se soltaba sobre la fila entera y a un tamaño aproximado)
        const s = picks[i].slot === 'ctas' ? d.w / r.w : clamp((d.w * 1.3) / r.w, 0.3, 0.84);
        return { gw: r.w, gh: r.h, s, ox: (GRAB[0] - 0.5) * r.w, oy: (GRAB[1] - 0.5) * r.h };
      });
      // el chip, junto a su sitio en la home
      const n = rectLocal(neety);
      picks.forEach((p, i) => {
        const d = rectLocal(slotEl[i]), ch = chips[i], cw = ch.offsetWidth, chh = ch.offsetHeight;
        const pos: Record<string, [number, number]> = {
          fondo: [n.x + n.w - cw - 16, n.y + 64],
          h1: [d.x + d.w - cw, d.y - chh - 6],
          ctas: [d.x, d.y + d.h + 8],
          esp: [d.x + 30, d.y + (modo === 'h' ? 0 : -2)],
          logo: [d.x, d.y + d.h + 10],
          punto: [d.x + (modo === 'h' ? 200 : 170), d.y - chh / 2 + 2],
        };
        const [px, py] = pos[p.slot] ?? [d.x, d.y + d.h + 8];
        ch.style.left = `${f2(clamp(px, n.x + 8, n.x + n.w - cw - 8))}px`;
        ch.style.top = `${f2(py)}px`;
      });
    };

    // ── LOS CURSORES: anclas (en unidades de la escena o de la ventana) y fotogramas clave en segundos
    type Ancla = (t: number) => number[];
    const Wp = (x: number, y: number): Ancla => (t) => { const v = camara(t); return [sx(v, x), sy(v, y)]; };
    const congela = (a: Ancla, ts: number): Ancla => () => a(ts);
    const enCaja = (lado: 'in' | 'out', i: number, fx = 0.66, fy = 0.64): Ancla => (t) => { const c = (lado === 'in' ? ins : outs)[i]; return Wp(c.x + c.w * fx, c.y + c.h * fy)(t); };
    const Vp = (e: HTMLElement | (() => HTMLElement), fx = 0.7, fy = 0.6): Ancla => (t) => {
      const r = rectLocal(typeof e === 'function' ? e() : e), w = ventanaEn(camara(t));
      return [w.x + (r.x + r.w * fx) * w.s, w.y + (r.y + r.h * fy) * w.s];
    };
    const Of = (fx: number, fy: number): Ancla => () => [W * fx, H * fy];
    const esquina = (ex: number, ey: number) => Wp(ex * (SW / 2 - 6), ey * (SH / 2 - 8));
    type Kf = [number, Ancla, (x: number) => number];
    const M = EZ.mano, Ln = EZ.lin;
    // un PICK: el agente va al elemento de la librería, lo coge (la copia se despega y viaja con su cursor) y lo lleva a su sitio en la home
    const Lloc = (f: (t: number) => [number, number]): Ancla => (t) => { const w = ventanaEn(camara(t)), [lx, ly] = f(t); return [w.x + lx * w.s, w.y + ly * w.s]; };
    const srcAt = (i: number): Ancla => Lloc((t) => { const r = rectLocal(srcEl[i]); return [r.x + r.w * GRAB[0], r.y + r.h * GRAB[1] - scrollY(t)]; });
    const slotAt = (i: number): Ancla => Lloc(() => { const r = rectLocal(slotEl[i]), d = dat[i]; return [r.x + r.w / 2 + d.ox * d.s, r.y + r.h / 2 + d.oy * d.s]; });
    const tomar = (i: number): Kf[] => {
      const p = picks[i];
      return [[p.tg - 0.32, srcAt(i), M], [p.tg, srcAt(i), Ln], [p.land, slotAt(i), M], [p.land + 0.25, slotAt(i), Ln]];
    };
    // Tu equipo: de salida en salida; llega cuando la tarjeta se está dibujando y la pulsa al aparecer (A + 0,15)
    const pulsa: Kf[] = CONS.flatMap((c) => [[c.A + 0.05, enCaja('out', c.o, 0.5, 0.62), M], [c.A + 0.28, enCaja('out', c.o, 0.5, 0.62), Ln]] as Kf[]);
    const salida = (q: number): Kf[] => CONS.filter((c) => c.ag === q).flatMap((c) => [[c.A - 0.85, enCaja('in', c.i), M], [c.A - 0.45, enCaja('in', c.i), Ln]] as Kf[]);
    const fuera = [Of(0.46, -0.25), Of(-0.3, 0.32), Of(-0.3, 0.86), Of(0.3, 1.25)];
    const esq: [number, number][] = [[-1, -1], [1, -1], [1, 1], [-1, 1]];
    // móvil (modo v): la ventana es estrecha y la etiqueta del cursor (≈110 u. a la derecha de la flecha) se salía del marco: las esperas, más al centro
    const segun = (h: Ancla, v: Ancla): Ancla => (t) => (modo === 'v' ? v : h)(t);
    const ESPERA = [Vp(() => lienzo, 0.32, 0.13), segun(Vp(() => lienzo, 0.8, 0.12), Vp(() => lienzo, 0.52, 0.12)), segun(Vp(() => lienzo, 0.9, 0.66), Vp(() => lienzo, 0.6, 0.66)), segun(Vp(() => composer, 0.96, 0.62), Vp(() => composer, 0.5, 0.62))];
    const intro = (q: number): Kf[] => {
      const e = EDIT.find((x) => x.ag === q)!;
      return [
        [0, fuera[q], Ln], [e.at - 0.85, fuera[q], Ln], [e.at, enCaja('in', e.i), M], [3.15, enCaja('in', e.i), Ln], [3.55, esquina(...esq[q]), M], [ABRE, esquina(...esq[q]), Ln],
        [4.2, congela(esquina(...esq[q]), ABRE), Ln],
      ];
    };
    // Tu equipo, mientras trabajan los agentes: a un lado, sin tapar el estado
    const aparte: Ancla = (t) => (modo === 'v' ? Vp(lienzo, 0.3, 0.97)(t) : Vp(lienzo, 0.6, 0.94)(t));
    const KF: Kf[][] = [0, 1, 2, 3].map((q) => {
      const kf: Kf[] = [...intro(q), [4.85, ESPERA[q], M]];
      // Tu equipo: teclea la petición y la envía; luego se aparta a un lado
      if (q === 3) kf.push([PIDE[1], ESPERA[3], Ln], [ENVIA - 0.05, Vp(enviar, 0.5, 0.55), M], [ENVIA + 0.3, Vp(enviar, 0.5, 0.55), Ln], [6.1, aparte, M]);
      picks.forEach((p, i) => {
        if (p.ag !== q) return;
        kf.push([p.tg - 1.0, kf[kf.length - 1][1], Ln], ...tomar(i), [p.land + SEND[i], q === 3 ? aparte : ESPERA[q], M]);
      });
      if (q === 3) kf.push([PUB - 0.4, aparte, Ln], [PUB, Vp(publicar, 0.5, 0.6), M]);
      const ult = kf[kf.length - 1];
      kf.push([SUBE[0], ult[1], Ln], [SUBE[0] + 0.05, congela(ult[1], SUBE[0]), Ln], ...(q === 3 ? pulsa : salida(q)), [15.95 + D + E, fuera[q], M]);
      return kf;
    });
    const CLICS: number[][] = [0, 1, 2, 3].map((q) => [
      EDIT.find((e) => e.ag === q)!.at, ABRE,
      ...picks.filter((p) => p.ag === q).flatMap((p) => [p.tg, p.land]),
      ...(q === 3 ? [ENVIA, PUB] : []),
      ...(q === 3 ? CONS.map((c) => c.A + 0.15) : CONS.filter((c) => c.ag === q).map((c) => c.A - 0.45)),
    ]);
    const manoEn = (q: number, t: number) => {
      const kf = KF[q];
      let i = 0;
      while (i < kf.length - 2 && kf[i + 1][0] <= t) i++;
      const [a0, A0] = kf[i], [a1, A1, ez] = kf[i + 1];
      const p = ez(prog(t, a0, a1)), P0 = A0(t), P1 = A1(t);
      const arco = ez === Ln ? 0 : Math.sin(Math.PI * p) * -Math.min(40, Math.hypot(P1[0] - P0[0], P1[1] - P0[1]) * 0.12);
      return [lerp(P0[0], P1[0], p), lerp(P0[1], P1[1], p) + arco];
    };

    // ── EL SONIDO: de ordenador (r109). Las piezas que llegan se POSAN, las ediciones son clic y tecleo, la petición se teclea de verdad, cada
    // lectura y cada pieza puesta es un clic, enviar y publicar son la tecla grande, y al publicar suena un timbre suave. La música de la web sigue.
    type Son = [number, () => void];
    // RONDA 156 · Eric: «la música va a cambiar por completo menos la del mockup del ordenador»: esta pieza va MUDA (los sonidos quedan aquí, apagados)
    const SONIDO_UI = false;
    const SON: Son[] = !SONIDO_UI ? [] : [
      ...CASC.map((c) => [c.t, () => posar({ vol: 0.03 + (c.i % 3) * 0.006 })] as Son),
      ...EDIT.map((e) => [e.at, () => { clic({ vol: 0.04 }); teclear(3, { vol: 0.026, ritmo: 0.05 }); }] as Son),
      [ABRE, () => papel({ vol: 0.05, dur: 0.3 })],
      [PIDE[0], () => teclear(Math.round(PETICION.length / 2.6), { vol: 0.026, ritmo: 0.048 })],
      [ENVIA, () => tecla({ vol: 0.05, fuerte: true })],
      ...picks.flatMap((p) => [[p.tg, () => clic({ vol: 0.045 })], [p.land, () => posar({ vol: 0.045 })]] as Son[]),
      [PUB, () => { tecla({ vol: 0.05, fuerte: true }); tocar(84, { vol: 0.03, dur: 1.4, cuando: 0.1 }); tocar(91, { vol: 0.02, dur: 1.6, cuando: 0.18 }); }],
      ...CONS.map((c) => [c.A + 0.15, () => clic({ vol: 0.025 })] as Son),
    ];
    const sonar = (t0: number, t1: number) => {
      for (const [ts, fn] of SON) if ((t1 >= t0 && ts > t0 && ts <= t1) || (t1 < t0 && (ts > t0 || ts <= t1))) fn();
    };

    // ── PINTAR el fotograma t (función pura del tiempo)
    const pintar = (t: number) => {
      const v = camara(t), K = k * v.S;
      pon(cam, '@transform', `translate(${f2(k * (W / 2 - v.S * v.cx))} ${f2(k * (H / 2 - v.S * v.cy))}) scale(${K.toFixed(5)})`);
      pon(cam, '--u', (1 / K).toFixed(5));
      const fin = sm(t, 15.4 + D + E, 15.95 + D + E);

      for (const r of cajas) {
        let ver = 1, dib = 1;
        if (r.lado === 'out') {
          const cn = CONS.find((x) => x.o === r.i)!, p0 = cn.A - 0.15;
          if (t >= 4.45 && t < p0) { ver = 0; dib = 0; }
          else if (t >= p0 && t < cn.A + 0.15) { dib = EZ.flujo(prog(t, p0, cn.A + 0.15)); ver = 0; }
          if (t >= cn.A + 0.15) ver = EZ.sale(prog(t, cn.A + 0.15, cn.A + 0.6));
        }
        pon(r.hilo, 'stroke-dasharray', dib >= 1 ? 'none' : `${f3(dib)} 2`);
        let act: Pulso | null = null;
        for (const p of PULSOS) if (p.lado === r.lado && p.i === r.i && t >= p.t0 && t <= p.t0 + p.d + 0.08) act = p;
        if (act) {
          const h = EZ.flujo(prog(t, act.t0, act.t0 + act.d)), seg = 0.18;
          pon(r.pulso, 'stroke', AG[act.ag]);
          pon(r.pulso, 'stroke-dasharray', `${f3(Math.min(seg, h))} 2`);
          pon(r.pulso, 'stroke-dashoffset', f3(-(h - Math.min(seg, h))));
          pon(r.pulso, 'opacity', f3(1 - prog(t, act.t0 + act.d, act.t0 + act.d + 0.08)));
          const [x, y] = bez(r.P, uDe(r.tabla, h));
          pon(r.cabeza, '@cx', f2(x));
          pon(r.cabeza, '@cy', f2(y));
          pon(r.cabeza, 'fill', AG[act.ag]);
          pon(r.cabeza, 'opacity', f3(Math.min(1, prog(t, act.t0, act.t0 + 0.06)) * (1 - prog(t, act.t0 + act.d - 0.04, act.t0 + act.d + 0.04))));
        } else {
          pon(r.pulso, 'opacity', '0');
          pon(r.cabeza, 'opacity', '0');
        }
        // la caja: se enciende con el color de quien la toca (cascada, edición, construcción) o queda seleccionada
        let luz = 0, ag = 0;
        const sube = (x: number, a: number) => { if (x > luz) { luz = x; ag = a; } };
        if (r.lado === 'in') {
          for (const q of CASC) if (q.i === r.i) sube(blip(t, q.t, 0.6) * 0.9, q.ag);
          for (const e of EDIT) if (e.i === r.i) sube(sm(t, e.at, e.at + 0.1) * (1 - sm(t, SEL_FIN, SEL_FIN + 0.3)), e.ag);
          for (const cn of CONS) if (cn.i === r.i) sube(blip(t, cn.A - 0.45, 0.7), cn.ag);
        } else {
          const cn = CONS.find((x) => x.o === r.i)!;
          sube(blip(t, cn.A + 0.15, 0.8), cn.ag);
          if (cn.o === 3) sube(sm(t, cn.A + 0.15, cn.A + 0.3) * (1 - fin), cn.ag);
        }
        pon(r.g, '--c', AG[ag]);
        pon(r.g, '--l', f3(luz));
        const pop = r.lado === 'out' ? lerp(0.9, 1, ver) : 1;
        pon(r.g, 'opacity', f3(ver));
        if (cmsTx && r.lado === 'out' && cmsTx.parentNode === r.g) { const cn = CONS.find((x) => x.o === r.i)!; pon(cmsTx, 'opacity', f3(EZ.sale(prog(t, cn.A + 0.7, cn.A + 1.1)))); }
        pon(r.g, '@transform', `translate(${f2(r.x + (r.w * (1 - pop)) / 2)} ${f2(r.y + (r.h * (1 - pop)) / 2)}) scale(${f3(pop)})`);
      }

      // la tarjeta: su filo se enciende con cada llegada y la fila que se indexa toma el color de quien la trae
      let fl = 0, fa = 0;
      const luzFila = filas.map(() => [0, 0]);
      for (const g of LLEGADAS) {
        const x = blip(t, g.t, 0.6);
        if (x > fl) { fl = x; fa = g.ag; }
        if (x > luzFila[g.fila][0]) luzFila[g.fila] = [x, g.ag];
      }
      filas.forEach((f, q) => {
        pon(f.bg, 'fill', AG[luzFila[q][1]]);
        pon(f.bg, 'opacity', f3(luzFila[q][0] * 0.16));
        pon(f.ic, 'fill', `color-mix(in oklab, ${AG[luzFila[q][1]]} ${Math.round(luzFila[q][0] * 100)}%, var(--ic-reposo))`);
      });
      pon(filo, 'stroke', `color-mix(in oklab, ${AG[fa]} ${Math.round(fl * 100)}%, var(--filo-reposo))`);
      pon(filo, '--g', f3(fl));
      pon(gPub, 'opacity', f3(sm(t, SUBE[1] - 0.2, SUBE[1] + 0.2) * (1 - fin)));
      const vT = 1 - clamp((Math.log(v.S) - Math.log(FOLD.S * 1.15)) / (Math.log(FOLD.S * 2.6) - Math.log(FOLD.S * 1.15)));
      pon(gTexto, 'opacity', f3(vT));

      // la app: nace del propio papel de la tarjeta según la cámara se acerca
      const wo = clamp((Math.log(v.S) - Math.log(8)) / (Math.log(24) - Math.log(8)));
      const w = ventanaEn(v);
      pon(win, 'visibility', wo > 0.001 ? 'visible' : 'hidden');
      pon(win, 'opacity', f3(EZ.fundido(wo)));
      if (wo > 0.001) {
        pon(win, 'transform', `translate(${f2(w.x * k)}px, ${f2(w.y * k)}px) scale(${(w.s * k).toFixed(5)})`);
        pintarApp(t);
      }

      curs.forEach((c, q) => {
        const [x, y] = manoEn(q, t);
        pon(c, 'transform', `translate3d(${f2(x * k)}px, ${f2(y * k)}px, 0)`);
        // la etiqueta pasa a la izquierda del cursor si no cabe a la derecha (Publicar queda pegado al borde: «Tu equipo» se cortaba)
        const et = c.querySelector<HTMLElement>('span');
        if (et) {
          const ew = et.offsetWidth, off = et.offsetLeft, over = x * k + off + ew + 12 - cine.clientWidth;
          pon(et, 'translate', `${f2(-clamp(over / 24) * (ew + off - 4))}px 0`); // espejo del caso normal: su borde derecho, junto a la flecha
        }
        let cl = 0, on = 0;
        for (const tc of CLICS[q]) { cl = Math.max(cl, blip(t, tc, 0.35)); const p = prog(t, tc, tc + 0.5); if (p > 0 && p < 1) on = p; }
        pon(c, '--clic', f3(cl));
        pon(c, '--onda', f3(on));
      });
    };

    const pintarApp = (t: number) => {
      // la PETICIÓN: aparece, se teclea, se envía y se recoge
      const ca = EZ.quart(prog(t, 4.15, 4.5)), col = EZ.sale(prog(t, ENVIA + 0.03, ENVIA + 0.5));
      const n = Math.round(prog(t, PIDE[0], PIDE[1]) * PETICION.length);
      pon(escrito, '#', PETICION.slice(0, n));
      pon(caret, 'opacity', t < ENVIA && (Math.floor(t * 2.4) % 2 === 0 || (t > PIDE[0] && t < PIDE[1])) ? '1' : '0');
      pon(composer, 'opacity', f3(ca * (1 - col)));
      pon(composer, 'transform', `translateY(${f2((1 - ca) * 24 + col * 150)}px) scale(${f3(1 - col * 0.18)})`);
      pon(enviar, '--l', f3(n > 0 ? 1 : 0)); // como en Claude: se enciende en cuanto hay texto
      pon(enviar, '--clic', f3(blip(t, ENVIA, 0.3)));
      pon(neety, '--vacio', f3(1 - sm(t, PIEZA.fondo, PIEZA.fondo + 0.6)));
      // el ESTADO: qué agente toma qué de la librería, y al final, publicado
      pon(estado, 'opacity', f3(sm(t, ENVIA + 0.3, ENVIA + 0.55)));
      pon(estado, 'transform', `translateY(${f2((1 - EZ.sale(prog(t, ENVIA + 0.3, ENVIA + 0.7))) * 16)}px)`);
      let iAct = -1;
      picks.forEach((p, i) => { if (t >= p.tg - 0.35) iAct = i; });
      const pub = t >= PUB + 0.12, ult = picks[picks.length - 1];
      // lee (los tres avatares) → toma (el agente, su color, la pieza) → listo (los tres) → publicado (check y el dominio)
      const m = pub ? 'pub' : iAct < 0 ? 'lee' : t > ult.land + 0.5 ? 'listo' : 'toma';
      pon(estado, '@data-m', m);
      if (m === 'toma') {
        const ag = picks[iAct].ag;
        pon(estadoAv, '@data-ag', String(ag));
        pon(estadoAv, '--c', AG[ag]);
        pon(estadoQuien, '#', NOMBRES[ag]);
      }
      pon(estadoTxt, '#', m === 'pub' ? ESTADO[1] : m === 'lee' ? ESTADO[0] : m === 'listo' ? ESTADO[2] : tr('ha añadido', 'added')); // ronda 203 · Eric: «ese "toma" queda raro»: como una notificación
      pon(estadoPieza, '#', m === 'pub' ? 'neety.com' : m === 'toma' ? picks[iAct].label : '');
      pon(estado, '--pub', pub ? '1' : '0');
      pon(estado, '--late', f3(0.5 - 0.5 * Math.cos(2 * Math.PI * t * 0.9)));
      pon(publicar, '--l', f3(sm(t, PUB - 0.4, PUB - 0.15)));
      pon(publicar, '--clic', f3(blip(t, PUB, 0.35)));
      pon(neety, '--pub', f3(prog(t, PUB + 0.05, PUB + 0.85)));
      // LA LIBRERÍA: la columna recorre sus secciones y el índice marca la que se mira
      const sy0 = scrollY(t), on = sobre(t);
      pon(scroller, 'transform', `translate3d(0, ${f2(-sy0)}px, 0)`);
      on.forEach((o, j) => indiceEls[j].forEach((e) => pon(e, '--on', f3(o))));
      // LOS PICKS: anillo y elevación en el elemento, la copia que viaja con el cursor, el chip y la pieza que se asienta en la home
      const w = ventanaEn(camara(t));
      picks.forEach((p, i) => {
        const c = AG[p.ag], d = dat[i];
        const anillo = sm(t, p.tg - 0.34, p.tg - 0.12) * (1 - sm(t, p.land - 0.1, p.land + 0.3));
        const eleva = sm(t, p.tg - 0.34, p.tg - 0.12) * (1 - sm(t, p.tg - 0.02, p.tg + 0.2));
        const atenua = sm(t, p.tg, p.tg + 0.14) * (1 - sm(t, p.land - 0.05, p.land + 0.35));
        pon(srcEl[i], '--c', c);
        pon(srcEl[i], '--pk', f3(anillo));
        pon(srcEl[i], '--lift', f3(eleva));
        pon(srcEl[i], '--dim', f3(atenua));
        // la copia: se despega al coger, se hace un poco más pequeña mientras viaja y se posa en su hueco (donde la pieza real se asienta)
        const vis = sm(t, p.tg - 0.02, p.tg + 0.06) * (1 - sm(t, p.land + 0.02, p.land + 0.22));
        if (vis > 0.001) {
          const [mx, my] = manoEn(p.ag, t), lx = (mx - w.x) / w.s, ly = (my - w.y) / w.s;
          const e = EZ.sale(prog(t, p.tg, p.tg + VIAJE * 0.8)), esc = lerp(1, d.s, e);
          pon(gh[i], 'transform', `translate(${f2(lx - d.ox * esc - d.gw / 2)}px, ${f2(ly - d.oy * esc - d.gh / 2)}px) rotate(${f2(-2.2 * Math.sin(Math.PI * prog(t, p.tg, p.land)))}deg) scale(${esc.toFixed(4)})`);
        }
        pon(gh[i], 'opacity', f3(vis));
        const co = EZ.quart(prog(t, p.land + 0.02, p.land + 0.3));
        pon(chips[i], '--o', f3(co * (1 - sm(t, p.land + 1.5, p.land + 1.9))));
        pon(chips[i], '--y', f2((1 - co) * 8));
      });
      // las PIEZAS de la home: se asientan cuando cae la copia (fundido + subida corta, expo)
      for (const [nm, a] of Object.entries(PIEZA)) pon(pz[nm], '--p', f3(EZ.sale(prog(t, a, a + (nm === 'fondo' ? 0.9 : 0.55)))));
      pon(neety, '--esp', f3(EZ.sale(prog(t, ESP_T, ESP_T + 0.6))));
      pon(pz.esp, '--p', f3(blip(t, ESP_T - 0.05, 1.7)));
      const late = f3(0.5 - 0.5 * Math.cos((2 * Math.PI * t) / 2.4));
      pon(puntoLib, '--late', late);
      // la cinta de la réplica arranca cuando se asienta su tarjeta (en segundos reales: la película va al VEL de su guion)
      vpNH.__nh?.latir(+late);
      vpNH.__nh?.pintar((t - PIEZA.card) / VEL);
      vpNH.__nh?.marquesina(t / VEL);
      // RONDA 188 · Eric: «al final, un poco de scroll down sobre la web antes de que termine la animación; cubic-bezier smooth»: tras publicar,
      // la home baja 2.850 px (los de la tablet): clientes, «Por qué Neety», «De ruido a señal» y el arranque de «Neety por dentro»
      vpNH.__nh?.desplazar(reducido ? 0 : 2850 * BAJA(prog(t, PUB + 0.1, SUBE[0] - 0.05)));
    };

    // ── el reloj
    let t0 = 0, raf = 0, jugando = false, tPrev = -1, tQuieto = 0, quietoDesde = 0, buscado: number | null = null;
    const tAhora = () => ((((performance.now() - t0) / 1000) * VEL) % LOOP + LOOP) % LOOP;
    const tick = () => {
      raf = 0;
      if (!jugando || buscado !== null) return;
      const t = tAhora();
      if (tPrev >= 0 && ((t - tPrev + LOOP) % LOOP) < 0.25) sonar(tPrev, t);
      tPrev = t;
      pintar(t);
      raf = requestAnimationFrame(tick);
    };

    montar();
    pintar(0);
    const T_FIN = 12.45; // fotograma de reposo (movimiento reducido): la home montada y publicada
    const rehacer = () => { montar(); pintar(buscado ?? (jugando ? tAhora() : reducido ? T_FIN : 0)); };
    mqV.addEventListener('change', rehacer);
    let anchoPrevio = cine.clientWidth;
    new ResizeObserver(() => { if (Math.abs(cine.clientWidth - anchoPrevio) > 1) { anchoPrevio = cine.clientWidth; rehacer(); } }).observe(cine);
    document.fonts?.ready.then(rehacer);

    // sonda para las pruebas (BEAT = 1: los tiempos van en segundos)
    (window as any).__partitura = {
      LOOP, BEAT: 1,
      ir: (t: number) => { buscado = t; pintar(t); },
      seguir: () => { buscado = null; t0 = performance.now(); tPrev = -1; if (jugando && !raf) raf = requestAnimationFrame(tick); },
      t: () => (buscado ?? tAhora()),
    };

    if (reducido) { sec.classList.add('quieta'); pintar(T_FIN); return; }
    new IntersectionObserver((e) => {
      const ver = e[0].isIntersecting;
      if (ver && !jugando) {
        jugando = true;
        t0 = performance.now() - (performance.now() - quietoDesde > 2000 ? 0 : (tQuieto / VEL) * 1000);
        tPrev = -1;
        if (!raf) raf = requestAnimationFrame(tick);
      } else if (!ver && jugando) {
        jugando = false;
        tQuieto = tAhora();
        quietoDesde = performance.now();
      }
    }, { rootMargin: '0px 0px -12% 0px' }).observe(cine);
  }
</script>

<style>
  /* RONDA 292 · Eric: «arriba un poco menos de espacio»: la ilustración va seguida del grid (misma superficie), así que su aire de abajo es menor que el de una sección suelta */
  .cierre { padding-top: clamp(3rem, 2rem + 6lvh, 7rem); padding-bottom: clamp(6rem, 3rem + 10lvh, 12rem); } /* escritorio: más aire tras la ilustración (el móvil lo pisa abajo) */ /* y arriba lo mismo: «aquí un poco menos de espacio» */

  /* ronda 292 · móvil: menos aire entre el manifiesto y la ilustración, y bajo su pie */
  @media (width < 48rem) {
    .la-partitura .cine { margin-top: calc(var(--spacing) * 6); }
    .la-partitura .cierre { padding-bottom: calc(var(--spacing) * 8); }
  }
  @media (width >= 48rem) { .la-partitura .cine { margin-top: calc(var(--spacing) * 24); } } /* escritorio: más aire entre el manifiesto y la ilustración */
  .la-partitura { overflow-x: clip; }
  .cine {
    --tinta: var(--fg);
    --filo-reposo: color-mix(in oklab, var(--tinta) 26%, transparent);
    --ic-reposo: color-mix(in oklab, var(--tinta) 28%, transparent);
