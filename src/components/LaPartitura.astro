      outs = SALE.map((s, i) => nueva('out', i, s));
      cajas = [...ins, ...outs];
      const curvaH = (x0: number, y0: number, x1: number, y1: number, c0: number, c1: number) => [x0, y0, x0 + (x1 - x0) * c0, y0, x0 + (x1 - x0) * c1, y1, x1, y1];
