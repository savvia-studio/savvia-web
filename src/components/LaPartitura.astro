      } else pasos.forEach((p, i) => { if (p.ag === q) kf.push([p.at - 0.4, kf[kf.length - 1][1], Ln], ...paso(i), [p.at + 1.25, ESPERA[q], M]); });
      const ult = kf[kf.length - 1];
      kf.push([SUBE[0], ult[1], Ln], [SUBE[0] + 0.05, congela(ult[1], SUBE[0]), Ln], ...salida(q), [15.95, fuera[q], M]);
      return kf;
    });
    const CLICS: number[][] = [0, 1, 2, 3].map((q) => [
      EDIT.find((e) => e.ag === q)!.at, ABRE,
      ...pasos.filter((p) => p.ag === q).flatMap((p) => [p.at, p.at + 0.42]),
      ...(q === 3 ? [ENVIA, PUB] : []),
      ...CONS.filter((c) => c.ag === q).map((c) => c.A - 0.45),
    ]);
    const manoEn = (q: number, t: number) => {
      const kf = KF[q];
      let i = 0;
      while (i < kf.length - 2 && kf[i + 1][0] <= t) i++;
      const [a0, A0] = kf[i], [a1, A1, ez] = kf[i + 1];
      const p = ez(prog(t, a0, a1)), P0 = A0(t), P1 = A1(t);
      const arco = ez === Ln ? 0 : Math.sin(Math.PI * p) * -Math.min(40, Math.hypot(P1[0] - P0[0], P1[1] - P0[1]) * 0.12);
      return [lerp(P0[0], P1[0], p), lerp(P0[1], P1[1], p) + arco];
    };

    // ── EL SONIDO: de ordenador (r109). Las piezas que llegan se POSAN, las ediciones son clic y tecleo, la petición se teclea de verdad, cada
    // lectura y cada pieza puesta es un clic, enviar y publicar son la tecla grande, y al publicar suena un timbre suave. La música de la web sigue.
    type Son = [number, () => void];
    const SON: Son[] = [
      ...CASC.map((c) => [c.t, () => posar({ vol: 0.03 + (c.i % 3) * 0.006 })] as Son),
      ...EDIT.map((e) => [e.at, () => { clic({ vol: 0.04 }); teclear(3, { vol: 0.026, ritmo: 0.05 }); }] as Son),
      [ABRE, () => papel({ vol: 0.05, dur: 0.3 })],
      [PIDE[0], () => teclear(Math.round(PETICION.length / 2.6), { vol: 0.026, ritmo: 0.048 })],
      [ENVIA, () => tecla({ vol: 0.05, fuerte: true })],
      ...pasos.flatMap((p) => [[p.at, () => clic({ vol: 0.03 })], [p.at + 0.42, () => clic({ vol: 0.04 })]] as Son[]),
      [PUB, () => { tecla({ vol: 0.05, fuerte: true }); rhodesSuelto(84, 0.02, 1.4, 0.1, false); rhodesSuelto(91, 0.013, 1.6, 0.18, false); }],
      ...CONS.map((c) => [c.A + 0.15, () => clic({ vol: 0.025 })] as Son),
    ];
    const sonar = (t0: number, t1: number) => {
      for (const [ts, fn] of SON) if ((t1 >= t0 && ts > t0 && ts <= t1) || (t1 < t0 && (ts > t0 || ts <= t1))) fn();
    };

    // ── PINTAR el fotograma t (función pura del tiempo)
    const pintar = (t: number) => {
      const v = camara(t), K = k * v.S;
      pon(cam, '@transform', `translate(${f2(k * (W / 2 - v.S * v.cx))} ${f2(k * (H / 2 - v.S * v.cy))}) scale(${K.toFixed(5)})`);
      pon(cam, '--u', (1 / K).toFixed(5));
      const fin = sm(t, 15.4, 15.95);

      for (const r of cajas) {
        let ver = 1, dib = 1;
        if (r.lado === 'out') {
          const cn = CONS.find((x) => x.o === r.i)!, p0 = cn.A - 0.15;
          if (t >= 4.45 && t < p0) { ver = 0; dib = 0; }
          else if (t >= p0 && t < cn.A + 0.15) { dib = EZ.flujo(prog(t, p0, cn.A + 0.15)); ver = 0; }
          if (t >= cn.A + 0.15) ver = EZ.sale(prog(t, cn.A + 0.15, cn.A + 0.6));
        }
        pon(r.hilo, 'stroke-dasharray', dib >= 1 ? 'none' : `${f3(dib)} 2`);
        let act: Pulso | null = null;
        for (const p of PULSOS) if (p.lado === r.lado && p.i === r.i && t >= p.t0 && t <= p.t0 + p.d + 0.08) act = p;
        if (act) {
          const h = EZ.flujo(prog(t, act.t0, act.t0 + act.d)), seg = 0.18;
          pon(r.pulso, 'stroke', AG[act.ag]);
          pon(r.pulso, 'stroke-dasharray', `${f3(Math.min(seg, h))} 2`);
          pon(r.pulso, 'stroke-dashoffset', f3(-(h - Math.min(seg, h))));
          pon(r.pulso, 'opacity', f3(1 - prog(t, act.t0 + act.d, act.t0 + act.d + 0.08)));
          const [x, y] = bez(r.P, uDe(r.tabla, h));
          pon(r.cabeza, '@cx', f2(x));
          pon(r.cabeza, '@cy', f2(y));
          pon(r.cabeza, 'fill', AG[act.ag]);
          pon(r.cabeza, 'opacity', f3(Math.min(1, prog(t, act.t0, act.t0 + 0.06)) * (1 - prog(t, act.t0 + act.d - 0.04, act.t0 + act.d + 0.04))));
        } else {
          pon(r.pulso, 'opacity', '0');
          pon(r.cabeza, 'opacity', '0');
        }
        // la caja: se enciende con el color de quien la toca (cascada, edición, construcción) o queda seleccionada
        let luz = 0, ag = 0;
        const sube = (x: number, a: number) => { if (x > luz) { luz = x; ag = a; } };
        if (r.lado === 'in') {
          for (const q of CASC) if (q.i === r.i) sube(blip(t, q.t, 0.6) * 0.9, q.ag);
          for (const e of EDIT) if (e.i === r.i) sube(sm(t, e.at, e.at + 0.1) * (1 - sm(t, SEL_FIN, SEL_FIN + 0.3)), e.ag);
          for (const cn of CONS) if (cn.i === r.i) sube(blip(t, cn.A - 0.45, 0.7), cn.ag);
        } else {
          const cn = CONS.find((x) => x.o === r.i)!;
          sube(blip(t, cn.A + 0.15, 0.8), cn.ag);
          if (cn.o === 3) sube(sm(t, cn.A + 0.15, cn.A + 0.3) * (1 - fin), cn.ag);
        }
        pon(r.g, '--c', AG[ag]);
        pon(r.g, '--l', f3(luz));
        const pop = r.lado === 'out' ? lerp(0.9, 1, ver) : 1;
        pon(r.g, 'opacity', f3(ver));
        pon(r.g, '@transform', `translate(${f2(r.x + (r.w * (1 - pop)) / 2)} ${f2(r.y + (r.h * (1 - pop)) / 2)}) scale(${f3(pop)})`);
      }

      // la tarjeta: su filo se enciende con cada llegada y la fila que se indexa toma el color de quien la trae
      let fl = 0, fa = 0;
      const luzFila = filas.map(() => [0, 0]);
      for (const g of LLEGADAS) {
        const x = blip(t, g.t, 0.6);
        if (x > fl) { fl = x; fa = g.ag; }
        if (x > luzFila[g.fila][0]) luzFila[g.fila] = [x, g.ag];
      }
      filas.forEach((f, q) => {
        pon(f.bg, 'fill', AG[luzFila[q][1]]);
        pon(f.bg, 'opacity', f3(luzFila[q][0] * 0.16));
        pon(f.ic, 'fill', `color-mix(in oklab, ${AG[luzFila[q][1]]} ${Math.round(luzFila[q][0] * 100)}%, var(--ic-reposo))`);
      });
      pon(filo, 'stroke', `color-mix(in oklab, ${AG[fa]} ${Math.round(fl * 100)}%, var(--filo-reposo))`);
      pon(filo, '--g', f3(fl));
      pon(gPub, 'opacity', f3(sm(t, SUBE[1] - 0.2, SUBE[1] + 0.2) * (1 - fin)));
      const vT = 1 - clamp((Math.log(v.S) - Math.log(FOLD.S * 1.15)) / (Math.log(FOLD.S * 2.6) - Math.log(FOLD.S * 1.15)));
      pon(gTexto, 'opacity', f3(vT));

      // la app: nace del propio papel de la tarjeta según la cámara se acerca
      const wo = clamp((Math.log(v.S) - Math.log(8)) / (Math.log(24) - Math.log(8)));
      const w = ventanaEn(v);
      pon(win, 'visibility', wo > 0.001 ? 'visible' : 'hidden');
      pon(win, 'opacity', f3(EZ.fundido(wo)));
      if (wo > 0.001) {
        pon(win, 'transform', `translate(${f2(w.x * k)}px, ${f2(w.y * k)}px) scale(${(w.s * k).toFixed(5)})`);
        pintarApp(t);
      }

      curs.forEach((c, q) => {
        const [x, y] = manoEn(q, t);
        pon(c, 'transform', `translate3d(${f2(x * k)}px, ${f2(y * k)}px, 0)`);
        let cl = 0, on = 0;
        for (const tc of CLICS[q]) { cl = Math.max(cl, blip(t, tc, 0.35)); const p = prog(t, tc, tc + 0.5); if (p > 0 && p < 1) on = p; }
        pon(c, '--clic', f3(cl));
        pon(c, '--onda', f3(on));
      });
    };

    // ── RONDA 94 · LA CINTA (sf-card de la web real): cada tarjeta llega a su sitio con la cinta subiendo, nítida; la anterior se queda arriba al 28 %,
    // desenfocada y a ×0,95; llega en esqueleto, el esqueleto se funde en la cabecera y las filas entran escalonadas (suben 6 px y crecen desde ×0,97)
    const SF_A = [10.3, 11.05, 11.8], SF_VIAJE = 0.5;
    const pintarCinta = (t: number) => {
      const yF = rectLocal(feed).y, alto = feed.parentElement!.offsetHeight, ancla = alto * 0.2;
      const ys = sf.map((c) => rectLocal(c.e).y - yF);
      let y = ys[0] + (1 - EZ.flujo(prog(t, SF_A[0], SF_A[0] + SF_VIAJE))) * -alto * 0.55;
      for (let j = 1; j < sf.length; j++) y += (ys[j] - ys[j - 1]) * EZ.flujo(prog(t, SF_A[j], SF_A[j] + SF_VIAJE));
      pon(feed, 'transform', `translateY(${f2(ancla - y)}px)`);
      sf.forEach((c, j) => {
        const a = SF_A[j], sig = SF_A[j + 1] ?? 99;
        const v = EZ.fundido(prog(t, a, a + SF_VIAJE)) * (1 - EZ.fundido(prog(t, sig, sig + SF_VIAJE)));
        pon(c.e, 'opacity', f3(0.28 + 0.72 * v));
        pon(c.e, 'filter', v > 0.995 ? 'none' : `blur(${f2(5 * (1 - v))}px)`);
        pon(c.e, 'transform', `scale(${(0.95 + 0.05 * v).toFixed(4)})`);
        const h = sm(t, a + 0.3, a + 0.5);
        pon(c.skel, 'opacity', f3(1 - h));
        pon(c.head, 'opacity', f3(h));
        const f0 = a + (c.pop ? 0.65 : 0.42), pasoF = c.pop ? 0.17 : 0.13;
        c.filas.forEach((e, i) => pon(e, '--p', f3(EZ.sale(prog(t, f0 + i * pasoF, f0 + i * pasoF + 0.3)))));
        if (c.pop) pon(c.pop, '--p', f3(EZ.sale(prog(t, a + 0.5, a + 0.75))));
        if (c.hl) pon(c.hl, 'opacity', f3(sm(t, a + 0.95, a + 1.15)));
      });
    };

    const pintarApp = (t: number) => {
      // la PETICIÓN: aparece, se teclea, se envía y se recoge
      const ca = EZ.quart(prog(t, 4.15, 4.6)), col = EZ.sale(prog(t, ENVIA + 0.03, ENVIA + 0.5));
      const n = Math.round(prog(t, PIDE[0], PIDE[1]) * PETICION.length);
      pon(escrito, '#', PETICION.slice(0, n));
      pon(caret, 'opacity', t < ENVIA && (Math.floor(t * 2.4) % 2 === 0 || (t > PIDE[0] && t < PIDE[1])) ? '1' : '0');
      pon(composer, 'opacity', f3(ca * (1 - col)));
      pon(composer, 'transform', `translateY(${f2((1 - ca) * 24 + col * 150)}px) scale(${f3(1 - col * 0.18)})`);
      pon(enviar, '--l', f3(n >= PETICION.length ? 1 : 0));
      pon(enviar, '--clic', f3(blip(t, ENVIA, 0.3)));
      pon(neety, '--vacio', f3(1 - sm(t, PIEZA.fondo, PIEZA.fondo + 0.6)));
      // el ESTADO: qué está pasando (quién lee qué), y al final, publicado
      pon(estado, 'opacity', f3(sm(t, ENVIA + 0.3, ENVIA + 0.55)));
      pon(estado, 'transform', `translateY(${f2((1 - EZ.sale(prog(t, ENVIA + 0.3, ENVIA + 0.7))) * 16)}px)`);
      let iAct = -1;
      pasos.forEach((p, i) => { if (t >= p.at - 0.3) iAct = i; });
      const pub = t >= PUB + 0.12;
      pon(estadoTxt, '#', pub ? ESTADO[1] : iAct < 0 || t > pasos[pasos.length - 1].at + 1.2 ? (iAct < 0 ? ESTADO[0] : ESTADO[2]) : `${NOMBRES[pasos[iAct].ag]} lee ${pasos[iAct].f}`);
      pon(estado, '--pub', pub ? '1' : '0');
      pon(estado, '--late', f3(0.5 - 0.5 * Math.cos(2 * Math.PI * t * 0.9)));
      pon(publicar, '--l', f3(sm(t, PUB - 0.4, PUB - 0.15)));
      pon(publicar, '--clic', f3(blip(t, PUB, 0.35)));
      pon(neety, '--pub', f3(prog(t, PUB + 0.05, PUB + 0.85)));
      // el LECTOR: el archivo que lee el agente activo, con su línea resaltada; el árbol marca el archivo
      const fAct = iAct >= 0 ? pasos[iAct].f : '', fAnt = iAct > 0 ? pasos[iAct - 1].f : '';
      const entra = iAct >= 0 ? sm(t, pasos[iAct].at - 0.3, pasos[iAct].at - 0.12) : 0;
      for (const f in archivos) pon(archivos[f], '--o', f3(f === fAct ? entra : f === fAnt ? 1 - entra : 0));
      pon(vacio, 'opacity', f3(iAct < 0 ? 1 : iAct === 0 ? 1 - entra : 0));
      for (const f in arch) {
        let l = 0, c = 0;
        pasos.forEach((p) => { if (p.f === f) { const x = sm(t, p.at - 0.3, p.at - 0.1) * (1 - sm(t, p.at + 0.7, p.at + 1.0)); if (x > l) { l = x; c = p.ag; } } });
        pon(arch[f], '--l', f3(l));
        pon(arch[f], '--c', AG[c]);
      }
      pasos.forEach((p, i) => {
        const li = lineaDe(p.f, p.ln);
        pon(li, '--h', f3(sm(t, p.at - 0.12, p.at + 0.1)));
        pon(li, '--c', AG[p.ag]);
        // la GUÍA: se traza de la línea a la pieza, y se va
        const dib = EZ.sale(prog(t, p.at + 0.05, p.at + 0.45)), o = sm(t, p.at, p.at + 0.08) * (1 - sm(t, p.at + 0.8, p.at + 1.05));
        const g = guias[i];
        if (g) {
          pon(g.p, 'stroke-dashoffset', f3(1 - dib));
          pon(g.p, 'opacity', f3(o));
          pon(g.a, 'opacity', f3(o));
          pon(g.b, 'opacity', f3(o * prog(dib, 0.85, 1)));
          pon(g.b, '@r', f2(2 + 3 * blip(t, p.at + 0.42, 0.4) + 2));
        }
        // el CHIP: el token, junto a la pieza; se queda (más callado) hasta publicar
        const co = EZ.quart(prog(t, p.at + 0.38, p.at + 0.62));
        pon(chips[i], '--o', f3(co * lerp(1, modo === 'v' ? 0 : 0.62, sm(t, p.at + 1.3, p.at + 1.6)) * (1 - sm(t, PUB - 0.1, PUB + 0.3))));
        pon(chips[i], '--y', f2((1 - co) * 8));
      });
      // las PIEZAS de la página: entran con su token (fundido + subida corta, expo)
      for (const [nm, a] of Object.entries(PIEZA)) pon(pz[nm], '--p', f3(EZ.sale(prog(t, a, a + (nm === 'fondo' ? 0.9 : 0.55)))));
      pon(punto, '--late', f3(0.5 - 0.5 * Math.cos((2 * Math.PI * t) / 2.4)));
      pintarCinta(t);
    };

    // ── el reloj
    let t0 = 0, raf = 0, jugando = false, tPrev = -1, tQuieto = 0, quietoDesde = 0, buscado: number | null = null;
    const tAhora = () => (((performance.now() - t0) / 1000) % LOOP + LOOP) % LOOP;
    const tick = () => {
      raf = 0;
      if (!jugando || buscado !== null) return;
      const t = tAhora();
      if (tPrev >= 0 && ((t - tPrev + LOOP) % LOOP) < 0.25) sonar(tPrev, t);
      tPrev = t;
      pintar(t);
      raf = requestAnimationFrame(tick);
    };

    montar();
    pintar(0);
    const rehacer = () => { montar(); pintar(buscado ?? (jugando ? tAhora() : 0)); };
    mqV.addEventListener('change', rehacer);
    let anchoPrevio = cine.clientWidth;
    new ResizeObserver(() => { if (Math.abs(cine.clientWidth - anchoPrevio) > 1) { anchoPrevio = cine.clientWidth; rehacer(); } }).observe(cine);
    document.fonts?.ready.then(rehacer);

    // sonda para las pruebas (BEAT = 1: los tiempos van en segundos)
    (window as any).__partitura = {
      LOOP, BEAT: 1,
      ir: (t: number) => { buscado = t; pintar(t); },
      seguir: () => { buscado = null; t0 = performance.now(); tPrev = -1; if (jugando && !raf) raf = requestAnimationFrame(tick); },
      t: () => (buscado ?? tAhora()),
    };

    if (reducido) { sec.classList.add('quieta'); return; }
    new IntersectionObserver((e) => {
      const ver = e[0].isIntersecting;
      if (ver && !jugando) {
        jugando = true;
        t0 = performance.now() - (performance.now() - quietoDesde > 2000 ? 0 : tQuieto * 1000);
        tPrev = -1;
        if (!raf) raf = requestAnimationFrame(tick);
      } else if (!ver && jugando) {
        jugando = false;
        tQuieto = tAhora();
        quietoDesde = performance.now();
      }
    }, { rootMargin: '0px 0px -12% 0px' }).observe(cine);
  }
</script>

<style>
  .la-partitura { overflow-x: clip; }
  .cine {
    --tinta: var(--fg);
    --filo-reposo: color-mix(in oklab, var(--tinta) 26%, transparent);
    --ic-reposo: color-mix(in oklab, var(--tinta) 28%, transparent);
    --hoja-papel: color-mix(in oklab, var(--color-niebla) 45%, #fff);
    position: relative;
    margin-top: calc(var(--spacing) * 16);
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    contain: layout paint;
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent), linear-gradient(transparent, #000 5%, #000 95%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent), linear-gradient(transparent, #000 5%, #000 95%, transparent);
    mask-composite: intersect;
  }
  :global(html[data-paleta='clara']) .cine { --hoja-papel: #fbfbfa; }
  .cine.v { aspect-ratio: 5 / 7; }
  .mapa { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .mapa :global(.hilo) { fill: none; stroke: color-mix(in oklab, var(--tinta) 26%, transparent); stroke-width: calc(var(--u) * 1px); }
  .mapa :global(.pulso) { fill: none; stroke-width: calc(var(--u) * 2px); stroke-linecap: round; }
  .mapa :global(.caja rect) {
    fill: color-mix(in oklab, var(--c) calc(var(--l, 0) * 12%), var(--hoja-papel));
    stroke: color-mix(in oklab, var(--c) calc(var(--l, 0) * 100%), color-mix(in oklab, var(--tinta) 16%, transparent));
    stroke-width: calc(var(--u) * (1px + var(--l, 0) * 0.6px));
  }
  .mapa :global(.rot) { font-family: var(--font-sans); font-size: 15px; fill: var(--tinta); }
  /* LA TARJETA de la librería (fuera): papel, barra con su ruta, título y las filas de su árbol */
  .mapa :global(.papel) { fill: var(--hoja-papel); }
  .mapa :global(.filo) { fill: none; stroke-width: calc(var(--u) * (1.2px + var(--g, 0) * 1.3px)); }
  .mapa :global(.sem) { fill: color-mix(in oklab, var(--tinta) 22%, transparent); }
  .mapa :global(.ruta-t) { font-family: var(--font-mono); font-size: 5.6px; fill: color-mix(in oklab, var(--tinta) 60%, transparent); }
  .mapa :global(.raya) { stroke: color-mix(in oklab, var(--tinta) 12%, transparent); stroke-width: calc(var(--u) * 1px); }
  .mapa :global(.titulo) { font-family: var(--font-display); font-size: 14px; fill: var(--tinta); }
  .mapa :global(.fila-n) { font-family: var(--font-mono); font-size: 6.2px; fill: color-mix(in oklab, var(--tinta) 82%, transparent); }
  .mapa :global(.fila-m) { font-family: var(--font-mono); font-size: 5.4px; fill: color-mix(in oklab, var(--tinta) 50%, transparent); }
  .mapa :global(.pub rect) { fill: var(--tinta); }
  .mapa :global(.pub text) { font-family: var(--font-mono); font-size: 5.4px; fill: var(--hoja-papel); }

  /* LA LIBRERÍA POR DENTRO: la app. Escritorio 1360 × 720, en px de diseño; la cámara la escala. Árbol y lector a la izquierda; la home de Neety, el resto */
  .app {
    position: absolute;
    left: 0;
    top: 0;
    width: 1360px;
    height: 720px;
    transform-origin: 0 0;
    visibility: hidden;
    display: grid;
    grid-template-columns: 340px 1fr;
    grid-template-rows: 44px 1fr;
    grid-template-areas: 'barra barra' 'lib lienzo';
    border-radius: 12px;
    overflow: hidden;
    background: var(--hoja-papel) url('/media/grano.png') 0 0 / 240px 240px;
    color: var(--tinta);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--tinta) 10%, transparent), 0 40px 80px -44px rgb(36 28 25 / 0.4);
