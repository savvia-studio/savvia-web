        kf.push([PIDE[1], ESPERA[3], Ln], [ENVIA - 0.05, Vp(enviar, 0.5, 0.55), M], [ENVIA + 0.3, Vp(enviar, 0.5, 0.55), Ln], [6.9, aparte, M],
