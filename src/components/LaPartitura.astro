  .mapa :global(.rot) { font-family: var(--font-sans); font-size: 13px; fill: var(--tinta); }
  .mapa :global(.cms) { font-family: var(--font-mono); font-size: 11px; fill: color-mix(in oklab, var(--tinta) 55%, transparent); opacity: 0; }
  /* LA TARJETA de la librería (fuera): papel, barra con su ruta, título y las filas de su árbol */
  .mapa :global(.papel) { fill: var(--hoja-papel); }
