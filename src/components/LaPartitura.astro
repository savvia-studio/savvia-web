<section id="la-savvia" class="surface-light la-partitura relative" aria-labelledby="partitura-h" data-partitura data-sube>
  <div class="wrap section-y">
    <h2 id="partitura-h" class="text-h1 max-w-[14ch]" data-entra>{receta.titulo}</h2>
    <p class="text-sub mt-6 lg:mt-8 max-w-[34ch] text-fg2" data-enfoca>{receta.arnes}</p>

    <div
      class="cine"
      data-cine
      data-entra-p={JSON.stringify(P.entra)}
      data-sale-p={JSON.stringify(P.sale)}
      data-titulo-p={JSON.stringify(L.titulo)}
      data-resumen-p={JSON.stringify(P.resumen)}
      data-pasos-p={JSON.stringify(L.pasos)}
      data-estado-p={JSON.stringify(L.estado)}
      data-peticion-p={JSON.stringify(L.peticion)}
      role="img"
      aria-label="Película en bucle: lo que entra en una web (estrategia, voz, identidad, componentes…) se guarda en la librería de Neety. Su equipo pide un hero nuevo; Claude, Codex y Diseño leen los archivos de la librería (el degradado, el logotipo, la tipografía, la voz, los botones y las etiquetas) y la home de Neety se monta con esos mismos tokens. Al publicar en neety.com, de la misma librería salen webs, landings, productos, campañas, emails y redes."
    >
      <svg class="mapa" aria-hidden="true" data-mapa></svg>

      <!-- LA LIBRERÍA POR DENTRO: la app (escritorio 1360 × 720; móvil 540 × 760), escalada por la cámara -->
      <div class="app" aria-hidden="true" data-ventana>
        <div class="barra">
          <span class="semaforo"><i></i><i></i><i></i></span>
          <span class="ruta">{L.ruta}</span>
          <span class="presencia">{P.agentes.slice(0, 3).map(([n, c]) => <i style={`--c: var(--color-${c})`}>{n.slice(0, 2)}</i>)}</span>
          <span class="publicar" data-publicar>{L.publicar}</span>
        </div>
        <div class="lib">
          <p class="lib-tit">{L.titulo}</p>
          <ul class="arbol">
            {L.arbol.map(([dir, fs]) => (
              <Fragment>
                <li class="dir"><i class="ic-dir"></i>{dir}/</li>
                {fs.map((f) => <li class="arch" data-arch={f}><i class="ic-arch"></i>{f}</li>)}
              </Fragment>
            ))}
          </ul>
          <div class="lector">
            <p class="lector-vacio" data-vacio>Sin archivo abierto</p>
            {Object.entries(L.archivos).map(([f, ls]) => (
              <div class="archivo" data-archivo={f}>
                <p class="pestana"><i></i>{rutaDe(f)}</p>
                <ol class="codigo">{ls.map((l) => <li data-linea><span>{l}</span></li>)}</ol>
              </div>
            ))}
          </div>
        </div>
        <div class="lienzo" data-lienzo>
          <!-- la home de Neety (sus colores, Bricolage Grotesque y su copy), que se monta con lo que leen los agentes -->
          <div class="neety" data-neety>
            <span class="n-fondo" data-pz="fondo"></span>
            <span class="n-nav" data-pz="nav">
              <svg class="n-logo" viewBox="0 0 130 32" aria-hidden="true"><g fill="#2A0E2C">{NEETY.map((d) => <path d={d} />)}</g></svg>
              <span class="n-menu">{L.hero.nav.map((x) => <i>{x}</i>)}</span>
              <span class="n-navcta">{L.hero.ctas[0]}</span>
            </span>
            <span class="n-eyebrow" data-pz="eyebrow"><i class="n-punto"></i>{L.hero.eyebrow.map((x, j) => <b class={j === 2 ? 'on' : ''}>{x}</b>)}</span>
            <p class="n-h1" data-pz="h1">{L.hero.h1} <span class="b">{L.hero.h1b}</span></p>
            <span class="n-ctas" data-pz="ctas"><span class="n-pill">{L.hero.ctas[0]}<i></i></span><span class="n-link">{L.hero.ctas[1]}</span></span>
            <span class="n-card" data-pz="card">
              <span class="n-feed" data-feed>
                {FEED.map((c) => (
                  <span class={`sf sf-${c.tipo}`} data-sf>
                    <span class="sf-cuerpo">
                      <span class="sf-skel" data-skel>
                        <span class="sk-head"><i></i><b></b></span>
                        {c.filas.map(() => <span class="sk-fila"><i></i><b></b><em></em></span>)}
                      </span>
                      <span class="sf-head" data-head>
                        <span class="sf-ic">{c.tipo === 'jon' ? 'J' : <svg viewBox="0 0 256 256" aria-hidden="true"><path d="M136,32V216H40V85.35a8,8,0,0,1,3.56-6.66l80-53.33A8,8,0,0,1,136,32Z" opacity="0.2" /><path d="M240,208H224V96a16,16,0,0,0-16-16H144V32a16,16,0,0,0-24.88-13.32L39.12,72A16,16,0,0,0,32,85.34V208H16a8,8,0,0,0,0,16H240a8,8,0,0,0,0-16ZM208,96V208H144V96ZM48,85.34,128,32V208H48Z" /></svg>}</span>
                        <b>{c.titulo}</b>
                        {c.tipo === 'jon' && <span class="sf-pop" data-pop>Templado</span>}
                      </span>
                      {c.filas.map((f: any) => c.tipo === 'jon'
                        ? <span class="sf-act" data-fila><i></i>{f.n}</span>
                        : <span class="sf-fila" data-fila>
                            {c.tipo === 'empresas' ? <i class="lg" style={`--lc: ${f.c}`}></i> : <i class="av" style={`--lc: ${f.c}`}>{f.n.split(' ').map((x: string) => x[0]).join('')}</i>}
                            {c.tipo === 'empresas' ? <span class="nm">{f.n}</span> : <span class="nm">{f.n}<small>{f.r}</small></span>}
                            <em>{f.v}%</em>
                          </span>)}
                      {c.tipo === 'personas' && <span class="sf-hl" data-hl></span>}
                    </span>
                  </span>
                ))}
              </span>
            </span>
            <p class="n-sub" data-pz="sub">{L.hero.sub}</p>
          </div>
          <!-- la PETICIÓN de Tu equipo: se teclea en vivo, se envía y se recoge en la píldora de estado -->
          <div class="composer" data-composer>
            <span class="quien"><i></i>{L.quien}</span>
            <p class="campo"><span data-escrito></span><i class="caret" data-caret></i></p>
            <span class="enviar" data-enviar><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg></span>
          </div>
          <div class="estado" data-estado><i class="punto"></i><svg class="ok" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" /></svg><span data-estado-txt>{L.estado[0]}</span></div>
        </div>
        <!-- las GUÍAS (línea del lector → pieza) y los CHIPS (el token que usa cada pieza) -->
        <svg class="guias" data-guias></svg>
        {L.pasos.map((p) => <span class="chip" style={`--c: var(--color-${P.agentes[p.ag][1]})`} data-chip>{p.chip}</span>)}
      </div>

      {P.agentes.map(([n, c]) => (
        <div class="cursor" style={`--c: var(--color-${c})`} aria-hidden="true" data-agente>
          <i class="onda"></i>
          <svg viewBox="0 0 16 16"><path d="M2 1.5 L14 7 L8.4 8.4 L6.2 14 Z" /></svg>
          <span>{n}</span>
        </div>
      ))}
    </div>

    <p class="nota detail text-fg2" data-enfoca>{P.nota} <a class="link" href={P.enlace.href} target="_blank" rel="noopener">{P.enlace.label}</a></p>
  </div>
</section>

<script>
  import { rhodesSuelto } from '../scripts/jazz';
  import { tecla, clic, teclear, papel, posar } from '../scripts/musica';

  const sec = document.querySelector<HTMLElement>('[data-partitura]');
  if (sec) iniciar(sec);

  function iniciar(sec: HTMLElement) {
    const cine = sec.querySelector<HTMLElement>('[data-cine]')!;
    const svg = sec.querySelector<SVGSVGElement>('[data-mapa]')!;
    const win = sec.querySelector<HTMLElement>('[data-ventana]')!;
    const curs = [...sec.querySelectorAll<HTMLElement>('[data-agente]')];
    const ENTRA: string[] = JSON.parse(cine.dataset.entraP!), SALE: string[] = JSON.parse(cine.dataset.saleP!), TIT: string = JSON.parse(cine.dataset.tituloP!);
    const RES: [string, string][] = JSON.parse(cine.dataset.resumenP!);
    const PASOS: { ag: number; f: string; ln: number; piezas: string[]; chip: string }[] = JSON.parse(cine.dataset.pasosP!);
    const ESTADO: string[] = JSON.parse(cine.dataset.estadoP!), PETICION: string = JSON.parse(cine.dataset.peticionP!);
    const NOMBRES = curs.map((c) => c.querySelector('span')!.textContent!);
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NS = 'http://www.w3.org/2000/svg';

    // ── el TIEMPO, en segundos: bucle de 16 s
    const LOOP = 16;
    const curva = (x1: number, y1: number, x2: number, y2: number) => {
      const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx, cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
      const X = (u: number) => ((ax * u + bx) * u + cx) * u, Y = (u: number) => ((ay * u + by) * u + cy) * u;
      return (x: number) => {
        if (x <= 0) return 0;
        if (x >= 1) return 1;
        let lo = 0, hi = 1, u = x;
        for (let i = 0; i < 22; i++) { const v = X(u); if (Math.abs(v - x) < 1e-5) break; if (v < x) lo = u; else hi = u; u = (lo + hi) / 2; }
        return Y(u);
      };
    };
    const EZ = {
      lin: (x: number) => x,
      fundido: curva(0.5, 0, 0.5, 1),
      sube: curva(0, 0, 0.2, 1),
      sale: curva(0.16, 1, 0.3, 1), // expo out
      quart: curva(0.25, 1, 0.5, 1), // quart out
      flujo: curva(0.6, 0, 0.4, 1),
      mano: curva(0.42, 0, 0.24, 1),
      deriva: curva(0.3, 0, 0.7, 1),
      camara: curva(0.6, 0, 0.25, 1),
      zambullida: curva(0.72, 0, 0.17, 1),
      subida: curva(0.56, 0, 0.2, 1),
    };
    const clamp = (v: number, a = 0, c = 1) => Math.min(c, Math.max(a, v));
    const prog = (t: number, a: number, c: number) => clamp((t - a) / (c - a));
    const lerp = (a: number, c: number, p: number) => a + (c - a) * p;
    const sm = (t: number, a: number, c: number) => EZ.fundido(prog(t, a, c));
    const blip = (t: number, t0: number, d: number) => {
      const p = prog(t, t0, t0 + d);
      return p <= 0 || p >= 1 ? 0 : p < 0.25 ? EZ.sube(p / 0.25) : 1 - EZ.fundido((p - 0.25) / 0.75);
    };

    const AG = ['coral', 'cobalto', 'cereza', 'nogal'].map((c) => `var(--color-${c})`);

    const ult = new WeakMap<Element, Record<string, string>>();
    const pon = (e: Element, k: string, v: string) => {
      let m = ult.get(e);
      if (!m) ult.set(e, (m = {}));
      if (m[k] === v) return;
      m[k] = v;
      if (k[0] === '@') e.setAttribute(k.slice(1), v);
      else if (k === '#') e.textContent = v;
      else (e as HTMLElement).style.setProperty(k, v);
    };
    const f3 = (n: number) => n.toFixed(3), f2 = (n: number) => n.toFixed(2);
    const el = <K extends keyof SVGElementTagNameMap>(tag: K, at: Record<string, string | number>, padre: Element) => {
      const e = document.createElementNS(NS, tag);
      for (const k in at) e.setAttribute(k, String(at[k]));
      padre.appendChild(e);
      return e;
    };

    // ── GUION (segundos)
    // fuera: lo que entra llega a la librería y se indexa; los agentes editan cuatro entradas; la cámara se acerca a la tarjeta y entra
    const CASC = ENTRA.map((_, i) => ({ i, t: 0.2 + 0.15 * i, ag: i % 4 }));
    const EDIT = [{ ag: 0, i: 2, at: 2.55 }, { ag: 1, i: 5, at: 2.7 }, { ag: 2, i: 4, at: 2.85 }, { ag: 3, i: 0, at: 3.0 }];
    const ABRE = 3.75, SEL_FIN = 3.35, SUBE = [12.6, 13.5];
    // dentro: la petición (se teclea y se envía), los PASOS (cada agente lee una línea de la librería y monta su pieza) y publicar
    const PIDE = [4.65, 5.9], ENVIA = 6.05, PUB = 11.95;
    const PASO_T = [6.6, 7.2, 7.8, 8.5, 9.2, 9.9];
    const pasos = PASOS.map((p, i) => ({ ...p, at: PASO_T[i] }));
    const PIEZA: Record<string, number> = {};
    pasos.forEach((p) => p.piezas.forEach((n, j) => { PIEZA[n] = p.at + 0.42 + j * 0.3; }));
    // lo que se publica: cada salida se construye con una entrada que la librería ya tiene
    const CONS = [
      { o: 0, i: 1, ag: 0 }, { o: 1, i: 5, ag: 2 }, { o: 2, i: 7, ag: 1 }, { o: 3, i: 4, ag: 3 }, { o: 4, i: 2, ag: 0 }, { o: 5, i: 3, ag: 2 },
    ].map((c, j) => ({ ...c, A: 13.7 + 0.3 * j }));

    type Pulso = { lado: 'in' | 'out'; i: number; t0: number; d: number; ag: number };
    const PULSOS: Pulso[] = [
      ...CASC.map((c) => ({ lado: 'in' as const, i: c.i, t0: c.t + 0.02, d: 0.5, ag: c.ag })),
      ...EDIT.map((e) => ({ lado: 'in' as const, i: e.i, t0: e.at + 0.03, d: 0.55, ag: e.ag })),
      ...CONS.flatMap((c) => [
