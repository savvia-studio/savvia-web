  /* LA LIBRERÍA POR DENTRO (r118): la librería REAL de Neety (Base cálida, Berenjena, Bricolage + Switzer) en miniatura a la izquierda y su home a la derecha.
     Escritorio 1360 × 720, en px de diseño; la cámara la escala. Los elementos que se cogen llevan `.pk` (anillo y elevación por variables del reloj) */
  .app {
    --b: #431b44;
    --b2: color-mix(in oklab, #431b44 62%, transparent);
    --linea: rgb(67 27 68 / 0.1);
    position: absolute;
    left: 0;
    top: 0;
    width: 1360px;
    height: 720px;
    transform-origin: 0 0;
    visibility: hidden;
    display: grid;
    grid-template-columns: 196px 560px 1fr;
    grid-template-rows: 44px 1fr;
    grid-template-areas: 'barra barra barra' 'indice libmain lienzo';
    border-radius: 12px;
    overflow: hidden;
    background: #f8f7ec;
    color: var(--b);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--tinta) 10%, transparent), 0 40px 80px -44px rgb(36 28 25 / 0.4);
    font-family: var(--font-switzer), var(--font-sans), system-ui, sans-serif;
  }
  .barra { grid-area: barra; display: flex; align-items: center; gap: 16px; padding: 0 14px 0 18px; border-bottom: 1px solid var(--linea); }
  .semaforo { display: flex; gap: 7px; }
  .semaforo i { width: 11px; height: 11px; border-radius: 50%; background: rgb(67 27 68 / 0.14); }
  .barra .ruta { font-family: var(--font-mono); font-size: 12.5px; letter-spacing: 0.04em; color: var(--b2); }
  .presencia { margin-left: auto; display: flex; }
  .presencia i { display: grid; place-items: center; width: 24px; height: 24px; margin-left: -6px; border-radius: 50%; background: var(--c); color: #fff; font-style: normal; font-size: 9.5px; font-weight: 600; box-shadow: 0 0 0 2px #f8f7ec; }
  .publicar {
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--b);
    color: #f8f7ec;
    font-size: 13px;
    font-weight: 500;
    box-shadow: 0 0 0 calc(var(--l, 0) * 4px) color-mix(in oklab, var(--color-coral) 35%, transparent);
    scale: calc(1 - var(--clic, 0) * 0.08);
  }
  /* el ÍNDICE lateral: grupos en mono mayúsculas y, en el apartado que se mira, el punto naranja */
  .indice { grid-area: indice; padding: 16px 8px 0 22px; overflow: hidden; border-right: 1px solid var(--linea); }
  .ind-g { margin-top: 13px; padding-left: 14px; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(67 27 68 / 0.5); }
  .ind-g:first-child { margin-top: 0; }
  .indice ul { margin-top: 5px; }
  .indice li { position: relative; padding: 2.5px 0 2.5px 14px; font-size: 12.5px; line-height: 1.22; color: rgb(67 27 68 / 0.72); }
  .indice li[data-s] { color: color-mix(in oklab, #431b44 calc(72% + var(--on, 0) * 28%), transparent); font-weight: calc(400 + var(--on, 0) * 100); }
  .indice li[data-s]::before { content: ''; position: absolute; left: -2px; top: 50%; width: 5px; height: 5px; margin-top: -2.5px; border-radius: 50%; background: #fe8238; opacity: var(--on, 0); scale: calc(0.4 + var(--on, 0) * 0.6); }
  .tabs-v { display: none; }
  /* la columna principal: las secciones se recorren con el reloj (translateY del `.scroller`) */
  .libmain { grid-area: libmain; position: relative; overflow: hidden; min-height: 0; }
  .scroller { position: relative; will-change: transform; padding-bottom: 260px; }
  .sec { position: relative; min-height: 596px; padding: 26px 28px 0; }
  .eb { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.07em; text-transform: uppercase; color: rgb(67 27 68 / 0.55); }
  .tt { margin-top: 6px; font-family: var(--font-bricolage), system-ui, sans-serif; font-weight: 500; font-size: 35px; line-height: 1.1; letter-spacing: -0.012em; }
  .tx { margin-top: 10px; max-width: 46ch; font-size: 13.5px; line-height: 1.5; color: rgb(67 27 68 / 0.66); }
  .tx b { font-weight: 600; color: var(--b); }
  .et { margin-top: 20px; font-size: 11.5px; font-weight: 600; letter-spacing: 0.03em; text-transform: uppercase; color: rgb(67 27 68 / 0.7); }
  .et2 { margin-top: 18px; }
  .pk {
    outline: calc(var(--pk, 0) * 2.5px) solid color-mix(in oklab, var(--c, #fe8238) calc(var(--pk, 0) * 100%), transparent);
    outline-offset: 2px;
    translate: 0 calc(var(--lift, 0) * -4px);
    opacity: calc(1 - var(--dim, 0) * 0.5);
  }
  /* Color */
  .swatches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 10px; }
  .sw { display: flex; flex-direction: column; border-radius: 8px; background: #fff; box-shadow: 0 0 0 1px var(--linea); overflow: hidden; }
  .sw .blk { display: block; height: 58px; box-shadow: inset 0 -1px 0 var(--linea); }
  /* ronda 152 · «cogemos un color sólido y se pone el degradado: hay que corregirlo»: la muestra que se coge ES el degradado del hero, con su grano */
  /* RONDA 188 · Eric: «el degradado de la librería, "degradado granular", y que sea el que ponemos luego»: la MISMA imagen horneada del hero (la de tablet,
     la que cae en la home), recortada a la muestra */
  .sw .blk.grad { background: url('/media/neety-hero/hero-bg-muestra.webp') 50% 62% / cover no-repeat; }
  .sw .nm { padding: 7px 9px 0; font-size: 12.5px; font-weight: 500; line-height: 1.15; }
  .sw .hx { padding: 3px 9px 8px; font-family: var(--font-mono); font-size: 9.5px; color: rgb(67 27 68 / 0.5); }
  .rampas { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 8px; }
  .rampa { display: flex; border-radius: 6px; background: #fff; box-shadow: 0 0 0 1px var(--linea); overflow: hidden; }
  .rampa i { flex: 1; height: 38px; position: relative; }
  .rampa small { position: absolute; left: 0; right: 0; bottom: 3px; text-align: center; font-family: var(--font-mono); font-size: 8px; color: rgb(67 27 68 / 0.5); }
  /* Tipografía */
  .tps { display: flex; flex-direction: column; gap: 14px; margin-top: 12px; }
  .tp { display: block; width: fit-content; padding-right: 8px; }
  .tp b { display: block; font-family: var(--font-bricolage), system-ui, sans-serif; font-weight: 600; letter-spacing: -0.01em; line-height: 1.18; }
  .tp small { display: block; margin-top: 3px; font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.02em; color: rgb(67 27 68 / 0.45); }
  .tp-xl b { font-size: 64px; } .tp-l b { font-size: 48px; } .tp-m b { font-size: 37px; } .tp-h2 b { font-size: 28px; }
  /* Botones: la pastilla REAL de Neety (label + punto), también la usa la home */
  .pill { display: inline-flex; align-items: center; gap: 22px; padding: 12px 18px 12px 24px; border-radius: 999px; background: var(--b); color: #fff; font-family: var(--font-bricolage), system-ui, sans-serif; font-weight: 500; font-size: 16px; white-space: nowrap; }
  .pill i { width: 7px; height: 7px; border-radius: 50%; background: #fff; }
  .pill.outline { background: #fff; color: var(--b); box-shadow: inset 0 0 0 1px var(--linea); }
  .pill.outline i { background: var(--b); }
  .pill.block { display: flex; justify-content: center; width: 100%; }
  .btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 18px; }
  .bt-card { display: flex; flex-direction: column; gap: 14px; padding: 14px 14px 16px; border-radius: 10px; background: #fff; box-shadow: 0 0 0 1px var(--linea); }
  .bt-card small { font-family: var(--font-mono); font-size: 9.5px; color: rgb(67 27 68 / 0.55); }
  .bt-card .pill { align-self: flex-start; }
  .bt-card .pill.block { align-self: stretch; }
  /* Espaciado: la escala de tokens con sus barras naranjas */
  .esps { display: flex; flex-direction: column; gap: 3px; margin-top: 16px; padding: 12px 14px; border-radius: 10px; background: #fff; box-shadow: 0 0 0 1px var(--linea); }
  .sp-row { display: grid; grid-template-columns: 54px 1fr 58px; align-items: center; gap: 12px; height: 23px; border-radius: 5px; }
  .sp-row b { font-family: var(--font-mono); font-size: 10.5px; font-weight: 400; color: rgb(67 27 68 / 0.7); }
  .sp-row i { display: block; height: 100%; display: flex; align-items: center; }
  .sp-row u { display: block; height: 9px; border-radius: 2px; background: color-mix(in oklab, #fe8238 62%, #fff); }
  .sp-row small { text-align: right; font-family: var(--font-mono); font-size: 9.5px; color: rgb(67 27 68 / 0.5); }
  /* Componentes de la web */
  .tabs-c { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
  .tabs-c span { display: inline-flex; align-items: center; gap: 6px; padding: 5px 11px; border-radius: 999px; background: #fff; box-shadow: 0 0 0 1px var(--linea); font-size: 11.5px; }
  .tabs-c span.on { background: var(--b); color: #fff; box-shadow: none; }
  .tabs-c em { font-style: normal; font-size: 9px; opacity: 0.5; }
  .fcs { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .fc { display: flex; flex-direction: column; gap: 7px; padding: 14px; border-radius: 10px; background: #fff; box-shadow: 0 0 0 1px var(--linea); }
  .fc-t { font-family: var(--font-bricolage), system-ui, sans-serif; font-weight: 500; font-size: 16px; }
  .chips-c { display: flex; flex-wrap: wrap; gap: 4px; }
  .chips-c code { padding: 2px 6px; border-radius: 5px; background: #f3f1e4; font-family: var(--font-mono); font-size: 8.5px; color: rgb(67 27 68 / 0.7); }
  .fc-x { font-size: 11.5px; line-height: 1.4; color: rgb(67 27 68 / 0.62); }
  .fc-pre { display: grid; place-items: center; height: 92px; margin-top: 3px; border-radius: 8px; background: #f5f7f9; }
  .fc-logo { height: 30px; width: auto; }
  .fc-dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--b); scale: calc(1 + var(--late, 0) * 0.35); }
  .fc-dot::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: rgb(67 27 68 / 0.3); scale: calc(1 + var(--late, 0) * 2); opacity: calc(1 - var(--late, 0)); }
  /* la COPIA que se despega del elemento y viaja con el cursor (translate + scale por el reloj) */
  .app > :global(.gh) { position: absolute; left: 0; top: 0; z-index: 9; margin: 0; pointer-events: none; opacity: 0; transform-origin: 50% 50%; outline: none; filter: drop-shadow(0 16px 20px rgb(36 28 25 / 0.32)); will-change: transform; }

  /* táctil (iPhone al límite de memoria al coger piezas): la copia en vuelo cambia a cada fotograma y `drop-shadow` obliga a repintar su filtro entero cada vez; sombra de caja, que no */
  @media (pointer: coarse) {
    .app > :global(.gh) { filter: none; box-shadow: 0 14px 18px -10px rgb(36 28 25 / 0.35); }
    .cursor svg { filter: none; }
  }

  .lienzo { grid-area: lienzo; position: relative; padding: 14px; min-width: 0; background: color-mix(in oklab, #431b44 6%, #f8f7ec); border-left: 1px solid var(--linea); }
  /* la home vacía: una retícula de puntos que se va con el fondo */
  .neety::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle, rgb(67 27 68 / 0.16) 1px, transparent 1.4px) 0 0 / 22px 22px; opacity: var(--vacio, 1); }
  /* al publicar, un barrido de luz cruza la página */
  .neety::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 4;
    pointer-events: none;
    background: linear-gradient(100deg, transparent 38%, rgb(255 255 255 / 0.6) 50%, transparent 62%);
    transform: translateX(calc((var(--pub, 0) * 2.4 - 1.2) * 100%));
    opacity: calc(var(--pub, 0) * (1 - var(--pub, 0)) * 4);
  }
  .neety {
    position: relative;
    height: 648px;
    border-radius: 14px;
    overflow: hidden;
    background: #f5f7f9;
    color: var(--b);
    font-family: var(--font-switzer), Inter, system-ui, sans-serif;
    box-shadow: 0 0 0 1px rgb(67 27 68 / 0.1), 0 24px 50px -36px rgb(36 28 25 / 0.45);
  }
  .neety > * { position: absolute; }

  /* LA PETICIÓN: se teclea en el centro de la página vacía; al enviarla, se recoge hacia abajo */
  .composer {
    position: absolute;
    left: calc(50% - 250px);
    top: calc(46% - 66px);
    z-index: 5;
    width: 500px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 14px 12px;
    padding: 18px 14px 14px 20px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(31 30 29 / 0.1), 0 4px 20px -6px rgb(31 30 29 / 0.12), 0 30px 60px -36px rgb(36 28 25 / 0.4);
    color: #1f1e1d;
    opacity: 0;
  }
  /* el campo, como en Claude: texto grande arriba; vacío, su placeholder en gris */
  .campo { grid-column: 1 / -1; min-height: 52px; font-size: 18px; line-height: 1.4; letter-spacing: -0.005em; }
  .campo:has([data-escrito]:empty)::after { content: var(--ph, 'Pide un cambio a tu web…'); color: rgb(31 30 29 / 0.38); }
  .caret { display: inline-block; width: 1.5px; height: 1.1em; margin-left: 1px; vertical-align: -0.18em; background: #1f1e1d; }
  .campo:has([data-escrito]:empty) .caret { margin: 0 2px 0 0; }
  .pie-chat { display: flex; align-items: center; gap: 8px; color: rgb(31 30 29 / 0.6); font-size: 14px; }
  .mas { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; box-shadow: inset 0 0 0 1px rgb(31 30 29 / 0.14); }
  .mas svg, .modelo .baja { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .modelo { display: flex; align-items: center; gap: 6px; padding: 0 6px 0 4px; height: 32px; border-radius: 10px; }
  .modelo b { display: grid; width: 15px; height: 15px; color: #d97757; }
  .modelo b :global(svg) { width: 100%; height: 100%; }
  .modelo .baja { width: 13px; height: 13px; }
  /* enviar: el cuadrado redondeado de Claude, apagado hasta que hay texto (--l) */
  .enviar {
    align-self: end;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: color-mix(in oklab, #d97757 calc(30% + var(--l, 0) * 70%), #fff);
    scale: calc(1 - var(--clic, 0) * 0.14);
  }
  .enviar svg { width: 16px; height: 16px; fill: none; stroke: #fff; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
  /* LA PÍLDORA DE ESTADO (ronda 188): un aviso de actividad de la propia app, en claro sobre la home: avatar del agente en su color, nombre, acción y la pieza en
     una etiqueta mono; al leer y al estar listo, los tres avatares; al publicar, un check en savia y el dominio */
  .estado {
    position: absolute;
    right: 42px; /* 28 px de aire desde el marco de la home (el lienzo tiene 14 px de relleno) */
    bottom: 42px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgb(67 27 68 / 0.1);
    color: #2a0e2c;
    font-family: var(--font-switzer), var(--font-sans), system-ui, sans-serif;
    font-size: 13px;
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 1px 2px rgb(42 14 44 / 0.06), 0 14px 32px -16px rgb(42 14 44 / 0.4);
    opacity: 0;
  }
  /* táctil: sin backdrop-filter (memoria en iOS); el fondo ya es blanco al 90 % */
  @media (pointer: coarse) { .estado { -webkit-backdrop-filter: none; backdrop-filter: none; } }
  .e-av, .e-ok, .e-trio i { display: grid; place-items: center; flex: none; width: 24px; height: 24px; border-radius: 50%; color: #fff; font-style: normal; font-size: 10px; font-weight: 600; letter-spacing: 0.01em; }
  .e-av { background: var(--c, #431b44); transition: background-color 0.3s; }
  .e-trio { display: flex; padding-left: 6px; }
  .e-trio i { margin-left: -6px; background: var(--c); box-shadow: 0 0 0 2px #fff; }
  /* ronda 203 · Eric: «cuando ponemos publicado, el icono de Vercel»: su triángulo, blanco sobre negro (antes un check en savia) */
  .e-ok { background: #000; }
  .e-ok svg { width: 12px; height: 12px; fill: #fff; translate: 0 -0.5px; }
  .e-txt { display: flex; align-items: center; gap: 6px; }
  .e-txt b { font-weight: 500; }
  .e-txt span { color: rgb(42 14 44 / 0.55); }
  .e-txt code { padding: 3px 7px; border-radius: 6px; background: rgb(67 27 68 / 0.06); color: #431b44; font-family: var(--font-mono); font-size: 11.5px; }
  .estado:not([data-m='toma']) .e-av, .estado:not([data-m='toma']) .e-txt b, .estado:not([data-m='lee']):not([data-m='listo']) .e-trio,
  .estado:not([data-m='pub']) .e-ok, .estado[data-m='lee'] .e-txt code, .estado[data-m='listo'] .e-txt code { display: none; }
  .estado:is([data-m='lee'], [data-m='listo']) .e-txt span { color: #2a0e2c; }
  /* el CHIP: qué pieza de la librería acaba de caer, junto a su sitio en la home */
  .chip {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 7;
    padding: 4px 9px;
    border-radius: 6px;
    background: var(--c);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    white-space: nowrap;
    opacity: var(--o, 0);
    translate: 0 calc(var(--y, 8) * 1px);
    box-shadow: 0 8px 18px -10px rgb(36 28 25 / 0.5);
  }

  /* MÓVIL (580 × 800): el índice pasa a una fila de pestañas, la librería arriba y la home debajo (la librería, al estilo real, sin el texto largo) */
  .app.v { width: 580px; height: 800px; grid-template-columns: 1fr; grid-template-rows: 38px 34px 288px 1fr; grid-template-areas: 'barra' 'tabs' 'libmain' 'lienzo'; }
  .app.v .barra { gap: 10px; padding: 0 10px 0 14px; }
  .app.v .semaforo i { width: 8px; height: 8px; }
  .app.v .barra .ruta { font-size: 11px; }
  .app.v .presencia i { width: 19px; height: 19px; font-size: 9px; }
  .app.v .publicar { font-size: 12px; padding: 5px 12px; }
  .app.v .indice { display: none; }
  .app.v .tabs-v { grid-area: tabs; display: flex; align-items: center; gap: 4px; padding: 0 10px; border-bottom: 1px solid var(--linea); overflow: hidden; }
  .app.v .tabs-v span { position: relative; padding: 4px 9px 4px 14px; border-radius: 999px; font-size: 13px; color: rgb(67 27 68 / 0.62); white-space: nowrap; }
  .app.v .tabs-v span::before { content: ''; position: absolute; left: 5px; top: 50%; width: 5px; height: 5px; margin-top: -2.5px; border-radius: 50%; background: #fe8238; opacity: var(--on, 0); scale: calc(0.4 + var(--on, 0) * 0.6); }
  .app.v .tabs-v span[data-s] { color: color-mix(in oklab, #431b44 calc(62% + var(--on, 0) * 38%), transparent); }
  .app.v .scroller { padding-bottom: 120px; }
  .app.v .sec { min-height: 262px; padding: 14px 18px 0; }
  .app.v .eb { font-size: 11px; }
  .app.v .tt { margin-top: 3px; font-size: 27px; }
  .app.v .tx { display: none; }
  .app.v .et { margin-top: 10px; font-size: 12px; }
  .app.v .et2, .app.v .rampas { display: none; }
  .app.v .swatches { gap: 8px; margin-top: 7px; }
  .app.v .sw .blk { height: 32px; }
  .app.v .sw .nm { padding: 5px 7px 0; font-size: 13.5px; }
  .app.v .sw .hx { padding: 2px 7px 6px; font-size: 11px; }
  .app.v .tps { gap: 9px; margin-top: 8px; }
  .app.v .tp-xl b { font-size: 47px; } .app.v .tp-l b { font-size: 35px; } .app.v .tp-m b { font-size: 27px; } .app.v .tp-h2 b { font-size: 21px; }
  .app.v .tp small { font-size: 11px; margin-top: 1px; }
  .app.v .tp-l small, .app.v .tp-m small, .app.v .tp-h2 small { display: none; }
  .app.v .btns { gap: 8px; margin-top: 10px; }
  .app.v .bt-card { gap: 9px; padding: 10px 11px 12px; }
  .app.v .bt-card small { font-size: 11px; }
  .app.v .pill { font-size: 15px; gap: 18px; padding: 9px 15px 9px 20px; }
  .app.v .esps { margin-top: 9px; padding: 6px 12px; gap: 0; }
  .app.v .sp-row { height: 17px; grid-template-columns: 54px 1fr 60px; }
  .app.v .sp-row:nth-child(-n + 3) { display: none; }
  .app.v .sp-row b { font-size: 11px; } .app.v .sp-row small { font-size: 10.5px; }
  .app.v .sp-row u { height: 7px; }
  .app.v .tabs-c { display: none; }
  .app.v .fcs { gap: 8px; margin-top: 10px; }
  .app.v .fc { gap: 5px; padding: 10px; }
  .app.v .fc-t { font-size: 15px; }
  .app.v .chips-c code { font-size: 10px; }
  .app.v .fc-x { display: none; }
  .app.v .fc-pre { height: 70px; }
  .app.v .lienzo { padding: 12px; border-left: 0; border-top: 1px solid var(--linea); }
  .app.v .composer { left: calc(50% - 224px); top: calc(46% - 54px); width: 448px; padding: 14px 12px 12px 16px; border-radius: 18px; gap: 10px; }
  .app.v .campo { min-height: 44px; font-size: 16px; }
  .app.v .pie-chat { font-size: 13px; }
  .app.v .enviar { width: 32px; height: 32px; }
  .app.v .estado { right: 26px; bottom: 26px; gap: 8px; font-size: 11.5px; padding: 5px 11px 5px 5px; }
  .app.v .e-av, .app.v .e-ok, .app.v .e-trio i { width: 20px; height: 20px; font-size: 9px; }
  .app.v .e-txt code { font-size: 10.5px; padding: 2px 6px; }
  .app.v .chip { font-size: 10.5px; padding: 3px 7px; }
  .app.v .neety { height: 412px; border-radius: 12px; }
  .cursor { position: absolute; left: 0; top: 0; z-index: 3; pointer-events: none; will-change: transform; }
  .cursor svg { position: relative; width: 18px; height: 18px; display: block; fill: var(--c); stroke: #fff; stroke-width: 1.4px; stroke-linejoin: round; paint-order: stroke; filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.18)); scale: calc(1 - var(--clic, 0) * 0.2); transform-origin: 2px 2px; }
  .cursor span { position: absolute; left: 14px; top: 16px; padding: 0.15em 0.6em; border-radius: 999px; background: var(--c); color: #fff; font-size: 0.8125rem; line-height: 1.5; white-space: nowrap; }
  .cursor .onda { position: absolute; left: 2px; top: 2px; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; border: 1.5px solid var(--c); opacity: calc((1 - var(--onda, 0)) * min(1, var(--onda, 0) * 20)); scale: calc(0.2 + var(--onda, 0) * 1.3); }
  .cine.v .cursor span { font-size: 0.6875rem; left: 11px; top: 13px; }
  .cine.v .cursor svg { width: 14px; height: 14px; }
  .quieta .cursor { display: none; }
  /* RONDA 203 · los iconos de los cursores */
  .cursor span { display: inline-flex; align-items: center; gap: 0.35em; }
  .cursor span:has(.ic) { padding-left: 0.45em; }
  .cursor .ic { display: inline-grid; place-items: center; width: 12px; height: 12px; flex: none; }
  .cursor .ic :global(svg) { width: 100%; height: 100%; display: block; }
  .cine.v .cursor .ic { width: 10px; height: 10px; }
  .cine.v .cursor[data-quien='savvia'] .ic { width: 14px; height: 14px; } /* el favicon a la escala de la píldora móvil (con 10 px desbordaba y el árbol quedaba más bajo que el texto) */
  .cine.v .cursor .ic :global(.fav) { width: 14px; height: 14px; translate: 0 -3px; }
  /* savvia: el favicon de la estación (el árbol, en la mitad baja: se sube 2 px para casar con el texto), sobre una píldora de su mismo fondo */
  .cursor .ic :global(.fav) { width: 16px; height: 16px; border-radius: 3px; background: url(/favicon-otono-32.png?v=205) center / cover; translate: 0 -3.5px; }
  .cursor[data-quien='savvia'] .ic { width: 16px; height: 16px; }
  .cursor[data-quien='savvia'] span { gap: 0.5em; }
  :global(html[data-estacion='invierno']) .cursor .ic :global(.fav) { background-image: url(/favicon-invierno-32.png?v=205); }
