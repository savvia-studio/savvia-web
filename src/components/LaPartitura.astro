---
// RONDA 117 · Andoni: «La partitura de tu web: cambiamos el titular a savvia agentic y quiero hacer un vídeo con Dynamic Motion de cómo se usa la
// librería de Neety en tiempo real. La base que tenemos está bien, pero tenemos que quitarle ese aspecto musical, es demasiada metáfora de música».
// · Se queda la BASE: una escena, una cámara, un reloj (`pintar(t)`, función pura del tiempo) y el mismo guion: lo que entra → la librería → la cámara
//   entra → los agentes trabajan → lo que se publica se construye.
// · Fuera TODA la música: pentagramas, cabezas de nota, «Allegro», «dir. savvia», «Fine», la doble barra, las partes como instrumentos, el ensayo, las
//   cuerdas que vibraban y el tempo como concepto (el reloj va en segundos; bucle de 16 s).
// · El objeto central es la LIBRERÍA de Neety (`neety / library`): fuera, una tarjeta con su árbol (color, tipografía, voz, espaciado, tokens,
//   componentes) cuyas filas se indexan cuando llega cada pieza; dentro, la APP de la librería: el árbol a la izquierda, el LECTOR con el archivo que
//   lee cada agente (la línea que usa, resaltada) y a la derecha la home de Neety montándose pieza a pieza CON ESOS tokens (una guía une la línea con
//   la pieza y un chip dice qué token es). Empieza con la petición de Tu equipo, tecleada en vivo, y acaba con «Publicar» → «Publicado · neety.com».
// · Película al estilo «Dynamic Motion» (los vídeos de motion graphics de Opus 5.5): interfaz nítida, cámara segura, texto que se teclea, ritmo prieto,
//   curvas ease-out expo/quart.
// · Sonidos de ordenador (r109): posar, clic, tecleo; un timbre suave al publicar. La música de la web sigue sonando.
// · Los nombres internos `partitura` (data-partitura, __partitura, el objeto de home.ts y el nombre del archivo) se quedan: los usan la portada y las
//   pruebas; no se ven. Anterior: tools/retirados/LaPartitura.r116.astro.txt (y r90–r92).
import { home } from '../data/idioma';
import { partitura as partituraEs } from '../data/home';
import { langDe } from '../lib/i18n';
import NeetyHero from './neety/NeetyHero.astro';
import { IAS } from '../data/ias';
// RONDA 203 · Eric, tras ver el vídeo de Lunagraph: cada cursor lleva su icono delante del nombre: Claude, Codex (OpenAI), Tu equipo (dos personas, Iconoir)
// y savvia (el favicon de la estación, sobre una píldora de su mismo fondo). Lo mismo en los avatares de la barra y de la píldora de estado.
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { receta, partitura } = home(lang);
const svgIA = (id: string) => `<svg viewBox="0 0 24 24" fill="currentColor">${IAS.find((x) => x.id === id)!.svg}</svg>`;
// los AVATARES (presencia de la barra, trío y avatar de la píldora de estado): Claude y Codex con su icono; savvia, el favicon de la estación (Eric)
const avatar = (n: string) => (n === 'savvia' ? '<b class="av-sv"></b>' : ICONO_AGENTE[n]);
const ICONO_AGENTE: Record<string, string> = {
  Claude: svgIA('claude'),
  Codex: svgIA('chatgpt'),
  savvia: '<i class="fav"></i>',
  'Your team': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 20v-1a7 7 0 0 1 14 0v1"/><path d="M13 14a5 5 0 0 1 10 0v.5"/><circle cx="8" cy="8" r="4"/><circle cx="18" cy="6" r="3"/></svg>',
  'Tu equipo': '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 20v-1a7 7 0 0 1 14 0v1"/><path d="M13 14a5 5 0 0 1 10 0v.5"/><circle cx="8" cy="8" r="4"/><circle cx="18" cy="6" r="3"/></svg>',
};
// RONDA 218 · en móvil, ¿escena viva (false) o vídeo grabado (true)? Safari reiniciaba la pestaña con la escena viva; la causa más probable era la copia del eco de la gota
// (entradas.ts), ya corregida. Se prueba viva (Eric: «hacerlo como en desktop»); si vuelve el negro, `true` (los 8 vídeos están en public/media/partitura/).
const VIDEO_EN_MOVIL = true;
const P = partitura;
const L = P.libreria;
// el logotipo de Neety, tal cual está en su web (components/Logo.tsx: wordmark en Ciruela #2A0E2C)
const NEETY = ["M80.9055 4.77539C74.9463 4.77539 70.6392 8.79043 70.6392 14.3541C70.6392 19.9178 74.9075 23.9406 80.8745 23.9406C85.497 23.9406 89.2277 21.5155 90.6755 17.6814H85.3574C84.4164 19.0568 82.7876 19.8557 80.8771 19.8557C78.2374 19.8557 76.3165 18.3381 75.8512 16.0216H91.0736C91.9733 9.69013 87.5317 4.77539 80.9107 4.77539H80.9055ZM75.8072 12.7253C76.314 10.3778 78.2349 8.82146 80.9055 8.82146C83.5761 8.82146 85.5358 10.3468 86.0425 12.7253H75.8072Z", "M58.5315 4.77539C52.5645 4.77539 48.2651 8.79043 48.2651 14.3541C48.2651 19.9178 52.5335 23.9406 58.4927 23.9406C63.123 23.9406 66.8459 21.5155 68.2937 17.6814H62.9834C62.0424 19.0568 60.4136 19.8557 58.4953 19.8557C55.8557 19.8557 53.9425 18.3381 53.4694 16.0216H68.6918C69.6019 9.69013 65.1499 4.77539 58.5366 4.77539H58.5315ZM53.4332 12.7253C53.9399 10.3778 55.8505 8.82146 58.5315 8.82146C61.2125 8.82146 63.154 10.3468 63.6608 12.7253H53.4332Z", "M105.771 18.8032V23.3948C97.9635 24.1937 95.4325 22.4537 95.4325 16.6367V9.65885H92.2163V5.17069C92.2163 5.17069 93.814 4.13655 94.4061 3.54968C95.0783 2.893 95.6005 2.1355 96.0116 1.25648C96.2494 0.74975 96.4304 0.315412 96.5648 0H101.583C101.583 0.0956578 101.575 0.18873 101.567 0.284388C101.552 0.48863 101.521 0.695457 101.487 0.891943C101.33 1.94418 101.068 2.90851 100.626 3.84699C100.528 4.05641 100.414 4.27099 100.285 4.48299C99.9645 5.01557 100.484 5.65932 101.071 5.46025C101.257 5.3982 101.433 5.34649 101.591 5.31547C102.92 5.04659 104.23 5.08537 105.668 5.2922V9.65368H100.784V16.4118C100.784 18.7282 101.684 19.3048 105.771 18.798V18.8032Z", "M129.266 5.20898L121.347 23.9708V25.204C121.347 30.5557 118.604 32.5076 111.404 31.8897V27.337C115.166 27.6937 115.996 26.9724 115.996 24.5163V23.901L108.465 6.02337L108.377 5.83464L108.116 5.20898H113.902C116.43 10.6511 117.361 15.2841 118.023 18.0116C118.188 18.6967 119.165 18.6916 119.328 18.0039C120.15 14.5369 120.978 10.5374 123.48 5.20898H129.266Z", "M45.4319 5.20898V23.5649H39.814C39.858 23.128 39.8502 22.6833 39.8088 22.2387C39.6796 21.0106 39.0694 19.8834 38.2602 18.8855C37.4536 17.8746 36.4479 17.0292 35.344 16.3518L33.5911 15.2841C33.1439 15.0126 32.5699 15.3332 32.5699 15.858V23.5649H27.4897V5.20898H32.9293C32.9344 6.08542 33.1025 7.07043 33.3662 7.84087C33.6816 8.7354 34.1315 9.511 34.7338 10.2401C35.8998 11.6517 37.4226 12.5824 39.0126 13.4407L39.4185 13.6553C39.8683 13.8932 40.4086 13.5648 40.4035 13.0555L40.3492 5.20898H45.4293H45.4319Z", "M16.952 5.20898H7.63706C6.83044 5.20898 6.17635 5.86308 6.17635 6.6697L7.21565 10.6666C7.33975 11.1475 7.22599 11.6723 6.87439 12.024C6.84854 12.0498 6.8201 12.0782 6.78907 12.1015C6.44264 12.3988 5.96177 12.4841 5.51968 12.3704L1.46071 11.3259C0.654089 11.3259 0 11.98 0 12.7866V22.1042C0 22.9108 0.654089 23.5649 1.46071 23.5649H10.7782C11.5849 23.5649 12.2389 22.9108 12.2389 22.1042L11.2875 18.0582C11.1893 17.6419 11.2746 17.1946 11.5538 16.8715C11.5771 16.8456 11.6004 16.8172 11.6262 16.7939C11.9571 16.463 12.4509 16.3518 12.906 16.4604L16.9546 17.448C17.7612 17.448 18.4153 16.7939 18.4153 15.9873V6.6697C18.4153 5.86308 17.7612 5.20898 16.9546 5.20898H16.952Z"];
// RONDA 94 · «si en la representación de Neety la animación que va en el hero podemos hacerla más fiel a la real, mejor». Medido en la web real
// (neety.treseiscero.app/home, tools/r94/real*.cjs, tools/shots/r94-real/): el hero entra entero con un FUNDIDO al irse la carga (sin palabras que
// suban); el punto del eyebrow LATE (vaivén senoidal de 2,4 s: el punto crece a ×1,35 y su halo, ciruela al 35 %, se abre a ×3 y se apaga); y a la
// derecha no hay una tarjeta quieta sino una CINTA de tarjetas que sube (máscara arriba y abajo): la activa nítida, las demás al 28 %, desenfocadas
// 5 px y a ×0,95; cada una llega en ESQUELETO, el esqueleto se funde en su cabecera y sus filas entran escalonadas (suben y crecen); las cifras no
// cuentan, están. RONDA 188 · ya no es un dibujo aproximado: es la RÉPLICA EXACTA del hero (src/components/neety/NeetyHero.astro, comparada al
// píxel con la web real) en su vista de TABLET, 768 × 864, escalada al hueco (576 × 648 = ×0,75). La película mueve su cinta y su punto con su reloj.
// RONDA 118 · el índice y los textos de cada sección de la librería (los que se ven dentro) salen de `libreria` en home.ts
const PG = L.paginas;
const SECDE_ES: Record<string, string> = { 'Color': 'color', 'Tipografía': 'tipo', 'Espaciado': 'esp', 'Botones': 'botones', 'Componentes de la web': 'comp' };
// la clave de cada entrada del índice sale de su posición (en castellano), así no depende del idioma del rótulo
const secDe = (gi: number, ii: number) => SECDE_ES[partituraEs.libreria.indice[gi][1][ii]];
const TABS_V: [string, string][] = en
  ? [['color', 'Colour'], ['tipo', 'Typography'], ['botones', 'Buttons'], ['esp', 'Spacing'], ['comp', 'Components']]
  : [['color', 'Color'], ['tipo', 'Tipografía'], ['botones', 'Botones'], ['esp', 'Espaciado'], ['comp', 'Componentes']];
const ESP_M = [4, 6, 12, 16, 18, 24, 32, 48, 64, 80, 96, 112]; // el valor mobile de cada paso de la escala (la librería real: «48 / 32px»)
import Problemas from './Problemas.astro';
---

<section id="la-savvia" class="surface-light la-partitura relative" aria-label={receta.titulo} data-partitura data-sube data-film-movil={VIDEO_EN_MOVIL ? "" : undefined}>
  <div class="wrap section-y cierre">
    <!-- RONDA 292 · JL: el manifiesto abre la sección; fuera el titular «savvia agentic» y su explicación (la ilustración se explica sola) -->
    <Problemas incrustada />

    <div
      class="cine"
      data-cine
      data-entra-p={JSON.stringify(P.entra)}
      data-sale-p={JSON.stringify(P.sale)}
      data-titulo-p={JSON.stringify(L.titulo)}
      data-resumen-p={JSON.stringify(P.resumen)}
      data-picks-p={JSON.stringify(L.picks)}
      data-estado-p={JSON.stringify(L.estado)}
      data-peticion-p={JSON.stringify(L.peticion)}
      role="img"
      aria-label={en ? "Looping film: what goes into a website (strategy, voice, identity, components…) is stored in Neety's library. Their team asks for a new hero; Claude, Codex and savvia pick pieces from Neety's real library (the hero gradient, the XL H1 headline, the Request a demo button, the spacing, the logo and the pulsing dot) and place them on its home page. Once published on neety.com, the same library is used to change copy, edit illustrations, create landing pages for ads, upload the blog to the CMS, add languages, publish client case studies, update pricing, tune SEO, run A/B tests and review accessibility." : "Película en bucle: lo que entra en una web (estrategia, voz, identidad, componentes…) se guarda en la librería de Neety. Su equipo pide un hero nuevo; Claude, Codex y savvia cogen piezas de la librería real de Neety (el degradado del hero, el titular H1 XL, el botón Solicitar demo, el espaciado, el logotipo y el punto pulsante) y las colocan en su home. Al publicar en neety.com, la misma librería sirve para cambiar textos, editar ilustraciones, crear landings para anuncios, subir el blog al CMS, añadir idiomas, publicar casos de cliente, actualizar precios, ajustar el SEO, hacer tests A/B y revisar la accesibilidad."}
    >
      <video class="film" data-film data-lang={lang} muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture></video>
      <svg class="mapa" aria-hidden="true" data-mapa></svg>

      <!-- LA LIBRERÍA POR DENTRO (r118): la librería REAL de Neety en miniatura (índice + secciones que se recorren con el reloj) y, al lado, la home que se monta con lo que cogen los agentes. Escritorio 1360 × 720; móvil 580 × 800 -->
      <div class="app" aria-hidden="true" data-ventana>
        <div class="barra">
          <span class="semaforo"><i></i><i></i><i></i></span>
          <span class="ruta">{L.ruta}</span>
          <span class="presencia">{P.agentes.slice(0, 3).map(([n, c]) => <i style={`--c: var(--color-${c})`} set:html={avatar(n)}></i>)}</span>
          <span class="publicar" data-publicar>{L.publicar}</span>
        </div>
        <nav class="indice">
          {L.indice.map(([g, items], gi) => (
            <Fragment>
              <p class="ind-g">{g}</p>
              <ul>{items.map((x, ii) => <li data-s={secDe(gi, ii)}>{x}</li>)}</ul>
            </Fragment>
          ))}
        </nav>
        <div class="tabs-v">{TABS_V.map(([k, x]) => <span data-s={k}>{x}</span>)}</div>
        <div class="libmain">
          <div class="scroller" data-scroller>
            <section class="sec" data-sec="color">
              <p class="eb">{PG.color.eyebrow}</p>
              <h3 class="tt">{PG.color.titulo}</h3>
              <p class="tx">{PG.color.texto}</p>
              <p class="et">{PG.color.etiqueta}</p>
              <div class="swatches">
                {L.color.map(([n, hx]) => (
                  <span class="sw pk" data-src={hx === 'grad' ? 'base' : undefined}><i class={`blk ${hx === 'grad' ? 'grad' : ''}`} style={hx === 'grad' ? undefined : `background:${hx}`}></i><b class="nm">{n}</b><small class="hx">{hx === 'grad' ? (en ? 'blue → aubergine, grain' : 'azul → berenjena, grano') : hx}</small></span>
                ))}
              </div>
              <p class="et et2">{PG.color.rampas}</p>
              <div class="rampas">
                {['#FE8238', '#A7C5F9'].map((c) => (
                  <span class="rampa">{[80, 60, 40, 20, 10, 5, 2].map((o) => <i style={`background:color-mix(in srgb, ${c} ${o}%, transparent)`}><small>{o}</small></i>)}</span>
                ))}
              </div>
            </section>
            <section class="sec" data-sec="tipo">
              <p class="eb">{PG.tipo.eyebrow}</p>
              <h3 class="tt">{PG.tipo.titulo}</h3>
              <p class="tx">{en ? <Fragment>Headings in <b>Bricolage Grotesque</b>, body in <b>Switzer</b>.</Fragment> : <Fragment>Titulares en <b>Bricolage Grotesque</b>, cuerpo en <b>Switzer</b>.</Fragment>}</p>
              <p class="et">{PG.tipo.etiqueta}</p>
              <div class="tps">
                {[['H1, XL', 'Desktop 112px, Mobile 64px, 120%', 'xl'], ['H1, L', 'Desktop 80px, Mobile 48px, 120%', 'l'], ['H1, M', 'Desktop 64px, Mobile 40px, 120%', 'm'], ['H2', 'Desktop 48px, Mobile 32px, 120%', 'h2']].map(([n, m, c]) => (
                  <span class={`tp tp-${c} pk`} data-src={c === 'xl' ? 'h1xl' : undefined}><b>{n}</b><small>{m}</small></span>
                ))}
              </div>
            </section>
            <section class="sec" data-sec="botones">
              <p class="eb">{PG.botones.eyebrow}</p>
              <h3 class="tt">{PG.botones.titulo}</h3>
              <p class="tx">{PG.botones.texto}</p>
              <div class="btns">
                {L.botonesTarjetas.map(([et, v, tx], j) => (
                  <span class="bt-card">
                    <small>{et}</small>
                    <span class={`pill ${v} ${j === 0 ? 'pk' : ''}`} data-src={j === 0 ? 'cta' : undefined}>{tx}<i></i></span>
                  </span>
                ))}
              </div>
            </section>
            <section class="sec" data-sec="esp">
              <p class="eb">{PG.esp.eyebrow}</p>
              <h3 class="tt">{PG.esp.titulo}</h3>
              <p class="tx">{PG.esp.texto}</p>
              <div class="esps">
                {L.espaciado.map(([n, v], j) => (
                  <span class={`sp-row ${n === 'large' ? 'pk' : ''}`} data-src={n === 'large' ? 'large' : undefined}><b>{n}</b><i><u style={`width:${(v / 160) * 100}%`}></u></i><small>{v} / {ESP_M[j]}px</small></span>
                ))}
              </div>
            </section>
            <section class="sec" data-sec="comp">
              <p class="eb">{PG.comp.eyebrow}</p>
              <h3 class="tt">{PG.comp.titulo}</h3>
              <p class="tx">{PG.comp.texto}</p>
              <div class="tabs-c">{L.tabsComponentes.map((x, j) => <span class={j === 0 ? 'on' : ''}>{x}<em>{[12, 13, 6, 4, 4, 5, 4, 3][j]}</em></span>)}</div>
              <div class="fcs">
                {L.fichas.map((f) => (
                  <span class="fc">
                    <b class="fc-t">{f.titulo}</b>
                    <span class="chips-c">{f.chips.map((c) => <code>{c}</code>)}</span>
                    <small class="fc-x">{f.texto}</small>
                    <span class="fc-pre pk" data-src={f.id}>
                      {f.id === 'logo'
                        ? <svg class="fc-logo" viewBox="0 0 130 32" aria-hidden="true"><g fill="#2A0E2C">{NEETY.map((d) => <path d={d} />)}</g></svg>
                        : <i class="fc-dot"></i>}
                    </span>
                  </span>
                ))}
              </div>
            </section>
          </div>
        </div>
        <div class="lienzo" data-lienzo>
          <!-- la home de Neety: su hero REAL (réplica exacta, vista tablet 768 × 864 escalada al hueco), que se monta con lo que cogen los agentes -->
          {/* 30/10 (pulido) · `inert`: la réplica es una ilustración; sus enlaces (Plataforma, Log in, Solicitar demo…) eran paradas del Tab y los lectores de pantalla los anunciaban */}
          <div class="neety" data-neety data-slot="fondo" inert><NeetyHero caja /></div>
          <!-- la PETICIÓN de Tu equipo: se teclea en vivo, se envía y se recoge en la píldora de estado -->
          <div class="composer" data-composer>
            <!-- ronda 203 · Eric: «más fiel al típico chat de Claude o ChatGPT»: el texto arriba y, abajo, «+», el modelo y enviar -->
            <p class="campo" style={en ? "--ph: 'Ask for a change to your website…'" : undefined}><span data-escrito></span><i class="caret" data-caret></i></p>
            <span class="pie-chat">
              <span class="mas" aria-hidden="true"><svg viewBox="0 0 16 16"><path d="M8 3.5v9M3.5 8h9" /></svg></span>
              <span class="modelo"><b set:html={ICONO_AGENTE.Claude}></b>Opus 5.5<svg class="baja" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 6.5 8 9.5l3-3" /></svg></span>
            </span>
            <span class="enviar" data-enviar><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg></span>
          </div>
          <!-- ronda 188 · la píldora de estado, como un aviso de actividad de la app: quién (su avatar, en su color), qué hace y con qué pieza -->
          <div class="estado" data-estado data-m="lee">
            <span class="e-trio">{P.agentes.slice(0, 3).map(([n, c]) => <i style={`--c: var(--color-${c})`} set:html={avatar(n)}></i>)}</span>
            <span class="e-av" data-estado-av data-ag="0">{P.agentes.map(([n], i) => <i data-a={i} set:html={avatar(n)}></i>)}</span>
            <span class="e-ok"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3.2 13.6 12.8 2.4 12.8Z" /></svg></span>
            <span class="e-txt"><b data-estado-quien></b><span data-estado-txt>{L.estado[0]}</span><code data-estado-pieza></code></span>
          </div>
        </div>
        <!-- los CHIPS: la pieza de la librería que acaba de caer en la home -->
        {L.picks.map((p) => <span class="chip" style={`--c: var(--color-${P.agentes[p.ag][1]})`} data-chip>{p.chip}</span>)}
      </div>

      {P.agentes.map(([n, c]) => (
        <div class="cursor" style={`--c: var(--color-${c})`} aria-hidden="true" data-agente data-quien={n === 'savvia' ? 'savvia' : undefined}>
          <i class="onda"></i>
          <svg viewBox="0 0 16 16"><path d="M2 1.5 L14 7 L8.4 8.4 L6.2 14 Z" /></svg>
          <span>{ICONO_AGENTE[n] && <b class="ic" set:html={ICONO_AGENTE[n]}></b>}{n}</span>
        </div>
      ))}
    </div>

    <p class="nota detail text-fg2" data-enfoca><span class="fig">{en ? 'Fig. 1' : 'Il. 1'}</span><span class="txt">{P.nota} <a class="link" href={P.enlace.href} target="_blank" rel="noopener">{P.enlace.label}</a></span></p>
  </div>
</section>

<script>
  import { jugar } from '../scripts/jugar';
  import { tecla, clic, teclear, papel, posar, tocar } from '../scripts/sonidos';
  import { t as tr } from '../scripts/i18n';
  import { revelar } from '../scripts/revelar';

  const sec = document.querySelector<HTMLElement>('[data-partitura]');
  if (sec) iniciar(sec);

  function iniciar(sec: HTMLElement) {
    const cine = sec.querySelector<HTMLElement>('[data-cine]')!;
    const svg = sec.querySelector<SVGSVGElement>('[data-mapa]')!;
    const win = sec.querySelector<HTMLElement>('[data-ventana]')!;
    const curs = [...sec.querySelectorAll<HTMLElement>('[data-agente]')];
    const ENTRA: string[] = JSON.parse(cine.dataset.entraP!), SALE: string[] = JSON.parse(cine.dataset.saleP!), TIT: string = JSON.parse(cine.dataset.tituloP!);
