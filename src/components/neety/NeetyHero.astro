// RONDA 188 · réplica EXACTA del hero de Neety (/home), a partir de lo extraído en tools/r188/neety-hero/ (LEEME.md): mismo marcado, mismas
// medidas (Tailwind de Hero.tsx, SignalFeed.tsx, PillCta, Navbar y HomePage traducido a CSS), el degradado horneado con su muesca y la cinta de
// tarjetas con su reloj de 26,6 s. Sin GSAP: la cinta es una función pura del tiempo (`pintar(t)`) con las mismas curvas (power1–3, back, sine).
// Referencia: 1440 × 900 (card 1400 × 795). Breakpoints como el original: md 768 · lg 1024 · 1200 · xl 1280 · 1360 · alto < 840.
// `?svh=830` fija 100svh en 830 px: así lo resolvía el Chrome sin ventana de la extracción a 1440 × 900 (padding 148, hueco 166).
// `?t=4.2` congela la cinta en ese segundo (y el punto en su pico): es el instante de las capturas de tools/r188/neety-hero/capturas/.
// `caja` (RONDA 188, savvia agentic): la web se pinta como en una tablet de 768 × 864 dentro de su caja, escalada a su ancho; no corre su propio reloj
// (la película llama a `__nh.pintar(t)` y `__nh.latir(l)`) y sus piezas llevan `data-pz` / `data-slot` para que los agentes las monten.
import { langDe } from '../../lib/i18n';
interface Props { caja?: boolean }
const { caja = false } = Astro.props;
const en = langDe(Astro.currentLocale) === 'en';
const Hx = caja ? 'p' : 'h1';
// dentro de savvia no puede haber otro <main> (y los carriles dibujan una fila por cada `main > section`)
const Main = caja ? 'div' : 'main';
const pz = (n: string, slot = false) => (caja ? { 'data-pz': n, ...(slot ? { 'data-slot': n } : {}) } : {});
