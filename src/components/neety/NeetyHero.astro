---

<div class:list={['nh-vp', caja && 'caja']} data-nh-vp data-neety-hero>
<Main class="nh-main">
  <!-- barra fija a nivel de página (StickyHeader: h-0, encima de la card) -->
  <div class="nh-sticky">
    {caja && <div class="nh-blur" aria-hidden="true" data-nav-blur><i></i><i></i><i></i><b></b></div>}
    <div class="nh-sticky-in">
      <nav class="nh-nav" aria-label="Neety">
        <a href="#" class="nh-logo-a" aria-label="Neety" {...pz('logo', true)}><svg class="nh-logo" viewBox="0 0 130 32" aria-hidden="true"><g fill="#2A0E2C">{LOGO.map((d) => <path d={d} />)}</g></svg></a>
        <div class="nh-der">
          <ul class="nh-menu" data-menu>
            <span class="nh-pastilla" aria-hidden="true" data-pastilla></span>
            {NAV.map((n) => (
              <li><a href="#" class:list={['nh-item', n.mas && 'nh-mas']} data-navitem>{n.label}{n.mas && <span class="nh-signo" aria-hidden="true">+</span>}</a></li>
            ))}
          </ul>
          <div class="nh-acc">
            <a href="#" class="nh-login">Log in</a>
            <a href="#" class="nh-navcta"><span class="nh-swap" data-text={en ? 'Request a demo' : 'Solicitar demo'}><span class="nh-swap-l">{en ? 'Request a demo' : 'Solicitar demo'}</span></span></a>
          </div>
        </div>
      </nav>
    </div>
  </div>

  <div class="nh-card">
    <div class="nh-fondo" aria-hidden="true" {...pz('fondo')}>
      <div class="nh-bg-m"></div>
      <div class="nh-bg"></div>
    </div>

    <section class="nh-hero">
      <div class="nh-col">
        <div>
          <div class="nh-eyebrow" {...pz('eyebrow')}>
            <span class="nh-punto" aria-hidden="true" data-punto {...(caja ? { 'data-slot': 'punto' } : {})}><span class="nh-halo" data-halo></span><span class="nh-core"></span></span>
            <span class="nh-eb-t">{en ? 'Detect. Prioritise. ' : 'Detecta. Prioriza. '}<span class="nh-eb-a">{en ? 'Act.' : 'Actúa.'}</span></span>
          </div>
          <Hx class="nh-h1" {...pz('h1', true)}>{en ? 'Detect who to sell to, when to do it and ' : 'Detecta a quién vender, cuándo hacerlo y '}<span class="nh-h1-dim">{en ? 'what action to take.' : 'qué acción tomar.'}</span></Hx>
          <div class="nh-ctas" {...pz('ctas')}>
            {caja && <span class="nh-esp" data-pz="esp" data-slot="esp" aria-hidden="true"><i></i><b>48</b></span>}
            <a href="#" class="nh-pill" {...(caja ? { 'data-slot': 'ctas' } : {})}>
              <span class="nh-pill-bg" aria-hidden="true"></span>
              <span class="nh-pill-in" data-text={en ? 'Request a demo' : 'Solicitar demo'}>
                <span class="nh-pill-t">{en ? 'Request a demo' : 'Solicitar demo'}</span>
                <span class="nh-pill-dw" aria-hidden="true">
                  <span class="nh-pill-dot"></span>
                  <svg class="nh-pill-ar" viewBox="0 0 16 16" fill="none"><path d="M2.5 8h10M8.5 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </span>
            </a>
            <a href="#" class="nh-how">{en ? 'See how it works' : 'Ver cómo funciona'}</a>
          </div>
        </div>

        <!-- la ilustración: en línea en móvil, absoluta a la derecha en lg -->
        <div class="nh-ilus" aria-hidden="true" {...pz('card')}>
          <div class="nh-ilus-in">
            <div class="sf-box" data-box>
              <div class="sf-stage" data-stage>
                <div class="sf-feed" data-feed>
                  <!-- 1 · empresas -->
                  <div class="sf-card"><div class="sf-c g3 p4">
                    <div class="sf-skel g3 p4"><div class="sk-h bord"><div class="sks s8 r8"></div><div class="skb h35"></div></div>
                      {[0, 1, 2].map(() => <div class="sk-row"><div class="sks s6 r4"></div><div class="skb h3" style="width:24%"></div><div class="sks sc ml"></div></div>)}</div>
                    <div class="sf-head bord"><span class="chip s8 r8"><svg viewBox="0 0 256 256" class="ic16"><path d={IC.buildings[0]} opacity="0.2" /><path d={IC.buildings[1]} /></svg></span><p class="t-lg">{en ? 'Neety found companies that fit' : 'Neety encontró empresas que encajan'}</p></div>
                    {COMPANIES.map((c) => (
                      <div class="sf-in row"><span class="chip s6 r4"><img src={c.logo} alt="" class="lg12" /></span><p class="nm f1">{c.name}</p><span class="score"><span>{c.score}%</span></span></div>
                    ))}
                  </div></div>
                  <!-- 2 · personas -->
                  <div class="sf-card"><div class="sf-c g3 p4">
                    <div class="sf-skel g3 p4"><div class="sk-h bord"><div class="sks s8 r8"></div><div class="skb h35"></div></div>
                      {[0, 1, 2].map(() => <div class="sk-row"><div class="sks s8 r4"></div><div class="sk-col"><div class="skb h25" style="width:38%"></div><div class="skb h2" style="width:62%"></div></div><div class="sks sc"></div></div>)}</div>
                    <div class="sf-head bord"><span class="chip s8 r8"><svg viewBox="0 0 256 256" class="ic16"><path d={IC.users[0]} opacity="0.2" /><path d={IC.users[1]} /></svg></span><p class="t-lg">{en ? '3 key people found' : '3 personas clave encontradas'}</p></div>
                    {PEOPLE.map((p) => (
                      <div class="sf-in row rel">
                        {p.jon && <span class="sf-jonhl"></span>}
                        <img src={p.photo} alt={p.name} class="foto" />
                        <div class="per"><p class="nm">{p.name}</p><p class="rol">{p.rol}</p></div>
                        <span class="score rel"><span>{p.score}%</span></span>
                      </div>
                    ))}
                  </div></div>
                  <!-- 3 · activarse -->
                  <div class="sf-card"><div class="sf-c g3 p4">
                    <div class="sf-skel g3 p4"><div class="sk-h bord"><div class="sks s8 r8"></div><div class="skb h35"></div></div>
                      <div class="sk-acts">{[0, 1, 2].map((i) => <div class="sk-act"><div class="sks s15 rf"></div><div class="skb h25" style={`width:${48 - i * 6}%`}></div></div>)}</div></div>
                    <div class="sf-head bord">
                      <img src={`${A}/jon-96.jpg`} alt="Iker Goikoetxea" class="foto r8" />
                      <p class="t-lg">{en ? 'Iker is starting to engage' : 'Iker empieza a activarse'}</p>
                      <span class="sf-pop pill-p" style="background:#fff9e5"><svg viewBox="0 0 256 256" class="ic12" style="color:#988c62"><path d={IC.termo[0]} opacity="0.2" /><path d={IC.termo[1]} /></svg><span class="pop-t" style="color:#988c62">{en ? 'Warm' : 'Templado'}</span></span>
                    </div>
                    <div class="acts">
                      <span class="sf-line"></span>
                      {ACTIONS.map((a) => <div class="sf-act"><span class="sf-dot"></span><span class="act-t">{a}</span></div>)}
                    </div>
                  </div></div>
                  <!-- 4 · señal -->
                  <div class="sf-card"><div class="sf-c g3 p4 rel">
                    <div class="sf-skel g3 p4"><div class="sk-h"><div class="sks s8 r4"></div><div class="skb h35"></div></div><div class="skb h25 ml11" style="width:55%"></div></div>
                    <div class="sf-head"><span class="chip s8 r4"><img src={`${A}/betsaide.avif`} alt="" class="lg16" /></span><p class="t-md" style="max-width:210px">{en ? 'Signal: Betsaide closed a funding round' : 'Señal: Betsaide cerró una ronda de financiación'}</p></div>
                    <p class="sf-in sub">{en ? 'The perfect moment to get in touch' : 'Es el momento perfecto para escribir'}</p>
                    <span class="sf-pop pill-p hot"><svg viewBox="0 0 256 256" class="ic12" style="color:#b25959"><path d={IC.fuego[0]} opacity="0.2" /><path d={IC.fuego[1]} /></svg><span class="pop-t" style="color:#b25959">Hot</span></span>
                  </div></div>
                  <!-- 5 · mensaje -->
                  <div class="sf-card"><div class="sf-c g3 p4">
