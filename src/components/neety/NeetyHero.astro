  .nh-blur i:nth-child(1) { -webkit-mask-image: linear-gradient(to bottom, #000, #000 55%, transparent); mask-image: linear-gradient(to bottom, #000, #000 55%, transparent); }
  .nh-blur i:nth-child(2) { -webkit-mask-image: linear-gradient(to bottom, #000, #000 28%, transparent 72%); mask-image: linear-gradient(to bottom, #000, #000 28%, transparent 72%); }
  .nh-blur i:nth-child(3) { -webkit-mask-image: linear-gradient(to bottom, #000, #000 12%, transparent 46%); mask-image: linear-gradient(to bottom, #000, #000 12%, transparent 46%); }
  .nh-blur.on i:nth-child(1) { -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); }
  .nh-blur.on i:nth-child(2) { -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); }
  .nh-blur.on i:nth-child(3) { -webkit-backdrop-filter: blur(11px); backdrop-filter: blur(11px); }
  .nh-blur b { opacity: 0; transition: opacity 0.3s; background: linear-gradient(to bottom, rgba(245,247,249,0.92) 0%, rgba(245,247,249,0.9) 45%, rgba(245,247,249,0.68) 62%, rgba(245,247,249,0.4) 78%, rgba(245,247,249,0.18) 90%, rgba(245,247,249,0) 100%); }
  .nh-blur.on b { opacity: 1; }
  /* «Nuestros clientes» en md (< lg): py-16 px-10, etiqueta mono al 40 %, cinta de tarjetas blancas de 180 px con su «nubecita» en los bordes */
