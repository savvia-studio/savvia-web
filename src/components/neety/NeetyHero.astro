  { name: 'Betsaide', score: 94, logo: `${A}/betsaide.avif` },
  { name: 'Arania', score: 91, logo: `${A}/arania.avif` },
  { name: 'Fagor Automation', score: 88, logo: `${A}/fagor-automation.avif` },
];
const PEOPLE = [
  { name: 'Iker Goikoetxea', score: 94, photo: `${A}/jon-96.jpg`, rol: en ? 'Head of procurement · Betsaide' : 'Director de compras · Betsaide', jon: true },
  { name: 'Ane Larrañaga', score: 91, photo: `${A}/nerea-96.jpg`, rol: en ? 'Head of operations · Arania' : 'Directora de operaciones · Arania' },
  { name: 'Naroa Iturbe', score: 88, photo: `${A}/ines-96.jpg`, rol: en ? 'Plant manager · Fagor Automation' : 'Directora de planta · Fagor Automation' },
];
const ACTIONS = en ? ['Visited your profile', 'Accepted your request', 'You reacted to their post'] : ['Ha visitado tu perfil', 'Ha aceptado tu solicitud', 'Has reaccionado a su post'];
const MESSAGE = en ? 'Hi Iker, I saw that Betsaide is strengthening its procurement team. I think we can help you prioritise opportunities better. Shall we talk this week?' : 'Hola Iker, he visto que Betsaide está reforzando compras. Creo que podemos ayudaros a priorizar mejor oportunidades. ¿Lo vemos esta semana?';
// RONDA 188 · «Nuestros clientes» (Clients.tsx + LogoMarquee.tsx de Neety), solo en caja: es lo que asoma cuando la película baja por la web
const CLIENTES = [
  { src: `${A}/client-ojmar.avif`, alt: 'Ojmar', h: 20, w: 127, n: 24 },
  { src: `${A}/client-telpark.avif`, alt: 'Telpark', h: 24, w: 119, n: 30 },
