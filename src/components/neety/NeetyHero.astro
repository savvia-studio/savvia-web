  .nh-mq-t img { width: auto; max-width: 100%; object-fit: contain; }
  /* «Por qué Neety», «De ruido a señal» y el arranque de «Neety por dentro»: capturadas de la web real a 768 px (DPR 2), ya con sus entradas hechas */
  .nh-secciones { display: block; width: 768px; height: 2700px; margin-inline: -20px; max-width: none; }
  /* las PIEZAS que montan los agentes (la película pone --p 0 → 1): se asientan con un fundido y una subida corta; el degradado crece desde el centro */
  .caja [data-pz]:not(.nh-fondo):not(.nh-esp) { opacity: var(--p, 0); translate: 0 calc((1 - var(--p, 0)) * 8px); }
  .caja .nh-fondo { clip-path: circle(calc(var(--p, 0) * 80%) at 50% 50%); }
  /* el espaciado «large · 48» abre el hueco del titular a la píldora (24 → 48) y una cota naranja lo marca */
