<script>
  // ── la cinta, como función pura del tiempo (el timeline de SignalFeed.tsx, sin GSAP) ──
  type Ease = (x: number) => number;
  const E = {
    p1o: (x: number) => 1 - (1 - x) ** 2,
    p2o: (x: number) => 1 - (1 - x) ** 3,
    p2i: (x: number) => x ** 3,
    p2io: (x: number) => (x < 0.5 ? 4 * x ** 3 : 1 - (-2 * x + 2) ** 3 / 2),
    p3o: (x: number) => 1 - (1 - x) ** 4,
    back: (c: number) => (x: number) => 1 + (c + 1) * (x - 1) ** 3 + c * (x - 1) ** 2,
    sine: (x: number) => -(Math.cos(Math.PI * x) - 1) / 2,
  };
  const cl = (x: number) => Math.min(Math.max(x, 0), 1);
  document.querySelectorAll<HTMLElement>('[data-neety-hero]').forEach(iniciar);

  function iniciar(raiz: HTMLElement) {
    const box = raiz.querySelector<HTMLElement>('[data-box]')!;
    const stage = raiz.querySelector<HTMLElement>('[data-stage]')!;
    const feed = raiz.querySelector<HTMLElement>('[data-feed]')!;
    const pista = raiz.querySelector<HTMLElement>('[data-marquee]'), hamb = raiz.querySelector<HTMLElement>('.nh-hamb'), navBlur = raiz.querySelector<HTMLElement>('[data-nav-blur]');
    const halos = [...raiz.querySelectorAll<HTMLElement>('[data-halo]')], puntos = halos.map((h) => h.parentElement!);
    const cards = [...feed.querySelectorAll<HTMLElement>('.sf-card')];
    // los cortes los decide la caja (el contenedor `nh`), no la ventana
    const lg = { get matches() { return raiz.offsetWidth >= 1024; } };
    const caja = raiz.classList.contains('caja');
    // en caja: escala = ancho del hueco / 768 (la película lee `__nh.escala` para colocar cursores y copias)
    let escala = 1;
    if (caja) {
      const escalar = () => { escala = raiz.parentElement!.clientWidth / 768; raiz.style.setProperty('--nh-s', String(escala)); };
      escalar();
      new ResizeObserver(escalar).observe(raiz.parentElement!);
    }
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const q = new URLSearchParams(location.search);
    const fijo = q.has('t') ? Number(q.get('t')) : null;

    // encaje: el lienzo de 408 px se escala al ancho de la caja y la zona activa (304) cae al 28 % (lg) o al 46 % del alto
    const encajar = () => {
      const sc = box.clientWidth / 408;
      const ty = (lg.matches ? 0.28 : 0.46) * box.clientHeight - 304 * sc;
      stage.style.transform = `translateY(${ty.toFixed(1)}px) scale(${sc})`;
    };
    encajar();
    new ResizeObserver(encajar).observe(box);

    const rd = cards.map((el) => ({
      el,
      skel: el.querySelector<HTMLElement>('.sf-skel'),
      heads: [...el.querySelectorAll<HTMLElement>('.sf-head')],
      ins: [...el.querySelectorAll<HTMLElement>('.sf-in')],
      acts: [...el.querySelectorAll<HTMLElement>('.sf-act')],
      dots: [...el.querySelectorAll<HTMLElement>('.sf-dot')],
      pops: [...el.querySelectorAll<HTMLElement>('.sf-pop')],
      line: el.querySelector<HTMLElement>('.sf-line'),
      jonhl: el.querySelector<HTMLElement>('.sf-jonhl'),
    }));
    const typed = raiz.querySelector<HTMLElement>('[data-typed]')!;
    const caret = raiz.querySelector<HTMLElement>('[data-caret]')!;
    const btn = raiz.querySelector<HTMLElement>('[data-btn]')!;
    const btnD = raiz.querySelector<HTMLElement>('[data-btn-d]')!;
    const btnS = raiz.querySelector<HTMLElement>('[data-btn-s]')!;
    const MENSAJE = typed.textContent!;

    // el guion: se monta con las alturas reales (offsetTop/offsetHeight en px de diseño, la escala no les afecta)
    type Tw = { k: number; at: number; dur: number; ease: Ease; f: (v: number) => void };
    let G: { tws: Tw[]; vuelo: { at: number; dur: number; ease: Ease; de: number; a: number }[]; act: number[]; total: number; y0: number; letras: number[]; ini: number; fin: number; parpadeos: number; spacing: number };
    const montar = () => {
      // como el original: se mide con el mensaje aún sin teclear (la tarjeta 4 mide 160, no 196), y así paran 5 y 6 en −733 y −840
      typed.textContent = '';
      const stageH = 760, activeAt = stageH * 0.4, spacing = cards[1].offsetTop;
      const centerY = (i: number) => activeAt - (cards[i].offsetTop + cards[i].offsetHeight / 2);
      const tws: Tw[] = [], vuelo: typeof G.vuelo = [], act: number[] = [];
      const tw = (k: number, at: number, dur: number, ease: Ease, f: (v: number) => void) => tws.push({ k, at, dur, ease, f });
      const reveal = (k: number, els: HTMLElement[], at: number, stagger = 0.1, dur = 0.55) =>
        els.forEach((el, i) => tw(k, at + i * stagger, dur, E.p3o, (v) => { el.style.opacity = v.toFixed(3); el.style.transform = `translateY(${((1 - v) * 18).toFixed(2)}px) scale(${(0.92 + 0.08 * v).toFixed(4)})`; }));
      const popIn = (k: number, els: HTMLElement[], at: number) =>
        els.forEach((el) => tw(k, at, 0.5, E.back(2), (v) => { el.style.opacity = cl(v).toFixed(3); el.style.transform = `scale(${(0.5 + 0.5 * v).toFixed(4)})`; }));
      const entry = stageH * 0.5;
      const y0 = centerY(0) + entry;
      let t = 0.1, prev = y0, letras: number[] = [], ini = 0, fin = 0;
      const move = 0.7, dwell = 1.25;
      for (let k = 0; k < 7; k++) {
        const mv = k === 0 ? 0.5 : move;
        vuelo.push({ at: t, dur: mv, ease: k === 0 ? E.p2o : E.p2io, de: prev, a: centerY(k) });
        prev = centerY(k);
        const ca = t + mv, c = rd[k], ci = ca - 0.12;
        act.push(ca - 0.14);
        if (c.skel) { const s = c.skel; tw(k, ci, 0.3, E.p1o, (v) => { s.style.opacity = (1 - v).toFixed(3); }); }
        c.heads.forEach((h) => tw(k, ci, 0.2, E.p1o, (v) => { h.style.opacity = v.toFixed(3); }));
        let dur = 0.9;
        if (k === 0) { reveal(k, c.ins, ci); dur = 0.9; }
        else if (k === 1) {
          reveal(k, c.ins, ci);
          const j = c.jonhl!; tw(k, ci + 0.7, 0.5, E.p2o, (v) => { j.style.opacity = v.toFixed(3); });
          dur = 1.2;
        } else if (k === 2) {
          reveal(k, c.ins, ci, 0, 0.5);
          popIn(k, c.pops, ci + 0.2);
          const b = ci + 0.35, gap = 0.42, ln = c.line!;
          tw(k, b, 2 * gap + 0.45, E.p2io, (v) => { ln.style.transform = `scaleY(${v.toFixed(4)})`; });
          c.acts.forEach((a, i) => tw(k, b + i * gap, 0.45, E.p3o, (v) => { a.style.opacity = v.toFixed(3); a.style.transform = `translateY(${((1 - v) * 8).toFixed(2)}px)`; }));
          c.dots.forEach((d, i) => tw(k, b + i * gap, 0.45, E.back(2.4), (v) => { d.style.transform = `scale(${v.toFixed(4)})`; }));
          dur = 0.35 + 2 * gap + 0.45;
        } else if (k === 3) { reveal(k, c.ins, ci, 0.12); popIn(k, c.pops, ci + 0.5); dur = 1.1; }
        else if (k === 4) {
          reveal(k, c.ins, ci, 0.12, 0.5);
          ini = ca + 0.75;
          let ct = 0;
          letras = [];
          for (let i = 0; i < MENSAJE.length; i++) {
            letras.push(ini + ct);
            const ch = MENSAJE[i];
            let dd = 0.014 + (MENSAJE.charCodeAt(i) % 5) * 0.004;
            if (ch === ' ') dd += 0.008;
            if (ch === ',' || ch === ';') dd += 0.07;
            if (ch === '.' || ch === '?' || ch === '!') dd += 0.13;
            ct += dd;
          }
          fin = ini + ct;
          tw(k, fin + 0.45, 0.22, (x) => x, (v) => { const p = v < 0.5 ? E.p2io(v * 2) : E.p2io((1 - v) * 2); btn.style.transform = `scale(${(1 - 0.05 * p).toFixed(4)})`; });
          tw(k, fin + 0.57, 0.18, E.p1o, (v) => { btnD.style.opacity = (1 - v).toFixed(3); btnS.style.opacity = v.toFixed(3); });
          tw(k, fin + 0.57, 0.28, E.p1o, (v) => { btn.style.backgroundColor = `rgba(${Math.round(67 + (11 - 67) * v)},${Math.round(27 + (183 - 27) * v)},${Math.round(68 + (131 - 68) * v)},${(1 + (0.15 - 1) * v).toFixed(3)})`; });
          dur = 0.7 + ct + 1.3;
        } else if (k === 5) { reveal(k, c.ins, ci, 0.14); dur = 1.0; }
        else { reveal(k, c.ins, ci, 0.14); popIn(k, c.pops, ci + 0.5); dur = 1.1; }
        t += mv + dur + dwell;
      }
      vuelo.push({ at: t, dur: 0.5, ease: E.p2i, de: prev, a: centerY(6) - stageH * 0.55 });
      G = { tws, vuelo, act, total: t + 0.62, y0, letras, ini, fin, parpadeos: Math.round((fin - ini) / 0.9), spacing };
    };

    // un fotograma: la posición de la cinta, la profundidad de cada tarjeta y el contenido que toca
    const pintar = (tt: number) => {
      const t = tt % G.total;
      let y = G.y0;
      for (const v of G.vuelo) { if (t < v.at) break; y = v.de + (v.a - v.de) * v.ease(cl((t - v.at) / v.dur)); }
      feed.style.transform = `translateY(${y.toFixed(2)}px)`;
      let activeK = -1;
      G.act.forEach((a, k) => { if (t >= a) activeK = k; });
      rd.forEach((c, k) => {
        const d = cl((Math.abs(c.el.offsetTop + c.el.offsetHeight / 2 + y - 304) - 26) / (G.spacing * 0.8));
        c.el.style.opacity = (1 - 0.72 * d).toFixed(3);
        c.el.style.filter = lg.matches && d >= 0.02 ? `blur(${(d * 5).toFixed(2)}px)` : 'none';
        c.el.style.transform = `scale(${(1 - 0.05 * d).toFixed(3)})`;
        // base: esqueleto a la vista y contenido oculto (como las que aún no han llegado)
        if (c.skel) c.skel.style.opacity = '1';
        c.heads.forEach((h) => (h.style.opacity = '0'));
        c.ins.forEach((it) => { it.style.opacity = '0'; it.style.transform = 'translateY(16px) scale(0.9)'; });
        c.acts.forEach((it) => { it.style.opacity = '0'; it.style.transform = 'translateY(10px)'; });
        c.dots.forEach((it) => (it.style.transform = 'scale(0)'));
        if (c.line) c.line.style.transform = 'scaleY(0)';
        if (c.jonhl) c.jonhl.style.opacity = '0';
        c.pops.forEach((it) => { it.style.opacity = '0'; it.style.transform = 'scale(0.6)'; });
      });
      // la tarjeta del mensaje vuelve a su estado de salida en cada vuelta
      btn.style.transform = 'scale(1)'; btn.style.backgroundColor = '#431b44'; btnD.style.opacity = '1'; btnS.style.opacity = '0'; caret.style.opacity = '0';
      // las ya activadas (y la activa) reciben su guion: las pasadas quedan en su estado final
      for (const w of G.tws) if (w.k <= activeK && t >= w.at) w.f(w.ease(cl((t - w.at) / w.dur)));
      let n = 0;
      if (activeK >= 4) { for (const l of G.letras) { if (t >= l) n++; else break; } }
      const txt = MENSAJE.slice(0, n);
      if (typed.textContent !== txt) typed.textContent = txt;
      if (activeK === 4 && t >= G.ini && t < G.fin + 0.05) {
        const s = Math.floor((t - G.ini) / 0.45);
        caret.style.opacity = s <= 2 * G.parpadeos && s % 2 === 0 ? '1' : '0';
      }
    };

    // el punto del eyebrow: vaivén senoidal de 1,2 s (periodo 2,4 s); el punto a ×1,35 y el halo a ×3 apagándose
    const latir = (late: number) => {
      puntos.forEach((p) => (p.style.transform = `scale(${(1 + 0.35 * late).toFixed(4)})`));
      halos.forEach((h) => { h.style.transform = `scale(${(1 + 2 * late).toFixed(4)})`; h.style.opacity = (1 - late).toFixed(4); });
    };

    let listo = false;
    const arrancar = () => {
      montar();
      listo = true;
      if (caja) { pintar(0); latir(0); return; }
      if (fijo !== null) { pintar(fijo); latir(0.991); return; }
      if (reducido) { pintar(G.act[1] + 2); return; }
      const t0 = performance.now();
      const frame = (now: number) => {
        const s = (now - t0) / 1000;
        pintar(s);
        const f = (s % 2.4) / 1.2;
        latir(E.sine(f <= 1 ? f : 2 - f));
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    };
    // las alturas dependen de las fuentes: se mide cuando han cargado
    document.fonts.ready.then(arrancar);
    // la API para quien la lleve dentro (la película de savvia agentic): la cinta en el segundo `t` de SU reloj y el punto en `late` (0–1)
    (raiz as HTMLElement & { __nh?: unknown }).__nh = {
      pintar: (t: number) => { if (listo) pintar(Math.max(0, t)); },
      latir,
      get escala() { return escala; },
      remedir: () => { if (listo) montar(); },
      // la marquesina de clientes (55 px/s, en bucle sin costura) en el segundo `t`
      marquesina: (t: number) => { if (!pista) return; const loop = (pista.children[5] as HTMLElement).offsetLeft; pista.style.transform = `translateX(${(-((Math.max(0, t) * 55) % loop)).toFixed(2)}px)`; },
      // el scroll de la página (px de la tablet): la barra pegada con su desenfoque en cuanto se pega (20 px) y la hamburguesa, fija
      desplazar: (y: number) => {
        raiz.scrollTop = y;
        if (hamb) hamb.style.transform = `translateY(${raiz.scrollTop.toFixed(2)}px)`;
        navBlur?.classList.toggle('on', raiz.scrollTop >= 20);
      },
    };

    // la pastilla blanca del menú que sigue al cursor
    const menu = raiz.querySelector<HTMLElement>('[data-menu]')!;
    const pas = raiz.querySelector<HTMLElement>('[data-pastilla]')!;
    menu.addEventListener('mouseover', (e) => {
      const it = (e.target as HTMLElement).closest<HTMLElement>('[data-navitem]');
      if (!it) return;
      pas.style.height = `${it.offsetHeight}px`;
      pas.style.width = `${it.offsetWidth}px`;
      pas.style.translate = `${it.offsetLeft}px ${it.offsetTop}px`;
      pas.style.opacity = '1';
    });
    menu.addEventListener('mouseleave', () => (pas.style.opacity = '0'));
  }
</script>
