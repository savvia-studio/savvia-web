<style>
  /* el «viewport» de la réplica: sus cortes responden a esta caja (container queries), no a la ventana */
  .nh-vp { container: nh / size; position: relative; width: 100%; height: 100svh; }
  .nh-vp.caja { position: absolute; left: 0; top: 0; width: 768px; height: 864px; transform: scale(var(--nh-s, 0.75)); transform-origin: 0 0; overflow: hidden; }
  .caja .nh-main { min-height: 100%; background: transparent; }
  /* el scroll de la película: la caja es el contenedor que se desplaza; la barra se queda pegada (sticky) y su banda de desenfoque y
