---
import Cta from '../Cta.astro';
import { icono } from '../../lib/iconos';
import { flecha } from '../../lib/flecha';
// RONDA 128 · EL LABORATORIO, sobre matthewvernon.co (lienzo que se recorre, ventanas de archivo, selector de fondo).
// RONDA 129 · Andoni: «el usuario elige el color de fondo como en la página de referencia. Es un loop infinito y cuando te mueves hacia los lados es
// como que se distorsionan un poco los proyectos, como si cogieras velocidad. El logo y menú superior en color-dodge. Lo del laboratorio, savvia lab,
// una card de cristal que deje ver lo de detrás. Y unir todos los proyectos con raíces que salen de la card del lab».
// · MUNDO EN BUCLE: ya no es un scroll nativo: una cámara recorre un mundo de W × H que se repite. Cada pieza se pinta UNA vez, en la copia que cae
//   más cerca del centro de la pantalla (W y H son siempre mayores que la pantalla + la pieza más grande: el salto ocurre fuera de la vista).
//   Rueda / trackpad, arrastre (con inercia al soltar), dedo y flechas. Si la página ya bajó (hacia el pie), la rueda y el dedo vuelven a la página.
// · VELOCIDAD: cada pieza persigue la velocidad del contenido con su propio retardo y se inclina y estira en la dirección del movimiento; en reposo
//   vuelve a su forma. Solo transform. Movimiento reducido: sin distorsión ni inercia.
// · RAÍCES: un lienzo 2D detrás de todo; de la card de cristal sale una raíz a cada proyecto (curva que se afina, con raicillas laterales y el
//   extremo abierto en dos), en la tinta del fondo; siguen a las piezas y se apagan antes de que una pieza dé la vuelta al mundo.
// · FONDO: un deslizador como el de la referencia («Choose Background Color») con la paleta de savvia (Rosa niebla → Salvia → Cobalto → Coral →
//   Nogal → Cacao) interpolada en OKLab; la tinta (Cacao o Rosa niebla) se elige por luminancia. Se recuerda (localStorage «savvia:lab-fondo»).
// · La barra (logo y menú) va en blanco con mix-blend-mode: difference (lab.astro; r130): siempre el contrario del fondo, sin placas.
// · Sin `translate:` junto a `transform:` (ronda 119).
// RONDA 132 · solo tres experimentos (Gravitas, Think Clearly, Skale), más grandes, cada uno con su línea y su web. Para que el lienzo infinito no
// tenga huecos, el mundo es más pequeño (src/data/lab.ts › mundo) y cada experimento aparece dos veces por vuelta. Clic = se abre en grande, con el
// enlace a su web (pestaña nueva). Fuera las notas sueltas.
import { mundo } from '../../data/lab';
import { labDe } from '../../data/idioma';
import { langDe } from '../../lib/i18n';
const lang = langDe(Astro.currentLocale);
const en = lang === 'en';
const { experimentos, lab } = labDe(lang);
const M = '/media/lab/';
const piezas = experimentos
  .flatMap((e, i) => e.lienzo.map((l, c) => ({ i, c, x: l.x, y: l.y, w: l.w, mx: l.m.x, my: l.m.y })))
  .sort((a, b) => Math.hypot(a.x + a.w / 2, a.y) - Math.hypot(b.x + b.w / 2, b.y));
---

<section class="lab surface-light" aria-labelledby="lab-h" data-lab>
  <canvas class="raices" aria-hidden="true" data-raices></canvas>
  <div class="mundo" tabindex="0" aria-label={en ? 'savvia lab canvas: drag, scroll or use the arrow keys to explore; it never ends' : 'Lienzo de savvia lab: arrastra, desliza o usa las flechas para explorar; no tiene fin'} data-mundo>
    {
      piezas.map((p, k) => {
        const e = experimentos[p.i];
        return (
          <article
            class="pieza"
            tabindex="0"
            aria-label={`${e.nombre}. ${e.que} ${en ? 'Open up close' : 'Abrir de cerca'}`}
            data-pieza
            data-esp={p.i}
            data-x={p.x}
            data-y={p.y}
            data-mx={p.mx}
            data-my={p.my}
            style={`--w:${p.w};--ar:${e.ar};--z:${k + 1};--d:${(k * 0.08).toFixed(2)}s`}
          >
            <header class="cab">
              <span class="archivo font-display">{e.nombre}</span>
              <span class="pill">{e.dominio}</span>
            </header>
            <div class="cuerpo">
              <video muted loop playsinline preload="none" poster={`${M}${e.slug}.jpg`} data-src={`${M}${e.slug}.mp4`} aria-hidden="true" />
              <button type="button" class="ver" data-ver aria-label={`${en ? 'Play' : 'Reproducir'} ${e.nombre}`}>
                <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 2l7 4-7 4z" /></svg>
              </button>
            </div>
            <p class="linea">{e.que}</p>
          </article>
        );
      })
    }
  </div>

  <div class="hola" data-hola>
    <!-- RONDA 307, 24.ª · Andoni: «en la tarjeta del centro, únicamente el título savvia lab y el subtítulo» (fuera la cabecera de archivo y el registro) -->
    <div class="hola-c">
      <h1 id="lab-h" class="font-display titular">{lab.titulo}</h1>
      <p class="sub">{lab.sub}</p>
    </div>
  </div>
  <p class="pista" aria-hidden="true" data-pista>
    <svg viewBox="0 0 16 16"><path d="M8 1v14M1 8h14M8 1l-2 2M8 1l2 2M8 15l-2-2M8 15l2-2M1 8l2-2M1 8l2 2M15 8l-2-2M15 8l-2 2" /></svg>
    <span class="solo-raton">{lab.ayuda}</span><span class="solo-tactil">{lab.ayudaTactil}</span>
  </p>

  <div class="fondos" data-fondos>
    <!-- 29/10 · Eric: «en mobile esto molesta»: en móvil, plegado en una muestra redonda del color; al tocarla se abre -->
    <button type="button" class="fondos-boton" aria-expanded="false" aria-label={en ? 'Choose the background' : 'Elige el fondo'} data-fondos-boton></button>
    <span class="fondos-t" id="fondo-t">{en ? 'Choose the background' : 'Elige el fondo'}</span>
    <div class="pista-color" data-pista-color>
      <span
        class="tirador"
        role="slider"
        tabindex="0"
        aria-labelledby="fondo-t"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        aria-valuetext={en ? 'Mist pink' : 'Rosa niebla'}
        data-tirador></span>
    </div>
  </div>

  <Cta href="#contacto" class="al-pie" variante="secundario" tam="sm" flecha="abajo">{en ? 'Contact' : 'Contacto'}</Cta>

</section>

<dialog class="lupa surface-light" data-lupa aria-labelledby="lupa-h">
  <div class="lupa-in">
    <!-- 29/10 · Eric: «enmárcalo en mockup como tenemos nosotros, en marco de cristal»: la ventana de cristal de los proyectos (obra/Pieza.astro › .mockup) -->
    <div class="lupa-pant"><div class="lupa-marco" data-lupa-marco><video muted loop playsinline preload="none" data-lupa-video></video></div></div>
    <div>
      <h2 id="lupa-h" class="font-display lupa-nombre" data-lupa-nombre></h2>
      <p class="lupa-que" data-lupa-que></p>
      <!-- 29/10 · Eric: «que esto sea slider, que pases de uno a otro» · «reutiliza slider»: las flechas de cristal del visor de proyectos (obra/Visor.astro) -->
      <div class="lupa-pie">
        <Cta class="ir" href="#" variante="secundario" externo data-lupa-ir>{lab.abrir}</Cta>
        <div class="barra-cristal" role="group" aria-label={en ? 'Experiments' : 'Experimentos'}>
          <button type="button" class="paso" aria-label={en ? 'Previous experiment' : 'Experimento anterior'} data-lupa-paso="-1"><Fragment set:html={flecha('izq')} /></button>
          <button type="button" class="paso" aria-label={en ? 'Next experiment' : 'Experimento siguiente'} data-lupa-paso="1"><Fragment set:html={flecha()} /></button>
        </div>
      </div>
    </div>
    <!-- 28/10 · Andoni: «la (x) de cerrar, más acorde al estilo de la web y animada»: la × redonda en el papel de la tarjeta, animada -->
    <button type="button" class="cerrar" data-lupa-cerrar aria-label={en ? 'Close' : 'Cerrar'}><Fragment set:html={icono('x', 'regular')} /></button>
  </div>
</dialog>

<script>
  import { jugar } from '../../scripts/jugar';
  import { mundo as MUNDO, mundoMovil as MUNDO_M } from '../../data/lab';
  import { labDe } from '../../data/idioma';
  import { t, EN } from '../../scripts/i18n';
  const { experimentos } = labDe(EN ? 'en' : 'es');
  const sec = document.querySelector<HTMLElement>('[data-lab]')!;
  const mundo = sec.querySelector<HTMLElement>('[data-mundo]')!;
  const lienzo = sec.querySelector<HTMLCanvasElement>('[data-raices]')!;
  const ctx = lienzo.getContext('2d')!;
  const hola = sec.querySelector<HTMLElement>('[data-hola]')!;
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const raton = matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (reducido) sec.classList.add('quieta');
  if (!raton) sec.classList.add('tactil');
  const html = document.documentElement;
  const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

  // ───────────────────────── el FONDO: deslizador con la paleta de savvia, interpolada en OKLab ─────────────────────────
  const PARADAS: [string, string][] = [
    [t('Rosa niebla', 'Mist pink'), '#eadde7'],
    [t('Salvia', 'Sage'), '#96bfe6'],
    [t('Cobalto', 'Cobalt'), '#3456d3'],
    [t('Coral', 'Coral'), '#ff616b'],
    [t('Nogal', 'Walnut'), '#63402f'],
    [t('Cacao', 'Cocoa'), '#302018'],
  ];
  const lin = (c: number) => (c <= 0.04045 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
  const gam = (c: number) => (c <= 0.0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - 0.055);
  const hexRgb = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  const aLab = ([r, g, b]: number[]) => {
    const R = lin(r), G = lin(g), B = lin(b);
    const l = Math.cbrt(0.4122214708 * R + 0.5363325363 * G + 0.0514459929 * B);
    const m = Math.cbrt(0.2119034982 * R + 0.6806995451 * G + 0.1073969566 * B);
    const s = Math.cbrt(0.0883024619 * R + 0.2817188376 * G + 0.6299787005 * B);
    return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];
  };
  const deLab = ([L, a, b]: number[]) => {
    const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3, m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3, s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
    return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s, -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s].map((c) => clamp(gam(c), 0, 1));
  };
  const LABS = PARADAS.map(([, h]) => aLab(hexRgb(h)));
  const aHex = (rgb: number[]) => '#' + rgb.map((c) => Math.round(c * 255).toString(16).padStart(2, '0')).join('');
  const luz = (rgb: number[]) => 0.2126 * lin(rgb[0]) + 0.7152 * lin(rgb[1]) + 0.0722 * lin(rgb[2]);
  let tinta = hexRgb('#302018');
  function colorEn(t: number) {
    const f = clamp(t, 0, 0.99999) * (LABS.length - 1), i = Math.floor(f), u = f - i;
    const a = LABS[i], b = LABS[i + 1];
    return deLab([a[0] + (b[0] - a[0]) * u, a[1] + (b[1] - a[1]) * u, a[2] + (b[2] - a[2]) * u]);
  }
  const pistaColor = sec.querySelector<HTMLElement>('[data-pista-color]')!;
  const tirador = sec.querySelector<HTMLElement>('[data-tirador]')!;
  let tFondo = 0;
  function ponerFondo(t: number, guardar = true) {
    tFondo = clamp(t, 0, 1);
    const rgb = colorEn(tFondo), Y = luz(rgb), oscuro = Y < 0.2;
    const hex = aHex(rgb), ti = oscuro ? '#eadde7' : '#302018';
    tinta = hexRgb(ti);
    html.style.setProperty('--lab-fondo', hex);
    html.style.setProperty('--lab-tinta', ti);
    html.classList.toggle('lab-oscuro', oscuro);
    tirador.style.left = `${tFondo * 100}%`;
    tirador.style.setProperty('--c', hex);
    tirador.setAttribute('aria-valuenow', String(Math.round(tFondo * 100)));
    tirador.setAttribute('aria-valuetext', PARADAS[Math.round(tFondo * (PARADAS.length - 1))][0]);
    if (guardar) { try { localStorage.setItem('savvia:lab-fondo', JSON.stringify({ t: tFondo, c: hex, ti, o: oscuro })); } catch {} }
    despertar();
  }
  let tiraId = -1;
  const tDe = (x: number) => { const r = pistaColor.getBoundingClientRect(); return (x - r.left) / r.width; };
  pistaColor.addEventListener('pointerdown', (ev) => {
    tiraId = ev.pointerId; try { pistaColor.setPointerCapture(tiraId); } catch {} ponerFondo(tDe(ev.clientX)); tirador.focus({ preventScroll: true });
  });
  pistaColor.addEventListener('pointermove', (ev) => { if (ev.pointerId === tiraId) ponerFondo(tDe(ev.clientX)); });
  const soltarTira = (ev: PointerEvent) => { if (ev.pointerId === tiraId) tiraId = -1; };
  pistaColor.addEventListener('pointerup', soltarTira);
  pistaColor.addEventListener('pointercancel', soltarTira);
  const fondos = sec.querySelector<HTMLElement>('[data-fondos]')!, fondosBoton = sec.querySelector<HTMLElement>('[data-fondos-boton]')!;
  const plegar = (abierto: boolean) => { fondos.classList.toggle('abierto', abierto); fondosBoton.setAttribute('aria-expanded', String(abierto)); };
  fondosBoton.addEventListener('click', () => { plegar(true); tirador.focus({ preventScroll: true }); });
  document.addEventListener('pointerdown', (ev) => { if (fondos.classList.contains('abierto') && !fondos.contains(ev.target as Node)) plegar(false); });
  tirador.addEventListener('keydown', (ev) => {
    if (ev.key === 'Escape') { plegar(false); fondosBoton.focus(); return; }
    const paso = ev.shiftKey ? 0.2 : 0.02;
    if (ev.key === 'Home') { ev.preventDefault(); ponerFondo(0); return; }
    if (ev.key === 'End') { ev.preventDefault(); ponerFondo(1); return; }
    const d = ({ ArrowLeft: -paso, ArrowDown: -paso, ArrowRight: paso, ArrowUp: paso } as Record<string, number>)[ev.key];
    if (d === undefined) return;
    ev.preventDefault(); ponerFondo(tFondo + d);
  });

  // ───────────────────────── el MUNDO en bucle ─────────────────────────
  type P = { el: HTMLElement; esp: boolean; x: number; y: number; w: number; h: number; dx: number; dy: number; vx: number; vy: number; lag: number; semilla: number; ult: string };
  const els = [...mundo.querySelectorAll<HTMLElement>('[data-pieza]')];
  // k = escala de las tarjetas; z = ZOOM de la cámara (29/10 · Eric: «en mobile, que se pueda zoom out»: se pellizca)
  let k = 1, z = 1, zMin = 1, zMax = 1, W = 3200, H = 1900, vw = innerWidth, vh = innerHeight;
  const ps: P[] = els.map((el, i) => ({
    el, esp: !!el.dataset.esp, x: +el.dataset.x!, y: +el.dataset.y!, w: 0, h: 0, dx: 0, dy: 0, vx: 0, vy: 0,
    lag: 0.07 + (((i * 37) % 11) / 11) * 0.09, semilla: ((i * 9301 + 49297) % 233280) / 233280, ult: '',
  }));
  const cam = { x: 0, y: 0 }, meta = { x: 0, y: 0 }, prev = { x: 0, y: 0 };
  let fling = { x: 0, y: 0 };
  let holaR = new DOMRect(), secTop = 0;
  function medir() {
    vw = sec.clientWidth; vh = sec.clientHeight;
    k = vw < 900 ? 0.62 : 1;
    // 29/10 · Eric: «en lab los proyectos se solapan en el iPhone 13 mini». El mundo de móvil encogía con el alto de la pantalla y las copias se pisaban
    // al dar la vuelta. Ahora el móvil tiene su rejilla (lab.ts › m) en un mundo FIJO (lab.ts › mundoMovil), en px de móvil.
    const movil = k < 1, M = movil ? MUNDO_M : MUNDO;
    ps.forEach((p) => { const d = p.el.dataset; p.x = movil ? +d.mx! : +d.x!; p.y = movil ? +d.my! : +d.y!; });
    let maxW = 0, maxH = 0;
    ps.forEach((p) => { p.w = p.el.offsetWidth; p.h = p.el.offsetHeight; maxW = Math.max(maxW, p.w); maxH = Math.max(maxH, p.h); });
    // el mundo: el diseño (lab.ts › mundo), pero siempre mayor que la pantalla + la pieza más grande (una sola copia por pieza)
    W = Math.max(M.w, vw + maxW + 120);
    H = Math.max(M.h, vh + maxH + 120);
    // el zoom: alejarse solo hasta donde el mundo sigue sin verse dar la vuelta (pantalla / z + pieza + margen ≤ mundo); en escritorio, sin zoom
    zMin = k < 1 ? clamp(Math.max(vw / (W - maxW - 120), vh / (H - maxH - 120)), 0.5, 1) : 1;
    zMax = k < 1 ? 1.4 : 1;
    z = clamp(z, zMin, zMax);
    const dpr = Math.min(2, devicePixelRatio || 1);
    lienzo.width = Math.round(vw * dpr); lienzo.height = Math.round(vh * dpr);
    lienzo.style.width = vw + 'px'; lienzo.style.height = vh + 'px';
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const sr = sec.getBoundingClientRect(); secTop = sr.top + scrollY;
    const r = hola.getBoundingClientRect();
    holaR = new DOMRect(r.left - sr.left, r.top - sr.top, r.width, r.height);
    ps.forEach((p) => (p.ult = ''));
  }
  const cerca = (v: number, L: number) => v - L * Math.round(v / L); // la copia más cercana a 0

  // 29/10 · Eric: «si deslizas o pellizcas, que eso se vaya»: la pista se va con el primer gesto que recorre el lienzo (y no vuelve)
  const explorado = () => sec.classList.add('explorado');
  // ── recorrer: rueda / trackpad ──
  const libre = () => scrollY > secTop + 2; // la página ya bajó: la rueda y el dedo vuelven a ella
  mundo.addEventListener('wheel', (ev) => {
    if (ev.ctrlKey || libre()) return;
    ev.preventDefault();
    const f = ev.deltaMode === 1 ? 32 : ev.deltaMode === 2 ? vh : 1;
    const horiz = ev.shiftKey && !ev.deltaX;
    explorado();
    meta.x += (horiz ? ev.deltaY : ev.deltaX) * f; meta.y += (horiz ? 0 : ev.deltaY) * f;
    if (reducido) { cam.x = meta.x; cam.y = meta.y; }
    fling = { x: 0, y: 0 };
    despertar();
  }, { passive: false });
  addEventListener('scroll', () => sec.classList.toggle('libre', libre()), { passive: true });

  // ── recorrer: arrastre (ratón, lápiz, dedo); con ratón, una pieza se puede coger y mover ──
  let modo: '' | 'pan' | 'pieza' | 'zoom' = '', pid = -1, sx0 = 0, sy0 = 0, mx0 = 0, my0 = 0, movido = false, zTop = ps.length + 1;
  let cogida: P | null = null, tocada: P | null = null;
  let muestras: { t: number; x: number; y: number }[] = [];
  // ── pellizco (dos dedos): el zoom gira en torno al punto medio de los dedos, que además arrastra ──
  const dedos = new Map<number, { x: number; y: number }>();
  let pz0 = { d: 1, z: 1, wx: 0, wy: 0 };
  const medio = () => { const [a, b] = [...dedos.values()]; return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2, d: Math.hypot(a.x - b.x, a.y - b.y) || 1 }; };
  function empezarZoom() {
    const m = medio();
    pz0 = { d: m.d, z, wx: cam.x + (m.x - vw / 2) / z, wy: cam.y + (m.y - secTopVista() - vh / 2) / z };
    cogida?.el.classList.remove('cogida');
    explorado();
    modo = 'zoom'; movido = true; tocada = null; cogida = null; fling = { x: 0, y: 0 };
    sec.classList.add('paneando');
  }
  const secTopVista = () => secTop - scrollY;
  mundo.addEventListener('gesturestart', (ev) => ev.preventDefault()); // Safari: que el pellizco no amplíe la página
  mundo.addEventListener('pointerdown', (ev) => {
    if (ev.pointerType === 'touch' && zMax > zMin && !libre()) {
      dedos.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });
      if (dedos.size === 2 && modo !== 'zoom') { try { mundo.setPointerCapture(ev.pointerId); } catch {} empezarZoom(); despertar(); return; }
    }
    if (ev.button > 0 || modo) return;
    const objetivo = ev.target as HTMLElement;
    if (objetivo.closest('[data-ver]')) return;
    if (ev.pointerType === 'touch' && libre()) return;
    const el = objetivo.closest<HTMLElement>('[data-pieza]');
    tocada = el ? ps.find((p) => p.el === el) ?? null : null;
    pid = ev.pointerId; sx0 = ev.clientX; sy0 = ev.clientY; movido = false; muestras = [{ t: performance.now(), x: ev.clientX, y: ev.clientY }];
    if (tocada && ev.pointerType !== 'touch') { modo = 'pieza'; cogida = tocada; mx0 = tocada.dx; my0 = tocada.dy; tocada.el.style.setProperty('--z', String(++zTop)); }
    else { modo = 'pan'; mx0 = meta.x; my0 = meta.y; fling = { x: 0, y: 0 }; }
    try { mundo.setPointerCapture(pid); } catch {}
    despertar();
  });
  mundo.addEventListener('pointermove', (ev) => {
    if (dedos.has(ev.pointerId)) dedos.set(ev.pointerId, { x: ev.clientX, y: ev.clientY });
    if (modo === 'zoom') {
      if (dedos.size < 2) return;
      const m = medio();
      z = clamp(pz0.z * (m.d / pz0.d), zMin, zMax);
      meta.x = cam.x = pz0.wx - (m.x - vw / 2) / z; meta.y = cam.y = pz0.wy - (m.y - secTopVista() - vh / 2) / z;
      ps.forEach((p) => (p.ult = ''));
      despertar();
      return;
    }
    if (ev.pointerId !== pid) return;
    const dx = ev.clientX - sx0, dy = ev.clientY - sy0;
    if (!movido && Math.hypot(dx, dy) < 5) return;
    if (!movido) { movido = true; if (modo === 'pan') explorado(); sec.classList.add(modo === 'pan' ? 'paneando' : 'cogiendo'); cogida?.el.classList.add('cogida'); }
    if (modo === 'pan') {
