  }).observe(sec);
  document.addEventListener('visibilitychange', () => { visible = !document.hidden; if (visible) despertar(); });

  // ───────────────────────── la lupa ─────────────────────────
  const lupa = document.querySelector<HTMLDialogElement>('[data-lupa]')!;
  const lv = lupa.querySelector<HTMLVideoElement>('[data-lupa-video]')!;
  const marco = lupa.querySelector<HTMLElement>('[data-lupa-marco]')!;
  let desde: HTMLElement | null = null, cur = 0;
  function pintar(i: number) {
    cur = (i + experimentos.length) % experimentos.length;
    const e = experimentos[cur];
    lupa.querySelector('[data-lupa-nombre]')!.textContent = e.nombre;
    lupa.querySelector('[data-lupa-que]')!.textContent = e.que;
    lupa.querySelector<HTMLAnchorElement>('[data-lupa-ir]')!.href = e.url;
    lv.poster = `/media/lab/${e.slug}.jpg`;
    lv.src = `/media/lab/${e.slug}.mp4`;
    marco.style.setProperty('--ar', String(e.ar));
    if (!reducido) jugar(lv);
  }
  function abrir(i: number, p: HTMLElement) {
    desde = p;
    pintar(i);
    lupa.showModal();
  }
  // el paso, como en el visor: flechas, teclas ← → y deslizar el dedo sobre el mockup (48 px y más de lado que de alto); el nuevo entra con un fundido
  function ir(d: number) {
    if (reducido) { pintar(cur + d); return; }
    lupa.classList.add('cambia');
    window.setTimeout(() => { pintar(cur + d); lupa.classList.remove('cambia'); }, 180);
  }
  lupa.querySelectorAll<HTMLElement>('[data-lupa-paso]').forEach((b) => b.addEventListener('click', () => ir(Number(b.dataset.lupaPaso))));
  lupa.addEventListener('keydown', (ev) => {
    if (ev.key === 'ArrowRight') { ev.preventDefault(); ir(1); }
    else if (ev.key === 'ArrowLeft') { ev.preventDefault(); ir(-1); }
  });
  {
    let x0 = 0, y0 = 0, seguir = false;
    marco.addEventListener('pointerdown', (ev) => { x0 = ev.clientX; y0 = ev.clientY; seguir = ev.pointerType !== 'mouse'; });
    marco.addEventListener('pointerup', (ev) => {
      if (!seguir) return;
      seguir = false;
      const dx = ev.clientX - x0, dy = ev.clientY - y0;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy) * 1.4) ir(dx < 0 ? 1 : -1);
    });
  }
  lupa.querySelector('[data-lupa-cerrar]')!.addEventListener('click', () => lupa.close());
  lupa.addEventListener('click', (ev) => { if (ev.target === lupa) lupa.close(); });
  lupa.addEventListener('close', () => {
    lv.pause();
    lv.removeAttribute('src');
    lv.load();
    desde?.focus({ preventScroll: true });
  });

  // sonda para las pruebas
  (window as any).__lab = { cam, meta, ps, pos, get W() { return W; }, get H() { return H; }, get z() { return z; }, get zMin() { return zMin; }, ponerFondo };

  {
    let tIni = 0;
    try { const g = JSON.parse(localStorage.getItem('savvia:lab-fondo') || 'null'); if (g && typeof g.t === 'number') tIni = g.t; } catch {}
    ponerFondo(tIni, false);
  }
  medir();
  requestAnimationFrame(() => { medir(); sec.classList.add('entra'); despertar(); });
  document.fonts?.ready.then(() => { medir(); despertar(); });
  let rz = 0;
  addEventListener('resize', () => { clearTimeout(rz); rz = window.setTimeout(() => { medir(); despertar(); }, 120); });
</script>

