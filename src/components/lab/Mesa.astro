      fling = { x: clamp((-(b.x - a.x) / dt / z) * 16, -70, 70), y: clamp((-(b.y - a.y) / dt / z) * 16, -70, 70) };
    }
    if (!movido && ev.type === 'pointerup' && tocada?.esp) abrir(+tocada.el.dataset.esp!, tocada.el);
    cogida?.el.classList.remove('cogida');
    sec.classList.remove('paneando', 'cogiendo');
    modo = ''; pid = -1; cogida = null; tocada = null;
    despertar();
  };
  mundo.addEventListener('pointerup', soltar);
  mundo.addEventListener('pointercancel', soltar);

  // ── teclado: flechas en el lienzo; Tab lleva a cada pieza y la cámara la acerca al centro; Intro la abre ──
  mundo.addEventListener('keydown', (ev) => {
    const el = (ev.target as HTMLElement).closest<HTMLElement>('[data-pieza]');
    if (el && (ev.key === 'Enter' || ev.key === ' ')) {
      if (el.dataset.esp) { ev.preventDefault(); abrir(+el.dataset.esp, el); }
      return;
    }
    const paso = ev.shiftKey ? 480 : 160;
    const d = ({ ArrowLeft: [-paso, 0], ArrowRight: [paso, 0], ArrowUp: [0, -paso], ArrowDown: [0, paso] } as Record<string, number[]>)[ev.key];
    if (!d) return;
    ev.preventDefault(); explorado(); meta.x += d[0]; meta.y += d[1]; despertar();
  });
  ps.forEach((p) => p.el.addEventListener('focus', () => {
    if (modo) return;
    const rx = cerca(p.x + p.w / 2 + p.dx - cam.x, W), ry = cerca(p.y + p.h / 2 + p.dy - cam.y, H);
    if (Math.abs(rx) * z > vw * 0.3 || Math.abs(ry) * z > vh * 0.3) { meta.x = cam.x + rx; meta.y = cam.y + ry * 0.9; despertar(); }
  }));

  // ───────────────────────── el bucle: cámara, distorsión por velocidad, raíces ─────────────────────────
  type Pos = { X: number; Y: number; cx: number; cy: number; f: number };
  const pos: Pos[] = ps.map(() => ({ X: 0, Y: 0, cx: 0, cy: 0, f: 1 }));
  let raf = 0, tAnt = 0, visible = true, espera = 0;
  const t0 = performance.now();
  function despertar() { if (!raf && visible) { clearTimeout(espera); tAnt = 0; raf = requestAnimationFrame(paso); } }
  function paso(ahora: number) {
    raf = 0;
    const dt = tAnt ? Math.min(50, ahora - tAnt) : 16.67, n = dt / 16.67;
    tAnt = ahora;
    if (fling.x || fling.y) {
      meta.x += fling.x * n; meta.y += fling.y * n;
      const dec = Math.pow(0.93, n); fling.x *= dec; fling.y *= dec;
      if (Math.hypot(fling.x, fling.y) < 0.15) fling = { x: 0, y: 0 };
    }
    const a = reducido ? 1 : 1 - Math.pow(0.8, n);
    cam.x += (meta.x - cam.x) * a; cam.y += (meta.y - cam.y) * a;
    // velocidad del contenido (px por fotograma de 60 Hz): el contenido va al revés que la cámara
    const cvx = -(cam.x - prev.x) / n, cvy = -(cam.y - prev.y) / n;
    prev.x = cam.x; prev.y = cam.y;
    let moviendo = Math.abs(meta.x - cam.x) + Math.abs(meta.y - cam.y) > 0.3 || !!(fling.x || fling.y) || modo !== '';
    ps.forEach((p, i) => {
      // cada pieza persigue la velocidad con su propio retardo: se deforman escalonadas, como una tela
      const b = 1 - Math.pow(1 - p.lag, n);
      p.vx += (cvx - p.vx) * b; p.vy += (cvy - p.vy) * b;
      if (Math.abs(p.vx) < 0.02) p.vx = 0;
      if (Math.abs(p.vy) < 0.02) p.vy = 0;
      if (p.vx || p.vy) moviendo = true;
      const ux = cerca(p.x + p.w / 2 + p.dx - cam.x, W), uy = cerca(p.y + p.h / 2 + p.dy - cam.y, H);
      const cx = vw / 2 + ux * z, cy = vh / 2 + uy * z;
      const X = cx - (p.w * z) / 2, Y = cy - (p.h * z) / 2;
      let t = `translate3d(${(cx - p.w / 2).toFixed(1)}px,${(cy - p.h / 2).toFixed(1)}px,0)`;
      if (z !== 1) t += ` scale(${z.toFixed(4)})`;
      if (!reducido && (p.vx || p.vy)) {
        const vx = clamp(p.vx, -70, 70), vy = clamp(p.vy, -70, 70), ax = Math.abs(vx), ay = Math.abs(vy);
        // de lado: la parte de arriba se queda atrás (inclinación) y la pieza se estira a lo largo del movimiento
        const sk = clamp(vx * 0.2, -9, 9);
        const sxx = 1 + ax * 0.0016 - ay * 0.0004, syy = 1 + ay * 0.0016 - ax * 0.0006;
        t += ` skewX(${sk.toFixed(2)}deg) scale(${sxx.toFixed(4)},${syy.toFixed(4)})`;
      }
      if (t !== p.ult) { p.el.style.transform = t; p.ult = t; }
      // las raíces se apagan antes de que la pieza dé la vuelta al mundo (el salto ocurre a W/2)
      const fx = 1 - clamp((Math.abs(ux) - W * 0.3) / (W * 0.16), 0, 1), fy = 1 - clamp((Math.abs(uy) - H * 0.3) / (H * 0.16), 0, 1);
      pos[i] = { X, Y, cx, cy, f: fx * fy };
    });
    raices(ahora);
    const creciendo = !reducido && ahora - t0 < 3000;
    if (moviendo || creciendo) raf = requestAnimationFrame(paso);
    // en reposo las raíces solo respiran: ~15 fps basta
    else if (!reducido && visible) espera = window.setTimeout(despertar, 66);
  }

  // ── raíces: de la card de cristal a cada proyecto ──
  const ruido = (s: number) => { const x = Math.sin(s * 127.1) * 43758.5453; return x - Math.floor(x); };
  function raices(ahora: number) {
    ctx.clearRect(0, 0, vw, vh);
    const tiempo = (ahora - t0) / 1000;
    const g = reducido ? 1 : clamp((ahora - t0 - 300) / 2200, 0, 1);
    const cx0 = holaR.x + holaR.width / 2, cy0 = holaR.y + holaR.height / 2;
    const [r, gg, bb] = tinta.map((c) => Math.round(c * 255));
    let n = 0;
    ps.forEach((p, i) => {
      if (!p.esp) return;
      n++;
      const q = pos[i];
      if (q.f <= 0.01) return;
      // el extremo: el borde de la pieza que mira a la card, un poco por dentro (la raíz se mete bajo la ventana)
      const ex = clamp(cx0, q.X + 14, q.X + p.w * z - 14), ey = clamp(cy0, q.Y + 10, q.Y + p.h * z - 10);
      // el origen: el borde de la card en dirección a la pieza, por dentro (la raíz sale de debajo del cristal)
      let dx = ex - cx0, dy = ey - cy0;
      const L0 = Math.hypot(dx, dy) || 1;
      dx /= L0; dy /= L0;
      const tb = Math.min((holaR.width / 2 - 22) / Math.max(1e-3, Math.abs(dx)), (holaR.height / 2 - 22) / Math.max(1e-3, Math.abs(dy)));
      const sx = cx0 + dx * tb, sy = cy0 + dy * tb;
      const L = Math.hypot(ex - sx, ey - sy);
      if (L < 30) return;
      const ux = (ex - sx) / L, uy = (ey - sy) / L, nx = -uy, ny = ux;
      const s = p.semilla * 10 + 1;
      const o1 = (ruido(s) - 0.5) * 0.5 * L + Math.sin(tiempo * 0.5 + s) * 4, o2 = (ruido(s + 3) - 0.5) * 0.42 * L + Math.sin(tiempo * 0.4 + s * 2) * 5;
      const c1x = sx + ux * L * 0.33 + nx * o1, c1y = sy + uy * L * 0.33 + ny * o1;
      const c2x = sx + ux * L * 0.7 + nx * o2, c2y = sy + uy * L * 0.7 + ny * o2;
      const fin = clamp(g * 1.6 - (n % 5) * 0.12, 0, 1);
      if (fin <= 0) return;
      ctx.fillStyle = `rgba(${r},${gg},${bb},${(0.34 * q.f).toFixed(3)})`;
      const bez = (t: number) => {
        const m = 1 - t;
        return [m * m * m * sx + 3 * m * m * t * c1x + 3 * m * t * t * c2x + t * t * t * ex, m * m * m * sy + 3 * m * m * t * c1y + 3 * m * t * t * c2y + t * t * t * ey];
      };
      const esc = (k < 1 ? 0.8 : 1) * Math.sqrt(z);
      const ancho = (t: number) => (3.4 - 2.6 * Math.pow(t, 0.7)) * esc;
      cinta(bez, ancho, 0, fin, 30);
      // raicillas: dos o tres brotes laterales que se afinan, y el extremo abierto en dos
      const nb = 2 + Math.floor(ruido(s + 7) * 2);
      for (let j = 0; j < nb; j++) {
        const tj = 0.22 + j * (0.6 / nb) + ruido(s + j * 5) * 0.12;
        if (tj > fin) continue;
        ramita(bez, tj, (ruido(s + j * 11) > 0.5 ? 1 : -1) * (0.55 + ruido(s + j) * 0.5), (16 + ruido(s + j * 3) * 26) * esc, ancho(tj) * 0.55, tiempo + j);
      }
      if (fin >= 1) { ramita(bez, 0.985, 0.42, 14 * esc, ancho(1) * 0.9, tiempo); ramita(bez, 0.985, -0.42, 11 * esc, ancho(1) * 0.9, tiempo + 1); }
    });
  }
  // una cinta que se afina a lo largo de una curva
  function cinta(f: (t: number) => number[], w: (t: number) => number, a: number, b: number, N: number) {
    const izq: number[][] = [], der: number[][] = [];
    for (let j = 0; j <= N; j++) {
      const t = a + ((b - a) * j) / N, p = f(t), p2 = f(Math.min(1, t + 0.01)), p1 = f(Math.max(0, t - 0.01));
      let tx = p2[0] - p1[0], ty = p2[1] - p1[1];
      const l = Math.hypot(tx, ty) || 1;
      tx /= l; ty /= l;
      const hw = w(t) / 2;
      izq.push([p[0] - ty * hw, p[1] + tx * hw]); der.push([p[0] + ty * hw, p[1] - tx * hw]);
    }
    ctx.beginPath();
    ctx.moveTo(izq[0][0], izq[0][1]);
    for (const q of izq) ctx.lineTo(q[0], q[1]);
    for (let j = der.length - 1; j >= 0; j--) ctx.lineTo(der[j][0], der[j][1]);
    ctx.closePath(); ctx.fill();
  }
  function ramita(f: (t: number) => number[], t: number, giro: number, largo: number, w0: number, fase: number) {
    const p = f(t), p2 = f(Math.min(1, t + 0.01)), p1 = f(Math.max(0, t - 0.01));
    const ang = Math.atan2(p2[1] - p1[1], p2[0] - p1[0]) + giro + Math.sin(fase * 0.6) * 0.04;
    const ex = p[0] + Math.cos(ang) * largo, ey = p[1] + Math.sin(ang) * largo;
    const cxx = p[0] + Math.cos(ang - giro * 0.4) * largo * 0.55, cyy = p[1] + Math.sin(ang - giro * 0.4) * largo * 0.55;
    cinta((u) => { const m = 1 - u; return [m * m * p[0] + 2 * m * u * cxx + u * u * ex, m * m * p[1] + 2 * m * u * cyy + u * u * ey]; }, (u) => Math.max(0.35, w0 * (1 - u)), 0, 1, 8);
  }

  // ───────────────────────── vídeos: solo a la vista ─────────────────────────
  // (30/10 · rendimiento en móvil con mala conexión) en pantallas estrechas, las tarjetas piden su vídeo a 720 px (`-m`: de 0,6–1,4 MB a la mitad o menos);
  // la lupa sigue con el grande
  const ligero = innerWidth < 900;
  const cargar = (v: HTMLVideoElement) => { if (!v.src && v.dataset.src) v.src = ligero ? v.dataset.src.replace(/\.mp4$/, '-m.mp4') : v.dataset.src; };
  let seVe = true;
  const vistos = new IntersectionObserver(
    (ents) => ents.forEach((en) => {
      const p = en.target as HTMLElement, v = p.querySelector('video')!;
      p.dataset.visto = en.isIntersecting ? '1' : '';
      if (seVe && en.isIntersecting && (!reducido || p.classList.contains('quiere'))) { cargar(v); jugar(v); }
      else v.pause();
    }),
    { rootMargin: '80px', threshold: 0.1 },
  );
  els.filter((p) => p.dataset.esp).forEach((p) => {
    vistos.observe(p);
    const v = p.querySelector('video')!;
    p.querySelector('[data-ver]')!.addEventListener('click', () => {
      p.classList.add('quiere');
