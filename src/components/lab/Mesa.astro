    });
  });
  new IntersectionObserver(([en]) => {
    seVe = visible = en.isIntersecting && !document.hidden;
    els.forEach((p) => {
      const v = p.querySelector('video');
      if (!v) return;
      if (seVe && p.dataset.visto && (!reducido || p.classList.contains('quiere'))) { cargar(v); jugar(v); }
