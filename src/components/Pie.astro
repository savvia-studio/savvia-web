---
// EL PIE · RONDA 83 · giro a la música. Andoni: «footer toca repensarlo por completo» → dirección A, «FIN DE LA OBRA» (elegida el 30/09).
// · La página es una partitura y aquí acaba: un PENTAGRAMA a todo el ancho del contenido que termina en la DOBLE BARRA FINAL (fina + gruesa).
// · «Contáctanos», enorme en Family, está escrito SOBRE ese pentagrama (la línea de abajo es su línea base): es la última nota de la obra.
// · El FOCO (el haz del hero) cae desde arriba sobre la palabra.
// · Al llegar: las cinco líneas se trazan de izquierda a derecha, la palabra sale del desenfoque y al final se cierra la doble barra.
// · Al pasar (o enfocar): la cuerda VIBRA, sobre la palabra se dibuja un CALDERÓN (la fermata: «sostener la nota») y de su punto sube la píldora con las
//   caras de Eric y Andoni: «Haz clic para agendar una reunión con nosotros» (ronda 81). La palabra se ilumina en degradado de izquierda a derecha (ronda 81).
//   Si el sonido de la web está encendido, suena el acorde final (el de la estación: el de la carga).
// · Abajo, la línea mono y el CRÉDITO de la música de Proyectos (Vivaldi, CC BY-SA 4.0: la atribución es obligatoria).
// Antes (rondas 20–82): el paisaje por capas con estaciones y el «Contáctanos» partido entre montañas (tools/retirados/Pie.r82.astro.txt).
import { pie, nav } from '../data/home';
const year = new Date().getFullYear();
---

<footer id="contacto" class="surface-dark pie" data-sube data-pie>
  <!-- RONDA 100 · «en el footer, lo mismo: el pulso se tiene que propagar por todo el footer»: la retícula de puntos que late (src/scripts/reticula.ts) -->
  <!-- RONDA 117 · la terraza que desvelan los pulsos ocupa TODO el pie; por arriba se deshace en trazos horizontales (máscara generada) para no parecer cortada -->
  <!-- RONDA 117 (4.ª) · «del footer anterior me gustaba que el fondo se pintaba al llegar»: la terraza en gris la PINTA el motor del roble (líneas → pintura rasgada desde
       el centro de abajo); encima, los pulsos de color y la IA (fondo-revela) -->
  <div class="fondo-pie" aria-hidden="true" data-fondo-pie-caja><canvas class="pinta" data-fondo-pinta></canvas><canvas class="revela" data-fondo-pie></canvas></div>
  <canvas class="reticula-pie" aria-hidden="true" data-reticula-pie></canvas>
  <!-- RONDA 95 · «hay un cambio de color en el footer entre la parte de arriba y la de abajo»: era el velo de noche lisa de las capas (rondas 86–94), que tapaba
       el grano de la página hasta un corte. Fuera las capas y el velo: el pie es una sola materia -->
  <div class="wrap contenido pt-24">
    <div class="grid-12 gap-y-12">
      <div class="col-span-4 lg:col-span-7">
        <p class="text-h1 font-display tracking-[-0.02em] titular" data-entra>{pie.titulo}</p>
        <p class="text-sub measure mt-4 lg:mt-6 text-fg2">{pie.pitch}</p>
      </div>
      <div class="col-span-4 lg:col-span-4 lg:col-start-9 lg:text-right">
        <ul class="enlaces text-ui flex flex-col gap-3 font-medium lg:items-end">
          {[...nav.links.filter((l) => l.href !== '/#contacto'), ...nav.mas.links].map((l) => <li><a href={l.href} class="enlace-pie">{l.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>

  <!-- EL ÚLTIMO SISTEMA: el pentagrama, la palabra sobre él y la doble barra final -->
  <div class="wrap final" data-final>
    <!-- RONDA 85 · la SALA del libro (ilustración de Andoni) detrás del último sistema, pintada por el mismo motor que el director: se DIBUJA desde la partitura
         abierta al llegar y queda TRAMADA, con las ondas del tramado saliendo del libro a compás; fundida con la noche por los bordes -->
    <!-- RONDA 117 · «trasladar el footer al lenguaje del hero»: detrás, la TERRAZA de jazz (piano, saxo en su estuche) en gris tramado que cada pulso (desde el centro
         de abajo, cada dos compases) tiñe de color, con la IA que lee lo que hay (src/scripts/fondo-revela.ts, el mismo del hero) -->
    <div class="foco" aria-hidden="true"><i class="haz"></i></div>
    <!-- RONDA 95 · «te paso una imagen del director de PERFIL y que parezca que está orquestando las letras de Contáctanos»: la lámina de Andoni (recortada:
         public/media/pie/director-perfil.webp) hecha de papel con el motor del hero, a la izquierda y mirando a la palabra, con la batuta y la mano libre
         marcando el compás (el rig de brazos) y las letras meciéndose a ese compás. La palabra le tapa de las rodillas abajo -->
    <div class="director-pie" aria-hidden="true" data-director-pie><canvas></canvas></div>
    <!-- RONDA 96 (2.ª) · «lo que sale del director tiene que pasar ENTRE los objetos; esto aplica también al footer»: la estela sale de la batuta y TEJE la
         palabra: por detrás de una letra, por delante de la siguiente (dos planos: detrás de la palabra y delante) -->
    <canvas class="magia-pie detras" aria-hidden="true" data-magia-pie="0"></canvas>
    <svg class="pauta" aria-hidden="true" data-pauta>
      <g class="lineas" data-lineas></g>
      <g class="barra" data-barra><path class="fina" d="" /><path class="gruesa" d="" /></g>
      <g class="notas-fin" data-notas-fin></g>
      <!-- RONDA 96 · «al hacer hover en Contáctanos volvemos a la versión donde se dibujaba algo musical y de ahí salía el haz clic para agendar reunión con
           nosotros» (la de las rondas 83–91): sobre la «á» se dibuja un CALDERÓN (la fermata: sostener la nota), de su punto sube un tallo y en su punta
           se abre la píldora con Eric y Andoni -->
      <g class="calderon" data-calderon><path class="arco" d="" pathLength="1" /><circle class="pto" r="0" /><path class="tallo" d="" pathLength="1" /></g>
    </svg>
    <a class="contacta font-display" href={pie.cal || `mailto:${pie.correo}`} aria-label={`Contáctanos · agenda una reunión con Eric y Andoni${pie.cal ? '' : ` (${pie.correo})`}`} data-contacta>
      <!-- ronda 93: la «á» es «a» + NUESTRA tilde (la de la Family de prueba caía en Georgia), dentro de la letra: se mueve y se encoge con ella -->
      <span class="txt" data-contacta-txt>{'Contáctanos'.split('').map((c, i) => c === 'á'
        ? <span class="l" style={`--i:${i}`}>a<svg class="tilde" viewBox="0 0 100 100" aria-hidden="true"><polygon points="52.5,21.5 61.8,-1.7 68.2,1.7 54.5,22.5" /></svg></span>
        : <span class="l" style={`--i:${i}`}>{c}</span>)}</span>
      <!-- RONDA 117 · «al hacer hover en Contáctanos, algo más original»: LA IA OS ENCUENTRA. Del cursor sale un pulso que tiñe la terraza y en ella aparecen Eric y Andoni
           como figuras DETECTADAS (las esquinas de la caja se cierran, un barrido las descubre, su etiqueta con la confianza), y la llamada a agendar -->
      <span class="cta-ia" aria-hidden="true">
        <span class="det"><img src="/media/equipo/cara-eric.webp" alt="" width="64" height="64" loading="lazy" decoding="async" /><i class="et">eric</i></span>
        <span class="det"><img src="/media/equipo/cara-andoni.webp" alt="" width="64" height="64" loading="lazy" decoding="async" /><i class="et">andoni</i></span>
        <span class="dice">Agenda 30 min con nosotros <b>↳</b></span>
      </span>
      <span class="cta-pastilla" aria-hidden="true" data-pastilla>
        <span class="cta-caras"><img src="/media/equipo/cara-eric.webp" alt="" width="64" height="64" loading="lazy" decoding="async" /><img src="/media/equipo/cara-andoni.webp" alt="" width="64" height="64" loading="lazy" decoding="async" /></span>
        <span class="cta-dice"><b>Haz clic para agendar una reunión con nosotros</b><small>30 min · videollamada ↳</small></span>
      </span>
    </a>
    <canvas class="magia-pie delante" aria-hidden="true" data-magia-pie="1"></canvas>
    <!-- RONDA 97 · «el Contáctanos es un ASCII que reacciona a la música, y cuando haces hover se reordena y se convierte en agendar reunión con nuestras caras» -->
    <canvas class="ascii-pie" aria-hidden="true" data-ascii-pie></canvas>
  </div>

  <div class="wrap linea detail">
    <span>savvia · {pie.lugar} · {pie.desde}</span>
    <!-- ronda 116 · la música de la web: «Smooth Lovin'» de Kevin MacLeod, CC BY 3.0 (la licencia pide el crédito) -->
    <span class="credito">Música: <a class="link" href="https://incompetech.com" rel="noopener">«<span data-cancion>Study And Relax</span>» · Kevin MacLeod</a> · <a class="link" href="https://creativecommons.org/licenses/by/4.0/deed.es" rel="noopener license">CC BY 4.0</a></span>
    <span>© {year}</span>
  </div>
</footer>

<script>
  import { cancionActual } from '../scripts/jazz';
  document.querySelectorAll('[data-cancion]').forEach((n) => (n.textContent = cancionActual())); // ronda 117: el crédito de la canción que suena
  import { sonidoEncendido, tecla, teclear } from '../scripts/musica';
  import { crearPapel } from '../scripts/papel';
  import { crearRetrato } from '../scripts/retrato';
  import { crearEstela } from '../scripts/estela';
  import { crearAscii } from '../scripts/ascii';
  import { crearReticula } from '../scripts/reticula';
  import { crearFondoRevela } from '../scripts/fondo-revela';
  import { bandas, fase } from '../scripts/jazz';
  const pie = document.querySelector<HTMLElement>('[data-pie]');
  // RONDA 97 · el ASCII es el de serie; `?estilo=color|retrato|papel` vuelven a lo de antes
  // RONDA 117 · el de serie pasa al lenguaje del hero (el saxofonista pintado por el motor del roble, la terraza que desvelan los pulsos, «Contáctanos» en Family);
  // el ASCII de las rondas 97–116 queda en `?estilo=ascii`
  const enAscii = /[?&]estilo=ascii/.test(location.search);
  if (pie && enAscii) pie.classList.add('ascii');
  if (pie && !enAscii) pie.classList.add('jazz'); // ronda 117: el lenguaje del hero (sin pentagrama, plicas, calderón ni estela de batuta)
  if (pie) {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const NS = 'http://www.w3.org/2000/svg';
    const final = pie.querySelector<HTMLElement>('[data-final]')!, pauta = pie.querySelector<SVGSVGElement>('[data-pauta]')!;
    const gL = pie.querySelector<SVGGElement>('[data-lineas]')!, barra = pie.querySelector<SVGGElement>('[data-barra]')!, cal = pie.querySelector<SVGGElement>('[data-calderon]')!;
    const pastilla = pie.querySelector<HTMLElement>('[data-pastilla]')!;
    const contacta = pie.querySelector<HTMLAnchorElement>('[data-contacta]')!, txt = contacta.querySelector<HTMLElement>('[data-contacta-txt]')!;
    const lineas: SVGPathElement[] = [];
    for (let i = 0; i < 5; i++) { const l = document.createElementNS(NS, 'path'); l.setAttribute('pathLength', '1'); gL.appendChild(l); lineas.push(l); }
    // GEOMETRÍA: la palabra a todo el ancho del contenido; el pentagrama desde su línea base hasta la altura de sus mayúsculas (la «C»)
    let W = 0, x0 = 0, x1 = 0, yb = 0, g = 20, fs = 100, cx = 0, xsLetras: number[] = [];
    const medir = () => {
      const cw = final.clientWidth - 2 * parseFloat(getComputedStyle(final).paddingLeft);
      const c = document.createElement('canvas').getContext('2d')!;
      c.font = `100px ${getComputedStyle(contacta).fontFamily}`;
      const tw = c.measureText('Contáctanos').width || 1; // (las letras van en spans: se mide la palabra entera)
      fs = (100 * cw * 0.9) / tw; contacta.style.fontSize = `${fs}px`;
      const real = txt.getBoundingClientRect().width; if (real > 0) { fs *= (cw * 0.9) / real; contacta.style.fontSize = `${fs}px`; }
      const fr = final.getBoundingClientRect(), tr = txt.getBoundingClientRect();
      W = fr.width; pauta.setAttribute('viewBox', `0 0 ${W} ${fr.height}`);
      const pad = parseFloat(getComputedStyle(final).paddingLeft);
      final.style.setProperty('--gp', `${pad}px`); // ronda 117: la terraza, entre los carriles
      x0 = pad; x1 = W - pad;
      // la línea base de Family ≈ el 78 % del alto de su caja de línea (line-height 1) · la altura de mayúscula ≈ 0,68 em
      yb = tr.top - fr.top + fs * 0.8; g = (fs * 0.68) / 4;
      cx = tr.left - fr.left + tr.width * 0.5;
      pintar(performance.now());
      // RONDA 95 · el director de perfil, a la izquierda y mirando a la palabra: lo más alto que quepa entre el subtítulo y la línea base (la palabra le tapa
      // de las rodillas abajo); en móvil, más pequeño
      const sub = pie.querySelector<HTMLElement>('.contenido .text-sub')!.getBoundingClientRect();
      const libre = yb - (sub.bottom - fr.top) - 16;
      let dh = Math.max(140, Math.min(libre / 0.78, fr.width < 600 ? fr.width * 0.7 : fs * 1.6)), dw = (dh * 1024) / 1536; // en móvil la palabra es pequeña: él puede crecer
      let dTop = yb - dh * 0.78;
      // RONDA 117 · «el director del footer tiene que tener más presencia»: en el lenguaje del hero ocupa del subtítulo a por debajo de la línea base (va
      // delante de la palabra), mucho más alto
      // (nunca por debajo del pie: en pantallas anchas se salía; la lámina soñada del perfil es cuadrada, 1536 × 1536, con margen para sus estelas)
      if (!enAscii) { const arriba = sub.bottom - fr.top + 4, abajo = Math.min(yb + fs * 0.65, fr.height - 8); dh = Math.max(140, Math.min((abajo - arriba) * 0.82, fs * 2.6, innerHeight * 0.5)); dw = dh; dTop = abajo - dh; } /* ronda 117: «algo más pequeño» */
      dirEl.style.width = `${dw.toFixed(0)}px`; dirEl.style.height = `${dh.toFixed(0)}px`;
      // ronda 117: entero dentro de los carriles (la capa le sale por la izquierda)
      dirEl.style.left = `${(enAscii ? x0 - dw * 0.18 : x0 - dw * 0.2).toFixed(0)}px`; dirEl.style.top = `${dTop.toFixed(0)}px`;
      contacta.style.setProperty('--fs', `${fs.toFixed(1)}px`);
      // la doble barra final
      const alto = `M0 ${(yb - 4 * g).toFixed(1)}V${yb.toFixed(1)}`;
      barra.querySelector('.fina')!.setAttribute('d', alto); barra.querySelector('.gruesa')!.setAttribute('d', alto);
      barra.setAttribute('transform', `translate(${x1.toFixed(1)} 0)`);
      const letras = [...txt.querySelectorAll<HTMLElement>('.l')];
      xsLetras = letras.map((l) => { const r = l.getBoundingClientRect(); return r.left - fr.left + r.width / 2; });
      if (enAscii) requestAnimationFrame(() => prepararAscii());
      // EL CALDERÓN sobre la «á» (por encima de su tilde) y el TALLO que sube de su punto hasta la píldora
      const q = letras[4]?.getBoundingClientRect(), ax = q ? q.left - fr.left + q.width * 0.52 : cx;
      const rx = fs * 0.17, ry = fs * 0.13, cy = yb - fs * 0.9, f = (n: number) => n.toFixed(1);
      cal.querySelector('.arco')!.setAttribute('d', `M${f(ax - rx)} ${f(cy)}A${f(rx)} ${f(ry)} 0 0 1 ${f(ax + rx)} ${f(cy)}`);
      const pto = cal.querySelector('circle')!; pto.setAttribute('cx', f(ax)); pto.setAttribute('cy', f(cy - ry * 0.18)); pto.setAttribute('r', f(Math.max(3, fs * 0.028)));
      cal.style.setProperty('--grosor', `${Math.max(2, fs * 0.022).toFixed(1)}px`);
      const tope = cy - ry - Math.max(22, fs * 0.11); // donde se apoya la píldora
      cal.querySelector('.tallo')!.setAttribute('d', `M${f(ax)} ${f(cy - ry - 6)}V${f(tope)}`);
      // la píldora se abre hacia la DERECHA desde el tallo (las caras sobre él): a la izquierda está el subtítulo. Sin salirse del contenido
      const pw = pastilla.offsetWidth, ANC = 34, pl = Math.max(x0, Math.min(ax - ANC, x1 - pw));
      contacta.style.setProperty('--ancla', `${f(ax - pl)}px`);
      contacta.style.setProperty('--px', `${f(pl - (tr.left - fr.left))}px`);
      contacta.style.setProperty('--pt', `${f(tope - (tr.top - fr.top))}px`);
      contacta.style.setProperty('--puente', `${f(yb - fs * 0.7 - tope)}px`);
    };
    // la cuerda que vibra (como en la carga): onda estacionaria que se apaga
    const vib = lineas.map(() => ({ a: 0, t: 0 }));
    const pintar = (ahora: number) => {
      lineas.forEach((l, i) => {
        const y = yb - i * g, v = vib[i], t = (ahora - v.t) / 1000, A = v.a * Math.exp(-t * 2.6);
        if (A < 0.05) { l.setAttribute('d', `M${x0.toFixed(1)} ${y.toFixed(1)}H${x1.toFixed(1)}`); return; }
        let d = ''; const n = 64, L = x1 - x0;
        for (let k = 0; k <= n; k++) { const x = x0 + (L * k) / n; d += (k ? 'L' : 'M') + x.toFixed(1) + ' ' + (y + A * Math.sin((Math.PI * k) / n) * Math.sin(k * 0.5 - t * 34) * Math.cos(t * 19)).toFixed(2); }
        l.setAttribute('d', d);
      });
    };
    let raf = 0;
    const bucle = (ahora: number) => { pintar(ahora); raf = vib.some((v) => ahora - v.t < 2200) ? requestAnimationFrame(bucle) : 0; };
    const pulsar = () => { if (reducido) return; const ahora = performance.now(); vib.forEach((v, i) => { v.a = g * (0.28 - i * 0.02); v.t = ahora + i * 40; }); if (!raf) raf = requestAnimationFrame(bucle); };
    // el acorde final (ronda 85: uno solo, fa mayor: el de la carga; la web ya no tiene estaciones)
    const ACORDE = [53, 65, 69, 72];
    let sonado = 0;
    const abrir = () => {
      if (pie.classList.contains('cta-abierto')) return;
      pie.classList.add('cta-abierto'); pulsar();
      // ronda 98: al reordenarse, se TECLEA (antes, el acorde: se superponía al jazz de fondo)
      if (!reducido && sonidoEncendido() && performance.now() - sonado > 1500) { sonado = performance.now(); teclear(7, { vol: 0.03, ritmo: 0.09 }); }
    };
    const cerrar = () => pie.classList.remove('cta-abierto');
    // los enlaces del pie, como las cuerdas de un arpa (ronda 85)
    pie.querySelectorAll<HTMLElement>('.enlace-pie').forEach((a, i) => a.addEventListener('pointerenter', () => tecla({ vol: 0.03 })));
    contacta.addEventListener('pointerenter', abrir);
    // ronda 117 · el pulso del hover nace donde está el cursor
    contacta.addEventListener('pointerenter', (ev) => { if (enAscii || reducido) return; const r = pie.getBoundingClientRect(); fonP?.pulso(1.3, (ev.clientX - r.left) / r.width, (ev.clientY - r.top) / r.height); });
    contacta.addEventListener('pointerleave', cerrar);
    contacta.addEventListener('focus', abrir);
    contacta.addEventListener('blur', cerrar);
    // RONDA 85 · «el Contáctanos del final: que sean NOTAS que se vayan tocando y se quede finalmente el Contáctanos». Al llegar se traza el pentagrama; luego,
    // letra a letra, una nota aparece sobre el pentagrama encima de su letra (una melodía que sube y baja), SUENA, se deshace y deja su letra. Al final se
    // cierra la doble barra y suena el acorde. Sin movimiento: la palabra, directamente.
    const MELODIA = [1, 3, 5, 4, 6, 8, 7, 5, 6, 4, 2]; // posición en el pentagrama (medios espacios desde la primera línea)
    const NATURAL = [64, 65, 67, 69, 71, 72, 74, 76, 77];
    const letras = [...txt.querySelectorAll<HTMLElement>('.l')];
    const llegar = () => {
      pie.classList.add('llega');
      // RONDA 117 · al llegar, la terraza nace del centro de abajo (3,2 s) a la par que se pinta el saxofonista, y suelta su primer pulso
      if (!enAscii) {
        pinta?.soltar(); // ronda 117 (4.ª): la terraza se PINTA al llegar (antes, una máscara que se abría)
        if (!reducido) setTimeout(() => dispatchEvent(new CustomEvent('savvia:pulso-pie')), 2600);
      }
      if (reducido) { letras.forEach((l) => l.classList.add('on')); pie.classList.add('entera'); return; }
      // RONDA 108 · «lo mismo al Contáctanos del footer»: en ASCII la palabra se ESCRIBE signo a signo (orden de lectura, con el cursor coral delante) y se
      // oyen los tecleos; al acabar, el intro
      if (enAscii) {
        setTimeout(() => {
          tTec = performance.now(); pedirA();
          const iv = window.setInterval(() => { if (performance.now() - tTec > TEC) { clearInterval(iv); letras.forEach((l) => l.classList.add('on')); pie.classList.add('entera'); tecla({ vol: 0.04, fuerte: true }); return; } const u = (performance.now() - tTec) / TEC; if (Math.random() < 0.55 * tramosP[Math.min(9, Math.floor(u * 10))] / (sumaP / 10)) tecla({ vol: 0.03 }); }, 55);
        }, 700);
        return;
      }
      // RONDA 85 (2.ª) · «que las propias letras sean las notas y sean lo que se queda»: cada LETRA entra a la altura de su nota en el pentagrama (sube o baja
      // según la melodía), con su plica, y suena; cuando han sonado todas, bajan juntas a la línea (el acorde) y queda la palabra
      letras.forEach((l, i) => setTimeout(() => {
        const p = MELODIA[i];
        l.style.setProperty('--y', '0px'); // ronda 117: las letras ya no entran a la altura de una nota: llegan tecleadas, en su sitio
        l.classList.add('on');
        tecla({ vol: 0.035 }); // ronda 98: cada letra llega TECLEADA (antes, su nota: se superponía al jazz)
        vib[Math.min(4, Math.round(p / 2))] = { a: g * 0.18, t: performance.now() }; if (!raf) raf = requestAnimationFrame(bucle);
        if (i === letras.length - 1) setTimeout(() => {
          pie.classList.add('entera'); letras.forEach((q) => { q.style.setProperty('--y', '0px'); q.classList.remove('nota'); });
          tecla({ vol: 0.04, fuerte: true }); // y el intro
          for (let k = 0; k < 5; k++) vib[k] = { a: g * 0.26, t: performance.now() + k * 40 };
          if (!raf) raf = requestAnimationFrame(bucle);
        }, 650);
      }, 1500 + i * 110));
    };
    // RONDA 94 · EL DIRECTOR del pie (se monta al acercarse; marca el compás solo a la vista)
    const dirEl = pie.querySelector<HTMLElement>('[data-director-pie]')!;
    let td: ReturnType<typeof crearPapel> | null = null, saxOnda: ((x: number, y: number) => void) | null = null;
    const montarDirector = () => {
      if (td) return;
      const bg = (getComputedStyle(pie).backgroundColor.match(/\d+/g) || ['59', '35', '27']).slice(0, 3).map(Number) as [number, number, number];
      // RONDA 96 (2.ª) · «a color, con el efecto que teníamos en el árbol»: el director de perfil, en color, pintado por el motor del árbol (se dibuja desde
