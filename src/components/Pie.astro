    background: url('/media/grano.png') 0 0 / 240px 240px, linear-gradient(to bottom, var(--noche), color-mix(in oklab, var(--noche) 88%, transparent) 30%, color-mix(in oklab, var(--noche) 45%, transparent) 65%, transparent);
    pointer-events: none;
