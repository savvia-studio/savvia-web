    background: linear-gradient(90deg, transparent, rgb(255 236 200 / 0.05) 30%, rgb(255 236 200 / 0.12) 50%, rgb(255 236 200 / 0.05) 70%, transparent);
    transform: translateX(calc(var(--lx, 0) * 30vw)) skewX(-18deg);
  }
  /* la copia dentro de la gota (.sube): el mismo haz que la capa del pie, con la caja ampliada 240 px por ARRIBA (el alto máximo de la gota) para que cubra
     toda la gota aunque --arriba valga 0. Por abajo termina donde el pie (si no, ensanchaba la página). El centro de la caja queda 120 px más alto: el
     origen de la inclinación baja otros 120 px para que la diagonal coincida con la de la capa del pie en la línea */
  :global(.sube) .luz-pie {
    top: calc(100% - var(--arriba, 0px) - 240px);
    bottom: auto;
    height: calc(var(--arriba, 0px) + var(--pie-h, 0px) + 240px);
  }
  :global(.sube) .luz-pie .haz { transform-origin: 50% calc(50% + 120px); }
  .pie:has(.pintado) .luz-pie { /* ronda 65: en todas las estaciones (antes, solo en verano) */
    opacity: 1;
  }

  /* RONDA 24 · «las palabras que quedan en el footer se tienen que leer bien»: sobre el paisaje, un velo del propio Rosa arcilla que se funde
     hacia abajo (bruma): lo que queda tras el texto se aclara sin taparlo */
  .paisaje::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: var(--alto);
    z-index: 1; /* ronda 32: bajo el formulario de cristal (z 2); la hierba (z 3) delante de todo */
    /* ronda 26: el GRANO de la página por encima del velo; si no, el filo superior del velo (arcilla lisa contra la sección con grano) se veía como un
       cambio de color */
    background: linear-gradient(to bottom, var(--noche), color-mix(in oklab, var(--noche) 88%, transparent) 30%, color-mix(in oklab, var(--noche) 45%, transparent) 65%, transparent);
    pointer-events: none;
