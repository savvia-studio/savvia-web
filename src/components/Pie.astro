  }
  .capa .flores {
    z-index: 1;
  }
  .capa img,
  .capa canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .capa img {
    object-fit: cover;
    object-position: 50% 100%;
    opacity: 0; /* es la textura: como imagen solo se ve sin WebGL */
  }
  .capa.sin-gl img,
  :global(html:not(.js)) .capa img {
    opacity: 1;
  }
  .capa canvas {
    opacity: 0; /* regla dura 3: nace invisible */
  }
  .capa canvas:global(.listo) {
    opacity: 1;
  }
  /* RONDA 24 · los enlaces: al pasar por uno, los demás se desenfocan y se retiran (como en el menú); el que pisas se desplaza un poco */
  .enlace-pie {
    display: inline-block;
    transition: opacity 0.35s ease, filter 0.45s ease, translate 0.45s var(--ease-out-expo);
  }
  ul:has(.enlace-pie:hover) .enlace-pie:not(:hover) {
