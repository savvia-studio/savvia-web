    -webkit-mask: none;
    mask: none;
  }
  /* los enlaces: la parte alta de sus mayúsculas a la altura de la del titular */
  @media (width >= 64rem) {
    .enlaces { margin-top: calc(var(--text-h1) * 0.14); }
  }
  /* el paisaje: a sangre, pegado al pie, DETRÁS del contenido */
  .paisaje {
    --p: 0; /* 1 = las capas aún vienen de abajo · 0 = asentadas */
    --mx: 0;
    --my: 0;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    --alto: min(33.35vw, 62lvh);
    --extra: 18rem; /* ronda 37: la tarjeta asoma más por encima del paisaje */
    height: calc(var(--alto) + var(--extra));
    pointer-events: none;
    /* recorte REAL (overflow: clip-path no evita el scroll horizontal de lo recortado); el panel asoma por encima del paisaje porque la caja lleva una
       franja transparente arriba (--extra) y las capas van ancladas abajo con su alto propio (ronda 35) */
    overflow: clip;
  }
  .capa.hierba {
    z-index: 3; /* delante del «Contáctanos» */
  }
  /* el lienzo del tiempo: sobre el paisaje y bajo el texto; aparece cuando el paisaje está pintado; se esconde con el formulario abierto */
  .clima {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .pie:has(.pintado) .clima {
    opacity: 1;
  }
  /* el RAYO del verano: el haz del hero (Rosa niebla translúcida, 18°), algo más presente, que se desplaza un poco con el ratón; solo en verano, con
     el paisaje pintado y sin el formulario */
  .luz-pie {
    position: absolute;
    /* RONDA 67 · «que la luz salga desde arriba del todo: si haces scroll hacia arriba parece que sale de la nada»: la capa sube hasta el borde de arriba
