---
// LOS CARRILES (ronda 14). Andoni, con el vídeo de referencia (sythera): «añadir los carriles que marcan los límites del contenido de la web,
// y que estos puedas quitarlos y ponerlos».
// · Dos líneas verticales en los bordes REALES del contenido (el `wrap`: 1200 px + márgenes 20/32/48): la retícula de la web, a la vista.
// · Al empezar cada sección, una línea horizontal de lado a lado y una cruz «+» donde corta a los carriles (como en la referencia).
// · RONDA 17: «las líneas se quedan siempre, no se quitan» → fuera el botón de la barra y todo el estado de quitar/poner.
//   Una sección puede renunciar a su fila con `data-sin-fila` (la segunda: «quitamos las líneas superiores»).
// · Mezcla por diferencia al 14 %: claras sobre Cacao, oscuras sobre lo claro. Nunca reciben el ratón. Escala de z: 40 (bajo el velo 48).
---

<div class="carriles" aria-hidden="true">
  <div class="caja"><i class="v"></i><i class="v der"></i></div>
</div>
<div class="marcas" aria-hidden="true" data-marcas></div>

<script>
  const marcas = document.querySelector<HTMLElement>('[data-marcas]')!;
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  // una fila por sección (y por cada [data-carril-fila]): línea horizontal + dos cruces sobre los carriles
  let pedido = false, trazadas = false;
  const colocar = () => {
    pedido = false;
    const ys = [...document.querySelectorAll<HTMLElement>('main > section:not([data-sin-fila]), body > footer, [data-carril-fila]')]
      .map((el) => Math.round(el.getBoundingClientRect().top + scrollY - (el.closest('[data-hero]') && hero ? new DOMMatrix(getComputedStyle(hero).transform).m42 : 0)))
      .filter((y) => y > 8)
      .sort((a, b) => a - b);
    marcas.replaceChildren(...ys.map((y) => {
      const f = document.createElement('div');
      f.className = 'fila' + (trazadas ? ' quieta' : ''); // RONDA 27: recolocada después (cambia el alto del body, p. ej. una FAQ abierta) no se vuelve a trazar
      f.style.top = `${y}px`;
      f.innerHTML = '<div class="caja"><i class="cruz"></i><i class="cruz der"></i></div>';
      return f;
    }));
    if (ys.length) setTimeout(() => { trazadas = true; }, 1500);
  };
  const pedir = () => { if (!pedido) { pedido = true; requestAnimationFrame(colocar); } };
  new ResizeObserver(pedir).observe(document.body);
  addEventListener('load', pedir);
  addEventListener('savvia:gota', pedir);
  colocar();
</script>

<style>
  .carriles,
  .marcas {
    pointer-events: none;
    z-index: 40; /* escala de z: 0 contenido · 40 carriles · 48 velo · 50 menú · 55 nav · 60 escenario sentado */
    mix-blend-mode: difference;
    transition: opacity 0.4s ease;
  }
  .carriles {
    position: fixed;
    inset: 0;
  }
  .marcas {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0;
  }
  /* la caja del contenido: la misma geometría que la utilidad `wrap` */
  /* (las filas las crea el JS: sin el atributo de ámbito de Astro → también :global dentro de .marcas) */
  .caja,
  .marcas :global(.caja) {
    --gutter: calc(var(--spacing) * 5);
    position: relative;
    height: 100%;
    width: min(100%, 75rem + var(--gutter) * 2);
    margin-inline: auto;
  }
  @media (width >= 48rem) {
    .caja, .marcas :global(.caja) { --gutter: calc(var(--spacing) * 8); }
  }
  @media (width >= 64rem) {
    .caja, .marcas :global(.caja) { --gutter: calc(var(--spacing) * 12); }
  }
  .v {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--gutter);
    width: 1px;
    background: color-mix(in srgb, var(--color-niebla) 14%, transparent);
    transform-origin: 50% 0;
  }
  .v.der {
    left: auto;
    right: var(--gutter);
  }
  .marcas :global(.fila) {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1px;
  }
  /* RONDA 83 · Eric: «las + salen de izquierda a derecha y eso no quiero; que salgan directamente en su posición»: la línea va en un pseudo-elemento
     (es lo único que se traza); antes se escalaba la fila entera y las cruces, que son sus hijas, viajaban con ella */
  .marcas :global(.fila)::before {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--color-niebla) 8%, transparent);
    transform-origin: 0 50%;
  }
  .marcas :global(.cruz) {
    position: absolute;
    top: 0;
    left: var(--gutter);
    width: 9px;
    height: 9px;
    translate: -4px -4px;
    background:
      linear-gradient(color-mix(in srgb, var(--color-niebla) 70%, transparent), color-mix(in srgb, var(--color-niebla) 70%, transparent)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(color-mix(in srgb, var(--color-niebla) 70%, transparent), color-mix(in srgb, var(--color-niebla) 70%, transparent)) 0 50% / 100% 1px no-repeat;
  }
  .marcas :global(.cruz.der) {
    left: auto;
    right: var(--gutter);
    translate: 4px -4px;
  }
  /* al aparecer (al cargar y al volver a ponerlos): los carriles se trazan de arriba abajo y las líneas de izquierda a derecha; las cruces
     aparecen en su sitio (ronda 83) */
  :global(html.carriles-entran) .v {
    animation: trazar-v 1.1s var(--ease-out-expo) both;
  }
  :global(html.carriles-entran) .v.der {
    animation-delay: 0.12s;
  }
  :global(html.carriles-entran) .marcas :global(.fila)::before {
    animation: trazar-h 1.2s var(--ease-out-expo) 0.2s both;
  }
  :global(html.carriles-entran) .marcas :global(.fila .cruz) {
    animation: asomar-cruz 0.5s ease 0.2s both;
  }
  :global(html.carriles-entran) .marcas :global(.fila.quieta)::before,
  :global(html.carriles-entran) .marcas :global(.fila.quieta .cruz) {
    animation: none;
  }
  @keyframes trazar-v {
    from { scale: 1 0; }
  }
  @keyframes trazar-h {
    from { scale: 0 1; }
  }
  @keyframes asomar-cruz {
    from { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.carriles-entran) .v,
    :global(html.carriles-entran) .marcas :global(.fila)::before,
    :global(html.carriles-entran) .marcas :global(.fila .cruz) {
      animation: none;
    }
  }
</style>
