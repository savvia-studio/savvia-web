        const sl = acum[k], atras = l - sl;
        const env = 0.55 + 0.45 * Math.sin(sl / 53 + 0.4) * Math.sin(sl / 19 + 1.7);
        let A = (2.2 + 3.4 * env) * Math.min(1, sl / 60);
