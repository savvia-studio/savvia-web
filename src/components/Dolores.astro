      // la onda está viva siempre que la sección se ve (el sonido no para), a ~30 fps en reposo
      if (visible) { if (Math.abs(lMeta - l) > 0.5 || Math.abs(dl) > 0.5) pedir(); else setTimeout(pedir, 30); }
    };
