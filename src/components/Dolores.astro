    const eco = sec.querySelector<SVGPathElement>('[data-eco]')!;
    const svg = sec.querySelector<SVGSVGElement>('[data-hilo]')!, via = sec.querySelector<SVGPathElement>('[data-via]')!, cuerda = sec.querySelector<SVGPathElement>('[data-cuerda]')!, punta = sec.querySelector<SVGCircleElement>('[data-punta]')!;
    type P = { x: number; y: number };
    // ── LA SOMBRA SONORA del director (ronda 87)
    const SOMBRA_H = innerWidth < 768 ? 180 : 280;
    const sc = sec.querySelector<HTMLCanvasElement>('[data-sombra]')!, sx = sc.getContext('2d')!;
    const sombra = (ahora: number) => {
      const W = sec.clientWidth, H = SOMBRA_H, dpr = Math.min(2, devicePixelRatio || 1);
      if (sc.width !== Math.round(W * dpr) || sc.height !== Math.round(H * dpr)) { sc.width = Math.round(W * dpr); sc.height = Math.round(H * dpr); }
      sx.setTransform(dpr, 0, 0, dpr, 0, 0); sx.clearRect(0, 0, W, H);
      const cx0 = W / 2, W0 = Math.min(560, W * 0.46), N = 14, t = ahora / 1000;
      sx.lineWidth = 1; sx.strokeStyle = '#eadde7';
      for (let i = 0; i < N; i++) {
        const k = i / (N - 1), y = 6 + k * (H - 6), ancho = W0 * Math.pow(1 - k, 1.25) + 3, amp = (7 * (1 - k) + 1.2) * (reducido ? 0 : 1);
        sx.globalAlpha = 0.07 + 0.26 * (1 - k) * (1 - k) + (k > 0.9 ? 0.3 : 0);
        sx.beginPath();
        for (let x = -ancho / 2; x <= ancho / 2; x += 4) {
