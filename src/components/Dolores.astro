---
import { recorrido } from '../data/home';
import { isoV } from '../lib/rich';
import TarjetaPaso from './TarjetaPaso.astro'; // ronda 54: «la animación de dentro de las cards, sin las cards» (TarjetaAgua.astro, la de agua, queda guardada)
// RONDA 51 · `tarjetas`: la A con las tarjetas de antes (Andoni: «esta me gusta y añadiendo las cards que teníamos puede quedar bien»)
interface Props { id?: string; tarjetas?: boolean }
const { id = 'recorrido', tarjetas = false } = Astro.props;
const pasos = recorrido.pasos;
// RONDA 83 · giro a la música: fuera los óleos de Donostia (y las ramas). Detrás de cada demo, un fragmento de PARTITURA MANUSCRITA (la partitura es lo que
// entregamos): tres pentagramas a mano alzada con sus notas, generados aquí con semilla (siempre los mismos) y escritos a trazo al llegar la onda.
const PASOS = ['Entender', 'Decidir', 'Documentar', 'Entregar'];
function partitura(k: number) {
  let sem = 97 + k * 131;
  const az = () => { sem = (sem * 16807) % 2147483647; return sem / 2147483647; };
  const f = (n: number) => n.toFixed(1);
  const trazos: string[] = [], manchas: string[] = [];
  const W = 640, g = 13; // separación entre líneas
  for (let s = 0; s < 3; s++) {
    const y0 = 210 + s * 250 + (az() - 0.5) * 20, x0 = 40 + az() * 20, x1 = W - 40 - az() * 20;
    // cinco líneas a pulso: un poco onduladas y con inclinación propia
    for (let l = 0; l < 5; l++) {
      const y = y0 + l * g, inc = (az() - 0.5) * 4;
      trazos.push(`M${f(x0 + az() * 4)} ${f(y)}C${f(x0 + 180)} ${f(y + (az() - 0.5) * 3)} ${f(x1 - 180)} ${f(y + inc + (az() - 0.5) * 3)} ${f(x1 - az() * 4)} ${f(y + inc)}`);
    }
    // barras de compás
    const compases = 3 + Math.floor(az() * 2), ancho = (x1 - x0 - 60) / compases;
    for (let c = 1; c <= compases; c++) { const x = x0 + 60 + c * ancho + (az() - 0.5) * 4; trazos.push(`M${f(x)} ${f(y0 - 1)}L${f(x + (az() - 0.5) * 2)} ${f(y0 + 4 * g + 1)}`); }
    // una clave a mano (una ese larga) al principio del primer pentagrama de cada sistema
    trazos.push(`M${f(x0 + 22)} ${f(y0 + 5 * g)}C${f(x0 + 36)} ${f(y0 + 2 * g)} ${f(x0 + 4)} ${f(y0 + g)} ${f(x0 + 18)} ${f(y0 - 1.6 * g)}C${f(x0 + 30)} ${f(y0 - 0.2 * g)} ${f(x0 + 4)} ${f(y0 + 3.4 * g)} ${f(x0 + 20)} ${f(y0 + 3.2 * g)}`);
    // las notas: cabezas rellenas con su plica; a veces, dos unidas por una barra
    for (let c = 0; c < compases; c++) {
      const n = 2 + Math.floor(az() * 3);
      const xs: number[] = [], ys: number[] = [];
      for (let i = 0; i < n; i++) {
        const x = x0 + 60 + c * ancho + (i + 0.6) * (ancho / (n + 0.4)), p = Math.floor(az() * 9) - 1, y = y0 + 4 * g - (p * g) / 2;
        manchas.push(`<ellipse cx="${f(x)}" cy="${f(y)}" rx="${f(g * 0.62)}" ry="${f(g * 0.42)}" transform="rotate(-22 ${f(x)} ${f(y)})"/>`);
        const arriba = p < 4;
        trazos.push(`M${f(x + (arriba ? g * 0.55 : -g * 0.55))} ${f(y)}l${f((az() - 0.5) * 2)} ${f(arriba ? -3.2 * g : 3.2 * g)}`);
        xs.push(x + (arriba ? g * 0.55 : -g * 0.55)); ys.push(y + (arriba ? -3.2 * g : 3.2 * g));
      }
      if (n >= 2 && az() < 0.5) trazos.push(`M${f(xs[0])} ${f(ys[0])}L${f(xs[1])} ${f(ys[1])}`);
    }
  }
  return `<svg viewBox="0 0 ${W} 960" preserveAspectRatio="xMidYMid slice" aria-hidden="true">` +
    trazos.map((d) => `<path pathLength="1" d="${d}"/>`).join('') + `<g class="manchas">${manchas.join('')}</g></svg>`;
}
---

<!--
  LOS DOLORES · RONDA 83 (giro a la música): de la batuta del director baja una CUERDA tensa que pasa por cada problema. Por su punta viaja una onda con el
  scroll; al llegar a un problema el tramo recorrido VIBRA (disonancia → resolución), la tarjeta se DIBUJA desde el impacto y su demo arranca, la partitura
  manuscrita de detrás se escribe y el eyebrow (el problema) se apaga mientras sube la respuesta. Si el sonido de la web está encendido, cada problema
  resuelto da una nota (la · do · mi). Antes (rondas 51–82): la raíz con la gota de savia y los óleos de Donostia (tools/retirados/Dolores.r82.astro.txt).
  Sin fijar el scroll. Móvil: una columna. Movimiento reducido: todo resuelto y la cuerda entera.
-->
<section id={id} class={`dolores surface-dark ${tarjetas ? 'con-tarjetas' : ''}`} aria-label={recorrido.pregunta} data-dolores data-sin-fila>
  <!-- RONDA 83 · LA CUERDA: de la batuta del hero a cada problema, en tramos rectos y tensos (las cuerdas de un instrumento). Se descubre con el scroll;
       por su punta viaja una ONDA (un paquete que se mueve) y, al llegar a un problema, el tramo que acaba de recorrer VIBRA y la tarjeta se dibuja -->
  <!-- RONDA 87 · «cuando haces scroll queda como cortado el director: proyectar su SOMBRA hacia ese lado, pero como si fueran ondas sonoras que se mueven, y de ellas
       sale la línea que une los problemas»: bajo el director, líneas que ondulan, anchas arriba (su ancho) y cada vez más estrechas, hasta ser la onda -->
  <canvas class="sombra-sonora" aria-hidden="true" data-sombra></canvas>
  <svg class="hilo" aria-hidden="true" data-hilo>
    <defs>
      <mask id={`hilo-texto-${id}`} maskUnits="userSpaceOnUse" data-mascara><rect x="-10" y="-10" width="99999" height="99999" fill="#fff" /></mask>
    </defs>
    <g mask={`url(#hilo-texto-${id})`}>
      <path class="via" d="" data-via />
      <path class="eco" d="" data-eco />
      <path class="cuerda" d="" data-cuerda />
      <circle class="punta" r="3" data-punta />
    </g>
  </svg>
  <ol class="paradas wrap">
    {
      pasos.map((p, k) => (
        <li class={`parada ${k % 2 ? 'derecha' : ''}`} data-parada={k}>
          <div class="texto">
            <h2 class="dolor detail" set:html={isoV(p.dolor)} />
            <div class="respuesta">
              <p class="t text-h1 font-display">{p.t}</p>
              <p class="d text-sub mt-3">{p.d}</p>
            </div>
          </div>
          <div class="lado">
            <div class="partitura" aria-hidden="true" data-partitura set:html={partitura(k)} />
            {tarjetas && <TarjetaPaso i={k} desnuda />}
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { tinta } from '../scripts/tinta';
  import { dibujar } from '../scripts/dibujar';
  import { tocar, sonidoEncendido } from '../scripts/musica';
  document.querySelectorAll<HTMLElement>('[data-dolores]').forEach((sec) => {
    const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const paradas = [...sec.querySelectorAll<HTMLElement>('[data-parada]')].map((li) => ({ li, tarjeta: li.querySelector<HTMLElement>('[data-tarjeta]'), sana: false }));
    type Parada = (typeof paradas)[number];
    // la nota con que RESUELVE cada problema (si el sonido de la web está encendido): la, do, mi — un acorde que se completa al bajar
    const NOTAS = [69, 72, 76];
    // LLEGA LA ONDA: la tarjeta aparece dibujándose desde el impacto y su demo arranca; la partitura de detrás se escribe
    const sanar = (r: Parada, n: number, impacto?: [number, number]) => {
      if (r.sana) return;
      r.sana = true; r.li.classList.add('sana');
      if (!reducido && sonidoEncendido()) tocar(NOTAS[n % 3], { vol: 0.1, dur: 2.4 });
      const t = r.tarjeta;
      if (!t) return;
      const d = t.querySelector('.demo'); d?.replaceWith(d.cloneNode(true));
      t.classList.add('viva');
      if (!reducido && impacto) dibujar(t, { arbol: true, abrir: true, origen: impacto, color: tinta('niebla', 0.6) });
    };
    paradas.forEach((r) => { if (r.tarjeta) new IntersectionObserver((e) => r.tarjeta!.classList.toggle('fuera', !e[0].isIntersecting)).observe(r.tarjeta); });

    // ── LA CUERDA ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
    const eco = sec.querySelector<SVGPathElement>('[data-eco]')!;
    const svg = sec.querySelector<SVGSVGElement>('[data-hilo]')!, via = sec.querySelector<SVGPathElement>('[data-via]')!, cuerda = sec.querySelector<SVGPathElement>('[data-cuerda]')!, punta = sec.querySelector<SVGCircleElement>('[data-punta]')!;
    type P = { x: number; y: number };
    // ── LA SOMBRA SONORA del director (ronda 87)
    const SOMBRA_H = innerWidth < 768 ? 180 : 280;
    const sc = sec.querySelector<HTMLCanvasElement>('[data-sombra]')!, sx = sc.getContext('2d')!;
    const sombra = (ahora: number) => {
      const W = sec.clientWidth, H = SOMBRA_H, dpr = Math.min(2, devicePixelRatio || 1);
      if (sc.width !== Math.round(W * dpr) || sc.height !== Math.round(H * dpr)) { sc.width = Math.round(W * dpr); sc.height = Math.round(H * dpr); }
      sx.setTransform(dpr, 0, 0, dpr, 0, 0); sx.clearRect(0, 0, W, H);
      const cx0 = W / 2, W0 = Math.min(560, W * 0.46), N = 14, t = ahora / 1000;
      sx.lineWidth = 1; sx.strokeStyle = '#eadde7';
      for (let i = 0; i < N; i++) {
        const k = i / (N - 1), y = 6 + k * (H - 6), ancho = W0 * Math.pow(1 - k, 1.25) + 3, amp = (7 * (1 - k) + 1.2) * (reducido ? 0 : 1);
        sx.globalAlpha = 0.07 + 0.26 * (1 - k) * (1 - k) + (k > 0.9 ? 0.3 : 0);
        sx.beginPath();
        for (let x = -ancho / 2; x <= ancho / 2; x += 4) {
          const env = Math.cos((Math.PI * x) / ancho); // los extremos, quietos
          const yy = y + Math.sin(x / 19 - t * 2.1 + i * 0.7) * amp * env;
          x === -ancho / 2 ? sx.moveTo(cx0 + x, yy) : sx.lineTo(cx0 + x, yy);
        }
        sx.stroke();
      }
      sx.globalAlpha = 1;
    };
    // pts: la cuerda muestreada cada ~6 px; nx/ny: su normal; acum: longitud recorrida; tramos: [inicio, fin] de cada tramo recto (para que vibre entero)
    let pts: P[] = [], nx: number[] = [], ny: number[] = [], acum: number[] = [], maxY: number[] = [], llegadas: number[] = [], tramos: [number, number][] = [], total = 1;
    // lo que vibra: [índice de inicio, índice de fin, amplitud, cuándo empezó]
    const vibran: { a: number; b: number; amp: number; t0: number }[] = [];
    // RONDA 85 · el camino de la ONDA: curvas que salen y llegan en vertical (como bajaba la raíz), muestreadas cada ~5 px
    const recta = (A: P, B: P) => { const dy = B.y - A.y, m = dy * 0.5, L = Math.hypot(B.x - A.x, dy), n = Math.max(2, Math.ceil(L / 5)); const o: P[] = []; for (let i = 1; i <= n; i++) { const t = i / n, u = 1 - t; o.push({ x: u * u * u * A.x + 3 * u * u * t * A.x + 3 * u * t * t * B.x + t * t * t * B.x, y: u * u * u * A.y + 3 * u * u * t * (A.y + m) + 3 * u * t * t * (B.y - m) + t * t * t * B.y }); } return o; };
    const medir = () => {
      const sr = sec.getBoundingClientRect(), W = sr.width, H = sec.offsetHeight;
      if (!H) return;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`); svg.setAttribute('width', String(W)); svg.setAttribute('height', String(H));
      const wr = sec.querySelector<HTMLElement>('.paradas')!.getBoundingClientRect();
      const rel = (x: number, y: number): P => ({ x: x - sr.left, y: y - sr.top });
      pts = [{ x: wr.left - sr.left + wr.width / 2, y: SOMBRA_H }]; llegadas = []; tramos = []; // ronda 87: nace donde acaba la sombra sonora
      const ir = (B: P) => { const a = pts.length - 1; pts.push(...recta(pts[pts.length - 1], B)); tramos.push([a, pts.length - 1]); };
      paradas.forEach((r) => {
        const b = (r.tarjeta ?? r.li).getBoundingClientRect(), cx = b.left + b.width / 2;
        ir(rel(cx, b.top + 4));
        llegadas.push(pts.length - 1);
        ir(rel(cx, b.bottom - 4)); // por detrás de la tarjeta
      });
      ir({ x: wr.left - sr.left + wr.width / 2, y: H });
      acum = [0]; maxY = [pts[0].y];
      for (let i = 1; i < pts.length; i++) { acum.push(acum[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y)); maxY.push(Math.max(maxY[i - 1], pts[i].y)); }
      total = acum[acum.length - 1];
      nx = []; ny = [];
      pts.forEach((_, i) => { const a = pts[Math.max(0, i - 1)], b = pts[Math.min(pts.length - 1, i + 1)], ang = Math.atan2(b.y - a.y, b.x - a.x); nx.push(-Math.sin(ang)); ny.push(Math.cos(ang)); });
      via.setAttribute('d', 'M' + pts.map((p) => `${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join('L'));
      // la cuerda pasa POR DETRÁS de cada bloque de texto y de cada demo
      const mascara = sec.querySelector<SVGMaskElement>('[data-mascara]')!;
      mascara.querySelectorAll('.hueco').forEach((n) => n.remove());
      sec.querySelectorAll<HTMLElement>('.texto, .lado .desnuda').forEach((t) => {
        const r = t.getBoundingClientRect(), h = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
        h.setAttribute('class', 'hueco'); h.setAttribute('fill', '#000'); h.setAttribute('rx', '24');
        h.setAttribute('x', String(r.left - sr.left - 20)); h.setAttribute('y', String(r.top - sr.top - 20));
        h.setAttribute('width', String(r.width + 40)); h.setAttribute('height', String(r.height + 40));
        mascara.append(h);
      });
      pedir();
    };
    // la punta de la cuerda sigue al scroll (al 62 % de la pantalla, sin retroceder dentro de un tramo que sube); `l` se suaviza para que la onda viaje
    let l = 0, lMeta = 0, visible = false, raf = 0;
    const pintar = (ahora: number) => {
      raf = 0;
      if (!pts.length) return;
      sombra(ahora);
      const sr = sec.getBoundingClientRect();
      if (reducido) {
        cuerda.setAttribute('d', via.getAttribute('d') || ''); eco.setAttribute('d', ''); punta.style.opacity = '0';
        paradas.forEach((r, n) => sanar(r, n)); return;
      }
      const y = innerHeight * 0.62 - sr.top;
      let i = maxY.findIndex((v) => v > y); if (i < 0) i = pts.length - 1;
      lMeta = acum[i];
      const dl = lMeta - l; l += dl * 0.16; if (Math.abs(dl) < 0.5) l = lMeta;
      let j = acum.findIndex((v) => v >= l); if (j < 0) j = pts.length - 1;
      // RONDA 85 · «la cuerda de uno a otro no me gusta: tiene que ser más como una ONDA DE SONIDO». La línea recorrida es una forma de onda viva: una senoide
      // fina cuya amplitud sigue una envolvente de audio (sube y baja a su ritmo), que se desplaza (el sonido viaja) y que da un GOLPE de volumen en cada
      // problema al llegar (y luego se calma). Detrás, su eco: la misma onda desfasada y más tenue. Hacia la punta, la onda crece con la velocidad del scroll.
      const vel = Math.min(1, Math.abs(dl) / 60), t = ahora / 1000;
      let d = '', de = '';
      for (let k = 0; k <= j; k++) {
        const sl = acum[k], atras = l - sl;
        const env = 0.55 + 0.45 * Math.sin(sl / 53 + 0.4) * Math.sin(sl / 19 + 1.7);
        let A = (2.2 + 3.4 * env) * Math.min(1, sl / 60);
        if (atras < 160) A += (4 + 10 * vel) * Math.sin((Math.PI * Math.min(160, atras)) / 160) * (atras < 24 ? atras / 24 : 1);
        for (const v of vibran) { const e = t - v.t0, dk = Math.abs(k - v.b) * 5; if (e < 6) A += v.amp * Math.exp(-e * 0.9) * Math.exp(-(dk * dk) / (2 * 140 * 140)) * (0.6 + 0.4 * Math.sin(e * 9)); }
        const o = A * Math.sin(sl / 7.5 - t * 7), oe = A * 0.7 * Math.sin(sl / 7.5 - t * 7 + 1.9);
        const p = pts[k];
        d += (k ? 'L' : 'M') + (p.x + nx[k] * o).toFixed(1) + ' ' + (p.y + ny[k] * o).toFixed(1);
        de += (k ? 'L' : 'M') + (p.x + nx[k] * oe).toFixed(1) + ' ' + (p.y + ny[k] * oe).toFixed(1);
      }
      eco.setAttribute('d', de);
      cuerda.setAttribute('d', d);
      const p = pts[j];
      punta.setAttribute('cx', p.x.toFixed(1)); punta.setAttribute('cy', p.y.toFixed(1));
      punta.style.opacity = l > 8 && l < total - 8 ? '1' : '0';
      // al llegar a un problema: ese tramo VIBRA (disonancia → resolución) y la tarjeta se dibuja
      llegadas.forEach((k, n) => {
        if (j < k || paradas[n].sana) return;
        const tr = tramos.find(([a, b]) => b === k);
        if (tr) vibran.push({ a: tr[0], b: tr[1], amp: 16, t0: t }); // el golpe de volumen al llegar
        sanar(paradas[n], n, [sr.left + pts[k].x, sr.top + pts[k].y]);
      });
      // sigue pintando mientras la onda se mueve o algo vibra (y la sección se ve)
      // la onda está viva siempre que la sección se ve (el sonido no para), a ~30 fps en reposo
      if (visible) { if (Math.abs(lMeta - l) > 0.5 || Math.abs(dl) > 0.5) pedir(); else setTimeout(pedir, 30); }
    };
    const pedir = () => { if (!raf) raf = requestAnimationFrame(pintar); };
    addEventListener('scroll', () => { if (visible) pedir(); }, { passive: true });
    new IntersectionObserver((e) => { visible = e[0].isIntersecting; if (visible) pedir(); }).observe(sec);
    new ResizeObserver(() => medir()).observe(sec);
    document.fonts.ready.then(medir);
    medir();
    const sonda = () => ({ sanas: paradas.map((r) => r.sana), vivas: paradas.map((r) => !!r.tarjeta?.classList.contains('viva')), total: Math.round(total), llegadas: llegadas.map((k) => Math.round(acum[k])), dibujado: Math.round(l) });
    ((window as any).__dolores ??= {})[sec.id] = sonda;
  });
</script>

<style>
  .dolores {
    position: relative;
    padding-block: calc(var(--spacing) * 24) calc(var(--spacing) * 32);
    overflow-x: clip;
  }
  /* ── la cuerda: la vía apenas marcada; lo recorrido, en Rosa niebla; la punta, una nota Coral */
  .sombra-sonora { position: absolute; left: 0; top: 0; width: 100%; height: 280px; pointer-events: none; }
  @media (width < 48rem) { .sombra-sonora { height: 180px; } }
  .hilo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }
  .via {
    fill: none;
    stroke: color-mix(in srgb, var(--color-niebla) 5%, transparent);
    stroke-width: 1;
    stroke-dasharray: 2 6;
  }
  .eco {
    fill: none;
    stroke: color-mix(in srgb, var(--color-coral) 38%, transparent);
    stroke-width: 1;
    stroke-linejoin: round;
  }
  .cuerda {
    fill: none;
    stroke: color-mix(in srgb, var(--color-niebla) 62%, transparent);
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .punta {
    fill: var(--color-coral);
    filter: drop-shadow(0 0 6px var(--color-coral));
    transition: opacity 0.3s ease;
  }
  /* ── las paradas: carteles, alternando el lado */
  .paradas {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 32);
  }
  .parada {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: calc(var(--spacing) * 6);
    align-items: center;
    min-height: 62lvh;
  }
  .texto {
    grid-column: 1 / span 6;
    grid-row: 1;
  }
  .lado {
    position: relative;
    grid-column: 8 / span 5;
    grid-row: 1;
  }
  .derecha .texto { grid-column: 7 / span 6; }
  .derecha .lado { grid-column: 1 / span 5; }
  /* CON TARJETAS: la tarjeta delante; la rama detrás, apenas asomando y MUY sutil (Andoni: «los detalles de flores, mucho más sutiles») */
  .con-tarjetas .lado {
    display: grid;
    place-items: center;
    padding-block: calc(var(--spacing) * 12);
  }
  .con-tarjetas .lado > :global(*) {
    grid-area: 1 / 1; /* la tarjeta y su copia a líneas (dibujar.ts) en la misma celda */
  }
  /* RONDA 83 · la PARTITURA MANUSCRITA detrás de la demo (en lugar de los óleos de Donostia): tinta clara al 16 %, fundida hacia los bordes; se escribe a
     trazo cuando llega la onda (cada trazo con `pathLength = 1`; escalonados) */
  .partitura {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 112%;
    aspect-ratio: 640 / 960;
    translate: -50% -48%;
    color: var(--fg);
    opacity: 0.16;
    -webkit-mask-image: radial-gradient(closest-side, #000 50%, transparent);
    mask-image: radial-gradient(closest-side, #000 50%, transparent);
    pointer-events: none;
  }
  .partitura :global(svg) { width: 100%; height: 100%; display: block; }
  .partitura :global(path) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .partitura :global(.manchas) { fill: currentColor; opacity: 0; transition: opacity 0.8s ease 1s; }
  .sana .partitura :global(path) { stroke-dashoffset: 0; }
  .sana .partitura :global(.manchas) { opacity: 1; }
