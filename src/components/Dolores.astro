      // una en cada tiempo de la música que suena (empiezan en el siguiente), y cada una da una nota del acorde que suena en ese momento
      // ronda 118 (7.ª): las líneas las revelan las NOTAS que bajan con el scroll desde el hero (ver más abajo); con movimiento reducido, a la vista
      if (reducido) r.li.classList.add('l1', 'l2', 'l3');
