        de += (k ? 'L' : 'M') + (p.x + nx[k] * oe).toFixed(1) + ' ' + (p.y + ny[k] * oe).toFixed(1);
      }
      eco.setAttribute('d', de);
      cuerda.setAttribute('d', d);
      const p = pts[j];
      punta.setAttribute('cx', p.x.toFixed(1)); punta.setAttribute('cy', p.y.toFixed(1));
      punta.style.opacity = l > 8 && l < total - 8 ? '1' : '0';
      // al llegar a un problema: ese tramo VIBRA (disonancia → resolución) y la tarjeta se dibuja
      llegadas.forEach((k, n) => {
        if (j < k || paradas[n].sana) return;
        const tr = tramos.find(([a, b]) => b === k);
        if (tr) vibran.push({ a: tr[0], b: tr[1], amp: 16, t0: t }); // el golpe de volumen al llegar
        sanar(paradas[n], n, [sr.left + pts[k].x, sr.top + pts[k].y]);
