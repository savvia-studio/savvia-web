  .cuadro .h { position: absolute; left: 0; right: 0; height: 1px; background: color-mix(in srgb, var(--fg) 16%, transparent); scale: 0 1; transition: scale 1.1s var(--ease-out-expo) 0.15s; }
  .cuadro .arriba { top: 0; } .cuadro .abajo { bottom: 0; }
