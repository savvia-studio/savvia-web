    };
    // pts: la cuerda muestreada cada ~6 px; nx/ny: su normal; acum: longitud recorrida; tramos: [inicio, fin] de cada tramo recto (para que vibre entero)
    let pts: P[] = [], nx: number[] = [], ny: number[] = [], acum: number[] = [], maxY: number[] = [], llegadas: number[] = [], tramos: [number, number][] = [], total = 1;
    // lo que vibra: [índice de inicio, índice de fin, amplitud, cuándo empezó]
