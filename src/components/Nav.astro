    .reel {
      width: 100%;
    }
  }
  /* el reproductor grande: el <dialog> ocupa la ventana, transparente; la tarjeta oscura se pinta desde la miniatura */
  .reel-dlg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: calc(var(--spacing) * 6);
    border: 0;
    background: transparent;
    display: none;
    place-items: center;
    overscroll-behavior: contain;
  }
  .reel-dlg[open] {
    display: grid;
  }
  .reel-dlg::backdrop {
    background: color-mix(in oklab, #1a1210 78%, transparent);
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .reel-dlg.on::backdrop {
    opacity: 1;
  }
  .reel-panel {
    width: min(100%, 72rem, (100dvh - 9rem) * 16 / 9);
    display: flex;
    flex-direction: column;
    gap: calc(var(--spacing) * 3);
    padding: calc(var(--spacing) * 3);
    border-radius: var(--radius-lg);
    color: var(--fg);
  }
  .reel-video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    background: #1a1210;
    object-fit: cover;
    cursor: pointer;
  }
  .reel-mandos {
    display: flex;
    align-items: center;
    gap: calc(var(--spacing) * 2);
  }
  .reel-bt {
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--spacing) * 8);
    height: calc(var(--spacing) * 8);
    border-radius: var(--radius-full);
    color: var(--fg);
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .reel-bt:hover,
  .reel-bt:focus-visible {
    background: color-mix(in oklab, var(--color-niebla) 12%, transparent);
  }
  .reel-bt :global(svg) {
    width: calc(var(--spacing) * 4);
    height: calc(var(--spacing) * 4);
  }
  .reel-bt :global(.ic-pausa),
  .reel-dlg.suena .reel-bt :global(.ic-play),
  .reel-bt :global(.ic-mudo),
  .reel-dlg.mudo .reel-bt :global(.ic-son) {
    display: none;
  }
  .reel-dlg.suena .reel-bt :global(.ic-pausa),
  .reel-dlg.mudo .reel-bt :global(.ic-mudo) {
    display: block;
  }
  /* el hilo de savia que mide el reel; un clic busca */
  .reel-hilo {
    position: relative;
    flex: 1;
    height: calc(var(--spacing) * 6);
    cursor: pointer;
  }
  .reel-hilo::before,
  .reel-hilo i {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: var(--rule);
  }
  .reel-hilo i {
    background: var(--color-coral);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
  }
  @media (width < 48rem) {
    .reel-dlg {
      padding: calc(var(--spacing) * 3);
    }
  }
  .enlace {
    transition: opacity 0.35s ease, filter 0.45s ease;
  }
  /* como en la referencia: el que pisas se queda, los demás se retiran. RONDA 22: y se DESENFOCAN */
  .menu ul:has(.enlace:hover) .enlace:not(:hover) {
    opacity: 0.4;
    filter: blur(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu.on,
    .menu li,
    .menu .resto,
    .menu.on li,
    .menu.on .resto,
    .velo,
    .rejilla span {
      transition: none;
    }
  }
  .pronto { opacity: 0.55; }
  .pronto small { font-size: 0.75em; }
</style>

<style is:global>
  /* RONDA 141 · vuelven los estados sólidos. Orden = prioridad: claro < escena < menú abierto < sentado. */
  html.sobre-claro [data-nav] {
    color: var(--color-cacao);
  }
  /* html.sobre-escena (ronda 20, la pone Proyectos.astro) ya no fuerza el claro: sobre la foto de la mesa el script lee el píxel de la lámina
     (medido: el cielo da 0,3–0,6 de luminancia; Rosa niebla encima se quedaba en 1,3–2,2:1). */
  /* primer fotograma, antes de que el script mire: en las páginas claras, ya en Cacao */
  html:not(.nav-lista):not(.lab-pagina):has(main.surface-light) [data-nav] {
    color: var(--color-cacao);
  }
  html.menu-abierto {
    overflow: hidden;
  }
  /* Con la tarjeta abierta el botón pisa Rosa niebla: deja la mezcla por diferencia (daría un verde sucio) y pasa a Cacao. */
  html.menu-abierto [data-nav] {
    color: var(--color-niebla);
  }
  html.menu-abierto [data-rejilla],
  html.menu-abierto [data-radio-play],
  html.menu-abierto [data-estacion-ic] {
    color: var(--color-cacao);
  }
  html.estudio-sentado [data-nav] {
    opacity: 0;
    pointer-events: none;
  }
</style>
