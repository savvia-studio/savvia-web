---
// RONDA 128 · la LÁMINA de cada capítulo: la imagen con la que se presenta en la portada del handbook y en la cabecera de su página
// (la referencia abre cada capítulo con una pieza visual propia). Solo material que ya existe: fotos de public/media, el roble de la
// estación, o composiciones tipográficas hechas con el propio contenido (los cuatro pasos, las etiquetas de los servicios).
import type { Portada } from '../../data/handbook';
import { juntos } from '../../data/handbook';
import { servicios } from '../../data/home';

interface Props { portada: Portada; proporcion?: string; grande?: boolean; carga?: 'lazy' | 'eager' }
const { portada, proporcion = '4 / 3', grande = false, carga = 'lazy' } = Astro.props;
const pasos = ['Entender', 'Decidir', 'Documentar', 'Entregar'];
const todas = servicios.lista[0].tags;
const enConsultoria = new Set(servicios.lista[2].tags);
---

<div class={`lamina l-${portada.tipo} ${grande ? 'grande' : ''}`} style={`--prop:${proporcion}`} aria-hidden={portada.tipo === 'imagen' ? undefined : 'true'}>
  {
    portada.tipo === 'imagen' && (
      <img
        src={portada.img.src}
        alt={portada.img.alt}
        width={portada.img.ancho}
        height={portada.img.alto}
        loading={carga}
        decoding="async"
        style={`object-position:${portada.img.recorte ?? '50% 50%'};${portada.img.fondo ? `background:${portada.img.fondo};` : ''}${portada.img.encaje ? `object-fit:${portada.img.encaje};padding:4%;` : ''}`}
      />
    )
  }
  {portada.tipo === 'arbol' && <div class="arbol" />}
  {portada.tipo === 'caras' && <img class="juntos" src={juntos.src} alt="" width={juntos.ancho} height={juntos.alto} loading={carga} decoding="async" />}
  {
    portada.tipo === 'pasos' && (
      <ol class="pasos">
        {pasos.map((p, i) => (
          <li style={`--i:${i}`}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="p">{p}</span>
          </li>
        ))}
      </ol>
    )
  }
  {
    portada.tipo === 'etiquetas' && (
      <ul class="etiquetas">
        {todas.map((t) => (
          <li class={enConsultoria.has(t) ? 'on' : ''}>{t}</li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .lamina {
    position: relative;
    aspect-ratio: var(--prop);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--color-cacao) 6%, var(--color-niebla));
    isolation: isolate;
    container-type: inline-size;
  }
  .lamina > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .l-imagen > img { transition: transform 1.1s var(--ease-out-expo); }

  .arbol {
    position: absolute;
    inset: 12% 6% 0;
    background: url('/media/hero/arbol-otono.webp') 50% 100% / contain no-repeat;
  }
  :global(html[data-estacion='invierno']) .arbol { background-image: url('/media/hero/arbol-invierno.webp'); }
  :global(html[data-estacion='primavera']) .arbol { background-image: url('/media/hero/arbol-primavera.webp'); }
  :global(html[data-estacion='verano']) .arbol { background-image: url('/media/hero/arbol-verano.webp'); }
  .l-arbol::after {
    content: '';
    position: absolute;
    left: 6%;
    right: 6%;
    bottom: 0;
    height: 1px;
    background: var(--rule-strong);
  }

  .lamina > .juntos {
    inset: 10% 0 0;
    height: 90%;
    object-fit: contain;
    object-position: 50% 100%;
  }

  /* los cuatro pasos, como una portada de libro */
  .pasos {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .pasos li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 6cqi;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .pasos li:nth-child(2n) { border-right: 0; }
  .pasos li:nth-child(n + 3) { border-bottom: 0; }
  .pasos .n { font-family: var(--font-mono); font-size: max(0.75rem, 2.6cqi); color: var(--color-coral); letter-spacing: 0.04em; }
  .pasos .p { font-family: var(--font-display); font-size: 8.5cqi; line-height: 1; letter-spacing: -0.03em; color: var(--color-cacao); }

  /* las etiquetas compartidas: las de Consultoría a plena tinta, el resto en filete (sale de servicios.lista) */
  .etiquetas {
    position: absolute;
    inset: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: center;
    gap: 1.6cqi;
    padding: 6cqi;
  }
  .etiquetas li {
    font-family: var(--font-mono);
    font-size: max(0.6875rem, 2.3cqi);
    line-height: 1.2;
    padding: 1.1cqi 2.2cqi;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-cacao) 22%, transparent);
    color: color-mix(in oklab, var(--color-cacao) 70%, transparent);
  }
  .etiquetas li.on { background: var(--color-cacao); border-color: var(--color-cacao); color: var(--color-niebla); }

  @media (prefers-reduced-motion: reduce) {
    .l-imagen > img { transition: none; }
  }
</style>
